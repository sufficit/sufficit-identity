<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Fork Sufficit do Pomelo.EntityFrameworkCore.MySql (EF Core 10 preview).
         Folder feed commitado: contém o .nupkg compilado do PR upstream #2019.
         TEMPORÁRIO: quando Pomelo upstream shipar EF Core 10 estável (issue #2007),
         remover este feed + a pasta .nuget-feed e usar a versão oficial. -->
    <add key="sufficit-pomelo-fork" value="./.nuget-feed" />
  </packageSources>
  <!-- Keep the temporary provider fork on its private feed.  Every other
       package family is explicitly mapped to nuget.org, so a typo or an
       upstream package with the same ID cannot silently resolve from the
       local feed. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="AspNet.*" />
      <package pattern="Humanizer.*" />
      <package pattern="Microsoft.*" />
      <package pattern="Mono.*" />
      <package pattern="MySqlConnector" />
      <package pattern="Newtonsoft.Json" />
      <package pattern="OpenIddict.*" />
      <package pattern="Polly*" />
      <package pattern="QRCoder" />
      <package pattern="RabbitMQ.Client" />
      <package pattern="SQLitePCLRaw.*" />
      <package pattern="Serilog*" />
      <package pattern="Swashbuckle.*" />
      <package pattern="System.*" />
      <package pattern="xunit*" />
    </packageSource>
    <packageSource key="sufficit-pomelo-fork">
      <package pattern="Pomelo.EntityFrameworkCore.MySql" />
    </packageSource>
  </packageSourceMapping>
</configuration>
