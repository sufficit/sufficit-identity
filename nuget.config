<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Fork Sufficit do Pomelo.EntityFrameworkCore.MySql (EF Core 10 preview).
         Folder feed commitado: contém o .nupkg compilado da branch upgrade/10.0.0
         do PR upstream #2019 (https://github.com/PomeloFoundation/Pomelo.EntityFrameworkCore.MySql/pull/2019).
         TEMPORÁRIO: quando o Pomelo upstream shipar EF Core 10 estável (issue #2007),
         remover este feed + a pasta .nuget-feed e usar a versão oficial. -->
    <add key="sufficit-pomelo-fork" value="./.nuget-feed" />
  </packageSources>
</configuration>
