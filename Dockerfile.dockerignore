# Per-Dockerfile ignore (BuildKit): used when the build context is the
# PARENT directory of the two checkouts (see Dockerfile). A plain
# .dockerignore at the context root would be outside this repository and
# unenforceable; this file travels with the repo and takes precedence for
# THIS Dockerfile, keeping the context upload to exactly the two source
# trees — critical locally, where the parent directory also contains
# deployment secrets (deploy/local certificates and KEKs) and databases.
*
!sufficit-identity/
!sufficit-identity/**
!sufficit-blazor-ui/
!sufficit-blazor-ui/**

# Never bake runtime configuration or local deployment data into image
# layers — mirrors the root .dockerignore, which does not apply to the
# parent context.
sufficit-identity/src/server/appsettings*.json
!sufficit-identity/src/server/appsettings.json.template
sufficit-identity/deploy/
sufficit-identity/_publish/
sufficit-identity/docs/
sufficit-identity/.git/
sufficit-blazor-ui/.git/

# Build outputs are rebuilt inside the image.
**/bin/
**/obj/
