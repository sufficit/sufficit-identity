@page "/manage/passkeys"
@attribute [Authorize]
@rendermode @(RenderMode.InteractiveServer)
@using Sufficit.Identity.UI.Services
@inject IAccountPasskeyService PasskeyService
@inject IJSRuntime JS
@inject ILogger<Passkeys> Logger

<PageTitle>Passkeys — Sufficit Identity</PageTitle>

<div class="auth-card">
    <ManageBackLink />
    <h1>Passkeys (WebAuthn)</h1>
    <p class="info">Use biometria, o bloqueio do dispositivo ou uma chave de segurança para entrar sem senha.</p>

    @if (_error is not null)
    {
        <div class="alert alert-error" role="alert" aria-live="assertive">@_error</div>
    }
    @if (_success is not null)
    {
        <div class="alert alert-success" role="status" aria-live="polite">@_success</div>
    }

    <h3>Suas passkeys</h3>
    @if (_loading)
    {
        <p class="muted" role="status">Carregando passkeys...</p>
    }
    else if (_loadFailed)
    {
        <div class="alert alert-error" role="alert">
            Não foi possível carregar suas passkeys.
            <button type="button" class="btn btn-secondary btn-sm" @onclick="LoadPasskeysAsync">
                Tentar novamente
            </button>
        </div>
    }
    else if (_overview?.Credentials.Count > 0)
    {
        <ul class="passkey-list">
            @foreach (var passkey in _overview.Credentials)
            {
                <li class="passkey-item">
                    <div class="passkey-item-info">
                        <span class="passkey-name">@(passkey.Name ?? "Passkey sem nome")</span>
                        <span class="passkey-meta">Criada em @passkey.CreatedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</span>
                        @if (passkey.IsBackedUp)
                        {
                            <span class="badge badge-success">Sincronizada</span>
                        }
                    </div>
                    <button type="button" class="btn btn-danger btn-sm" disabled="@_busy"
                            aria-label="Remover @(passkey.Name ?? "passkey sem nome")"
                            @onclick="@(async () => await RemovePasskeyAsync(passkey.CredentialId))">
                        Remover
                    </button>
                </li>
            }
        </ul>
    }
    else
    {
        <p class="muted">Nenhuma passkey cadastrada. Registre uma para entrar sem digitar sua senha.</p>
    }

    @if (!_loading && !_loadFailed && _overview is not null)
    {
        <hr />
        <h3>Adicionar passkey</h3>

        @if (!_supported)
        {
            <div class="alert alert-info" role="status">
                Este navegador não oferece suporte a passkeys neste dispositivo. Tente um navegador moderno
                com Windows Hello, Touch ID, Face ID ou uma chave de segurança USB/NFC.
            </div>
        }
        else if (!_overview.CanRegister)
        {
            <div class="alert alert-info" role="status">
                Esta conta atingiu o limite de @_overview.MaximumCredentials passkeys. Remova uma passkey antes de registrar outra.
            </div>
        }
        else
        {
            <form @ref="_registrationForm" @onsubmit="RegisterPasskeyAsync" @onsubmit:preventDefault>
                <AntiforgeryToken />
                <div class="form-group">
                    <label for="passkey-name">Nome (opcional)</label>
                    <input id="passkey-name" name="name" @bind="_passkeyName" class="form-control"
                           maxlength="@_overview.MaximumNameLength" autocomplete="off"
                           placeholder="Ex.: notebook pessoal" disabled="@_busy" />
                    <span class="field-hint">Use um nome que ajude a reconhecer o dispositivo.</span>
                </div>
                <button type="submit" class="btn btn-primary" disabled="@_busy">
                    @(_busy ? "Aguardando o dispositivo..." : "Registrar passkey")
                </button>
            </form>
        }
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? _authTask { get; set; }

    private ElementReference _registrationForm;
    private AccountPasskeyOverview? _overview;
    private string? _passkeyName;
    private string? _error;
    private string? _success;
    private bool _loading = true;
    private bool _loadFailed;
    private bool _busy;
    private bool _supported = true;

    protected override Task OnInitializedAsync() => LoadPasskeysAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _supported = await JS.InvokeAsync<bool>("passkeys.isSupported");
            StateHasChanged();
        }
        catch (JSException exception)
        {
            Logger.LogDebug(exception, "Passkey capability detection was unavailable.");
        }
    }

    private async Task LoadPasskeysAsync()
    {
        _loading = true;
        _loadFailed = false;

        try
        {
            var principal = await _authTask.GetAuthenticatedPrincipalAsync();
            if (principal is null)
            {
                _error = "Sua sessão expirou. Entre novamente para gerenciar passkeys.";
                _overview = null;
                return;
            }

            _overview = await PasskeyService.GetOverviewAsync(principal);
            if (_overview is null)
            {
                _error = "Sua sessão expirou. Entre novamente para gerenciar passkeys.";
            }
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Failed to load account passkeys.");
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RegisterPasskeyAsync()
    {
        _error = null;
        _success = null;
        _busy = true;

        try
        {
            var result = await JS.InvokeAsync<AccountPasskeyResult>(
                "passkeys.register",
                _registrationForm,
                _passkeyName ?? string.Empty);

            if (result.State is not null)
            {
                _overview = result.State;
            }

            if (result.Succeeded)
            {
                _passkeyName = null;
                _success = "Passkey registrada com sucesso.";
            }
            else
            {
                _error = DescribeErrors(result.Errors, "Não foi possível registrar a passkey.");
            }
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Passkey registration interaction failed.");
            _error = "Não foi possível concluir o registro. Recarregue a página e tente novamente.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemovePasskeyAsync(string credentialId)
    {
        _error = null;
        _success = null;
        _busy = true;

        try
        {
            var confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                "Remover esta passkey? Ela deixará de funcionar para entrar nesta conta.");
            if (!confirmed)
            {
                return;
            }

            var principal = await _authTask.GetAuthenticatedPrincipalAsync();
            if (principal is null)
            {
                _error = "Sua sessão expirou. Entre novamente para gerenciar passkeys.";
                return;
            }

            var result = await PasskeyService.RemoveAsync(principal, credentialId);
            if (result.State is not null)
            {
                _overview = result.State;
            }

            if (result.Succeeded)
            {
                _success = "Passkey removida.";
            }
            else
            {
                _error = DescribeErrors(result.Errors, "Não foi possível remover a passkey.");
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to remove account passkey {CredentialId}.", credentialId);
            _error = "Não foi possível remover a passkey. Tente novamente.";
        }
        finally
        {
            _busy = false;
        }
    }

    private static string DescribeErrors(
        IReadOnlyList<AccountSelfServiceError> errors,
        string fallback) =>
        errors.Count == 0
            ? fallback
            : string.Join(" ", errors.Select(error => error.Description));
}
