@page "/vault/admin"
@page "/management/vault"
@attribute [Authorize(Policy = VaultUiPolicies.Admin)]
@rendermode InteractiveServer
@layout VaultLayout
@inject VaultDataSource Data
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ISUIToast Toast

<PageTitle>@L["Vault.AdminVault.PageTitle"].Value | Sufficit Identity</PageTitle>
<SUIPageHeader Title="@L["Vault.AdminVault.PageTitle"].Value"
            Description="@L["Vault.AdminVault.Description"].Value">
    <Actions><SUIStatusBadge ToneValue="SUITone.Warning" Icon="shield">@L["Vault.AdminVault.AdminAccessBadge"]</SUIStatusBadge></Actions>
</SUIPageHeader>

<SUIToastHost />

<SUIAlert ToneValue="SUITone.Warning" Icon="alert" role="note">
    <strong>@L["Vault.AdminVault.WarningNoteTitle"]</strong> @L["Vault.AdminVault.WarningNoteBody"]
</SUIAlert>

<nav class="vault-admin-tabs" aria-label="@L["Vault.AdminVault.TabsAriaLabel"].Value">
    <a class="vault-admin-tab @(!IsGlobalView ? "vault-admin-tab--active" : null)"
       href="@UsersUrl()" aria-current="@(!IsGlobalView ? "page" : null)">
        <SUIIcon Name="users" Size="17" /> @L["Vault.AdminVault.UserVaultsTab"]
    </a>
    <a class="vault-admin-tab @(IsGlobalView ? "vault-admin-tab--active" : null)"
       href="/vault/admin?view=global" aria-current="@(IsGlobalView ? "page" : null)">
        <SUIIcon Name="database" Size="17" /> @L["Vault.AdminVault.GlobalSecretsTab"]
    </a>
</nav>

@if (IsGlobalView)
{
    <SUICard Elevation="0">
        <SUICardHeader Title="@L["Vault.AdminVault.CreateOrRotateHeading"].Value" Description="@L["Vault.AdminVault.CreateOrRotateDescription"].Value" />
        <AuthorizeView Policy="@VaultUiPolicies.AdminManage">
            <Authorized Context="vaultAuthorization">
                <EditForm Model="form" Context="editContext" OnValidSubmit="SaveGlobalAsync">
                    <DataAnnotationsValidator />
                    <SUICardContent>
                    @* ValueChanged notifies the EditContext and ValidationMessage stays explicit (see docs/frontend/EVALUATION-SUI-ADOPTION.md). *@
                    <SUIFormGrid Columns="2" LabelLines="1">
                        <div>
                            <IdentityTextField T="string" Id="admin-secret-name" Label="@L["Vault.AdminVault.NameLabel"].Value" Value="@form.Name"
                                          ValueChanged="value => { form.Name = value ?? string.Empty; editContext.NotifyFieldChanged(new(form, nameof(form.Name))); }"
                                          autocomplete="off" Placeholder="@L["Vault.AdminVault.NamePlaceholder"].Value" />
                            <ValidationMessage For="() => form.Name" />
                        </div>
                        <div>
                            <IdentityTextField T="string" Id="admin-secret-value" Label="@L["Vault.AdminVault.ValueLabel"].Value" Value="@form.Value"
                                          ValueChanged="value => { form.Value = value ?? string.Empty; editContext.NotifyFieldChanged(new(form, nameof(form.Value))); }"
                                          InputType="password" autocomplete="new-password" />
                            <ValidationMessage For="() => form.Value" />
                        </div>
                    </SUIFormGrid>
                    </SUICardContent>
                    <SUICardActions AlignEnd="true">
                        <SUIButton ButtonTypeValue="SUIButtonType.Submit" Disabled="@saving">@(saving ? L["Vault.Common.Saving"].Value : L["Vault.AdminVault.SaveRotation"].Value)</SUIButton>
                    </SUICardActions>
                </EditForm>
            </Authorized>
            <NotAuthorized>
                <SUICardContent><SUIAlert ToneValue="SUITone.Info" Icon="lock" role="note">@L["Vault.AdminVault.ReadOnlyHint"]</SUIAlert></SUICardContent>
            </NotAuthorized>
        </AuthorizeView>
    </SUICard>

    <SUICard Elevation="0">
        <SUICardHeader Title="@L["Vault.AdminVault.GlobalSecretsHeading"].Value" Description="@L["Vault.AdminVault.GlobalSecretsDescription"].Value">
            <MetaContent><SUIStatusBadge ToneValue="SUITone.Info">@globalItems.Count @(globalItems.Count == 1 ? L["Vault.Common.ItemSingular"].Value : L["Vault.Common.ItemPlural"].Value)</SUIStatusBadge></MetaContent>
        </SUICardHeader>
        @if (loading)
        {
            <SUICardContent aria-label="@L["Vault.AdminVault.LoadingGlobalAriaLabel"].Value"><SUISkeletonLoader Type="SUISkeletonType.Table" Rows="3" /></SUICardContent>
        }
        else if (!success && !string.IsNullOrWhiteSpace(loadError))
        {
            <SUICardContent>
                <SUIAlert ToneValue="SUITone.Danger" Icon="alert">
                    <div class="vault-alert-row">
                        <div><strong>@L["Vault.AdminVault.LoadErrorTitle"]</strong><p>@loadError</p></div>
                        <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" OnClick="LoadGlobalAsync">@L["Vault.Common.Retry"]</SUIButton>
                    </div>
                </SUIAlert>
            </SUICardContent>
        }
        else if (globalItems.Count == 0)
        {
            <SUIEmptyState Icon="database" Title="@L["Vault.AdminVault.NoGlobalSecretsTitle"].Value" Description="@L["Vault.AdminVault.NoGlobalSecretsDescription"].Value" />
        }
        else
        {
            <div class="vault-list">
                @foreach (var item in globalItems)
                {
                    <div class="vault-list__item">
                        <span class="vault-list__icon"><SUIIcon Name="lock" Size="18" /></span>
                        <div class="vault-list__copy">
                            <strong>@item.Name</strong>
                            <span>@string.Format(L["Vault.AdminVault.UpdatedByOn"].Value, item.UpdatedBy, FormatDate(item.UpdatedAtUtc))</span>
                        </div>
                        <AuthorizeView Policy="@VaultUiPolicies.AdminManage">
                            <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" OnClick="() => DeleteGlobalAsync(item.Name)" Disabled="@saving">@L["Vault.Common.Remove"]</SUIButton>
                        </AuthorizeView>
                    </div>
                }
            </div>
        }
    </SUICard>
}
else
{
    <SUICard Elevation="0">
        <SUICardHeader Title="@L["Vault.AdminVault.UsersHeading"].Value" Description="@L["Vault.AdminVault.UsersDescription"].Value" />

        <form class="vault-search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
            <div class="vault-search__controls">
                <div class="vault-search-field">
                    <SUIIcon Name="search" Size="18" />
                    <IdentityTextField T="string" Id="vault-user-search" Label="@L["Vault.AdminVault.SearchLabel"].Value" @bind-Value="search"
                              InputType="search" Placeholder="@L["Vault.AdminVault.SearchPlaceholder"].Value" autocomplete="off" />
                </div>
                <SUIButton ButtonTypeValue="SUIButtonType.Submit" Disabled="@loading">@L["Vault.AdminVault.SearchButton"]</SUIButton>
                @if (!string.IsNullOrWhiteSpace(QuerySearch))
                {
                    <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" Href="/vault/admin">@L["Vault.AdminVault.ClearSearch"]</SUIButton>
                }
            </div>
        </form>

        @if (userPage is not null)
        {
            <div class="vault-inventory-strip">
                <SUIStat Label="@L["Vault.AdminVault.VaultsFoundLabel"].Value" Value="@userPage.TotalUsers.ToString()" Icon="users" />
                <SUIStat Label="@L["Vault.AdminVault.PersonalSecretsFoundLabel"].Value" Value="@userPage.TotalPersonalSecrets.ToString()" Icon="lock" />
                <SUIStat Label="@L["Vault.AdminVault.ManagedCredentialsFoundLabel"].Value" Value="@userPage.TotalManagedCredentials.ToString()" Icon="key" />
            </div>
        }

        @if (loading)
        {
            <SUICardContent aria-label="@L["Vault.AdminVault.LoadingUsersAriaLabel"].Value"><SUISkeletonLoader Type="SUISkeletonType.Table" Rows="5" /></SUICardContent>
        }
        else if (!success)
        {
            <SUICardContent>
                <SUIAlert ToneValue="SUITone.Danger" Icon="alert">
                    <div class="vault-alert-row">
                        <div><strong>@L["Vault.AdminVault.LoadErrorTitle"]</strong><p>@loadError</p></div>
                        <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" OnClick="LoadUsersAsync">@L["Vault.Common.Retry"]</SUIButton>
                    </div>
                </SUIAlert>
            </SUICardContent>
        }
        else if (userPage is null || userPage.Items.Count == 0)
        {
            <SUIEmptyState Icon="users" Title="@L["Vault.AdminVault.NoVaultFoundTitle"].Value" Description="@L["Vault.AdminVault.NoVaultFoundDescription"].Value" />
        }
        else
        {
            <div class="vault-users">
                @foreach (var item in userPage.Items)
                {
                    <a class="vault-user-row" href="@UserDetailUrl(item.OwnerSubject)">
                        <span class="vault-user-row__icon"><SUIIcon Name="users" Size="19" /></span>
                        <span class="vault-user-row__identity">
                            <strong>@UserTitle(item)</strong>
                            <span>@UserSubtitle(item)</span>
                        </span>
                        <span class="vault-user-row__counts">
                            <span>@item.PersonalSecretCount @L["Vault.AdminVault.PersonalCountSuffix"]</span>
                            <span>@item.ManagedCredentialCount @L["Vault.AdminVault.ConnectedCountSuffix"]</span>
                        </span>
                        <span class="vault-user-row__activity">@(item.LastUpdatedAtUtc is null ? L["Vault.Common.NoDate"].Value : string.Format(L["Vault.AdminVault.UpdatedPrefix"].Value, FormatDate(item.LastUpdatedAtUtc.Value)))</span>
                        <SUIIcon Name="arrow-right" Size="17" />
                    </a>
                }
            </div>
            @if (TotalPages > 1)
            {
                <SUICardActions>
                    <SUIPagination TotalItems="@userPage.TotalUsers" PageSize="PageSize" PageIndex="@(CurrentPage - 1)"
                                   PageHref="index => UsersUrl(index + 1)"
                                   AriaLabel="@L["Vault.AdminVault.PaginationAriaLabel"].Value"
                                   PreviousLabel="@L["Vault.AdminVault.Previous"].Value"
                                   NextLabel="@L["Vault.AdminVault.Next"].Value"
                                   RangeFormatter="RangeOf"
                                   PageLabel="PageOf" />
                </SUICardActions>
            }
        }
    </SUICard>
}

@code {
    private const int PageSize = 25;
    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? QuerySearch { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int QueryPage { get; set; } = 1;

    private readonly AdminSecretForm form = new();
    private IReadOnlyList<ManagementVaultSecret> globalItems = [];
    private VaultUserInventoryPage? userPage;
    private bool loading = true;
    private bool saving;
    private bool success = true;
    private string search = string.Empty;
    private string? loadError;
    private string? loadedFingerprint;

    private bool IsGlobalView => string.Equals(View, "global", StringComparison.OrdinalIgnoreCase);
    private int CurrentPage => Math.Max(1, QueryPage);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((userPage?.TotalUsers ?? 0) / (double)PageSize));

    protected override void OnInitialized() => form.Localizer = L;

    protected override async Task OnParametersSetAsync()
    {
        var fingerprint = $"{View}|{QuerySearch}|{QueryPage}";
        if (fingerprint == loadedFingerprint) return;
        loadedFingerprint = fingerprint;
        search = QuerySearch ?? string.Empty;
        if (IsGlobalView) await LoadGlobalAsync(); else await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        loading = true;
        var result = await Data.ListVaultUsersAsync(
            QuerySearch,
            (CurrentPage - 1) * PageSize,
            PageSize);
        success = result.IsSuccess;
        userPage = result.Value;
        loadError = result.Error;
        loading = false;
    }

    private async Task LoadGlobalAsync()
    {
        loading = true;
        var result = await Data.ListAdminAsync();
        success = result.IsSuccess;
        globalItems = result.Value ?? [];
        loadError = result.Error;
        loading = false;
    }

    private Task SearchAsync()
    {
        Navigation.NavigateTo(UsersUrl(1, search));
        return Task.CompletedTask;
    }

    private async Task SaveGlobalAsync()
    {
        saving = true;
        var result = await Data.PutAdminAsync(form.Name, form.Value);
        Notify(result.IsSuccess, L["Vault.AdminVault.GlobalSecretSaved"].Value, result.Error);
        if (result.IsSuccess)
        {
            form.Value = string.Empty;
            await LoadGlobalAsync();
        }
        saving = false;
    }

    private async Task DeleteGlobalAsync(string name)
    {
        saving = true;
        var result = await Data.DeleteAdminAsync(name);
        Notify(result.IsSuccess, L["Vault.AdminVault.GlobalSecretRemoved"].Value, result.Error);
        if (result.IsSuccess) await LoadGlobalAsync();
        saving = false;
    }

    private void Notify(bool succeeded, string successMessage, string? error)
    {
        if (succeeded) Toast.Success(successMessage);
        else Toast.Error(error ?? L["Vault.Data.OperationFailed"].Value);
    }

    private string UsersUrl(int page = 1, string? searchValue = null)
    {
        var selectedSearch = searchValue ?? QuerySearch;
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(selectedSearch))
            query.Add($"q={Uri.EscapeDataString(selectedSearch.Trim())}");
        if (page > 1) query.Add($"page={page}");
        return query.Count == 0 ? "/vault/admin" : $"/vault/admin?{string.Join('&', query)}";
    }

    private string RangeOf(int first, int last, int total) =>
        string.Format(L["Vault.AdminVault.RangeOf"].Value, first, last, total);

    private string PageOf(int page, int total) =>
        string.Format(L["Vault.AdminVault.PageOf"].Value, page, total);

    private static string UserDetailUrl(string ownerSubject) =>
        $"/vault/admin/users/{Uri.EscapeDataString(ownerSubject)}";

    private static string UserTitle(VaultUserInventoryItem item) =>
        item.Email ?? item.UserName ?? item.OwnerSubject;

    private string UserSubtitle(VaultUserInventoryItem item)
    {
        if (!item.UserExists) return string.Format(L["Vault.AdminVault.AccountRemovedSubtitle"].Value, item.OwnerSubject);
        if (!string.IsNullOrWhiteSpace(item.Email)
            && !string.IsNullOrWhiteSpace(item.UserName))
            return $"{item.UserName} · {item.OwnerSubject}";
        return item.OwnerSubject;
    }

    // This page is its own interactive island, outside any BrowserTime
    // cascade: it asks the browser for its zone after the first render.
    private BrowserTime time = BrowserTime.Server;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        var resolved = await BrowserTime.ResolveAsync(JS);
        if (resolved.Resolved)
        {
            time = resolved;
            StateHasChanged();
        }
    }

    private string FormatDate(DateTime value) => time.Format(value);

    private sealed class AdminSecretForm : IValidatableObject
    {
        public IStringLocalizer<Sufficit.Identity.UI.Vault.Resources.VaultResource>? Localizer { get; set; }

        public string Name { get; set; } = string.Empty;

        public string Value { get; set; } = string.Empty;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (Localizer is null)
                throw new InvalidOperationException("Localizer must be assigned before validation.");
            var l = Localizer;

            if (string.IsNullOrWhiteSpace(Name))
                yield return new ValidationResult(l["Vault.AdminVault.Validation.NameRequired"].Value, [nameof(Name)]);

            if (string.IsNullOrWhiteSpace(Value))
                yield return new ValidationResult(l["Vault.AdminVault.Validation.ValueRequired"].Value, [nameof(Value)]);
        }
    }
}
