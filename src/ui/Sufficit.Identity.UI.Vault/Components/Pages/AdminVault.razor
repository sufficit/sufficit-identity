@page "/vault/admin"
@page "/management/vault"
@attribute [Authorize(Policy = VaultUiPolicies.Admin)]
@rendermode InteractiveServer
@layout VaultLayout
@inject VaultDataSource Data
@inject NavigationManager Navigation

<PageTitle>Gestão do Vault | Sufficit Identity</PageTitle>
<SUIPageHeader Title="Gestão do Vault"
            Description="Localize credenciais por usuário, remova acessos comprometidos e mantenha os segredos globais dos serviços.">
    <Actions><SUIStatusBadge ToneValue="SUITone.Warning" Icon="shield">Acesso administrativo</SUIStatusBadge></Actions>
</SUIPageHeader>

<div class="vault-note vault-note--warning" role="note">
    <SUIIcon Name="alert" Size="20" />
    <div>
        <strong>Valores protegidos continuam invisíveis.</strong>
        <span>Esta área mostra somente metadados. Remoções são definitivas, exigem permissão de gestão e ficam registradas na auditoria.</span>
    </div>
</div>

<nav class="vault-admin-tabs" aria-label="Áreas da gestão do Vault">
    <a class="vault-admin-tab @(!IsGlobalView ? "vault-admin-tab--active" : null)"
       href="@UsersUrl()" aria-current="@(!IsGlobalView ? "page" : null)">
        <SUIIcon Name="users" Size="17" /> Vaults de usuários
    </a>
    <a class="vault-admin-tab @(IsGlobalView ? "vault-admin-tab--active" : null)"
       href="/vault/admin?view=global" aria-current="@(IsGlobalView ? "page" : null)">
        <SUIIcon Name="database" Size="17" /> Segredos globais
    </a>
</nav>

@if (IsGlobalView)
{
    <section class="vault-panel" aria-labelledby="admin-secret-heading">
        <div class="vault-panel__heading">
            <div><h2 id="admin-secret-heading">Criar ou rotacionar</h2><p>O novo valor é aceito somente nesta operação e não poderá ser consultado nesta tela.</p></div>
        </div>
        <AuthorizeView Policy="@VaultUiPolicies.AdminManage">
            <Authorized Context="vaultAuthorization">
                <EditForm Model="form" Context="editContext" OnValidSubmit="SaveGlobalAsync" class="vault-form">
                    <DataAnnotationsValidator />
                    @* Keep EditContext notifications and validation explicit while consuming SUI 1.28.0. *@
                    <SUIFormGrid Columns="2" LabelLines="1">
                        <div>
                            <SUITextField T="string" Id="admin-secret-name" Label="Nome lógico" Value="@form.Name"
                                          ValueChanged="value => { form.Name = value ?? string.Empty; editContext.NotifyFieldChanged(new(form, nameof(form.Name))); }"
                                          autocomplete="off" Placeholder="ex.: metrics/victoria-token" />
                            <ValidationMessage For="() => form.Name" />
                        </div>
                        <div>
                            <SUITextField T="string" Id="admin-secret-value" Label="Novo valor" Value="@form.Value"
                                          ValueChanged="value => { form.Value = value ?? string.Empty; editContext.NotifyFieldChanged(new(form, nameof(form.Value))); }"
                                          InputType="password" autocomplete="new-password" />
                            <ValidationMessage For="() => form.Value" />
                        </div>
                    </SUIFormGrid>
                    <div class="vault-form__actions">
                        <SUIButton ButtonTypeValue="SUIButtonType.Submit" Disabled="@saving">@(saving ? "Salvando…" : "Salvar rotação")</SUIButton>
                    </div>
                </EditForm>
            </Authorized>
            <NotAuthorized>
                <p class="vault-panel__hint">Sua permissão permite consultar metadados, mas não criar nem rotacionar segredos.</p>
            </NotAuthorized>
        </AuthorizeView>
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <p class="vault-feedback @(success ? "vault-feedback--success" : "vault-feedback--error")" role="status">@message</p>
        }
    </section>

    <section class="vault-panel" aria-labelledby="admin-list-heading">
        <div class="vault-panel__heading">
            <div><h2 id="admin-list-heading">Segredos globais</h2><p>Credenciais compartilhadas por serviços e rotinas internas.</p></div>
            <SUIStatusBadge ToneValue="SUITone.Info">@globalItems.Count @(globalItems.Count == 1 ? "item" : "itens")</SUIStatusBadge>
        </div>
        @if (loading)
        {
            <div class="vault-loading" aria-label="Carregando segredos globais"></div>
        }
        else if (globalItems.Count == 0)
        {
            <SUIEmptyState Icon="database" Title="Nenhum segredo global" Description="O armazenamento ainda não possui segredos administrativos." />
        }
        else
        {
            <div class="vault-list">
                @foreach (var item in globalItems)
                {
                    <div class="vault-list__item">
                        <span class="vault-list__icon"><SUIIcon Name="lock" Size="18" /></span>
                        <div class="vault-list__copy">
                            <strong>@item.Name</strong>
                            <span>Atualizado por @item.UpdatedBy em @FormatDate(item.UpdatedAtUtc)</span>
                        </div>
                        <AuthorizeView Policy="@VaultUiPolicies.AdminManage">
                            <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" OnClick="() => DeleteGlobalAsync(item.Name)" Disabled="@saving">Remover</SUIButton>
                        </AuthorizeView>
                    </div>
                }
            </div>
        }
    </section>
}
else
{
    <section class="vault-panel" aria-labelledby="vault-users-heading">
        <div class="vault-panel__heading vault-panel__heading--users">
            <div><h2 id="vault-users-heading">Usuários com dados no Vault</h2><p>Inclui contas ativas e resíduos de contas removidas que ainda exigem limpeza.</p></div>
            @if (userPage is not null)
            {
                <span class="vault-result-count">@userPage.TotalUsers @(userPage.TotalUsers == 1 ? "usuário" : "usuários")</span>
            }
        </div>

        <form class="vault-search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
            <div class="vault-search__controls">
                <div class="vault-search-field">
                    <SUIIcon Name="search" Size="18" />
                    <SUITextField T="string" Id="vault-user-search" Label="Buscar usuário" @bind-Value="search"
                              InputType="search" Placeholder="E-mail, nome ou identificador" autocomplete="off" />
                </div>
                <SUIButton ButtonTypeValue="SUIButtonType.Submit" Disabled="@loading">Buscar</SUIButton>
                @if (!string.IsNullOrWhiteSpace(QuerySearch))
                {
                    <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" Href="/vault/admin">Limpar</SUIButton>
                }
            </div>
        </form>

        @if (userPage is not null)
        {
            <dl class="vault-inventory-strip">
                <div><dt>Vaults encontrados</dt><dd>@userPage.TotalUsers</dd></div>
                <div><dt>Segredos pessoais</dt><dd>@userPage.TotalPersonalSecrets</dd></div>
                <div><dt>Credenciais conectadas</dt><dd>@userPage.TotalManagedCredentials</dd></div>
            </dl>
        }

        @if (loading)
        {
            <div class="vault-loading" aria-label="Carregando usuários do Vault"></div>
        }
        else if (!string.IsNullOrWhiteSpace(message) && !success)
        {
            <div class="vault-load-error" role="alert">
                <div><strong>Não foi possível carregar os Vaults</strong><span>@message</span></div>
                <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" OnClick="LoadUsersAsync">Tentar novamente</SUIButton>
            </div>
        }
        else if (userPage is null || userPage.Items.Count == 0)
        {
            <SUIEmptyState Icon="users" Title="Nenhum Vault encontrado" Description="Altere a busca ou aguarde até que uma credencial seja armazenada." />
        }
        else
        {
            <div class="vault-users">
                @foreach (var item in userPage.Items)
                {
                    <a class="vault-user-row" href="@UserDetailUrl(item.OwnerSubject)">
                        <span class="vault-user-row__icon"><SUIIcon Name="users" Size="19" /></span>
                        <span class="vault-user-row__identity">
                            <strong>@UserTitle(item)</strong>
                            <span>@UserSubtitle(item)</span>
                        </span>
                        <span class="vault-user-row__counts">
                            <span>@item.PersonalSecretCount pessoais</span>
                            <span>@item.ManagedCredentialCount conectadas</span>
                        </span>
                        <span class="vault-user-row__activity">@(item.LastUpdatedAtUtc is null ? "Sem data" : $"Atualizado {FormatDate(item.LastUpdatedAtUtc.Value)}")</span>
                        <SUIIcon Name="arrow-right" Size="17" />
                    </a>
                }
            </div>
            @if (TotalPages > 1)
            {
                <nav class="vault-pagination" aria-label="Paginação dos Vaults de usuários">
                    <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" Disabled="@(CurrentPage <= 1)" Href="@(CurrentPage > 1 ? UsersUrl(CurrentPage - 1) : null)">Anterior</SUIButton>
                    <span>Página @CurrentPage de @TotalPages</span>
                    <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" Disabled="@(CurrentPage >= TotalPages)" Href="@(CurrentPage < TotalPages ? UsersUrl(CurrentPage + 1) : null)">Próxima</SUIButton>
                </nav>
            }
        }
    </section>
}

@code {
    private const int PageSize = 25;
    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? QuerySearch { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int QueryPage { get; set; } = 1;

    private readonly AdminSecretForm form = new();
    private IReadOnlyList<ManagementVaultSecret> globalItems = [];
    private VaultUserInventoryPage? userPage;
    private bool loading = true;
    private bool saving;
    private bool success = true;
    private string search = string.Empty;
    private string? message;
    private string? loadedFingerprint;

    private bool IsGlobalView => string.Equals(View, "global", StringComparison.OrdinalIgnoreCase);
    private int CurrentPage => Math.Max(1, QueryPage);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((userPage?.TotalUsers ?? 0) / (double)PageSize));

    protected override async Task OnParametersSetAsync()
    {
        var fingerprint = $"{View}|{QuerySearch}|{QueryPage}";
        if (fingerprint == loadedFingerprint) return;
        loadedFingerprint = fingerprint;
        search = QuerySearch ?? string.Empty;
        message = null;
        if (IsGlobalView) await LoadGlobalAsync(); else await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        loading = true;
        var result = await Data.ListVaultUsersAsync(
            QuerySearch,
            (CurrentPage - 1) * PageSize,
            PageSize);
        success = result.IsSuccess;
        userPage = result.Value;
        message = result.Error;
        loading = false;
    }

    private async Task LoadGlobalAsync()
    {
        loading = true;
        var result = await Data.ListAdminAsync();
        success = result.IsSuccess;
        globalItems = result.Value ?? [];
        message = result.Error;
        loading = false;
    }

    private Task SearchAsync()
    {
        Navigation.NavigateTo(UsersUrl(1, search));
        return Task.CompletedTask;
    }

    private async Task SaveGlobalAsync()
    {
        saving = true;
        message = null;
        var result = await Data.PutAdminAsync(form.Name, form.Value);
        success = result.IsSuccess;
        message = result.IsSuccess ? "Segredo global salvo." : result.Error;
        if (result.IsSuccess)
        {
            form.Value = string.Empty;
            await LoadGlobalAsync();
        }
        saving = false;
    }

    private async Task DeleteGlobalAsync(string name)
    {
        saving = true;
        var result = await Data.DeleteAdminAsync(name);
        success = result.IsSuccess;
        message = result.IsSuccess ? "Segredo global removido." : result.Error;
        if (result.IsSuccess) await LoadGlobalAsync();
        saving = false;
    }

    private string UsersUrl(int page = 1, string? searchValue = null)
    {
        var selectedSearch = searchValue ?? QuerySearch;
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(selectedSearch))
            query.Add($"q={Uri.EscapeDataString(selectedSearch.Trim())}");
        if (page > 1) query.Add($"page={page}");
        return query.Count == 0 ? "/vault/admin" : $"/vault/admin?{string.Join('&', query)}";
    }

    private static string UserDetailUrl(string ownerSubject) =>
        $"/vault/admin/users/{Uri.EscapeDataString(ownerSubject)}";

    private static string UserTitle(VaultUserInventoryItem item) =>
        item.Email ?? item.UserName ?? item.OwnerSubject;

    private static string UserSubtitle(VaultUserInventoryItem item)
    {
        if (!item.UserExists) return $"Conta removida · {item.OwnerSubject}";
        if (!string.IsNullOrWhiteSpace(item.Email)
            && !string.IsNullOrWhiteSpace(item.UserName))
            return $"{item.UserName} · {item.OwnerSubject}";
        return item.OwnerSubject;
    }

    private static string FormatDate(DateTime value) =>
        value.ToLocalTime().ToString("dd/MM/yyyy HH:mm");

    private sealed class AdminSecretForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Informe um nome.")]
        public string Name { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Informe um valor.")]
        public string Value { get; set; } = string.Empty;
    }
}
