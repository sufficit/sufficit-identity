@page "/management/vault"
@attribute [Authorize(Policy = VaultUiPolicies.Admin)]
@rendermode InteractiveServer
@layout VaultLayout
@inject VaultDataSource Data

<PageTitle>Vault administrativo | Sufficit Identity</PageTitle>
<SUIPageHeader Title="Vault administrativo"
            Description="Rotacione segredos nomeados usados por serviços. Os valores nunca aparecem na listagem.">
    <Actions><SUIStatusBadge Tone="warning" Icon="shield">Capability protegida</SUIStatusBadge></Actions>
</SUIPageHeader>

<div class="vault-note vault-note--warning" role="note"><SUIIcon Name="alert" Size="20" /><div><strong>Operação de alto impacto.</strong><span>Substituir um segredo altera o próximo consumidor que o resolver. Registre a finalidade no nome e faça a rotação de forma controlada.</span></div></div>

<section class="vault-panel" aria-labelledby="admin-secret-heading">
    <div class="vault-panel__heading"><div><h2 id="admin-secret-heading">Criar ou rotacionar</h2><p>O valor é aceito somente nesta operação.</p></div></div>
    <EditForm Model="form" OnValidSubmit="SaveAsync" class="vault-form"><DataAnnotationsValidator /><div class="vault-form__grid"><div class="vault-field"><label for="admin-secret-name">Nome lógico</label><InputText id="admin-secret-name" @bind-Value="form.Name" autocomplete="off" placeholder="ex.: metrics/victoria-token" /><ValidationMessage For="() => form.Name" /></div><div class="vault-field"><label for="admin-secret-value">Novo valor</label><InputText id="admin-secret-value" type="password" @bind-Value="form.Value" autocomplete="new-password" /><ValidationMessage For="() => form.Value" /></div></div><div class="vault-form__actions"><button class="vault-button vault-button--primary" type="submit" disabled="@saving">@(saving ? "Salvando…" : "Salvar rotação")</button></div></EditForm>
    @if (!string.IsNullOrWhiteSpace(message)) { <p class="vault-feedback @(success ? "vault-feedback--success" : "vault-feedback--error")" role="status">@message</p> }
</section>

<section class="vault-panel" aria-labelledby="admin-list-heading">
    <div class="vault-panel__heading"><div><h2 id="admin-list-heading">Segredos nomeados</h2><p>Somente metadados e data da última alteração.</p></div><SUIStatusBadge Tone="info">@items.Count @(items.Count == 1 ? "item" : "itens")</SUIStatusBadge></div>
    @if (loading) { <div class="vault-loading" aria-label="Carregando segredos"></div> }
    else if (items.Count == 0) { <SUIEmptyState Icon="database" Title="Nenhum segredo nomeado" Description="O armazenamento ainda não possui segredos administrativos." /> }
    else { <div class="vault-list">@foreach (var item in items) { <div class="vault-list__item"><span class="vault-list__icon"><SUIIcon Name="lock" Size="18" /></span><div class="vault-list__copy"><strong>@item.Name</strong><span>Atualizado por @item.UpdatedBy em @item.UpdatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></div><button class="vault-button vault-button--quiet" type="button" @onclick="() => DeleteAsync(item.Name)" disabled="@saving">Remover</button></div> }</div> }
</section>

@code {
    private readonly AdminSecretForm form = new();
    private IReadOnlyList<ManagementVaultSecret> items = [];
    private bool loading = true;
    private bool saving;
    private bool success;
    private string? message;

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        loading = true;
        var result = await Data.ListAdminAsync();
        if (result.IsSuccess) items = result.Value ?? [];
        else { items = []; message = result.Error; success = false; }
        loading = false;
    }
    private async Task SaveAsync()
    {
        saving = true; message = null;
        var result = await Data.PutAdminAsync(form.Name, form.Value);
        success = result.IsSuccess;
        message = result.IsSuccess ? "Segredo administrativo salvo." : result.Error;
        if (result.IsSuccess) { form.Value = string.Empty; await LoadAsync(); }
        saving = false;
    }
    private async Task DeleteAsync(string name)
    {
        saving = true;
        var result = await Data.DeleteAdminAsync(name);
        success = result.IsSuccess;
        message = result.IsSuccess ? "Segredo removido." : result.Error;
        if (result.IsSuccess) await LoadAsync();
        saving = false;
    }
    private sealed class AdminSecretForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Informe um nome.")]
        public string Name { get; set; } = string.Empty;
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Informe um valor.")]
        public string Value { get; set; } = string.Empty;
    }
}
