@page "/vault/admin/users/{OwnerSubject}"
@attribute [Authorize(Policy = VaultUiPolicies.Admin)]
@rendermode InteractiveServer
@layout VaultLayout
@inject VaultDataSource Data

<PageTitle>@L["Vault.AdminUserVault.DefaultTitle"].Value | Sufficit Identity</PageTitle>

<a class="vault-back-link" href="/vault/admin"><SUIIcon Name="arrow-left" Size="16" /> @L["Vault.AdminUserVault.BackLink"]</a>

<SUIPageHeader Title="@PageTitleText"
            Description="@L["Vault.AdminUserVault.Description"].Value">
    <Actions>
        @if (detail is not null && !detail.User.UserExists)
        {
            <SUIStatusBadge ToneValue="SUITone.Warning" Icon="alert">@L["Vault.AdminUserVault.AccountRemoved"]</SUIStatusBadge>
        }
        else
        {
            <SUIStatusBadge ToneValue="SUITone.Info" Icon="shield">@L["Vault.AdminUserVault.MetadataProtected"]</SUIStatusBadge>
        }
    </Actions>
</SUIPageHeader>

@if (loading)
{
    <div class="vault-panel"><div class="vault-loading" aria-label="@L["Vault.AdminUserVault.LoadingAriaLabel"].Value"></div></div>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="vault-load-error" role="alert">
        <div><strong>@L["Vault.AdminUserVault.LoadErrorTitle"]</strong><span>@loadError</span></div>
        <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" OnClick="LoadAsync">@L["Vault.Common.Retry"]</SUIButton>
    </div>
}
else if (detail is null)
{
    @if (!string.IsNullOrWhiteSpace(feedback))
    {
        <p class="vault-feedback vault-feedback--success" role="status">@feedback</p>
    }
    <section class="vault-panel">
        <SUIEmptyState Icon="users" Title="@L["Vault.AdminUserVault.NotFoundTitle"].Value" Description="@L["Vault.AdminUserVault.NotFoundDescription"].Value">
            <Actions><SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" Href="/vault/admin">@L["Vault.AdminUserVault.BackToManagement"]</SUIButton></Actions>
        </SUIEmptyState>
    </section>
}
else
{
    <section class="vault-user-summary" aria-label="@L["Vault.AdminUserVault.IdentificationAriaLabel"].Value">
        <span class="vault-user-summary__icon"><SUIIcon Name="users" Size="21" /></span>
        <div>
            <strong>@(detail.User.Email ?? detail.User.UserName ?? detail.User.OwnerSubject)</strong>
            <span>@IdentityDescription(detail.User)</span>
        </div>
        <dl>
            <div><dt>@L["Vault.AdminUserVault.PersonalLabel"]</dt><dd>@detail.User.PersonalSecretCount</dd></div>
            <div><dt>@L["Vault.AdminUserVault.ConnectedLabel"]</dt><dd>@detail.User.ManagedCredentialCount</dd></div>
            <div><dt>@L["Vault.AdminUserVault.LastActivityLabel"]</dt><dd>@(detail.User.LastUpdatedAtUtc is null ? L["Vault.Common.NoDate"].Value : FormatDate(detail.User.LastUpdatedAtUtc.Value))</dd></div>
        </dl>
    </section>

    <div class="vault-note" role="note">
        <SUIIcon Name="info" Size="20" />
        <div><strong>@L["Vault.AdminUserVault.NoPasswordShown"]</strong><span>@L["Vault.AdminUserVault.NoteBody"]</span></div>
    </div>

    @if (!string.IsNullOrWhiteSpace(feedback))
    {
        <p class="vault-feedback @(operationSucceeded ? "vault-feedback--success" : "vault-feedback--error")" role="status">@feedback</p>
    }

    <section class="vault-panel" aria-labelledby="managed-credentials-heading">
        <div class="vault-panel__heading">
            <div><h2 id="managed-credentials-heading">@L["Vault.AdminUserVault.ManagedCredentialsHeading"]</h2><p>@L["Vault.AdminUserVault.ManagedCredentialsDescription"]</p></div>
            <SUIStatusBadge ToneValue="SUITone.Info">@detail.ManagedCredentials.Count</SUIStatusBadge>
        </div>
        @if (detail.ManagedCredentials.Count == 0)
        {
            <SUIEmptyState Icon="key" Title="@L["Vault.AdminUserVault.ManagedCredentialsEmptyTitle"].Value" Description="@L["Vault.AdminUserVault.ManagedCredentialsEmptyDescription"].Value" />
        }
        else
        {
            <div class="vault-list">
                @foreach (var item in detail.ManagedCredentials)
                {
                    var actionKey = $"managed:{item.Name}";
                    <div class="vault-list__item vault-list__item--managed">
                        <span class="vault-list__icon"><SUIIcon Name="key" Size="18" /></span>
                        <div class="vault-list__copy">
                            <strong>@(item.Provider is null ? item.Name : ProviderLabel(item.Provider))</strong>
                            <span>@string.Format(L["Vault.AdminUserVault.ManagedCredentialMeta"].Value, item.Name, FormatDate(item.UpdatedAtUtc))</span>
                        </div>
                        <div class="vault-list__status">
                            @if (item.ExpiresAtUtc is { } expiration)
                            {
                                <span>@string.Format(L["Vault.AdminUserVault.ExpiresOn"].Value, FormatDate(expiration))</span>
                            }
                            else
                            {
                                <span>@L["Vault.AdminUserVault.NoExpirationInfo"]</span>
                            }
                        </div>
                        <AuthorizeView Policy="@VaultUiPolicies.AdminManage">
                            @if (pendingAction == actionKey)
                            {
                                <div class="vault-confirm" role="group" aria-label="@L["Vault.AdminUserVault.ConfirmRemovalAriaLabel"].Value">
                                    <span>@L["Vault.AdminUserVault.RemoveQuestion"]</span>
                                    <SUIButton ColorValue="SUIColor.Error" OnClick="() => DeleteManagedAsync(item.Name)" Disabled="@working">@L["Vault.Common.Confirm"]</SUIButton>
                                    <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" OnClick="CancelConfirmation" Disabled="@working">@L["Vault.Common.Cancel"]</SUIButton>
                                </div>
                            }
                            else
                            {
                                <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" OnClick="() => Confirm(actionKey)" Disabled="@working">@L["Vault.Common.Remove"]</SUIButton>
                            }
                        </AuthorizeView>
                    </div>
                }
            </div>
        }
    </section>

    <section class="vault-panel" aria-labelledby="personal-secrets-heading">
        <div class="vault-panel__heading">
            <div><h2 id="personal-secrets-heading">@L["Vault.AdminUserVault.PersonalSecretsHeading"]</h2><p>@L["Vault.AdminUserVault.PersonalSecretsDescription"]</p></div>
            <SUIStatusBadge ToneValue="SUITone.Info">@detail.PersonalSecrets.Count</SUIStatusBadge>
        </div>
        @if (detail.PersonalSecrets.Count == 0)
        {
            <SUIEmptyState Icon="lock" Title="@L["Vault.AdminUserVault.PersonalSecretsEmptyTitle"].Value" Description="@L["Vault.AdminUserVault.PersonalSecretsEmptyDescription"].Value" />
        }
        else
        {
            <div class="vault-list">
                @foreach (var item in detail.PersonalSecrets)
                {
                    var actionKey = $"personal:{item.Namespace}:{item.Name}";
                    <div class="vault-list__item">
                        <span class="vault-list__icon"><SUIIcon Name="lock" Size="18" /></span>
                        <div class="vault-list__copy">
                            <strong>@item.Name</strong>
                            <span>@string.Format(L["Vault.AdminUserVault.PersonalSecretMeta"].Value, item.Namespace, FormatDate(item.UpdatedAtUtc))</span>
                        </div>
                        <AuthorizeView Policy="@VaultUiPolicies.AdminManage">
                            @if (pendingAction == actionKey)
                            {
                                <div class="vault-confirm" role="group" aria-label="@L["Vault.AdminUserVault.ConfirmRemovalAriaLabel"].Value">
                                    <span>@L["Vault.AdminUserVault.RemoveQuestion"]</span>
                                    <SUIButton ColorValue="SUIColor.Error" OnClick="() => DeletePersonalAsync(item.Namespace, item.Name)" Disabled="@working">@L["Vault.Common.Confirm"]</SUIButton>
                                    <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" OnClick="CancelConfirmation" Disabled="@working">@L["Vault.Common.Cancel"]</SUIButton>
                                </div>
                            }
                            else
                            {
                                <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" OnClick="() => Confirm(actionKey)" Disabled="@working">@L["Vault.Common.Remove"]</SUIButton>
                            }
                        </AuthorizeView>
                    </div>
                }
            </div>
        }
    </section>

    <AuthorizeView Policy="@VaultUiPolicies.AdminManage">
        <section class="vault-danger-zone" aria-labelledby="vault-cleanup-heading">
            <div>
                <h2 id="vault-cleanup-heading">@L["Vault.AdminUserVault.CleanupHeading"]</h2>
                <p>@L["Vault.AdminUserVault.CleanupDescription"]</p>
            </div>
            @if (confirmClear)
            {
                <div class="vault-danger-zone__confirm" role="group" aria-label="@L["Vault.AdminUserVault.CleanupConfirmAriaLabel"].Value">
                    <strong>@L["Vault.AdminUserVault.CleanupIrreversible"]</strong>
                    <div>
                        <SUIButton ColorValue="SUIColor.Error" OnClick="ClearAsync" Disabled="@working">@(working ? L["Vault.AdminUserVault.Clearing"].Value : L["Vault.AdminUserVault.ConfirmCleanup"].Value)</SUIButton>
                        <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" OnClick="CancelClear" Disabled="@working">@L["Vault.Common.Cancel"]</SUIButton>
                    </div>
                </div>
            }
            else
            {
                <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Error" OnClick="RequestClear" Disabled="@(working || TotalItems == 0)">@L["Vault.AdminUserVault.ClearCredentials"]</SUIButton>
            }
        </section>
    </AuthorizeView>
}

@code {
    [Parameter] public string OwnerSubject { get; set; } = string.Empty;

    private VaultUserDetail? detail;
    private bool loading = true;
    private bool working;
    private bool operationSucceeded;
    private bool confirmClear;
    private string? pendingAction;
    private string? feedback;
    private string? loadError;

    private string PageTitleText => detail is null
        ? L["Vault.AdminUserVault.DefaultTitle"].Value
        : detail.User.Email ?? detail.User.UserName ?? L["Vault.AdminUserVault.DefaultTitle"].Value;
    private int TotalItems => detail is null
        ? 0
        : detail.PersonalSecrets.Count + detail.ManagedCredentials.Count;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        loadError = null;
        var result = await Data.LoadVaultUserAsync(OwnerSubject);
        if (result.IsSuccess) detail = result.Value;
        else
        {
            detail = null;
            loadError = result.Error;
        }
        loading = false;
    }

    private void Confirm(string actionKey)
    {
        pendingAction = actionKey;
        confirmClear = false;
        feedback = null;
    }

    private void CancelConfirmation() => pendingAction = null;

    private void RequestClear()
    {
        confirmClear = true;
        pendingAction = null;
        feedback = null;
    }

    private void CancelClear() => confirmClear = false;

    private async Task DeleteManagedAsync(string name)
    {
        working = true;
        var result = await Data.DeleteVaultUserManagedAsync(OwnerSubject, name);
        await FinishMutationAsync(result, L["Vault.AdminUserVault.ManagedCredentialRemoved"].Value);
    }

    private async Task DeletePersonalAsync(string @namespace, string name)
    {
        working = true;
        var result = await Data.DeleteVaultUserPersonalAsync(
            OwnerSubject,
            @namespace,
            name);
        await FinishMutationAsync(result, L["Vault.AdminUserVault.PersonalSecretRemoved"].Value);
    }

    private async Task FinishMutationAsync(VaultDataResult<bool> result, string successMessage)
    {
        operationSucceeded = result.IsSuccess;
        feedback = result.IsSuccess ? successMessage : result.Error;
        pendingAction = null;
        working = false;
        if (result.IsSuccess) await LoadAsync();
    }

    private async Task ClearAsync()
    {
        working = true;
        var result = await Data.ClearVaultUserAsync(OwnerSubject);
        operationSucceeded = result.IsSuccess;
        feedback = result.IsSuccess && result.Value is { } cleanup
            ? string.Format(
                L["Vault.AdminUserVault.VaultCleared"].Value,
                cleanup.PersonalSecretsDeleted,
                cleanup.ManagedCredentialsDeleted)
            : result.Error;
        confirmClear = false;
        working = false;
        if (result.IsSuccess) await LoadAsync();
    }

    private string IdentityDescription(VaultUserInventoryItem item)
    {
        var prefix = item.UserExists
            ? L["Vault.AdminUserVault.IdentifierPrefix"].Value
            : L["Vault.AdminUserVault.AccountNotFoundIdentifierPrefix"].Value;
        return $"{prefix} {item.OwnerSubject}";
    }

    private string ProviderLabel(string provider) =>
        provider.Length == 0
            ? L["Vault.AdminUserVault.ConnectedIntegration"].Value
            : char.ToUpperInvariant(provider[0]) + provider[1..];

    private static string FormatDate(DateTime value) =>
        value.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
}
