@page "/vault"
@attribute [Authorize(Policy = VaultUiPolicies.User)]
@rendermode InteractiveServer
@layout VaultLayout
@inject VaultDataSource Data
@inject ISUIToast Toast
@inject ISUIDialogService Dialogs

<PageTitle>@L["Vault.UserVault.PageTitle"].Value | Sufficit Identity</PageTitle>
<div class="vault-personal">
    <SUIPageHeader Title="@L["Vault.UserVault.PageTitle"].Value"
                   Description="@L["Vault.UserVault.Description"].Value">
        <Actions>
            <SUIButton StartIcon="plus" ColorValue="SUIColor.Primary"
                       aria-expanded="@showEditor.ToString().ToLowerInvariant()" Disabled="@saving"
                       OnClick="ToggleEditor">@L["Vault.Personal.Add"]</SUIButton>
        </Actions>
    </SUIPageHeader>
    <SUIToastHost />

    <SUIAlert ToneValue="SUITone.Info" Icon="shield" Class="vault-personal-notice" role="note">
        <div class="vault-personal-notice__content">
            <div>
                <strong>@L["Vault.Reveal.NoticeTitle"]</strong>
                <p>@L["Vault.Reveal.NoticeBody"]</p>
            </div>
            <SUIStatusBadge ToneValue="SUITone.Info" Icon="lock">@L["Vault.Personal.TwoFactor"]</SUIStatusBadge>
        </div>
    </SUIAlert>

    <AuthorizeView Policy="@VaultUiPolicies.Admin">
        <Authorized>
            <SUIAlert ToneValue="SUITone.Warning" Icon="shield" role="region" aria-labelledby="vault-admin-entry-heading" Class="vault-admin-entry">
                <div class="vault-alert-row">
                    <div>
                        <strong id="vault-admin-entry-heading">@L["Vault.UserVault.AdminEntryHeading"]</strong>
                        <p>@L["Vault.UserVault.AdminEntryBody"]</p>
                    </div>
                    <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Warning" Href="/vault/admin">
                        @L["Vault.UserVault.OpenAdminVault"]
                        <SUIIcon Name="arrow-right" Size="16" />
                    </SUIButton>
                </div>
            </SUIAlert>
        </Authorized>
    </AuthorizeView>

    @if (!string.IsNullOrWhiteSpace(loadError))
    {
        <SUIAlert ToneValue="SUITone.Danger" Icon="alert">
            <div class="vault-alert-row">
                <div><strong>@L["Vault.UserVault.LoadErrorTitle"]</strong><p>@loadError</p></div>
                <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" OnClick="LoadAsync" Disabled="@loading">@L["Vault.Common.Retry"]</SUIButton>
            </div>
        </SUIAlert>
    }

    @if (showEditor)
    {
        <div tabindex="-1" @ref="editorRegion">
            <SUICard Elevation="0" Class="vault-personal-editor">
                <SUICardHeader Title="@L["Vault.UserVault.AddOrReplaceHeading"].Value"
                               Description="@PersonalSecretHint">
                    <MetaContent><SUIStatusBadge ToneValue="SUITone.Neutral">@L["Vault.UserVault.PersonalNamespaceBadge"]</SUIStatusBadge></MetaContent>
                </SUICardHeader>
                <EditForm Model="form" @key="form" Context="editContext" OnValidSubmit="SaveAsync" aria-busy="@saving">
                    <DataAnnotationsValidator />
                    <SUICardContent>
                        @* ValueChanged notifies the EditContext and ValidationMessage stays explicit (see docs/frontend/EVALUATION-SUI-ADOPTION.md). *@
                        <SUIFormGrid Columns="2" LabelLines="1">
                            <div>
                                <IdentityTextField T="string" Id="personal-secret-name" Label="@L["Vault.UserVault.NameLabel"].Value" Value="@form.Name"
                                              ValueChanged="value => { form.Name = value ?? string.Empty; editContext.NotifyFieldChanged(new(form, nameof(form.Name))); }"
                                              autocomplete="off" Placeholder="@L["Vault.UserVault.NamePlaceholder"].Value" MaxLength="128" HelperText="@L["Vault.UserVault.NameHelperText"].Value" />
                                <ValidationMessage For="() => form.Name" />
                            </div>
                            <div>
                                <IdentityTextField T="string" Id="personal-secret-value" Label="@L["Vault.UserVault.ValueLabel"].Value" Value="@form.Value"
                                              ValueChanged="value => { form.Value = value ?? string.Empty; editContext.NotifyFieldChanged(new(form, nameof(form.Value))); }"
                                              InputType="password" Revealable="true" RevealText="@L["Vault.Common.RevealValue"].Value" HideText="@L["Vault.Common.HideValue"].Value" autocomplete="new-password" MaxLength="16384" Placeholder="@L["Vault.UserVault.ValuePlaceholder"].Value" />
                                <ValidationMessage For="() => form.Value" />
                            </div>
                        </SUIFormGrid>
                    </SUICardContent>
                    <SUICardActions AlignEnd="true">
                        <SUIButton VariantValue="SUIVariant.Text" ColorValue="SUIColor.Default" OnClick="CloseEditor"
                                   Disabled="@saving">@L["Vault.Personal.Cancel"]</SUIButton>
                        <SUIButton ButtonTypeValue="SUIButtonType.Submit" Disabled="@saving">
                            @(saving ? L["Vault.Common.Saving"].Value : L["Vault.UserVault.SaveSecret"].Value)
                        </SUIButton>
                    </SUICardActions>
                </EditForm>
            </SUICard>
        </div>
    }

    <SUIDialogHost CloseLabel="@L["Vault.Reveal.Close"].Value" />
    @* Seed request verification when the page is prerendered. The dialog opens on the circuit. *@
    <div hidden><AntiforgeryToken /></div>
    <div class="vault-personal-workspace">
        <SUICard Elevation="0" Class="vault-personal-inventory" aria-busy="@loading">
            <SUICardHeader Title="@L["Vault.UserVault.AddedSecretsHeading"].Value"
                           Description="@L["Vault.UserVault.AddedSecretsDescription"].Value">
                <MetaContent>
                    @if (!loading && loadError is null)
                    {
                        <SUIChip SizeValue="SUISize.Small">@personalSecrets.Count</SUIChip>
                    }
                </MetaContent>
            </SUICardHeader>
            @if (loading)
            {
                <SUICardContent aria-label="@L["Vault.UserVault.LoadingPersonalAriaLabel"].Value">
                    <SUISkeletonLoader Type="SUISkeletonType.Table" Rows="4" />
                </SUICardContent>
            }
            else if (loadError is null && personalSecrets.Count == 0)
            {
                <SUIEmptyState Icon="key" Title="@L["Vault.UserVault.NoSecretAddedTitle"].Value"
                               Description="@L["Vault.UserVault.NoSecretAddedDescription"].Value" />
            }
            else if (loadError is null)
            {
                <div class="vault-personal-toolbar">
                    <SUITextField TValue="string" Value="@search" ValueChanged="SetSearch"
                                  Immediate="true" AdornmentIcon="search" MaxLength="128"
                                  Placeholder="@L["Vault.Personal.Search"].Value"
                                  aria-label="@L["Vault.Personal.Search"].Value" />
                    <div class="vault-personal-filters" role="group" aria-label="@L["Vault.Personal.Filters"].Value">
                        @foreach (var option in Enum.GetValues<SecretFilter>())
                        {
                            <SUIButton Class="vault-personal-filter" SizeValue="SUISize.Small"
                                       ColorValue="@(filter == option ? SUIColor.Primary : SUIColor.Default)"
                                       VariantValue="@(filter == option ? SUIVariant.Filled : SUIVariant.Outlined)"
                                       aria-pressed="@((filter == option).ToString().ToLowerInvariant())"
                                       OnClick="() => SetFilter(option)">@L[$"Vault.Personal.Filter.{option}"]</SUIButton>
                        }
                    </div>
                </div>
                @if (visibleSecrets.Count == 0)
                {
                    <SUIEmptyState Icon="search" Title="@L["Vault.Personal.NoResults"].Value" />
                }
                else
                {
                    <ul class="vault-personal-list">
                        @foreach (var item in visibleSecrets)
                        {
                            var kind = KindOf(item.Name);
                            <li @key="item.Name">
                                <SUIButton Class="vault-secret-row" VariantValue="SUIVariant.Text" ColorValue="SUIColor.Default"
                                           aria-controls="vault-selected-secret"
                                           aria-current="@(selected == item ? "true" : null)"
                                           OnClick="() => SelectSecret(item)">
                                    <span class="vault-secret-row__body">
                                        <span class="@IconClass(kind)"><SUIIcon Name="@KindIcon(kind)" Size="19" /></span>
                                        <code>@item.Name</code>
                                        <SUIChip SizeValue="SUISize.Small" ColorValue="@KindColor(kind)">@L[$"Vault.Personal.Kind.{kind}"]</SUIChip>
                                        <SUIIcon Name="chevron-right" Size="16" />
                                    </span>
                                </SUIButton>
                            </li>
                        }
                    </ul>
                }
            }
        </SUICard>
        <aside class="vault-personal-sidebar">
            @if (!loading && selected is { } item)
            {
                var kind = KindOf(item.Name);
                <SUICard Elevation="0" Class="vault-secret-detail" id="vault-selected-secret"
                         aria-labelledby="vault-selected-secret-title">
                    <div class="vault-secret-detail__top">
                        <span class="@IconClass(kind)"><SUIIcon Name="@KindIcon(kind)" Size="23" /></span>
                        <SUIChip SizeValue="SUISize.Small" ColorValue="@KindColor(kind)">@L[$"Vault.Personal.Kind.{kind}"]</SUIChip>
                        <SUIButton Class="vault-secret-detail__more" VariantValue="SUIVariant.Text" ColorValue="SUIColor.Default"
                                   aria-label="@L["Vault.Personal.More"].Value" aria-expanded="@showActions.ToString().ToLowerInvariant()"
                                   Disabled="@saving" OnClick="ToggleActions"><SUIIcon Name="more-vertical" Size="19" /></SUIButton>
                    </div>
                    <h2 id="vault-selected-secret-title" tabindex="-1" @ref="selectedHeading"><code>@item.Name</code></h2>
                    @if (showActions)
                    {
                        <div class="vault-secret-detail__actions">
                            @if (confirmRemoval)
                            {
                                <p role="alert">@L["Vault.Personal.ConfirmRemove"]</p>
                                <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" Disabled="@saving"
                                           OnClick="() => confirmRemoval = false">@L["Vault.Personal.Cancel"]</SUIButton>
                                <SUIButton ColorValue="SUIColor.Error" StartIcon="trash" Disabled="@saving"
                                           OnClick="() => DeleteAsync(item.Name)">@L["Vault.Common.Remove"]</SUIButton>
                            }
                            else
                            {
                                <SUIButton StartIcon="key" VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default"
                                           OnClick="() => OpenEditor(item.Name)">@L["Vault.Personal.Replace"]</SUIButton>
                                <SUIButton StartIcon="trash" VariantValue="SUIVariant.Text" ColorValue="SUIColor.Error"
                                           OnClick="() => confirmRemoval = true">@L["Vault.Common.Remove"]</SUIButton>
                            }
                        </div>
                    }
                    <div class="vault-secret-detail__updated">
                        <SUIIcon Name="clock" Size="17" />
                        <div><strong>@L["Vault.Personal.LastUpdated"]</strong><TimeInText Text="@TimeInText.Slot" Instant="@Utc(item.UpdatedAtUtc)" /></div>
                    </div>
                    <div class="vault-secret-detail__value-label">@L["Vault.Reveal.Value"]</div>
                    <div class="vault-secret-detail__mask">
                        <span aria-hidden="true">••••••••••••••••</span>
                        <span class="vault-personal-sr-only">@L["Vault.Personal.ValueHidden"]</span>
                        <SUIIcon Name="lock" Size="17" />
                    </div>
                    <SUIButton Class="vault-secret-detail__reveal" ColorValue="SUIColor.Primary" StartIcon="eye"
                               aria-haspopup="dialog" aria-label="@L["Vault.Reveal.ForName", item.Name].Value"
                               Disabled="@saving" OnClick="() => RevealAsync(item.Name)">@L["Vault.Personal.Reveal"]</SUIButton>
                </SUICard>
            }
            @if (!loading && loadError is null)
            {
                <VaultConnectedCredentials Items="@managedCredentials" />
            }
        </aside>
    </div>
</div>
