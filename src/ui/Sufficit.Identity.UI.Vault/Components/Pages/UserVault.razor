@page "/vault"
@attribute [Authorize(Policy = VaultUiPolicies.User)]
@rendermode InteractiveServer
@layout VaultLayout
@inject VaultDataSource Data
@inject ISUIToast Toast

<PageTitle>@L["Vault.UserVault.PageTitle"].Value | Sufficit Identity</PageTitle>
<SUIPageHeader Title="@L["Vault.UserVault.PageTitle"].Value"
            Description="@L["Vault.UserVault.Description"].Value">
    <Actions><SUIStatusBadge ToneValue="SUITone.Success" Icon="shield">@L["Vault.UserVault.EncryptedBadge"]</SUIStatusBadge></Actions>
</SUIPageHeader>

@* Pages are their own interactive islands when embedded in the public UI
   (per-page render mode), so the toast host lives with the page. *@
<SUIToastHost />

<SUIAlert ToneValue="SUITone.Info" Icon="lock" role="note">
    <strong>@L["Vault.UserVault.MetadataOnlyTitle"]</strong> @L["Vault.UserVault.MetadataOnlyBody"]
</SUIAlert>

<AuthorizeView Policy="@VaultUiPolicies.Admin">
    <Authorized>
        <SUIAlert ToneValue="SUITone.Warning" Icon="shield" role="region" aria-labelledby="vault-admin-entry-heading" Class="vault-admin-entry">
            <div class="vault-alert-row">
                <div>
                    <strong id="vault-admin-entry-heading">@L["Vault.UserVault.AdminEntryHeading"]</strong>
                    <p>@L["Vault.UserVault.AdminEntryBody"]</p>
                </div>
                <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Warning" Href="/vault/admin">
                    @L["Vault.UserVault.OpenAdminVault"]
                    <SUIIcon Name="arrow-right" Size="16" />
                </SUIButton>
            </div>
        </SUIAlert>
    </Authorized>
</AuthorizeView>

@if (!string.IsNullOrWhiteSpace(loadError))
{
    <SUIAlert ToneValue="SUITone.Danger" Icon="alert">
        <div class="vault-alert-row">
            <div><strong>@L["Vault.UserVault.LoadErrorTitle"]</strong><p>@loadError</p></div>
            <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" OnClick="LoadAsync" Disabled="@loading">@L["Vault.Common.Retry"]</SUIButton>
        </div>
    </SUIAlert>
}

<SUICard Elevation="0" aria-busy="@loading">
    <SUICardHeader Title="@L["Vault.UserVault.ManagedCredentialHeading"].Value" Description="@L["Vault.UserVault.ManagedCredentialDescription"].Value">
        <MetaContent><SUIStatusBadge ToneValue="SUITone.Info">@managedCredentials.Count @(managedCredentials.Count == 1 ? L["Vault.UserVault.CredentialSingular"].Value : L["Vault.UserVault.CredentialPlural"].Value)</SUIStatusBadge></MetaContent>
    </SUICardHeader>
    @if (loading)
    {
        <SUICardContent aria-label="@L["Vault.UserVault.LoadingManagedAriaLabel"].Value"><SUISkeletonLoader Type="SUISkeletonType.Table" Rows="2" /></SUICardContent>
    }
    else if (string.IsNullOrWhiteSpace(loadError) && managedCredentials.Count == 0)
    {
        <SUIEmptyState Icon="key" Title="@L["Vault.UserVault.NoManagedCredentialTitle"].Value" Description="@L["Vault.UserVault.NoManagedCredentialDescription"].Value" />
    }
    else if (string.IsNullOrWhiteSpace(loadError))
    {
        <div class="vault-list">
            @foreach (var item in managedCredentials)
            {
                <div class="vault-list__item vault-list__item--managed">
                    <span class="vault-list__icon"><SUIIcon Name="key" Size="18" /></span>
                    <div class="vault-list__copy">
                        <strong>@CredentialDisplayName(item)</strong>
                        <span><TimeInText Text="@CredentialDescription(item)" Instant="@Utc(item.UpdatedAtUtc)" /></span>
                    </div>
                    <div class="vault-list__status">
                        @if (IsExpired(item))
                        {
                            <SUIStatusBadge ToneValue="SUITone.Warning">@L["Vault.UserVault.ExpiredBadge"]</SUIStatusBadge>
                        }
                        else
                        {
                            <SUIStatusBadge ToneValue="SUITone.Success">@L["Vault.UserVault.ActiveBadge"]</SUIStatusBadge>
                        }
                        <span>@L["Vault.UserVault.ManagedByApp"]</span>
                    </div>
                </div>
            }
        </div>
        <SUICardActions><span class="vault-card-hint">@L["Vault.UserVault.ManagedRemoveHint"]</span></SUICardActions>
    }
</SUICard>

<SUICard Elevation="0">
    <SUICardHeader Title="@L["Vault.UserVault.AddOrReplaceHeading"].Value"
                   Description="@PersonalSecretHint">
        <MetaContent><SUIStatusBadge ToneValue="SUITone.Neutral">@L["Vault.UserVault.PersonalNamespaceBadge"]</SUIStatusBadge></MetaContent>
    </SUICardHeader>
    <EditForm Model="form" Context="editContext" OnValidSubmit="SaveAsync" aria-busy="@saving">
        <DataAnnotationsValidator />
        <SUICardContent>
            @* ValueChanged notifies the EditContext and ValidationMessage stays explicit (see docs/frontend/EVALUATION-SUI-ADOPTION.md). *@
            <SUIFormGrid Columns="2" LabelLines="1">
                <div>
                    <IdentityTextField T="string" Id="personal-secret-name" Label="@L["Vault.UserVault.NameLabel"].Value" Value="@form.Name"
                                  ValueChanged="value => { form.Name = value ?? string.Empty; editContext.NotifyFieldChanged(new(form, nameof(form.Name))); }"
                                  autocomplete="off" Placeholder="@L["Vault.UserVault.NamePlaceholder"].Value" MaxLength="128" HelperText="@L["Vault.UserVault.NameHelperText"].Value" />
                    <ValidationMessage For="() => form.Name" />
                </div>
                <div>
                    <IdentityTextField T="string" Id="personal-secret-value" Label="@L["Vault.UserVault.ValueLabel"].Value" Value="@form.Value"
                                  ValueChanged="value => { form.Value = value ?? string.Empty; editContext.NotifyFieldChanged(new(form, nameof(form.Value))); }"
                                  InputType="password" autocomplete="new-password" MaxLength="16384" Placeholder="@L["Vault.UserVault.ValuePlaceholder"].Value" />
                    <ValidationMessage For="() => form.Value" />
                </div>
            </SUIFormGrid>
        </SUICardContent>
        <SUICardActions AlignEnd="true"><SUIButton ButtonTypeValue="SUIButtonType.Submit" Disabled="@saving">@(saving ? L["Vault.Common.Saving"].Value : L["Vault.UserVault.SaveSecret"].Value)</SUIButton></SUICardActions>
    </EditForm>
</SUICard>

<SUICard Elevation="0">
    <SUICardHeader Title="@L["Vault.UserVault.AddedSecretsHeading"].Value" Description="@L["Vault.UserVault.AddedSecretsDescription"].Value">
        <MetaContent><SUIStatusBadge ToneValue="SUITone.Info">@personalSecrets.Count @(personalSecrets.Count == 1 ? L["Vault.Common.ItemSingular"].Value : L["Vault.Common.ItemPlural"].Value)</SUIStatusBadge></MetaContent>
    </SUICardHeader>
    @if (loading) { <SUICardContent aria-label="@L["Vault.UserVault.LoadingPersonalAriaLabel"].Value"><SUISkeletonLoader Type="SUISkeletonType.Table" Rows="2" /></SUICardContent> }
    else if (string.IsNullOrWhiteSpace(loadError) && personalSecrets.Count == 0) { <SUIEmptyState Icon="key" Title="@L["Vault.UserVault.NoSecretAddedTitle"].Value" Description="@L["Vault.UserVault.NoSecretAddedDescription"].Value" /> }
    else if (string.IsNullOrWhiteSpace(loadError))
    {
        <div class="vault-list">
            @foreach (var item in personalSecrets)
            {
                <div class="vault-list__item"><span class="vault-list__icon"><SUIIcon Name="key" Size="18" /></span><div class="vault-list__copy"><strong>@item.Name</strong><span><TimeInText Text="@string.Format(L["Vault.UserVault.UpdatedOn"].Value, TimeInText.Slot)" Instant="@Utc(item.UpdatedAtUtc)" /></span></div><SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" OnClick="() => DeleteAsync(item.Name)" Disabled="@saving">@L["Vault.Common.Remove"]</SUIButton></div>
            }
        </div>
    }
</SUICard>

@code {
    private const string Namespace = "personal";
    private string PersonalSecretHint => $"{L["Vault.UserVault.PersonalSecretHintPrefix"].Value} openai/api-key.";
    private readonly PersonalSecretForm form = new();
    private IReadOnlyList<UserVaultSecretMetadata> personalSecrets = [];
    private IReadOnlyList<UserVaultManagedCredentialMetadata> managedCredentials = [];
    private bool loading = true;
    private bool saving;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        form.Localizer = L;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        loadError = null;
        var result = await Data.LoadPersonalOverviewAsync();
        if (result.IsSuccess && result.Value is not null)
        {
            personalSecrets = result.Value.PersonalSecrets;
            managedCredentials = result.Value.ManagedCredentials;
        }
        else
        {
            personalSecrets = [];
            managedCredentials = [];
            loadError = result.Error;
        }
        loading = false;
    }

    private async Task SaveAsync()
    {
        saving = true;
        var result = await Data.PutPersonalAsync(Namespace, form.Name, form.Value);
        Notify(result.IsSuccess, L["Vault.UserVault.SecretSavedWithEnvelope"].Value, result.Error);
        if (result.IsSuccess) { form.Value = string.Empty; await LoadAsync(); }
        saving = false;
    }

    private async Task DeleteAsync(string name)
    {
        saving = true;
        var result = await Data.DeletePersonalAsync(Namespace, name);
        Notify(result.IsSuccess, L["Vault.UserVault.SecretRemoved"].Value, result.Error);
        if (result.IsSuccess) await LoadAsync();
        saving = false;
    }

    private void Notify(bool succeeded, string successMessage, string? error)
    {
        if (succeeded) Toast.Success(successMessage);
        else Toast.Error(error ?? L["Vault.Data.OperationFailed"].Value);
    }

    private sealed class PersonalSecretForm : IValidatableObject
    {
        public IStringLocalizer<Sufficit.Identity.UI.Vault.Resources.VaultResource>? Localizer { get; set; }

        public string Name { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (Localizer is null)
                throw new InvalidOperationException("Localizer must be assigned before validation.");
            var l = Localizer;

            if (string.IsNullOrWhiteSpace(Name))
            {
                yield return new ValidationResult(l["Vault.UserVault.Validation.NameRequired"].Value, [nameof(Name)]);
            }
            else
            {
                if (Name.Length > 128)
                    yield return new ValidationResult(l["Vault.UserVault.Validation.NameMaxLength"].Value, [nameof(Name)]);

                if (!System.Text.RegularExpressions.Regex.IsMatch(
                        Name,
                        @"^(?!/)(?!.*(?:\.\.|//))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)+(?<!/)$"))
                    yield return new ValidationResult(l["Vault.UserVault.Validation.NamePattern"].Value, [nameof(Name)]);
            }

            if (string.IsNullOrWhiteSpace(Value))
                yield return new ValidationResult(l["Vault.UserVault.Validation.ValueRequired"].Value, [nameof(Value)]);
            else if (Value.Length > 16384)
                yield return new ValidationResult(l["Vault.UserVault.Validation.ValueMaxLength"].Value, [nameof(Value)]);
        }
    }

    private static bool IsExpired(UserVaultManagedCredentialMetadata item) =>
        item.ExpiresAtUtc is { } expiration && expiration <= DateTime.UtcNow;

    private static string CredentialDisplayName(UserVaultManagedCredentialMetadata item) =>
        item.Provider switch
        {
            "github" => "GitHub",
            "gitlab" => "GitLab",
            "google-workspace" => "Google Workspace",
            { Length: > 0 } provider => provider,
            _ => item.Name,
        };

    private string CredentialDescription(UserVaultManagedCredentialMetadata item)
    {
        var origin = item.Provider is null ? item.Namespace : L["Vault.UserVault.OAuthIntegration"].Value;
        return string.Format(
            L["Vault.UserVault.CredentialUpdatedOn"].Value,
            origin,
            TimeInText.Slot);
    }

    // Stored instants are UTC; the round trip may drop the kind.
    private static DateTimeOffset Utc(DateTime value) =>
        new(DateTime.SpecifyKind(value, DateTimeKind.Utc));
}
