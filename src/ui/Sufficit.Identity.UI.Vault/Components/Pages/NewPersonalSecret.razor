@page "/vault/new"
@attribute [Authorize(Policy = VaultUiPolicies.User)]
@rendermode InteractiveServer
@layout VaultLayout
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject VaultDataSource Data
@inject IJSRuntime JS

<PageTitle>@L["Vault.Entry.Title"].Value | Sufficit Identity</PageTitle>
<SUIPageHeader Title="@L["Vault.Entry.Title"].Value" Description="@L["Vault.Entry.Description"].Value" />
@if (!ValidName)
{
    <p class="vault-feedback vault-feedback--error" role="alert">@L["Vault.Entry.InvalidLink"]</p>
}
else if (saved)
{
    <section class="vault-panel" role="status">
        <h2>@L["Vault.Entry.Saved"]</h2>
        <p>@L["Vault.Entry.ReturnToChat"]</p>
        <SUIButton Href="/vault" VariantValue="SUIVariant.Outlined">@L["Vault.Entry.OpenVault"]</SUIButton>
    </section>
}
else
{
    <section class="vault-panel" aria-labelledby="entry-heading" aria-busy="@saving">
        <div class="vault-panel__heading"><div><h2 id="entry-heading">@EntryName</h2><p>@L["Vault.Entry.AccountHint"]</p></div></div>
        @if (exists) { <p class="vault-feedback" role="status">@L["Vault.Entry.Existing"]</p> }
        <EditForm Model="form" OnValidSubmit="SaveAsync" class="vault-form">
            <SUITextField T="string" Id="guided-secret-value" Label="@L["Vault.UserVault.ValueLabel"].Value"
                          Value="@form.Value" ValueChanged="SetValue" Immediate="true" InputType="password" autocomplete="new-password"
                          MaxLength="16384" Disabled="@saving" Placeholder="@L["Vault.UserVault.ValuePlaceholder"].Value" />
            <p class="vault-panel__hint" role="status">@L[clipboardReady ? "Vault.Entry.Pasted" : "Vault.Entry.PasteHint"]</p>
            <div class="vault-form__actions">
                <SUIButton ButtonTypeValue="SUIButtonType.Button" VariantValue="SUIVariant.Outlined" OnClick="PasteAsync" Disabled="@saving">@L["Vault.Entry.Paste"]</SUIButton>
                <SUIButton ButtonTypeValue="SUIButtonType.Submit" Disabled="@(saving || loading || string.IsNullOrWhiteSpace(form.Value))">@(saving ? L["Vault.Common.Saving"].Value : L["Vault.UserVault.SaveSecret"].Value)</SUIButton>
            </div>
        </EditForm>
        @if (!string.IsNullOrEmpty(error)) { <p class="vault-feedback vault-feedback--error" role="alert">@error</p> }
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "name")] public string? Name { get; set; }
    private string EntryName => Name?.Trim().ToLowerInvariant() ?? string.Empty;
    private bool ValidName => EntryName.Length is > 0 and <= 119
        && !EntryName.Contains("..", StringComparison.Ordinal)
        && EntryName.Split('/').All(segment => segment.Length > 0
            && segment.All(character => char.IsAsciiLetterOrDigit(character)
                || character is '.' or '_' or '-'));
    private readonly EntryForm form = new();
    private IJSObjectReference? module;
    private string? appliedName;
    private string? error;
    private bool saved, saving, loading = true, exists, clipboardReady, pastePending;
    private int revision;
    private int entryVersion;

    protected override async Task OnParametersSetAsync()
    {
        if (appliedName == EntryName) return;
        appliedName = EntryName;
        entryVersion++;
        revision++;
        form.Value = string.Empty;
        saved = exists = clipboardReady = false;
        error = null;
        loading = true;
        if (ValidName)
        {
            var version = entryVersion;
            var result = await Data.LoadPersonalOverviewAsync();
            if (version != entryVersion) return;
            if (result.IsSuccess)
            {
                exists = result.Value?.PersonalSecrets.Any(item => item.Name == EntryName) == true;
                loading = false;
                pastePending = true;
            }
            else error = result.Error;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!pastePending || saved || !ValidName) return;
        pastePending = false;
        if (!string.IsNullOrEmpty(form.Value)) return;
        await PasteAsync();
        StateHasChanged();
    }

    private void SetValue(string? value)
    {
        revision++;
        form.Value = value ?? string.Empty;
        clipboardReady = false;
    }

    private async Task PasteAsync()
    {
        var version = revision;
        var previous = form.Value;
        try
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Sufficit.Identity.UI.Vault/vault-entry.js");
            var value = await module.InvokeAsync<string?>("readClipboard");
            if (version == revision && form.Value == previous && !saving && !saved && value is { Length: > 0 and <= 16384 })
            {
                form.Value = value;
                clipboardReady = true;
                revision++;
            }
        }
        catch (JSException) { clipboardReady = false; }
        catch (JSDisconnectedException) { }
    }

    private async Task SaveAsync()
    {
        if (saving || loading || !ValidName || string.IsNullOrWhiteSpace(form.Value) || form.Value.Length > 16384) return;
        saving = true;
        error = null;
        revision++;
        var version = entryVersion;
        var result = await Data.PutPersonalAsync("personal", EntryName, form.Value);
        if (version != entryVersion) { saving = false; return; }
        saved = result.IsSuccess;
        if (saved) form.Value = string.Empty;
        else error = result.Error;
        saving = false;
    }

    public async ValueTask DisposeAsync()
    {
        revision++;
        form.Value = string.Empty;
        if (module is not null)
            try { await module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }

    private sealed class EntryForm { public string Value { get; set; } = string.Empty; }
}
