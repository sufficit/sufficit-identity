@inject IJSRuntime JS

<dialog @ref="dialog" class="vault-reveal sui-card" aria-labelledby="vault-reveal-title"
        data-error="@L["Vault.Reveal.Unavailable"].Value"
        data-invalid="@L["Vault.Reveal.InvalidCode"].Value"
        data-locked="@L["Vault.Reveal.LockedOut"].Value"
        data-authenticator="@L["Vault.Reveal.AuthenticatorRequired"].Value"
        data-unauthorized="@L["Vault.Reveal.Unauthorized"].Value"
        data-not-found="@L["Vault.Reveal.NotFound"].Value">
    <h2 id="vault-reveal-title">@L["Vault.Reveal.Title"]</h2>
    <p class="vault-reveal__name" data-name></p>
    <p role="status" data-loading hidden>@L["Vault.Reveal.Loading"]</p>
    <p role="alert" data-error-message hidden></p>
    <form method="post" action="/vault/reveal" data-challenge hidden>
        <AntiforgeryToken />
        <p>@L["Vault.Reveal.Challenge"]</p>
        <label for="vault-reveal-code">@L["Vault.Reveal.Code"]</label>
        <input id="vault-reveal-code" class="vault-reveal__code"
               name="code" inputmode="numeric" autocomplete="one-time-code"
               pattern="[0-9]{6}" maxlength="6" required />
        <SUIButton ButtonTypeValue="SUIButtonType.Submit">@L["Vault.Reveal.Confirm"]</SUIButton>
    </form>
    <div data-setup hidden>
        <SUIButton Href="/manage/twofactor" VariantValue="SUIVariant.Outlined"
                   data-enhance-nav="false">@L["Vault.Reveal.Configure"]</SUIButton>
    </div>
    <pre class="vault-reveal__value" aria-label="@L["Vault.Reveal.Value"].Value" data-value hidden></pre>
    <form method="dialog" class="vault-reveal__actions" data-close>
        <SUIButton ButtonTypeValue="SUIButtonType.Submit" VariantValue="SUIVariant.Outlined"
                   ColorValue="SUIColor.Default">@L["Vault.Reveal.Close"]</SUIButton>
    </form>
</dialog>

@code {
    private ElementReference dialog;

    public async Task OpenAsync(string name)
    {
        await using var module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "/_content/Sufficit.Identity.UI.Vault/vault-entry.js");
        await module.InvokeVoidAsync("openSecretReveal", dialog, name);
    }
}
