@inject IJSRuntime JS

<div @ref="content" class="vault-reveal"
     data-error="@L["Vault.Reveal.Unavailable"].Value"
     data-invalid="@L["Vault.Reveal.InvalidCode"].Value"
     data-authenticator="@L["Vault.Reveal.AuthenticatorRequired"].Value"
     data-locked="@L["Vault.Reveal.LockedOut"].Value"
     data-unauthorized="@L["Vault.Reveal.Unauthorized"].Value"
     data-not-found="@L["Vault.Reveal.NotFound"].Value">
    <p class="vault-reveal__name"><code>@SecretName</code></p>
    <p role="status" data-loading>@L["Vault.Reveal.Loading"]</p>
    <div data-error-container hidden>
        <SUIAlert ToneValue="SUITone.Danger" Icon="alert"><span data-error-message></span></SUIAlert>
    </div>

    <form id="vault-reveal-form" method="post" action="/vault/reveal" data-challenge hidden>
        <AntiforgeryToken />
        <SUITextField TValue="string" Id="vault-reveal-code" Name="code"
                      Label="@L["Vault.Reveal.Code"].Value"
                      HelperText="@L["Vault.Reveal.Challenge"].Value"
                      Monospace="true" MaxLength="6"
                      inputmode="numeric" autocomplete="one-time-code"
                      pattern="[0-9]{6}" required
                      @attributes="BrowserOnlyField" />
    </form>

    <div data-setup hidden>
        <SUIButton Href="/manage/twofactor" VariantValue="SUIVariant.Outlined"
                   data-enhance-nav="false">@L["Vault.Reveal.Configure"]</SUIButton>
    </div>
    <pre class="vault-reveal__value" aria-label="@L["Vault.Reveal.Value"].Value" data-value hidden></pre>

    <SUICardActions Class="vault-reveal__actions" AlignEnd="true">
        <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default"
                   OnClick="Close" data-close>@L["Vault.Reveal.Close"]</SUIButton>
        <span data-confirm hidden>
            <SUIButton ButtonTypeValue="SUIButtonType.Submit" form="vault-reveal-form" StartIcon="eye">
                @L["Vault.Reveal.Confirm"]
            </SUIButton>
        </span>
    </SUICardActions>
</div>

@code {
    // Splat these last to remove the SUI field's default Blazor event handlers.
    // The authenticator code is read by FormData and sent only in the HTTPS POST.
    private static readonly IReadOnlyDictionary<string, object?> BrowserOnlyField =
        new Dictionary<string, object?> { ["oninput"] = null, ["onchange"] = null };

    private ElementReference content;

    [Parameter, EditorRequired]
    public string SecretName { get; set; } = string.Empty;

    [CascadingParameter]
    public SUIDialogReference Dialog { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await using var module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "/_content/Sufficit.Identity.UI.Vault/vault-entry.js");
        await module.InvokeVoidAsync("mountSecretReveal", content, SecretName);
    }

    private void Close() => Dialog.Complete(null);
}
