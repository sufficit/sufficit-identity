<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sufficit.Identity.UI.Components</RootNamespace>
    <AssemblyName>Sufficit.Identity.UI.Components</AssemblyName>
    <Description>Sufficit Identity shared visual components.</Description>
    <IsPackable>true</IsPackable>
    <StaticWebAssetsEnabled>true</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
     </ItemGroup>

  <!-- Use the shared SUI implementation instead of keeping a local copy.
       Local sibling checkout wins when present (fast inner loop);
       CI/Docker/fresh clones consume the published NuGet package. See
       SufficitUseLocalSui in Directory.Build.props. -->
  <ItemGroup Condition="'$(SufficitUseLocalSui)' == 'true'">
    <ProjectReference Include="..\..\..\..\sufficit-blazor-ui\src\Sufficit.Blazor.UI.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(SufficitUseLocalSui)' != 'true'">
    <PackageReference Include="Sufficit.Blazor.UI" />
  </ItemGroup>

  <ItemGroup>  </ItemGroup>

</Project>
