@namespace Sufficit.Blazor.UI.Components

<header class="@Classname">
    <div class="sui-page-header__copy">
        @if (!string.IsNullOrWhiteSpace(Eyebrow)) { <p class="sui-page-header__eyebrow">@Eyebrow</p> }
        <h1 class="sui-page-header__title">@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Description)) { <p class="sui-page-header__description">@Description</p> }
    </div>
    @if (Actions is not null) { <div class="sui-page-header__actions">@Actions</div> }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string? Class { get; set; }
    private string Classname => string.IsNullOrWhiteSpace(Class) ? "sui-page-header" : $"sui-page-header {Class}";
}
