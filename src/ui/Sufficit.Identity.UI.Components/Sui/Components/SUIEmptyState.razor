@namespace Sufficit.Blazor.UI.Components

<div class="@Classname">
    @if (!string.IsNullOrEmpty(IconPath))
    {
        <svg class="sui-empty__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            @((MarkupString)IconPath)
        </svg>
    }
    else if (!string.IsNullOrEmpty(Icon))
    {
        <span class="sui-empty__icon"><SUIIcon Name="@Icon" Size="48" /></span>
    }
    @if (!string.IsNullOrEmpty(Title)) { <div class="sui-empty__title">@Title</div> }
    @if (!string.IsNullOrEmpty(Description)) { <div class="sui-empty__description">@Description</div> }
    @{ var actions = Actions ?? ActionContent; }
    @if (actions is not null) { <div class="sui-empty__actions">@actions</div> }
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? IconPath { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ActionContent { get; set; }
    [Parameter] public string? Class { get; set; }
    private string Classname => string.IsNullOrWhiteSpace(Class) ? "sui-empty" : $"sui-empty {Class}";
}
