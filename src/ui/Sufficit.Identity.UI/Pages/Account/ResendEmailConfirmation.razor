@page "/account/resendemailconfirmation"
@rendermode @(RenderMode.InteractiveServer)
@inject IAccountOnboardingService AccountOnboarding
@inject IHumanVerificationService HumanVerification
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ResendEmail.Title"]</PageTitle>

<div class="auth-card">
    <h1>@L["ResendEmail.Title"]</h1>

    @if (_sent)
    {
        <SUIAlert ToneValue="SUITone.Success">@L["ResendEmail.Success"]</SUIAlert>
        <SUIButton Href="/account/login">@L["Common.BackToLogin"]</SUIButton>
    }
    else
    {
        @if (_error is not null)
        {
            <SUIAlert ToneValue="SUITone.Danger">@_error</SUIAlert>
        }

        <EditForm Model="_model" Method="post" OnValidSubmit="ResendAsync" FormName="resend-confirm">
            <DataAnnotationsValidator />

            <SUITextField T="string" Id="email"
                          Label="@L["ResendEmail.Email"]"
                          @bind-Value="_model.Email"
                          InputType="email"
                          autocomplete="email" autofocus />

            <HumanVerification Flow="HumanVerificationFlow.EmailConfirmation"
                               @bind-Token="_verificationToken"
                               @ref="_verificationControl" />

            <SUILoadingButton ButtonTypeValue="SUIButtonType.Submit" FullWidth
                              Disabled="@_submitting">
                @L["ResendEmail.Submit"]
            </SUILoadingButton>
        </EditForm>
    }
</div>

@code {
    private EmailInput? _boundModel;
    [SupplyParameterFromForm(FormName = "resend-confirm")]
    private EmailInput _model
    {
        get => _boundModel ??= new();
        set => _boundModel = value;
    }
    private bool _sent;
    private bool _submitting;
    private string? _error;
    private string _verificationToken = string.Empty;
    private HumanVerification? _verificationControl;

    private async Task ResendAsync()
    {
        if (_submitting)
        {
            return;
        }

        _submitting = true;
        _error = null;
        try
        {
            var verification = await HumanVerification.VerifyAsync(
                HumanVerificationFlow.EmailConfirmation,
                _verificationToken);
            if (!verification.Succeeded)
            {
                _error = L["HumanVerification.Required"];
                if (_verificationControl is not null)
                {
                    await _verificationControl.ResetAsync();
                }
                return;
            }

            var result = await AccountOnboarding
                .RequestEmailConfirmationAsync(_model.Email);
            _sent = result.Accepted;
        }
        finally
        {
            _submitting = false;
        }
    }

    private sealed class EmailInput
    {
        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;
    }
}
