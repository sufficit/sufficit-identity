@page "/account/login"
@rendermode @(RenderMode.InteractiveServer)
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.WebUtilities
@inject IInteractiveSignInService SignInService
@inject IAccountOnboardingService AccountOnboarding
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS
@inject ILogger<Login> Logger
@inject IBrandingThemeProvider BrandingProvider
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Login.Title"]</PageTitle>

<div class="auth-card">
    <div class="auth-brand">
        <img src="@_logoUrl" alt="@L["Layout.BrandFallback"]" height="44" />
    </div>

    <AuthorizeView>
        <Authorized>
            @if (IsExternalCorrelationFailure)
            {
                <SUIAlert ToneValue="SUITone.Warning">
                    @L["Login.SessionActive.ExternalCorrelationFailed"]
                </SUIAlert>
            }

            <section aria-labelledby="active-session-title">
                <h1 id="active-session-title">@L["Login.SessionActive.Title"]</h1>
                <p class="auth-card-subtitle">@L["Login.SessionActive.Description"]</p>
                <SUIButton Href="@(_returnUrl ?? "/")" FullWidth data-enhance-nav="false">
                    @L["Login.SessionActive.Continue"]
                </SUIButton>
                <div class="auth-links">
                    <a href="/account/logout">@L["Login.SessionActive.UseAnotherAccount"]</a>
                </div>
            </section>
        </Authorized>
        <NotAuthorized>
            @if (_errorMessage is not null)
            {
                <SUIAlert ToneValue="SUITone.Danger">@_errorMessage</SUIAlert>
            }

            @if (_noticeMessage is not null)
            {
                <p class="info" role="status">@_noticeMessage</p>
            }

            @* F-8 (eval 2026-08-14): branch on the structured passkey error
               CODE, never on localized prose — the previous
               _errorMessage.Contains("duas etapas") matched a substring no
               current error string contained (dead affordance) and would
               break with any copy or locale change. *@
            @if (_requiresTwoFactor)
            {
                <p class="info">@L["Login.Requires2FA"]</p>
                <SUIButton Href="@($"/account/loginwith2fa?returnUrl={Uri.EscapeDataString(_returnUrl ?? "/")}")">
                    @L["Login.Continue2FA"]
                </SUIButton>
            }
            else
            {
        // ---- External logins FIRST (Google, Facebook, passkey) ----
        <div class="external-logins">
            @if (_externalProviders.Any())
            {
                @foreach (var scheme in _externalProviders)
                {
                    @* Link straight to the MVC challenge endpoint and opt out of
                       Blazor enhanced navigation: the endpoint 302s to an external
                       domain (Google/Facebook), which enhanced nav can't follow —
                       it left the page frozen for seconds before falling back.
                       data-redirect-overlay triggers the "connecting…" overlay
                       (script in App.razor). *@
                    <SUIButton Href="@($"/account/externalchallenge?provider={scheme.Name}&returnUrl={Uri.EscapeDataString(_returnUrl ?? "/")}")"
                               FullWidth
                               VariantValue="SUIVariant.Outlined"
                               ColorValue="SUIColor.Default"
                               Class="@ProviderClass(scheme.Name)"
                               data-enhance-nav="false"
                               data-redirect-overlay="@scheme.DisplayName">
                        <ProviderIcon Provider="@scheme.Name" />
                        <span>@L["Login.SignInWith", scheme.DisplayName]</span>
                    </SUIButton>
                }
            }

            @if (_passkeySupported)
            {
                <form @ref="_passkeyForm" class="passkey-form">
                    <AntiforgeryToken />
                    @* aria-busy carries the ceremony, not SUI's IsLoading: the platform
                       dialog can stay open for as long as the person needs, and this
                       button keeps its label while it does. *@
                    <SUILoadingButton FullWidth
                                      VariantValue="SUIVariant.Outlined"
                                      ColorValue="SUIColor.Default"
                                      Class="btn-passkey"
                                      Disabled="@_passkeyBusy"
                                      aria-busy="@(_passkeyBusy ? "true" : "false")"
                                      OnClick="PasskeySignInAsync">
                        <svg class="provider-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
                        <span>@(_passkeyBusy ? L["Login.PasskeyVerifying"] : L["Login.SignInWithPasskey"])</span>
                    </SUILoadingButton>
                </form>
            }
        </div>

        @if (_externalProviders.Any() || _passkeySupported)
        {
                <p class="separator"><span>@L["Login.OrEmailPassword"]</span></p>
        }

        // Password sign-in must be a full HTTP POST. ASP.NET Core Identity
        // cannot emit its Set-Cookie header from this page's Blazor circuit
        // after the initial HTTP response has already started.
        <form method="post" action="/account/login/password" data-enhance="false" data-auth-submit-once>
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@(_returnUrl ?? "/")" />
            @if (!string.IsNullOrEmpty(_loginHint))
            {
                <input type="hidden" name="FromRegistration" value="true" />
            }

            <SUITextField T="string" Id="username"
                          Label="@(_registrationPolicy.RequiresUserName ? L["Login.EmailOrUsername"] : L["Login.Email"])"
                          @bind-Value="Model.UserName"
                          name="UserName"
                          autocomplete="username" required />

            <SUITextField T="string" Id="password"
                          Label="@L["Login.Password"]"
                          InputType="password"
                          name="Password"
                          autofocus="@(!string.IsNullOrEmpty(_loginHint))"
                          autocomplete="current-password" required />

            <SUICheckbox Id="rememberMe"
                         Name="RememberMe"
                         FormValue="true"
                         Label="@L["Login.RememberMe"]"
                         @bind-Value="Model.RememberMe" />

            <SUILoadingButton ButtonTypeValue="SUIButtonType.Submit" FullWidth>
                @L["Login.Submit"]
            </SUILoadingButton>
        </form>

                <div class="auth-links">
                    <a href="/account/forgotpassword">@L["Login.ForgotPassword"]</a>
                    <br />
                    @if (_registrationPolicy.Enabled)
                    {
                        <a href="@RegisterUrl">@L["Login.CreateAccount"]</a>
                        <br />
                    }
                    <a href="/account/resendemailconfirmation">@L["Login.ResendConfirmation"]</a>
                </div>
            }
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private LoginViewModel? _boundModel;
    [SupplyParameterFromForm(FormName = "login")]
    private LoginViewModel Model
    {
        get => _boundModel ??= new();
        set => _boundModel = value;
    }

    // ASP.NET Core's cookie middleware emits `ReturnUrl` (PascalCase), while
    // our own redirects use `returnUrl`. Query binding is explicit here so the
    // external-login link cannot silently fall back to `/` and lose a pending
    // OIDC authorization request.
    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    private string? _returnUrlQueryPascal { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? _returnUrlQuery { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? _externalError { get; set; }

    [SupplyParameterFromQuery(Name = "login_hint")]
    private string? _loginHint { get; set; }

    // A flow that is waiting on the user (for example, a confirmation link sent
    // to their mailbox) is not an error, so it arrives on its own parameter and
    // renders as information rather than as a failure.
    [SupplyParameterFromQuery(Name = "notice")]
    private string? _externalNotice { get; set; }

    private string? _returnUrl;
    private string? _errorMessage;
    private string? _noticeMessage;
    private IReadOnlyList<InteractiveSignInProvider> _externalProviders = [];
    private AccountRegistrationPolicy _registrationPolicy = new(false, false);
    private ElementReference _passkeyForm;
    private bool _passkeySupported;
    private bool _passkeyBusy;

    // Set when the passkey ceremony succeeded but the account still needs
    // the second factor (structured code "two-factor-required").
    private bool _requiresTwoFactor;
    private string _logoUrl = "_content/Sufficit.Identity.UI/img/logo-full.png";
    private bool IsExternalCorrelationFailure =>
        string.Equals(
            _externalError,
            "external_correlation_failed",
            StringComparison.Ordinal);
    private string RegisterUrl => QueryHelpers.AddQueryString(
        "/account/register",
        "returnUrl",
        _returnUrl ?? "/");

    protected override async Task OnInitializedAsync()
    {
        // Never trust returnUrl blindly: reject absolute/off-host URLs to prevent
        // an authenticated open redirect (attacker crafts a login link with
        // returnUrl=https://evil.example and phishes the victim post-login).
        var requestQuery = HttpContextAccessor.HttpContext?.Request.Query;
        var queryReturnUrl = requestQuery?["ReturnUrl"].FirstOrDefault()
            ?? requestQuery?["returnUrl"].FirstOrDefault();
        if (queryReturnUrl is null)
        {
            var query = QueryHelpers.ParseQuery(
                Navigation.ToAbsoluteUri(Navigation.Uri).Query);
            queryReturnUrl = query.TryGetValue(
                    "ReturnUrl",
                    out var pascalReturnUrl)
                ? pascalReturnUrl.ToString()
                : query.TryGetValue("returnUrl", out var lowerReturnUrl)
                    ? lowerReturnUrl.ToString()
                    : null;
        }
        _returnUrl = LocalUrlValidator.EnsureLocal(
            queryReturnUrl ?? _returnUrlQueryPascal ?? _returnUrlQuery);
        Model.ReturnUrl = _returnUrl;
        Model.UserName = _loginHint ?? string.Empty;

        _externalProviders = await SignInService.GetExternalProvidersAsync();
        _registrationPolicy = await AccountOnboarding
            .GetRegistrationPolicyAsync();
        _errorMessage = _externalError switch
        {
            "locked_out" =>
                L["Login.Error.LockedOut"],
            "not_allowed" =>
                L["Login.Error.NotAllowed"],
            "no_email_from_provider" =>
                L["Login.Error.NoEmailFromProvider"],
            "account_link_requires_signin" =>
                L["Login.Error.AccountLinkRequiresSignIn"],
            "registration_disabled" =>
                L["Login.Error.RegistrationDisabled"],
            "create_failed" =>
                L["Login.Error.CreateFailed"],
            "external_callback_unavailable" =>
                L["Login.Error.ExternalCallbackUnavailable"],
            "external_correlation_failed" =>
                L["Login.Error.ExternalCorrelationFailed"],
            "invalid_credentials" =>
                L["Login.Error.InvalidCredentials"],
            "invalid_password" =>
                L["Login.Error.InvalidPassword"],
            "request_expired" =>
                L["Login.Error.RequestExpired"],
            "registration_denied_for_provider" =>
                L["Login.Error.RegistrationDeniedForProvider"],
            "external_link_ticket_invalid" =>
                L["Login.Error.ExternalLinkTicketInvalid"],
            _ => _errorMessage,
        };
        _noticeMessage = _externalNotice switch
        {
            "external_signin" =>
                L["Login.Notice.ExternalSignIn"].Value,
            "external_email_verification_sent" =>
                L["Login.Notice.ExternalEmailVerificationSent"].Value,
            _ => null,
        };

        // Load branding theme logo
        var theme = await BrandingProvider.GetActiveAsync();
        if (theme?.LogoUrl is not null)
            _logoUrl = theme.LogoUrl;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _passkeySupported = await JS.InvokeAsync<bool>("passkeys.isSupported");
                StateHasChanged();
            }
            catch { /* JS interop is unavailable during prerendering */ }
        }
    }

    private async Task PasskeySignInAsync()
    {
        _errorMessage = null;
        _passkeyBusy = true;

        // The next call opens the platform's passkey dialog and does not come
        // back until the user answers it. Without yielding first, the busy
        // state would only reach the browser after that — js/instant-feedback.js
        // already marked the button, and this makes the component agree.
        await Task.Yield();

        try
        {
            var result = await JS.InvokeAsync<PasskeyAuthenticationResult>(
                "passkeys.signIn",
                _passkeyForm,
                Model.UserName ?? string.Empty);

            if (result.Succeeded)
            {
                Navigation.NavigateTo(_returnUrl ?? "/", forceLoad: true);
            }
            else
            {
                _requiresTwoFactor = result.Errors.Any(error =>
                    string.Equals(error.Code, "two-factor-required", StringComparison.Ordinal));
                // The API answers in English with a stable code; translate the
                // codes this page knows. A required second step is explained by
                // the dedicated block above, so it adds no error text.
                var messages = result.Errors
                    .Select(error => error.Code switch
                    {
                        "two-factor-required" => null,
                        "account-locked" => L["Login.Error.LockedOut"].Value,
                        "sign-in-not-allowed" => L["Login.Error.NotAllowed"].Value,
                        "passkey-ceremony-invalid" => L["Login.Error.PasskeyRetry"].Value,
                        "passkey-credential-required"
                            or "passkey-credential-too-large"
                            or "passkey-authentication-failed" =>
                            L["Login.Error.PasskeyFailed"].Value,
                        _ => L["Login.Error.PasskeyGeneric"].Value,
                    })
                    .OfType<string>()
                    .Distinct(StringComparer.Ordinal)
                    .ToArray();
                _errorMessage = result.Errors.Count == 0
                    ? L["Login.Error.PasskeyFailed"]
                    : messages.Length == 0
                        ? null
                        : string.Join(" ", messages);
            }
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Passkey sign-in interaction failed.");
            _errorMessage = L["Login.Error.PasskeyRetry"];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Passkey sign-in failed.");
            _errorMessage = L["Login.Error.PasskeyGeneric"];
        }
        finally
        {
            _passkeyBusy = false;
        }
    }

    // Only the providers whose own brand colour the button wears get a class;
    // everything else keeps the neutral surface. The mark is chosen separately,
    // by ProviderIcon, so a provider can have artwork without a painted button.
    private static string ProviderClass(string providerName) =>
        providerName.ToLowerInvariant() switch
        {
            "google" => "btn-google",
            "facebook" => "btn-facebook",
            _ => "btn-external"
        };

}
