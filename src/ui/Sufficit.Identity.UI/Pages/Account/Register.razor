@page "/account/register"
@rendermode @(RenderMode.InteractiveServer)
@using Microsoft.AspNetCore.WebUtilities
@inject IAccountOnboardingService AccountOnboarding
@inject IAccountPasswordPolicyProvider PasswordPolicyProvider
@inject IHumanVerificationService HumanVerification
@inject IJSRuntime JS
@inject IBrandingThemeProvider BrandingProvider
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Register.Title"]</PageTitle>

@if (!_registrationPolicy.Enabled)
{
    <div class="auth-card">
        <h1>@L["Register.Title"]</h1>
        <SUIAlert ToneValue="SUITone.Danger">@L["Register.Disabled"]</SUIAlert>
        <SUIButton Href="@LoginUrl">@L["Common.BackToLogin"]</SUIButton>
    </div>
}
else
{
    <div class="auth-card">
        <div class="auth-brand">
            <img src="@_logoUrl" alt="@L["Layout.BrandFallback"]" height="44" />
        </div>
        <h1>@L["Register.Title"]</h1>
        <p class="auth-card-subtitle">@L["Register.Subtitle"]</p>

        @if (_registered)
        {
            <SUIAlert ToneValue="SUITone.Success" Class="registration-success" aria-live="polite">
                <div class="registration-success__content">
                    <p class="registration-success__title">@L["Register.SuccessTitle"]</p>
                    @if (_confirmationMessageSent)
                    {
                        <p>
                            @L["Register.ConfirmationSentPrefix"]
                            <strong class="registration-success__email">@_model.Email</strong>.
                            @L["Register.ConfirmationSentSuffix"]
                        </p>
                    }
                    else
                    {
                        <p>@L["Register.ConfirmationFailed"]</p>
                    }
                </div>
            </SUIAlert>
            <SUIButton Href="@LoginUrl" FullWidth>@L["Common.BackToLogin"]</SUIButton>
        }
        else
        {
            @if (_error is not null)
            {
                <SUIAlert ToneValue="SUITone.Danger">@_error</SUIAlert>
            }

            <EditForm id="registration-form" Model="_model" Method="post" OnValidSubmit="RegisterAsync" FormName="register">
                <DataAnnotationsValidator />
                <ValidationSummary class="validation-summary" role="alert" aria-live="polite" />

                @if (_registrationPolicy.RequiresUserName)
                {
                    <SUITextField T="string" Id="username"
                                  Label="@L["Register.UserName"]"
                                  @bind-Value="_model.UserName"
                                  autocomplete="username" autofocus />
                }

                <SUITextField T="string" Id="email"
                              Label="@L["Register.Email"]"
                              @bind-Value="_model.Email"
                              InputType="email"
                              autocomplete="email"
                              autofocus="@(!_registrationPolicy.RequiresUserName)" />

                <SUITextField T="string" Id="password"
                              Label="@L["Register.Password"]"
                              @bind-Value="_model.Password"
                              AriaDescribedBy="password-requirements"
                              InputType="password"
                              autocomplete="new-password" />

                <PasswordRequirements Policy="_passwordPolicy" MaximumLength="100" />
                <SUITextField T="string" Id="confirm"
                              Label="@L["Register.ConfirmPassword"]"
                              @bind-Value="_model.ConfirmPassword"
                              InputType="password"
                              autocomplete="new-password" />

                <HumanVerification Flow="HumanVerificationFlow.Registration"
                                   @bind-Token="_verificationToken"
                                   @ref="_verificationControl" />

                <SUILoadingButton ButtonTypeValue="SUIButtonType.Submit" FullWidth
                                  Disabled="@_submitting">
                    @L["Register.Submit"]
                </SUILoadingButton>
            </EditForm>

            <div class="auth-links">
                <a href="@LoginUrl">@L["Register.HasAccount"]</a>
                @if (_error is not null)
                {
                    <br />
                    <a href="/account/forgotpassword">@L["Login.ForgotPassword"]</a>
                    <br />
                    <a href="/account/resendemailconfirmation">@L["Login.ResendConfirmation"]</a>
                }
            </div>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    private string? ReturnUrlPascal { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    private RegisterInput? _boundModel;
    [SupplyParameterFromForm(FormName = "register")]
    private RegisterInput _model
    {
        get => _boundModel ??= new();
        set => _boundModel = value;
    }

    private string? _error;
    private bool _registered;
    private bool _confirmationMessageSent;
    private bool _submitting;
    private bool _signingIn;
    private string _verificationToken = string.Empty;
    private HumanVerification? _verificationControl;
    private AccountPasswordPolicy _passwordPolicy = default!;
    private AccountRegistrationPolicy _registrationPolicy = new(false, false);
    private string _logoUrl = "_content/Sufficit.Identity.UI/img/logo-full.png";
    private string _returnUrl = "/";
    private string LoginUrl => QueryHelpers.AddQueryString(
        "/account/login",
        "returnUrl",
        _returnUrl);

    protected override async Task OnInitializedAsync()
    {
        _passwordPolicy = PasswordPolicyProvider.GetPolicy();
        _returnUrl = LocalUrlValidator.EnsureLocal(
            ReturnUrlPascal ?? ReturnUrl);
        _registrationPolicy = await AccountOnboarding
            .GetRegistrationPolicyAsync();
        _model.RequiresUserName = _registrationPolicy.RequiresUserName;

        // Load branding theme logo
        var theme = await BrandingProvider.GetActiveAsync();
        if (theme?.LogoUrl is not null)
            _logoUrl = theme.LogoUrl;
    }

    private async Task RegisterAsync()
    {
        if (_submitting)
        {
            return;
        }

        _submitting = true;
        _error = null;
        try
        {
            var verification = await HumanVerification.VerifyAsync(
                HumanVerificationFlow.Registration,
                _verificationToken);
            if (!verification.Succeeded)
            {
                _error = L["HumanVerification.Required"];
                if (_verificationControl is not null)
                {
                    await _verificationControl.ResetAsync();
                }
                return;
            }

            var result = await AccountOnboarding.RegisterAsync(
                new AccountRegistrationCommand(
                    _model.UserName,
                    _model.Email,
                    _model.Password,
                    _returnUrl));
            if (result.RequiresSignIn)
            {
                // Cookies require a new HTTP response, never a circuit call.
                await JS.InvokeVoidAsync("sufficitIdentitySignInFromRegistration",
                    "registration-form", _returnUrl);
                _signingIn = true;
                return;
            }
            if (!result.Succeeded)
            {
                // The API answers in English with a stable code; the page owns
                // the user's language, so it translates the codes it knows and
                // falls back to the English description for the rest.
                _error = string.Join(
                    " ",
                    result.Errors
                        .Select(error => error.Code switch
                        {
                            "DuplicateUserName" or "DuplicateEmail" =>
                                L["Register.Error.CreateFailed"].Value,
                            "registration-disabled" =>
                                L["Register.Error.RegistrationDisabled"].Value,
                            _ => PasswordMessages.ForError(error.Code, _passwordPolicy, L)
                                ?? error.Description,
                        })
                        .Distinct(StringComparer.Ordinal));
                if (_verificationControl is not null)
                {
                    // Provider responses are single-use. A corrected form must
                    // always receive a fresh challenge.
                    await _verificationControl.ResetAsync();
                }
                return;
            }

            _confirmationMessageSent = result.ConfirmationMessageSent;
            _registered = true;
        }
        finally
        {
            _submitting = _signingIn;
        }
    }

    private sealed class RegisterInput : IValidatableObject
    {
        // UserName is collected only when required by the runtime policy.
        [StringLength(
            50,
            ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.UserNameLength),
            MinimumLength = 3)]
        public string? UserName { get; set; }

        public bool RequiresUserName { get; set; }

        [Required(
            ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.EmailRequired))]
        [EmailAddress(
            ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.EmailInvalid))]
        public string Email { get; set; } = string.Empty;

        [Required(
            ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.PasswordRequired))]
        [StringLength(
            100,
            ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.PasswordLength),
            MinimumLength = 1)]
        [DataType(System.ComponentModel.DataAnnotations.DataType.Password)]
        public string Password { get; set; } = string.Empty;

        [Required(
            ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.ConfirmPasswordRequired))]
        [DataType(System.ComponentModel.DataAnnotations.DataType.Password)]
        [Compare(
            nameof(Password),
            ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.PasswordMismatch))]
        public string ConfirmPassword { get; set; } = string.Empty;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (RequiresUserName && string.IsNullOrWhiteSpace(UserName))
            {
                yield return new ValidationResult(
                    ValidationMessages.UserNameRequired,
                    [nameof(UserName)]);
            }
        }
    }
}
