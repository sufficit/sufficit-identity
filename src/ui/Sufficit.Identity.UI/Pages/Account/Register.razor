@page "/account/register"
@rendermode @(RenderMode.InteractiveServer)
@inject IAccountOnboardingService AccountOnboarding
@inject IHumanVerificationService HumanVerification
@inject IBrandingThemeProvider BrandingProvider
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Register.Title"]</PageTitle>

@if (!_registrationPolicy.Enabled)
{
    <div class="auth-card">
        <h1>@L["Register.Title"]</h1>
        <div class="alert alert-error" role="alert">
            @L["Register.Disabled"]
        </div>
        <a href="/account/login" class="btn btn-primary">@L["Common.BackToLogin"]</a>
    </div>
}
else
{
    <div class="auth-card">
        <div class="auth-brand">
            <img src="@_logoUrl" alt="Sufficit Identity" height="44" />
        </div>
        <h1>@L["Register.Title"]</h1>
        <p class="auth-card-subtitle">@L["Register.Subtitle"]</p>

        @if (_registered)
        {
            <div class="alert alert-success registration-success" role="status" aria-live="polite">
                <div class="registration-success__content">
                    <p class="registration-success__title">@L["Register.SuccessTitle"]</p>
                    @if (_confirmationMessageSent)
                    {
                        <p>
                            @L["Register.ConfirmationSentPrefix"]
                            <strong class="registration-success__email">@_model.Email</strong>.
                            @L["Register.ConfirmationSentSuffix"]
                        </p>
                    }
                    else
                    {
                        <p>@L["Register.ConfirmationFailed"]</p>
                    }
                </div>
            </div>
            <a href="/account/login" class="btn btn-primary btn-block">@L["Common.BackToLogin"]</a>
        }
        else
        {
            @if (_error is not null)
            {
                <div class="alert alert-error" role="alert">@_error</div>
            }

            <EditForm Model="_model" Method="post" OnValidSubmit="RegisterAsync" FormName="register">
                <DataAnnotationsValidator />
                <ValidationSummary class="validation-summary" role="alert" aria-live="polite" />

                @if (_registrationPolicy.RequiresUserName)
                {
                    <div class="form-group">
                        <label for="username">@L["Register.UserName"]</label>
                        <InputText id="username" @bind-Value="_model.UserName" class="form-control"
                                   autocomplete="username" autofocus />
                        <ValidationMessage For="@(() => _model.UserName)" />
                    </div>
                }

                <div class="form-group">
                    <label for="email">@L["Register.Email"]</label>
                    <InputText id="email" @bind-Value="_model.Email" class="form-control"
                               autocomplete="email"
                               autofocus="@( !_registrationPolicy.RequiresUserName )" />
                    <ValidationMessage For="@(() => _model.Email)" />
                </div>

                <div class="form-group">
                    <label for="password">@L["Register.Password"]</label>
                    <InputText id="password" type="password" @bind-Value="_model.Password" class="form-control"
                               autocomplete="new-password" />
                    <ValidationMessage For="@(() => _model.Password)" />
                </div>

                <div class="form-group">
                    <label for="confirm">@L["Register.ConfirmPassword"]</label>
                    <InputText id="confirm" type="password" @bind-Value="_model.ConfirmPassword" class="form-control"
                               autocomplete="new-password" />
                    <ValidationMessage For="@(() => _model.ConfirmPassword)" />
                </div>

                <HumanVerification Flow="HumanVerificationFlow.Registration"
                                   @bind-Token="_verificationToken"
                                   @ref="_verificationControl" />

                <button type="submit" class="btn btn-primary btn-block" disabled="@_submitting">
                    @L["Register.Submit"]
                </button>
            </EditForm>

            <div class="auth-links">
                <a href="/account/login">@L["Register.HasAccount"]</a>
            </div>
        }
    </div>
}

@code {
    private RegisterInput? _boundModel;
    [SupplyParameterFromForm(FormName = "register")]
    private RegisterInput _model
    {
        get => _boundModel ??= new();
        set => _boundModel = value;
    }

    private string? _error;
    private bool _registered;
    private bool _confirmationMessageSent;
    private bool _submitting;
    private string _verificationToken = string.Empty;
    private HumanVerification? _verificationControl;
    private AccountRegistrationPolicy _registrationPolicy = new(false, false);
    private string _logoUrl = "_content/Sufficit.Identity.UI/img/logo-full.png";

    protected override async Task OnInitializedAsync()
    {
        _registrationPolicy = await AccountOnboarding
            .GetRegistrationPolicyAsync();
        _model.RequiresUserName = _registrationPolicy.RequiresUserName;

        // Load branding theme logo
        var theme = await BrandingProvider.GetActiveAsync();
        if (theme?.LogoUrl is not null)
            _logoUrl = theme.LogoUrl;
    }

    private async Task RegisterAsync()
    {
        if (_submitting)
        {
            return;
        }

        _submitting = true;
        _error = null;
        try
        {
            var verification = await HumanVerification.VerifyAsync(
                HumanVerificationFlow.Registration,
                _verificationToken);
            if (!verification.Succeeded)
            {
                _error = L["HumanVerification.Required"];
                if (_verificationControl is not null)
                {
                    await _verificationControl.ResetAsync();
                }
                return;
            }

            var result = await AccountOnboarding.RegisterAsync(
                new AccountRegistrationCommand(
                    _model.UserName,
                    _model.Email,
                    _model.Password));
            if (!result.Succeeded)
            {
                _error = string.Join(
                    " ",
                    result.Errors.Select(error => error.Description));
                if (_verificationControl is not null)
                {
                    // Provider responses are single-use. A corrected form must
                    // always receive a fresh challenge.
                    await _verificationControl.ResetAsync();
                }
                return;
            }

            _confirmationMessageSent = result.ConfirmationMessageSent;
            _registered = true;
        }
        finally
        {
            _submitting = false;
        }
    }

    private sealed class RegisterInput : IValidatableObject
    {
        // UserName is collected only when required by the runtime policy.
        [StringLength(
            50,
            ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.UserNameLength),
            MinimumLength = 3)]
        public string? UserName { get; set; }

        public bool RequiresUserName { get; set; }

        [Required(
            ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.EmailRequired))]
        [EmailAddress(
            ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.EmailInvalid))]
        public string Email { get; set; } = string.Empty;

        [Required(
            ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.PasswordRequired))]
        [StringLength(
            100,
            ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.PasswordLength),
            MinimumLength = 6)]
        [DataType(System.ComponentModel.DataAnnotations.DataType.Password)]
        public string Password { get; set; } = string.Empty;

        [Required(
            ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.ConfirmPasswordRequired))]
        [DataType(System.ComponentModel.DataAnnotations.DataType.Password)]
        [Compare(
            nameof(Password),
            ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.PasswordMismatch))]
        public string ConfirmPassword { get; set; } = string.Empty;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (RequiresUserName && string.IsNullOrWhiteSpace(UserName))
            {
                yield return new ValidationResult(
                    ValidationMessages.UserNameRequired,
                    [nameof(UserName)]);
            }
        }
    }
}
