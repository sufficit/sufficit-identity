@page "/account/register"
@inject IAccountOnboardingService AccountOnboarding
@inject IBrandingThemeProvider BrandingProvider

<PageTitle>Criar conta — Sufficit Identity</PageTitle>

@if (!_registrationPolicy.Enabled)
{
    <div class="auth-card">
        <h1>Criar conta</h1>
        <div class="alert alert-error" role="alert">
            Cadastro de novas contas está desativado.
        </div>
        <a href="/account/login" class="btn btn-primary">Voltar ao login</a>
    </div>
}
else
{
    <div class="auth-card">
        <div class="auth-brand">
            <img src="@_logoUrl" alt="Sufficit Identity" height="44" />
        </div>
        <h1>Criar conta</h1>
        <p class="auth-card-subtitle">Crie sua conta em poucos segundos</p>

        @if (_registered)
        {
            <div class="alert alert-success" role="alert">
                Conta criada!
                @if (_confirmationMessageSent)
                {
                    <text> Enviamos um e-mail de confirmação para <strong>@_model.Email</strong>.
                    Clique no link do e-mail para ativar sua conta.</text>
                }
                else
                {
                    <text> Não foi possível entregar a confirmação agora. Use a opção de reenviar confirmação.</text>
                }
            </div>
            <a href="/account/login" class="btn btn-primary">Voltar ao login</a>
        }
        else
        {
            @if (_error is not null)
            {
                <div class="alert alert-error" role="alert">@_error</div>
            }

            <EditForm Model="_model" Method="post" OnValidSubmit="RegisterAsync" FormName="register">
                <DataAnnotationsValidator />

                @if (_registrationPolicy.RequiresUserName)
                {
                    <div class="form-group">
                        <label for="username">Usuário</label>
                        <InputText id="username" @bind-Value="_model.UserName" class="form-control"
                                   autocomplete="username" autofocus />
                        <ValidationMessage For="@(() => _model.UserName)" />
                    </div>
                }

                <div class="form-group">
                    <label for="email">E-mail</label>
                    <InputText id="email" @bind-Value="_model.Email" class="form-control"
                               autocomplete="email"
                               autofocus="@( !_registrationPolicy.RequiresUserName )" />
                    <ValidationMessage For="@(() => _model.Email)" />
                </div>

                <div class="form-group">
                    <label for="password">Senha</label>
                    <InputText id="password" type="password" @bind-Value="_model.Password" class="form-control"
                               autocomplete="new-password" />
                    <ValidationMessage For="@(() => _model.Password)" />
                </div>

                <div class="form-group">
                    <label for="confirm">Confirmar senha</label>
                    <InputText id="confirm" type="password" @bind-Value="_model.ConfirmPassword" class="form-control"
                               autocomplete="new-password" />
                    <ValidationMessage For="@(() => _model.ConfirmPassword)" />
                </div>

                <button type="submit" class="btn btn-primary btn-block">Criar conta</button>
            </EditForm>

            <div class="auth-links">
                <a href="/account/login">Já tem conta? Entrar</a>
            </div>
        }
    </div>
}

@code {
    private RegisterInput? _boundModel;
    [SupplyParameterFromForm(FormName = "register")]
    private RegisterInput _model
    {
        get => _boundModel ??= new();
        set => _boundModel = value;
    }

    private string? _error;
    private bool _registered;
    private bool _confirmationMessageSent;
    private AccountRegistrationPolicy _registrationPolicy = new(false, false);
    private string _logoUrl = "_content/Sufficit.Identity.UI/img/logo-full.png";

    protected override async Task OnInitializedAsync()
    {
        _registrationPolicy = await AccountOnboarding
            .GetRegistrationPolicyAsync();

        // Load branding theme logo
        var theme = await BrandingProvider.GetActiveAsync();
        if (theme?.LogoUrl is not null)
            _logoUrl = theme.LogoUrl;
    }

    private async Task RegisterAsync()
    {
        var result = await AccountOnboarding.RegisterAsync(
            new AccountRegistrationCommand(
                _model.UserName,
                _model.Email,
                _model.Password));
        if (!result.Succeeded)
        {
            _error = string.Join(
                " ",
                result.Errors.Select(error => error.Description));
            return;
        }

        _confirmationMessageSent = result.ConfirmationMessageSent;
        _registered = true;
    }

    private sealed class RegisterInput
    {
        // UserName is collected only when required by the runtime policy.
        [StringLength(50, ErrorMessage = "O usuário deve ter entre {2} e {1} caracteres.", MinimumLength = 3)]
        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "O e-mail é obrigatório.")]
        [EmailAddress(ErrorMessage = "E-mail inválido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "A senha é obrigatória.")]
        [StringLength(100, ErrorMessage = "A senha deve ter pelo menos {2} caracteres.", MinimumLength = 6)]
        [DataType(System.ComponentModel.DataAnnotations.DataType.Password)]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirme a senha.")]
        [DataType(System.ComponentModel.DataAnnotations.DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "As senhas não conferem.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
