@page "/account/resetpassword"
@inject IAccountOnboardingService AccountOnboarding
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ResetPassword.Title"]</PageTitle>

<div class="auth-card">
    <h1>@L["ResetPassword.Title"]</h1>

    @if (_invalidRequest)
    {
        <SUIAlert ToneValue="SUITone.Danger">@L["ResetPassword.InvalidLink"]</SUIAlert>
        <SUIButton Href="/account/forgotpassword"
                   VariantValue="SUIVariant.Outlined"
                   ColorValue="SUIColor.Default">
            @L["ResetPassword.RequestNewLink"]
        </SUIButton>
    }
    else if (_done)
    {
        <SUIAlert ToneValue="SUITone.Success">@L["ResetPassword.Success"]</SUIAlert>
        <SUIButton Href="/account/login">@L["Login.Submit"]</SUIButton>
    }
    else
    {
        @if (_error is not null)
        {
            <SUIAlert ToneValue="SUITone.Danger">@_error</SUIAlert>
        }

        <EditForm Model="_model" Method="post" OnValidSubmit="ResetAsync" FormName="reset">
            <DataAnnotationsValidator />

            @* Account context is read-only. The opaque runtime token and user
               identifier are preserved as hidden fields across the POST. *@
            <div class="form-group">
                <label>@L["ResetPassword.Account"]</label>
                <p class="form-control-static"><strong>@_resolvedEmail</strong></p>
                <input type="hidden" name="_model.UserId" value="@_model.UserId" />
                <input type="hidden" name="_model.EncodedToken" value="@_model.EncodedToken" />
            </div>

            <SUITextField T="string" Id="password"
                          Label="@L["ResetPassword.NewPassword"]"
                          @bind-Value="_model.Password"
                          InputType="password"
                          autocomplete="new-password" autofocus />
            <SUITextField T="string" Id="confirm"
                          Label="@L["ResetPassword.ConfirmPassword"]"
                          @bind-Value="_model.ConfirmPassword"
                          InputType="password"
                          autocomplete="new-password" />

            <SUILoadingButton ButtonTypeValue="SUIButtonType.Submit" FullWidth>
                @L["ResetPassword.Submit"]
            </SUILoadingButton>
        </EditForm>
    }
</div>

@code {
    [SupplyParameterFromQuery] private string? UserId { get; set; }
    [SupplyParameterFromQuery(Name = "code")] private string? Token { get; set; }

    private ResetInput? _boundModel;
    [SupplyParameterFromForm(FormName = "reset")]
    private ResetInput _model
    {
        get => _boundModel ??= new();
        set => _boundModel = value;
    }

    private bool _done;
    private bool _invalidRequest;
    private string? _error;
    private string? _resolvedEmail;

    protected override async Task OnInitializedAsync()
    {
        var userId = UserId ?? _model.UserId;
        var encodedToken = Token ?? _model.EncodedToken;
        var context = await AccountOnboarding.GetPasswordResetContextAsync(
            userId,
            encodedToken);
        _invalidRequest = !context.IsValid;
        if (_invalidRequest)
            return;

        _model.UserId = userId!;
        _model.EncodedToken = encodedToken!;
        _resolvedEmail = context.AccountLabel;
    }

    private async Task ResetAsync()
    {
        var result = await AccountOnboarding.ResetPasswordAsync(
            new AccountPasswordResetCommand(
                _model.UserId,
                _model.EncodedToken,
                _model.Password));
        if (result.Status == AccountPasswordResetStatus.Succeeded)
        {
            _done = true;
        }
        else if (result.Status == AccountPasswordResetStatus.InvalidRequest)
        {
            _invalidRequest = true;
        }
        else
        {
            _error = string.Join(
                " ",
                result.Errors.Select(error => error.Description));
        }
    }

    private sealed class ResetInput
    {
        [Required]
        public string UserId { get; set; } = string.Empty;

        [Required(
            ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.PasswordRequired))]
        [StringLength(
            100,
            ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.PasswordLength),
            MinimumLength = 6)]
        [DataType(System.ComponentModel.DataAnnotations.DataType.Password)]
        public string Password { get; set; } = string.Empty;

        [Required(
            ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.ConfirmPasswordRequired))]
        [DataType(System.ComponentModel.DataAnnotations.DataType.Password)]
        [Compare(
            nameof(Password),
            ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.PasswordMismatch))]
        public string ConfirmPassword { get; set; } = string.Empty;

        // Hidden — populated from query string in OnInitialized.
        public string EncodedToken { get; set; } = string.Empty;
    }
}
