@page "/account/confirmemail"
@using Microsoft.AspNetCore.WebUtilities
@inject IAccountOnboardingService AccountOnboarding
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ConfirmEmail.Title"]</PageTitle>

<div class="auth-card">
    <h1>@L["ConfirmEmail.Title"]</h1>

    @if (_status is not null)
    {
        <SUIAlert ToneValue="@(_success ? SUITone.Success : SUITone.Danger)">@_status</SUIAlert>
    }

    <SUIButton Href="@LoginUrl">@L["Common.BackToLogin"]</SUIButton>
</div>

@code {
    [SupplyParameterFromQuery] private string? UserId { get; set; }
    [SupplyParameterFromQuery(Name = "code")] private string? Token { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] private string? ReturnUrl { get; set; }

    private string? _status;
    private bool _success;
    private string LoginUrl => QueryHelpers.AddQueryString(
        "/account/login",
        "returnUrl",
        LocalUrlValidator.EnsureLocal(ReturnUrl));

    protected override async Task OnInitializedAsync()
    {
        var result = await AccountOnboarding.ConfirmEmailAsync(
            UserId,
            Token);
        _success = result.Status == AccountEmailConfirmationStatus.Succeeded;
        _status = result.Status switch
        {
            AccountEmailConfirmationStatus.Succeeded =>
                L["ConfirmEmail.Success"],
            AccountEmailConfirmationStatus.InvalidRequest =>
                L["ConfirmEmail.InvalidLink"],
            _ => string.Join(
                " ",
                result.Errors.Select(error => error.Description)),
        };
    }
}
