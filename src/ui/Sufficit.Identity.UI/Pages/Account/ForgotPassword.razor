@page "/account/forgotpassword"
@rendermode @(RenderMode.InteractiveServer)
@inject IAccountOnboardingService AccountOnboarding
@inject IHumanVerificationService HumanVerification
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ForgotPassword.Title"]</PageTitle>

<div class="auth-card">
    <h1>@L["ForgotPassword.Title"]</h1>

    @if (_emailSent)
    {
        <div class="alert alert-success" role="alert">
            @L["ForgotPassword.Info"]
        </div>
        <a href="/account/login" class="btn btn-primary">@L["ForgotPassword.BackToLogin"]</a>
    }
    else
    {
        @if (_error is not null)
        {
            <div class="alert alert-error" role="alert">@_error</div>
        }

        <EditForm Model="_email" Method="post" OnValidSubmit="SendResetLinkAsync" FormName="forgot">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="email">@L["ForgotPassword.Email"]</label>
                <InputText id="email" @bind-Value="_email.Address" class="form-control"
                           autocomplete="email" autofocus />
                <ValidationMessage For="@(() => _email.Address)" />
            </div>

            <HumanVerification Flow="HumanVerificationFlow.PasswordRecovery"
                               @bind-Token="_verificationToken"
                               @ref="_verificationControl" />

            <button type="submit" class="btn btn-primary btn-block" disabled="@_submitting">
                @L["ForgotPassword.Submit"]
            </button>
        </EditForm>
    }
</div>

@code {
    private EmailInput? _boundEmail;
    [SupplyParameterFromForm(FormName = "forgot")]
    private EmailInput _email
    {
        get => _boundEmail ??= new();
        set => _boundEmail = value;
    }

    private bool _emailSent;
    private bool _submitting;
    private string? _error;
    private string _verificationToken = string.Empty;
    private HumanVerification? _verificationControl;

    private async Task SendResetLinkAsync()
    {
        if (_submitting)
        {
            return;
        }

        _submitting = true;
        _error = null;
        try
        {
            var verification = await HumanVerification.VerifyAsync(
                HumanVerificationFlow.PasswordRecovery,
                _verificationToken);
            if (!verification.Succeeded)
            {
                _error = L["HumanVerification.Required"];
                if (_verificationControl is not null)
                {
                    await _verificationControl.ResetAsync();
                }
                return;
            }

            var result = await AccountOnboarding.RequestPasswordResetAsync(
                _email.Address);
            _emailSent = result.Accepted;
        }
        finally
        {
            _submitting = false;
        }
    }

    private sealed class EmailInput
    {
        [Required, EmailAddress]
        public string Address { get; set; } = string.Empty;
    }
}
