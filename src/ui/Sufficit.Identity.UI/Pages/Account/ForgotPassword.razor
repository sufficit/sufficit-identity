@page "/account/forgotpassword"
@inject IAccountOnboardingService AccountOnboarding
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ForgotPassword.Title"]</PageTitle>

<div class="auth-card">
    <h1>@L["ForgotPassword.Title"]</h1>

    @if (_emailSent)
    {
        <div class="alert alert-success" role="alert">
            @L["ForgotPassword.Info"]
        </div>
        <a href="/account/login" class="btn btn-primary">@L["ForgotPassword.BackToLogin"]</a>
    }
    else
    {
        <EditForm Model="_email" Method="post" OnValidSubmit="SendResetLinkAsync" FormName="forgot">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="email">@L["ForgotPassword.Email"]</label>
                <InputText id="email" @bind-Value="_email.Address" class="form-control"
                           autocomplete="email" autofocus />
                <ValidationMessage For="@(() => _email.Address)" />
            </div>

            <button type="submit" class="btn btn-primary btn-block">@L["ForgotPassword.Submit"]</button>
        </EditForm>
    }
</div>

@code {
    private EmailInput? _boundEmail;
    [SupplyParameterFromForm(FormName = "forgot")]
    private EmailInput _email
    {
        get => _boundEmail ??= new();
        set => _boundEmail = value;
    }

    private bool _emailSent;

    private async Task SendResetLinkAsync()
    {
        var result = await AccountOnboarding.RequestPasswordResetAsync(
            _email.Address);
        _emailSent = result.Accepted;
    }

    private sealed class EmailInput
    {
        [Required, EmailAddress]
        public string Address { get; set; } = string.Empty;
    }
}
