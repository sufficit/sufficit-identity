@page "/account/loginwithrecoverycode"
@inject IInteractiveSignInService SignInService
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["RecoveryCode.Title"]</PageTitle>

<div class="auth-card">
    <h1>@L["RecoveryCode.Title"]</h1>
    <p class="info">@L["RecoveryCode.EnterCode"]</p>

    @if (ErrorMessage is { } errorMessage)
    {
        <SUIAlert ToneValue="SUITone.Danger">@errorMessage</SUIAlert>
    }

    <form method="post" action="/account/login/recoverycode" data-enhance="false" data-auth-submit-once>
        <AntiforgeryToken />
        <input type="hidden" name="ReturnUrl" value="@_returnUrl" />

        <SUITextField T="string" Id="code"
                      Label="@L["RecoveryCode.CodeLabel"]"
                      Placeholder="abc-defg"
                      name="Code"
                      autocomplete="one-time-code" autofocus required />

        <SUILoadingButton ButtonTypeValue="SUIButtonType.Submit" FullWidth>
            @L["Login.Submit"]
        </SUILoadingButton>
    </form>

    <div class="auth-links">
        <a href="/account/loginwith2fa?returnUrl=@Uri.EscapeDataString(_returnUrl ?? "/")">
            @L["RecoveryCode.BackToAuthenticator"]
        </a>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery] private string? Error { get; set; }
    private string? _returnUrl;

    private string? ErrorMessage => Error switch
    {
        "locked_out" => L["RecoveryCode.Error.LockedOut"].Value,
        "pending_state_missing" => L["RecoveryCode.Error.SessionExpired"].Value,
        "request_expired" => L["RecoveryCode.Error.RequestExpired"].Value,
        "invalid_code" => L["RecoveryCode.Error.InvalidCode"].Value,
        _ => null,
    };

    protected override async Task OnInitializedAsync()
    {
        // Reject absolute/off-host returnUrl (authenticated open redirect).
        _returnUrl = LocalUrlValidator.EnsureLocal(ReturnUrl);

        if (!await SignInService.HasPendingTwoFactorSignInAsync())
        {
            Navigation.NavigateTo("/account/login?returnUrl=" + Uri.EscapeDataString(_returnUrl), forceLoad: true);
        }
    }

}
