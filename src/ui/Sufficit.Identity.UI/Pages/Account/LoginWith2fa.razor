@page "/account/loginwith2fa"
@inject IInteractiveSignInService SignInService
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["TwoFactor.Title"]</PageTitle>

<div class="auth-card">
    <h1>@L["TwoFactor.Title"]</h1>
    <p class="info">@L["TwoFactor.EnterCode"]</p>

    @if (ErrorMessage is { } errorMessage)
    {
        <SUIAlert ToneValue="SUITone.Danger">@errorMessage</SUIAlert>
    }

    <form method="post" action="/account/login/2fa" data-enhance="false" data-auth-submit-once>
        <AntiforgeryToken />
        <input type="hidden" name="ReturnUrl" value="@_returnUrl" />
        @if (RememberMe)
        {
            <input type="hidden" name="RememberMe" value="true" />
        }

        <SUITextField T="string" Id="code"
                      Label="@L["TwoFactor.VerificationCode"]"
                      Placeholder="123456"
                      MaxLength="7"
                      name="Code"
                      autocomplete="one-time-code" autofocus required minlength="6" />

        <div class="form-check">
            <input id="rememberMachine" name="RememberClient" type="checkbox" value="true" />
            <label for="rememberMachine">@L["TwoFactor.RememberDevice"]</label>
        </div>

        <SUILoadingButton ButtonTypeValue="SUIButtonType.Submit" FullWidth>
            @L["TwoFactor.Submit"]
        </SUILoadingButton>
    </form>

    <div class="auth-links">
        <a href="/account/loginwithrecoverycode?returnUrl=@Uri.EscapeDataString(_returnUrl ?? "/")">
            @L["TwoFactor.UseRecoveryCode"]
        </a>
        <br />
        <a href="/account/logout">@L["Common.Cancel"]</a>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] private bool RememberMe { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }
    private string? _returnUrl;

    private string? ErrorMessage => Error switch
    {
        "locked_out" => L["TwoFactor.Error.LockedOut"].Value,
        "pending_state_missing" => L["TwoFactor.Error.SessionExpired"].Value,
        "request_expired" => L["TwoFactor.Error.RequestExpired"].Value,
        "invalid_code" => L["TwoFactor.Error.InvalidCode"].Value,
        _ => null,
    };

    protected override async Task OnInitializedAsync()
    {
        // Reject absolute/off-host returnUrl (authenticated open redirect).
        _returnUrl = LocalUrlValidator.EnsureLocal(ReturnUrl);

        // The runtime owns and validates the protected pending-2FA state.
        if (!await SignInService.HasPendingTwoFactorSignInAsync())
        {
            // No pending 2FA session — redirect to login.
            Navigation.NavigateTo("/account/login?returnUrl=" + Uri.EscapeDataString(_returnUrl), forceLoad: true);
        }
    }

}
