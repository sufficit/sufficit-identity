@page "/device/usercode"
@page "/device"
@attribute [Authorize]
@using System.Globalization
@inject IDeviceAuthorizationContextService DeviceContextService
@inject ScopeViewModelProvider ScopeProvider
@inject IStringLocalizer<SharedResource> L

<PageTitle>Confirmar acesso — Sufficit Identity</PageTitle>

<div class="auth-card device-authorization-card">
    @if (_resultApproved is not null)
    {
        @if (_resultApproved == true)
        {
            <div class="device-result" role="status" data-device-flow-result>
                <span class="device-result__icon" aria-hidden="true">✓</span>
                <h1>Acesso autorizado</h1>
                <p>@L["Device.Approved"]</p>
            </div>
        }
        else
        {
            <div class="device-result" role="status" data-device-flow-result>
                <span class="device-result__icon device-result__icon--denied" aria-hidden="true">×</span>
                <h1>Acesso negado</h1>
                <p>@L["Device.Denied"]</p>
            </div>
        }
        <button type="button" class="btn btn-primary btn-block" data-device-flow-close>
            Fechar esta aba
        </button>
        <p class="device-close-fallback" data-device-close-fallback hidden role="status">
            O navegador não permitiu fechar esta aba automaticamente. Você pode fechá-la pelo controle de abas e voltar ao dispositivo que iniciou o acesso.
        </p>
        <noscript>
            <p class="device-close-fallback">
                Você pode fechar esta aba e voltar ao dispositivo que iniciou o acesso.
            </p>
        </noscript>
    }
    else if (string.IsNullOrEmpty(_userCode))
    {
        <h1>@L["Device.Activate"]</h1>
        <p class="auth-card-subtitle">
            @L["Device.EnterCode"]
        </p>

        <form method="get" action="/connect/device">
            <div class="form-group">
                <label for="usercode">@L["Device.CodeLabel"]</label>
                <input id="usercode" name="user_code" class="form-control device-code"
                       inputmode="numeric" placeholder="@L["Device.CodePlaceholder"]"
                       autocomplete="one-time-code" autofocus />
                <span class="field-hint">O código identifica esta solicitação e expira em poucos minutos.</span>
            </div>

            <button type="submit" class="btn btn-primary btn-block">@L["Device.Continue"]</button>
        </form>
    }
    else if (_error is not null)
    {
        <h1>Não foi possível confirmar</h1>
        <div class="alert alert-error" role="alert">@_error</div>
        <a class="btn btn-secondary btn-block" href="/device/usercode">@L["Device.TryAgain"]</a>
    }
    else
    {
        <header class="device-authorization-header">
            <h1>Confirmar acesso</h1>
            <p>
                @L["Device.RequestingAccess"]
            </p>
        </header>

        <div class="device-client" aria-label="@L["Device.Application"]">
            <span class="device-client__mark" aria-hidden="true">@ClientInitial</span>
            <span class="device-client__identity">
                <strong>@_clientName</strong>
                <code>@_clientId</code>
            </span>
            <span class="badge badge-outline">Solicitante</span>
        </div>

        <div class="device-code-confirmation">
            <span>Código confirmado</span>
            <strong>@_displayCode</strong>
        </div>

        <section class="device-permissions" aria-labelledby="device-permissions-title">
            <h2 id="device-permissions-title">@L["Device.RequestedScopes"]</h2>
            @if (_scopes.Count == 0)
            {
                <p class="device-permissions__empty">Nenhuma permissão adicional foi solicitada.</p>
            }
            else
            {
                <ul class="device-scope-list">
                    @foreach (var scope in _scopes)
                    {
                        <li class="device-scope-item">
                            <span class="device-scope-item__check" aria-hidden="true">✓</span>
                            <span>
                                <strong>@scope.DisplayName</strong>
                                <small>@scope.Description</small>
                            </span>
                        </li>
                    }
                </ul>
            }
        </section>

        <dl class="device-validity" aria-label="Validade do acesso">
            <div class="device-validity__row">
                <dt>Validade do token</dt>
                <dd>
                    @if (_estimatedAccessTokenExpiresAt is { } expiresAt)
                    {
                        <strong>
                            Até <time datetime="@expiresAt.ToString("O", CultureInfo.InvariantCulture)">@FormatExpiration(expiresAt)</time>
                        </strong>
                        <span>@FormatLifetime(_accessTokenLifetime!.Value) após a emissão.</span>
                    }
                    else
                    {
                        <strong>Prazo indeterminado</strong>
                        <span>Este token não tem uma expiração configurada.</span>
                    }
                </dd>
            </div>
            @if (_allowsRefreshAccess)
            {
                <div class="device-validity__row">
                    <dt>Renovação</dt>
                    <dd>
                        <strong>Acesso contínuo solicitado</strong>
                        <span>A aplicação poderá renovar o token até você revogar esta autorização.</span>
                    </dd>
                </div>
            }
        </dl>

        <p class="device-safety-note">
            Autorize somente se você iniciou esta solicitação. A aplicação nunca verá sua senha.
        </p>

        <form method="post" action="/connect/device">
            <AntiforgeryToken />
            <input type="hidden" name="user_code" value="@_userCode" />

            <div class="btn-group device-authorization-actions">
                <button type="submit" name="approved" value="true" class="btn btn-primary btn-block">
                    @L["Device.Authorize"]
                </button>
                <button type="submit" name="approved" value="false" class="btn btn-secondary btn-block">
                    @L["Device.Deny"]
                </button>
            </div>
        </form>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "user_code")] private string? UserCodeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "code")] private string? LegacyCodeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "result")] private string? Result { get; set; }

    private string? _userCode;
    private string? _displayCode;
    private string? _clientId;
    private string? _clientName;
    private IReadOnlyList<ScopeViewModel> _scopes = Array.Empty<ScopeViewModel>();
    private TimeSpan? _accessTokenLifetime;
    private DateTimeOffset? _estimatedAccessTokenExpiresAt;
    private bool _allowsRefreshAccess;
    private string? _error;
    private bool? _resultApproved;

    private string ClientInitial => string.IsNullOrWhiteSpace(_clientName)
        ? "A"
        : _clientName.Trim()[..1].ToUpperInvariant();

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(Result))
        {
            _resultApproved = string.Equals(Result, "approved", StringComparison.OrdinalIgnoreCase);
            return;
        }

        var raw = UserCodeQuery ?? LegacyCodeQuery;
        if (string.IsNullOrWhiteSpace(raw))
        {
            return;
        }

        _userCode = NormalizeCode(raw);
        _displayCode = FormatCode(_userCode);

        var context = await DeviceContextService.GetCurrentAsync();
        if (!context.IsValid)
        {
            _error = L["Device.InvalidCode"];
            return;
        }

        _clientId = context.ClientId;
        _clientName = context.ClientDisplayName ?? context.ClientId;
        _scopes = ScopeProvider.Build(context.RequestedScopes);
        _accessTokenLifetime = context.AccessTokenLifetime;
        _estimatedAccessTokenExpiresAt = context.AccessTokenLifetime is { } lifetime
            ? DateTimeOffset.UtcNow.Add(lifetime)
            : null;
        _allowsRefreshAccess = context.AllowsRefreshAccess;
    }

    private static string NormalizeCode(string code) =>
        code.Trim().ToUpperInvariant().Replace("-", string.Empty)
            .Replace(" ", string.Empty);

    private static string FormatCode(string code)
    {
        if (code.Length <= 4)
        {
            return code;
        }

        return string.Join('-', Enumerable.Range(0, (code.Length + 3) / 4)
            .Select(index => code.Substring(
                index * 4,
                Math.Min(4, code.Length - index * 4))));
    }

    private static string FormatExpiration(DateTimeOffset value) =>
        value.UtcDateTime.ToString(
            "dd/MM/yyyy 'às' HH:mm 'UTC'",
            CultureInfo.GetCultureInfo("pt-BR"));

    private static string FormatLifetime(TimeSpan value)
    {
        if (value.TotalDays >= 1 && value.TotalDays == Math.Truncate(value.TotalDays))
        {
            var days = (int)value.TotalDays;
            return days == 1 ? "1 dia" : $"{days} dias";
        }

        if (value.TotalHours >= 1 && value.TotalHours == Math.Truncate(value.TotalHours))
        {
            var hours = (int)value.TotalHours;
            return hours == 1 ? "1 hora" : $"{hours} horas";
        }

        var minutes = Math.Max(1, (int)Math.Round(value.TotalMinutes));
        return minutes == 1 ? "1 minuto" : $"{minutes} minutos";
    }
}
