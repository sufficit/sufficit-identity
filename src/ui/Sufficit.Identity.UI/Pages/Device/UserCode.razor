@page "/device/usercode"
@page "/device"
@attribute [Authorize]
@using System.Globalization
@inject IDeviceAuthorizationContextService DeviceContextService
@inject INativeReturnUriTicketService NativeReturnTickets
@inject ScopeViewModelProvider ScopeProvider
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Device.PageTitle"]</PageTitle>

<div class="auth-card device-authorization-card">
    @if (_resultApproved is not null)
    {
        @if (_resultApproved == true)
        {
            <div class="device-result" role="status" data-device-flow-result="approved" data-device-launch-mode="@TerminalLaunchMode">
                <span class="device-result__icon" aria-hidden="true">✓</span>
                <h1>@L["Device.ApprovedTitle"]</h1>
                <p>@L["Device.Approved"]</p>
            </div>
        }
        else
        {
            <div class="device-result" role="status" data-device-flow-result="denied" data-device-launch-mode="@TerminalLaunchMode">
                <span class="device-result__icon device-result__icon--denied" aria-hidden="true">×</span>
                <h1>@L["Device.DeniedTitle"]</h1>
                <p>@L["Device.Denied"]</p>
            </div>
        }
        @if (NativeReturnUri is { } returnUri)
        {
            <a class="btn btn-primary btn-block" href="@returnUri"
               data-device-flow-return aria-describedby="device-return-hint">
                @L["Device.ReturnToApp"]
            </a>
            <p id="device-return-hint" class="device-return-hint">
                @L["Device.ReturnToAppHint"]
            </p>
        }
        else
        {
            <button type="button" class="btn btn-primary btn-block" data-device-flow-close>
                @L["Device.CloseTab"]
            </button>
            <p id="device-close-fallback" class="device-close-fallback" data-device-close-fallback hidden role="status" aria-live="polite">
                @L["Device.CloseFallback"]
            </p>
        }
        @if (NativeReturnUri is null)
        {
            <noscript>
                <p class="device-close-fallback">
                    @L["Device.CloseNoScript"]
                </p>
            </noscript>
        }
    }
    else if (string.IsNullOrEmpty(_userCode))
    {
        <h1>@L["Device.Activate"]</h1>
        <p class="auth-card-subtitle">
            @L["Device.EnterCode"]
        </p>

        <form method="get" action="/connect/device">
            <div class="form-group">
                <label for="usercode">@L["Device.CodeLabel"]</label>
                <input id="usercode" name="user_code" class="form-control device-code"
                       inputmode="numeric" placeholder="@L["Device.CodePlaceholder"]"
                       autocomplete="one-time-code" autofocus />
                <span class="field-hint">@L["Device.CodeHint"]</span>
            </div>

            <button type="submit" class="btn btn-primary btn-block">@L["Device.Continue"]</button>
        </form>
    }
    else if (_error is not null)
    {
        <h1>@L["Device.ConfirmationFailed"]</h1>
        <div class="alert alert-error" role="alert">@_error</div>
        <a class="btn btn-secondary btn-block" href="/device/usercode">@L["Device.TryAgain"]</a>
    }
    else
    {
        <header class="device-authorization-header">
            <h1>@L["Device.ConfirmTitle"]</h1>
            <p>
                @L["Device.RequestingAccess"]
            </p>
        </header>

        <div class="device-client" aria-label="@L["Device.Application"]">
            <span class="device-client__mark" aria-hidden="true">@ClientInitial</span>
            <span class="device-client__identity">
                <strong>@_clientName</strong>
                <code>@_clientId</code>
            </span>
            <span class="badge badge-outline">@L["Device.Requester"]</span>
        </div>

        <div class="device-code-confirmation">
            <span>@L["Device.CodeConfirmed"]</span>
            <strong>@_displayCode</strong>
        </div>

        <section class="device-permissions" aria-labelledby="device-permissions-title">
            <h2 id="device-permissions-title">@L["Device.RequestedScopes"]</h2>
            @if (_scopes.Count == 0)
            {
                <p class="device-permissions__empty">@L["Device.NoAdditionalScopes"]</p>
            }
            else
            {
                <ul class="device-scope-list">
                    @foreach (var scope in _scopes)
                    {
                        <li class="device-scope-item">
                            <span class="device-scope-item__check" aria-hidden="true">✓</span>
                            <span>
                                <strong>@scope.DisplayName</strong>
                                <small>@scope.Description</small>
                                @if (scope.IsTechnical)
                                {
                                    <code class="device-scope-item__identifier">@scope.Name</code>
                                }
                            </span>
                        </li>
                    }
                </ul>
            }
        </section>

        @if (_resources.Count > 0)
        {
            <details class="device-resources">
                <summary>@L["Device.AccessDestinations"]</summary>
                <p>@L["Device.AccessDestinationsDescription"]</p>
                <ul>
                    @foreach (var resource in _resources)
                    {
                        <li><code>@resource</code></li>
                    }
                </ul>
            </details>
        }

        <dl class="device-validity" aria-label="@L["Device.ValidityLabel"]">
            <div class="device-validity__row">
                <dt>@L["Device.TokenValidity"]</dt>
                <dd>
                    @if (_estimatedAccessTokenExpiresAt is { } expiresAt)
                    {
                        <strong>
                            @L["Device.ValidUntil"] <time datetime="@expiresAt.ToString("O", CultureInfo.InvariantCulture)">@FormatExpiration(expiresAt)</time>
                        </strong>
                        <span>@L["Device.IssuedAfter", FormatLifetime(_accessTokenLifetime!.Value)]</span>
                    }
                    else
                    {
                        <strong>@L["Device.NoExpirationTitle"]</strong>
                        <span>@L["Device.NoExpirationDescription"]</span>
                    }
                </dd>
            </div>
            @if (_allowsRefreshAccess)
            {
                <div class="device-validity__row">
                    <dt>@L["Device.Renewal"]</dt>
                    <dd>
                        <strong>@L["Device.ContinuousAccess"]</strong>
                        <span>@L["Device.ContinuousAccessDescription"]</span>
                    </dd>
                </div>
            }
        </dl>

        <p class="device-safety-note">
            @L["Device.SafetyNote"]
        </p>

        <form method="post" action="/connect/device" data-enhance="false">
            <AntiforgeryToken />
            <input type="hidden" name="user_code" value="@_userCode" />
            @if (IsPopup)
            {
                <input type="hidden" name="launch_mode" value="popup" />
            }
            else if (NativeReturnUri is not null)
            {
                <input type="hidden" name="launch_mode" value="app" />
                <input type="hidden" name="return_ticket" value="@ReturnTicketQuery" />
            }

            <div class="btn-group device-authorization-actions">
                <button type="submit" name="approved" value="true" class="btn btn-primary btn-block">
                    @L["Device.Authorize"]
                </button>
                <button type="submit" name="approved" value="false" class="btn btn-secondary btn-block">
                    @L["Device.Deny"]
                </button>
            </div>
        </form>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "user_code")] private string? UserCodeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "code")] private string? LegacyCodeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "result")] private string? Result { get; set; }
    [SupplyParameterFromQuery(Name = "launch_mode")] private string? LaunchModeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "return_ticket")] private string? ReturnTicketQuery { get; set; }

    private string? _userCode;
    private string? _displayCode;
    private string? _clientId;
    private string? _clientName;
    private IReadOnlyList<ScopeViewModel> _scopes = Array.Empty<ScopeViewModel>();
    private IReadOnlyList<string> _resources = Array.Empty<string>();
    private TimeSpan? _accessTokenLifetime;
    private DateTimeOffset? _estimatedAccessTokenExpiresAt;
    private bool _allowsRefreshAccess;
    private string? _error;
    private bool? _resultApproved;

    private bool IsPopup =>
        string.Equals(LaunchModeQuery, "popup", StringComparison.OrdinalIgnoreCase);

    // The callback was already checked against the client's registration by
    // the STS, which handed it back as an encrypted ticket. This page only
    // opens the ticket: a query string edited in the browser produces nothing.
    private string? NativeReturnUri =>
        string.Equals(LaunchModeQuery, "app", StringComparison.OrdinalIgnoreCase)
            ? NativeReturnTickets.Unprotect(ReturnTicketQuery)
            : null;

    private string? TerminalLaunchMode => NativeReturnUri is not null
        ? "app"
        : IsPopup ? "popup" : null;

    private string ClientInitial => string.IsNullOrWhiteSpace(_clientName)
        ? "A"
        : _clientName.Trim()[..1].ToUpperInvariant();

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(Result))
        {
            _resultApproved = string.Equals(Result, "approved", StringComparison.OrdinalIgnoreCase);
            return;
        }

        var raw = UserCodeQuery ?? LegacyCodeQuery;
        if (string.IsNullOrWhiteSpace(raw))
        {
            return;
        }

        _userCode = NormalizeCode(raw);
        _displayCode = FormatCode(_userCode);

        var context = await DeviceContextService.GetCurrentAsync();
        if (!context.IsValid)
        {
            _error = L["Device.InvalidCode"];
            return;
        }

        _clientId = context.ClientId;
        _clientName = context.ClientDisplayName ?? context.ClientId;
        _scopes = ScopeProvider.Build(
            context.ScopePresentations is { Count: > 0 }
                ? context.ScopePresentations
                : context.RequestedScopes.Select(scope =>
                    new AuthorizationScopePresentation(scope, null, null, [])));
        _resources = context.RequestedResources ?? [];
        _accessTokenLifetime = context.AccessTokenLifetime;
        _estimatedAccessTokenExpiresAt = context.AccessTokenLifetime is { } lifetime
            ? DateTimeOffset.UtcNow.Add(lifetime)
            : null;
        _allowsRefreshAccess = context.AllowsRefreshAccess;
    }

    private static string NormalizeCode(string code) =>
        code.Trim().ToUpperInvariant().Replace("-", string.Empty)
            .Replace(" ", string.Empty);

    private static string FormatCode(string code)
    {
        if (code.Length <= 4)
        {
            return code;
        }

        return string.Join('-', Enumerable.Range(0, (code.Length + 3) / 4)
            .Select(index => code.Substring(
                index * 4,
                Math.Min(4, code.Length - index * 4))));
    }

    private static string FormatExpiration(DateTimeOffset value) =>
        $"{value.UtcDateTime.ToString("g", CultureInfo.CurrentCulture)} UTC";

    private string FormatLifetime(TimeSpan value)
    {
        if (value.TotalDays >= 1 && value.TotalDays == Math.Truncate(value.TotalDays))
        {
            var days = (int)value.TotalDays;
            return days == 1
                ? L["Device.Duration.Day"]
                : L["Device.Duration.Days", days];
        }

        if (value.TotalHours >= 1 && value.TotalHours == Math.Truncate(value.TotalHours))
        {
            var hours = (int)value.TotalHours;
            return hours == 1
                ? L["Device.Duration.Hour"]
                : L["Device.Duration.Hours", hours];
        }

        var minutes = Math.Max(1, (int)Math.Round(value.TotalMinutes));
        return minutes == 1
            ? L["Device.Duration.Minute"]
            : L["Device.Duration.Minutes", minutes];
    }
}
