@page "/manage/personaldata"
@attribute [Authorize]
@inject IAccountSelfService AccountSelfService
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["PersonalData.Title"]</PageTitle>

<div class="auth-card">
    <ManageBackLink />
    <h1>@L["PersonalData.Title"]</h1>
    <p class="info">@L["PersonalData.Description"]</p>

    @if (_error is not null)
    {
        <div class="alert alert-error">@_error</div>
    }

    <div class="btn-group">
        <EditForm Method="post" Model="_empty" OnValidSubmit="DownloadAsync" FormName="download-data">
            <button type="submit" class="btn btn-primary">@L["PersonalData.Download"]</button>
        </EditForm>
        <a href="/manage/deleteaccount" class="btn btn-danger">@L["PersonalData.DeleteAccount"]</a>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? _authTask { get; set; }

    private string? _error;
    private readonly object _empty = new();

    private async Task DownloadAsync()
    {
        var principal = await _authTask.GetAuthenticatedPrincipalAsync();
        if (principal is null)
        {
            _error = L["ChangePassword.SessionExpired"];
            return;
        }

        var export = await AccountSelfService.ExportPersonalDataAsync(principal);
        if (export is null)
        {
            _error = L["PersonalData.LoadFailed"];
            return;
        }

        _error = null;
        await JS.InvokeVoidAsync(
            "sufficitIdentityDownloadFile",
            export.FileName,
            Convert.ToBase64String(export.Content),
            export.ContentType);
    }
}
