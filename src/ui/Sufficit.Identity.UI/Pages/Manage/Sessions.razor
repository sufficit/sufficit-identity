@page "/manage/sessions"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Authorize]
@using System.Globalization
@inject IAccountAccessService AccountAccessService
@inject IJSRuntime JS
@inject ILogger<Sessions> Logger
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Sessions.Title"]</PageTitle>

<div class="auth-card manage-sessions">
    <ManageBackLink />
    <header class="manage-sessions__header">
        <div>
            <h1>@L["Sessions.Title"]</h1>
            <p class="info">@L["Sessions.Description"]</p>
        </div>
        @if (!_loading && _sessions.Count > 0)
        {
            <SUIChip SizeValue="SUISize.Small" VariantValue="SUIVariant.Outlined">
                @L["Sessions.CredentialCount", _sessions.Count]
            </SUIChip>
        }
    </header>

    <div aria-live="polite">
        @if (_success is not null)
        {
            <SUIAlert ToneValue="SUITone.Success">@_success</SUIAlert>
        }
        @if (_error is not null)
        {
            <SUIAlert ToneValue="SUITone.Danger">@_error</SUIAlert>
        }
    </div>

    @if (_loading)
    {
        <p class="muted">@L["Sessions.Loading"]</p>
    }
    else if (_sessions.Count == 0)
    {
        <p class="muted">@L["Sessions.None"]</p>
    }
    else
    {
        <ul class="session-groups">
            @foreach (var group in SessionGroups)
            {
                <li class="session-group">
                    <header class="session-group__header">
                        <div>
                            <strong class="session-group__title">@group.DisplayName</strong>
                            @if (!string.IsNullOrWhiteSpace(group.ClientId))
                            {
                                <span class="access-client-id">@group.ClientId</span>
                            }
                        </div>
                        <SUIChip SizeValue="SUISize.Small">
                            @L["Sessions.CredentialCount", group.Sessions.Count]
                        </SUIChip>
                    </header>
                    <ul class="session-credential-list">
                        @foreach (var session in group.Sessions)
                        {
                            <li class="session-credential">
                                <dl class="access-metadata">
                                    <div>
                                        <dt>@L["Sessions.Type"]</dt>
                                        <dd>@FormatTokenType(session.Type)</dd>
                                    </div>
                                    <div>
                                        <dt>@L["Sessions.Issued"]</dt>
                                        <dd>@FormatDate(session.CreatedAt)</dd>
                                    </div>
                                    <div>
                                        <dt>@L["Sessions.Expires"]</dt>
                                        <dd>@FormatDate(session.ExpiresAt, L["Sessions.NoExpiration"])</dd>
                                    </div>
                                </dl>
                                <SUILoadingButton SizeValue="SUISize.Small"
                                                  ColorValue="SUIColor.Error"
                                                  Class="access-item-action"
                                                  aria-label="@L["Sessions.RevokeAria", group.DisplayName]"
                                                  Disabled="@IsBusy"
                                                  OnClick="@(() => RevokeAsync(session))">
                                    @(_busySessionId == session.Id
                                        ? L["Sessions.Revoking"]
                                        : L["Sessions.RevokeCredential"])
                                </SUILoadingButton>
                            </li>
                        }
                    </ul>
                </li>
            }
        </ul>

        <div class="session-revoke-all">
            <p class="muted">
                @L["Sessions.RevokeAllDescription"]
            </p>
            <SUILoadingButton ColorValue="SUIColor.Error"
                              Disabled="@IsBusy"
                              OnClick="RevokeAllAsync">
                @(_revokingAll ? L["Sessions.RevokingAll"] : L["Sessions.RevokeAll"])
            </SUILoadingButton>
        </div>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? _authTask { get; set; }

    private IReadOnlyList<AccountSessionCredential> _sessions = [];
    private bool _loading = true;
    private bool _revokingAll;
    private string? _busySessionId;
    private string? _success;
    private string? _error;
    private bool IsBusy => _revokingAll || _busySessionId is not null;

    private IReadOnlyList<SessionGroup> SessionGroups => _sessions
        .GroupBy(session => new { session.ClientId, session.DisplayName })
        .Select(group => new SessionGroup(
            group.Key.ClientId,
            group.Key.DisplayName,
            group.ToArray()))
        .ToArray();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var principal = await _authTask.GetAuthenticatedPrincipalAsync();
            if (principal is null)
            {
                _error = L["ChangePassword.SessionExpired"];
                return;
            }

            _sessions = await AccountAccessService.GetSessionsAsync(principal);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Active sessions could not be loaded.");
            _error = L["Sessions.LoadFailed"];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RevokeAsync(AccountSessionCredential session)
    {
        _busySessionId = session.Id;
        _success = null;
        _error = null;
        try
        {
            var principal = await _authTask.GetAuthenticatedPrincipalAsync();
            if (principal is null)
            {
                _error = L["ChangePassword.SessionExpired"];
                return;
            }

            var result = await AccountAccessService.RevokeSessionAsync(
                principal,
                session.Id);
            if (!result.Succeeded)
            {
                _error = result.Errors.Any(error => error.Code == "session-not-found")
                    ? L["Sessions.NotFound"]
                    : L["Sessions.RevokeFailed"];
                return;
            }

            _sessions = _sessions
                .Where(item => item.Id != session.Id)
                .ToArray();
            _success = L["Sessions.RevokeSuccess"];
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Session credential {SessionId} could not be revoked.",
                session.Id);
            _error = L["Sessions.RevokeFailed"];
        }
        finally
        {
            _busySessionId = null;
        }
    }

    private async Task RevokeAllAsync()
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            L["Sessions.RevokeAllConfirm"].Value);
        if (!confirmed)
        {
            return;
        }

        _revokingAll = true;
        _success = null;
        _error = null;
        try
        {
            var principal = await _authTask.GetAuthenticatedPrincipalAsync();
            if (principal is null)
            {
                _error = L["ChangePassword.SessionExpired"];
                return;
            }

            var result = await AccountAccessService.RevokeAllSessionsAsync(principal);
            if (!result.Succeeded)
            {
                _error = string.Join(
                    " ",
                    result.Errors.Select(error => error.Description));
                return;
            }

            _sessions = [];
            _success = L["Sessions.RevokeAllSuccess"];
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "All account sessions could not be revoked.");
            _error = L["Sessions.RevokeAllFailed"];
        }
        finally
        {
            _revokingAll = false;
        }
    }

    private string FormatTokenType(string type)
    {
        var value = type
            .Split(':', StringSplitOptions.RemoveEmptyEntries)
            .LastOrDefault() ?? type;

        return value switch
        {
            "access_token" => L["Sessions.AccessToken"],
            "refresh_token" => L["Sessions.RefreshToken"],
            "identity_token" => L["Sessions.IdentityToken"],
            "authorization_code" => L["Sessions.AuthCode"],
            "device_code" => L["Sessions.DeviceCode"],
            "user_code" => L["Sessions.UserCode"],
            _ => value,
        };
    }

    private string FormatDate(
        DateTimeOffset? value,
        string? fallback = null) =>
        value is null
            ? fallback ?? L["Common.NotProvided"]
            : $"{value.Value.UtcDateTime.ToString("g", CultureInfo.CurrentCulture)} UTC";

    private sealed record SessionGroup(
        string? ClientId,
        string DisplayName,
        IReadOnlyList<AccountSessionCredential> Sessions);
}
