@page "/manage/passkeys"
@attribute [Authorize]
@rendermode @(RenderMode.InteractiveServer)
@using Sufficit.Identity.UI.Services
@inject IAccountPasskeyService PasskeyService
@inject IJSRuntime JS
@inject ILogger<Passkeys> Logger
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ManagePasskeys.Title"]</PageTitle>

<div class="auth-card">
    <ManageBackLink />
    <h1>@L["ManagePasskeys.Title"]</h1>
    <p class="info">@L["ManagePasskeys.Description"]</p>

    @if (_error is not null)
    {
        <div class="alert alert-error" role="alert" aria-live="assertive">@_error</div>
    }
    @if (_success is not null)
    {
        <div class="alert alert-success" role="status" aria-live="polite">@_success</div>
    }

    <h3>@L["ManagePasskeys.YourPasskeys"]</h3>
    @if (_loading)
    {
        <p class="muted" role="status">@L["ManagePasskeys.Loading"]</p>
    }
    else if (_loadFailed)
    {
        <div class="alert alert-error" role="alert">
            @L["ManagePasskeys.LoadError"]
            <button type="button" class="btn btn-secondary btn-sm" @onclick="LoadPasskeysAsync">
                @L["Common.TryAgain"]
            </button>
        </div>
    }
    else if (_overview?.Credentials.Count > 0)
    {
        <ul class="passkey-list">
            @foreach (var passkey in _overview.Credentials)
            {
                <li class="passkey-item">
                    @if (_editingCredentialId == passkey.CredentialId)
                    {
                        <div class="form-group passkey-inline-editor">
                            <label for="passkey-edit-name">@L["ManagePasskeys.Name"]</label>
                            <input id="passkey-edit-name" @ref="_renameInput"
                                   @bind="_editingPasskeyName" @bind:event="oninput"
                                   @onkeydown="@(args => HandleRenameKeyDownAsync(args, passkey.CredentialId))"
                                   class="form-control" maxlength="@_overview.MaximumNameLength"
                                   autocomplete="off" disabled="@_busy" />
                            <span class="field-hint">@L["ManagePasskeys.RenameHint"]</span>
                            <div class="passkey-inline-actions">
                                <button type="button" class="btn btn-primary btn-sm" disabled="@_busy"
                                        @onclick="@(async () => await SavePasskeyNameAsync(passkey.CredentialId))">
                                    @(_busy ? L["ManagePasskeys.Saving"] : L["ManagePasskeys.SaveName"])
                                </button>
                                <button type="button" class="btn btn-secondary btn-sm" disabled="@_busy"
                                        @onclick="CancelRenaming">
                                    @L["Common.Cancel"]
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="passkey-item-info">
                            <span class="passkey-name">@(passkey.Name ?? L["ManagePasskeys.Unnamed"])</span>
                            <span class="passkey-meta">@L["ManagePasskeys.CreatedAt", passkey.CreatedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")]</span>
                            @if (passkey.IsBackedUp)
                            {
                                <span class="badge badge-success">@L["ManagePasskeys.Synced"]</span>
                            }
                        </div>
                        <div class="passkey-item-actions">
                            <button type="button" class="btn btn-secondary btn-sm" disabled="@_busy"
                                    aria-label="Renomear @(passkey.Name ?? "passkey sem nome")"
                                    @onclick="@(() => StartRenaming(passkey))">
                                Renomear
                            </button>
                            <button type="button" class="btn btn-danger btn-sm" disabled="@_busy"
                                    aria-label="Remover @(passkey.Name ?? "passkey sem nome")"
                                    @onclick="@(async () => await RemovePasskeyAsync(passkey.CredentialId))">
                                Remover
                            </button>
                        </div>
                    }
                </li>
            }
        </ul>
    }
    else
    {
        <p class="muted">@L["ManagePasskeys.None"]</p>
    }

    @if (!_loading && !_loadFailed && _overview is not null)
    {
        <hr />
        <h3>@L["ManagePasskeys.Add"]</h3>

        @if (!_supported)
        {
            <div class="alert alert-info" role="status">
                @L["ManagePasskeys.Unsupported"]
            </div>
        }
        else if (!_overview.CanRegister)
        {
            <div class="alert alert-info" role="status">
                @L["ManagePasskeys.LimitReached", _overview.MaximumCredentials]
            </div>
        }
        else
        {
            <form @ref="_registrationForm">
                <AntiforgeryToken />
                <div class="form-group">
                    <label for="passkey-name">@L["ManagePasskeys.NameOptional"]</label>
                    <input id="passkey-name" name="name" @bind="_passkeyName" class="form-control"
                           maxlength="@_overview.MaximumNameLength" autocomplete="off"
                           placeholder="@L["ManagePasskeys.NamePlaceholder"]" disabled="@_busy" />
                    <span class="field-hint">@L["ManagePasskeys.DeviceNameHint"]</span>
                </div>
                <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="RegisterPasskeyAsync">
                    @(_busy ? L["ManagePasskeys.WaitingDevice"] : L["ManagePasskeys.Register"])
                </button>
            </form>
        }
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? _authTask { get; set; }

    private ElementReference _registrationForm;
    private ElementReference _renameInput;
    private AccountPasskeyOverview? _overview;
    private string? _passkeyName;
    private string? _editingCredentialId;
    private string? _editingPasskeyName;
    private string? _error;
    private string? _success;
    private bool _loading = true;
    private bool _loadFailed;
    private bool _busy;
    private bool _supported = true;
    private bool _focusRenameInput;

    protected override Task OnInitializedAsync() => LoadPasskeysAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _supported = await JS.InvokeAsync<bool>("passkeys.isSupported");
                StateHasChanged();
            }
            catch (JSException exception)
            {
                Logger.LogDebug(exception, "Passkey capability detection was unavailable.");
            }
        }

        if (_focusRenameInput)
        {
            _focusRenameInput = false;
            try
            {
                await _renameInput.FocusAsync();
            }
            catch (JSException exception)
            {
                Logger.LogDebug(exception, "Passkey rename input could not receive focus.");
            }
        }
    }

    private async Task LoadPasskeysAsync()
    {
        _loading = true;
        _loadFailed = false;

        try
        {
            var principal = await _authTask.GetAuthenticatedPrincipalAsync();
            if (principal is null)
            {
                _error = "Sua sessão expirou. Entre novamente para gerenciar passkeys.";
                _overview = null;
                return;
            }

            _overview = await PasskeyService.GetOverviewAsync(principal);
            if (_overview is null)
            {
                _error = "Sua sessão expirou. Entre novamente para gerenciar passkeys.";
            }
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Failed to load account passkeys.");
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RegisterPasskeyAsync()
    {
        _error = null;
        _success = null;
        _busy = true;

        try
        {
            var result = await JS.InvokeAsync<AccountPasskeyResult>(
                "passkeys.register",
                _registrationForm,
                _passkeyName ?? string.Empty);

            if (result.State is not null)
            {
                _overview = result.State;
            }

            if (result.Succeeded)
            {
                _passkeyName = null;
                _success = "Passkey registrada com sucesso.";
            }
            else
            {
                _error = DescribeErrors(result.Errors, "Não foi possível registrar a passkey.");
            }
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Passkey registration interaction failed.");
            _error = "Não foi possível concluir o registro. Recarregue a página e tente novamente.";
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartRenaming(AccountPasskeyCredential passkey)
    {
        _error = null;
        _success = null;
        _editingCredentialId = passkey.CredentialId;
        _editingPasskeyName = passkey.Name ?? string.Empty;
        _focusRenameInput = true;
    }

    private void CancelRenaming()
    {
        _editingCredentialId = null;
        _editingPasskeyName = null;
        _focusRenameInput = false;
    }

    private async Task HandleRenameKeyDownAsync(
        KeyboardEventArgs args,
        string credentialId)
    {
        if (args.Key == "Enter")
        {
            await SavePasskeyNameAsync(credentialId);
        }
        else if (args.Key == "Escape")
        {
            CancelRenaming();
        }
    }

    private async Task SavePasskeyNameAsync(string credentialId)
    {
        if (_editingCredentialId != credentialId)
        {
            return;
        }

        _error = null;
        _success = null;
        _busy = true;

        try
        {
            var principal = await _authTask.GetAuthenticatedPrincipalAsync();
            if (principal is null)
            {
                _error = "Sua sessão expirou. Entre novamente para gerenciar passkeys.";
                return;
            }

            var nameWasRemoved = string.IsNullOrWhiteSpace(_editingPasskeyName);
            var result = await PasskeyService.RenameAsync(
                principal,
                new AccountPasskeyRename(credentialId, _editingPasskeyName));
            if (result.State is not null)
            {
                _overview = result.State;
            }

            if (result.Succeeded)
            {
                CancelRenaming();
                _success = nameWasRemoved
                    ? "Nome da passkey removido."
                    : "Nome da passkey atualizado.";
            }
            else
            {
                _error = DescribeErrors(result.Errors, "Não foi possível atualizar o nome da passkey.");
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to rename account passkey {CredentialId}.", credentialId);
            _error = "Não foi possível atualizar o nome da passkey. Tente novamente.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemovePasskeyAsync(string credentialId)
    {
        _error = null;
        _success = null;
        _busy = true;

        try
        {
            var confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                "Remover esta passkey? Ela deixará de funcionar para entrar nesta conta.");
            if (!confirmed)
            {
                return;
            }

            var principal = await _authTask.GetAuthenticatedPrincipalAsync();
            if (principal is null)
            {
                _error = "Sua sessão expirou. Entre novamente para gerenciar passkeys.";
                return;
            }

            var result = await PasskeyService.RemoveAsync(principal, credentialId);
            if (result.State is not null)
            {
                _overview = result.State;
            }

            if (result.Succeeded)
            {
                _success = "Passkey removida.";
            }
            else
            {
                _error = DescribeErrors(result.Errors, "Não foi possível remover a passkey.");
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to remove account passkey {CredentialId}.", credentialId);
            _error = "Não foi possível remover a passkey. Tente novamente.";
        }
        finally
        {
            _busy = false;
        }
    }

    private static string DescribeErrors(
        IReadOnlyList<AccountSelfServiceError> errors,
        string fallback) =>
        errors.Count == 0
            ? fallback
            : string.Join(" ", errors.Select(error => error.Description));
}
