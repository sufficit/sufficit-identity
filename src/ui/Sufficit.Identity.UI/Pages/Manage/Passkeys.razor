@page "/manage/passkeys"
@attribute [Authorize]
@rendermode @(RenderMode.InteractiveServer)
@using System.Globalization
@using Sufficit.Identity.UI.Services
@inject IAccountPasskeyService PasskeyService
@inject IJSRuntime JS
@inject ILogger<Passkeys> Logger
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ManagePasskeys.Title"]</PageTitle>

<div class="auth-card">
    <ManageBackLink />
    <h1>@L["ManagePasskeys.Title"]</h1>
    <p class="info">@L["ManagePasskeys.Description"]</p>

    @if (_error is not null)
    {
        <SUIAlert ToneValue="SUITone.Danger" aria-live="assertive">@_error</SUIAlert>
    }
    @if (_success is not null)
    {
        <SUIAlert ToneValue="SUITone.Success" aria-live="polite">@_success</SUIAlert>
    }

    <h3>@L["ManagePasskeys.YourPasskeys"]</h3>
    @if (_loading)
    {
        <p class="muted" role="status">@L["ManagePasskeys.Loading"]</p>
    }
    else if (_loadFailed)
    {
        <SUIAlert ToneValue="SUITone.Danger">
            @L["ManagePasskeys.LoadError"]
            <SUILoadingButton SizeValue="SUISize.Small"
                              VariantValue="SUIVariant.Outlined"
                              ColorValue="SUIColor.Default"
                              OnClick="LoadPasskeysAsync">
                @L["Common.TryAgain"]
            </SUILoadingButton>
        </SUIAlert>
    }
    else if (_overview?.Credentials.Count > 0)
    {
        <ul class="passkey-list">
            @foreach (var passkey in _overview.Credentials)
            {
                <li class="passkey-item">
                    @if (_editingCredentialId == passkey.CredentialId)
                    {
                        <div class="passkey-inline-editor">
                            <SUITextField T="string" @ref="_renameField"
                                          Id="passkey-edit-name"
                                          Label="@L["ManagePasskeys.Name"]"
                                          HelperText="@L["ManagePasskeys.RenameHint"]"
                                          MaxLength="@_overview.MaximumNameLength"
                                          @bind-Value="_editingPasskeyName"
                                          Immediate
                                          Disabled="@_busy"
                                          @onkeydown="@(args => HandleRenameKeyDownAsync(args, passkey.CredentialId))"
                                          autocomplete="off" />
                            <div class="passkey-inline-actions">
                                <SUILoadingButton SizeValue="SUISize.Small" Disabled="@_busy"
                                                  OnClick="@(async () => await SavePasskeyNameAsync(passkey.CredentialId))">
                                    @(_busy ? L["ManagePasskeys.Saving"] : L["ManagePasskeys.SaveName"])
                                </SUILoadingButton>
                                <SUILoadingButton SizeValue="SUISize.Small"
                                                  VariantValue="SUIVariant.Outlined"
                                                  ColorValue="SUIColor.Default"
                                                  Disabled="@_busy"
                                                  OnClick="CancelRenaming">
                                    @L["Common.Cancel"]
                                </SUILoadingButton>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="passkey-item-info">
                            <span class="passkey-name">@(passkey.Name ?? L["ManagePasskeys.Unnamed"])</span>
                            <span class="passkey-meta">@L["ManagePasskeys.CreatedAt", passkey.CreatedAt.LocalDateTime.ToString("g", CultureInfo.CurrentCulture)]</span>
                            @if (passkey.IsBackedUp)
                            {
                                <SUIChip SizeValue="SUISize.Small" ColorValue="SUIColor.Success">
                                    @L["ManagePasskeys.Synced"]
                                </SUIChip>
                            }
                        </div>
                        <div class="passkey-item-actions">
                            <SUILoadingButton SizeValue="SUISize.Small"
                                              VariantValue="SUIVariant.Outlined"
                                              ColorValue="SUIColor.Default"
                                              Disabled="@_busy"
                                              aria-label="@L["ManagePasskeys.RenameAria", passkey.Name ?? L["ManagePasskeys.Unnamed"]]"
                                              OnClick="@(() => StartRenaming(passkey))">
                                @L["ManagePasskeys.Rename"]
                            </SUILoadingButton>
                            <SUILoadingButton SizeValue="SUISize.Small"
                                              ColorValue="SUIColor.Error"
                                              Disabled="@_busy"
                                              aria-label="@L["ManagePasskeys.RemoveAria", passkey.Name ?? L["ManagePasskeys.Unnamed"]]"
                                              OnClick="@(async () => await RemovePasskeyAsync(passkey.CredentialId))">
                                @L["ManagePasskeys.Remove"]
                            </SUILoadingButton>
                        </div>
                    }
                </li>
            }
        </ul>
    }
    else
    {
        <p class="muted">@L["ManagePasskeys.None"]</p>
    }

    @if (!_loading && !_loadFailed && _overview is not null)
    {
        <hr />
        <h3>@L["ManagePasskeys.Add"]</h3>

        @if (!_supported)
        {
            <SUIAlert ToneValue="SUITone.Info">@L["ManagePasskeys.Unsupported"]</SUIAlert>
        }
        else if (!_overview.CanRegister)
        {
            <SUIAlert ToneValue="SUITone.Info">
                @L["ManagePasskeys.LimitReached", _overview.MaximumCredentials]
            </SUIAlert>
        }
        else
        {
            <form @ref="_registrationForm">
                <AntiforgeryToken />
                <SUITextField T="string" Id="passkey-name"
                              Label="@L["ManagePasskeys.NameOptional"]"
                              Placeholder="@L["ManagePasskeys.NamePlaceholder"]"
                              HelperText="@L["ManagePasskeys.DeviceNameHint"]"
                              MaxLength="@_overview.MaximumNameLength"
                              @bind-Value="_passkeyName"
                              Disabled="@_busy"
                              name="name" autocomplete="off" />
                @* aria-busy, not IsLoading: the authenticator dialog is the wait,
                   and the label says which one. *@
                <SUILoadingButton Disabled="@_busy"
                                  aria-busy="@(_busy ? "true" : "false")"
                                  OnClick="RegisterPasskeyAsync">
                    @(_busy ? L["ManagePasskeys.WaitingDevice"] : L["ManagePasskeys.Register"])
                </SUILoadingButton>
            </form>
        }
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? _authTask { get; set; }

    private ElementReference _registrationForm;
    private SUITextField<string>? _renameField;
    private AccountPasskeyOverview? _overview;
    private string? _passkeyName;
    private string? _editingCredentialId;
    private string? _editingPasskeyName;
    private string? _error;
    private string? _success;
    private bool _loading = true;
    private bool _loadFailed;
    private bool _busy;
    private bool _supported = true;
    private bool _focusRenameInput;

    protected override Task OnInitializedAsync() => LoadPasskeysAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _supported = await JS.InvokeAsync<bool>("passkeys.isSupported");
                StateHasChanged();
            }
            catch (JSException exception)
            {
                Logger.LogDebug(exception, "Passkey capability detection was unavailable.");
            }
        }

        if (_focusRenameInput)
        {
            _focusRenameInput = false;
            try
            {
                if (_renameField is not null)
        {
            await _renameField.FocusAsync();
        }
            }
            catch (JSException exception)
            {
                Logger.LogDebug(exception, "Passkey rename input could not receive focus.");
            }
        }
    }

    private async Task LoadPasskeysAsync()
    {
        _loading = true;
        _loadFailed = false;

        try
        {
            var principal = await _authTask.GetAuthenticatedPrincipalAsync();
            if (principal is null)
            {
                _error = L["ManagePasskeys.SessionExpired"];
                _overview = null;
                return;
            }

            _overview = await PasskeyService.GetOverviewAsync(principal);
            if (_overview is null)
            {
                _error = L["ManagePasskeys.SessionExpired"];
            }
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Failed to load account passkeys.");
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RegisterPasskeyAsync()
    {
        _error = null;
        _success = null;
        _busy = true;

        try
        {
            var result = await JS.InvokeAsync<AccountPasskeyResult>(
                "passkeys.register",
                _registrationForm,
                _passkeyName ?? string.Empty);

            if (result.State is not null)
            {
                _overview = result.State;
            }

            if (result.Succeeded)
            {
                _passkeyName = null;
                _success = L["ManagePasskeys.RegisterSuccess"];
            }
            else
            {
                _error = DescribeErrors(
                    result.Errors,
                    L["ManagePasskeys.RegisterFailed"]);
            }
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Passkey registration interaction failed.");
            _error = L["ManagePasskeys.RegisterInteractionFailed"];
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartRenaming(AccountPasskeyCredential passkey)
    {
        _error = null;
        _success = null;
        _editingCredentialId = passkey.CredentialId;
        _editingPasskeyName = passkey.Name ?? string.Empty;
        _focusRenameInput = true;
    }

    private void CancelRenaming()
    {
        _editingCredentialId = null;
        _editingPasskeyName = null;
        _focusRenameInput = false;
    }

    private async Task HandleRenameKeyDownAsync(
        KeyboardEventArgs args,
        string credentialId)
    {
        if (args.Key == "Enter")
        {
            await SavePasskeyNameAsync(credentialId);
        }
        else if (args.Key == "Escape")
        {
            CancelRenaming();
        }
    }

    private async Task SavePasskeyNameAsync(string credentialId)
    {
        if (_editingCredentialId != credentialId)
        {
            return;
        }

        _error = null;
        _success = null;
        _busy = true;

        try
        {
            var principal = await _authTask.GetAuthenticatedPrincipalAsync();
            if (principal is null)
            {
                _error = L["ManagePasskeys.SessionExpired"];
                return;
            }

            var nameWasRemoved = string.IsNullOrWhiteSpace(_editingPasskeyName);
            var result = await PasskeyService.RenameAsync(
                principal,
                new AccountPasskeyRename(credentialId, _editingPasskeyName));
            if (result.State is not null)
            {
                _overview = result.State;
            }

            if (result.Succeeded)
            {
                CancelRenaming();
                _success = nameWasRemoved
                    ? L["ManagePasskeys.NameRemovedSuccess"]
                    : L["ManagePasskeys.NameUpdatedSuccess"];
            }
            else
            {
                _error = DescribeErrors(
                    result.Errors,
                    L["ManagePasskeys.RenameFailed"]);
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to rename account passkey {CredentialId}.", credentialId);
            _error = L["ManagePasskeys.RenameRetryFailed"];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemovePasskeyAsync(string credentialId)
    {
        _error = null;
        _success = null;
        _busy = true;

        try
        {
            var confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                L["ManagePasskeys.RemoveConfirm"]);
            if (!confirmed)
            {
                return;
            }

            var principal = await _authTask.GetAuthenticatedPrincipalAsync();
            if (principal is null)
            {
                _error = L["ManagePasskeys.SessionExpired"];
                return;
            }

            var result = await PasskeyService.RemoveAsync(principal, credentialId);
            if (result.State is not null)
            {
                _overview = result.State;
            }

            if (result.Succeeded)
            {
                _success = L["ManagePasskeys.RemoveSuccess"];
            }
            else
            {
                _error = DescribeErrors(
                    result.Errors,
                    L["ManagePasskeys.RemoveFailed"]);
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to remove account passkey {CredentialId}.", credentialId);
            _error = L["ManagePasskeys.RemoveRetryFailed"];
        }
        finally
        {
            _busy = false;
        }
    }

    private string DescribeErrors(
        IReadOnlyList<AccountSelfServiceError> errors,
        string fallback)
    {
        if (errors.Count == 0)
        {
            return fallback;
        }

        var localized = errors
            .Select(error => LocalizeError(error.Code))
            .Where(message => message is not null)
            .Select(message => message!)
            .ToArray();
        return localized.Length == 0
            ? fallback
            : string.Join(" ", localized);
    }

    private string? LocalizeError(string code) =>
        (code switch
        {
            "unauthenticated" => L["ManagePasskeys.Error.Unauthenticated"],
            "step-up-required" => L["ManagePasskeys.Error.StepUpRequired"],
            "passkey-limit-reached" => L[
                "ManagePasskeys.LimitReached",
                _overview?.MaximumCredentials ?? 0],
            "passkey-credential-required" => L["ManagePasskeys.Error.CredentialRequired"],
            "passkey-credential-too-large" => L["ManagePasskeys.Error.CredentialTooLarge"],
            "passkey-name-too-long" => L[
                "ManagePasskeys.Error.NameTooLong",
                _overview?.MaximumNameLength ?? 0],
            "passkey-ceremony-invalid" => L["ManagePasskeys.Error.CeremonyInvalid"],
            "passkey-attestation-failed" => L["ManagePasskeys.Error.AttestationFailed"],
            "passkey-not-found" => L["ManagePasskeys.Error.NotFound"],
            _ => null,
        })?.Value;
}
