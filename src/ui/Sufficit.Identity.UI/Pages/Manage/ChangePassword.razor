@page "/manage/changepassword"
@attribute [Authorize]
@inject IAccountSelfService AccountSelfService
@inject IAccountPasswordPolicyProvider PasswordPolicyProvider
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ChangePassword.Title"]</PageTitle>

<div class="auth-card">
    <ManageBackLink />
    <h1>@L["ChangePassword.Title"]</h1>

    @if (_success)
    {
        <SUIAlert ToneValue="SUITone.Success">@L["ChangePassword.Success"]</SUIAlert>
    }
    @if (_errors.Count > 0)
    {
        <SUIAlert ToneValue="SUITone.Danger">
            @foreach (var error in _errors) { <div>@error</div> }
        </SUIAlert>
    }

    <EditForm id="change-password-form" Model="_model" Method="post" OnValidSubmit="ChangeAsync" FormName="change-password">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-summary" role="alert" aria-live="polite" />

        <SUITextField T="string" Id="current-password" Name="_model.OldPassword"
                      Label="@L["ChangePassword.Current"]"
                      @bind-Value="_model.OldPassword"
                      InputType="password"
                      autocomplete="current-password" autofocus />
        <SUITextField T="string" Id="new-password" Name="_model.NewPassword"
                      Label="@L["ChangePassword.New"]"
                      @bind-Value="_model.NewPassword"
                      AriaDescribedBy="password-requirements"
                      InputType="password"
                      autocomplete="new-password" />
        <PasswordRequirements Policy="_passwordPolicy" />
        <SUITextField T="string" Id="confirm-password" Name="_model.ConfirmPassword"
                      Label="@L["ChangePassword.Confirm"]"
                      @bind-Value="_model.ConfirmPassword"
                      InputType="password"
                      autocomplete="new-password" />

        <SUILoadingButton ButtonTypeValue="SUIButtonType.Submit" FullWidth>
            @L["ChangePassword.Submit"]
        </SUILoadingButton>
    </EditForm>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? _authTask { get; set; }

    private PasswordInput? _boundModel;
    [SupplyParameterFromForm(FormName = "change-password")]
    private PasswordInput _model
    {
        get => _boundModel ??= new();
        set => _boundModel = value;
    }
    private bool _success;
    private IReadOnlyList<string> _errors = [];
    private AccountPasswordPolicy _passwordPolicy = default!;

    protected override void OnInitialized() =>
        _passwordPolicy = PasswordPolicyProvider.GetPolicy();

    private async Task ChangeAsync()
    {
        var principal = await _authTask.GetAuthenticatedPrincipalAsync();
        if (principal is null)
        {
            _errors = [L["ChangePassword.SessionExpired"]];
            return;
        }

        var result = await AccountSelfService.ChangePasswordAsync(
            principal,
            new AccountPasswordChange(
                _model.OldPassword,
                _model.NewPassword,
                _model.ConfirmPassword));
        if (result.Succeeded)
        {
            _success = true;
            _errors = [];
            _model = new();
        }
        else
        {
            _success = false;
            _errors = result.Errors.Select(error =>
                PasswordMessages.ForError(error.Code, _passwordPolicy, L)
                ?? L["PasswordError.Unknown"].Value).Distinct().ToArray();
        }
    }

    private sealed class PasswordInput
    {
        [Required(ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.CurrentPasswordRequired))]
        public string OldPassword { get; set; } = string.Empty;
        [Required(ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.PasswordRequired))]
        public string NewPassword { get; set; } = string.Empty;
        [Required(ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.ConfirmPasswordRequired))]
        [Compare(nameof(NewPassword), ErrorMessageResourceType = typeof(ValidationMessages),
            ErrorMessageResourceName = nameof(ValidationMessages.PasswordMismatch))]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
