@page "/manage/twofactor"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Authorize]
@inject IAccountTwoFactorService TwoFactorService
@inject IJSRuntime JS
@inject ILogger<TwoFactor> Logger
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ManageTwoFactor.Title"]</PageTitle>

<div class="auth-card">
    <ManageBackLink />
    <h1>@L["ManageTwoFactor.Title"]</h1>
    <p class="info">@L["ManageTwoFactor.Description"]</p>

    <div aria-live="polite">
        @if (_error is not null)
        {
            <div class="alert alert-error" role="alert">@_error</div>
        }
        else if (_success is not null)
        {
            <div class="alert alert-success" role="status">@_success</div>
        }
    </div>

    @if (_loading)
    {
        <p class="muted">@L["ManageTwoFactor.Loading"]</p>
    }
    else if (_loadFailed)
    {
        <button type="button" class="btn btn-secondary" @onclick="LoadAsync">
            @L["ManageTwoFactor.Retry"]
        </button>
    }
    else if (_overview?.IsEnabled == true)
    {
        <div class="alert alert-success">
            @L["ManageTwoFactor.Enabled"]
        </div>

        @if (_recoveryCodes.Count > 0)
        {
            <div class="alert alert-warning" role="alert">
                @L["ManageTwoFactor.RecoveryCodesWarning"]
            </div>
            <div class="recovery-codes" aria-label="@L["ManageTwoFactor.RecoveryCodes"]">
                @foreach (var recoveryCode in _recoveryCodes)
                {
                    <code class="recovery-code">@recoveryCode</code>
                }
            </div>
            <p class="muted">@L["ManageTwoFactor.EachCodeOnce"]</p>
            <div class="btn-group">
                <button type="button"
                        class="btn btn-secondary"
                        disabled="@_busy"
                        @onclick="CopyRecoveryCodesAsync">
                    @L["ManageTwoFactor.CopyRecoveryCodes"]
                </button>
                <button type="button"
                        class="btn btn-primary"
                        disabled="@_busy"
                        @onclick="DismissRecoveryCodes">
                    @L["ManageTwoFactor.RecoveryCodesSaved"]
                </button>
            </div>
        }
        else
        {
            <p class="muted">@RecoveryCodeSummary</p>
            <div class="btn-group two-factor-actions">
                <button type="button"
                        class="btn btn-secondary"
                        disabled="@_busy"
                        @onclick="ResetAuthenticatorAsync">
                    @L["ManageTwoFactor.ResetAuthenticator"]
                </button>
                <button type="button"
                        class="btn btn-secondary"
                        disabled="@_busy"
                        @onclick="GenerateRecoveryCodesAsync">
                    @L["ManageTwoFactor.GenerateRecoveryCodes"]
                </button>
                <button type="button"
                        class="btn btn-danger"
                        disabled="@_busy"
                        @onclick="DisableAsync">
                    @L["ManageTwoFactor.Disable"]
                </button>
            </div>
        }
    }
    else if (_overview?.AuthenticatorSetup is { } setup)
    {
        <p class="info">
            @L["ManageTwoFactor.SetupInstructions"]
        </p>
        <div class="qr-container">
            <img src="@_qrCode"
                 alt="@(L["ManageTwoFactor.QrAlt"])" />
        </div>
        <p class="muted">@L["ManageTwoFactor.ManualKeyHint"]</p>
        <code class="manual-key">@setup.ManualKey</code>

        <EditForm Model="Verify" Method="post" OnSubmit="EnableAsync" FormName="verify-2fa">
            <div class="form-group">
                <label for="code">@L["ManageTwoFactor.VerificationCode"]</label>
                <InputText id="code"
                           @bind-Value="Verify.Code"
                           class="form-control"
                           inputmode="numeric"
                           maxlength="16"
                           placeholder="123456"
                           autocomplete="one-time-code"
                           required
                           autofocus />
            </div>
            <button type="submit"
                    class="btn btn-primary btn-block"
                    disabled="@_busy">
                @(_busy ? L["ManageTwoFactor.Confirming"] : L["ManageTwoFactor.Enable"])
            </button>
        </EditForm>
    }
    else
    {
        <button type="button"
                class="btn btn-primary btn-block"
                disabled="@_busy"
                @onclick="BeginSetupAsync">
            @(_busy ? L["ManageTwoFactor.Preparing"] : L["ManageTwoFactor.ConfigureAuthenticator"])
        </button>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? _authTask { get; set; }

    private AccountTwoFactorOverview? _overview;
    private IReadOnlyList<string> _recoveryCodes = [];
    private bool _loading = true;
    private bool _loadFailed;
    private bool _busy;
    private string? _qrCode;
    private string? _error;
    private string? _success;

    private VerifyInput? _boundVerify;
    [SupplyParameterFromForm(FormName = "verify-2fa")]
    private VerifyInput Verify
    {
        get => _boundVerify ??= new();
        set => _boundVerify = value;
    }

    private string RecoveryCodeSummary
    {
        get
        {
            var count = _overview?.RecoveryCodesRemaining ?? 0;
            return count switch
            {
                0 => L["ManageTwoFactor.RecoveryCodesNone"],
                1 => L["ManageTwoFactor.RecoveryCodesOne"],
                _ => L["ManageTwoFactor.RecoveryCodesMany", count],
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadFailed = false;
        _error = null;
        _success = null;
        try
        {
            var principal = await _authTask.GetAuthenticatedPrincipalAsync();
            if (principal is null)
            {
                _error = L["ChangePassword.SessionExpired"];
                _loadFailed = true;
                return;
            }

            var overview = await TwoFactorService.GetOverviewAsync(principal);
            if (overview is null)
            {
                _error = L["ChangePassword.SessionExpired"];
                _loadFailed = true;
                return;
            }

            ApplyState(overview);
            _error = null;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Two-factor settings could not be loaded.");
            _error = L["ManageTwoFactor.LoadError"];
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task BeginSetupAsync() =>
        await ExecuteAsync(
            principal => TwoFactorService.BeginSetupAsync(principal),
            L["ManageTwoFactor.BeginSetupSuccess"]);

    private async Task EnableAsync()
    {
        if (string.IsNullOrWhiteSpace(Verify.Code))
        {
            _success = null;
            _error = L["ManageTwoFactor.VerificationCodeRequired"];
            return;
        }

        await ExecuteAsync(
            principal => TwoFactorService.EnableAsync(principal, Verify.Code),
            L["ManageTwoFactor.EnableSuccess"]);
        if (_error is null)
        {
            Verify.Code = string.Empty;
        }
    }

    private async Task GenerateRecoveryCodesAsync()
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            L["ManageTwoFactor.GenerateRecoveryCodesConfirm"].Value);
        if (confirmed)
        {
            await ExecuteAsync(
                principal => TwoFactorService.GenerateRecoveryCodesAsync(principal),
                L["ManageTwoFactor.GenerateRecoveryCodesSuccess"]);
        }
    }

    private async Task ResetAuthenticatorAsync()
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            L["ManageTwoFactor.ResetAuthenticatorConfirm"].Value);
        if (confirmed)
        {
            await ExecuteAsync(
                principal => TwoFactorService.ResetAuthenticatorAsync(principal),
                L["ManageTwoFactor.ResetAuthenticatorSuccess"]);
        }
    }

    private async Task DisableAsync()
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            L["ManageTwoFactor.DisableConfirm"].Value);
        if (confirmed)
        {
            await ExecuteAsync(
                principal => TwoFactorService.DisableAsync(principal),
                L["ManageTwoFactor.DisableSuccess"]);
        }
    }

    private async Task ExecuteAsync(
        Func<System.Security.Claims.ClaimsPrincipal, Task<AccountTwoFactorResult>> operation,
        LocalizedString successMessage)
    {
        // A browser retry can queue a second Blazor event while the first one
        // is still in flight. The service also reports an already-enabled
        // state, so keep this screen deterministic in both cases.
        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;
        _success = null;
        try
        {
            var principal = await _authTask.GetAuthenticatedPrincipalAsync();
            if (principal is null)
            {
                _error = L["ChangePassword.SessionExpired"];
                return;
            }

            var result = await operation(principal);
            if (result.State is not null)
            {
                ApplyState(result.State);
            }
            if (!result.Succeeded)
            {
                if (IsAlreadyEnabled(result))
                {
                    _error = null;
                    _recoveryCodes = result.RecoveryCodes;
                    _success = L["ManageTwoFactor.AlreadyEnabled"];
                    return;
                }

                _error = LocalizeErrors(result.Errors);
                return;
            }

            _error = null;
            _recoveryCodes = result.RecoveryCodes;
            _success = successMessage.Value;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Two-factor account operation failed.");
            _success = null;
            _error = L["ManageTwoFactor.OperationError"];
        }
        finally
        {
            _busy = false;
        }
    }

    private void ApplyState(AccountTwoFactorOverview state)
    {
        _overview = state;
        _qrCode = state.AuthenticatorSetup is null
            ? null
            : BuildQrCode(state.AuthenticatorSetup.AuthenticatorUri);
    }

    private static bool IsAlreadyEnabled(AccountTwoFactorResult result) =>
        result.State?.IsEnabled == true
        && result.Errors.Any(error => error.Code == "two-factor-already-enabled");

    private string LocalizeErrors(IReadOnlyList<AccountSelfServiceError> errors)
    {
        var localized = errors
            .Select(error => error.Code switch
            {
                "unauthenticated" => L["ManageTwoFactor.Error.Unauthenticated"].Value,
                "step-up-required" => L["ManageTwoFactor.Error.StepUpRequired"].Value,
                "two-factor-already-enabled" => L["ManageTwoFactor.Error.AlreadyEnabled"].Value,
                "two-factor-not-enabled" => L["ManageTwoFactor.Error.NotEnabled"].Value,
                "authenticator-key-unavailable" => L["ManageTwoFactor.Error.KeyUnavailable"].Value,
                "authenticator-code-invalid" => L["ManageTwoFactor.Error.InvalidCode"].Value,
                "authenticator-setup-required" => L["ManageTwoFactor.Error.SetupRequired"].Value,
                "recovery-codes-generation-failed" => L["ManageTwoFactor.Error.RecoveryCodes"].Value,
                _ => L["ManageTwoFactor.OperationError"].Value,
            })
            .Distinct(StringComparer.Ordinal)
            .ToArray();

        return localized.Length == 0
            ? L["ManageTwoFactor.OperationError"]
            : string.Join(" ", localized);
    }

    private async Task CopyRecoveryCodesAsync()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "navigator.clipboard.writeText",
                string.Join(Environment.NewLine, _recoveryCodes));
            _error = null;
            _success = L["ManageTwoFactor.CopySuccess"];
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Recovery codes could not be copied.");
            _success = null;
            _error = L["ManageTwoFactor.CopyError"];
        }
    }

    private void DismissRecoveryCodes()
    {
        _recoveryCodes = [];
        _error = null;
        _success = L["ManageTwoFactor.RecoveryCodesConfirmed"];
    }

    private static string BuildQrCode(string authenticatorUri)
    {
        using var qrGenerator = new QRCoder.QRCodeGenerator();
        using var qrData = qrGenerator.CreateQrCode(
            authenticatorUri,
            QRCoder.QRCodeGenerator.ECCLevel.Q);
        var pngQrCode = new QRCoder.PngByteQRCode(qrData);
        var pngBytes = pngQrCode.GetGraphic(20);
        return $"data:image/png;base64,{Convert.ToBase64String(pngBytes)}";
    }

    private sealed class VerifyInput
    {
        public string Code { get; set; } = string.Empty;
    }
}
