@page "/manage/externallogins"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Authorize]
@inject IAccountExternalIdentityService ExternalIdentityService
@inject IJSRuntime JS
@inject ILogger<ExternalLogins> Logger
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ExternalLogins.Title"]</PageTitle>

<div class="auth-card">
    <ManageBackLink />
    <h1>@L["ExternalLogins.Title"]</h1>
    <p class="info">@L["ExternalLogins.Description"]</p>

    <div aria-live="polite">
        @if (_error is not null)
        {
            <div class="alert alert-error" role="alert">@_error</div>
        }
        @if (_success is not null)
        {
            <div class="alert alert-success" role="status">@_success</div>
        }
    </div>

    @if (_loading)
    {
        <p class="muted">Carregando identidades externas…</p>
    }
    else if (_loadFailed)
    {
        <button type="button" class="btn btn-secondary" @onclick="LoadAsync">
            Tentar novamente
        </button>
    }
    else
    {
        <section class="external-section" aria-labelledby="linked-identities-title">
            <h3 id="linked-identities-title">@L["ExternalLogins.Linked"]</h3>
            @if (_overview.LinkedIdentities.Count > 0)
            {
                <ul class="external-list">
                    @foreach (var identity in _overview.LinkedIdentities)
                    {
                        <li>
                            <span class="external-item-info">
                                <span class="external-item-name">@identity.DisplayName</span>
                                @if (!identity.CanRemove)
                                {
                                    <span class="external-item-reason">
                                        @identity.RemovalBlockedReason
                                    </span>
                                }
                            </span>
                            @if (identity.CanRemove)
                            {
                                <button type="button"
                                        class="btn btn-danger btn-sm"
                                        disabled="@IsBusy"
                                        @onclick="() => RemoveAsync(identity)">
                                    @(_busyIdentity == IdentityKey(identity)
                                        ? "Removendo…"
                                        : "Remover")
                                </button>
                            }
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="muted">@L["ExternalLogins.None"]</p>
            }
        </section>

        @if (_overview.AvailableProviders.Count > 0)
        {
            <section class="external-section" aria-labelledby="available-identities-title">
                <h3 id="available-identities-title">@L["ExternalLogins.Available"]</h3>
                <div class="external-providers">
                    @foreach (var provider in _overview.AvailableProviders)
                    {
                        <a href="@BuildChallengeUrl(provider)"
                           class="btn btn-block @ProviderClass(provider.AuthenticationScheme)"
                           data-enhance-nav="false"
                           data-redirect-overlay="@provider.DisplayName">
                            Vincular @provider.DisplayName
                        </a>
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? _authTask { get; set; }
    [SupplyParameterFromQuery(Name = "status")] private string? Status { get; set; }
    [SupplyParameterFromQuery(Name = "provider")] private string? Provider { get; set; }
    [SupplyParameterFromQuery(Name = "error")] private string? CallbackError { get; set; }

    private AccountExternalIdentityOverview _overview = new([], []);
    private bool _loading = true;
    private bool _loadFailed;
    private string? _busyIdentity;
    private string? _error;
    private string? _success;
    private bool IsBusy => _busyIdentity is not null;

    protected override async Task OnInitializedAsync()
    {
        ApplyCallbackStatus();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadFailed = false;
        if (CallbackError is null)
        {
            _error = null;
        }

        try
        {
            var principal = await _authTask.GetAuthenticatedPrincipalAsync();
            if (principal is null)
            {
                _error = L["ChangePassword.SessionExpired"];
                _loadFailed = true;
                return;
            }

            var overview = await ExternalIdentityService.GetOverviewAsync(principal);
            if (overview is null)
            {
                _error = L["ChangePassword.SessionExpired"];
                _loadFailed = true;
                return;
            }

            _overview = overview;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "External identities could not be loaded.");
            _error = "Não foi possível carregar as identidades externas.";
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RemoveAsync(AccountExternalIdentity identity)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Remover {identity.DisplayName} das formas de entrada da sua conta?");
        if (!confirmed)
        {
            return;
        }

        _busyIdentity = IdentityKey(identity);
        _error = null;
        _success = null;
        try
        {
            var principal = await _authTask.GetAuthenticatedPrincipalAsync();
            if (principal is null)
            {
                _error = L["ChangePassword.SessionExpired"];
                return;
            }

            var result = await ExternalIdentityService.RemoveAsync(
                principal,
                identity.LoginProvider,
                identity.ProviderKey);
            if (!result.Succeeded)
            {
                _error = string.Join(
                    " ",
                    result.Errors.Select(error => error.Description));
                return;
            }

            _success = $"{identity.DisplayName} foi removido das suas formas de entrada.";
            var overview = await ExternalIdentityService.GetOverviewAsync(principal);
            if (overview is not null)
            {
                _overview = overview;
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "External identity provider {Provider} could not be removed.",
                identity.LoginProvider);
            _error = "Não foi possível remover a identidade externa. Tente novamente.";
        }
        finally
        {
            _busyIdentity = null;
        }
    }

    private void ApplyCallbackStatus()
    {
        if (string.Equals(Status, "linked", StringComparison.Ordinal))
        {
            _success = string.IsNullOrWhiteSpace(Provider)
                ? "A identidade externa foi vinculada."
                : $"{Provider} foi vinculado à sua conta.";
        }

        _error = CallbackError switch
        {
            "external-identity-in-use" =>
                "Esta identidade externa já está vinculada a outra conta.",
            "external-provider-unavailable" =>
                "O provedor externo não está mais disponível.",
            "external-identity-invalid" =>
                "O provedor retornou uma identidade inválida. Tente novamente.",
            null => _error,
            _ => "Não foi possível vincular a identidade externa. Tente novamente.",
        };
    }

    private static string BuildChallengeUrl(AccountExternalProvider provider) =>
        "/account/externalchallenge"
        + $"?provider={Uri.EscapeDataString(provider.AuthenticationScheme)}"
        + $"&returnUrl={Uri.EscapeDataString("/manage/externallogins")}";

    private static string ProviderClass(string provider) =>
        provider.ToLowerInvariant() switch
        {
            "google" => "btn-google",
            "facebook" => "btn-facebook",
            _ => "btn-secondary",
        };

    private static string IdentityKey(AccountExternalIdentity identity) =>
        $"{identity.LoginProvider}\u001f{identity.ProviderKey}";
}
