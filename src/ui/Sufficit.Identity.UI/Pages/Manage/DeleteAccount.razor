@page "/manage/deleteaccount"
@attribute [Authorize]
@inject IAccountSelfService AccountSelfService
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["DeleteAccount.Title"]</PageTitle>

<div class="auth-card">
    <ManageBackLink />
    <h1>@L["DeleteAccount.Title"]</h1>

    <SUIAlert ToneValue="SUITone.Danger">
        <strong>@L["DeleteAccount.Warning"]</strong>
        @L["DeleteAccount.DataWarning"]
    </SUIAlert>

    @if (_deleted)
    {
        <SUIAlert ToneValue="SUITone.Success">@L["DeleteAccount.Success"]</SUIAlert>
        <SUIButton Href="/">@L["Common.BackHome"]</SUIButton>
    }
    else
    {
        @if (_error is not null)
        {
            <SUIAlert ToneValue="SUITone.Danger">@_error</SUIAlert>
        }

        <p class="info">@L["DeleteAccount.ConfirmEmail"]</p>

        <EditForm Model="_model" Method="post" OnValidSubmit="DeleteAsync" FormName="delete-account">
            <DataAnnotationsValidator />

            <SUITextField T="string" Id="email"
                          Label="@L["DeleteAccount.Email"]"
                          @bind-Value="_model.Email"
                          InputType="email"
                          autocomplete="email" autofocus />

            <SUITextField T="string" Id="password"
                          Label="@L["DeleteAccount.CurrentPassword"]"
                          @bind-Value="_model.Password"
                          InputType="password"
                          autocomplete="current-password" />

            <SUILoadingButton ButtonTypeValue="SUIButtonType.Submit" ColorValue="SUIColor.Error">
                @L["DeleteAccount.Submit"]
            </SUILoadingButton>
            <SUIButton Href="/manage/personaldata"
                       VariantValue="SUIVariant.Outlined"
                       ColorValue="SUIColor.Default">
                @L["Common.Cancel"]
            </SUIButton>
        </EditForm>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? _authTask { get; set; }

    private DeleteInput? _boundModel;
    [SupplyParameterFromForm(FormName = "delete-account")]
    private DeleteInput _model
    {
        get => _boundModel ??= new();
        set => _boundModel = value;
    }
    private string? _error;
    private bool _deleted;

    private async Task DeleteAsync()
    {
        var principal = await _authTask.GetAuthenticatedPrincipalAsync();
        if (principal is null)
        {
            _error = L["ChangePassword.SessionExpired"];
            return;
        }

        var result = await AccountSelfService.DeleteAccountAsync(
            principal,
            new AccountDeletionRequest(
                _model.Email,
                _model.Password));
        if (result.Succeeded)
        {
            _deleted = true;
            _error = null;
            return;
        }

        _error = string.Join(
            " ",
            result.Errors.Select(error => error.Description));
    }

    private sealed class DeleteInput
    {
        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        [DataType(System.ComponentModel.DataAnnotations.DataType.Password)]
        public string Password { get; set; } = string.Empty;
    }
}
