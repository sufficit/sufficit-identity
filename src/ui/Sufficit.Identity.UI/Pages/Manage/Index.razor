@page "/manage"
@attribute [Authorize]
@inject IAccountSelfService AccountSelfService
@inject IUserAvatarUrlResolver AvatarUrlResolver
@inject IStringLocalizer<SharedResource> L
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject IUiModuleRegistry UiModules
@inject IAuthorizationService AuthorizationService
@using Sufficit.Identity.UI.Abstractions.Hosting

<PageTitle>@L["Manage.Title"]</PageTitle>

<div class="auth-card manage-grid">
    <h1>@L["Manage.Title"]</h1>

    <div class="profile-card">
        @if (!string.IsNullOrEmpty(_avatarUrl) && !_avatarLoadFailed)
        {
            <img src="@_avatarUrl"
                 class="profile-avatar"
                 alt=""
                 decoding="async"
                 referrerpolicy="no-referrer"
                 @onerror="HandleAvatarError" />
        }
        else
        {
            <div class="profile-avatar">@AvatarFallback</div>
        }
        <div>
            <h2>@_profile?.UserName</h2>
            <p class="muted">@_profile?.Email</p>
            @if (_emailConfirmed)
            {
                <span class="badge badge-success">@L["Manage.EmailConfirmed"]</span>
            }
            else
            {
                <span class="badge badge-warning">@L["Manage.EmailNotConfirmed"]</span>
            }
        </div>
    </div>

    <nav class="manage-nav">
        <a href="/manage/changepassword" class="manage-link">@L["Manage.ChangePassword"]</a>
        <a href="/manage/twofactor" class="manage-link">@L["Manage.TwoFactor"]</a>
        <a href="/manage/passkeys" class="manage-link">@L["Manage.Passkeys"]</a>
        <a href="/manage/externallogins" class="manage-link">@L["Manage.ExternalLogins"]</a>
        <a href="/manage/grants" class="manage-link">@L["Manage.ConnectedApps"]</a>
        <a href="/manage/sessions" class="manage-link">@L["Manage.ActiveSessions"]</a>
        <a href="/manage/personaldata" class="manage-link">@L["Manage.PersonalData"]</a>
    </nav>

    @if (AdditionalResourcesAvailable)
    {
        <section class="manage-resources"
                 aria-labelledby="manage-resources-heading">
            <h2 id="manage-resources-heading"
                class="manage-resources__heading">
                @L["Manage.AdditionalResources"]
            </h2>
            <nav class="manage-nav manage-nav--resources"
                 aria-labelledby="manage-resources-heading">
                @if (VaultAvailable)
                {
                    <a href="/vault" class="manage-link">
                        @L["Manage.StoredCredentials"]
                    </a>
                }
                @if (_managementAvailable)
                {
                    <a href="/management/"
                       class="manage-link"
                       data-enhance-nav="false">
                        @L["Manage.SystemManagement"]
                    </a>
                }
            </nav>
        </section>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? _authTask { get; set; }
    private AccountSelfServiceProfile? _profile;
    private bool _emailConfirmed;
    private bool _avatarLoadFailed;
    private bool _managementAvailable;
    private string? _avatarUrl;
    private bool VaultAvailable =>
        UiModules.HasSurface(UiSurface.Vault)
        && bool.TryParse(Configuration["Sufficit:Vault:Enabled"], out var enabled)
        && enabled;
    private bool AdditionalResourcesAvailable =>
        VaultAvailable || _managementAvailable;
    private string AvatarFallback =>
        string.IsNullOrWhiteSpace(_profile?.UserName)
            ? "ID"
            : _profile.UserName.Trim()[..1].ToUpperInvariant();

    protected override async Task OnInitializedAsync()
    {
        var principal = await _authTask.GetAuthenticatedPrincipalAsync();
        if (principal is null) return;

        _profile = await AccountSelfService.GetProfileAsync(principal);
        if (_profile is not null)
        {
            _emailConfirmed = _profile.EmailConfirmed;
            _avatarUrl = await AvatarUrlResolver.ResolveAsync(_profile.UserId);
        }

        if (UiModules.HasSurface(UiSurface.Management))
        {
            var authorization = await AuthorizationService.AuthorizeAsync(
                principal,
                UiAuthorizationPolicies.ManagementAccess);
            _managementAvailable = authorization.Succeeded;
        }
    }

    private void HandleAvatarError()
    {
        _avatarLoadFailed = true;
    }
}
