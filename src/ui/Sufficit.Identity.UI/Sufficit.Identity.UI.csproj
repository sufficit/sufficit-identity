<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sufficit.Identity.UI</RootNamespace>
    <AssemblyName>Sufficit.Identity.UI</AssemblyName>
    <Description>Sufficit Identity UI — embedded public and account frontend.</Description>
    <NeutralLanguage>pt-BR</NeutralLanguage>
    <IsPackable>true</IsPackable>
    <!-- Static web assets (CSS, JS) served via MapStaticAssets in the host STS -->
    <StaticWebAssetsEnabled>true</StaticWebAssetsEnabled>
    <!--
      Blazor Razor components define display-only state fields (e.g. _error, _signedOut)
      that are read in markup but assigned only in code paths reached at runtime (handlers,
      external redirects). Suppress these false positives for the project as a whole.
    -->
    <NoWarn>$(NoWarn);CS0414;CS0649;RZ10012</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core presentation primitives (Razor Components and HTTP). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- QR code generation for 2FA TOTP setup -->
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The public UI consumes canonical application contracts from Core. Runtime
      adapters own identity, protocol and persistence implementations.
    -->
    <ProjectReference Include="..\..\core\Sufficit.Identity.Core.csproj" />
  </ItemGroup>

</Project>
