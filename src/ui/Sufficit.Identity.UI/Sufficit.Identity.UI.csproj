<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sufficit.Identity.UI</RootNamespace>
    <AssemblyName>Sufficit.Identity.UI</AssemblyName>
    <Description>Sufficit Identity UI — embedded public and account frontend.</Description>
    <NeutralLanguage>pt-BR</NeutralLanguage>
    <IsPackable>true</IsPackable>
    <!-- Static web assets (CSS, JS) served via MapStaticAssets in the host STS -->
    <StaticWebAssetsEnabled>true</StaticWebAssetsEnabled>
    <!--
      Blazor Razor components define display-only state fields (e.g. _error, _signedOut)
      that are read in markup but assigned only in code paths reached at runtime (handlers,
      external redirects). Suppress these false positives for the project as a whole.
    -->
    <NoWarn>$(NoWarn);CS0414;CS0649;RZ10012</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core presentation primitives (Razor Components and HTTP). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- QR code generation for 2FA TOTP setup -->
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\application\Sufficit.Identity.Application.Abstractions\Sufficit.Identity.Application.Abstractions.csproj" />
    <ProjectReference Include="..\Sufficit.Identity.UI.Abstractions\Sufficit.Identity.UI.Abstractions.csproj" />
    <!-- Local sibling checkout wins when present (fast inner loop);
         CI/Docker/fresh clones consume the published NuGet package. See
         SufficitUseLocalSui in Directory.Build.props. -->
  </ItemGroup>

  <!-- Local sibling checkout wins when present (fast inner loop);
       CI/Docker/fresh clones consume the published NuGet package.
       See SufficitUseLocalSui in Directory.Build.props. -->
    <ItemGroup Condition="'$(SufficitUseLocalSui)' == 'true'">
      <ProjectReference Include="..\..\..\..\sufficit-blazor-ui\src\Sufficit.Blazor.UI.csproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(SufficitUseLocalSui)' != 'true'">
      <PackageReference Include="Sufficit.Blazor.UI" />
    </ItemGroup>

</Project>
