@using System.Globalization
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Localization
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject IStringLocalizer<SharedResource> L

@if (_cultures.Length > 1)
{
    <div class="culture-selector">
        <label class="visually-hidden" for="identity-culture">@L["Culture.Selector"]</label>
        <select id="identity-culture"
                name="culture"
                aria-label="@L["Culture.Selector"]"
                @onchange="ChangeCulture"
                value="@_currentCulture.Name">
            @foreach (var culture in _cultures)
            {
                <option value="@culture.Name">@GetCultureLabel(culture)</option>
            }
        </select>
    </div>
}

@code {
    private static readonly CultureInfo[] _cultures = new[]
    {
        new CultureInfo("pt-BR"),
        new CultureInfo("en-US"),
    };

    private CultureInfo _currentCulture = CultureInfo.CurrentUICulture;

    private static string GetCultureLabel(CultureInfo culture) =>
        culture.Name switch
        {
            "pt-BR" => "PT",
            "en-US" => "EN",
            _ => culture.TwoLetterISOLanguageName.ToUpperInvariant(),
        };

    private async Task ChangeCulture(ChangeEventArgs e)
    {
        var culture = e.Value?.ToString() ?? "pt-BR";
        var cultureCookie = $"c={culture}|uic={culture}";

        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext is not null)
        {
            httpContext.Response.Cookies.Append(
                CookieRequestCultureProvider.DefaultCookieName,
                cultureCookie,
                new CookieOptions { Expires = DateTimeOffset.UtcNow.AddYears(1), IsEssential = true });
        }

        // Force reload so the new culture takes effect across the Blazor circuit.
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }
}
