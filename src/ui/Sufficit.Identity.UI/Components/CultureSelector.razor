@using System.Globalization
@rendermode @(RenderMode.InteractiveServer)
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

@if (_cultures.Length > 1)
{
    <div class="culture-selector" data-culture-selector>
        <SUISelect T="string"
                   Value="@_currentCulture.Name"
                   ValueChanged="ChangeCulture"
                   Label="@L["Culture.Selector"]"
                   MenuWidth="10rem"
                   MenuMaxWidth="calc(100vw - 1.5rem)"
                   Class="culture-selector__select">
            @foreach (var culture in _cultures)
            {
                <SUISelectItem Value="@culture.Name">
                    @GetCultureLabel(culture)
                </SUISelectItem>
            }
        </SUISelect>

        <noscript>
            <form class="culture-selector__fallback"
                  action="/culture/set"
                  method="get">
                <label class="visually-hidden" for="identity-culture-fallback">@L["Culture.Selector"]</label>
                <input type="hidden" name="returnUrl" value="@CurrentReturnUrl" />
                <select id="identity-culture-fallback"
                        name="culture"
                        aria-label="@L["Culture.Selector"]">
                    @foreach (var culture in _cultures)
                    {
                        <option value="@culture.Name" selected="@(culture.Name == _currentCulture.Name)">
                            @GetCultureLabel(culture)
                        </option>
                    }
                </select>
            <button type="submit" class="culture-selector__submit">@L["Common.Confirm"]</button>
            </form>
        </noscript>
    </div>
}

@code {
    private static readonly CultureInfo[] _cultures = new[]
    {
        new CultureInfo("pt-BR"),
        new CultureInfo("en-US"),
    };

    private CultureInfo _currentCulture = CultureInfo.CurrentUICulture;

    private string CurrentReturnUrl
    {
        get
        {
            var currentUri = Nav.ToAbsoluteUri(Nav.Uri);
            return currentUri.PathAndQuery + currentUri.Fragment;
        }
    }

    private void ChangeCulture(string? culture)
    {
        if (string.IsNullOrWhiteSpace(culture)
            || string.Equals(culture, _currentCulture.Name, StringComparison.OrdinalIgnoreCase)
            || !_cultures.Any(item => string.Equals(
                item.Name,
                culture,
                StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        var destination = "/culture/set?culture="
            + Uri.EscapeDataString(culture)
            + "&returnUrl="
            + Uri.EscapeDataString(CurrentReturnUrl);
        Nav.NavigateTo(destination, forceLoad: true);
    }

    private static string GetCultureLabel(CultureInfo culture) =>
        culture.Name switch
        {
            "pt-BR" => "Português",
            "en-US" => "English",
            _ => culture.TwoLetterISOLanguageName.ToUpperInvariant(),
        };
}
