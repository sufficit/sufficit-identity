@* Standalone SSR: recovery must not need a circuit, JavaScript, a login or a database lookup. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@L[$"{ResourcePrefix}.Title"] — Sufficit Identity</title>
    <link rel="stylesheet" href="/_content/Sufficit.Identity.UI/css/site.css" />
    <link rel="stylesheet" href="/_content/Sufficit.Identity.UI/css/authorization-error.css" />
</head>
<body>
    <div class="page">
        <header class="topbar">
            <div class="topbar-brand">
                <a href="/">
                    <span class="brand-wordmark"><span class="brand-name">Sufficit</span><span class="brand-sub">Identity</span></span>
                </a>
            </div>
        </header>
        <main class="content">
            <section class="auth-card authorization-error" aria-labelledby="authorization-error-title">
                <h1 id="authorization-error-title">@L[$"{ResourcePrefix}.Title"]</h1>
                <p>@L[$"{ResourcePrefix}.Explanation"]</p>
                <p>@L[$"{ResourcePrefix}.Recovery", RetryAfterSeconds ?? 0]</p>
                <div class="authorization-error__actions">
                    <a class="btn btn-primary" href="/">@L["AuthorizationError.Home"]</a>
                </div>
                <p class="authorization-error__help">@L[RetryAfterSeconds.HasValue ? "RateLimitError.Help" : "AuthorizationError.AttemptEnded"]</p>
            </section>
        </main>
    </div>
</body>
</html>

@code {
    [Parameter] public int? RetryAfterSeconds { get; set; }
    private string ResourcePrefix => RetryAfterSeconds.HasValue ? "RateLimitError" : "AuthorizationError";
}
