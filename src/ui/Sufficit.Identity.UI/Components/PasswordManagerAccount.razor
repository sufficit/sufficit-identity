@* A text control hidden from the layout lets password managers associate the
   new password with its account. This hint is never used to select an account
   on POST; the validated reset token or authenticated principal remains authoritative. *@
@if (!string.IsNullOrWhiteSpace(UserName))
{
    <input id="password-account" type="text" name="username" autocomplete="username"
           value="@UserName" hidden />
}

@code {
    [Parameter] public string? UserName { get; set; }
}
