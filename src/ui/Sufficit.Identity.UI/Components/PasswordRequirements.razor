@inject IStringLocalizer<SharedResource> L

<div id="@Id" class="password-requirements" data-password-requirements="@InputId"
     data-password-minimum="@Policy.RequiredLength" data-password-maximum="@MaximumLength"
     data-password-unique="@Policy.RequiredUniqueChars" aria-live="polite" aria-atomic="true">
    <p>@L["PasswordRules.Title"]</p>
    <ul>
        <li data-password-rule="length">@(MaximumLength is { } maximum
            ? L["PasswordRules.LengthRange", Policy.RequiredLength, maximum]
            : L["PasswordRules.MinimumLength", Policy.RequiredLength])</li>
        @if (Policy.RequireUppercase) { <li data-password-rule="uppercase">@L["PasswordRules.Uppercase"]</li> }
        @if (Policy.RequireLowercase) { <li data-password-rule="lowercase">@L["PasswordRules.Lowercase"]</li> }
        @if (Policy.RequireDigit) { <li data-password-rule="digit">@L["PasswordRules.Digit"]</li> }
        @if (Policy.RequireNonAlphanumeric) { <li data-password-rule="symbol">@L["PasswordRules.Symbol"]</li> }
        @if (Policy.RequiredUniqueChars > ImpliedUniqueCharacters)
        {
            <li data-password-rule="unique">@L["PasswordRules.Unique", Policy.RequiredUniqueChars]</li>
        }
    </ul>
</div>

@code {
    [Parameter, EditorRequired] public AccountPasswordPolicy Policy { get; set; } = default!;
    [Parameter, EditorRequired] public string InputId { get; set; } = string.Empty;
    [Parameter] public string Id { get; set; } = "password-requirements";
    [Parameter] public int? MaximumLength { get; set; }

    // Distinct required character categories already imply distinct characters.
    private int ImpliedUniqueCharacters => Math.Max(1,
        (Policy.RequireUppercase ? 1 : 0) + (Policy.RequireLowercase ? 1 : 0)
        + (Policy.RequireDigit ? 1 : 0) + (Policy.RequireNonAlphanumeric ? 1 : 0));
}
