@inject IBrandingThemeProvider BrandingProvider
@inject IStringLocalizer<SharedResource> L
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inherits LayoutComponentBase

@code {
    protected BrandingTheme? _theme;

    // The server chip tells operators WHICH replica of the round-robin
    // (eveo/apoint/castrum) is serving the page. Precedence: an explicit
    // Sufficit:Runtime:ServerDisplayName (deployments that consider the raw
    // host name sensitive can show a nickname instead), then the configured
    // ServerHostName, then Environment.MachineName as the situate-me default.
    private string? ServerHostName =>
        (Configuration["Sufficit:Runtime:ServerDisplayName"]?.Trim()
            is { Length: > 0 } display)
            ? display
            : Configuration["Sufficit:Runtime:ServerHostName"]?.Trim()
                is { Length: > 0 } configured
                ? configured
                : Environment.MachineName;

    // Mirrors the host's Swagger gate (Sufficit:Identity:Swagger:Enabled,
    // unset = Development only). Linking to /swagger when the host does not
    // publish it would advertise a dead route and imply the contract is
    // browsable when it is not.
    private bool SwaggerPublished =>
        bool.TryParse(
            Configuration["Sufficit:Identity:Swagger:Enabled"],
            out var configured)
            ? configured
            : string.Equals(
                Configuration["ASPNETCORE_ENVIRONMENT"],
                "Development",
                StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        _theme = await BrandingProvider.GetActiveAsync();
    }
}

<div class="page">
    <header class="topbar">
        <div class="topbar-brand">
            <a href="/">
                <img src="@(_theme?.HeaderIconUrl ?? "_content/Sufficit.Identity.UI/img/header-icon.png")" class="brand-mark" alt="" />
                <span class="brand-wordmark">
                    <span class="brand-name">@(_theme?.BrandName ?? "Sufficit")</span>
                    <span class="brand-sub">@(_theme?.BrandSubtitle ?? "Identity")</span>
                </span>
            </a>
        </div>
        <nav class="topbar-nav">
            <CultureSelector />
            <AuthorizeView>
                <Authorized>
                    <a href="/account/logout" class="nav-link">@L["Layout.Logout"]</a>
                </Authorized>
            </AuthorizeView>
        </nav>
    </header>

    <main class="content">
        @Body
    </main>

    <footer class="footer">
        <span>&copy; @DateTime.UtcNow.Year Sufficit</span>
        @if (ServerHostName is not null)
        {
            <span class="footer-server"
                  title="@L["Layout.ServerDescription", ServerHostName]">
                <span class="footer-server__status" aria-hidden="true"></span>
                <span>@L["Layout.Server"]</span>
                <code>@ServerHostName</code>
            </span>
        }
        <span class="footer-links">
            <a href="/.well-known/openid-configuration">Discovery</a>
            @if (SwaggerPublished)
            {
                <text> · </text>
                <a href="/swagger">API Swagger</a>
            }
        </span>
    </footer>
</div>
