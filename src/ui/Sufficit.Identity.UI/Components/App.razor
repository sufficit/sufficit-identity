@inject IBrandingThemeProvider BrandingProvider
@inject IUiModuleRegistry UiModules
@inject IStringLocalizer<SharedResource> L
@using System.Globalization
@using Sufficit.Identity.UI.Abstractions.Hosting
@using Sufficit.Identity.UI.Components

@code {
    private BrandingTheme? _theme;
    private string _themeCss = string.Empty;

    // The browser writes constraint-validation messages ("Please fill out this
    // field.") in its own UI language, not the page's. identity.js swaps them
    // for these, rendered in the culture the person picked.
    private string BrowserValidationMessages => System.Text.Json.JsonSerializer.Serialize(
        new Dictionary<string, string>
        {
            ["required"] = L["Validation.Browser.Required"],
            ["checkboxRequired"] = L["Validation.Browser.CheckboxRequired"],
            ["choiceRequired"] = L["Validation.Browser.ChoiceRequired"],
            ["email"] = L["Validation.Browser.Email"],
            ["url"] = L["Validation.Browser.Url"],
            ["tooShort"] = L["Validation.Browser.TooShort"],
            ["tooLong"] = L["Validation.Browser.TooLong"],
            ["pattern"] = L["Validation.Browser.Pattern"],
            ["number"] = L["Validation.Browser.Number"],
            ["rangeUnderflow"] = L["Validation.Browser.RangeUnderflow"],
            ["rangeOverflow"] = L["Validation.Browser.RangeOverflow"],
            ["step"] = L["Validation.Browser.Step"],
            ["invalid"] = L["Validation.Browser.Invalid"],
        });

    protected override async Task OnInitializedAsync()
    {
        _theme = await BrandingProvider.GetActiveAsync();
        _themeCss = BrandingStylesheet.Build(_theme);
    }
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <base href="/" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="@(_theme?.FaviconUrl ?? "_content/Sufficit.Identity.UI/img/favicon.png")" type="image/png" />
    <link rel="apple-touch-icon" href="@(_theme?.FaviconUrl ?? "_content/Sufficit.Identity.UI/img/favicon.png")" />
    <link rel="preload" href="_content/Sufficit.Identity.UI/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="_content/Sufficit.Identity.UI/fonts/inter-latin-600.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="sufficit-validation-messages" content="@BrowserValidationMessages" />
    <meta name="theme-color" content="@(_theme?.ThemeColor ?? "#cc0000")" />
    <link rel="stylesheet" href="_content/Sufficit.Blazor.UI/sufficit-ui.css" />
    <link rel="stylesheet" href="Sufficit.Identity.Server.styles.css" />
    <link rel="stylesheet" href="_content/Sufficit.Identity.UI/css/site.css" />
    @if (UiModules.HasSurface(UiSurface.Vault))
    {
        <link rel="stylesheet" href="_content/Sufficit.Identity.UI.Vault/vault.css" />
    }
    @if (_themeCss.Length > 0)
    {
        <link rel="stylesheet" href="@($"{BrandingStylesheet.Path.TrimStart('/')}?v={BrandingStylesheet.Version(_themeCss)}")" />
    }
    <HeadOutlet />
</head>
<body>
    <Routes />
    <ReconnectModal Reconnecting="@L["App.Reconnecting"].Value"
                    Failed="@L["App.ConnectionLost"].Value"
                    Reload="@L["App.Reload"].Value" />
    <script src="_content/Sufficit.Identity.UI/js/identity.js"></script>
    <script src="_content/Sufficit.Identity.UI/js/password-requirements.js"></script>
    <script src="_content/Sufficit.Identity.UI/js/human-verification.js"></script>
    <script src="_content/Sufficit.Identity.UI/js/passkeys.js"></script>
    <script src="_content/Sufficit.Identity.UI/_framework/blazor.web.js"></script>
</body>
</html>
