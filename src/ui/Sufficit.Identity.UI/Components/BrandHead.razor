@* BrandHead renders favicon, theme-color, title and dynamic CSS overrides
   from the active BrandingTheme (DB-backed, cached). Placed inside <head>
   via App.razor's <HeadOutlet/>. Falls back to hardcoded defaults when
   no theme is active or the table doesn't exist yet. *@

@code {
    [Inject] IBrandingThemeProvider BrandingProvider { get; set; } = null!;

    private BrandingTheme? _theme;

    // M7 defense-in-depth: the management API + EditModel already validate
    // colors via [RegularExpression("^#[0-9A-Fa-f]{6}$")], but the render site
    // must not trust stored data blindly (a direct DB write bypasses API
    // validation). SafeColor returns null for anything that is not a valid
    // hex color, preventing CSS/JS injection through the <style> block.
    private static readonly System.Text.RegularExpressions.Regex HexColorRegex =
        new("^#[0-9A-Fa-f]{6}$",
            System.Text.RegularExpressions.RegexOptions.Compiled);

    private static string? SafeColor(string? value) =>
        !string.IsNullOrEmpty(value) && HexColorRegex.IsMatch(value)
            ? value
            : null;

    private static string? SafeUrl(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        if (Uri.TryCreate(value, UriKind.Absolute, out var uri)
            && (uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp))
        {
            return uri.AbsoluteUri;
        }
        // Relative URLs (starting with a single /) are safe in img/background
        // contexts. Protocol-relative (//) is NOT safe.
        if (value.StartsWith('/') && !value.StartsWith("//"))
        {
            return value;
        }
        return null;
    }

    // Pre-compute sanitized values to keep the markup clean.
    private string? _brandColor;
    private string? _brandHoverColor;
    private string? _brandSoftColor;
    private string? _themeColor;
    private string? _backgroundImageUrl;
    private string? _faviconUrl;

    protected override async Task OnInitializedAsync()
    {
        _theme = await BrandingProvider.GetActiveAsync();

        _brandColor = SafeColor(_theme?.BrandColor);
        _brandHoverColor = SafeColor(_theme?.BrandHoverColor);
        _brandSoftColor = SafeColor(_theme?.BrandSoftColor);
        _themeColor = SafeColor(_theme?.ThemeColor);
        _backgroundImageUrl = SafeUrl(_theme?.BackgroundImageUrl);
        _faviconUrl = SafeUrl(_theme?.FaviconUrl);
    }
}

<link rel="icon" href="@(_faviconUrl ?? "_content/Sufficit.Identity.UI/img/favicon.png")" type="image/png" />
<link rel="apple-touch-icon" href="@(_faviconUrl ?? "_content/Sufficit.Identity.UI/img/favicon.png")" />
<meta name="theme-color" content="@(_themeColor ?? "#cc0000")" />
<title>@(_theme?.Title ?? "Sufficit Identity")</title>

@if (!string.IsNullOrEmpty(_brandColor))
{
    <style>
        :root {
            --brand: @_brandColor;
            --brand-ring: @(_brandColor)40;
            @if (!string.IsNullOrEmpty(_brandHoverColor))
            {
                <text>--brand-hover: @_brandHoverColor;</text>
            }
            @if (!string.IsNullOrEmpty(_brandSoftColor))
            {
                <text>--brand-soft: @_brandSoftColor;</text>
            }
        }
    </style>
}

@if (!string.IsNullOrEmpty(_backgroundImageUrl))
{
    <style>
        body {
            background:
                linear-gradient(rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0.15)),
                url("@_backgroundImageUrl") center / cover fixed no-repeat !important;
        }
    </style>
}
