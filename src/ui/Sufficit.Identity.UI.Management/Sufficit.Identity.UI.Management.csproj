<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sufficit.Identity.UI.Management</RootNamespace>
    <AssemblyName>Sufficit.Identity.UI.Management</AssemblyName>
    <Description>Sufficit Identity UI — injectable administrative management module.</Description>
    <NeutralLanguage>pt-BR</NeutralLanguage>
    <IsPackable>true</IsPackable>
    <StaticWebAssetsEnabled>true</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\application\Sufficit.Identity.Application.Abstractions\Sufficit.Identity.Application.Abstractions.csproj" />
    <ProjectReference Include="..\Sufficit.Identity.UI.Abstractions\Sufficit.Identity.UI.Abstractions.csproj" />
    <ProjectReference Include="..\Sufficit.Identity.UI.Components\Sufficit.Identity.UI.Components.csproj" />
  </ItemGroup>

  <ItemGroup>
    <RazorComponent Remove="Components\Common\*.razor" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared visual assets are embedded at build time. The host exposes them
         under this RCL's _content path when the module is enabled. -->
    <EmbeddedResource Include="..\Sufficit.Identity.UI\wwwroot\img\logo-mark.png"
                      LogicalName="Sufficit.Identity.UI.Management.Assets.logo-mark.png" />
    <EmbeddedResource Include="..\Sufficit.Identity.UI\wwwroot\fonts\inter-latin.woff2"
                      LogicalName="Sufficit.Identity.UI.Management.Assets.inter-latin.woff2" />
    <EmbeddedResource Include="..\Sufficit.Identity.UI\wwwroot\fonts\inter-latin-500.woff2"
                      LogicalName="Sufficit.Identity.UI.Management.Assets.inter-latin-500.woff2" />
    <EmbeddedResource Include="..\Sufficit.Identity.UI\wwwroot\fonts\inter-latin-600.woff2"
                      LogicalName="Sufficit.Identity.UI.Management.Assets.inter-latin-600.woff2" />
    <EmbeddedResource Include="..\Sufficit.Identity.UI\wwwroot\_framework\blazor.web.js"
                      LogicalName="Sufficit.Identity.UI.Management.Assets.blazor.web.js" />
    <EmbeddedResource Include="wwwroot\app.css"
                      LogicalName="Sufficit.Identity.UI.Management.Assets.app.css" />
    <EmbeddedResource Include="wwwroot\users.css"
                      LogicalName="Sufficit.Identity.UI.Management.Assets.users.css" />
  </ItemGroup>

</Project>
