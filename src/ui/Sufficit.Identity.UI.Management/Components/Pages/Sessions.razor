@page "/sessions"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageSessions)]
@attribute [StreamRendering]
@inject ManagementSessionDataSource SessionData

<PageTitle>@L["Sessions.PageTitle"]</PageTitle>

<SUIPageHeader Title="@L["Sessions.HeaderTitle"].Value"
            Description="@L["Sessions.HeaderDescription"].Value">
</SUIPageHeader>

<div class="contract-strip contract-strip--info">
    <SUIIcon Name="clock" Size="20" />
    <div>
        <strong>@L["Sessions.ContractStrip.Title"]</strong>
        <span>@L["Sessions.ContractStrip.Description"]</span>
    </div>
    <SUIStatusBadge ToneValue="SUITone.Info">@L["Sessions.ContractStrip.Badge"]</SUIStatusBadge>
</div>

@if (revoked)
{
    <div class="inline-notice inline-notice--success" role="status">
        <SUIIcon Name="check" Size="19" />
        <div>
            <strong>@L["Sessions.Revoked.Title"]</strong>
            <span>@L["Sessions.Revoked.Description"]</span>
        </div>
    </div>
}

@if (revokedAll is not null)
{
    <div class="inline-notice inline-notice--success" role="status">
        <SUIIcon Name="check" Size="19" />
        <div>
            <strong>@L["Sessions.RevokedAll.Title"]</strong>
            <span>@string.Format(L["Sessions.RevokedAll.DescriptionFormat"].Value, revokedAll.RevokedTokens, revokedAll.RevokedAuthorizations)</span>
        </div>
    </div>
}

<div class="table-panel" aria-labelledby="sessions-list-heading" aria-busy="@loading">
    <div class="data-toolbar data-toolbar--users">
        <div>
            <h2 id="sessions-list-heading">@L["Sessions.List.Heading"]</h2>
            <p>@FilterDescription</p>
        </div>
        <div class="data-toolbar__actions">
            <form class="user-search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
                <label class="search-field">
                    <span class="visually-hidden">@L["Sessions.Search.VisuallyHidden"]</span>
                    <SUIIcon Name="search" Size="18" />
                    <input type="search"
                           placeholder="@L["Sessions.Search.Placeholder"].Value"
                           autocomplete="off"
                           @bind="search" />
                </label>
                <div class="select-field">
                    <span>@L["Sessions.Filter.StateLabel"]</span>
                    <SUISelect T="string" @bind-Value="stateFilter">
                        <SUISelectItem Value="@("active")">@L["Sessions.Filter.Active"]</SUISelectItem>
                        <SUISelectItem Value="@("all")">@L["Sessions.Filter.All"]</SUISelectItem>
                    </SUISelect>
                </div>
                <button class="button button--secondary" type="submit" disabled="@loading">@L["Sessions.Apply"]</button>
            </form>
        </div>
    </div>

    <div class="client-results" aria-live="polite">
        @if (loading)
        {
            <div class="table-skeleton" aria-label="@L["Sessions.LoadingAriaLabel"].Value">
                @for (var index = 0; index < 4; index++)
                {
                    <span></span>
                }
            </div>
        }
        else if (result?.IsSuccess is true)
        {
            @if (Page.Items.Count is 0)
            {
                <SUIEmptyState Icon="clock"
                            Title="@L["Sessions.Empty.Title"].Value"
                            Description="@L["Sessions.Empty.Description"].Value" />
            }
            else
            {
                <div class="table-scroll">
                    <table class="data-table data-table--claims">
                        <thead>
                            <tr>
                                <th scope="col">@L["Sessions.Column.UserApplication"]</th>
                                <th scope="col">@L["Sessions.Column.Client"]</th>
                                <th scope="col">@L["Sessions.Column.Type"]</th>
                                <th scope="col">@L["Sessions.Column.IssuedExpires"]</th>
                                <th scope="col">@L["Sessions.Column.State"]</th>
                                <th scope="col"><span class="visually-hidden">@L["Sessions.Column.Actions"]</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var session in Page.Items)
                            {
                                <tr>
                                    <td data-label="@L["Sessions.Column.UserApplication"].Value">
                                        @if (HasHumanUser(session))
                                        {
                                            <a class="client-name" href="@UserHref(session.UserId!)">@UserLabel(session)</a>
                                        }
                                        else if (session.ClientApplicationId is not null)
                                        {
                                            <a class="client-name" href="@ClientHref(session.ClientApplicationId)">
                                                @ClientLabel(session)
                                            </a>
                                        }
                                        else
                                        {
                                            <span>@L["Sessions.TechnicalClientNoApp"]</span>
                                        }
                                    </td>
                                    <td data-label="@L["Sessions.Column.Client"].Value">
                                        <span class="scope-identity">
                                            <strong>@(session.ClientDisplayName ?? session.ClientId ?? L["Sessions.NoClient"].Value)</strong>
                                            @if (session.ClientId is not null)
                                            {
                                                <code>@session.ClientId</code>
                                            }
                                        </span>
                                    </td>
                                    <td data-label="@L["Sessions.Column.Type"].Value"><code class="client-id">@TypeLabel(session.Type)</code></td>
                                    <td data-label="@L["Sessions.Column.IssuedExpires"].Value">
                                        <span class="scope-identity">
                                            <strong>@DateLabel(session.CreatedAt)</strong>
                                            <code>@L["Sessions.ExpiresPrefix"] @DateLabel(session.ExpiresAt)</code>
                                        </span>
                                    </td>
                                    <td data-label="@L["Sessions.Column.State"].Value">
                                        <SUIStatusBadge ToneValue="@(session.IsActive ? SUITone.Success : SUITone.Neutral)">
                                            @StatusLabel(session.Status)
                                        </SUIStatusBadge>
                                    </td>
                                    <td data-label="@L["Sessions.Column.Actions"].Value">
                                        @if (session.IsActive)
                                        {
                                            <button class="row-action row-action--button"
                                                    type="button"
                                                    @onclick="() => SelectForRevocation(session)">
                                                @L["Sessions.RevokeAction"]
                                                <SUIIcon Name="lock" Size="15" />
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else
        {
            <SUIEmptyState Icon="alert"
                        Title="@ErrorTitle"
                        Description="@(result?.ErrorMessage ?? L["Sessions.Error.GenericDescription"].Value)">
                <Actions>
                    <button class="button button--secondary" type="button" @onclick="LoadAsync">@L["Sessions.Retry"]</button>
                </Actions>
            </SUIEmptyState>
        }
    </div>

    <footer class="table-footer table-footer--paginated">
        <span>@ResultCountLabel</span>
        @if (result?.IsSuccess is true && Page.TotalCount > Page.PageSize)
        {
            <div class="pagination" aria-label="@L["Sessions.PaginationAriaLabel"].Value">
                <button class="button button--secondary button--compact" type="button"
                        disabled="@(Page.Page <= 1 || loading)"
                        @onclick="PreviousPageAsync">@L["Sessions.Previous"]</button>
                <span>@string.Format(L["Sessions.PageOfFormat"].Value, Page.Page, TotalPages)</span>
                <button class="button button--secondary button--compact" type="button"
                        disabled="@(Page.Page >= TotalPages || loading)"
                        @onclick="NextPageAsync">@L["Sessions.Next"]</button>
            </div>
        }
    </footer>
</div>

@if (selected is not null)
{
    <div class="delete-zone" aria-labelledby="revoke-session-heading">
        <div>
            <h2 id="revoke-session-heading">@L["Sessions.RevokeConfirm.Heading"]</h2>
            <p>@PrincipalLabel(selected) · @TypeLabel(selected.Type) · @L["Sessions.RevokeConfirm.IssuedAt"] @DateLabel(selected.CreatedAt).</p>
        </div>
        @if (revocation?.IsSuccess is false)
        {
            <div class="inline-notice inline-notice--danger" role="alert">
                <SUIIcon Name="alert" Size="19" />
                <div><strong>@L["Sessions.RevokeConfirm.ErrorTitle"]</strong><span>@revocation.ErrorMessage</span></div>
            </div>
        }
        <button class="button button--secondary" type="button" @onclick="CancelRevocation">@L["Sessions.Cancel"]</button>
        <button class="button button--danger" type="button" disabled="@revoking" @onclick="RevokeAsync">
            <SUIIcon Name="lock" Size="17" />
            @(revoking ? L["Sessions.Revoking"] : L["Sessions.ConfirmRevocation"])
        </button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(UserId))
{
    <div class="danger-zone" aria-labelledby="revoke-all-heading">
        <div>
            <h2 id="revoke-all-heading">@L["Sessions.RevokeAll.Heading"]</h2>
            <p>@L["Sessions.RevokeAll.Description"]</p>
        </div>
        <div>
            <label class="delete-confirmation">
                <input type="checkbox" @bind="revokeAllConfirmed" />
                <span>@L["Sessions.RevokeAll.ConfirmLabel"]</span>
            </label>
            <button class="button button--danger"
                    type="button"
                    disabled="@(!revokeAllConfirmed || revokingAll)"
                    @onclick="RevokeAllAsync">
                <SUIIcon Name="lock" Size="17" />
                @(revokingAll ? L["Sessions.RevokeAll.Ending"] : L["Sessions.RevokeAll.EndAll"])
            </button>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "user")]
    public string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "client")]
    public string? ClientId { get; set; }

    private ManagementDataResult<ManagementSessionPage>? result;
    private ManagementDataResult<bool>? revocation;
    private ManagementSessionSummary? selected;
    private ManagementUserSessionRevocation? revokedAll;
    private string search = string.Empty;
    private string stateFilter = "active";
    private int currentPage = 1;
    private bool loading = true;
    private bool revoking;
    private bool revokingAll;
    private bool revokeAllConfirmed;
    private bool revoked;
    private const int PageSize = 25;

    private ManagementSessionPage Page =>
        result?.Value ?? new([], 1, PageSize, 0, UserId, ClientId, true);

    private int TotalPages =>
        Math.Max(1, (int)Math.Ceiling(Page.TotalCount / (double)Page.PageSize));

    private string FilterDescription =>
        UserId is not null
            ? string.Format(L["Sessions.FilterDescription.ByAccountFormat"].Value, UserId)
            : ClientId is not null
                ? string.Format(L["Sessions.FilterDescription.ByClientFormat"].Value, ClientId)
                : L["Sessions.FilterDescription.Default"].Value;

    private string ErrorTitle =>
        result?.Outcome is ManagementDataOutcome.StepUpRequired
            ? L["Sessions.Error.StepUp"].Value
            : result?.Outcome is ManagementDataOutcome.Forbidden
                ? L["Sessions.Error.Forbidden"].Value
                : L["Sessions.Error.Generic"].Value;

    private string ResultCountLabel =>
        loading
            ? L["Sessions.ResultCount.Loading"].Value
            : result?.IsSuccess is true
                ? string.Format(L["Sessions.ResultCount.Format"].Value, Page.TotalCount)
                : L["Sessions.ResultCount.NoneLoaded"].Value;

    protected override async Task OnParametersSetAsync()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        result = await SessionData.SearchAsync(
            new ManagementSessionSearch(
                search,
                UserId,
                ClientId,
                stateFilter == "active",
                currentPage,
                PageSize));
        loading = false;
    }

    private async Task SearchAsync()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task PreviousPageAsync()
    {
        currentPage = Math.Max(1, currentPage - 1);
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        currentPage = Math.Min(TotalPages, currentPage + 1);
        await LoadAsync();
    }

    private void SelectForRevocation(ManagementSessionSummary session)
    {
        selected = session;
        revocation = null;
        revoked = false;
    }

    private void CancelRevocation()
    {
        selected = null;
        revocation = null;
    }

    private async Task RevokeAsync()
    {
        if (selected is null || revoking)
        {
            return;
        }

        revoking = true;
        revocation = await SessionData.RevokeAsync(selected.Id);
        revoking = false;
        if (revocation.IsSuccess)
        {
            selected = null;
            revoked = true;
            await LoadAsync();
        }
    }

    private async Task RevokeAllAsync()
    {
        if (string.IsNullOrWhiteSpace(UserId)
            || !revokeAllConfirmed
            || revokingAll)
        {
            return;
        }

        revokingAll = true;
        var response = await SessionData.RevokeAllForUserAsync(UserId);
        revokingAll = false;
        if (response.IsSuccess)
        {
            revokedAll = response.Value;
            revokeAllConfirmed = false;
            await LoadAsync();
        }
    }

    private static bool HasHumanUser(ManagementSessionSummary session) =>
        session.UserId is not null
        && (session.UserName is not null || session.Email is not null);

    private string UserLabel(ManagementSessionSummary session) =>
        session.UserName ?? session.Email ?? session.UserId ?? L["Sessions.NoUser"].Value;

    private static string UserHref(string id) =>
        $"users/{Uri.EscapeDataString(id)}";

    private string ClientLabel(ManagementSessionSummary session) =>
        session.ClientDisplayName ?? session.ClientId ?? L["Sessions.Application"].Value;

    private static string ClientHref(string id) =>
        $"clients/{Uri.EscapeDataString(id)}";

    private string PrincipalLabel(ManagementSessionSummary session) =>
        HasHumanUser(session) ? UserLabel(session) : ClientLabel(session);

    private static string TypeLabel(string value) =>
        value.Replace('_', ' ');

    private string StatusLabel(string value) =>
        value switch
        {
            "valid" => L["Sessions.Status.Active"].Value,
            "revoked" => L["Sessions.Status.Revoked"].Value,
            "redeemed" => L["Sessions.Status.Used"].Value,
            _ => value
        };

    private string DateLabel(DateTimeOffset? value) =>
        value?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? L["Sessions.NoExpiration"].Value;
}
