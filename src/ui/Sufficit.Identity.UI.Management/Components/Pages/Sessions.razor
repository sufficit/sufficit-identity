@page "/sessions"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageSessions)]
@attribute [StreamRendering]
@inject ManagementSessionDataSource SessionData

<PageTitle>@L["Sessions.PageTitle"]</PageTitle>

<SUIPageHeader Title="@L["Sessions.HeaderTitle"].Value"
            Description="@L["Sessions.HeaderDescription"].Value">
</SUIPageHeader>

<div class="page-notices">
    <SUIAlert ToneValue="SUITone.Info" Icon="clock" role="note">
        <SUIStack Row Wrap AlignItems="Center" Justify="Between" Spacing="2">
            <div><strong>@L["Sessions.ContractStrip.Title"]</strong> <span>@L["Sessions.ContractStrip.Description"]</span></div>
            <SUIStatusBadge ToneValue="SUITone.Info">@L["Sessions.ContractStrip.Badge"]</SUIStatusBadge>
        </SUIStack>
    </SUIAlert>

    @if (revoked)
    {
        <SUIAlert ToneValue="SUITone.Success" Icon="check" role="status">
            <div><strong>@L["Sessions.Revoked.Title"]</strong> <span>@L["Sessions.Revoked.Description"]</span></div>
        </SUIAlert>
    }

    @if (revokedAll is not null)
    {
        <SUIAlert ToneValue="SUITone.Success" Icon="check" role="status">
            <div><strong>@L["Sessions.RevokedAll.Title"]</strong> <span>@string.Format(L["Sessions.RevokedAll.DescriptionFormat"].Value, revokedAll.RevokedTokens, revokedAll.RevokedAuthorizations)</span></div>
        </SUIAlert>
    }
</div>

<div class="table-panel" aria-labelledby="sessions-list-heading" aria-busy="@loading">
    <div class="data-toolbar data-toolbar--users">
        <div>
            <h2 id="sessions-list-heading">@L["Sessions.List.Heading"]</h2>
            <p>@FilterDescription</p>
        </div>
        <div class="data-toolbar__actions">
            <form @onsubmit="SearchAsync" @onsubmit:preventDefault>
                <SUIStack Row Wrap AlignItems="End" Spacing="2">
                    <IdentityTextField T="string"
                                       Id="session-search"
                                       InputType="search"
                                       AdornmentIcon="search"
                                       Placeholder="@L["Sessions.Search.Placeholder"].Value"
                                       aria-label="@L["Sessions.Search.VisuallyHidden"].Value"
                                       autocomplete="off"
                                       @bind-Value="search" />
                    <IdentitySelect T="string"
                                    Id="session-state-filter"
                                    Label="@L["Sessions.Filter.StateLabel"].Value"
                                    @bind-Value="stateFilter">
                        <SUISelectItem Value="@("active")">@L["Sessions.Filter.Active"]</SUISelectItem>
                        <SUISelectItem Value="@("all")">@L["Sessions.Filter.All"]</SUISelectItem>
                    </IdentitySelect>
                    <SUIButton ButtonTypeValue="SUIButtonType.Submit"
                               ColorValue="SUIColor.Secondary"
                               Disabled="@loading">
                        @L["Sessions.Apply"]
                    </SUIButton>
                </SUIStack>
            </form>
        </div>
    </div>

    <ManagementDataView Result="result"
                        Loading="loading"
                        OnRetry="LoadAsync"
                        Class="client-results"
                        LoadingLabel="@L["Sessions.LoadingAriaLabel"].Value"
                        StepUpTitle="@L["Sessions.Error.StepUp"].Value"
                        ForbiddenTitle="@L["Sessions.Error.Forbidden"].Value"
                        UnavailableTitle="@L["Sessions.Error.Generic"].Value">
        <Success Context="_">
            @if (Page.Items.Count is 0)
            {
                <SUIEmptyState Icon="clock"
                            Title="@L["Sessions.Empty.Title"].Value"
                            Description="@L["Sessions.Empty.Description"].Value" />
            }
            else
            {
                <SUITable TItem="ManagementSessionSummary"
                          Items="Page.Items"
                          RowKey="session => session.Id"
                          Hover="true"
                          StackOnMobile="true">
                    <HeaderContent>
                        <SUITh>@L["Sessions.Column.UserApplication"]</SUITh>
                        <SUITh>@L["Sessions.Column.Client"]</SUITh>
                        <SUITh>@L["Sessions.Column.Type"]</SUITh>
                        <SUITh>@L["Sessions.Column.IssuedExpires"]</SUITh>
                        <SUITh>@L["Sessions.Column.State"]</SUITh>
                        <SUITh><span class="visually-hidden">@L["Sessions.Column.Actions"]</span></SUITh>
                    </HeaderContent>
                    <RowTemplate Context="session">
                        <SUITd DataLabel="@L["Sessions.Column.UserApplication"].Value">
                            @if (HasHumanUser(session))
                            {
                                <a class="client-name" href="@UserHref(session.UserId!)">@UserLabel(session)</a>
                            }
                            else if (session.ClientApplicationId is not null)
                            {
                                <a class="client-name" href="@ClientHref(session.ClientApplicationId)">
                                    @ClientLabel(session)
                                </a>
                            }
                            else
                            {
                                <span>@L["Sessions.TechnicalClientNoApp"]</span>
                            }
                        </SUITd>
                        <SUITd DataLabel="@L["Sessions.Column.Client"].Value">
                            <span class="scope-identity">
                                <strong>@(session.ClientDisplayName ?? session.ClientId ?? L["Sessions.NoClient"].Value)</strong>
                                @if (session.ClientId is not null)
                                {
                                    <code>@session.ClientId</code>
                                }
                            </span>
                        </SUITd>
                        <SUITd DataLabel="@L["Sessions.Column.Type"].Value"><code class="client-id">@TypeLabel(session.Type)</code></SUITd>
                        <SUITd DataLabel="@L["Sessions.Column.IssuedExpires"].Value">
                            <span class="scope-identity">
                                <strong>@DateLabel(session.CreatedAt)</strong>
                                <code>@L["Sessions.ExpiresPrefix"] @DateLabel(session.ExpiresAt)</code>
                            </span>
                        </SUITd>
                        <SUITd DataLabel="@L["Sessions.Column.State"].Value">
                            <SUIStatusBadge ToneValue="@(session.IsActive ? SUITone.Success : SUITone.Neutral)">
                                @StatusLabel(session.Status)
                            </SUIStatusBadge>
                        </SUITd>
                        <SUITd DataLabel="@L["Sessions.Column.Actions"].Value">
                            @if (session.IsActive)
                            {
                                <SUIButton VariantValue="SUIVariant.Text"
                                           ColorValue="SUIColor.Primary"
                                           SizeValue="SUISize.Small"
                                           EndIcon="lock"
                                           OnClick="() => SelectForRevocation(session)">
                                    @L["Sessions.RevokeAction"]
                                </SUIButton>
                            }
                        </SUITd>
                    </RowTemplate>
                </SUITable>
            }
        </Success>
    </ManagementDataView>

    <footer class="table-footer table-footer--paginated">
        @if (result?.IsSuccess is true)
        {
            <SUIPagination TotalItems="Page.TotalCount"
                           PageSize="Page.PageSize"
                           PageIndex="@(Page.Page - 1)"
                           PageIndexChanged="GoToPageAsync"
                           Disabled="loading"
                           AriaLabel="@L["Sessions.PaginationAriaLabel"].Value"
                           PreviousLabel="@L["Sessions.Previous"].Value"
                           NextLabel="@L["Sessions.Next"].Value"
                           PageLabel="@((current, count) => string.Format(L["Sessions.PageOfFormat"].Value, current, count))"
                           RangeFormatter="@((first, last, total) => string.Format(L["Sessions.RangeFormat"].Value, first, last, total))"
                           EmptyText="@string.Format(L["Sessions.ResultCount.Format"].Value, 0)" />
        }
        else
        {
            <span>@ResultCountLabel</span>
        }
    </footer>
</div>

@if (selected is not null)
{
    <div class="delete-zone" aria-labelledby="revoke-session-heading">
        <div>
            <h2 id="revoke-session-heading">@L["Sessions.RevokeConfirm.Heading"]</h2>
            <p>@PrincipalLabel(selected) · @TypeLabel(selected.Type) · @L["Sessions.RevokeConfirm.IssuedAt"] @DateLabel(selected.CreatedAt).</p>
        </div>
        @if (revocation?.IsSuccess is false)
        {
            <SUIAlert ToneValue="SUITone.Danger" Icon="alert">
                <div><strong>@L["Sessions.RevokeConfirm.ErrorTitle"]</strong> <span>@revocation.ErrorMessage</span></div>
            </SUIAlert>
        }
        <SUIButton ColorValue="SUIColor.Secondary" OnClick="CancelRevocation">@L["Sessions.Cancel"]</SUIButton>
        <SUILoadingButton ColorValue="SUIColor.Error"
                          StartIcon="lock"
                          IsLoading="@revoking"
                          OnClick="RevokeAsync">
            @(revoking ? L["Sessions.Revoking"] : L["Sessions.ConfirmRevocation"])
        </SUILoadingButton>
    </div>
}

@if (!string.IsNullOrWhiteSpace(UserId))
{
    <div class="danger-zone" aria-labelledby="revoke-all-heading">
        <div>
            <h2 id="revoke-all-heading">@L["Sessions.RevokeAll.Heading"]</h2>
            <p>@L["Sessions.RevokeAll.Description"]</p>
        </div>
        <SUIStack Spacing="2">
            <SUICheckbox Id="revoke-all-confirmation"
                         Label="@L["Sessions.RevokeAll.ConfirmLabel"].Value"
                         @bind-Value="revokeAllConfirmed" />
            <SUILoadingButton ColorValue="SUIColor.Error"
                              StartIcon="lock"
                              IsLoading="@revokingAll"
                              Disabled="@(!revokeAllConfirmed)"
                              OnClick="RevokeAllAsync">
                @(revokingAll ? L["Sessions.RevokeAll.Ending"] : L["Sessions.RevokeAll.EndAll"])
            </SUILoadingButton>
        </SUIStack>
    </div>
}

@code {
    // The reader's zone once the browser answers (BrowserTimeProvider in the layout).
    [CascadingParameter]
    private BrowserTime Time { get; set; } = BrowserTime.Server;

    [SupplyParameterFromQuery(Name = "user")]
    public string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "client")]
    public string? ClientId { get; set; }

    private ManagementDataResult<ManagementSessionPage>? result;
    private ManagementDataResult<bool>? revocation;
    private ManagementSessionSummary? selected;
    private ManagementUserSessionRevocation? revokedAll;
    private string search = string.Empty;
    private string stateFilter = "active";
    private int currentPage = 1;
    private bool loading = true;
    private bool revoking;
    private bool revokingAll;
    private bool revokeAllConfirmed;
    private bool revoked;
    private const int PageSize = 25;

    private ManagementSessionPage Page =>
        result?.Value ?? new([], 1, PageSize, 0, UserId, ClientId, true);

    private int TotalPages =>
        Math.Max(1, (int)Math.Ceiling(Page.TotalCount / (double)Page.PageSize));

    private string FilterDescription =>
        UserId is not null
            ? string.Format(L["Sessions.FilterDescription.ByAccountFormat"].Value, UserId)
            : ClientId is not null
                ? string.Format(L["Sessions.FilterDescription.ByClientFormat"].Value, ClientId)
                : L["Sessions.FilterDescription.Default"].Value;

    private string ResultCountLabel =>
        loading
            ? L["Sessions.ResultCount.Loading"].Value
            : L["Sessions.ResultCount.NoneLoaded"].Value;

    protected override async Task OnParametersSetAsync()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        result = await SessionData.SearchAsync(
            new ManagementSessionSearch(
                search,
                UserId,
                ClientId,
                stateFilter == "active",
                currentPage,
                PageSize));
        loading = false;
    }

    private async Task SearchAsync()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task GoToPageAsync(int pageIndex)
    {
        currentPage = Math.Clamp(pageIndex + 1, 1, TotalPages);
        await LoadAsync();
    }

    private void SelectForRevocation(ManagementSessionSummary session)
    {
        selected = session;
        revocation = null;
        revoked = false;
    }

    private void CancelRevocation()
    {
        selected = null;
        revocation = null;
    }

    private async Task RevokeAsync()
    {
        if (selected is null || revoking)
        {
            return;
        }

        revoking = true;
        revocation = await SessionData.RevokeAsync(selected.Id);
        revoking = false;
        if (revocation.IsSuccess)
        {
            selected = null;
            revoked = true;
            await LoadAsync();
        }
    }

    private async Task RevokeAllAsync()
    {
        if (string.IsNullOrWhiteSpace(UserId)
            || !revokeAllConfirmed
            || revokingAll)
        {
            return;
        }

        revokingAll = true;
        var response = await SessionData.RevokeAllForUserAsync(UserId);
        revokingAll = false;
        if (response.IsSuccess)
        {
            revokedAll = response.Value;
            revokeAllConfirmed = false;
            await LoadAsync();
        }
    }

    private static bool HasHumanUser(ManagementSessionSummary session) =>
        session.UserId is not null
        && (session.UserName is not null || session.Email is not null);

    private string UserLabel(ManagementSessionSummary session) =>
        session.UserName ?? session.Email ?? session.UserId ?? L["Sessions.NoUser"].Value;

    private static string UserHref(string id) =>
        $"users/{Uri.EscapeDataString(id)}";

    private string ClientLabel(ManagementSessionSummary session) =>
        session.ClientDisplayName ?? session.ClientId ?? L["Sessions.Application"].Value;

    private static string ClientHref(string id) =>
        $"clients/{Uri.EscapeDataString(id)}";

    private string PrincipalLabel(ManagementSessionSummary session) =>
        HasHumanUser(session) ? UserLabel(session) : ClientLabel(session);

    private static string TypeLabel(string value) =>
        value.Replace('_', ' ');

    private string StatusLabel(string value) =>
        value switch
        {
            "valid" => L["Sessions.Status.Active"].Value,
            "revoked" => L["Sessions.Status.Revoked"].Value,
            "redeemed" => L["Sessions.Status.Used"].Value,
            _ => value
        };

    private string DateLabel(DateTimeOffset? value) =>
        Time.Format(value) ?? L["Sessions.NoExpiration"].Value;
}
