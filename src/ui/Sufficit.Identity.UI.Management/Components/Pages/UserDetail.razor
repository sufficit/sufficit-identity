@page "/users/{Id}"
@attribute [Authorize(Policy = ManagementUiPolicies.Access)]
@inject ManagementUserDataSource UserData
@inject NavigationManager Navigation

@{ var user = result?.Value!; var currentlyLocked = IsLockedOut(user); }

<PageTitle>@PageTitleText</PageTitle>

<SUIPageHeader Title="@HeaderTitle"
            Description="@L["Users.Detail.HeaderDescription"].Value">
    <Actions>
        <a class="button button--secondary" href="@BackHref">
            <SUIIcon Name="arrow-left" Size="17" />
            @L["Users.Detail.BackToUsers"]
        </a>
        <AuthorizeView Policy="@ManagementUiPolicies.ManageClaims">
            <Authorized>
                <a class="button button--secondary" href="@ClaimsHref">
                    <SUIIcon Name="shield" Size="17" />
                    @L["Users.Detail.ClaimsLink"]
                </a>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@ManagementUiPolicies.ManageSessions">
            <Authorized>
                <a class="button button--secondary" href="@SessionsHref">
                    <SUIIcon Name="clock" Size="17" />
                    @L["Users.Detail.SessionsLink"]
                </a>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@ManagementUiPolicies.ManageAuthorizations">
            <Authorized>
                <a class="button button--secondary" href="@AuthorizationsHref">
                    <SUIIcon Name="shield" Size="17" />
                    @L["Users.Detail.AuthorizationsLink"]
                </a>
            </Authorized>
        </AuthorizeView>
        @if (result?.Value?.Actions.CanUpdateProfile is true)
        {
            <a class="button button--primary" href="@EditHref">
                <SUIIcon Name="edit" Size="17" />
                @L["Users.Detail.EditProfileLink"]
            </a>
        }
    </Actions>
</SUIPageHeader>

@if (Created)
{
    <div class="inline-notice inline-notice--success" role="status">
        <SUIIcon Name="check" Size="19" />
        <div>
            <strong>@L["Users.Detail.Created.Title"]</strong>
            <span>@L["Users.Detail.Created.Description"]</span>
        </div>
    </div>
}

@if (Updated)
{
    <div class="inline-notice inline-notice--success" role="status">
        <SUIIcon Name="check" Size="19" />
        <div>
            <strong>@L["Users.Detail.Updated.Title"]</strong>
            <span>@L["Users.Detail.Updated.Description"]</span>
        </div>
    </div>
}

@if (passwordResetSucceeded)
{
    <div class="inline-notice inline-notice--success" role="status">
        <SUIIcon Name="check" Size="19" />
        <div>
            <strong>@L["Users.Detail.PasswordReset.Title"]</strong>
            <span>@L["Users.Detail.PasswordReset.Description"]</span>
        </div>
    </div>
}

@if (lockoutChangeSucceeded)
{
    <div class="inline-notice inline-notice--success" role="status">
        <SUIIcon Name="check" Size="19" />
        <div>
            <strong>@(lastLockoutState is true ? L["Users.Detail.LockoutChanged.LockedTitle"] : L["Users.Detail.LockoutChanged.UnlockedTitle"])</strong>
            <span>
                @(lastLockoutState is true
                    ? L["Users.Detail.LockoutChanged.LockedDescription"]
                    : L["Users.Detail.LockoutChanged.UnlockedDescription"])
            </span>
        </div>
    </div>
}

@if (loading)
{
    <div class="detail-shell" aria-busy="true" aria-label="@L["Users.Detail.LoadingAriaLabel"].Value">
        <div class="detail-skeleton"></div>
        <div class="detail-skeleton detail-skeleton--short"></div>
    </div>
}
else if (result?.IsSuccess is true && result.Value is not null)
{
    <div class="detail-shell">
        <div class="detail-summary detail-summary--users">
            <div>
                <span class="detail-label">@L["Users.Detail.Field.UserName"]</span>
                <strong class="detail-value">@Display(user.UserName)</strong>
            </div>
            <div>
                <span class="detail-label">@L["Users.Detail.Field.Email"]</span>
                <span class="detail-value">@Display(user.Email)</span>
            </div>
            <div>
                <span class="detail-label">@L["Users.Detail.Field.Confirmation"]</span>
                <SUIStatusBadge ToneValue="@(user.EmailConfirmed ? SUITone.Success : SUITone.Neutral)">
                    @(user.EmailConfirmed ? L["Users.Detail.EmailConfirmedYes"] : L["Users.Detail.EmailConfirmedPending"])
                </SUIStatusBadge>
            </div>
            <div>
                <span class="detail-label">@L["Users.Detail.Field.Id"]</span>
                <code class="detail-value detail-value--code">@user.Id</code>
            </div>
        </div>

        <div class="detail-columns detail-columns--users">
            <div aria-labelledby="user-security-heading">
                <h2 id="user-security-heading">@L["Users.Detail.Security.Heading"]</h2>
                <dl class="property-list">
                    <div>
                        <dt>@L["Users.Detail.Security.Mfa"]</dt>
                        <dd>
                            <SUIStatusBadge ToneValue="@(user.TwoFactorEnabled ? SUITone.Success : SUITone.Neutral)">
                                @(user.TwoFactorEnabled ? L["Users.Detail.Security.MfaActive"] : L["Users.Detail.Security.MfaInactive"])
                            </SUIStatusBadge>
                        </dd>
                    </div>
                    <div>
                        <dt>@L["Users.Detail.Security.Lockout"]</dt>
                        <dd>@LockoutLabel(user)</dd>
                    </div>
                    <div>
                        <dt>@L["Users.Detail.Security.AccessFailures"]</dt>
                        <dd>@user.AccessFailedCount</dd>
                    </div>
                    <div>
                        <dt>@L["Users.Detail.Security.Phone"]</dt>
                        <dd>@Display(user.PhoneNumber)</dd>
                    </div>
                </dl>
            </div>

            <div aria-labelledby="user-state-heading">
                <h2 id="user-state-heading">@L["Users.Detail.States.Heading"]</h2>
                <dl class="property-list">
                    <div>
                        <dt>@L["Users.Detail.States.EmailVerified"]</dt>
                        <dd>@(user.EmailConfirmed ? L["Users.Detail.Common.Yes"] : L["Users.Detail.Common.No"])</dd>
                    </div>
                    <div>
                        <dt>@L["Users.Detail.States.PhoneVerified"]</dt>
                        <dd>@(user.PhoneNumberConfirmed ? L["Users.Detail.Common.Yes"] : L["Users.Detail.Common.No"])</dd>
                    </div>
                    <div>
                        <dt>@L["Users.Detail.States.LockoutEnabled"]</dt>
                        <dd>@(user.LockoutEnabled ? L["Users.Detail.Common.Yes"] : L["Users.Detail.Common.No"])</dd>
                    </div>
                    <div>
                        <dt>@L["Users.Detail.States.LastUpdated"]</dt>
                        <dd>@user.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                    </div>
                </dl>
            </div>
        </div>

        <div class="requirements-line" aria-labelledby="user-audit-heading">
            <div>
                <h2 id="user-audit-heading">@L["Users.Detail.Audit.Heading"]</h2>
                <p>@L["Users.Detail.Audit.Description"]</p>
            </div>
            <SUIStatusBadge ToneValue="SUITone.Success" Icon="audit">@L["Users.Detail.Audit.Badge"]</SUIStatusBadge>
        </div>
    </div>

    <UserMfaResetPanel User="user" UserChanged="OnMfaReset" />

    @if (user.Actions.CanSetLockout)
    {
        <div class="account-access-panel @(currentlyLocked ? "account-access-panel--restore" : "account-access-panel--restrict")"
                 aria-labelledby="account-access-heading">
            <div class="account-access-panel__heading">
                <div class="account-access-panel__icon">
                    <SUIIcon Name="@(currentlyLocked ? "refresh" : "lock")" Size="20" />
                </div>
                <div>
                    <h2 id="account-access-heading">
                        @(currentlyLocked ? L["Users.Detail.Access.UnlockHeading"] : L["Users.Detail.Access.LockHeading"])
                    </h2>
                    <p>
                        @(currentlyLocked
                            ? L["Users.Detail.Access.UnlockDescription"]
                            : L["Users.Detail.Access.LockDescription"])
                    </p>
                </div>
                <SUIStatusBadge ToneValue="@(currentlyLocked ? SUITone.Warning : SUITone.Danger)">
                    @(currentlyLocked ? L["Users.Detail.Access.LockedBadge"] : L["Users.Detail.Access.ActiveBadge"])
                </SUIStatusBadge>
            </div>

            @if (lockoutResult?.IsSuccess is false)
            {
                <div class="inline-notice inline-notice--danger" role="alert">
                    <SUIIcon Name="alert" Size="19" />
                    <div>
                        <strong>@LockoutErrorTitle</strong>
                        <span>@lockoutResult.ErrorMessage</span>
                    </div>
                </div>
            }

            @if (!currentlyLocked)
            {
                <label class="account-access-confirmation" for="confirm-account-lockout">
                    <input id="confirm-account-lockout"
                           type="checkbox"
                           @bind="lockoutConfirmed" />
                    <span>
                        <strong>@L["Users.Detail.Access.ConfirmLabel"]</strong>
                        <small>@L["Users.Detail.Access.ConfirmHint"]</small>
                    </span>
                </label>
            }

            <div class="account-access-panel__actions">
                <span>@L["Users.Detail.Access.ActionNote"]</span>
                <button class="button @(currentlyLocked ? "button--secondary" : "button--danger")"
                        type="button"
                        disabled="@(changingLockout || (!currentlyLocked && !lockoutConfirmed))"
                        @onclick="() => SetLockoutAsync(!currentlyLocked)">
                    @if (changingLockout)
                    {
                        <span class="button-spinner" aria-hidden="true"></span>
                        <span>@(currentlyLocked ? L["Users.Detail.Access.Unlocking"] : L["Users.Detail.Access.Locking"])</span>
                    }
                    else
                    {
                        <SUIIcon Name="@(currentlyLocked ? "refresh" : "lock")" Size="17" />
                        <span>@(currentlyLocked ? L["Users.Detail.Access.UnlockButton"] : L["Users.Detail.Access.LockButton"])</span>
                    }
                </button>
            </div>
        </div>
    }
    else if (user.Actions.SetLockoutRequiresMfa)
    {
        <div class="decision-note decision-note--neutral">
            <SUIIcon Name="shield" Size="21" />
            <div>
                <h2>@L["Users.Detail.Access.MfaRequiredTitle"]</h2>
                <p>@L["Users.Detail.MfaRequiredDescription"]</p>
            </div>
        </div>
    }
    else if (user.Actions.SetLockoutReasonCode is "user_self_lockout_not_allowed")
    {
        <div class="decision-note decision-note--neutral">
            <SUIIcon Name="shield" Size="21" />
            <div>
                <h2>@L["Users.Detail.Access.SelfProtectedTitle"]</h2>
                <p>@L["Users.Detail.Access.SelfProtectedDescription"]</p>
            </div>
        </div>
    }
    else
    {
        <div class="decision-note decision-note--neutral">
            <SUIIcon Name="lock" Size="21" />
            <div>
                <h2>@L["Users.Detail.Access.ForbiddenTitle"]</h2>
                <p>@L["Users.Detail.Access.ForbiddenDescription"]</p>
            </div>
        </div>
    }

    @if (user.Actions.CanResetPassword)
    {
        <EditForm Model="passwordModel"
                  OnValidSubmit="ResetPasswordAsync"
                  FormName="reset-management-user-password"
                  class="credential-panel">
            <DataAnnotationsValidator />
            <div class="credential-panel__heading">
                <div class="credential-panel__icon">
                    <SUIIcon Name="key" Size="20" />
                </div>
                <div>
                    <h2>@L["Users.Detail.Reset.Title"]</h2>
                    <p>@L["Users.Detail.Reset.Description"]</p>
                </div>
                <SUIStatusBadge ToneValue="SUITone.Info">@L["Users.Detail.Reset.Badge"]</SUIStatusBadge>
            </div>

            @if (resetResult?.IsSuccess is false)
            {
                <div class="inline-notice inline-notice--danger" role="alert">
                    <SUIIcon Name="alert" Size="19" />
                    <div>
                        <strong>@ResetErrorTitle</strong>
                        <span>@resetResult.ErrorMessage</span>
                    </div>
                </div>
            }

            <div class="form-grid form-grid--two credential-panel__fields">
                <div class="field-group">
                    <label for="new-password">@L["Users.Detail.Reset.Field.NewPassword"]</label>
                    <InputText id="new-password"
                               class="form-control"
                               type="password"
                               autocomplete="new-password"
                               @bind-Value="passwordModel.NewPassword" />
                    <ValidationMessage For="() => passwordModel.NewPassword" />
                    @if (resetResult?.ErrorField is "newPassword")
                    {
                        <p class="validation-message">@resetResult.ErrorMessage</p>
                    }
                </div>
                <div class="field-group">
                    <label for="confirm-new-password">@L["Users.Detail.Reset.Field.ConfirmPassword"]</label>
                    <InputText id="confirm-new-password"
                               class="form-control"
                               type="password"
                               autocomplete="new-password"
                               @bind-Value="passwordModel.ConfirmPassword" />
                    <ValidationMessage For="() => passwordModel.ConfirmPassword" />
                </div>
            </div>

            <div class="credential-panel__actions">
                <span>@L["Users.Detail.Reset.PolicyNote"]</span>
                <button class="button button--primary"
                        type="submit"
                        disabled="@resettingPassword">
                    @if (resettingPassword)
                    {
                        <span class="button-spinner" aria-hidden="true"></span>
                        <span>@L["Users.Detail.Reset.Submitting"]</span>
                    }
                    else
                    {
                        <SUIIcon Name="key" Size="17" />
                        <span>@L["Users.Detail.Reset.Title"]</span>
                    }
                </button>
            </div>
        </EditForm>
    }
    else if (user.Actions.ResetPasswordRequiresMfa)
    {
        <div class="decision-note decision-note--neutral">
            <SUIIcon Name="shield" Size="21" />
            <div>
                <h2>@L["Users.Detail.Reset.MfaRequiredTitle"]</h2>
                <p>@L["Users.Detail.MfaRequiredDescription"]</p>
            </div>
        </div>
    }
    else
    {
        <div class="decision-note decision-note--neutral">
            <SUIIcon Name="lock" Size="21" />
            <div>
                <h2>@L["Users.Detail.Reset.ForbiddenTitle"]</h2>
                <p>@L["Users.Detail.Reset.ForbiddenDescription"]</p>
            </div>
        </div>
    }

    @if (user.Actions.CanDelete)
    {
        <div class="delete-zone" aria-labelledby="delete-user-heading">
            <div>
                <h2 id="delete-user-heading">@L["Users.Detail.Delete.Heading"]</h2>
                <p>@L["Users.Detail.Delete.Description"]</p>
            </div>

            <div class="delete-confirmation">
                <label for="delete-user-confirmation">
                    @L["Users.Detail.Delete.ConfirmLabelPrefix"] <strong>@DeletionConfirmationValue</strong> @L["Users.Detail.Delete.ConfirmLabelSuffix"]
                </label>
                <input id="delete-user-confirmation"
                       class="form-control"
                       type="text"
                       autocomplete="off"
                       spellcheck="false"
                       aria-describedby="delete-user-help"
                       @bind="deleteConfirmation"
                       @bind:event="oninput" />
                <small id="delete-user-help">@L["Users.Detail.Delete.Help"]</small>
            </div>

            <button class="button button--danger"
                    type="button"
                    disabled="@(!CanSubmitDeletion)"
                    @onclick="DeleteAsync">
                @if (deleting)
                {
                    <span class="button-spinner" aria-hidden="true"></span>
                    <span>@L["Users.Detail.Delete.Submitting"]</span>
                }
                else
                {
                    <SUIIcon Name="trash" Size="17" />
                    <span>@L["Users.Detail.Delete.Submit"]</span>
                }
            </button>

            @if (deleteResult?.IsSuccess is false)
            {
                <div class="inline-notice inline-notice--danger" role="alert">
                    <SUIIcon Name="alert" Size="19" />
                    <div>
                        <strong>@DeleteErrorTitle</strong>
                        <span>@deleteResult.ErrorMessage</span>
                    </div>
                </div>
            }
        </div>
    }
    else if (user.Actions.DeleteRequiresMfa)
    {
        <div class="decision-note decision-note--neutral">
            <SUIIcon Name="shield" Size="21" />
            <div>
                <h2>@L["Users.Detail.Delete.MfaRequiredTitle"]</h2>
                <p>@L["Users.Detail.Delete.MfaRequiredDescription"]</p>
            </div>
        </div>
    }
    else if (user.Actions.DeleteReasonCode is "user_self_delete_not_allowed")
    {
        <div class="decision-note decision-note--neutral">
            <SUIIcon Name="shield" Size="21" />
            <div>
                <h2>@L["Users.Detail.Delete.SelfTitle"]</h2>
                <p>@L["Users.Detail.Delete.SelfDescription"]</p>
            </div>
        </div>
    }
}
else
{
    <div>
        <SUIEmptyState Icon="alert"
                    Title="@ErrorTitle"
                    Description="@ErrorDescription">
            <Actions>
                <a class="button button--secondary" href="@BackHref">@L["Users.Detail.BackToUsers"]</a>
                @if (result?.Outcome is ManagementDataOutcome.Unavailable)
                {
                    <button class="button button--primary"
                            type="button"
                            @onclick="LoadAsync">
                        @L["Users.Detail.Retry"]
                    </button>
                }
            </Actions>
        </SUIEmptyState>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "created")]
    public int CreatedFlag { get; set; }

    [SupplyParameterFromQuery(Name = "updated")]
    public int UpdatedFlag { get; set; }

    private ManagementDataResult<ManagementUserDetail>? result;
    private ManagementDataResult<ManagementUserDetail>? resetResult;
    private ManagementDataResult<ManagementUserDetail>? lockoutResult;
    private ManagementDataResult<bool>? deleteResult;
    private readonly PasswordResetModel passwordModel = new();
    private bool loading = true;
    private bool resettingPassword;
    private bool changingLockout;
    private bool passwordResetSucceeded;
    private bool lockoutChangeSucceeded;
    private bool deleting;
    private bool? lastLockoutState;
    private bool lockoutConfirmed;
    private string deleteConfirmation = string.Empty;

    private bool Created => CreatedFlag is 1;

    private bool Updated => UpdatedFlag is 1;

    private string HeaderTitle =>
        result?.Value?.UserName
        ?? result?.Value?.Email
        ?? L["Users.Detail.HeaderTitleDefault"].Value;

    private string PageTitleText =>
        string.Format(L["Users.Detail.PageTitleFormat"].Value, HeaderTitle);

    private const string BackHref = "users";

    private string EditHref =>
        $"users/{Uri.EscapeDataString(Id)}/edit";

    private string ClaimsHref =>
        $"claims?user={Uri.EscapeDataString(Id)}";

    private string SessionsHref =>
        $"sessions?user={Uri.EscapeDataString(Id)}";

    private string AuthorizationsHref =>
        $"authorizations?user={Uri.EscapeDataString(Id)}";

    private string ErrorTitle =>
        result?.Outcome is ManagementDataOutcome.NotFound
            ? L["Users.Detail.Error.NotFound"].Value
            : result?.Outcome is ManagementDataOutcome.StepUpRequired
                ? L["Users.Detail.Error.StepUp"].Value
                : result?.Outcome is ManagementDataOutcome.Forbidden
                    ? L["Users.Detail.Error.Forbidden"].Value
                    : L["Users.Detail.Error.Generic"].Value;

    private string ErrorDescription =>
        result?.ErrorMessage
        ?? L["Users.Detail.Error.GenericDescription"].Value;

    private string ResetErrorTitle =>
        resetResult?.Outcome is ManagementDataOutcome.StepUpRequired
            ? L["Users.Detail.Reset.Error.StepUp"].Value
            : resetResult?.Outcome is ManagementDataOutcome.Forbidden
                ? L["Users.Detail.Error.InsufficientAuthority"].Value
                : L["Users.Detail.Reset.Error.Generic"].Value;

    private string LockoutErrorTitle =>
        lockoutResult?.Outcome is ManagementDataOutcome.StepUpRequired
            ? L["Users.Detail.Access.Error.StepUp"].Value
            : lockoutResult?.Outcome is ManagementDataOutcome.Forbidden
                ? L["Users.Detail.Error.InsufficientAuthority"].Value
                : L["Users.Detail.Access.Error.Generic"].Value;

    private string DeleteErrorTitle =>
        deleteResult?.Outcome is ManagementDataOutcome.StepUpRequired
            ? L["Users.Detail.Delete.Error.StepUp"].Value
            : deleteResult?.Outcome is ManagementDataOutcome.Forbidden
                ? L["Users.Detail.Delete.Error.Forbidden"].Value
                : deleteResult?.Outcome is ManagementDataOutcome.NotFound
                    ? L["Users.Detail.Delete.Error.NotFound"].Value
                    : L["Users.Detail.Delete.Error.Generic"].Value;

    private string DeletionConfirmationValue =>
        result?.Value?.UserName
        ?? result?.Value?.Email
        ?? Id;

    private bool CanSubmitDeletion =>
        !deleting
        && string.Equals(
            deleteConfirmation.Trim(),
            DeletionConfirmationValue,
            StringComparison.Ordinal);

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        result = await UserData.GetAsync(Id);
        loading = false;
    }

    private void OnMfaReset(ManagementUserDetail user) => result = ManagementDataResult<ManagementUserDetail>.Success(user);

    private async Task ResetPasswordAsync()
    {
        if (resettingPassword)
        {
            return;
        }

        resettingPassword = true;
        passwordResetSucceeded = false;
        resetResult = await UserData.ResetPasswordAsync(
            Id,
            new ResetManagementUserPasswordCommand(
                passwordModel.NewPassword));
        resettingPassword = false;

        if (resetResult.IsSuccess && resetResult.Value is not null)
        {
            result = resetResult;
            passwordModel.NewPassword = string.Empty;
            passwordModel.ConfirmPassword = string.Empty;
            passwordResetSucceeded = true;
        }
    }

    private async Task SetLockoutAsync(bool locked)
    {
        if (changingLockout || (locked && !lockoutConfirmed))
        {
            return;
        }

        changingLockout = true;
        lockoutChangeSucceeded = false;
        lockoutResult = await UserData.SetLockoutAsync(
            Id,
            new SetManagementUserLockoutCommand(locked));
        changingLockout = false;

        if (lockoutResult.IsSuccess && lockoutResult.Value is not null)
        {
            result = lockoutResult;
            lastLockoutState = locked;
            lockoutConfirmed = false;
            lockoutChangeSucceeded = true;
        }
    }

    private async Task DeleteAsync()
    {
        if (!CanSubmitDeletion)
        {
            return;
        }

        deleting = true;
        deleteResult = await UserData.DeleteAsync(Id);
        deleting = false;

        if (deleteResult.IsSuccess)
        {
            Navigation.NavigateTo("users?deleted=1");
        }
    }

    private string Display(string? value) =>
        string.IsNullOrWhiteSpace(value) ? L["Users.Detail.NotInformed"].Value : value;

    private string LockoutLabel(ManagementUserDetail user)
    {
        if (!user.LockoutEnabled)
        {
            return L["Users.Detail.Security.LockoutDisabled"].Value;
        }

        return user.LockoutEnd is { } end && end > DateTimeOffset.UtcNow
            ? string.Format(
                L["Users.Detail.Security.LockedUntilFormat"].Value,
                end.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
            : L["Users.Detail.Security.NoActiveLockout"].Value;
    }

    private static bool IsLockedOut(ManagementUserDetail? user) =>
        user?.LockoutEnd is { } end
        && end > DateTimeOffset.UtcNow;

    protected override void OnInitialized()
    {
        passwordModel.Localizer = L;
        base.OnInitialized();
    }

    private sealed class PasswordResetModel : IValidatableObject
    {
        public IStringLocalizer<Sufficit.Identity.UI.Management.Resources.ManagementResource>? Localizer { get; set; }

        public string NewPassword { get; set; } = string.Empty;

        public string ConfirmPassword { get; set; } = string.Empty;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            var l = Localizer ?? throw new InvalidOperationException(
                "The form model localizer must be set before validation.");

            if (string.IsNullOrWhiteSpace(NewPassword))
            {
                yield return new ValidationResult(l["Users.Detail.Validation.NewPasswordRequired"].Value, [nameof(NewPassword)]);
            }
            if (string.IsNullOrWhiteSpace(ConfirmPassword))
            {
                yield return new ValidationResult(l["Users.Detail.Validation.ConfirmNewPasswordRequired"].Value, [nameof(ConfirmPassword)]);
            }
            if (!string.Equals(NewPassword, ConfirmPassword, StringComparison.Ordinal))
            {
                yield return new ValidationResult(l["Users.Create.Validation.PasswordsDoNotMatch"].Value, [nameof(ConfirmPassword)]);
            }
        }
    }
}
