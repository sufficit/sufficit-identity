@page "/clients/registrations"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageClients)]
@attribute [StreamRendering]
@inject ManagementClientDataSource ClientData
@inject NavigationManager Navigation

<PageTitle>@L["Clients.Registrations.Title"] | Sufficit Identity</PageTitle>

<SUIPageHeader Title="@L["Clients.Registrations.Title"].Value"
            Description="@L["Clients.Registrations.Description"].Value">
    <Actions>
        <a class="button button--secondary" href="clients">
            <SUIIcon Name="key" Size="17" />
            @L["Clients.Registrations.AllApplications"]
        </a>
    </Actions>
</SUIPageHeader>

@if (!string.IsNullOrWhiteSpace(RevokedClientId))
{
    <div class="inline-notice inline-notice--success" role="status">
        <SUIIcon Name="check" Size="19" />
        <div>
            <strong>@L["Clients.Registrations.RevokedTitle"]</strong>
            <span>@L["Clients.Registrations.RevokedMessagePrefix"] <code>@RevokedClientId</code> @L["Clients.Registrations.RevokedMessageSuffix"]</span>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(RevokeError))
{
    <div class="inline-notice inline-notice--danger" role="alert">
        <SUIIcon Name="alert-triangle" Size="19" />
        <div>
            <strong>@L["Clients.Registrations.RevokeErrorTitle"]</strong>
            <span>@RevokeError</span>
        </div>
    </div>
}

<section class="table-card">
    <div class="table-card__body">
        @if (Page is null)
        {
            <div class="table-skeleton" aria-label="@L["Clients.Registrations.LoadingRegistrations"].Value">
                @for (var index = 0; index < 4; index++)
                {
                    <span></span>
                }
            </div>
        }
        else if (Page.Items.Count == 0)
        {
            <SUIEmptyState Icon="key"
                        Title="@L["Clients.Registrations.EmptyTitle"].Value"
                        Description="@L["Clients.Registrations.EmptyDescription"].Value" />
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table data-table--clients">
                    <thead>
                        <tr>
                            <th scope="col">@L["Clients.Registrations.ColumnApplication"]</th>
                            <th scope="col">Client ID</th>
                            <th scope="col">@L["Clients.Registrations.ColumnRegisteredAt"]</th>
                            <th scope="col">@L["Clients.Registrations.ColumnOrigin"]</th>
                            <th scope="col">Gate</th>
                            <th scope="col"><span class="visually-hidden">@L["Clients.Registrations.ColumnActions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var client in Page.Items)
                        {
                            <tr>
                                <td data-label="@L["Clients.Registrations.ColumnApplication"].Value">
                                    <a class="client-name client-link" href="@ClientHref(client.Id)">
                                        @(string.IsNullOrWhiteSpace(client.DisplayName)
                                            ? client.ClientId
                                            : client.DisplayName)
                                    </a>
                                </td>
                                <td data-label="Client ID">
                                    <code class="client-id">@client.ClientId</code>
                                </td>
                                <td data-label="@L["Clients.Registrations.ColumnRegisteredAt"].Value">
                                    @(client.RegisteredAtUtc is { } instant
                                        ? instant.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        : "—")
                                </td>
                                <td data-label="@L["Clients.Registrations.ColumnOrigin"].Value">
                                    <span class="registration-state">
                                        <code>@(client.RegisteredFromAddress ?? "—")</code>
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(client.RegisteredUserAgent))
                                    {
                                        <span class="registration-hint" title="@client.RegisteredUserAgent">
                                            @Truncate(client.RegisteredUserAgent!, 48)
                                        </span>
                                    }
                                </td>
                                <td data-label="Gate">
                                    <SUIStatusBadge ToneValue="@IdentitySuiTone.From(
                                        client.RegisteredAnonymously ? "warning" : "success")">
                                        @(client.RegisteredAnonymously
                                            ? L["Clients.Registrations.AnonymousMcpProfile"]
                                            : L["Clients.Registrations.InitialToken"])
                                    </SUIStatusBadge>
                                </td>
                                <td data-label="@L["Clients.Registrations.ColumnActions"].Value">
                                    <a class="row-action" href="@ClientHref(client.Id)">
                                        @L["Clients.Registrations.Details"]
                                        <SUIIcon Name="arrow-right" Size="15" />
                                    </a>
                                    <button class="row-action row-action--danger"
                                            type="button"
                                            disabled="@(RevokingClientId == client.ClientId)"
                                            @onclick="() => RevokeAsync(client.ClientId)">
                                        @(RevokingClientId == client.ClientId ? L["Clients.Registrations.Revoking"] : L["Clients.Registrations.Revoke"])
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <footer class="table-footer table-footer--paginated">
        <span aria-live="polite" aria-atomic="true">@ResultCountLabel</span>
        @if (Page is { PageCount: > 1 })
        {
            <div class="pagination">
                <button class="button button--ghost"
                        type="button"
                        disabled="@(CurrentPage <= 1)"
                        @onclick="() => GoToPageAsync(CurrentPage - 1)">
                    @L["Clients.Registrations.Previous"]
                </button>
                <span>@L["Clients.Registrations.PageOf", Page.Page, Page.PageCount]</span>
                <button class="button button--ghost"
                        type="button"
                        disabled="@(CurrentPage >= Page.PageCount)"
                        @onclick="() => GoToPageAsync(CurrentPage + 1)">
                    @L["Clients.Registrations.Next"]
                </button>
            </div>
        }
    </footer>
</section>

@code {
    private ManagementDataResult<ManagementClientPage>? result;
    private string? loadedFingerprint;

    [SupplyParameterFromQuery(Name = "page")]
    public int QueryPage { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "revoked")]
    public string? RevokedClientId { get; set; }

    private string? RevokeError { get; set; }

    private string? RevokingClientId { get; set; }

    private int CurrentPage => QueryPage < 1 ? 1 : QueryPage;

    private ManagementClientPage? Page => result?.IsSuccess is true
        ? result.Value
        : null;

    private string ResultCountLabel => Page is null
        ? L["Clients.Registrations.LoadingRegistrations"].Value
        : Page.TotalCount == 0
            ? L["Clients.Registrations.EmptyTitle"].Value
            : L["Clients.Registrations.CountFormat", Page.TotalCount].Value;

    protected override async Task OnParametersSetAsync()
    {
        var fingerprint = CurrentPage.ToString();
        if (fingerprint == loadedFingerprint)
        {
            return;
        }
        loadedFingerprint = fingerprint;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // Origin filter is applied by the management service; this console only
        // ever shows self-registered clients.
        result = await ClientData.SearchClientsAsync(new ManagementClientQuery(
            Search: null,
            Type: "all",
            Grant: "all",
            Scope: null,
            Origin: "dcr",
            Status: "all",
            Page: CurrentPage,
            PageSize: 25));
    }

    private async Task GoToPageAsync(int target)
    {
        Navigation.NavigateTo($"clients/registrations?page={target}");
        await Task.CompletedTask;
    }

    private async Task RevokeAsync(string clientId)
    {
        RevokeError = null;
        RevokingClientId = clientId;
        var outcome = await ClientData.DeleteClientAsync(clientId);
        RevokingClientId = null;
        if (outcome.IsSuccess)
        {
            Navigation.NavigateTo(
                $"clients/registrations?revoked={Uri.EscapeDataString(clientId)}",
                forceLoad: false);
            loadedFingerprint = null;
            await LoadAsync();
            return;
        }

        RevokeError = outcome.ErrorMessage
            ?? L["Clients.Registrations.RevokeGenericError"].Value;
    }

    private static string ClientHref(string id) => $"clients/{id}";

    private static string Truncate(string value, int length) =>
        value.Length <= length ? value : value[..length] + "…";
}
