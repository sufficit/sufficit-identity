@page "/clients/registrations"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageClients)]
@attribute [StreamRendering]
@inject ManagementClientDataSource ClientData
@inject NavigationManager Navigation

<PageTitle>@L["Clients.Registrations.Title"] | Sufficit Identity</PageTitle>

<SUIPageHeader Title="@L["Clients.Registrations.Title"].Value"
            Description="@L["Clients.Registrations.Description"].Value">
    <Actions>
        <SUIButton Href="clients" VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" StartIcon="key">
            @L["Clients.Registrations.AllApplications"]
        </SUIButton>
    </Actions>
</SUIPageHeader>

@if (!string.IsNullOrWhiteSpace(RevokedClientId))
{
    <SUIAlert ToneValue="SUITone.Success" Icon="check" role="status">
        <div>
            <strong>@L["Clients.Registrations.RevokedTitle"]</strong>
            <span>@L["Clients.Registrations.RevokedMessagePrefix"] <code>@RevokedClientId</code> @L["Clients.Registrations.RevokedMessageSuffix"]</span>
        </div>
    </SUIAlert>
}

@if (!string.IsNullOrWhiteSpace(RevokeError))
{
    <SUIAlert ToneValue="SUITone.Danger" Icon="warning">
        <div>
            <strong>@L["Clients.Registrations.RevokeErrorTitle"]</strong>
            <span>@RevokeError</span>
        </div>
    </SUIAlert>
}

<RegistrationTokenPanel />

<SUISection Title="@L["Clients.Registrations.ListTitle"].Value">
    <div>
        <ManagementDataView Result="result"
                            OnRetry="LoadAsync"
                            LoadingLabel="@L["Clients.Registrations.LoadingRegistrations"].Value">
            <Success Context="loadedPage">
        @if (loadedPage.Items.Count == 0)
        {
            <SUIEmptyState Icon="key"
                        Title="@L["Clients.Registrations.EmptyTitle"].Value"
                        Description="@L["Clients.Registrations.EmptyDescription"].Value" />
        }
        else
        {
            <SUITable TItem="ManagementClientSummary"
                      Items="loadedPage.Items"
                      RowKey="client => client.Id"
                      StackOnMobile="true"
                      ColumnCount="6">
                <HeaderContent>
                    <SUITh>@L["Clients.Registrations.ColumnApplication"]</SUITh>
                    <SUITh>Client ID</SUITh>
                    <SUITh>@L["Clients.Registrations.ColumnRegisteredAt"]</SUITh>
                    <SUITh>@L["Clients.Registrations.ColumnOrigin"]</SUITh>
                    <SUITh>Gate</SUITh>
                    <SUITh><span class="visually-hidden">@L["Clients.Registrations.ColumnActions"]</span></SUITh>
                </HeaderContent>
                <RowTemplate Context="client">
                    <SUITd DataLabel="@L["Clients.Registrations.ColumnApplication"].Value">
                        <a class="client-name client-link" href="@ClientHref(client.Id)">
                            @(string.IsNullOrWhiteSpace(client.DisplayName)
                                ? client.ClientId
                                : client.DisplayName)
                        </a>
                        @if (client.Status == "disabled")
                        {
                            <SUIStatusBadge ToneValue="SUITone.Danger">@L["Clients.State.Disabled"]</SUIStatusBadge>
                        }
                    </SUITd>
                    <SUITd DataLabel="Client ID">
                        <code class="client-id">@client.ClientId</code>
                    </SUITd>
                    <SUITd DataLabel="@L["Clients.Registrations.ColumnRegisteredAt"].Value">
                        @(client.RegisteredAtUtc is { } instant
                            ? Time.Format(instant)
                            : "—")
                    </SUITd>
                    <SUITd DataLabel="@L["Clients.Registrations.ColumnOrigin"].Value">
                        <span class="registration-state">
                            <code>@(client.RegisteredFromAddress ?? "—")</code>
                        </span>
                        @if (!string.IsNullOrWhiteSpace(client.RegisteredUserAgent))
                        {
                            <SUITooltip Text="@client.RegisteredUserAgent">
                                <span class="registration-hint">@Truncate(client.RegisteredUserAgent!, 48)</span>
                            </SUITooltip>
                        }
                    </SUITd>
                    <SUITd DataLabel="Gate">
                        <SUIStatusBadge ToneValue="@IdentitySuiTone.From(
                            client.RegisteredAnonymously ? "warning" : "success")">
                            @(client.RegisteredAnonymously
                                ? L["Clients.Registrations.AnonymousMcpProfile"]
                                : L["Clients.Registrations.InitialToken"])
                        </SUIStatusBadge>
                    </SUITd>
                    <SUITd DataLabel="@L["Clients.Registrations.ColumnActions"].Value">
                        <SUIStack Row="true" AlignItems="Center" Justify="End" Spacing="2" Wrap="false">
                            <SUIButton Href="@ClientHref(client.Id)"
                                       VariantValue="SUIVariant.Text"
                                       SizeValue="SUISize.Small"
                                       EndIcon="arrow-right">
                                @L["Clients.Registrations.Details"]
                            </SUIButton>
                            <SUILoadingButton VariantValue="SUIVariant.Text"
                                              ColorValue="SUIColor.Error"
                                              SizeValue="SUISize.Small"
                                              IsLoading="@(RevokingClientId == client.ClientId)"
                                              Disabled="@(RevokingClientId == client.ClientId)"
                                              OnClick="() => RevokeAsync(client.ClientId)">
                                @(RevokingClientId == client.ClientId ? L["Clients.Registrations.Revoking"] : L["Clients.Registrations.Revoke"])
                            </SUILoadingButton>
                        </SUIStack>
                    </SUITd>
                </RowTemplate>
            </SUITable>
        }
            </Success>
        </ManagementDataView>
    </div>

    @if (Page is not null)
    {
        <footer class="registrations-footer">
            <SUIPagination TotalItems="Page.TotalCount"
                           PageSize="Page.PageSize"
                           PageIndex="@(Page.Page - 1)"
                           PageHref="@(index => $"clients/registrations?page={index + 1}")"
                           AriaLabel="@L["Clients.Registrations.PaginationAriaLabel"].Value"
                           PreviousLabel="@L["Clients.Registrations.PreviousPage"].Value"
                           NextLabel="@L["Clients.Registrations.NextPage"].Value"
                           PageLabel="@((page, count) => L["Clients.Registrations.PageOf", page, count].Value)"
                           RangeFormatter="@((first, last, total) => L["Clients.Registrations.RangeFormat", first, last, total].Value)"
                           EmptyText="@L["Clients.Registrations.EmptyTitle"].Value" />
        </footer>
    }
</SUISection>

@code {
    // The reader's zone once the browser answers (BrowserTimeProvider in the layout).
    [CascadingParameter]
    private BrowserTime Time { get; set; } = BrowserTime.Server;

    private ManagementDataResult<ManagementClientPage>? result;
    private string? loadedFingerprint;

    [SupplyParameterFromQuery(Name = "page")]
    public int QueryPage { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "revoked")]
    public string? RevokedClientId { get; set; }

    private string? RevokeError { get; set; }

    private string? RevokingClientId { get; set; }

    private int CurrentPage => QueryPage < 1 ? 1 : QueryPage;

    private ManagementClientPage? Page => result?.IsSuccess is true
        ? result.Value
        : null;

    protected override async Task OnParametersSetAsync()
    {
        var fingerprint = CurrentPage.ToString();
        if (fingerprint == loadedFingerprint)
        {
            return;
        }
        loadedFingerprint = fingerprint;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // Origin filter is applied by the management service; this console only
        // ever shows self-registered clients.
        result = await ClientData.SearchClientsAsync(new ManagementClientQuery(
            Search: null,
            Type: "all",
            Grant: "all",
            Scope: null,
            Origin: "dcr",
            Status: "all",
            Page: CurrentPage,
            PageSize: 25));
    }

    private async Task RevokeAsync(string clientId)
    {
        RevokeError = null;
        RevokingClientId = clientId;
        var outcome = await ClientData.DeleteClientAsync(clientId);
        RevokingClientId = null;
        if (outcome.IsSuccess)
        {
            Navigation.NavigateTo(
                $"clients/registrations?revoked={Uri.EscapeDataString(clientId)}",
                forceLoad: false);
            loadedFingerprint = null;
            await LoadAsync();
            return;
        }

        RevokeError = outcome.ErrorMessage
            ?? L["Clients.Registrations.RevokeGenericError"].Value;
    }

    private static string ClientHref(string id) => $"clients/{id}";

    private static string Truncate(string value, int length) =>
        value.Length <= length ? value : value[..length] + "…";
}
