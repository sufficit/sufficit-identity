@page "/users/{Id}/edit"
@attribute [Authorize(Policy = ManagementUiPolicies.Access)]
@attribute [StreamRendering]
@inject ManagementUserDataSource UserData
@inject NavigationManager Navigation

<PageTitle>@L["Users.Edit.PageTitle"]</PageTitle>

<SUIPageHeader Title="@L["Users.Edit.HeaderTitle"].Value"
            Description="@L["Users.Edit.HeaderDescription"].Value">
    <Actions>
        <SUIButton Href="@DetailHref" VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default">
            <SUIIcon Name="arrow-left" Size="17" />
            @L["Users.Edit.BackToUser"]
        </SUIButton>
    </Actions>
</SUIPageHeader>

<ManagementDataView Result="detailResult"
                    Loading="loading"
                    OnRetry="LoadAsync"
                    FailureClass="panel"
                    NotFoundTitle="@L["Users.Edit.LoadError.NotFound"].Value"
                    StepUpTitle="@L["Users.Edit.LoadError.StepUp"].Value"
                    ForbiddenTitle="@L["Users.Edit.LoadError.Forbidden"].Value"
                    UnavailableTitle="@L["Users.Edit.LoadError.Generic"].Value">
    <LoadingContent>
        <div class="form-section">
            <div class="table-skeleton" aria-label="@L["Users.Edit.LoadingAriaLabel"].Value">
                @for (var index = 0; index < 4; index++)
                {
                    <span></span>
                }
            </div>
        </div>
    </LoadingContent>
    <FailureActions>
        <SUIButton Href="@UsersHref" VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default">
            @L["Users.Edit.BackToUsers"]
        </SUIButton>
    </FailureActions>
    <Success Context="_">
@if (User.Actions.UpdateProfileRequiresMfa)
{
    <div class="panel">
        <SUIEmptyState Icon="shield"
                    Title="@L["Users.Edit.MfaRequired.Title"].Value"
                    Description="@L["Users.Edit.MfaRequired.Description"].Value">
            <Actions>
                <SUIButton Href="@DetailHref" VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default">
                    @L["Users.Edit.BackToUser"]
                </SUIButton>
            </Actions>
        </SUIEmptyState>
    </div>
}
else if (!User.Actions.CanUpdateProfile)
{
    <div class="panel">
        <SUIEmptyState Icon="lock"
                    Title="@L["Users.Edit.Forbidden.Title"].Value"
                    Description="@L["Users.Edit.Forbidden.Description"].Value">
            <Actions>
                <SUIButton Href="@DetailHref" VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default">
                    @L["Users.Edit.BackToUser"]
                </SUIButton>
            </Actions>
        </SUIEmptyState>
    </div>
}
else
{
    <div class="contract-strip contract-strip--warning">
        <SUIIcon Name="shield" Size="20" />
        <div>
            <strong>@L["Users.Edit.ContractStrip.Title"]</strong>
            <span>@L["Users.Edit.ContractStrip.Description"]</span>
        </div>
        <SUIStatusBadge ToneValue="SUITone.Warning">@L["Users.Edit.ContractStrip.Badge"]</SUIStatusBadge>
    </div>

    @if (submission?.IsSuccess is false)
    {
        <div class="inline-notice inline-notice--danger" role="alert">
            <SUIIcon Name="alert" Size="19" />
            <div>
                <strong>@SubmissionTitle</strong>
                <span>@submission.ErrorMessage</span>
            </div>
        </div>
    }

    <div>
    <EditForm Model="model"
              OnValidSubmit="UpdateAsync"
              FormName="update-management-user-profile"
              class="management-form">
        <DataAnnotationsValidator />

        <div class="form-section" aria-labelledby="user-profile-heading">
            <div class="form-section__heading">
                <h2 id="user-profile-heading">@L["Users.Edit.Identity.Heading"]</h2>
                <p>@L["Users.Edit.Identity.Description"]</p>
            </div>

            <SUIFormGrid Columns="2">
                <ChildContent>
                    <IdentityTextField T="string"
                                       Id="user-name"
                                       autocomplete="username"
                                       MaxLength="256"
                                       Label="@L["Users.Edit.Field.UserName"].Value"
                                       ErrorText="@(submission?.ErrorField is "userName" ? submission.ErrorMessage : null)"
                                       @bind-Value="model.UserName" />
                    <IdentityTextField T="string"
                                       Id="user-email"
                                       InputType="email"
                                       autocomplete="email"
                                       MaxLength="256"
                                       Label="@L["Users.Edit.Field.Email"].Value"
                                       ErrorText="@(submission?.ErrorField is "email" ? submission.ErrorMessage : null)"
                                       @bind-Value="model.Email" />
                </ChildContent>
                <FullWidthContent>
                    <IdentityTextField T="string"
                                       Id="user-phone"
                                       InputType="tel"
                                       autocomplete="tel"
                                       MaxLength="256"
                                       Label="@PhoneLabel"
                                       HelperText="@L["Users.Edit.Field.PhoneHint"].Value"
                                       ErrorText="@(submission?.ErrorField is "phoneNumber" ? submission.ErrorMessage : null)"
                                       @bind-Value="model.PhoneNumber" />
                </FullWidthContent>
            </SUIFormGrid>
        </div>

        <SUIStack Row="true" AlignItems="center" Justify="end" Spacing="2" Wrap="true">
            <SUIButton Href="@DetailHref" VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default">@L["Users.Edit.Cancel"]</SUIButton>
            <SUIButton ButtonTypeValue="SUIButtonType.Submit" Disabled="@submitting">
                @if (submitting)
                {
                    @L["Users.Edit.Submitting"]
                }
                else
                {
                    <SUIIcon Name="check" Size="17" />
                    @L["Users.Edit.Submit"]
                }
            </SUIButton>
        </SUIStack>
    </EditForm>
    </div>
}
    </Success>
</ManagementDataView>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private readonly UserEditModel model = new();
    private ManagementDataResult<ManagementUserDetail>? detailResult;
    private ManagementDataResult<ManagementUserDetail>? submission;
    private bool loading = true;
    private bool submitting;

    private string PhoneLabel => $"{L["Users.Edit.Field.Phone"].Value} ({L["Users.Edit.Field.PhoneOptional"].Value})";

    private ManagementUserDetail User =>
        detailResult?.Value
        ?? new ManagementUserDetail(
            string.Empty,
            null,
            null,
            false,
            null,
            false,
            false,
            false,
            null,
            0,
            DateTime.MinValue);

    private string DetailHref =>
        $"users/{Uri.EscapeDataString(Id)}";

    private const string UsersHref = "users";

    private string SubmissionTitle =>
        submission?.Outcome is ManagementDataOutcome.StepUpRequired
            ? L["Users.Edit.SubmitError.StepUp"].Value
            : submission?.Outcome is ManagementDataOutcome.Forbidden
                ? L["Users.Edit.SubmitError.Forbidden"].Value
                : submission?.Outcome is ManagementDataOutcome.Conflict
                    ? L["Users.Edit.SubmitError.Conflict"].Value
                    : L["Users.Edit.SubmitError.Generic"].Value;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        submission = null;
        detailResult = await UserData.GetAsync(Id);
        if (detailResult.IsSuccess && detailResult.Value is not null)
        {
            model.UserName = detailResult.Value.UserName ?? string.Empty;
            model.Email = detailResult.Value.Email ?? string.Empty;
            model.PhoneNumber = detailResult.Value.PhoneNumber;
        }
        loading = false;
    }

    private async Task UpdateAsync()
    {
        if (submitting)
        {
            return;
        }

        submitting = true;
        submission = await UserData.UpdateProfileAsync(
            Id,
            new UpdateManagementUserProfileCommand(
                model.UserName,
                model.Email,
                model.PhoneNumber));
        submitting = false;

        if (submission.IsSuccess && submission.Value is not null)
        {
            Navigation.NavigateTo(
                $"users/{Uri.EscapeDataString(Id)}?updated=1");
        }
    }

    protected override void OnInitialized()
    {
        model.Localizer = L;
        base.OnInitialized();
    }

    private sealed class UserEditModel : IValidatableObject
    {
        public IStringLocalizer<Sufficit.Identity.UI.Management.Resources.ManagementResource>? Localizer { get; set; }

        public string UserName { get; set; } = string.Empty;

        public string Email { get; set; } = string.Empty;

        public string? PhoneNumber { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            var l = Localizer ?? throw new InvalidOperationException(
                "The form model localizer must be set before validation.");

            if (string.IsNullOrWhiteSpace(UserName))
            {
                yield return new ValidationResult(l["Users.Edit.Validation.UserNameRequired"].Value, [nameof(UserName)]);
            }
            if (UserName?.Length > 256)
            {
                yield return new ValidationResult(l["Common.Validation.MaxLength", 256].Value, [nameof(UserName)]);
            }
            if (string.IsNullOrWhiteSpace(Email))
            {
                yield return new ValidationResult(l["Users.Edit.Validation.EmailRequired"].Value, [nameof(Email)]);
            }
            if (!string.IsNullOrWhiteSpace(Email) && !new EmailAddressAttribute().IsValid(Email))
            {
                yield return new ValidationResult(l["Users.Edit.Validation.EmailInvalid"].Value, [nameof(Email)]);
            }
            if (Email?.Length > 256)
            {
                yield return new ValidationResult(l["Common.Validation.MaxLength", 256].Value, [nameof(Email)]);
            }
            if (PhoneNumber?.Length > 256)
            {
                yield return new ValidationResult(l["Common.Validation.MaxLength", 256].Value, [nameof(PhoneNumber)]);
            }
        }
    }
}
