@page "/users/{Id}/edit"
@attribute [StreamRendering]
@inject ManagementUserDataSource UserData
@inject NavigationManager Navigation

<PageTitle>Editar usuário | Sufficit Identity</PageTitle>

<SUIPageHeader Title="Editar perfil"
            Description="Atualize a identidade da conta sem duplicar regras de persistência ou autorização na interface.">
    <Actions>
        <a class="button button--secondary" href="@DetailHref">
            <SUIIcon Name="arrow-left" Size="17" />
            Voltar para o usuário
        </a>
    </Actions>
</SUIPageHeader>

@if (loading)
{
    <div class="form-section" aria-busy="true">
        <div class="table-skeleton" aria-label="Carregando perfil do usuário">
            @for (var index = 0; index < 4; index++)
            {
                <span></span>
            }
        </div>
    </div>
}
else if (detailResult?.IsSuccess is false)
{
    <div class="panel">
        <SUIEmptyState Icon="alert"
                    Title="@LoadErrorTitle"
                    Description="@detailResult.ErrorMessage">
            <Actions>
                <a class="button button--secondary" href="@UsersHref">
                    Voltar para usuários
                </a>
                @if (detailResult.Outcome is ManagementDataOutcome.Unavailable)
                {
                    <button class="button button--primary"
                            type="button"
                            @onclick="LoadAsync">
                        Tentar novamente
                    </button>
                }
            </Actions>
        </SUIEmptyState>
    </div>
}
else if (User.Actions.UpdateProfileRequiresMfa)
{
    <div class="panel">
        <SUIEmptyState Icon="shield"
                    Title="MFA necessário para editar o perfil"
                    Description="A política administrativa exige autenticação multifator. Conclua o MFA e retorne a esta página.">
            <Actions>
                <a class="button button--secondary" href="@DetailHref">
                    Voltar para o usuário
                </a>
            </Actions>
        </SUIEmptyState>
    </div>
}
else if (!User.Actions.CanUpdateProfile)
{
    <div class="panel">
        <SUIEmptyState Icon="lock"
                    Title="Edição de perfil não autorizada"
                    Description="Sua sessão não possui a capability necessária para alterar contas do provedor.">
            <Actions>
                <a class="button button--secondary" href="@DetailHref">
                    Voltar para o usuário
                </a>
            </Actions>
        </SUIEmptyState>
    </div>
}
else
{
    <div class="contract-strip contract-strip--warning">
        <SUIIcon Name="shield" Size="20" />
        <div>
            <strong>Alteração da conta no provedor</strong>
            <span>Dados modificados invalidam tokens ativos; consentimentos duráveis permanecem preservados.</span>
        </div>
        <SUIStatusBadge Tone="warning">Sessões afetadas</SUIStatusBadge>
    </div>

    @if (submission?.IsSuccess is false)
    {
        <div class="inline-notice inline-notice--danger" role="alert">
            <SUIIcon Name="alert" Size="19" />
            <div>
                <strong>@SubmissionTitle</strong>
                <span>@submission.ErrorMessage</span>
            </div>
        </div>
    }

    <div>
    <EditForm Model="model"
              OnValidSubmit="UpdateAsync"
              FormName="update-management-user-profile"
              class="management-form">
        <DataAnnotationsValidator />

        <div class="form-section" aria-labelledby="user-profile-heading">
            <div class="form-section__heading">
                <h2 id="user-profile-heading">Identificação</h2>
                <p>O Identity valida unicidade e formato no servidor. E-mail e telefone alterados voltam a exigir confirmação.</p>
            </div>

            <div class="form-grid form-grid--two">
                <div class="field-group">
                    <label for="user-name">Nome de usuário</label>
                    <InputText id="user-name"
                               class="form-control"
                               autocomplete="username"
                               maxlength="256"
                               @bind-Value="model.UserName" />
                    <ValidationMessage For="() => model.UserName" />
                    @if (submission?.ErrorField is "userName")
                    {
                        <p class="validation-message">@submission.ErrorMessage</p>
                    }
                </div>

                <div class="field-group">
                    <label for="user-email">E-mail</label>
                    <InputText id="user-email"
                               class="form-control"
                               type="email"
                               autocomplete="email"
                               maxlength="256"
                               @bind-Value="model.Email" />
                    <ValidationMessage For="() => model.Email" />
                    @if (submission?.ErrorField is "email")
                    {
                        <p class="validation-message">@submission.ErrorMessage</p>
                    }
                </div>
            </div>

            <div class="field-group">
                <label for="user-phone">
                    Telefone
                    <span class="label-optional">Opcional</span>
                </label>
                <InputText id="user-phone"
                           class="form-control"
                           type="tel"
                           autocomplete="tel"
                           maxlength="256"
                           @bind-Value="model.PhoneNumber" />
                <ValidationMessage For="() => model.PhoneNumber" />
                @if (submission?.ErrorField is "phoneNumber")
                {
                    <p class="validation-message">@submission.ErrorMessage</p>
                }
                <span class="field-hint">Use o formato reconhecido pelo provedor de confirmação configurado para este runtime.</span>
            </div>
        </div>

        <footer class="form-actions">
            <a class="button button--secondary" href="@DetailHref">Cancelar</a>
            <button class="button button--primary"
                    type="submit"
                    disabled="@submitting">
                @if (submitting)
                {
                    <span class="button-spinner" aria-hidden="true"></span>
                    <span>Salvando perfil…</span>
                }
                else
                {
                    <SUIIcon Name="check" Size="17" />
                    <span>Salvar perfil</span>
                }
            </button>
        </footer>
    </EditForm>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private readonly UserEditModel model = new();
    private ManagementDataResult<ManagementUserDetail>? detailResult;
    private ManagementDataResult<ManagementUserDetail>? submission;
    private bool loading = true;
    private bool submitting;

    private ManagementUserDetail User =>
        detailResult?.Value
        ?? new ManagementUserDetail(
            string.Empty,
            null,
            null,
            false,
            null,
            false,
            false,
            false,
            null,
            0,
            DateTime.MinValue);

    private string DetailHref =>
        $"users/{Uri.EscapeDataString(Id)}";

    private const string UsersHref = "users";

    private string LoadErrorTitle =>
        detailResult?.Outcome is ManagementDataOutcome.NotFound
            ? "Usuário não encontrado"
            : detailResult?.Outcome is ManagementDataOutcome.StepUpRequired
                ? "MFA exigido para carregar o perfil"
                : detailResult?.Outcome is ManagementDataOutcome.Forbidden
                    ? "Acesso ao usuário negado"
                    : "Não foi possível carregar o perfil";

    private string SubmissionTitle =>
        submission?.Outcome is ManagementDataOutcome.StepUpRequired
            ? "MFA exigido para editar o perfil"
            : submission?.Outcome is ManagementDataOutcome.Forbidden
                ? "Autoridade insuficiente sobre a conta"
                : submission?.Outcome is ManagementDataOutcome.Conflict
                    ? "Nome de usuário ou e-mail já utilizado"
                    : "Não foi possível atualizar o perfil";

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        submission = null;
        detailResult = await UserData.GetAsync(Id);
        if (detailResult.IsSuccess && detailResult.Value is not null)
        {
            model.UserName = detailResult.Value.UserName ?? string.Empty;
            model.Email = detailResult.Value.Email ?? string.Empty;
            model.PhoneNumber = detailResult.Value.PhoneNumber;
        }
        loading = false;
    }

    private async Task UpdateAsync()
    {
        if (submitting)
        {
            return;
        }

        submitting = true;
        submission = await UserData.UpdateProfileAsync(
            Id,
            new UpdateManagementUserProfileCommand(
                model.UserName,
                model.Email,
                model.PhoneNumber));
        submitting = false;

        if (submission.IsSuccess && submission.Value is not null)
        {
            Navigation.NavigateTo(
                $"users/{Uri.EscapeDataString(Id)}?updated=1");
        }
    }

    private sealed class UserEditModel
    {
        [Required(ErrorMessage = "Informe o nome de usuário.")]
        [StringLength(256, ErrorMessage = "Use no máximo 256 caracteres.")]
        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe o e-mail.")]
        [EmailAddress(ErrorMessage = "Informe um e-mail válido.")]
        [StringLength(256, ErrorMessage = "Use no máximo 256 caracteres.")]
        public string Email { get; set; } = string.Empty;

        [StringLength(256, ErrorMessage = "Use no máximo 256 caracteres.")]
        public string? PhoneNumber { get; set; }
    }
}
