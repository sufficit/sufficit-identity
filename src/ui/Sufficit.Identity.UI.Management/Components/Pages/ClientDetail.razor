@page "/clients/{Id}"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageClients)]
@inject ManagementClientDataSource ClientData
@inject NavigationManager Navigation
@inject ISUIDialogService Dialogs
@inject ISUIToast Toast

@{ var client = result?.Value!; }

<PageTitle>@PageTitleText</PageTitle>

<SUIPageHeader Title="@HeaderTitle"
            Description="@L["Clients.Detail.Description"].Value">
    <Actions>
        <SUIButton Href="clients" ColorValue="SUIColor.Secondary">
            <SUIIcon Name="arrow-left" Size="17" />
            @L["Clients.Detail.Back"]
        </SUIButton>
        @if (result?.Value is { } selectedClient)
        {
            @if (!selectedClient.IsManifestManaged)
            {
                <SUIButton Href="@EditHref(selectedClient.Id)" ColorValue="SUIColor.Primary">
                    <SUIIcon Name="edit" Size="17" />
                    @L["Clients.Detail.Edit"]
                </SUIButton>
            }
            <AuthorizeView Policy="@ManagementUiPolicies.ManageSessions">
                <Authorized>
                    <SUIButton Href="@SessionsHref(selectedClient.ClientId)" ColorValue="SUIColor.Secondary">
                        <SUIIcon Name="clock" Size="17" />
                        @L["Clients.Detail.Sessions"]
                    </SUIButton>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@ManagementUiPolicies.ManageAuthorizations">
                <Authorized>
                    <SUIButton Href="@AuthorizationsHref(selectedClient.ClientId)" ColorValue="SUIColor.Secondary">
                        <SUIIcon Name="shield" Size="17" />
                        @L["Clients.Detail.Authorizations"]
                    </SUIButton>
                </Authorized>
            </AuthorizeView>
        }
    </Actions>
</SUIPageHeader>

@if (Updated)
{
    <SUIAlert ToneValue="SUITone.Success" Icon="check" role="status">
        <strong>@L["Clients.Detail.UpdatedTitle"]</strong>
        <span>@L["Clients.Detail.UpdatedMessage"]</span>
    </SUIAlert>
}

@if (Created)
{
    <SUIAlert ToneValue="SUITone.Success" Icon="check" role="status">
        <strong>@L["Clients.Detail.CreatedTitle"]</strong>
        <span>@L["Clients.Detail.CreatedMessage"]</span>
    </SUIAlert>
}

<ManagementDataView Result="result"
                    Loading="loading"
                    OnRetry="LoadAsync"
                    NotFoundTitle="@L["Clients.Detail.NotFoundTitle"].Value"
                    UnavailableTitle="@L["Clients.Detail.GenericErrorTitle"].Value">
    <LoadingContent>
        <div class="detail-shell" aria-label="@L["Clients.Detail.LoadingAriaLabel"].Value">
            <div class="detail-skeleton"></div>
            <div class="detail-skeleton detail-skeleton--short"></div>
        </div>
    </LoadingContent>
    <FailureActions>
        <SUIButton Href="clients" ColorValue="SUIColor.Secondary">@L["Clients.Detail.Back"]</SUIButton>
    </FailureActions>
    <Success Context="_">
    <div class="detail-shell client-detail-shell">
        <div class="detail-summary">
            <div>
                <span class="detail-label">Client ID</span>
                <code class="detail-value detail-value--code">@client.ClientId</code>
            </div>
            <div>
                <span class="detail-label">@L["Clients.Detail.TypeLabel"]</span>
                <SUIStatusBadge ToneValue="@IdentitySuiTone.From(ClientTypeTone(client.Type))">
                    @ClientTypeLabel(client.Type)
                </SUIStatusBadge>
            </div>
            <div>
                <span class="detail-label">@L["Clients.Detail.ConsentLabel"]</span>
                <strong class="detail-value">@ConsentTypeLabel(client.ConsentType)</strong>
            </div>
            <div>
                <span class="detail-label">@L["Clients.Detail.InternalIdLabel"]</span>
                <code class="detail-value detail-value--code">@client.Id</code>
            </div>
            <div>
                <span class="detail-label">@L["Clients.State.Label"]</span>
                <SUIStatusBadge ToneValue="@(IsDisabled(client) ? SUITone.Danger : SUITone.Success)">
                    @(IsDisabled(client) ? L["Clients.State.Disabled"] : L["Clients.State.Active"])
                </SUIStatusBadge>
            </div>
        </div>

        @if (IsDisabled(client))
        {
            <SUIAlert ToneValue="SUITone.Danger" Icon="lock" role="status">
                <strong>@L["Clients.State.DisabledTitle"]</strong>
                <span>@L["Clients.State.DisabledSince", Time.Format(client.DisabledAtUtc) ?? "-", client.DisabledBy ?? "-", client.DisabledReason ?? "-"]</span>
            </SUIAlert>
        }

        @if (client.IsManifestManaged)
        {
            <SUIAlert ToneValue="SUITone.Warning" Icon="lock" role="status">
                <strong>@L["Clients.Detail.ManifestManagedTitle"]</strong>
                <span>@L["Clients.Detail.ManifestManagedDescription"]</span>
            </SUIAlert>
        }

        <div class="client-detail-layout">
            <section class="client-detail-panel client-detail-panel--permissions"
                     aria-labelledby="permission-heading">
                <header class="client-detail-panel__heading">
                    <div>
                        <h2 id="permission-heading">@L["Clients.Detail.PermissionsHeading"]</h2>
                        <p>@L["Clients.Detail.PermissionsCount", client.Permissions.Count]</p>
                    </div>
                </header>

                @if (client.Permissions.Count is 0)
                {
                    <p class="detail-empty">@L["Clients.Detail.NoPermissions"]</p>
                }
                else
                {
                    <div class="permission-groups">
                        @if (HasPermissionPrefix(client, "gt:"))
                        {
                            <div class="permission-group">
                                <span class="detail-label">Grants</span>
                                <div class="permission-badges">
                                    @foreach (var permission in PermissionsWithPrefix(client, "gt:"))
                                    {
                                        <code class="permission-badge permission-badge--grant">@PermissionValue(permission)</code>
                                    }
                                </div>
                            </div>
                        }
                        @if (HasPermissionPrefix(client, "scp:"))
                        {
                            <div class="permission-group">
                                <span class="detail-label">Scopes</span>
                                <div class="permission-badges">
                                    @foreach (var permission in PermissionsWithPrefix(client, "scp:"))
                                    {
                                        <code class="permission-badge">@PermissionValue(permission)</code>
                                    }
                                </div>
                            </div>
                        }
                        @if (HasOtherPermissions(client))
                        {
                            <div class="permission-group">
                                <span class="detail-label">@L["Clients.Detail.EndpointsAndResponses"]</span>
                                <div class="permission-badges">
                                    @foreach (var permission in OtherPermissions(client))
                                    {
                                        <code class="permission-badge permission-badge--muted">@PermissionLabel(permission)</code>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="client-detail-panel client-detail-panel--tokens"
                     aria-labelledby="token-lifetime-heading">
                <header class="client-detail-panel__heading client-detail-panel__heading--action">
                    <div>
                        <h2 id="token-lifetime-heading">@L["Clients.Detail.TokenValidityHeading"]</h2>
                        <p>@L["Clients.Detail.TokenValiditySubheading"]</p>
                    </div>
                    @if (!client.IsManifestManaged)
                    {
                        <SUIButton Href="@EditTokensHref(client.Id)" VariantValue="SUIVariant.Text" SizeValue="SUISize.Small">@L["Clients.Detail.AdjustAction"]</SUIButton>
                    }
                </header>
                <dl class="token-policy-list">
                    <div>
                        <dt>Access token</dt>
                        <dd>
                            <strong>@FormatMinutes(client.AccessTokenLifetimeMinutes ?? client.GlobalAccessTokenLifetimeMinutes)</strong>
                            <span>@PolicySource(client.AccessTokenLifetimeMinutes)</span>
                        </dd>
                    </div>
                    <div>
                        <dt>ID token</dt>
                        <dd>
                            <strong>@FormatMinutes(client.IdentityTokenLifetimeMinutes ?? client.GlobalIdentityTokenLifetimeMinutes)</strong>
                            <span>@PolicySource(client.IdentityTokenLifetimeMinutes)</span>
                        </dd>
                    </div>
                    <div>
                        <dt>Refresh token</dt>
                        <dd>
                            <strong>@FormatDays(client.RefreshTokenLifetimeDays ?? client.GlobalRefreshTokenLifetimeDays)</strong>
                            <span>@PolicySource(client.RefreshTokenLifetimeDays)</span>
                        </dd>
                    </div>
                    <div>
                        <dt>@L["Clients.Edit.DelegationSignInAge"]</dt>
                        <dd>
                            <strong>@L["Clients.Edit.HoursValue", client.DelegationMaxAuthAgeHours ?? client.GlobalDelegationMaxAuthAgeHours]</strong>
                            <span>@PolicySource(client.DelegationMaxAuthAgeHours)</span>
                        </dd>
                    </div>
                </dl>
            </section>

            @if (client.HasClientSecret
                || client.AuthenticationMethods?.Count is > 0
                || UsesClientCredentials(client))
            {
                <section class="client-detail-panel client-detail-panel--credentials"
                         aria-labelledby="client-secret-heading">
                    <header class="client-detail-panel__heading client-detail-panel__heading--action">
                        <div>
                            <h2 id="client-secret-heading">@L["Clients.Detail.AppAuthHeading"]</h2>
                            <p>@L["Clients.Detail.AppAuthSubheading"]</p>
                        </div>
                        @if (!client.IsManifestManaged)
                        {
                            <SUIButton Href="@EditCredentialsHref(client.Id)" VariantValue="SUIVariant.Text" SizeValue="SUISize.Small">
                                @L["Clients.Detail.ManageAction"]
                            </SUIButton>
                        }
                    </header>
                    <div class="client-secret-summary">
                        <span class="client-secret-summary__icon">
                            <SUIIcon Name="@(HasAuthenticationMethod(client) ? "lock" : "alert")" Size="20" />
                        </span>
                        <div>
                            <strong>
                                @(HasAuthenticationMethod(client)
                                    ? AuthenticationSummaryTitle(client)
                                    : L["Clients.Detail.AuthNotConfigured"].Value)
                            </strong>
                            <span>
                                @(HasAuthenticationMethod(client)
                                    ? AuthenticationMethodsDescription(client)
                                    : L["Clients.Detail.AuthNotConfiguredHint"].Value)
                            </span>
                        </div>
                        <SUIStatusBadge ToneValue="@(HasAuthenticationMethod(client) ? SUITone.Success : SUITone.Warning)">
                            @(HasAuthenticationMethod(client) ? L["Clients.Detail.ConfiguredBadge"] : L["Clients.Detail.ActionRequiredBadge"])
                        </SUIStatusBadge>
                    </div>
                </section>
            }

            <section class="client-detail-panel client-detail-panel--uris"
                     aria-labelledby="redirect-heading">
                <header class="client-detail-panel__heading">
                    <div>
                        <h2 id="redirect-heading">@L["Clients.Detail.DestinationsHeading"]</h2>
                        <p>@L["Clients.Detail.DestinationsSubheading"]</p>
                    </div>
                </header>
                <div class="uri-groups">
                    <div class="uri-group">
                        <div class="uri-group__heading">
                            <h3>Redirect URIs</h3>
                            <span>@client.RedirectUris.Count</span>
                        </div>
                        @if (client.RedirectUris.Count is 0)
                        {
                            <p class="detail-empty">@L["Clients.Detail.NoUris"]</p>
                        }
                        else
                        {
                            <ul class="compact-uri-list">
                                @foreach (var uri in client.RedirectUris)
                                {
                                    <li><code>@uri</code></li>
                                }
                            </ul>
                        }
                    </div>
                    <div class="uri-group">
                        <div class="uri-group__heading">
                            <h3>@L["Clients.Detail.AfterLogoutHeading"]</h3>
                            <span>@client.PostLogoutRedirectUris.Count</span>
                        </div>
                        @if (client.PostLogoutRedirectUris.Count is 0)
                        {
                            <p class="detail-empty">@L["Clients.Detail.NoDestinations"]</p>
                        }
                        else
                        {
                            <ul class="compact-uri-list">
                                @foreach (var uri in client.PostLogoutRedirectUris)
                                {
                                    <li><code>@uri</code></li>
                                }
                            </ul>
                        }
                    </div>
                    <div class="uri-group">
                        <div class="uri-group__heading">
                            <h3>@L["Clients.Detail.NativeReturnsHeading"]</h3>
                            <span>@(client.NativeReturnUris?.Count ?? 0)</span>
                        </div>
                        @if ((client.NativeReturnUris?.Count ?? 0) is 0)
                        {
                            <p class="detail-empty">@L["Clients.Detail.NoReturns"]</p>
                        }
                        else
                        {
                            <ul class="compact-uri-list">
                                @foreach (var uri in client.NativeReturnUris!)
                                {
                                    <li><code>@uri</code></li>
                                }
                            </ul>
                        }
                    </div>
                    <div class="uri-group">
                        <div class="uri-group__heading">
                            <h3>@L["Clients.Detail.FederatedLogoutHeading"]</h3>
                            <span>@FederatedLogoutCount(client)</span>
                        </div>
                        @if (client.FrontchannelLogoutUri is null && client.BackchannelLogoutUri is null)
                        {
                            <p class="detail-empty">@L["Clients.Detail.NoEndpoints"]</p>
                        }
                        else
                        {
                            <dl class="compact-uri-list compact-uri-list--definition">
                                @if (client.FrontchannelLogoutUri is not null)
                                {
                                    <div><dt>Front-channel</dt><dd><code>@client.FrontchannelLogoutUri</code></dd></div>
                                }
                                @if (client.BackchannelLogoutUri is not null)
                                {
                                    <div><dt>Back-channel</dt><dd><code>@client.BackchannelLogoutUri</code></dd></div>
                                }
                            </dl>
                        }
                    </div>
                </div>
            </section>

            @if (client.Requirements.Count > 0)
            {
                <section class="client-detail-panel client-detail-panel--requirements"
                         aria-labelledby="requirements-heading">
                    <div>
                        <h2 id="requirements-heading">@L["Clients.Detail.SecurityRequirementsHeading"]</h2>
                        <p>@L["Clients.Detail.SecurityRequirementsSubheading"]</p>
                    </div>
                    <div class="token-row">
                        @foreach (var requirement in client.Requirements)
                        {
                            <SUIStatusBadge ToneValue="SUITone.Info">@RequirementLabel(requirement)</SUIStatusBadge>
                        }
                    </div>
                </section>
            }
        </div>
    </div>

    <div class="danger-zone" aria-labelledby="client-state-heading">
        <div>
            <h2 id="client-state-heading">@(IsDisabled(client) ? L["Clients.State.EnableTitle"] : L["Clients.State.DisableTitle"])</h2>
            <p>@(IsDisabled(client) ? L["Clients.State.EnableDescription"] : L["Clients.State.DisableDescription"])</p>
        </div>

        @if (IsDisabled(client))
        {
            <SUIButton ColorValue="SUIColor.Primary" Disabled="@changingState" OnClick="EnableAsync">
                <SUIIcon Name="check-circle" Size="17" />
                @L["Clients.State.Enable"]
            </SUIButton>
        }
        else if (!editingState)
        {
            <SUIButton ColorValue="SUIColor.Error" OnClick="@(() => editingState = true)">
                <SUIIcon Name="lock" Size="17" />
                @L["Clients.State.Disable"]
            </SUIButton>
        }
        else
        {
            <SUIStack Spacing="3" Class="client-detail-confirmation">
                <IdentityTextField T="string"
                                   Id="client-state-reason"
                                   Label="@L["Clients.State.ReasonLabel"].Value"
                                   MaxLength="500"
                                   Immediate="true"
                                   autocomplete="off"
                                   @bind-Value="stateReason" />
                <SUISwitch Label="@L["Clients.State.RevokeTokens"].Value"
                           @bind-Value="stateRevokeTokens" />
                <SUIStack Row="true" Wrap="true" Spacing="2" Justify="End">
                    <SUIButton ColorValue="SUIColor.Secondary" Disabled="@changingState"
                               OnClick="@(() => editingState = false)">
                        @L["Clients.Detail.Cancel"]
                    </SUIButton>
                    <SUIButton ColorValue="SUIColor.Error"
                               Disabled="@(changingState || string.IsNullOrWhiteSpace(stateReason))"
                               OnClick="DisableAsync">
                        <SUIIcon Name="lock" Size="17" />
                        @L["Clients.State.ConfirmDisable"]
                    </SUIButton>
                </SUIStack>
            </SUIStack>
        }
    </div>

    <div class="danger-zone" aria-labelledby="delete-client-heading">
        <div>
            <h2 id="delete-client-heading">@L["Clients.Detail.DeleteClient"]</h2>
            <p>
                @L["Clients.Detail.DeleteDescription"]
            </p>
        </div>

        @if (!confirmingDelete)
        {
            <SUIButton ColorValue="SUIColor.Error" OnClick="BeginDelete">
                <SUIIcon Name="trash" Size="17" />
                @L["Clients.Detail.DeleteClient"]
            </SUIButton>
        }
        else
        {
            <SUIStack Spacing="3" Class="client-detail-confirmation">
                <IdentityTextField T="string"
                                   Id="delete-confirmation"
                                   Label="@($"{L["Clients.Detail.DeleteConfirmPrefix"].Value} {client.ClientId} {L["Clients.Detail.DeleteConfirmSuffix"].Value}")"
                                   ErrorText="@(deleteResult?.IsSuccess is false ? deleteResult.ErrorMessage : null)"
                                   Immediate="true"
                                   autocomplete="off"
                                   @bind-Value="deleteConfirmation" />
                <SUIStack Row="true" Wrap="true" Spacing="2" Justify="End">
                    <SUIButton ColorValue="SUIColor.Secondary"
                               Disabled="@deleting"
                               OnClick="CancelDelete">
                        @L["Clients.Detail.Cancel"]
                    </SUIButton>
                    <SUILoadingButton ColorValue="SUIColor.Error"
                                      IsLoading="@deleting"
                                      Disabled="@(!CanDelete)"
                                      aria-label="@(deleting ? L["Clients.Detail.Deleting"].Value : null)"
                                      OnClick="DeleteAsync">
                        <SUIIcon Name="trash" Size="17" />
                        <span>@L["Clients.Detail.ConfirmDelete"]</span>
                    </SUILoadingButton>
                </SUIStack>
            </SUIStack>
        }
    </div>
    </Success>
</ManagementDataView>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "created")]
    public int CreatedFlag { get; set; }

    [SupplyParameterFromQuery(Name = "updated")]
    public int UpdatedFlag { get; set; }

    private ManagementDataResult<ManagementClientDetail>? result;
    private ManagementDataResult<bool>? deleteResult;
    private bool loading = true;
    private bool confirmingDelete;
    // The reader's zone once the browser answers (BrowserTimeProvider in the layout).
    [CascadingParameter]
    private BrowserTime Time { get; set; } = BrowserTime.Server;

    private bool editingState;
    private bool changingState;
    private bool stateRevokeTokens = true;
    private string stateReason = string.Empty;

    private static bool IsDisabled(ManagementClientDetail client) =>
        string.Equals(client.Status, "disabled", StringComparison.Ordinal);

    private async Task DisableAsync()
    {
        if (result?.Value is not { } client) return;
        await ChangeStateAsync(new SetManagementClientStateCommand(
            client.ClientId, Enabled: false, stateReason, stateRevokeTokens, client.Version),
            L["Clients.State.DisabledToast"].Value);
    }

    private async Task EnableAsync()
    {
        if (result?.Value is not { } client) return;
        if (!await Dialogs.ConfirmAsync(L["Clients.State.EnableTitle"].Value,
                L["Clients.State.EnableConfirm", client.DisplayName ?? client.ClientId].Value))
            return;
        await ChangeStateAsync(new SetManagementClientStateCommand(
            client.ClientId, Enabled: true, ExpectedVersion: client.Version),
            L["Clients.State.EnabledToast"].Value);
    }

    private async Task ChangeStateAsync(SetManagementClientStateCommand command, string success)
    {
        changingState = true;
        var changed = await ClientData.SetClientStateAsync(command);
        changingState = false;
        if (!changed.IsSuccess)
        {
            Toast.Error(changed.ErrorMessage ?? L["Common.Unavailable"].Value);
            return;
        }
        result = changed;
        editingState = false;
        stateReason = string.Empty;
        Toast.Success(success);
    }
    private bool deleting;
    private string deleteConfirmation = string.Empty;

    private bool Created => CreatedFlag is 1;
    private bool Updated => UpdatedFlag is 1;

    private string HeaderTitle =>
        result?.Value?.DisplayName
        ?? result?.Value?.ClientId
        ?? L["Clients.Detail.HeaderFallbackTitle"].Value;

    private string PageTitleText =>
        $"{HeaderTitle} | Sufficit Identity";

    private static string SessionsHref(string clientId) =>
        $"sessions?client={Uri.EscapeDataString(clientId)}";

    private static string AuthorizationsHref(string clientId) =>
        $"authorizations?client={Uri.EscapeDataString(clientId)}";

    private static string EditHref(string id) =>
        $"clients/{Uri.EscapeDataString(id)}/edit";

    private static string EditTokensHref(string id) =>
        $"clients/{Uri.EscapeDataString(id)}/edit?section=tokens";

    private static string EditCredentialsHref(string id) =>
        $"clients/{Uri.EscapeDataString(id)}/edit?section=credentials";

    private bool CanDelete =>
        !deleting
        && result?.Value is not null
        && string.Equals(
            deleteConfirmation,
            result.Value.ClientId,
            StringComparison.Ordinal);

    protected override async Task OnParametersSetAsync() =>
        await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        result = await ClientData.GetClientAsync(Id);
        loading = false;
    }

    private void BeginDelete()
    {
        confirmingDelete = true;
        deleteConfirmation = string.Empty;
        deleteResult = null;
    }

    private void CancelDelete()
    {
        confirmingDelete = false;
        deleteConfirmation = string.Empty;
        deleteResult = null;
    }

    private async Task DeleteAsync()
    {
        if (!CanDelete || result?.Value is null)
        {
            return;
        }

        deleting = true;
        deleteResult = await ClientData.DeleteClientAsync(result.Value.ClientId);
        deleting = false;

        if (deleteResult.IsSuccess)
        {
            Navigation.NavigateTo(
                $"clients?deleted={Uri.EscapeDataString(result.Value.ClientId)}");
        }
    }

    private string ClientTypeLabel(string? type) =>
        type?.ToLowerInvariant() switch
        {
            "public" => L["Clients.Detail.TypePublic"].Value,
            "confidential" => L["Clients.Detail.TypeConfidential"].Value,
            null or "" => L["Clients.Detail.NotInformed"].Value,
            _ => type
        };

    private static string ClientTypeTone(string? type) =>
        string.Equals(type, "confidential", StringComparison.OrdinalIgnoreCase)
            ? "info"
            : "neutral";

    private string ConsentTypeLabel(string? consentType) =>
        consentType?.ToLowerInvariant() switch
        {
            "explicit" => L["Clients.Detail.ConsentExplicit"].Value,
            "implicit" => L["Clients.Detail.ConsentImplicit"].Value,
            "external" => L["Clients.Detail.ConsentExternal"].Value,
            "systematic" => L["Clients.Detail.ConsentSystematic"].Value,
            null or "" => L["Clients.Detail.NotInformed"].Value,
            _ => consentType
        };

    private static string PermissionLabel(string permission) =>
        permission
            .Replace("gt:", "grant: ", StringComparison.Ordinal)
            .Replace("scp:", "scope: ", StringComparison.Ordinal)
            .Replace("ept:", "endpoint: ", StringComparison.Ordinal)
            .Replace("rst:", "response: ", StringComparison.Ordinal);

    private string RequirementLabel(string requirement) =>
        requirement switch
        {
            "ft:pkce" => L["Clients.Detail.PkceRequired"].Value,
            "ft:par" => L["Clients.Detail.ParRequired"].Value,
            _ => requirement
        };

    private static bool HasPermissionPrefix(
        ManagementClientDetail client,
        string prefix) =>
        client.Permissions.Any(permission => permission.StartsWith(
            prefix,
            StringComparison.Ordinal));

    private static bool UsesClientCredentials(ManagementClientDetail client) =>
        client.Permissions.Contains("gt:client_credentials", StringComparer.Ordinal);

    private static bool HasAuthenticationMethod(ManagementClientDetail client) =>
        client.AuthenticationMethods?.Count is > 0;

    private string AuthenticationMethodsDescription(
        ManagementClientDetail client)
    {
        var methods = client.AuthenticationMethods ?? [];
        var labels = methods
            .Select(method => method switch
            {
                "client_secret_basic" => L["Clients.Detail.AuthMethodSecretHeader"].Value,
                "client_secret_post" => L["Clients.Detail.AuthMethodSecretBody"].Value,
                "private_key_jwt" => L["Clients.Detail.AuthMethodSignedJwt"].Value,
                "tls_client_auth" => L["Clients.Detail.AuthMethodMtls"].Value,
                "self_signed_tls_client_auth" => L["Clients.Detail.AuthMethodMtlsSelfSigned"].Value,
                _ => method,
            })
            .Distinct(StringComparer.Ordinal)
            .ToArray();
        return labels.Length is 0
            ? L["Clients.Detail.NoAuthMethodsAvailable"].Value
            : L["Clients.Detail.AuthMethodsAvailable", string.Join(", ", labels)].Value;
    }

    private string AuthenticationSummaryTitle(
        ManagementClientDetail client) =>
        client.ActiveCredentialCount switch
        {
            > 1 => L["Clients.Detail.ActiveCredentialsCount", client.ActiveCredentialCount].Value,
            1 => L["Clients.Detail.ActiveCredentialSingular"].Value,
            _ when client.AuthenticationMethods?.Contains(
                "private_key_jwt",
                StringComparer.Ordinal) is true => L["Clients.Detail.PublicKeyAuthActive"].Value,
            _ => L["Clients.Detail.ClientAuthConfigured"].Value,
        };

    private static IEnumerable<string> PermissionsWithPrefix(
        ManagementClientDetail client,
        string prefix) =>
        client.Permissions.Where(permission => permission.StartsWith(
            prefix,
            StringComparison.Ordinal));

    private static bool HasOtherPermissions(ManagementClientDetail client) =>
        client.Permissions.Any(permission =>
            !permission.StartsWith("gt:", StringComparison.Ordinal)
            && !permission.StartsWith("scp:", StringComparison.Ordinal));

    private static IEnumerable<string> OtherPermissions(
        ManagementClientDetail client) =>
        client.Permissions.Where(permission =>
            !permission.StartsWith("gt:", StringComparison.Ordinal)
            && !permission.StartsWith("scp:", StringComparison.Ordinal));

    private static string PermissionValue(string permission)
    {
        var separator = permission.IndexOf(':', StringComparison.Ordinal);
        return separator >= 0 && separator < permission.Length - 1
            ? permission[(separator + 1)..]
            : permission;
    }

    private static int FederatedLogoutCount(ManagementClientDetail client) =>
        (client.FrontchannelLogoutUri is null ? 0 : 1)
        + (client.BackchannelLogoutUri is null ? 0 : 1);

    private string PolicySource(int? configuredValue) =>
        configuredValue is null
            ? L["Clients.Detail.PolicyGlobalDefault"].Value
            : L["Clients.Detail.PolicyCustom"].Value;

    private string FormatMinutes(int minutes)
    {
        if (minutes % (24 * 60) == 0)
        {
            var days = minutes / (24 * 60);
            return days is 1 ? L["Clients.Detail.OneDay"].Value : L["Clients.Detail.DaysFormat", days].Value;
        }
        if (minutes % 60 == 0)
        {
            var hours = minutes / 60;
            return hours is 1 ? L["Clients.Detail.OneHour"].Value : L["Clients.Detail.HoursFormat", hours].Value;
        }
        return minutes is 1 ? L["Clients.Detail.OneMinute"].Value : L["Clients.Detail.MinutesFormat", minutes].Value;
    }

    private string FormatDays(double days)
    {
        var value = days.ToString("0.##", System.Globalization.CultureInfo.CurrentCulture);
        return days is 1 ? L["Clients.Detail.OneDay"].Value : L["Clients.Detail.DaysFormat", value].Value;
    }
}
