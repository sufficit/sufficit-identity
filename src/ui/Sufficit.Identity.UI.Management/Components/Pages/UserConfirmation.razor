@page "/users/{Id}/actions/confirmation"
@attribute [Authorize(Policy = ManagementUiPolicies.Access)]
@attribute [StreamRendering]
@inject ManagementUserDataSource UserData
@inject ISUIToast Toast

@{ var user = result?.Value!; }

<PageTitle>@L["Users.Confirmation.PageTitle"]</PageTitle>

<SUIPageHeader Title="@HeaderTitle" Description="@L["Users.Detail.Actions.ResendConfirmationDescription"].Value">
    <Actions>
        <SUIButton Href="@DetailHref" VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" StartIcon="arrow-left">
            @L["Users.Actions.BackToUser"]
        </SUIButton>
    </Actions>
</SUIPageHeader>

<ManagementDataView Result="result"
                    Loading="loading"
                    OnRetry="LoadAsync"
                    FailureClass="panel"
                    NotFoundTitle="@L["Users.Detail.Error.NotFound"].Value"
                    StepUpTitle="@L["Users.Detail.Error.StepUp"].Value"
                    ForbiddenTitle="@L["Users.Detail.Error.Forbidden"].Value"
                    UnavailableTitle="@L["Users.Detail.Error.Generic"].Value">
    <LoadingContent>
    <div class="account-access-panel" aria-label="@L["Users.Actions.Loading"].Value">
        <div class="detail-skeleton"></div>
        <div class="detail-skeleton detail-skeleton--short"></div>
    </div>
    </LoadingContent>
    <FailureActions>
        <SUIButton Href="@DetailHref" VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default">@L["Users.Actions.BackToUser"]</SUIButton>
    </FailureActions>
    <Success Context="_">
@if (user.EmailConfirmed)
{
    <div class="decision-note decision-note--neutral"><SUIIcon Name="check" Size="21" /><div><h2>@L["Users.Confirmation.AlreadyConfirmedTitle"]</h2><p>@L["Users.Confirmation.AlreadyConfirmedDescription"]</p></div></div>
}
else if (string.IsNullOrWhiteSpace(user.Email))
{
    <div class="decision-note decision-note--neutral"><SUIIcon Name="alert" Size="21" /><div><h2>@L["Users.Confirmation.NoEmailTitle"]</h2><p>@L["Error.user_email_missing"]</p></div></div>
}
else if (user.Actions.CanResendConfirmation)
{
    <section class="account-access-panel" aria-labelledby="account-confirmation-heading">
        <div class="account-access-panel__heading">
            <div class="account-access-panel__icon"><SUIIcon Name="inbox" Size="20" /></div>
            <div>
                <h2 id="account-confirmation-heading">@L["Users.Confirmation.Heading"]</h2>
                <p>@string.Format(L["Users.Confirmation.DescriptionFormat"].Value, user.Email)</p>
            </div>
            <SUIStatusBadge ToneValue="SUITone.Neutral">@L["Users.Detail.EmailConfirmedPending"]</SUIStatusBadge>
        </div>

        <SUIStack Row="true" AlignItems="center" Justify="between" Spacing="2" Wrap="true" Class="account-access-panel__actions">
            <span>@L["Users.Confirmation.ActionNote"]</span>
            <SUIButton Disabled="@busy" OnClick="ResendAsync" StartIcon="@(busy ? null : "inbox")">
                @if (busy)
                {
                    @L["Users.Confirmation.Sending"]
                }
                else
                {
                    @L["Users.Confirmation.SendButton"]
                }
            </SUIButton>
        </SUIStack>
    </section>
}
else if (user.Actions.ResendConfirmationRequiresMfa)
{
    <div class="decision-note decision-note--neutral"><SUIIcon Name="shield" Size="21" /><div><h2>@L["Users.Confirmation.MfaRequiredTitle"]</h2><p>@L["Users.Detail.MfaRequiredDescription"]</p></div></div>
}
else
{
    <div class="decision-note decision-note--neutral"><SUIIcon Name="lock" Size="21" /><div><h2>@L["Users.Confirmation.ForbiddenTitle"]</h2><p>@L["Users.Confirmation.ForbiddenDescription"]</p></div></div>
}
    </Success>
</ManagementDataView>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private ManagementDataResult<ManagementUserDetail>? result;
    private bool loading = true;
    private bool busy;
    private string DetailHref => $"users/{Uri.EscapeDataString(Id)}";
    private string HeaderTitle => result?.Value?.UserName ?? result?.Value?.Email ?? L["Users.Detail.Actions.ResendConfirmation"].Value;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        result = await UserData.GetAsync(Id);
        loading = false;
    }

    private async Task ResendAsync()
    {
        if (busy) return;
        busy = true;
        try
        {
            var resend = await UserData.ResendConfirmationAsync(Id);
            if (resend.IsSuccess)
            {
                Toast.Success(L["Users.Detail.ResendConfirmation.Sent"].Value);
            }
            else
            {
                Toast.Error(string.Format(
                    L["Users.Detail.ResendConfirmation.FailedFormat"].Value,
                    resend.ErrorMessage));
            }
        }
        finally
        {
            busy = false;
        }
    }
}
