@page "/service-accounts"
@attribute [Authorize(Policy = ManagementUiPolicies.Access)]
@inject NavigationManager Navigation

@* Service accounts were folded into system users: a server-side client is
   bound to a system user. Old links land on the system users page. *@

@code {
    protected override void OnInitialized() =>
        Navigation.NavigateTo("system-users", replace: true);
}
