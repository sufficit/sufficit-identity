@page "/service-accounts"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageClients)]
@using Sufficit.Identity.Management.ServiceAccounts
@using Sufficit.Identity.UI.Management.ServiceAccounts
@inject ManagementServiceAccountDataSource AccountData

<PageTitle>@L["ServiceAccounts.PageTitle"]</PageTitle>

<SUIPageHeader Title="@L["ServiceAccounts.HeaderTitle"].Value"
            Description="@L["ServiceAccounts.HeaderDescription"].Value">
    <Actions>
        <SUIButton ButtonTypeValue="SUIButtonType.Button"
                   ColorValue="SUIColor.Secondary"
                   OnClick="LoadAsync"
                   Disabled="@loading">
            <SUIIcon Name="refresh" Size="17" />
            @L["ServiceAccounts.Reload"]
        </SUIButton>
        <SUIButton ButtonTypeValue="SUIButtonType.Button"
                   OnClick="BeginCreate"
                   Disabled="@(loading || creating)">
            <SUIIcon Name="plus" Size="17" />
            @L["ServiceAccounts.NewAccount"]
        </SUIButton>
    </Actions>
</SUIPageHeader>

@if (createdSecret is not null)
{
    <SUIAlert ToneValue="SUITone.Warning" Icon="key" Class="service-account-alert">
        <div class="service-account-alert__copy">
            <strong>@L["ServiceAccounts.CreatedSecret.Title"]</strong>
            <span>
                @L["ServiceAccounts.CreatedSecret.AccountLabel"] <code>@createdSecret.Account.ClientId</code>. @L["ServiceAccounts.CreatedSecret.HashNote"]
            </span>
            <pre class="service-account-secret"><code>@createdSecret.ClientSecret</code></pre>
            <SUIButton ButtonTypeValue="SUIButtonType.Button"
                       ColorValue="SUIColor.Secondary"
                       OnClick="() => createdSecret = null">
                @L["ServiceAccounts.CreatedSecret.Acknowledge"]
            </SUIButton>
        </div>
    </SUIAlert>
}

@if (showCreate)
{
    <section class="sa-create" aria-label="@L["ServiceAccounts.Create.AriaLabel"].Value">
        <header class="sa-create__header">
            <h2>@L["ServiceAccounts.Create.AriaLabel"]</h2>
            <p>
                @L["ServiceAccounts.Create.DescriptionPrefix"]
                <code>client_credentials</code> @L["ServiceAccounts.Create.DescriptionSuffix"]
            </p>
        </header>

        <div class="sa-create__fields" data-sui-align-row>
            <SUITextField T="string"
                          id="service-account-client-id"
                          aria-label="@L["ServiceAccounts.Field.IdentifierAriaLabel"].Value"
                          Label="@L["ServiceAccounts.Field.IdentifierLabel"].Value"
                          HelperText="@L["ServiceAccounts.Field.IdentifierHelp"].Value"
                          Placeholder="@L["ServiceAccounts.Field.IdentifierPlaceholder"].Value"
                          MaxLength="100"
                          Disabled="@creating"
                          Value="@draftClientId"
                          ValueChanged="ClientIdChanged"
                          autocomplete="off" />

            <SUITextField T="string"
                          id="service-account-display-name"
                          aria-label="@L["ServiceAccounts.Field.DisplayNameAriaLabel"].Value"
                          Label="@L["ServiceAccounts.Field.DisplayNameLabel"].Value"
                          HelperText="@L["ServiceAccounts.Field.DisplayNameHelp"].Value"
                          Placeholder="@L["ServiceAccounts.Field.DisplayNamePlaceholder"].Value"
                          MaxLength="200"
                          Disabled="@creating"
                          Value="@draftDisplayName"
                          ValueChanged="DisplayNameChanged"
                          autocomplete="off" />
        </div>

        <fieldset class="sa-create__roles">
            <legend>@L["ServiceAccounts.Roles"]</legend>
            @if (workspace is null || workspace.KnownRoles.Count == 0)
            {
                <p class="sa-create__empty-roles">
                    @L["ServiceAccounts.NoRoles.DescriptionPrefix"]
                    (<code>Management:Authorization:RoleCapabilities</code>)@L["ServiceAccounts.NoRoles.DescriptionSuffix"]
                </p>
            }
            else
            {
                <div class="sa-role-picker" role="group" aria-label="@L["ServiceAccounts.RolePicker.NewAccountAriaLabel"].Value">
                    @foreach (var option in workspace.KnownRoles)
                    {
                        <label class="sa-role-picker__option">
                            <input type="checkbox"
                                   checked="@createRoles.Contains(option.Role)"
                                   disabled="@creating"
                                   @onchange="e => ToggleCreateRole(option.Role, e)" />
                            <span>
                                @option.Role
                                @if (option.IsFullAdministrator)
                                {
                                    <strong>@L["ServiceAccounts.FullAdministratorSuffixCreate"]</strong>
                                }
                            </span>
                        </label>
                    }
                </div>
            }
        </fieldset>

        <footer class="sa-create__actions">
            <SUILoadingButton IsLoading="@creating"
                              Disabled="@(creating || string.IsNullOrWhiteSpace(draftClientId))"
                              ColorValue="SUIColor.Primary"
                              OnClick="CreateAsync"
                              aria-busy="@creating">
                <SUIIcon Name="plus" Size="17" />
                <span>@L["ServiceAccounts.CreateSubmit"]</span>
            </SUILoadingButton>
            <SUIButton ButtonTypeValue="SUIButtonType.Button"
                       ColorValue="SUIColor.Secondary"
                       Disabled="@creating"
                       OnClick="CancelCreate">
                @L["ServiceAccounts.Cancel"]
            </SUIButton>
        </footer>
    </section>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="inline-notice inline-notice--danger" role="alert">
        <SUIIcon Name="alert" Size="19" />
        <div>
            <strong>@L["ServiceAccounts.Error.Title"]</strong>
            <span>@errorMessage</span>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="inline-notice inline-notice--success" role="status">
        <SUIIcon Name="check" Size="19" />
        <div><span>@successMessage</span></div>
    </div>
}

@if (loading)
{
    <p aria-busy="true">@L["ServiceAccounts.Loading"]</p>
}
else if (workspace is null || workspace.Accounts.Count == 0)
{
    <SUIEmptyState Icon="server"
                Title="@L["ServiceAccounts.Empty.Title"].Value"
                Description="@L["ServiceAccounts.Empty.Description"].Value">
    </SUIEmptyState>
}
else
{
    <table class="data-table service-accounts-table" aria-label="@L["ServiceAccounts.Table.AriaLabel"].Value">
        <thead>
            <tr>
                <th>@L["ServiceAccounts.Column.Client"]</th>
                <th>@L["ServiceAccounts.Roles"]</th>
                <th>@L["ServiceAccounts.Column.ResultingCapabilities"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var account in workspace.Accounts)
            {
                var editing = editingClientId == account.ClientId;
                <tr>
                    <td>
                        <strong>@(account.DisplayName ?? account.ClientId)</strong>
                        <div><code>@account.ClientId</code></div>
                        @if (!account.CanRequestTokens)
                        {
                            @* A role without a grant is orphaned configuration: the client
                               cannot issue any token, so its roles do nothing — but they
                               remain declared, and that is exactly the kind of residue
                               that only a screen catches. *@
                            <span class="sa-tag sa-tag--warning">@L["ServiceAccounts.NoGrantTag"]</span>
                        }
                    </td>
                    <td>
                        @if (editing)
                        {
                            <div class="sa-role-picker" role="group" aria-label="@string.Format(L["ServiceAccounts.RolePicker.AccountAriaLabelFormat"].Value, account.ClientId)">
                                @foreach (var option in workspace.KnownRoles)
                                {
                                    <label class="sa-role-picker__option">
                                        <input type="checkbox"
                                               checked="@draftRoles.Contains(option.Role)"
                                               @onchange="e => ToggleRole(option.Role, e.Value)" />
                                        <span>
                                            @option.Role
                                            @if (option.IsFullAdministrator)
                                            {
                                                <em>@L["ServiceAccounts.FullAdministratorSuffixEdit"]</em>
                                            }
                                        </span>
                                    </label>
                                }
                            </div>
                        }
                        else if (account.Roles.Count == 0)
                        {
                            <span class="sa-muted">@L["ServiceAccounts.NoneRolesMasculine"]</span>
                        }
                        else
                        {
                            @foreach (var role in account.Roles)
                            {
                                <span class="sa-tag">@role</span>
                            }
                        }
                    </td>
                    <td>
                        @if (account.Capabilities.Count == 0)
                        {
                            <span class="sa-muted">@L["ServiceAccounts.NoneCapabilitiesFeminine"]</span>
                        }
                        else
                        {
                            <details>
                                <summary>@string.Format(L["ServiceAccounts.CapabilityCountFormat"].Value, account.Capabilities.Count)</summary>
                                <ul class="sa-capabilities">
                                    @foreach (var capability in account.Capabilities)
                                    {
                                        <li><code>@capability</code></li>
                                    }
                                </ul>
                            </details>
                        }
                    </td>
                    <td class="sa-actions">
                        @if (editing)
                        {
                            <SUILoadingButton IsLoading="@saving"
                                              Disabled="@saving"
                                              ColorValue="SUIColor.Primary"
                                              OnClick="() => SaveAsync(account.ClientId)">
                                @L["ServiceAccounts.Save"]
                            </SUILoadingButton>
                            <SUIButton ButtonTypeValue="SUIButtonType.Button"
                                       ColorValue="SUIColor.Secondary"
                                       Disabled="@saving"
                                       OnClick="CancelEdit">
                                @L["ServiceAccounts.Cancel"]
                            </SUIButton>
                        }
                        else
                        {
                            <SUIButton ButtonTypeValue="SUIButtonType.Button"
                                       ColorValue="SUIColor.Secondary"
                                       OnClick="() => BeginEdit(account)">
                                @L["ServiceAccounts.EditRoles"]
                            </SUIButton>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="inline-notice sa-footnote" role="note">
        <SUIIcon Name="info" Size="17" />
        <div>
            <span>
                @L["ServiceAccounts.Footnote.Prefix"]
                (<code>Management:Authorization:RoleCapabilities</code>)@L["ServiceAccounts.Footnote.Middle"]
                <strong>@L["ServiceAccounts.Footnote.Who"]</strong> @L["ServiceAccounts.Footnote.Suffix"]
            </span>
        </div>
    </div>
}

@code {
    private ServiceAccountWorkspace? workspace;
    private bool loading = true;
    private bool saving;
    private string? errorMessage;
    private string? successMessage;
    private string? editingClientId;
    private readonly HashSet<string> draftRoles = new(StringComparer.OrdinalIgnoreCase);

    private bool showCreate;
    private bool creating;
    private string draftClientId = string.Empty;
    private string draftDisplayName = string.Empty;
    private readonly HashSet<string> createRoles = new(StringComparer.OrdinalIgnoreCase);
    // Kept outside successMessage on purpose: the secret only appears once
    // and disappears through an explicit operator action, not on the next reload.
    private ServiceAccountCreated? createdSecret;

    protected override Task OnInitializedAsync() => LoadAsync();

    private void ClientIdChanged(string? value)
    {
        draftClientId = value ?? string.Empty;
    }

    private void DisplayNameChanged(string? value)
    {
        draftDisplayName = value ?? string.Empty;
    }

    private void BeginCreate()
    {
        showCreate = true;
        errorMessage = null;
        successMessage = null;
        draftClientId = string.Empty;
        draftDisplayName = string.Empty;
        createRoles.Clear();
    }

    private void CancelCreate()
    {
        showCreate = false;
        createRoles.Clear();
    }

    private void ToggleCreateRole(string role, ChangeEventArgs args)
    {
        if (args.Value is true)
        {
            createRoles.Add(role);
        }
        else
        {
            createRoles.Remove(role);
        }
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(draftClientId))
        {
            return;
        }

        creating = true;
        errorMessage = null;
        successMessage = null;

        var result = await AccountData.CreateAsync(
            draftClientId.Trim(),
            string.IsNullOrWhiteSpace(draftDisplayName) ? null : draftDisplayName.Trim(),
            createRoles.ToArray());

        if (result.IsSuccess)
        {
            createdSecret = result.Value;
            showCreate = false;
            createRoles.Clear();
            successMessage = string.Format(L["ServiceAccounts.Created.SuccessFormat"].Value, result.Value!.Account.ClientId);
            await LoadAsync();
            // LoadAsync clears the messages; the secret's message has to survive.
            successMessage = string.Format(L["ServiceAccounts.Created.SuccessFormat"].Value, createdSecret!.Account.ClientId);
        }
        else
        {
            errorMessage = result.ErrorMessage;
        }

        creating = false;
    }

    private async Task LoadAsync()
    {
        loading = true;
        errorMessage = null;
        successMessage = null;
        editingClientId = null;

        var result = await AccountData.GetWorkspaceAsync();
        if (result.IsSuccess)
        {
            workspace = result.Value;
        }
        else
        {
            errorMessage = result.ErrorMessage;
        }

        loading = false;
    }

    private void BeginEdit(ServiceAccountSummary account)
    {
        editingClientId = account.ClientId;
        successMessage = null;
        errorMessage = null;
        draftRoles.Clear();
        foreach (var role in account.Roles)
        {
            draftRoles.Add(role);
        }
    }

    private void CancelEdit()
    {
        editingClientId = null;
        draftRoles.Clear();
    }

    private void ToggleRole(string role, object? value)
    {
        if (value is bool selected && selected)
        {
            draftRoles.Add(role);
        }
        else
        {
            draftRoles.Remove(role);
        }
    }

    private async Task SaveAsync(string clientId)
    {
        saving = true;
        errorMessage = null;

        var result = await AccountData.SetRolesAsync(clientId, draftRoles.ToArray());
        if (result.IsSuccess && workspace is not null)
        {
            var updated = workspace.Accounts
                .Select(account => account.ClientId == clientId ? result.Value! : account)
                .ToArray();
            workspace = workspace with { Accounts = updated };
            successMessage = draftRoles.Count == 0
                ? string.Format(L["ServiceAccounts.RolesRemovedFormat"].Value, clientId)
                : string.Format(L["ServiceAccounts.RolesUpdatedFormat"].Value, clientId);
            editingClientId = null;
        }
        else if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
        }

        saving = false;
    }
}
