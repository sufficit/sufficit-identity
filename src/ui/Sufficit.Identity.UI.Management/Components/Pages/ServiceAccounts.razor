@page "/service-accounts"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageClients)]
@using Sufficit.Identity.Management.ServiceAccounts
@using Sufficit.Identity.UI.Management.ServiceAccounts
@inject ManagementServiceAccountDataSource AccountData

<PageTitle>Contas de sistema | Sufficit Identity</PageTitle>

<SUIPageHeader Title="Contas de sistema"
            Description="Serviços que se autenticam sozinhos (client_credentials) e recebem capacidades de gestão por papéis declarados no próprio registro. Revogar um papel vale na próxima requisição — nenhum token precisa expirar.">
    <Actions>
        <SUIButton ButtonTypeValue="SUIButtonType.Button"
                   ColorValue="SUIColor.Secondary"
                   OnClick="LoadAsync"
                   Disabled="@loading">
            <SUIIcon Name="refresh" Size="17" />
            Recarregar
        </SUIButton>
        <SUIButton ButtonTypeValue="SUIButtonType.Button"
                   OnClick="BeginCreate"
                   Disabled="@(loading || creating)">
            <SUIIcon Name="plus" Size="17" />
            Nova conta
        </SUIButton>
    </Actions>
</SUIPageHeader>

@if (createdSecret is not null)
{
    <SUIAlert ToneValue="SUITone.Warning" Icon="key" Class="service-account-alert">
        <div class="service-account-alert__copy">
            <strong>Copie o segredo agora — ele não será exibido de novo</strong>
            <span>
                Conta <code>@createdSecret.Account.ClientId</code>. O segredo é
                guardado apenas como hash; se perder, só resta rotacionar.
            </span>
            <pre class="service-account-secret"><code>@createdSecret.ClientSecret</code></pre>
            <SUIButton ButtonTypeValue="SUIButtonType.Button"
                       ColorValue="SUIColor.Secondary"
                       OnClick="() => createdSecret = null">
                Já copiei
            </SUIButton>
        </div>
    </SUIAlert>
}

@if (showCreate)
{
    <section class="sa-create" aria-label="Nova conta de sistema">
        <header class="sa-create__header">
            <h2>Nova conta de sistema</h2>
            <p>
                A conta é criada como cliente confidencial com
                <code>client_credentials</code> — sem redirect e sem fluxo
                interativo, porque não há usuário nessa história. O segredo é
                gerado pelo servidor e mostrado uma única vez.
            </p>
        </header>

        <div class="sa-create__fields" data-sui-align-row>
            <SUITextField T="string"
                          id="service-account-client-id"
                          aria-label="Identificador"
                          Label="Identificador (client_id)"
                          HelperText="Como o serviço se identifica no endpoint de token."
                          Placeholder="Ex.: billing-sync"
                          MaxLength="100"
                          Disabled="@creating"
                          Value="@draftClientId"
                          ValueChanged="ClientIdChanged"
                          autocomplete="off" />

            <SUITextField T="string"
                          id="service-account-display-name"
                          aria-label="Nome de exibição"
                          Label="Nome de exibição"
                          HelperText="Opcional. Aparece na lista e na auditoria."
                          Placeholder="Ex.: Sincronização de faturamento"
                          MaxLength="200"
                          Disabled="@creating"
                          Value="@draftDisplayName"
                          ValueChanged="DisplayNameChanged"
                          autocomplete="off" />
        </div>

        <fieldset class="sa-create__roles">
            <legend>Papéis</legend>
            @if (workspace is null || workspace.KnownRoles.Count == 0)
            {
                <p class="sa-create__empty-roles">
                    Esta implantação não declara papéis
                    (<code>Management:Authorization:RoleCapabilities</code>).
                    A conta pode ser criada sem papel e recebê-los depois.
                </p>
            }
            else
            {
                <div class="sa-role-picker" role="group" aria-label="Papéis da nova conta">
                    @foreach (var option in workspace.KnownRoles)
                    {
                        <label class="sa-role-picker__option">
                            <input type="checkbox"
                                   checked="@createRoles.Contains(option.Role)"
                                   disabled="@creating"
                                   @onchange="e => ToggleCreateRole(option.Role, e)" />
                            <span>
                                @option.Role
                                @if (option.IsFullAdministrator)
                                {
                                    <strong> — administrador pleno</strong>
                                }
                            </span>
                        </label>
                    }
                </div>
            }
        </fieldset>

        <footer class="sa-create__actions">
            <SUILoadingButton IsLoading="@creating"
                              Disabled="@(creating || string.IsNullOrWhiteSpace(draftClientId))"
                              ColorValue="SUIColor.Primary"
                              OnClick="CreateAsync"
                              aria-busy="@creating">
                <SUIIcon Name="plus" Size="17" />
                <span>Criar conta</span>
            </SUILoadingButton>
            <SUIButton ButtonTypeValue="SUIButtonType.Button"
                       ColorValue="SUIColor.Secondary"
                       Disabled="@creating"
                       OnClick="CancelCreate">
                Cancelar
            </SUIButton>
        </footer>
    </section>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="inline-notice inline-notice--danger" role="alert">
        <SUIIcon Name="alert" Size="19" />
        <div>
            <strong>Não foi possível concluir</strong>
            <span>@errorMessage</span>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="inline-notice inline-notice--success" role="status">
        <SUIIcon Name="check" Size="19" />
        <div><span>@successMessage</span></div>
    </div>
}

@if (loading)
{
    <p aria-busy="true">Carregando contas de sistema…</p>
}
else if (workspace is null || workspace.Accounts.Count == 0)
{
    <SUIEmptyState Icon="server"
                Title="Nenhuma conta de sistema"
                Description="Nenhum cliente tem o grant client_credentials nem papéis declarados. Conceda o grant no registro do cliente para que ele apareça aqui.">
    </SUIEmptyState>
}
else
{
    <table class="data-table service-accounts-table" aria-label="Contas de sistema">
        <thead>
            <tr>
                <th>Cliente</th>
                <th>Papéis</th>
                <th>Capacidades resultantes</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var account in workspace.Accounts)
            {
                var editing = editingClientId == account.ClientId;
                <tr>
                    <td>
                        <strong>@(account.DisplayName ?? account.ClientId)</strong>
                        <div><code>@account.ClientId</code></div>
                        @if (!account.CanRequestTokens)
                        {
                            @* Papel sem grant é configuração órfã: o cliente não
                               consegue emitir token nenhum, então os papéis dele
                               não fazem nada — mas continuam declarados, e é
                               exatamente o tipo de resíduo que só uma tela acha. *@
                            <span class="sa-tag sa-tag--warning">sem grant client_credentials</span>
                        }
                    </td>
                    <td>
                        @if (editing)
                        {
                            <div class="sa-role-picker" role="group" aria-label="Papéis de @account.ClientId">
                                @foreach (var option in workspace.KnownRoles)
                                {
                                    <label class="sa-role-picker__option">
                                        <input type="checkbox"
                                               checked="@draftRoles.Contains(option.Role)"
                                               @onchange="e => ToggleRole(option.Role, e.Value)" />
                                        <span>
                                            @option.Role
                                            @if (option.IsFullAdministrator)
                                            {
                                                <em> — administrador total</em>
                                            }
                                        </span>
                                    </label>
                                }
                            </div>
                        }
                        else if (account.Roles.Count == 0)
                        {
                            <span class="sa-muted">nenhum</span>
                        }
                        else
                        {
                            @foreach (var role in account.Roles)
                            {
                                <span class="sa-tag">@role</span>
                            }
                        }
                    </td>
                    <td>
                        @if (account.Capabilities.Count == 0)
                        {
                            <span class="sa-muted">nenhuma</span>
                        }
                        else
                        {
                            <details>
                                <summary>@account.Capabilities.Count capacidade(s)</summary>
                                <ul class="sa-capabilities">
                                    @foreach (var capability in account.Capabilities)
                                    {
                                        <li><code>@capability</code></li>
                                    }
                                </ul>
                            </details>
                        }
                    </td>
                    <td class="sa-actions">
                        @if (editing)
                        {
                            <SUILoadingButton IsLoading="@saving"
                                              Disabled="@saving"
                                              ColorValue="SUIColor.Primary"
                                              OnClick="() => SaveAsync(account.ClientId)">
                                Salvar
                            </SUILoadingButton>
                            <SUIButton ButtonTypeValue="SUIButtonType.Button"
                                       ColorValue="SUIColor.Secondary"
                                       Disabled="@saving"
                                       OnClick="CancelEdit">
                                Cancelar
                            </SUIButton>
                        }
                        else
                        {
                            <SUIButton ButtonTypeValue="SUIButtonType.Button"
                                       ColorValue="SUIColor.Secondary"
                                       OnClick="() => BeginEdit(account)">
                                Editar papéis
                            </SUIButton>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="inline-notice" role="note">
        <SUIIcon Name="info" Size="17" />
        <div>
            <span>
                O que cada papel significa vem da configuração da implantação
                (<code>Management:Authorization:RoleCapabilities</code>); esta tela decide apenas
                <strong>quem</strong> tem o papel. Um operador humano com o mesmo papel continua
                exigindo segundo fator — a isenção de MFA é da conta de sistema, e só para o que
                os papéis dela concedem.
            </span>
        </div>
    </div>
}

@code {
    private ServiceAccountWorkspace? workspace;
    private bool loading = true;
    private bool saving;
    private string? errorMessage;
    private string? successMessage;
    private string? editingClientId;
    private readonly HashSet<string> draftRoles = new(StringComparer.OrdinalIgnoreCase);

    private bool showCreate;
    private bool creating;
    private string draftClientId = string.Empty;
    private string draftDisplayName = string.Empty;
    private readonly HashSet<string> createRoles = new(StringComparer.OrdinalIgnoreCase);
    // Mantido fora de successMessage de propósito: o segredo só aparece uma vez
    // e some por ação explícita do operador, não no próximo recarregamento.
    private ServiceAccountCreated? createdSecret;

    protected override Task OnInitializedAsync() => LoadAsync();

    private void ClientIdChanged(string? value)
    {
        draftClientId = value ?? string.Empty;
    }

    private void DisplayNameChanged(string? value)
    {
        draftDisplayName = value ?? string.Empty;
    }

    private void BeginCreate()
    {
        showCreate = true;
        errorMessage = null;
        successMessage = null;
        draftClientId = string.Empty;
        draftDisplayName = string.Empty;
        createRoles.Clear();
    }

    private void CancelCreate()
    {
        showCreate = false;
        createRoles.Clear();
    }

    private void ToggleCreateRole(string role, ChangeEventArgs args)
    {
        if (args.Value is true)
        {
            createRoles.Add(role);
        }
        else
        {
            createRoles.Remove(role);
        }
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(draftClientId))
        {
            return;
        }

        creating = true;
        errorMessage = null;
        successMessage = null;

        var result = await AccountData.CreateAsync(
            draftClientId.Trim(),
            string.IsNullOrWhiteSpace(draftDisplayName) ? null : draftDisplayName.Trim(),
            createRoles.ToArray());

        if (result.IsSuccess)
        {
            createdSecret = result.Value;
            showCreate = false;
            createRoles.Clear();
            successMessage = $"Conta '{result.Value!.Account.ClientId}' criada.";
            await LoadAsync();
            // LoadAsync limpa as mensagens; a do segredo tem de sobreviver.
            successMessage = $"Conta '{createdSecret!.Account.ClientId}' criada.";
        }
        else
        {
            errorMessage = result.ErrorMessage;
        }

        creating = false;
    }

    private async Task LoadAsync()
    {
        loading = true;
        errorMessage = null;
        successMessage = null;
        editingClientId = null;

        var result = await AccountData.GetWorkspaceAsync();
        if (result.IsSuccess)
        {
            workspace = result.Value;
        }
        else
        {
            errorMessage = result.ErrorMessage;
        }

        loading = false;
    }

    private void BeginEdit(ServiceAccountSummary account)
    {
        editingClientId = account.ClientId;
        successMessage = null;
        errorMessage = null;
        draftRoles.Clear();
        foreach (var role in account.Roles)
        {
            draftRoles.Add(role);
        }
    }

    private void CancelEdit()
    {
        editingClientId = null;
        draftRoles.Clear();
    }

    private void ToggleRole(string role, object? value)
    {
        if (value is bool selected && selected)
        {
            draftRoles.Add(role);
        }
        else
        {
            draftRoles.Remove(role);
        }
    }

    private async Task SaveAsync(string clientId)
    {
        saving = true;
        errorMessage = null;

        var result = await AccountData.SetRolesAsync(clientId, draftRoles.ToArray());
        if (result.IsSuccess && workspace is not null)
        {
            var updated = workspace.Accounts
                .Select(account => account.ClientId == clientId ? result.Value! : account)
                .ToArray();
            workspace = workspace with { Accounts = updated };
            successMessage = draftRoles.Count == 0
                ? $"Papéis removidos de {clientId}. A conta perde as capacidades na próxima requisição."
                : $"Papéis de {clientId} atualizados.";
            editingClientId = null;
        }
        else if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
        }

        saving = false;
    }
}
