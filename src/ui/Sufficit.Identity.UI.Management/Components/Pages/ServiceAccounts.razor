@page "/service-accounts"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageClients)]
@using Sufficit.Identity.Management.ServiceAccounts
@using Sufficit.Identity.UI.Management.ServiceAccounts
@inject ManagementServiceAccountDataSource AccountData

<PageTitle>Contas de sistema | Sufficit Identity</PageTitle>

<SUIPageHeader Title="Contas de sistema"
            Description="Serviços que se autenticam sozinhos (client_credentials) e recebem capacidades de gestão por papéis declarados no próprio registro. Revogar um papel vale na próxima requisição — nenhum token precisa expirar.">
    <Actions>
        <button class="button button--secondary" type="button" @onclick="LoadAsync" disabled="@loading">
            <SUIIcon Name="refresh" Size="17" />
            Recarregar
        </button>
    </Actions>
</SUIPageHeader>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="inline-notice inline-notice--danger" role="alert">
        <SUIIcon Name="alert" Size="19" />
        <div>
            <strong>Não foi possível concluir</strong>
            <span>@errorMessage</span>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="inline-notice inline-notice--success" role="status">
        <SUIIcon Name="check" Size="19" />
        <div><span>@successMessage</span></div>
    </div>
}

@if (loading)
{
    <p aria-busy="true">Carregando contas de sistema…</p>
}
else if (workspace is null || workspace.Accounts.Count == 0)
{
    <SUIEmptyState Icon="server"
                Title="Nenhuma conta de sistema"
                Description="Nenhum cliente tem o grant client_credentials nem papéis declarados. Conceda o grant no registro do cliente para que ele apareça aqui.">
    </SUIEmptyState>
}
else
{
    <table class="data-table" aria-label="Contas de sistema">
        <thead>
            <tr>
                <th>Cliente</th>
                <th>Papéis</th>
                <th>Capacidades resultantes</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var account in workspace.Accounts)
            {
                var editing = editingClientId == account.ClientId;
                <tr>
                    <td>
                        <strong>@(account.DisplayName ?? account.ClientId)</strong>
                        <div><code>@account.ClientId</code></div>
                        @if (!account.CanRequestTokens)
                        {
                            @* Papel sem grant é configuração órfã: o cliente não
                               consegue emitir token nenhum, então os papéis dele
                               não fazem nada — mas continuam declarados, e é
                               exatamente o tipo de resíduo que só uma tela acha. *@
                            <span class="badge badge--warning">sem grant client_credentials</span>
                        }
                    </td>
                    <td>
                        @if (editing)
                        {
                            <div class="role-picker" role="group" aria-label="Papéis de @account.ClientId">
                                @foreach (var option in workspace.KnownRoles)
                                {
                                    <label class="role-picker__option">
                                        <input type="checkbox"
                                               checked="@draftRoles.Contains(option.Role)"
                                               @onchange="e => ToggleRole(option.Role, e.Value)" />
                                        <span>
                                            @option.Role
                                            @if (option.IsFullAdministrator)
                                            {
                                                <em> — administrador total</em>
                                            }
                                        </span>
                                    </label>
                                }
                            </div>
                        }
                        else if (account.Roles.Count == 0)
                        {
                            <span class="text-muted">nenhum</span>
                        }
                        else
                        {
                            @foreach (var role in account.Roles)
                            {
                                <span class="badge">@role</span>
                            }
                        }
                    </td>
                    <td>
                        @if (account.Capabilities.Count == 0)
                        {
                            <span class="text-muted">nenhuma</span>
                        }
                        else
                        {
                            <details>
                                <summary>@account.Capabilities.Count capacidade(s)</summary>
                                <ul class="capability-list">
                                    @foreach (var capability in account.Capabilities)
                                    {
                                        <li><code>@capability</code></li>
                                    }
                                </ul>
                            </details>
                        }
                    </td>
                    <td class="data-table__actions">
                        @if (editing)
                        {
                            <button class="button button--primary" type="button"
                                    @onclick="() => SaveAsync(account.ClientId)" disabled="@saving">
                                Salvar
                            </button>
                            <button class="button button--secondary" type="button"
                                    @onclick="CancelEdit" disabled="@saving">
                                Cancelar
                            </button>
                        }
                        else
                        {
                            <button class="button button--secondary" type="button"
                                    @onclick="() => BeginEdit(account)">
                                Editar papéis
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="inline-notice" role="note">
        <SUIIcon Name="info" Size="17" />
        <div>
            <span>
                O que cada papel significa vem da configuração da implantação
                (<code>Management:Authorization:RoleCapabilities</code>); esta tela decide apenas
                <strong>quem</strong> tem o papel. Um operador humano com o mesmo papel continua
                exigindo segundo fator — a isenção de MFA é da conta de sistema, e só para o que
                os papéis dela concedem.
            </span>
        </div>
    </div>
}

@code {
    private ServiceAccountWorkspace? workspace;
    private bool loading = true;
    private bool saving;
    private string? errorMessage;
    private string? successMessage;
    private string? editingClientId;
    private readonly HashSet<string> draftRoles = new(StringComparer.OrdinalIgnoreCase);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        errorMessage = null;
        successMessage = null;
        editingClientId = null;

        var result = await AccountData.GetWorkspaceAsync();
        if (result.IsSuccess)
        {
            workspace = result.Value;
        }
        else
        {
            errorMessage = result.ErrorMessage;
        }

        loading = false;
    }

    private void BeginEdit(ServiceAccountSummary account)
    {
        editingClientId = account.ClientId;
        successMessage = null;
        errorMessage = null;
        draftRoles.Clear();
        foreach (var role in account.Roles)
        {
            draftRoles.Add(role);
        }
    }

    private void CancelEdit()
    {
        editingClientId = null;
        draftRoles.Clear();
    }

    private void ToggleRole(string role, object? value)
    {
        if (value is bool selected && selected)
        {
            draftRoles.Add(role);
        }
        else
        {
            draftRoles.Remove(role);
        }
    }

    private async Task SaveAsync(string clientId)
    {
        saving = true;
        errorMessage = null;

        var result = await AccountData.SetRolesAsync(clientId, draftRoles.ToArray());
        if (result.IsSuccess && workspace is not null)
        {
            var updated = workspace.Accounts
                .Select(account => account.ClientId == clientId ? result.Value! : account)
                .ToArray();
            workspace = workspace with { Accounts = updated };
            successMessage = draftRoles.Count == 0
                ? $"Papéis removidos de {clientId}. A conta perde as capacidades na próxima requisição."
                : $"Papéis de {clientId} atualizados.";
            editingClientId = null;
        }
        else if (!result.IsSuccess)
        {
            errorMessage = result.ErrorMessage;
        }

        saving = false;
    }
}
