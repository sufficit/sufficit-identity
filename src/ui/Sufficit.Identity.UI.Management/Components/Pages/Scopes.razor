@page "/scopes"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageScopes)]
@attribute [StreamRendering]
@inject ManagementScopeDataSource ScopeData

<PageTitle>Scopes OAuth | Sufficit Identity</PageTitle>

<SUIPageHeader Title="Scopes"
            Description="@L["Scopes.PageDescription"].Value">
    <Actions>
        <a class="button button--primary" href="scopes/new">
            <SUIIcon Name="plus" Size="17" />
            @L["Scopes.NewScope"]
        </a>
    </Actions>
</SUIPageHeader>

@if (Deleted is 1)
{
    <div class="inline-notice inline-notice--success" role="status">
        <SUIIcon Name="check" Size="19" />
        <div>
            <strong>@L["Scopes.Deleted.Title"]</strong>
            <span>@L["Scopes.Deleted.Description"]</span>
        </div>
    </div>
}

<div class="contract-strip contract-strip--info">
    <SUIIcon Name="scope" Size="20" />
    <div>
        <strong>@L["Scopes.CustomDefinitions.Title"]</strong>
        <span>@((MarkupString)L["Scopes.CustomDefinitions.Description"].Value)</span>
    </div>
    <SUIStatusBadge ToneValue="SUITone.Info">OAuth 2.0</SUIStatusBadge>
</div>

<div class="table-panel" aria-labelledby="scopes-list-heading" aria-busy="@loading">
    <div class="data-toolbar">
        <div>
            <h2 id="scopes-list-heading">@L["Scopes.List.Title"]</h2>
            <p>@L["Scopes.List.Description"]</p>
        </div>
        <div class="data-toolbar__actions">
            @if (AllScopes.Count > 0)
            {
                <label class="search-field">
                    <span class="visually-hidden">@L["Scopes.Search.Label"]</span>
                    <SUIIcon Name="search" Size="18" />
                    <input type="search"
                           placeholder="@L["Scopes.Search.Placeholder"].Value"
                           autocomplete="off"
                           @bind="search"
                           @bind:event="oninput" />
                </label>
            }
        </div>
    </div>

    <div class="client-results" aria-live="polite">
        @if (loading)
        {
            <div class="table-skeleton" aria-label="@L["Scopes.Loading"].Value">
                @for (var index = 0; index < 4; index++)
                {
                    <span></span>
                }
            </div>
        }
        else if (result?.IsSuccess is true)
        {
            @if (FilteredScopes.Count is 0)
            {
                <SUIEmptyState Icon="scope"
                            Title="@(AllScopes.Count is 0 ? L["Scopes.Empty.NoScopes.Title"].Value : L["Scopes.Empty.NoMatch.Title"].Value)"
                            Description="@(AllScopes.Count is 0 ? L["Scopes.Empty.NoScopes.Description"].Value : L["Scopes.Empty.NoMatch.Description"].Value)">
                    <Actions>
                        @if (AllScopes.Count is 0)
                        {
                            <a class="button button--primary" href="scopes/new">@L["Scopes.CreateFirst"]</a>
                        }
                        else
                        {
                            <button class="button button--secondary" type="button" @onclick="ClearSearch">@L["Scopes.ClearSearch"]</button>
                        }
                    </Actions>
                </SUIEmptyState>
            }
            else
            {
                <div class="table-scroll">
                    <table class="data-table data-table--scopes">
                        <thead>
                            <tr>
                                <th scope="col">@L["Scopes.Table.Scope"]</th>
                                <th scope="col">@L["Scopes.Table.Origin"]</th>
                                <th scope="col">@L["Scopes.Table.Resources"]</th>
                                <th scope="col">@L["Scopes.Table.Clients"]</th>
                                <th scope="col"><span class="visually-hidden">@L["Scopes.Table.Actions"]</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var scope in FilteredScopes)
                            {
                                <tr>
                                    <td data-label="@L["Scopes.Table.Scope"].Value">
                                        <a class="scope-identity" href="@ScopeHref(scope.Id)">
                                            <strong>@DisplayName(scope)</strong>
                                            <code>@scope.Name</code>
                                        </a>
                                    </td>
                                    <td data-label="@L["Scopes.Table.Origin"].Value">
                                        <SUIStatusBadge ToneValue="@(scope.IsManifestManaged ? SUITone.Info : SUITone.Neutral)">
                                            @(scope.IsManifestManaged ? L["Scopes.Origin.Manifest"] : L["Scopes.Origin.Manual"])
                                        </SUIStatusBadge>
                                    </td>
                                    <td data-label="@L["Scopes.Table.Resources"].Value">@scope.ResourceCount</td>
                                    <td data-label="@L["Scopes.Table.Clients"].Value">@scope.ClientCount</td>
                                    <td data-label="@L["Scopes.Table.Actions"].Value">
                                        <a class="row-action" href="@ScopeHref(scope.Id)">
                                            @L["Scopes.Details"]
                                            <SUIIcon Name="arrow-right" Size="15" />
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else
        {
            <SUIEmptyState Icon="alert"
                        Title="@ErrorTitle"
                        Description="@(result?.ErrorMessage ?? L["Scopes.Error.Fallback"].Value)">
                <Actions>
                    <button class="button button--secondary" type="button" @onclick="LoadAsync">@L["Scopes.Retry"]</button>
                </Actions>
            </SUIEmptyState>
        }
    </div>

    <footer class="table-footer">
        <span>@ResultCountLabel</span>
        <span>@L["Scopes.Footer.CanonicalRegistry"]</span>
    </footer>
</div>

<div class="client-guardrails" aria-labelledby="scope-safety-heading">
    <div>
        <h2 id="scope-safety-heading">@L["Scopes.SafetyHeading"]</h2>
        <p>@L["Scopes.SafetyDescription"]</p>
    </div>
    <ul>
        <li><SUIIcon Name="lock" Size="18" /> @L["Scopes.Safety.Immutable"]</li>
        <li><SUIIcon Name="workflow" Size="18" /> @L["Scopes.Safety.ManifestOnly"]</li>
        <li><SUIIcon Name="key" Size="18" /> @L["Scopes.Safety.DeleteBlocked"]</li>
    </ul>
</div>

@code {
    [SupplyParameterFromQuery(Name = "deleted")]
    public int Deleted { get; set; }

    private ManagementDataResult<IReadOnlyList<ManagementScopeSummary>>? result;
    private string search = string.Empty;
    private bool loading = true;

    private IReadOnlyList<ManagementScopeSummary> AllScopes =>
        result?.Value ?? [];

    private IReadOnlyList<ManagementScopeSummary> FilteredScopes =>
        string.IsNullOrWhiteSpace(search)
            ? AllScopes
            : AllScopes.Where(scope =>
                    scope.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
                    || (scope.DisplayName?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (scope.Description?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToArray();

    private string ErrorTitle =>
        result?.Outcome is ManagementDataOutcome.StepUpRequired
            ? L["Scopes.ErrorTitle.StepUp"].Value
            : result?.Outcome is ManagementDataOutcome.Forbidden
                ? L["Scopes.ErrorTitle.Forbidden"].Value
                : L["Scopes.ErrorTitle.Generic"].Value;

    private string ResultCountLabel =>
        loading
            ? L["Scopes.Loading"].Value
            : result?.IsSuccess is true
                ? L["Scopes.ResultCount.Format", FilteredScopes.Count, AllScopes.Count].Value
                : L["Scopes.ResultCount.None"].Value;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        result = await ScopeData.ListAsync();
        loading = false;
    }

    private void ClearSearch() => search = string.Empty;

    private static string ScopeHref(string id) =>
        $"scopes/{Uri.EscapeDataString(id)}";

    private static string DisplayName(ManagementScopeSummary scope) =>
        string.IsNullOrWhiteSpace(scope.DisplayName)
            ? scope.Name
            : scope.DisplayName;
}
