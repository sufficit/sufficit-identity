@page "/settings"
@attribute [Authorize(Policy = ManagementUiPolicies.Access)]
@inject ManagementOverviewDataSource OverviewData

@{ var overview = result?.Value!; }

<PageTitle>@L["Settings.PageTitle"]</PageTitle>

<SUIPageHeader Title="@L["Settings.HeaderTitle"].Value"
            Description="@L["Settings.HeaderDescription"].Value" />

<AuthorizeView Policy="@ManagementUiPolicies.ReadTrustedProxies">
    <a class="button button--secondary" href="settings/trusted-proxies">@L["Settings.ConfigureTrustedProxies"]</a>
</AuthorizeView>

@if (loading)
{
    <div class="detail-shell"
             aria-busy="true"
             aria-label="@L["Settings.LoadingAriaLabel"].Value">
        <div class="detail-skeleton"></div>
        <div class="detail-skeleton detail-skeleton--short"></div>
    </div>
}
else if (result?.IsSuccess is not true || result.Value is null)
{
    <div>
        <SUIEmptyState Icon="alert"
                    Title="@L["Settings.LoadError.Title"].Value"
                    Description="@(result?.ErrorMessage ?? L["Settings.LoadError.Description"].Value)">
            <Actions>
                <button class="button button--primary"
                        type="button"
                        @onclick="RefreshAsync">
                    @L["Settings.Retry"]
                </button>
            </Actions>
        </SUIEmptyState>
    </div>
}
else
{
    <div class="contract-strip contract-strip--info">
        <SUIIcon Name="settings" Size="20" />
        <div>
            <strong>@L["Settings.ProvidedByService.Title"]</strong>
            <span>@L["Settings.ProvidedByService.Description"]</span>
        </div>
        <SUIStatusBadge ToneValue="SUITone.Info">@overview.EnvironmentName</SUIStatusBadge>
    </div>

    <div class="settings-grid">
        <div class="settings-panel" aria-labelledby="policy-settings-heading">
            <div class="panel-header">
                <div>
                    <h2 id="policy-settings-heading">@L["Settings.OperatorPolicy.Title"]</h2>
                </div>
            </div>
            <dl class="config-list">
                <div>
                    <dt>
                        <span>@L["Settings.Field.Capabilities"]</span>
                        <code>Capabilities</code>
                    </dt>
                    <dd>
                        <span class="config-value">@overview.Operator.Capabilities.Count</span>
                        <SUIStatusBadge ToneValue="SUITone.Success">@L["Settings.Calculated"]</SUIStatusBadge>
                    </dd>
                </div>
                <div>
                    <dt>
                        <span>@L["Settings.Field.Mfa"]</span>
                        <code>RequireMfa</code>
                    </dt>
                    <dd>
                        <span class="config-value">
                            @(overview.Operator.RequiresMfa ? L["Settings.Mandatory"].Value : L["Settings.Optional"].Value)
                        </span>
                        <SUIStatusBadge ToneValue="@IdentitySuiTone.From(MfaTone)">@MfaStatus</SUIStatusBadge>
                    </dd>
                </div>
                <div>
                    <dt>
                        <span>@L["Settings.Field.AuthorizedModules"]</span>
                        <code>CanAccess</code>
                    </dt>
                    <dd>
                        <span class="config-value">@L["Settings.ModuleCountFormat", AccessibleModuleCount, overview.Modules.Count]</span>
                        <SUIStatusBadge ToneValue="SUITone.Neutral">@L["Settings.ThisSession"]</SUIStatusBadge>
                    </dd>
                </div>
            </dl>
        </div>

        <div class="settings-panel" aria-labelledby="transport-settings-heading">
            <div class="panel-header">
                <div>
                    <h2 id="transport-settings-heading">@L["Settings.HttpTransport.Title"]</h2>
                </div>
            </div>
            <dl class="config-list">
                <div>
                    <dt>
                        <span>@L["Settings.Field.ConfiguredPrefix"]</span>
                        <code>RoutePrefix</code>
                    </dt>
                    <dd>
                        <span class="config-value"><code>/@overview.Api.RoutePrefix</code></span>
                        <SUIStatusBadge ToneValue="SUITone.Neutral">@L["Settings.Route"]</SUIStatusBadge>
                    </dd>
                </div>
                <div>
                    <dt>
                        <span>@L["Settings.Field.TransportAuthorization"]</span>
                        <code>RequireAuthorization</code>
                    </dt>
                    <dd>
                        <span class="config-value">
                            @(overview.Api.RequiresAuthorization ? L["Settings.Mandatory"].Value : L["Settings.Disabled"].Value)
                        </span>
                        <SUIStatusBadge ToneValue="@(overview.Api.RequiresAuthorization ? SUITone.Success : SUITone.Warning)">
                            @(overview.Api.RequiresAuthorization ? L["Settings.Protected"].Value : L["Settings.Review"].Value)
                        </SUIStatusBadge>
                    </dd>
                </div>
                <div>
                    <dt>
                        <span>@L["Settings.Field.RequiredScope"]</span>
                        <code>RequiredScope</code>
                    </dt>
                    <dd>
                        <span class="config-value"><code>@overview.Api.RequiredScope</code></span>
                        <SUIStatusBadge ToneValue="SUITone.Info">OAuth</SUIStatusBadge>
                    </dd>
                </div>
            </dl>
        </div>
    </div>

    <div class="settings-panel" aria-labelledby="module-settings-heading">
        <div class="panel-header">
            <div>
                <h2 id="module-settings-heading">@L["Settings.ModuleCatalog.Title"]</h2>
            </div>
            <span class="section-meta">@L["Settings.ReportedByRuntime"]</span>
        </div>
        <dl class="config-list">
            @foreach (var module in Modules)
            {
                <div>
                    <dt>
                        <span>@module.Presentation.Title</span>
                        <code>@module.Contract.Key</code>
                    </dt>
                    <dd>
                        <span class="config-value">@ModuleDescription(module.Contract)</span>
                        <SUIStatusBadge ToneValue="@IdentitySuiTone.From(ModuleTone(module.Contract))">
                            @ModuleStatus(module.Contract)
                        </SUIStatusBadge>
                    </dd>
                </div>
            }
        </dl>
    </div>
}

@code {
    [CascadingParameter(Name = "ManagementOverview")]
    public ManagementDataResult<ManagementOverview>? CascadedOverview
    {
        get;
        set;
    }

    private ManagementDataResult<ManagementOverview>? result;
    private bool loading = true;
    private bool initialized;

    private ManagementOverview Overview =>
        result?.Value
        ?? throw new InvalidOperationException(
            "Overview is only available after a successful load.");

    private IReadOnlyList<ModuleView> Modules =>
        Overview.Modules
            .Select(CreateModuleView)
            .OfType<ModuleView>()
            .OrderBy(item => item.Presentation.SectionOrder)
            .ThenBy(item => item.Presentation.Order)
            .ToArray();

    private int AccessibleModuleCount =>
        Overview.Modules.Count(module => module.CanAccess);

    private string MfaStatus =>
        !Overview.Operator.RequiresMfa
            ? L["Settings.Mfa.NotRequired"].Value
            : Overview.Operator.MeetsMfaRequirement
                ? L["Settings.Mfa.Met"].Value
                : L["Settings.Mfa.Pending"].Value;

    private string MfaTone =>
        Overview.Operator is
            { RequiresMfa: true, MeetsMfaRequirement: false }
            ? "warning"
            : "success";

    protected override async Task OnParametersSetAsync()
    {
        if (initialized)
        {
            return;
        }

        initialized = true;
        if (CascadedOverview is not null)
        {
            result = CascadedOverview;
            loading = false;
            return;
        }

        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        loading = true;
        result = await OverviewData.GetAsync();
        loading = false;
    }

    private string ModuleStatus(ManagementModuleDescriptor module) =>
        !module.IsAvailable
            ? L["Settings.Module.Unavailable"].Value
            : module.AccessOutcome is ManagementAuthorizationOutcome.Allowed
                ? L["Settings.Module.Allowed"].Value
                : module.AccessOutcome is
                    ManagementAuthorizationOutcome.StepUpRequired
                    ? L["Settings.Module.MfaRequired"].Value
                    : L["Settings.Module.NoCapability"].Value;

    private static string ModuleTone(ManagementModuleDescriptor module) =>
        !module.IsAvailable
            ? "neutral"
            : module.AccessOutcome is ManagementAuthorizationOutcome.Allowed
                ? "success"
                : module.AccessOutcome is
                    ManagementAuthorizationOutcome.StepUpRequired
                    ? "warning"
                    : "neutral";

    private string ModuleDescription(
        ManagementModuleDescriptor module) =>
        !module.IsAvailable
            ? L["Settings.Module.NotAvailableDescription"].Value
            : module.RequiredCapability ?? L["Settings.Module.NoCapabilityDeclared"].Value;

    private ModuleView? CreateModuleView(
        ManagementModuleDescriptor module)
    {
        var presentation = ManagementModulePresentations.Find(module.Key, L);
        return presentation is null
            ? null
            : new ModuleView(module, presentation);
    }

    private sealed record ModuleView(
        ManagementModuleDescriptor Contract,
        ManagementModulePresentation Presentation);
}
