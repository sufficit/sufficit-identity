@page "/scopes/new"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageScopes)]
@inject ManagementScopeDataSource ScopeData
@inject NavigationManager Navigation

<PageTitle>@L["Scopes.Create.PageTitle"]</PageTitle>

<SUIPageHeader Title="@L["Scopes.NewScope"].Value"
            Description="@L["Scopes.Create.HeaderDescription"].Value">
    <Actions>
        <a class="button button--secondary" href="scopes">
            <SUIIcon Name="arrow-left" Size="17" />
            @L["Scopes.BackToScopes"]
        </a>
    </Actions>
</SUIPageHeader>

<div class="contract-strip contract-strip--success">
    <SUIIcon Name="shield" Size="20" />
    <div>
        <strong>@L["Scopes.Create.Validation.Title"]</strong>
        <span>@L["Scopes.Create.Validation.Description"]</span>
    </div>
    <SUIStatusBadge ToneValue="SUITone.Success">@L["Scopes.Canonical"]</SUIStatusBadge>
</div>

@if (submission?.IsSuccess is false)
{
    <div class="inline-notice inline-notice--danger" role="alert">
        <SUIIcon Name="alert" Size="19" />
        <div>
            <strong>@L["Scopes.Create.Error.Title"]</strong>
            <span>@submission.ErrorMessage</span>
        </div>
    </div>
}

<EditForm Model="model"
          OnValidSubmit="CreateAsync"
          FormName="create-oauth-scope"
          class="management-form"
          Context="definition">
    <DataAnnotationsValidator />

    <div class="form-section" aria-labelledby="scope-identity-heading">
        <div class="form-section__heading">
            <h2 id="scope-identity-heading">@L["Scopes.Identification.Title"]</h2>
            <p>@L["Scopes.Identification.Description"]</p>
        </div>
        <SUIFormGrid Columns="2" Spacing="4" LabelLines="2">
            <SUITextField T="string"
                          id="scope-name"
                          Label="@L["Scopes.Field.Name.Label"].Value"
                          HelperText="@L["Scopes.Field.Name.Helper"].Value"
                          MaxLength="200"
                          ErrorText="@ErrorFor(definition, nameof(model.Name))"
                          autocomplete="off"
                          @bind-Value="model.Name" />
            <SUITextField T="string"
                          id="scope-display-name"
                          Label="@L["Scopes.Field.DisplayName.Label"].Value"
                          HelperText="@L["Scopes.Field.DisplayName.Helper"].Value"
                          MaxLength="200"
                          ErrorText="@ErrorFor(definition, nameof(model.DisplayName))"
                          autocomplete="off"
                          @bind-Value="model.DisplayName" />
        </SUIFormGrid>
        <SUIFormGrid Columns="1" Spacing="4">
            <SUITextField T="string"
                          id="scope-description"
                          Label="@L["Scopes.Field.Description.Label"].Value"
                          HelperText="@L["Scopes.Field.Description.Helper"].Value"
                          Multiline
                          MaxLength="1000"
                          ErrorText="@ErrorFor(definition, nameof(model.Description))"
                          @bind-Value="model.Description" />
        </SUIFormGrid>
    </div>

    <div class="form-section" aria-labelledby="scope-resources-heading">
        <div class="form-section__heading">
            <h2 id="scope-resources-heading">@L["Scopes.Resources.Title"]</h2>
            <p>@L["Scopes.Resources.Description"]</p>
        </div>
        <SUIFormGrid Columns="1" Spacing="4">
            <SUITextField T="string"
                          id="scope-resources"
                          Label="@L["Scopes.Field.Resources.Label"].Value"
                          HelperText="@L["Scopes.Field.Resources.Helper"].Value"
                          Multiline
                          @bind-Value="model.Resources" />
        </SUIFormGrid>
    </div>

    <footer class="form-actions">
        <a class="button button--secondary" href="scopes">@L["Scopes.Cancel"]</a>
        <button class="button button--primary" type="submit" disabled="@submitting">
            @if (submitting)
            {
                <span class="button-spinner" aria-hidden="true"></span>
                <span>@L["Scopes.Create.Submitting"]</span>
            }
            else
            {
                <SUIIcon Name="plus" Size="17" />
                <span>@L["Scopes.Create.Submit"]</span>
            }
        </button>
    </footer>
</EditForm>

@code {
    private readonly ScopeCreateModel model = new();
    private ManagementDataResult<ManagementScopeDetail>? submission;
    private bool submitting;

    protected override void OnInitialized() => model.Localizer = L;

    private async Task CreateAsync()
    {
        if (submitting)
        {
            return;
        }

        submitting = true;
        submission = await ScopeData.CreateAsync(
            new CreateManagementScopeCommand(
                model.Name,
                model.DisplayName,
                model.Description,
                SplitLines(model.Resources)));
        submitting = false;

        if (submission.IsSuccess && submission.Value is not null)
        {
            Navigation.NavigateTo(
                $"scopes/{Uri.EscapeDataString(submission.Value.Id)}?created=1");
        }
    }

    private static IReadOnlyList<string> SplitLines(string? value) =>
        (value ?? string.Empty).Split(
            ['\r', '\n'],
            StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    /// <summary>
    /// Delivers the field validation message to the component itself, instead
    /// of hanging a &lt;ValidationMessage&gt; next to it: inside a two-column
    /// grid, the sibling element becomes a cell and shifts the following
    /// column.
    /// </summary>
    private string? ErrorFor(EditContext context, string field) =>
        context.GetValidationMessages(new FieldIdentifier(model, field))
            .FirstOrDefault();

    private sealed class ScopeCreateModel : IValidatableObject
    {
        public IStringLocalizer<Sufficit.Identity.UI.Management.Resources.ManagementResource>? Localizer { get; set; }

        public string Name { get; set; } = string.Empty;

        public string? DisplayName { get; set; }

        public string? Description { get; set; }

        public string? Resources { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            var l = Localizer;
            if (l is null)
            {
                yield break;
            }

            if (string.IsNullOrWhiteSpace(Name))
            {
                yield return new ValidationResult(
                    l["Scopes.Validation.NameRequired"].Value,
                    [nameof(Name)]);
            }
            else if (Name.Length > 200)
            {
                yield return new ValidationResult(
                    l["Scopes.Validation.MaxLength200"].Value,
                    [nameof(Name)]);
            }

            if (DisplayName?.Length > 200)
            {
                yield return new ValidationResult(
                    l["Scopes.Validation.MaxLength200"].Value,
                    [nameof(DisplayName)]);
            }

            if (Description?.Length > 1000)
            {
                yield return new ValidationResult(
                    l["Scopes.Validation.MaxLength1000"].Value,
                    [nameof(Description)]);
            }
        }
    }
}
