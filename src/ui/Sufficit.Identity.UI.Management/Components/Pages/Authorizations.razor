@page "/authorizations"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageAuthorizations)]
@attribute [StreamRendering]
@inject ManagementAuthorizationDataSource AuthorizationData

<PageTitle>@L["Authorizations.PageTitle"]</PageTitle>

<SUIPageHeader Title="@L["Authorizations.HeaderTitle"].Value"
            Description="@L["Authorizations.HeaderDescription"].Value">
</SUIPageHeader>

<div class="page-notices">
    <SUIAlert ToneValue="SUITone.Info" Icon="shield" role="note">
        <SUIStack Row Wrap AlignItems="Center" Justify="Between" Spacing="2">
            <div><strong>@L["Authorizations.ContractStrip.Title"]</strong> <span>@L["Authorizations.ContractStrip.Description"]</span></div>
            <SUIStatusBadge ToneValue="SUITone.Info">OAuth &amp; OIDC</SUIStatusBadge>
        </SUIStack>
    </SUIAlert>

    @if (revoked)
    {
        <SUIAlert ToneValue="SUITone.Success" Icon="check" role="status">
            <div><strong>@L["Authorizations.Revoked.Title"]</strong> <span>@L["Authorizations.Revoked.Description"]</span></div>
        </SUIAlert>
    }
</div>

<div class="table-panel" aria-labelledby="authorizations-list-heading" aria-busy="@loading">
    <div class="data-toolbar data-toolbar--users">
        <div>
            <h2 id="authorizations-list-heading">@L["Authorizations.List.Heading"]</h2>
            <p>@FilterDescription</p>
        </div>
        <div class="data-toolbar__actions">
            <form @onsubmit="SearchAsync" @onsubmit:preventDefault>
                <SUIStack Row AlignItems="End" Spacing="2" Class="toolbar-filters">
                    <IdentityTextField T="string"
                                       Id="authorization-search"
                                       InputType="search"
                                       AdornmentIcon="search"
                                       Placeholder="@L["Authorizations.Search.Placeholder"].Value"
                                       aria-label="@L["Authorizations.Search.VisuallyHidden"].Value"
                                       autocomplete="off"
                                       @bind-Value="search" />
                    <IdentitySelect T="string"
                                    Id="authorization-state-filter"
                                    Name="state"
                                    Label="@L["Authorizations.Filter.StateLabel"].Value"
                                    @bind-Value="stateFilter">
                        <SUISelectItem Value="@("active")">@L["Authorizations.Filter.Active"]</SUISelectItem>
                        <SUISelectItem Value="@("all")">@L["Authorizations.Filter.All"]</SUISelectItem>
                    </IdentitySelect>
                    <SUIButton ButtonTypeValue="SUIButtonType.Submit"
                               ColorValue="SUIColor.Secondary"
                               Disabled="@loading">
                        @L["Authorizations.Apply"]
                    </SUIButton>
                </SUIStack>
            </form>
        </div>
    </div>

    <ManagementDataView Result="result"
                        Loading="loading"
                        OnRetry="LoadAsync"
                        Class="client-results"
                        LoadingLabel="@L["Authorizations.LoadingAriaLabel"].Value"
                        StepUpTitle="@L["Authorizations.Error.StepUp"].Value"
                        ForbiddenTitle="@L["Authorizations.Error.Forbidden"].Value"
                        UnavailableTitle="@L["Authorizations.Error.Generic"].Value">
        <Success Context="_">
            @if (Page.Items.Count is 0)
            {
                <SUIEmptyState Icon="shield"
                            Title="@L["Authorizations.Empty.Title"].Value"
                            Description="@L["Authorizations.Empty.Description"].Value" />
            }
            else
            {
                <SUITable TItem="ManagementAuthorizationSummary"
                          Items="Page.Items"
                          RowKey="grant => grant.Id"
                          Hover="true"
                          StackOnMobile="true">
                    <HeaderContent>
                                <SUITh>@L["Authorizations.Column.User"]</SUITh>
                                <SUITh>@L["Authorizations.Column.Client"]</SUITh>
                                <SUITh>@L["Authorizations.Column.Scopes"]</SUITh>
                                <SUITh>@L["Authorizations.Column.TypeCreated"]</SUITh>
                                <SUITh>@L["Authorizations.Column.Credentials"]</SUITh>
                                <SUITh>@L["Authorizations.Column.State"]</SUITh>
                                <SUITh><span class="visually-hidden">@L["Authorizations.Column.Actions"]</span></SUITh>
                    </HeaderContent>
                    <RowTemplate Context="grant">
                                    <SUITd DataLabel="@L["Authorizations.Column.User"].Value">
                                        @if (grant.UserId is not null)
                                        {
                                            <a class="client-name" href="@UserHref(grant.UserId)">@UserLabel(grant)</a>
                                        }
                                        else
                                        {
                                            <span>@L["Authorizations.NoUser"]</span>
                                        }
                                    </SUITd>
                                    <SUITd DataLabel="@L["Authorizations.Column.Client"].Value">
                                        <span class="scope-identity">
                                            <strong>@(grant.ClientDisplayName ?? grant.ClientId ?? L["Authorizations.NoClient"].Value)</strong>
                                            @if (grant.ClientId is not null)
                                            {
                                                <code>@grant.ClientId</code>
                                            }
                                        </span>
                                    </SUITd>
                                    <SUITd DataLabel="@L["Authorizations.Column.Scopes"].Value">
                                        <span class="token-row">
                                            @if (grant.Scopes.Count is 0)
                                            {
                                                <span>@L["Authorizations.NoScopes"]</span>
                                            }
                                            else
                                            {
                                                @foreach (var scope in grant.Scopes.Take(4))
                                                {
                                                    <SUIStatusBadge ToneValue="SUITone.Neutral">@scope</SUIStatusBadge>
                                                }
                                                @if (grant.Scopes.Count > 4)
                                                {
                                                    <SUIStatusBadge ToneValue="SUITone.Neutral">+@(grant.Scopes.Count - 4)</SUIStatusBadge>
                                                }
                                            }
                                        </span>
                                    </SUITd>
                                    <SUITd DataLabel="@L["Authorizations.Column.TypeCreated"].Value">
                                        <span class="scope-identity">
                                            <strong>@TypeLabel(grant.Type)</strong>
                                            <code>@DateLabel(grant.CreatedAt)</code>
                                        </span>
                                    </SUITd>
                                    <SUITd DataLabel="@L["Authorizations.Column.Credentials"].Value">@grant.CredentialCount</SUITd>
                                    <SUITd DataLabel="@L["Authorizations.Column.State"].Value">
                                        <SUIStatusBadge ToneValue="@(grant.IsActive ? SUITone.Success : SUITone.Neutral)">
                                            @StatusLabel(grant.Status)
                                        </SUIStatusBadge>
                                    </SUITd>
                                    <SUITd DataLabel="@L["Authorizations.Column.Actions"].Value">
                                        @if (grant.IsActive)
                                        {
                                            <SUIButton VariantValue="SUIVariant.Text"
                                                       ColorValue="SUIColor.Primary"
                                                       SizeValue="SUISize.Small"
                                                       EndIcon="lock"
                                                       OnClick="() => SelectForRevocation(grant)">
                                                @L["Authorizations.RevokeAction"]
                                            </SUIButton>
                                        }
                                    </SUITd>
                    </RowTemplate>
                </SUITable>
            }
        </Success>
    </ManagementDataView>

    <footer class="table-footer table-footer--paginated">
        @if (result?.IsSuccess is true)
        {
            <SUIPagination TotalItems="Page.TotalCount"
                           PageSize="Page.PageSize"
                           PageIndex="@(Page.Page - 1)"
                           PageIndexChanged="GoToPageAsync"
                           Disabled="loading"
                           AriaLabel="@L["Authorizations.PaginationAriaLabel"].Value"
                           PreviousLabel="@L["Authorizations.Previous"].Value"
                           NextLabel="@L["Authorizations.Next"].Value"
                           PageLabel="@((current, count) => string.Format(L["Authorizations.PageOfFormat"].Value, current, count))"
                           RangeFormatter="@((first, last, total) => string.Format(L["Authorizations.RangeFormat"].Value, first, last, total))"
                           EmptyText="@string.Format(L["Authorizations.ResultCount.Format"].Value, 0)" />
        }
        else
        {
            <span>@ResultCountLabel</span>
        }
    </footer>
</div>

@if (selected is not null)
{
    <div class="delete-zone" aria-labelledby="revoke-authorization-heading">
        <div>
            <h2 id="revoke-authorization-heading">@L["Authorizations.RevokeConfirm.Heading"]</h2>
            <p>@UserLabel(selected) · @(selected.ClientDisplayName ?? selected.ClientId ?? L["Authorizations.NoClient"].Value) · @string.Format(L["Authorizations.RevokeConfirm.CredentialCountFormat"].Value, selected.CredentialCount)</p>
        </div>
        @if (revocation?.IsSuccess is false)
        {
            <SUIAlert ToneValue="SUITone.Danger" Icon="alert">
                <div><strong>@L["Authorizations.RevokeConfirm.ErrorTitle"]</strong> <span>@revocation.ErrorMessage</span></div>
            </SUIAlert>
        }
        <SUIButton ColorValue="SUIColor.Secondary" OnClick="CancelRevocation">@L["Authorizations.Cancel"]</SUIButton>
        <SUILoadingButton ColorValue="SUIColor.Error"
                          StartIcon="lock"
                          IsLoading="@revoking"
                          OnClick="RevokeAsync">
            @(revoking ? L["Authorizations.Revoking"] : L["Authorizations.ConfirmRevocation"])
        </SUILoadingButton>
    </div>
}

@code {
    // The reader's zone once the browser answers (BrowserTimeProvider in the layout).
    [CascadingParameter]
    private BrowserTime Time { get; set; } = BrowserTime.Server;

    [SupplyParameterFromQuery(Name = "user")]
    public string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "client")]
    public string? ClientId { get; set; }

    private ManagementDataResult<ManagementAuthorizationPage>? result;
    private ManagementDataResult<bool>? revocation;
    private ManagementAuthorizationSummary? selected;
    private string search = string.Empty;
    private string stateFilter = "active";
    private int currentPage = 1;
    private bool loading = true;
    private bool revoking;
    private bool revoked;
    private const int PageSize = 25;

    private ManagementAuthorizationPage Page =>
        result?.Value ?? new([], 1, PageSize, 0, UserId, ClientId, true);

    private int TotalPages =>
        Math.Max(1, (int)Math.Ceiling(Page.TotalCount / (double)Page.PageSize));

    private string FilterDescription =>
        UserId is not null
            ? string.Format(L["Authorizations.FilterDescription.ByAccountFormat"].Value, UserId)
            : ClientId is not null
                ? string.Format(L["Authorizations.FilterDescription.ByClientFormat"].Value, ClientId)
                : L["Authorizations.FilterDescription.Default"].Value;

    private string ResultCountLabel =>
        loading
            ? L["Authorizations.ResultCount.Loading"].Value
            : L["Authorizations.ResultCount.NoneLoaded"].Value;

    protected override async Task OnParametersSetAsync()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        result = await AuthorizationData.SearchAsync(
            new ManagementAuthorizationSearch(
                search,
                UserId,
                ClientId,
                stateFilter == "active",
                currentPage,
                PageSize));
        loading = false;
    }

    private async Task SearchAsync()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task GoToPageAsync(int pageIndex)
    {
        currentPage = Math.Clamp(pageIndex + 1, 1, TotalPages);
        await LoadAsync();
    }

    private void SelectForRevocation(ManagementAuthorizationSummary grant)
    {
        selected = grant;
        revocation = null;
        revoked = false;
    }

    private void CancelRevocation()
    {
        selected = null;
        revocation = null;
    }

    private async Task RevokeAsync()
    {
        if (selected is null || revoking)
        {
            return;
        }

        revoking = true;
        revocation = await AuthorizationData.RevokeAsync(selected.Id);
        revoking = false;
        if (revocation.IsSuccess)
        {
            selected = null;
            revoked = true;
            await LoadAsync();
        }
    }

    private string UserLabel(ManagementAuthorizationSummary grant) =>
        grant.UserName ?? grant.Email ?? grant.UserId ?? L["Authorizations.NoUser"].Value;

    private static string UserHref(string id) =>
        $"users/{Uri.EscapeDataString(id)}";

    private static string TypeLabel(string value) =>
        value.Replace('_', ' ');

    private string StatusLabel(string value) =>
        value switch
        {
            "valid" => L["Authorizations.Status.Active"].Value,
            "revoked" => L["Authorizations.Status.Revoked"].Value,
            _ => value
        };

    private string DateLabel(DateTimeOffset? value) =>
        Time.Format(value) ?? L["Authorizations.NoDateRecorded"].Value;
}
