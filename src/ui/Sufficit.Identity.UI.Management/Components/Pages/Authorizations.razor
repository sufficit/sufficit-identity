@page "/authorizations"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageAuthorizations)]
@attribute [StreamRendering]
@inject ManagementAuthorizationDataSource AuthorizationData

<PageTitle>@L["Authorizations.PageTitle"]</PageTitle>

<SUIPageHeader Title="@L["Authorizations.HeaderTitle"].Value"
            Description="@L["Authorizations.HeaderDescription"].Value">
</SUIPageHeader>

<div class="contract-strip contract-strip--info">
    <SUIIcon Name="shield" Size="20" />
    <div>
        <strong>@L["Authorizations.ContractStrip.Title"]</strong>
        <span>@L["Authorizations.ContractStrip.Description"]</span>
    </div>
    <SUIStatusBadge ToneValue="SUITone.Info">OAuth &amp; OIDC</SUIStatusBadge>
</div>

@if (revoked)
{
    <div class="inline-notice inline-notice--success" role="status">
        <SUIIcon Name="check" Size="19" />
        <div>
            <strong>@L["Authorizations.Revoked.Title"]</strong>
            <span>@L["Authorizations.Revoked.Description"]</span>
        </div>
    </div>
}

<div class="table-panel" aria-labelledby="authorizations-list-heading" aria-busy="@loading">
    <div class="data-toolbar data-toolbar--users">
        <div>
            <h2 id="authorizations-list-heading">@L["Authorizations.List.Heading"]</h2>
            <p>@FilterDescription</p>
        </div>
        <div class="data-toolbar__actions">
            <form class="user-search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
                <label class="search-field">
                    <span class="visually-hidden">@L["Authorizations.Search.VisuallyHidden"]</span>
                    <SUIIcon Name="search" Size="18" />
                    <input type="search"
                           placeholder="@L["Authorizations.Search.Placeholder"].Value"
                           autocomplete="off"
                           @bind="search" />
                </label>
                <div class="select-field">
                    <span>@L["Authorizations.Filter.StateLabel"]</span>
                    <SUISelect T="string" id="authorization-state-filter" name="state" aria-label="@L["Authorizations.Filter.StateLabel"].Value" @bind-Value="stateFilter">
                        <SUISelectItem Value="@("active")">@L["Authorizations.Filter.Active"]</SUISelectItem>
                        <SUISelectItem Value="@("all")">@L["Authorizations.Filter.All"]</SUISelectItem>
                    </SUISelect>
                </div>
                <button class="button button--secondary" type="submit" disabled="@loading">@L["Authorizations.Apply"]</button>
            </form>
        </div>
    </div>

    <div class="client-results" aria-live="polite">
        @if (loading)
        {
            <div class="table-skeleton" aria-label="@L["Authorizations.LoadingAriaLabel"].Value">
                @for (var index = 0; index < 4; index++)
                {
                    <span></span>
                }
            </div>
        }
        else if (result?.IsSuccess is true)
        {
            @if (Page.Items.Count is 0)
            {
                <SUIEmptyState Icon="shield"
                            Title="@L["Authorizations.Empty.Title"].Value"
                            Description="@L["Authorizations.Empty.Description"].Value" />
            }
            else
            {
                <div class="table-scroll">
                    <table class="data-table data-table--claims">
                        <thead>
                            <tr>
                                <th scope="col">@L["Authorizations.Column.User"]</th>
                                <th scope="col">@L["Authorizations.Column.Client"]</th>
                                <th scope="col">@L["Authorizations.Column.Scopes"]</th>
                                <th scope="col">@L["Authorizations.Column.TypeCreated"]</th>
                                <th scope="col">@L["Authorizations.Column.Credentials"]</th>
                                <th scope="col">@L["Authorizations.Column.State"]</th>
                                <th scope="col"><span class="visually-hidden">@L["Authorizations.Column.Actions"]</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var grant in Page.Items)
                            {
                                <tr>
                                    <td data-label="@L["Authorizations.Column.User"].Value">
                                        @if (grant.UserId is not null)
                                        {
                                            <a class="client-name" href="@UserHref(grant.UserId)">@UserLabel(grant)</a>
                                        }
                                        else
                                        {
                                            <span>@L["Authorizations.NoUser"]</span>
                                        }
                                    </td>
                                    <td data-label="@L["Authorizations.Column.Client"].Value">
                                        <span class="scope-identity">
                                            <strong>@(grant.ClientDisplayName ?? grant.ClientId ?? L["Authorizations.NoClient"].Value)</strong>
                                            @if (grant.ClientId is not null)
                                            {
                                                <code>@grant.ClientId</code>
                                            }
                                        </span>
                                    </td>
                                    <td data-label="@L["Authorizations.Column.Scopes"].Value">
                                        <span class="token-row">
                                            @if (grant.Scopes.Count is 0)
                                            {
                                                <span>@L["Authorizations.NoScopes"]</span>
                                            }
                                            else
                                            {
                                                @foreach (var scope in grant.Scopes.Take(4))
                                                {
                                                    <SUIStatusBadge ToneValue="SUITone.Neutral">@scope</SUIStatusBadge>
                                                }
                                                @if (grant.Scopes.Count > 4)
                                                {
                                                    <SUIStatusBadge ToneValue="SUITone.Neutral">+@(grant.Scopes.Count - 4)</SUIStatusBadge>
                                                }
                                            }
                                        </span>
                                    </td>
                                    <td data-label="@L["Authorizations.Column.TypeCreated"].Value">
                                        <span class="scope-identity">
                                            <strong>@TypeLabel(grant.Type)</strong>
                                            <code>@DateLabel(grant.CreatedAt)</code>
                                        </span>
                                    </td>
                                    <td data-label="@L["Authorizations.Column.Credentials"].Value">@grant.CredentialCount</td>
                                    <td data-label="@L["Authorizations.Column.State"].Value">
                                        <SUIStatusBadge ToneValue="@(grant.IsActive ? SUITone.Success : SUITone.Neutral)">
                                            @StatusLabel(grant.Status)
                                        </SUIStatusBadge>
                                    </td>
                                    <td data-label="@L["Authorizations.Column.Actions"].Value">
                                        @if (grant.IsActive)
                                        {
                                            <button class="row-action row-action--button"
                                                    type="button"
                                                    @onclick="() => SelectForRevocation(grant)">
                                                @L["Authorizations.RevokeAction"]
                                                <SUIIcon Name="lock" Size="15" />
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else
        {
            <SUIEmptyState Icon="alert"
                        Title="@ErrorTitle"
                        Description="@(result?.ErrorMessage ?? L["Authorizations.Error.GenericDescription"].Value)">
                <Actions>
                    <button class="button button--secondary" type="button" @onclick="LoadAsync">@L["Authorizations.Retry"]</button>
                </Actions>
            </SUIEmptyState>
        }
    </div>

    <footer class="table-footer table-footer--paginated">
        <span>@ResultCountLabel</span>
        @if (result?.IsSuccess is true && Page.TotalCount > Page.PageSize)
        {
            <div class="pagination" aria-label="@L["Authorizations.PaginationAriaLabel"].Value">
                <button class="button button--secondary button--compact" type="button"
                        disabled="@(Page.Page <= 1 || loading)"
                        @onclick="PreviousPageAsync">@L["Authorizations.Previous"]</button>
                <span>@string.Format(L["Authorizations.PageOfFormat"].Value, Page.Page, TotalPages)</span>
                <button class="button button--secondary button--compact" type="button"
                        disabled="@(Page.Page >= TotalPages || loading)"
                        @onclick="NextPageAsync">@L["Authorizations.Next"]</button>
            </div>
        }
    </footer>
</div>

@if (selected is not null)
{
    <div class="delete-zone" aria-labelledby="revoke-authorization-heading">
        <div>
            <h2 id="revoke-authorization-heading">@L["Authorizations.RevokeConfirm.Heading"]</h2>
            <p>@UserLabel(selected) · @(selected.ClientDisplayName ?? selected.ClientId ?? L["Authorizations.NoClient"].Value) · @string.Format(L["Authorizations.RevokeConfirm.CredentialCountFormat"].Value, selected.CredentialCount)</p>
        </div>
        @if (revocation?.IsSuccess is false)
        {
            <div class="inline-notice inline-notice--danger" role="alert">
                <SUIIcon Name="alert" Size="19" />
                <div><strong>@L["Authorizations.RevokeConfirm.ErrorTitle"]</strong><span>@revocation.ErrorMessage</span></div>
            </div>
        }
        <button class="button button--secondary" type="button" @onclick="CancelRevocation">@L["Authorizations.Cancel"]</button>
        <button class="button button--danger" type="button" disabled="@revoking" @onclick="RevokeAsync">
            <SUIIcon Name="lock" Size="17" />
            @(revoking ? L["Authorizations.Revoking"] : L["Authorizations.ConfirmRevocation"])
        </button>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "user")]
    public string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "client")]
    public string? ClientId { get; set; }

    private ManagementDataResult<ManagementAuthorizationPage>? result;
    private ManagementDataResult<bool>? revocation;
    private ManagementAuthorizationSummary? selected;
    private string search = string.Empty;
    private string stateFilter = "active";
    private int currentPage = 1;
    private bool loading = true;
    private bool revoking;
    private bool revoked;
    private const int PageSize = 25;

    private ManagementAuthorizationPage Page =>
        result?.Value ?? new([], 1, PageSize, 0, UserId, ClientId, true);

    private int TotalPages =>
        Math.Max(1, (int)Math.Ceiling(Page.TotalCount / (double)Page.PageSize));

    private string FilterDescription =>
        UserId is not null
            ? string.Format(L["Authorizations.FilterDescription.ByAccountFormat"].Value, UserId)
            : ClientId is not null
                ? string.Format(L["Authorizations.FilterDescription.ByClientFormat"].Value, ClientId)
                : L["Authorizations.FilterDescription.Default"].Value;

    private string ErrorTitle =>
        result?.Outcome is ManagementDataOutcome.StepUpRequired
            ? L["Authorizations.Error.StepUp"].Value
            : result?.Outcome is ManagementDataOutcome.Forbidden
                ? L["Authorizations.Error.Forbidden"].Value
                : L["Authorizations.Error.Generic"].Value;

    private string ResultCountLabel =>
        loading
            ? L["Authorizations.ResultCount.Loading"].Value
            : result?.IsSuccess is true
                ? string.Format(L["Authorizations.ResultCount.Format"].Value, Page.TotalCount)
                : L["Authorizations.ResultCount.NoneLoaded"].Value;

    protected override async Task OnParametersSetAsync()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        result = await AuthorizationData.SearchAsync(
            new ManagementAuthorizationSearch(
                search,
                UserId,
                ClientId,
                stateFilter == "active",
                currentPage,
                PageSize));
        loading = false;
    }

    private async Task SearchAsync()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task PreviousPageAsync()
    {
        currentPage = Math.Max(1, currentPage - 1);
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        currentPage = Math.Min(TotalPages, currentPage + 1);
        await LoadAsync();
    }

    private void SelectForRevocation(ManagementAuthorizationSummary grant)
    {
        selected = grant;
        revocation = null;
        revoked = false;
    }

    private void CancelRevocation()
    {
        selected = null;
        revocation = null;
    }

    private async Task RevokeAsync()
    {
        if (selected is null || revoking)
        {
            return;
        }

        revoking = true;
        revocation = await AuthorizationData.RevokeAsync(selected.Id);
        revoking = false;
        if (revocation.IsSuccess)
        {
            selected = null;
            revoked = true;
            await LoadAsync();
        }
    }

    private string UserLabel(ManagementAuthorizationSummary grant) =>
        grant.UserName ?? grant.Email ?? grant.UserId ?? L["Authorizations.NoUser"].Value;

    private static string UserHref(string id) =>
        $"users/{Uri.EscapeDataString(id)}";

    private static string TypeLabel(string value) =>
        value.Replace('_', ' ');

    private string StatusLabel(string value) =>
        value switch
        {
            "valid" => L["Authorizations.Status.Active"].Value,
            "revoked" => L["Authorizations.Status.Revoked"].Value,
            _ => value
        };

    private string DateLabel(DateTimeOffset? value) =>
        value?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? L["Authorizations.NoDateRecorded"].Value;
}
