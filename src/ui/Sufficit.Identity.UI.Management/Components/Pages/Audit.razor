@page "/audit"
@attribute [Authorize(Policy = ManagementUiPolicies.ReadAudit)]
@attribute [StreamRendering]
@inject ManagementAuditDataSource AuditData

<PageTitle>@L["Audit.PageTitle"]</PageTitle>

<SUIPageHeader Title="@L["Audit.HeaderTitle"].Value"
            Description="@L["Audit.HeaderDescription"].Value" />

<div class="page-notices">
    <SUIAlert ToneValue="SUITone.Success" Icon="audit" role="note">
        <SUIStack Row Wrap AlignItems="Center" Justify="Between" Spacing="2">
            <div><strong>@L["Audit.PersistentEvents.Title"]</strong> <span>@L["Audit.PersistentEvents.Description"]</span></div>
            <SUIStatusBadge ToneValue="SUITone.Success">@L["Audit.Active"]</SUIStatusBadge>
        </SUIStack>
    </SUIAlert>
</div>

<div class="table-panel" aria-labelledby="audit-list-heading" aria-busy="@loading">
    <div class="data-toolbar">
        <div>
            <h2 id="audit-list-heading">@L["Audit.List.Title"]</h2>
            <p>@L["Audit.List.Description"]</p>
        </div>
        <div class="data-toolbar__actions">
            <SUIStack Row AlignItems="Center" Spacing="2" Class="toolbar-filters">
            @if (CanFilter)
            {
                <IdentityTextField T="string"
                                   Id="audit-search"
                                   InputType="search"
                                   AdornmentIcon="search"
                                   Immediate="true"
                                   Placeholder="@L["Audit.Search.Placeholder"].Value"
                                   aria-label="@L["Audit.Search.Label"].Value"
                                   autocomplete="off"
                                   @bind-Value="search" />
            }
            <SUIButton ColorValue="SUIColor.Secondary"
                       StartIcon="refresh"
                       Disabled="@loading"
                       OnClick="LoadAsync">
                @L["Audit.Refresh"]
            </SUIButton>
            </SUIStack>
        </div>
    </div>

    <ManagementDataView Result="result"
                        Loading="loading"
                        OnRetry="LoadAsync"
                        Class="audit-results"
                        LoadingLabel="@L["Audit.Loading.Aria"].Value"
                        UnavailableTitle="@L["Audit.ErrorTitle"].Value">
        <Success Context="_">
            @if (FilteredEvents.Count is 0)
            {
                <SUIEmptyState Icon="audit"
                            Title="@EmptyTitle"
                            Description="@EmptyDescription">
                    <Actions>
                        @if (!string.IsNullOrWhiteSpace(search))
                        {
                            <SUIButton ColorValue="SUIColor.Secondary"
                                       OnClick="ClearSearch">
                                @L["Audit.ClearSearch"]
                            </SUIButton>
                        }
                    </Actions>
                </SUIEmptyState>
            }
            else
            {
                <SUITable TItem="ManagementAuditRecord"
                          Items="FilteredEvents"
                          StackOnMobile="true">
                    <HeaderContent>
                                <SUITh>@L["Audit.Table.When"]</SUITh>
                                <SUITh>@L["Audit.Table.Operator"]</SUITh>
                                <SUITh>@L["Audit.Table.Action"]</SUITh>
                                <SUITh>@L["Audit.Table.Target"]</SUITh>
                                <SUITh>@L["Audit.Table.Result"]</SUITh>
                                <SUITh>@L["Audit.Table.Correlation"]</SUITh>
                    </HeaderContent>
                    <RowTemplate Context="entry">
                                    <SUITd DataLabel="@L["Audit.Table.When"].Value">
                                        <time datetime="@entry.OccurredAtUtc.ToString("O")">
                                            @Time.Format(entry.OccurredAtUtc, TimeStyle.DateTimeSeconds)
                                        </time>
                                    </SUITd>
                                    <SUITd DataLabel="@L["Audit.Table.Operator"].Value">
                                        <strong class="audit-operator">
                                            @(entry.OperatorDisplayName ?? entry.OperatorSubject)
                                        </strong>
                                        @if (entry.OperatorDisplayName is not null)
                                        {
                                            <code class="audit-subject">@entry.OperatorSubject</code>
                                        }
                                    </SUITd>
                                    <SUITd DataLabel="@L["Audit.Table.Action"].Value">
                                        <code>@CapabilityLabel(entry.Capability)</code>
                                        @if (entry.BeforeJson is not null || entry.AfterJson is not null)
                                        {
                                            @* Kept mounted: the JSON stays in the document while collapsed. *@
                                            <SUIExpansionPanel Title="@L["Audit.ViewChange"].Value"
                                                               KeepContentMounted="true"
                                                               Class="audit-change-details">
                                                <strong>@L["Audit.Before"]</strong><pre class="audit-json">@entry.BeforeJson</pre>
                                                <strong>@L["Audit.After"]</strong><pre class="audit-json">@entry.AfterJson</pre>
                                            </SUIExpansionPanel>
                                        }
                                    </SUITd>
                                    <SUITd DataLabel="@L["Audit.Table.Target"].Value">
                                        <span>@entry.ResourceType</span>
                                        @if (entry.ResourceId is not null)
                                        {
                                            <code>@entry.ResourceId</code>
                                        }
                                    </SUITd>
                                    <SUITd DataLabel="@L["Audit.Table.Result"].Value">
                                        <SUIStatusBadge ToneValue="@IdentitySuiTone.From(OutcomeTone(entry.OperationOutcome))">
                                            @OutcomeLabel(entry.OperationOutcome)
                                        </SUIStatusBadge>
                                    </SUITd>
                                    <SUITd DataLabel="@L["Audit.Table.Correlation"].Value">
                                        <code class="audit-correlation">@entry.CorrelationId</code>
                                    </SUITd>
                    </RowTemplate>
                </SUITable>
            }
        </Success>
    </ManagementDataView>

    <footer class="table-footer">
        <span>@ResultCountLabel</span>
        <span>@L["Audit.Footer.UtcLimit"]</span>
    </footer>
</div>

<div class="client-guardrails" aria-labelledby="audit-safety-heading">
    <div>
        <h2 id="audit-safety-heading">@L["Audit.Safety.Heading"]</h2>
        <p>@L["Audit.Safety.Description"]</p>
    </div>
    <ul>
        <li><SUIIcon Name="lock" Size="18" /> @L["Audit.Safety.NoSecrets"]</li>
        <li><SUIIcon Name="shield" Size="18" /> @L["Audit.Safety.StableCodes"]</li>
        <li><SUIIcon Name="code" Size="18" /> @L["Audit.Safety.Correlation"]</li>
    </ul>
</div>

@code {
    // The reader's zone once the browser answers (BrowserTimeProvider in the layout).
    [CascadingParameter]
    private BrowserTime Time { get; set; } = BrowserTime.Server;

    private ManagementDataResult<IReadOnlyList<ManagementAuditRecord>>? result;
    private bool loading = true;
    private string search = string.Empty;

    private IReadOnlyList<ManagementAuditRecord> Events =>
        result?.Value ?? [];

    private IReadOnlyList<ManagementAuditRecord> FilteredEvents =>
        string.IsNullOrWhiteSpace(search)
            ? Events
            : Events.Where(MatchesSearch).ToArray();

    private bool CanFilter => result?.IsSuccess is true && Events.Count > 0;

    private string EmptyTitle =>
        string.IsNullOrWhiteSpace(search)
            ? L["Audit.Empty.NoEvents.Title"].Value
            : L["Audit.Empty.NoMatch.Title"].Value;

    private string EmptyDescription =>
        string.IsNullOrWhiteSpace(search)
            ? L["Audit.Empty.NoEvents.Description"].Value
            : L["Audit.Empty.NoMatch.Description"].Value;

    private string ResultCountLabel =>
        loading
            ? L["Audit.ResultCount.Loading"].Value
            : result?.IsSuccess is true
                ? L["Audit.ResultCount.Format", FilteredEvents.Count, Events.Count].Value
                : L["Audit.ResultCount.None"].Value;

    protected override async Task OnInitializedAsync() =>
        await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        result = await AuditData.GetEventsAsync();
        loading = false;
    }

    private bool MatchesSearch(ManagementAuditRecord entry) =>
        entry.OperatorSubject.Contains(search, StringComparison.OrdinalIgnoreCase)
        || (entry.OperatorDisplayName?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)
        || entry.Capability.Contains(search, StringComparison.OrdinalIgnoreCase)
        || entry.ResourceType.Contains(search, StringComparison.OrdinalIgnoreCase)
        || (entry.ResourceId?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)
        || entry.CorrelationId.Contains(search, StringComparison.OrdinalIgnoreCase);

    private void ClearSearch() => search = string.Empty;

    // Rows written before a capability rename keep the retired spelling;
    // show them under the canonical name.
    private string CapabilityLabel(string capability) =>
        ManagementCapabilities.Normalize(capability) switch
        {
            "identity.clients.create" => L["Audit.Capability.ClientsCreate"].Value,
            "identity.clients.delete" => L["Audit.Capability.ClientsDelete"].Value,
            "identity.clients.read" => L["Audit.Capability.ClientsRead"].Value,
            // Audit-only label of delegated credentials, renamed 2026-10-27.
            "token_exchange.delegated_credential" => "identity.credentials.delegate",
            var canonical => canonical
        };

    private string OutcomeLabel(string outcome) =>
        outcome switch
        {
            "succeeded" => L["Audit.Outcome.Succeeded"].Value,
            "denied" => L["Audit.Outcome.Denied"].Value,
            "rejected" => L["Audit.Outcome.Rejected"].Value,
            "conflict" => L["Audit.Outcome.Conflict"].Value,
            "not-found" => L["Audit.Outcome.NotFound"].Value,
            _ => outcome
        };

    private static string OutcomeTone(string outcome) =>
        outcome switch
        {
            "succeeded" => "success",
            "denied" or "rejected" => "danger",
            "conflict" or "not-found" => "warning",
            _ => "neutral"
        };
}
