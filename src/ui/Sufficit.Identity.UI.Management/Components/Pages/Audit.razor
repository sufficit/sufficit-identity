@page "/audit"
@attribute [Authorize(Policy = ManagementUiPolicies.ReadAudit)]
@attribute [StreamRendering]
@inject ManagementAuditDataSource AuditData

<PageTitle>Auditoria | Sufficit Identity</PageTitle>

<PageHeader Title="Auditoria"
            Description="Rastreabilidade das decisões de autorização e mutações administrativas." />

<section class="contract-strip contract-strip--success">
    <AppIcon Name="audit" Size="20" />
    <div>
        <strong>Eventos persistentes e sem segredos</strong>
        <span>Operador, capability, alvo, resultado e correlation ID são registrados pela camada de aplicação.</span>
    </div>
    <StatusBadge Tone="success">Ativa</StatusBadge>
</section>

<section class="table-panel" aria-labelledby="audit-list-heading" aria-busy="@loading">
    <div class="data-toolbar">
        <div>
            <h2 id="audit-list-heading">Eventos administrativos</h2>
            <p>Os 100 eventos mais recentes, em horário UTC.</p>
        </div>
        <div class="data-toolbar__actions">
            @if (CanFilter)
            {
                <label class="search-field">
                    <span class="visually-hidden">Pesquisar eventos</span>
                    <AppIcon Name="search" Size="18" />
                    <input type="search"
                           placeholder="Operador, ação ou alvo"
                           autocomplete="off"
                           @bind="search"
                           @bind:event="oninput" />
                </label>
            }
            <button class="button button--secondary"
                    type="button"
                    disabled="@loading"
                    @onclick="LoadAsync">
                <AppIcon Name="refresh" Size="16" />
                Atualizar
            </button>
        </div>
    </div>

    <div class="audit-results" aria-live="polite">
        @if (loading)
        {
            <div class="table-skeleton" aria-label="Carregando eventos de auditoria">
                @for (var index = 0; index < 4; index++)
                {
                    <span></span>
                }
            </div>
        }
        else if (result?.IsSuccess is true)
        {
            @if (FilteredEvents.Count is 0)
            {
                <EmptyState Icon="audit"
                            Title="@EmptyTitle"
                            Description="@EmptyDescription">
                    <Actions>
                        @if (!string.IsNullOrWhiteSpace(search))
                        {
                            <button class="button button--secondary"
                                    type="button"
                                    @onclick="ClearSearch">
                                Limpar pesquisa
                            </button>
                        }
                    </Actions>
                </EmptyState>
            }
            else
            {
                <div class="table-scroll">
                    <table class="data-table data-table--audit">
                        <thead>
                            <tr>
                                <th scope="col">Quando</th>
                                <th scope="col">Operador</th>
                                <th scope="col">Ação</th>
                                <th scope="col">Alvo</th>
                                <th scope="col">Resultado</th>
                                <th scope="col">Correlação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in FilteredEvents)
                            {
                                <tr>
                                    <td data-label="Quando">
                                        <time datetime="@entry.OccurredAtUtc.ToString("O")">
                                            @entry.OccurredAtUtc.ToString("dd/MM/yyyy HH:mm:ss")
                                        </time>
                                    </td>
                                    <td data-label="Operador">
                                        <strong class="audit-operator">
                                            @(entry.OperatorDisplayName ?? entry.OperatorSubject)
                                        </strong>
                                        @if (entry.OperatorDisplayName is not null)
                                        {
                                            <code class="audit-subject">@entry.OperatorSubject</code>
                                        }
                                    </td>
                                    <td data-label="Ação">
                                        <code>@CapabilityLabel(entry.Capability)</code>
                                    </td>
                                    <td data-label="Alvo">
                                        <span>@entry.ResourceType</span>
                                        @if (entry.ResourceId is not null)
                                        {
                                            <code>@entry.ResourceId</code>
                                        }
                                    </td>
                                    <td data-label="Resultado">
                                        <StatusBadge Tone="@OutcomeTone(entry.OperationOutcome)">
                                            @OutcomeLabel(entry.OperationOutcome)
                                        </StatusBadge>
                                    </td>
                                    <td data-label="Correlação">
                                        <code class="audit-correlation">@entry.CorrelationId</code>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else
        {
            <EmptyState Icon="alert"
                        Title="Não foi possível consultar a auditoria"
                        Description="@(result?.ErrorMessage ?? "O serviço de identidade não retornou os eventos agora.")">
                <Actions>
                    <button class="button button--secondary"
                            type="button"
                            @onclick="LoadAsync">
                        Tentar novamente
                    </button>
                </Actions>
            </EmptyState>
        }
    </div>

    <footer class="table-footer">
        <span>@ResultCountLabel</span>
        <span>Registros em UTC · limite de 100</span>
    </footer>
</section>

<section class="client-guardrails" aria-labelledby="audit-safety-heading">
    <div>
        <h2 id="audit-safety-heading">Conteúdo protegido</h2>
        <p>A trilha registra metadados operacionais suficientes para investigação sem replicar dados sensíveis.</p>
    </div>
    <ul>
        <li><AppIcon Name="lock" Size="18" /> Segredos e tokens nunca são persistidos</li>
        <li><AppIcon Name="shield" Size="18" /> Decisões negadas usam códigos estáveis</li>
        <li><AppIcon Name="code" Size="18" /> Correlation ID conecta operação e logs</li>
    </ul>
</section>

@code {
    private ManagementDataResult<IReadOnlyList<ManagementAuditRecord>>? result;
    private bool loading = true;
    private string search = string.Empty;

    private IReadOnlyList<ManagementAuditRecord> Events =>
        result?.Value ?? [];

    private IReadOnlyList<ManagementAuditRecord> FilteredEvents =>
        string.IsNullOrWhiteSpace(search)
            ? Events
            : Events.Where(MatchesSearch).ToArray();

    private bool CanFilter => result?.IsSuccess is true && Events.Count > 0;

    private string EmptyTitle =>
        string.IsNullOrWhiteSpace(search)
            ? "Nenhum evento administrativo"
            : "Nenhum evento corresponde à pesquisa";

    private string EmptyDescription =>
        string.IsNullOrWhiteSpace(search)
            ? "Criações, exclusões e tentativas negadas aparecerão aqui."
            : "Revise o operador, a ação ou o identificador informado.";

    private string ResultCountLabel =>
        loading
            ? "Carregando eventos"
            : result?.IsSuccess is true
                ? $"{FilteredEvents.Count} de {Events.Count} eventos"
                : "Nenhum evento carregado";

    protected override async Task OnInitializedAsync() =>
        await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        result = await AuditData.GetEventsAsync();
        loading = false;
    }

    private bool MatchesSearch(ManagementAuditRecord entry) =>
        entry.OperatorSubject.Contains(search, StringComparison.OrdinalIgnoreCase)
        || (entry.OperatorDisplayName?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)
        || entry.Capability.Contains(search, StringComparison.OrdinalIgnoreCase)
        || entry.ResourceType.Contains(search, StringComparison.OrdinalIgnoreCase)
        || (entry.ResourceId?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)
        || entry.CorrelationId.Contains(search, StringComparison.OrdinalIgnoreCase);

    private void ClearSearch() => search = string.Empty;

    private static string CapabilityLabel(string capability) =>
        capability switch
        {
            "identity.clients.create" => "Criar cliente",
            "identity.clients.delete" => "Excluir cliente",
            "identity.clients.read" => "Consultar clientes",
            _ => capability
        };

    private static string OutcomeLabel(string outcome) =>
        outcome switch
        {
            "succeeded" => "Concluído",
            "denied" => "Negado",
            "rejected" => "Rejeitado",
            "conflict" => "Conflito",
            "not-found" => "Não encontrado",
            _ => outcome
        };

    private static string OutcomeTone(string outcome) =>
        outcome switch
        {
            "succeeded" => "success",
            "denied" or "rejected" => "danger",
            "conflict" or "not-found" => "warning",
            _ => "neutral"
        };
}
