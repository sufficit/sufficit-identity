@page "/claims/new"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageClaims)]
@inject ManagementClaimDataSource ClaimData
@inject ManagementUserDataSource UserData
@inject NavigationManager Navigation

<PageTitle>@L["ClaimCreate.PageTitle"]</PageTitle>

<SUIPageHeader Title="@L["ClaimCreate.HeaderTitle"].Value"
            Description="@HeaderDescription">
    <Actions>
        <SUIButton ColorValue="SUIColor.Secondary" StartIcon="arrow-left" Href="@BackHref">
            @L["ClaimCreate.BackToClaims"]
        </SUIButton>
    </Actions>
</SUIPageHeader>

@if (!HasUserContext)
{
    <div>
        <SUIEmptyState Icon="users"
                    Title="@L["ClaimCreate.SelectUser.Title"].Value"
                    Description="@L["ClaimCreate.SelectUser.Description"].Value">
            <Actions>
                <SUIButton ColorValue="SUIColor.Primary" Href="users">@L["ClaimCreate.OpenUserDirectory"]</SUIButton>
            </Actions>
        </SUIEmptyState>
    </div>
}
else
{
    <div class="contract-strip contract-strip--warning">
        <SUIIcon Name="refresh" Size="20" />
        <div>
            <strong>@L["ClaimCreate.ContractStrip.Title"]</strong>
            <span>@L["ClaimCreate.ContractStrip.Description"]</span>
        </div>
        <SUIStatusBadge ToneValue="SUITone.Warning">@L["ClaimCreate.ContractStrip.Badge"]</SUIStatusBadge>
    </div>

    @if (submission?.IsSuccess is false)
    {
        <div class="inline-notice inline-notice--danger" role="alert">
            <SUIIcon Name="alert" Size="19" />
            <div>
                <strong>@L["ClaimCreate.SubmitError.Title"]</strong>
                <span>@submission.ErrorMessage</span>
            </div>
        </div>
    }

    <ManagementDataView Result="userResult" OnRetry="LoadAsync">
    <Success Context="_">
    <div>
    <EditForm Model="model"
              OnValidSubmit="CreateAsync"
              FormName="create-user-claim"
              class="management-form">
        <DataAnnotationsValidator />

        <div class="form-section" aria-labelledby="claim-account-heading">
            <div class="form-section__heading">
                <h2 id="claim-account-heading">@L["ClaimCreate.Account.Heading"]</h2>
                <p>@L["ClaimCreate.Account.Description"]</p>
            </div>
            <dl class="property-list">
                <div>
                    <dt>@L["ClaimCreate.Field.User"]</dt>
                    <dd>@AccountLabel</dd>
                </div>
                <div>
                    <dt>@L["ClaimCreate.Field.Email"]</dt>
                    <dd>@(userResult?.Value?.Email ?? L["ClaimCreate.NotInformed"].Value)</dd>
                </div>
                <div>
                    <dt>@L["ClaimCreate.Field.Identifier"]</dt>
                    <dd><code class="client-id">@UserId</code></dd>
                </div>
            </dl>
        </div>

        <div class="form-section" aria-labelledby="claim-value-heading">
            <div class="form-section__heading">
                <h2 id="claim-value-heading">@L["ClaimCreate.Attribute.Heading"]</h2>
                <p>@L["ClaimCreate.Attribute.Description"]</p>
            </div>

            <SUIStack Spacing="4">
                @* Free text with suggestions: SUIAutocomplete only commits a
                   listed item, so the field keeps the native datalist hint. *@
                <IdentityTextField T="string"
                                   Id="claim-type"
                                   Label="@L["ClaimCreate.Field.Type"].Value"
                                   HelperText="@TypeHint"
                                   list="claim-type-suggestions"
                                   autocomplete="off"
                                   @bind-Value="model.Type" />
                <datalist id="claim-type-suggestions">
                    @foreach (var type in SuggestedTypes)
                    {
                        <option value="@type"></option>
                    }
                </datalist>
                <IdentityTextField T="string"
                                   Id="claim-value"
                                   Label="@L["ClaimCreate.Field.Value"].Value"
                                   HelperText="@L["ClaimCreate.Field.ValueHint"].Value"
                                   Multiline="true"
                                   @bind-Value="model.Value" />
            </SUIStack>
        </div>

        <SUIStack Row Wrap AlignItems="Center" Justify="End" Spacing="2" Class="form-actions">
            <SUIButton ColorValue="SUIColor.Secondary" Href="@BackHref">@L["ClaimCreate.Cancel"]</SUIButton>
            <SUILoadingButton ButtonTypeValue="SUIButtonType.Submit"
                              ColorValue="SUIColor.Primary"
                              StartIcon="plus"
                              IsLoading="@submitting"
                              Disabled="@(submitting || userResult?.IsSuccess is not true)">
                @(submitting ? L["ClaimCreate.Submitting"] : L["ClaimCreate.Submit"])
            </SUILoadingButton>
        </SUIStack>
    </EditForm>
    </div>
    </Success>
    </ManagementDataView>
}

@code {
    [SupplyParameterFromQuery(Name = "user")]
    public string? UserId { get; set; }

    private readonly ClaimCreateModel model = new();
    private ManagementDataResult<ManagementClaimMetadata>? metadataResult;
    private ManagementDataResult<ManagementUserDetail>? userResult;
    private ManagementDataResult<ManagementClaimAssignment>? submission;
    private bool submitting;

    private bool HasUserContext =>
        !string.IsNullOrWhiteSpace(UserId);

    private string TypeHint =>
        $"{L["ClaimCreate.Field.TypeHintPrefix"].Value} locale, zoneinfo {L["ClaimCreate.Field.TypeHintSuffix"].Value}";

    private IReadOnlyList<string> SuggestedTypes =>
        metadataResult?.Value?.SuggestedTypes ?? [];

    private string AccountLabel =>
        userResult?.Value is { } user
            ? user.UserName ?? user.Email ?? user.Id
            : L["ClaimCreate.LoadingAccount"].Value;

    private string HeaderDescription =>
        HasUserContext
            ? string.Format(L["ClaimCreate.HeaderDescriptionFormat"].Value, AccountLabel)
            : L["ClaimCreate.HeaderDescriptionNoUser"].Value;

    private string BackHref =>
        HasUserContext
            ? $"claims?user={Uri.EscapeDataString(UserId!)}"
            : "users";

    protected override async Task OnParametersSetAsync()
    {
        metadataResult = null;
        userResult = null;
        submission = null;

        if (!HasUserContext)
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        userResult = null;
        var metadataTask = ClaimData.GetMetadataAsync();
        var userTask = UserData.GetAsync(UserId!);
        await Task.WhenAll(metadataTask, userTask);
        metadataResult = await metadataTask;
        userResult = await userTask;
    }

    private async Task CreateAsync()
    {
        if (!HasUserContext || submitting)
        {
            return;
        }

        submitting = true;
        submission = await ClaimData.CreateAsync(
            new CreateManagementClaimCommand(
                UserId!,
                model.Type,
                model.Value));
        submitting = false;

        if (submission.IsSuccess)
        {
            Navigation.NavigateTo($"{BackHref}&created=1");
        }
    }

    protected override void OnInitialized()
    {
        model.Localizer = L;
        base.OnInitialized();
    }

    private sealed class ClaimCreateModel : IValidatableObject
    {
        public IStringLocalizer<Sufficit.Identity.UI.Management.Resources.ManagementResource>? Localizer { get; set; }

        public string Type { get; set; } = string.Empty;

        public string Value { get; set; } = string.Empty;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            var l = Localizer ?? throw new InvalidOperationException(
                "The form model localizer must be set before validation.");

            if (string.IsNullOrWhiteSpace(Type))
            {
                yield return new ValidationResult(l["Claims.Validation.TypeRequired"].Value, [nameof(Type)]);
            }
            if (Type?.Length > 256)
            {
                yield return new ValidationResult(l["Common.Validation.MaxLength", 256].Value, [nameof(Type)]);
            }
            if (string.IsNullOrWhiteSpace(Value))
            {
                yield return new ValidationResult(l["Claims.Validation.ValueRequired"].Value, [nameof(Value)]);
            }
            if (Value?.Length > 4096)
            {
                yield return new ValidationResult(l["Common.Validation.MaxLength", 4096].Value, [nameof(Value)]);
            }
        }
    }
}
