@page "/claims"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageClaims)]
@attribute [StreamRendering]
@inject ManagementClaimDataSource ClaimData
@inject ManagementUserDataSource UserData

<PageTitle>@PageTitleText</PageTitle>

<SUIPageHeader Title="@HeaderTitle"
            Description="@L["Claims.HeaderDescription"].Value">
    <Actions>
        <a class="button button--secondary" href="@UserHref">
            <SUIIcon Name="arrow-left" Size="17" />
            @L["Claims.BackToUser"]
        </a>
        @if (HasUserContext)
        {
            <a class="button button--primary" href="@CreateHref">
                <SUIIcon Name="plus" Size="17" />
                @L["Claims.AssignClaim"]
            </a>
        }
    </Actions>
</SUIPageHeader>

@if (!HasUserContext)
{
    <div>
        <SUIEmptyState Icon="users"
                    Title="@L["Claims.SelectUser.Title"].Value"
                    Description="@L["Claims.SelectUser.Description"].Value">
            <Actions>
                <a class="button button--primary" href="users">@L["Claims.OpenUserDirectory"]</a>
            </Actions>
        </SUIEmptyState>
    </div>
}
else
{
    @if (Created is 1)
    {
        <div class="inline-notice inline-notice--success" role="status">
            <SUIIcon Name="check" Size="19" />
            <div>
                <strong>@L["Claims.Assigned.Title"]</strong>
                <span>@L["Claims.Assigned.Description"]</span>
            </div>
        </div>
    }

    @if (Deleted is 1)
    {
        <div class="inline-notice inline-notice--success" role="status">
            <SUIIcon Name="check" Size="19" />
            <div>
                <strong>@L["Claims.Removed.Title"]</strong>
                <span>@L["Claims.Removed.Description"]</span>
            </div>
        </div>
    }

    <div class="contract-strip contract-strip--info">
        <SUIIcon Name="users" Size="20" />
        <div>
            <strong>@AccountLabel</strong>
            <span>@AccountDescription</span>
        </div>
        <SUIStatusBadge ToneValue="SUITone.Info">@L["Claims.ContractStrip.Badge"]</SUIStatusBadge>
    </div>

    <div class="table-panel" aria-labelledby="claims-list-heading" aria-busy="@loading">
        <div class="data-toolbar data-toolbar--users">
            <div>
                <h2 id="claims-list-heading">@L["Claims.List.Heading"]</h2>
                <p>@L["Claims.List.Description"]</p>
            </div>
            <div class="data-toolbar__actions">
                <form class="user-search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
                    <label class="search-field">
                        <span class="visually-hidden">@L["Claims.Search.VisuallyHidden"]</span>
                        <SUIIcon Name="search" Size="18" />
                        <input type="search"
                               placeholder="@L["Claims.Search.Placeholder"].Value"
                               autocomplete="off"
                               @bind="search" />
                    </label>
                    <button class="button button--secondary" type="submit" disabled="@loading">
                        @L["Claims.Search.Submit"]
                    </button>
                    @if (!string.IsNullOrWhiteSpace(search))
                    {
                        <button class="button button--secondary button--compact"
                                type="button"
                                @onclick="ClearSearchAsync">
                            @L["Claims.Search.Clear"]
                        </button>
                    }
                </form>
            </div>
        </div>

        <div class="client-results" aria-live="polite">
            @if (loading)
            {
                <div class="table-skeleton" aria-label="@L["Claims.LoadingAriaLabel"].Value">
                    @for (var index = 0; index < 4; index++)
                    {
                        <span></span>
                    }
                </div>
            }
            else if (userResult?.IsSuccess is false)
            {
                <SUIEmptyState Icon="alert"
                            Title="@UserErrorTitle"
                            Description="@(userResult.ErrorMessage ?? L["Claims.User.Error.GenericDescription"].Value)">
                    <Actions>
                        <a class="button button--secondary" href="users">@L["Claims.BackToUsers"]</a>
                    </Actions>
                </SUIEmptyState>
            }
            else if (result?.IsSuccess is true)
            {
                @if (Page.Items.Count is 0)
                {
                    <SUIEmptyState Icon="shield"
                                Title="@L["Claims.Empty.Title"].Value"
                                Description="@EmptyDescription">
                        <Actions>
                            <a class="button button--primary" href="@CreateHref">@L["Claims.AssignFirstClaim"]</a>
                        </Actions>
                    </SUIEmptyState>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="data-table data-table--claims">
                            <thead>
                                <tr>
                                    <th scope="col">@L["Claims.Column.Type"]</th>
                                    <th scope="col">@L["Claims.Column.Value"]</th>
                                    <th scope="col">@L["Claims.Column.State"]</th>
                                    <th scope="col"><span class="visually-hidden">@L["Claims.Column.Actions"]</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var claim in Page.Items)
                                {
                                    <tr>
                                        <td data-label="@L["Claims.Column.Type"].Value"><code class="client-id">@claim.Type</code></td>
                                        <td data-label="@L["Claims.Column.Value"].Value"><span class="claim-value">@claim.Value</span></td>
                                        <td data-label="@L["Claims.Column.State"].Value"><SUIStatusBadge ToneValue="SUITone.Success">@L["Claims.AssignedBadge"]</SUIStatusBadge></td>
                                        <td data-label="@L["Claims.Column.Actions"].Value">
                                            <a class="row-action" href="@ClaimHref(claim.Id)">
                                                @L["Claims.Edit"]
                                                <SUIIcon Name="edit" Size="15" />
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else
            {
                <SUIEmptyState Icon="alert"
                            Title="@ErrorTitle"
                            Description="@(result?.ErrorMessage ?? L["Claims.Error.GenericDescription"].Value)">
                    <Actions>
                        <button class="button button--secondary" type="button" @onclick="LoadAsync">
                            @L["Claims.Retry"]
                        </button>
                    </Actions>
                </SUIEmptyState>
            }
        </div>

        <footer class="table-footer table-footer--paginated">
            <span>@ResultCountLabel</span>
            @if (result?.IsSuccess is true && Page.TotalCount > Page.PageSize)
            {
                <div class="pagination" aria-label="@L["Claims.PaginationAriaLabel"].Value">
                    <button class="button button--secondary button--compact" type="button"
                            disabled="@(Page.Page <= 1 || loading)"
                            @onclick="PreviousPageAsync">@L["Claims.Previous"]</button>
                    <span>@string.Format(L["Claims.PageOfFormat"].Value, Page.Page, TotalPages)</span>
                    <button class="button button--secondary button--compact" type="button"
                            disabled="@(Page.Page >= TotalPages || loading)"
                            @onclick="NextPageAsync">@L["Claims.Next"]</button>
                </div>
            }
        </footer>
    </div>

    <div class="client-guardrails" aria-labelledby="claim-boundary-heading">
        <div>
            <h2 id="claim-boundary-heading">@L["Claims.Boundary.Heading"]</h2>
            <p>@L["Claims.Boundary.Description"]</p>
        </div>
        <ul>
            <li><SUIIcon Name="shield" Size="18" /> @L["Claims.Boundary.ReservedProtected"]</li>
            <li><SUIIcon Name="refresh" Size="18" /> @L["Claims.Boundary.MutationRevokes"]</li>
            <li><SUIIcon Name="audit" Size="18" /> @L["Claims.Boundary.ValuesNotAudited"]</li>
        </ul>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "user")]
    public string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "created")]
    public int Created { get; set; }

    [SupplyParameterFromQuery(Name = "deleted")]
    public int Deleted { get; set; }

    private ManagementDataResult<ManagementUserDetail>? userResult;
    private ManagementDataResult<ManagementClaimPage>? result;
    private string search = string.Empty;
    private int currentPage = 1;
    private bool loading = true;
    private const int PageSize = 25;

    private bool HasUserContext =>
        !string.IsNullOrWhiteSpace(UserId);

    private ManagementClaimPage Page =>
        result?.Value ?? new([], 1, PageSize, 0, UserId ?? string.Empty);

    private string HeaderTitle =>
        userResult?.Value is { } user
            ? string.Format(L["Claims.HeaderTitleFormat"].Value, DisplayName(user))
            : L["Claims.HeaderTitleDefault"].Value;

    private string PageTitleText =>
        string.Format(L["Claims.PageTitleFormat"].Value, HeaderTitle);

    private string AccountLabel =>
        userResult?.Value is { } user
            ? DisplayName(user)
            : L["Claims.AccountLabelDefault"].Value;

    private string AccountDescription =>
        userResult?.Value is { } user
            ? $"{user.Email ?? L["Claims.EmailNotInformed"].Value} · {user.Id}"
            : UserId ?? string.Empty;

    private string UserHref =>
        HasUserContext
            ? $"users/{Uri.EscapeDataString(UserId!)}"
            : "users";

    private string CreateHref =>
        $"claims/new?user={Uri.EscapeDataString(UserId!)}";

    private int TotalPages =>
        Math.Max(1, (int)Math.Ceiling(Page.TotalCount / (double)Page.PageSize));

    private string EmptyDescription =>
        string.IsNullOrWhiteSpace(search)
            ? L["Claims.Empty.NoAttributesYet"].Value
            : L["Claims.Empty.NoMatch"].Value;

    private string UserErrorTitle =>
        userResult?.Outcome is ManagementDataOutcome.NotFound
            ? L["Claims.User.Error.NotFound"].Value
            : L["Claims.User.Error.Generic"].Value;

    private string ErrorTitle =>
        result?.Outcome is ManagementDataOutcome.StepUpRequired
            ? L["Claims.Error.StepUp"].Value
            : result?.Outcome is ManagementDataOutcome.Forbidden
                ? L["Claims.Error.Forbidden"].Value
                : L["Claims.Error.Generic"].Value;

    private string ResultCountLabel =>
        loading
            ? L["Claims.ResultCount.Loading"].Value
            : result?.IsSuccess is true
                ? $"{Page.TotalCount} {Pluralize(Page.TotalCount, L["Claims.ResultCount.Singular"].Value, L["Claims.ResultCount.Plural"].Value)}"
                : L["Claims.ResultCount.NoneLoaded"].Value;

    protected override async Task OnParametersSetAsync()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        userResult = null;
        result = null;

        if (!HasUserContext)
        {
            loading = false;
            return;
        }

        var userTask = UserData.GetAsync(UserId!);
        var claimsTask = ClaimData.SearchAsync(
            new ManagementClaimSearch(search, UserId, currentPage, PageSize));
        await Task.WhenAll(userTask, claimsTask);
        userResult = await userTask;
        result = await claimsTask;
        loading = false;
    }

    private async Task SearchAsync()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task ClearSearchAsync()
    {
        search = string.Empty;
        currentPage = 1;
        await LoadAsync();
    }

    private async Task PreviousPageAsync()
    {
        currentPage = Math.Max(1, currentPage - 1);
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        currentPage = Math.Min(TotalPages, currentPage + 1);
        await LoadAsync();
    }

    private string ClaimHref(int id) =>
        $"claims/edit?user={Uri.EscapeDataString(UserId!)}&claim={id}";

    private static string DisplayName(ManagementUserDetail user) =>
        user.UserName ?? user.Email ?? user.Id;

    private static string Pluralize(int count, string singular, string plural) =>
        count is 1 ? singular : plural;
}
