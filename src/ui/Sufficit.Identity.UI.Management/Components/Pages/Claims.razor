@page "/claims"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageClaims)]
@attribute [StreamRendering]
@inject ManagementClaimDataSource ClaimData
@inject ManagementUserDataSource UserData

<PageTitle>@PageTitleText</PageTitle>

<SUIPageHeader Title="@HeaderTitle"
            Description="@L["Claims.HeaderDescription"].Value">
    <Actions>
        <SUIButton ColorValue="SUIColor.Secondary" StartIcon="arrow-left" Href="@UserHref">
            @L["Claims.BackToUser"]
        </SUIButton>
        @if (HasUserContext)
        {
            <SUIButton ColorValue="SUIColor.Primary" StartIcon="plus" Href="@CreateHref">
                @L["Claims.AssignClaim"]
            </SUIButton>
        }
    </Actions>
</SUIPageHeader>

@if (!HasUserContext)
{
    <div>
        <SUIEmptyState Icon="users"
                    Title="@L["Claims.SelectUser.Title"].Value"
                    Description="@L["Claims.SelectUser.Description"].Value">
            <Actions>
                <SUIButton ColorValue="SUIColor.Primary" Href="users">@L["Claims.OpenUserDirectory"]</SUIButton>
            </Actions>
        </SUIEmptyState>
    </div>
}
else
{
    <div class="page-notices">
        @if (Created is 1)
        {
            <SUIAlert ToneValue="SUITone.Success" Icon="check" role="status">
                <div><strong>@L["Claims.Assigned.Title"]</strong> <span>@L["Claims.Assigned.Description"]</span></div>
            </SUIAlert>
        }

        @if (Deleted is 1)
        {
            <SUIAlert ToneValue="SUITone.Success" Icon="check" role="status">
                <div><strong>@L["Claims.Removed.Title"]</strong> <span>@L["Claims.Removed.Description"]</span></div>
            </SUIAlert>
        }

        <SUIAlert ToneValue="SUITone.Info" Icon="users" role="note">
            <SUIStack Row Wrap AlignItems="Center" Justify="Between" Spacing="2">
                <div><strong>@AccountLabel</strong> <span>@AccountDescription</span></div>
                <SUIStatusBadge ToneValue="SUITone.Info">@L["Claims.ContractStrip.Badge"]</SUIStatusBadge>
            </SUIStack>
        </SUIAlert>
    </div>

    <div class="table-panel" aria-labelledby="claims-list-heading" aria-busy="@loading">
        <div class="data-toolbar data-toolbar--users">
            <div>
                <h2 id="claims-list-heading">@L["Claims.List.Heading"]</h2>
                <p>@L["Claims.List.Description"]</p>
            </div>
            <div class="data-toolbar__actions">
                <form @onsubmit="SearchAsync" @onsubmit:preventDefault>
                    <SUIStack Row Wrap AlignItems="End" Spacing="2">
                        <IdentityTextField T="string"
                                           Id="claim-search"
                                           InputType="search"
                                           AdornmentIcon="search"
                                           Placeholder="@L["Claims.Search.Placeholder"].Value"
                                           aria-label="@L["Claims.Search.VisuallyHidden"].Value"
                                           autocomplete="off"
                                           @bind-Value="search" />
                        <SUIButton ButtonTypeValue="SUIButtonType.Submit"
                                   ColorValue="SUIColor.Secondary"
                                   Disabled="@loading">
                            @L["Claims.Search.Submit"]
                        </SUIButton>
                        @if (!string.IsNullOrWhiteSpace(search))
                        {
                            <SUIButton ColorValue="SUIColor.Secondary"
                                       SizeValue="SUISize.Small"
                                       OnClick="ClearSearchAsync">
                                @L["Claims.Search.Clear"]
                            </SUIButton>
                        }
                    </SUIStack>
                </form>
            </div>
        </div>

        <ManagementDataView Result="userResult"
                            Loading="loading"
                            OnRetry="LoadAsync"
                            Class="client-results"
                            LoadingLabel="@L["Claims.LoadingAriaLabel"].Value"
                            NotFoundTitle="@L["Claims.User.Error.NotFound"].Value"
                            UnavailableTitle="@L["Claims.User.Error.Generic"].Value">
            <FailureActions>
                <SUIButton ColorValue="SUIColor.Secondary" Href="users">@L["Claims.BackToUsers"]</SUIButton>
            </FailureActions>
            <Success Context="_">
            <ManagementDataView Result="result"
                                OnRetry="LoadAsync"
                                StepUpTitle="@L["Claims.Error.StepUp"].Value"
                                ForbiddenTitle="@L["Claims.Error.Forbidden"].Value"
                                UnavailableTitle="@L["Claims.Error.Generic"].Value">
                <Success Context="claimPage">
                @if (Page.Items.Count is 0)
                {
                    <SUIEmptyState Icon="shield"
                                Title="@L["Claims.Empty.Title"].Value"
                                Description="@EmptyDescription">
                        <Actions>
                            <SUIButton ColorValue="SUIColor.Primary" Href="@CreateHref">@L["Claims.AssignFirstClaim"]</SUIButton>
                        </Actions>
                    </SUIEmptyState>
                }
                else
                {
                    <SUITable TItem="ManagementClaimAssignment"
                              Items="Page.Items"
                              RowKey="claim => claim.Id"
                              Hover="true"
                              StackOnMobile="true">
                        <HeaderContent>
                            <SUITh>@L["Claims.Column.Type"]</SUITh>
                            <SUITh>@L["Claims.Column.Value"]</SUITh>
                            <SUITh>@L["Claims.Column.State"]</SUITh>
                            <SUITh><span class="visually-hidden">@L["Claims.Column.Actions"]</span></SUITh>
                        </HeaderContent>
                        <RowTemplate Context="claim">
                            <SUITd DataLabel="@L["Claims.Column.Type"].Value"><code class="client-id">@claim.Type</code></SUITd>
                            <SUITd DataLabel="@L["Claims.Column.Value"].Value"><span class="claim-value">@claim.Value</span></SUITd>
                            <SUITd DataLabel="@L["Claims.Column.State"].Value"><SUIStatusBadge ToneValue="SUITone.Success">@L["Claims.AssignedBadge"]</SUIStatusBadge></SUITd>
                            <SUITd DataLabel="@L["Claims.Column.Actions"].Value">
                                <SUIButton VariantValue="SUIVariant.Text"
                                           ColorValue="SUIColor.Primary"
                                           SizeValue="SUISize.Small"
                                           EndIcon="edit"
                                           Href="@ClaimHref(claim.Id)">
                                    @L["Claims.Edit"]
                                </SUIButton>
                            </SUITd>
                        </RowTemplate>
                    </SUITable>
                }
                </Success>
            </ManagementDataView>
            </Success>
        </ManagementDataView>

        <footer class="table-footer table-footer--paginated">
            @if (result?.IsSuccess is true)
            {
                <SUIPagination TotalItems="Page.TotalCount"
                               PageSize="Page.PageSize"
                               PageIndex="@(Page.Page - 1)"
                               PageIndexChanged="GoToPageAsync"
                               Disabled="loading"
                               AriaLabel="@L["Claims.PaginationAriaLabel"].Value"
                               PreviousLabel="@L["Claims.Previous"].Value"
                               NextLabel="@L["Claims.Next"].Value"
                               PageLabel="@((current, count) => string.Format(L["Claims.PageOfFormat"].Value, current, count))"
                               RangeFormatter="@((first, last, total) => string.Format(L["Claims.RangeFormat"].Value, first, last, total, CountNoun(total)))"
                               EmptyText="@($"0 {CountNoun(0)}")" />
            }
            else
            {
                <span>@ResultCountLabel</span>
            }
        </footer>
    </div>

    <div class="client-guardrails" aria-labelledby="claim-boundary-heading">
        <div>
            <h2 id="claim-boundary-heading">@L["Claims.Boundary.Heading"]</h2>
            <p>@L["Claims.Boundary.Description"]</p>
        </div>
        <ul>
            <li><SUIIcon Name="shield" Size="18" /> @L["Claims.Boundary.ReservedProtected"]</li>
            <li><SUIIcon Name="refresh" Size="18" /> @L["Claims.Boundary.MutationRevokes"]</li>
            <li><SUIIcon Name="audit" Size="18" /> @L["Claims.Boundary.ValuesNotAudited"]</li>
        </ul>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "user")]
    public string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "created")]
    public int Created { get; set; }

    [SupplyParameterFromQuery(Name = "deleted")]
    public int Deleted { get; set; }

    private ManagementDataResult<ManagementUserDetail>? userResult;
    private ManagementDataResult<ManagementClaimPage>? result;
    private string search = string.Empty;
    private int currentPage = 1;
    private bool loading = true;
    private const int PageSize = 25;

    private bool HasUserContext =>
        !string.IsNullOrWhiteSpace(UserId);

    private ManagementClaimPage Page =>
        result?.Value ?? new([], 1, PageSize, 0, UserId ?? string.Empty);

    private string HeaderTitle =>
        userResult?.Value is { } user
            ? string.Format(L["Claims.HeaderTitleFormat"].Value, DisplayName(user))
            : L["Claims.HeaderTitleDefault"].Value;

    private string PageTitleText =>
        string.Format(L["Claims.PageTitleFormat"].Value, HeaderTitle);

    private string AccountLabel =>
        userResult?.Value is { } user
            ? DisplayName(user)
            : L["Claims.AccountLabelDefault"].Value;

    private string AccountDescription =>
        userResult?.Value is { } user
            ? $"{user.Email ?? L["Claims.EmailNotInformed"].Value} · {user.Id}"
            : UserId ?? string.Empty;

    private string UserHref =>
        HasUserContext
            ? $"users/{Uri.EscapeDataString(UserId!)}"
            : "users";

    private string CreateHref =>
        $"claims/new?user={Uri.EscapeDataString(UserId!)}";

    private int TotalPages =>
        Math.Max(1, (int)Math.Ceiling(Page.TotalCount / (double)Page.PageSize));

    private string EmptyDescription =>
        string.IsNullOrWhiteSpace(search)
            ? L["Claims.Empty.NoAttributesYet"].Value
            : L["Claims.Empty.NoMatch"].Value;

    private string ResultCountLabel =>
        loading
            ? L["Claims.ResultCount.Loading"].Value
            : L["Claims.ResultCount.NoneLoaded"].Value;

    private string CountNoun(int count) =>
        Pluralize(count, L["Claims.ResultCount.Singular"].Value, L["Claims.ResultCount.Plural"].Value);

    protected override async Task OnParametersSetAsync()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        userResult = null;
        result = null;

        if (!HasUserContext)
        {
            loading = false;
            return;
        }

        var userTask = UserData.GetAsync(UserId!);
        var claimsTask = ClaimData.SearchAsync(
            new ManagementClaimSearch(search, UserId, currentPage, PageSize));
        await Task.WhenAll(userTask, claimsTask);
        userResult = await userTask;
        result = await claimsTask;
        loading = false;
    }

    private async Task SearchAsync()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task ClearSearchAsync()
    {
        search = string.Empty;
        currentPage = 1;
        await LoadAsync();
    }

    private async Task GoToPageAsync(int pageIndex)
    {
        currentPage = Math.Clamp(pageIndex + 1, 1, TotalPages);
        await LoadAsync();
    }

    private string ClaimHref(int id) =>
        $"claims/edit?user={Uri.EscapeDataString(UserId!)}&claim={id}";

    private static string DisplayName(ManagementUserDetail user) =>
        user.UserName ?? user.Email ?? user.Id;

    private static string Pluralize(int count, string singular, string plural) =>
        count is 1 ? singular : plural;
}
