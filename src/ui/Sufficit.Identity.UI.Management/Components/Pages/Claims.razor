@page "/claims"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageClaims)]
@attribute [StreamRendering]
@inject ManagementClaimDataSource ClaimData
@inject ManagementUserDataSource UserData

<PageTitle>@PageTitleText</PageTitle>

<PageHeader Title="@HeaderTitle"
            Description="Atributos adicionais emitidos pelo provedor para esta conta.">
    <Actions>
        <a class="button button--secondary" href="@UserHref">
            <AppIcon Name="arrow-left" Size="17" />
            Voltar para o usuário
        </a>
        @if (HasUserContext)
        {
            <a class="button button--primary" href="@CreateHref">
                <AppIcon Name="plus" Size="17" />
                Atribuir claim
            </a>
        }
    </Actions>
</PageHeader>

@if (!HasUserContext)
{
    <div>
        <EmptyState Icon="users"
                    Title="Selecione um usuário"
                    Description="Abra uma conta no diretório de identidades para consultar e administrar suas claims.">
            <Actions>
                <a class="button button--primary" href="users">Abrir diretório de usuários</a>
            </Actions>
        </EmptyState>
    </div>
}
else
{
    @if (Created is 1)
    {
        <div class="inline-notice inline-notice--success" role="status">
            <AppIcon Name="check" Size="19" />
            <div>
                <strong>Claim atribuída</strong>
                <span>O selo de segurança foi atualizado e os tokens anteriores foram revogados.</span>
            </div>
        </div>
    }

    @if (Deleted is 1)
    {
        <div class="inline-notice inline-notice--success" role="status">
            <AppIcon Name="check" Size="19" />
            <div>
                <strong>Claim removida</strong>
                <span>A atribuição foi excluída e as credenciais emitidas anteriormente foram revogadas.</span>
            </div>
        </div>
    }

    <div class="contract-strip contract-strip--info">
        <AppIcon Name="users" Size="20" />
        <div>
            <strong>@AccountLabel</strong>
            <span>@AccountDescription</span>
        </div>
        <StatusBadge Tone="info">Conta selecionada</StatusBadge>
    </div>

    <div class="table-panel" aria-labelledby="claims-list-heading" aria-busy="@loading">
        <div class="data-toolbar data-toolbar--users">
            <div>
                <h2 id="claims-list-heading">Claims da conta</h2>
                <p>Tipos multivalorados aparecem em linhas separadas e podem ser editados individualmente.</p>
            </div>
            <div class="data-toolbar__actions">
                <form class="user-search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
                    <label class="search-field">
                        <span class="visually-hidden">Pesquisar claims da conta</span>
                        <AppIcon Name="search" Size="18" />
                        <input type="search"
                               placeholder="Tipo ou valor"
                               autocomplete="off"
                               @bind="search" />
                    </label>
                    <button class="button button--secondary" type="submit" disabled="@loading">
                        Pesquisar
                    </button>
                    @if (!string.IsNullOrWhiteSpace(search))
                    {
                        <button class="button button--secondary button--compact"
                                type="button"
                                @onclick="ClearSearchAsync">
                            Limpar
                        </button>
                    }
                </form>
            </div>
        </div>

        <div class="client-results" aria-live="polite">
            @if (loading)
            {
                <div class="table-skeleton" aria-label="Carregando claims">
                    @for (var index = 0; index < 4; index++)
                    {
                        <span></span>
                    }
                </div>
            }
            else if (userResult?.IsSuccess is false)
            {
                <EmptyState Icon="alert"
                            Title="@UserErrorTitle"
                            Description="@(userResult.ErrorMessage ?? "O serviço não conseguiu ler a conta.")">
                    <Actions>
                        <a class="button button--secondary" href="users">Voltar para usuários</a>
                    </Actions>
                </EmptyState>
            }
            else if (result?.IsSuccess is true)
            {
                @if (Page.Items.Count is 0)
                {
                    <EmptyState Icon="shield"
                                Title="Nenhuma claim atribuída"
                                Description="@EmptyDescription">
                        <Actions>
                            <a class="button button--primary" href="@CreateHref">Atribuir primeira claim</a>
                        </Actions>
                    </EmptyState>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="data-table data-table--claims">
                            <thead>
                                <tr>
                                    <th scope="col">Tipo</th>
                                    <th scope="col">Valor</th>
                                    <th scope="col">Estado</th>
                                    <th scope="col"><span class="visually-hidden">Ações</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var claim in Page.Items)
                                {
                                    <tr>
                                        <td data-label="Tipo"><code class="client-id">@claim.Type</code></td>
                                        <td data-label="Valor"><span class="claim-value">@claim.Value</span></td>
                                        <td data-label="Estado"><StatusBadge Tone="success">Atribuída</StatusBadge></td>
                                        <td data-label="Ações">
                                            <a class="row-action" href="@ClaimHref(claim.Id)">
                                                Editar
                                                <AppIcon Name="edit" Size="15" />
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else
            {
                <EmptyState Icon="alert"
                            Title="@ErrorTitle"
                            Description="@(result?.ErrorMessage ?? "O serviço não conseguiu ler as atribuições agora.")">
                    <Actions>
                        <button class="button button--secondary" type="button" @onclick="LoadAsync">
                            Tentar novamente
                        </button>
                    </Actions>
                </EmptyState>
            }
        </div>

        <footer class="table-footer table-footer--paginated">
            <span>@ResultCountLabel</span>
            @if (result?.IsSuccess is true && Page.TotalCount > Page.PageSize)
            {
                <div class="pagination" aria-label="Paginação de claims">
                    <button class="button button--secondary button--compact" type="button"
                            disabled="@(Page.Page <= 1 || loading)"
                            @onclick="PreviousPageAsync">Anterior</button>
                    <span>Página @Page.Page de @TotalPages</span>
                    <button class="button button--secondary button--compact" type="button"
                            disabled="@(Page.Page >= TotalPages || loading)"
                            @onclick="NextPageAsync">Próxima</button>
                </div>
            }
        </footer>
    </div>

    <div class="client-guardrails" aria-labelledby="claim-boundary-heading">
        <div>
            <h2 id="claim-boundary-heading">Atributos do protocolo, não regras empresariais</h2>
            <p>O provedor armazena os valores; cada aplicação decide como interpretá-los.</p>
        </div>
        <ul>
            <li><AppIcon Name="shield" Size="18" /> Claims reservadas permanecem protegidas</li>
            <li><AppIcon Name="refresh" Size="18" /> Cada mutação revoga tokens da conta</li>
            <li><AppIcon Name="audit" Size="18" /> Valores não entram na auditoria</li>
        </ul>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "user")]
    public string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "created")]
    public int Created { get; set; }

    [SupplyParameterFromQuery(Name = "deleted")]
    public int Deleted { get; set; }

    private ManagementDataResult<ManagementUserDetail>? userResult;
    private ManagementDataResult<ManagementClaimPage>? result;
    private string search = string.Empty;
    private int currentPage = 1;
    private bool loading = true;
    private const int PageSize = 25;

    private bool HasUserContext =>
        !string.IsNullOrWhiteSpace(UserId);

    private ManagementClaimPage Page =>
        result?.Value ?? new([], 1, PageSize, 0, UserId ?? string.Empty);

    private string HeaderTitle =>
        userResult?.Value is { } user
            ? $"Claims de {DisplayName(user)}"
            : "Claims do usuário";

    private string PageTitleText => $"{HeaderTitle} | Sufficit Identity";

    private string AccountLabel =>
        userResult?.Value is { } user
            ? DisplayName(user)
            : "Conta do provedor";

    private string AccountDescription =>
        userResult?.Value is { } user
            ? $"{user.Email ?? "E-mail não informado"} · {user.Id}"
            : UserId ?? string.Empty;

    private string UserHref =>
        HasUserContext
            ? $"users/{Uri.EscapeDataString(UserId!)}"
            : "users";

    private string CreateHref =>
        $"claims/new?user={Uri.EscapeDataString(UserId!)}";

    private int TotalPages =>
        Math.Max(1, (int)Math.Ceiling(Page.TotalCount / (double)Page.PageSize));

    private string EmptyDescription =>
        string.IsNullOrWhiteSpace(search)
            ? "A conta ainda não possui atributos adicionais. Claims padrão continuam sendo derivadas pelo protocolo."
            : "Nenhuma claim desta conta corresponde ao tipo ou valor pesquisado.";

    private string UserErrorTitle =>
        userResult?.Outcome is ManagementDataOutcome.NotFound
            ? "Usuário não encontrado"
            : "Não foi possível abrir o usuário";

    private string ErrorTitle =>
        result?.Outcome is ManagementDataOutcome.StepUpRequired
            ? "MFA exigido para consultar claims"
            : result?.Outcome is ManagementDataOutcome.Forbidden
                ? "Acesso às claims negado"
                : "Não foi possível consultar as claims";

    private string ResultCountLabel =>
        loading
            ? "Carregando claims"
            : result?.IsSuccess is true
                ? $"{Page.TotalCount} {Pluralize(Page.TotalCount, "atribuição", "atribuições")}"
                : "Nenhum resultado carregado";

    protected override async Task OnParametersSetAsync()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        userResult = null;
        result = null;

        if (!HasUserContext)
        {
            loading = false;
            return;
        }

        var userTask = UserData.GetAsync(UserId!);
        var claimsTask = ClaimData.SearchAsync(
            new ManagementClaimSearch(search, UserId, currentPage, PageSize));
        await Task.WhenAll(userTask, claimsTask);
        userResult = await userTask;
        result = await claimsTask;
        loading = false;
    }

    private async Task SearchAsync()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task ClearSearchAsync()
    {
        search = string.Empty;
        currentPage = 1;
        await LoadAsync();
    }

    private async Task PreviousPageAsync()
    {
        currentPage = Math.Max(1, currentPage - 1);
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        currentPage = Math.Min(TotalPages, currentPage + 1);
        await LoadAsync();
    }

    private string ClaimHref(int id) =>
        $"claims/edit?user={Uri.EscapeDataString(UserId!)}&claim={id}";

    private static string DisplayName(ManagementUserDetail user) =>
        user.UserName ?? user.Email ?? user.Id;

    private static string Pluralize(int count, string singular, string plural) =>
        count is 1 ? singular : plural;
}
