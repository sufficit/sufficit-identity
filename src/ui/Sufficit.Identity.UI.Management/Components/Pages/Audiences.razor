@page "/audiences"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageScopes)]
@inject ManagementScopeDataSource ScopeData

<PageTitle>@L["Audiences.PageTitle"]</PageTitle>

<SUIPageHeader Title="@L["Audiences.HeaderTitle"].Value" Description="@L["Audiences.HeaderDescription"].Value">
    <Actions>
        <AuthorizeView Policy="@ManagementUiPolicies.UpdateAudienceBindings">
            <SUIButton ColorValue="SUIColor.Primary" StartIcon="plus" Disabled="@(!interactive || loading || busy || result?.IsSuccess is not true)" OnClick="OpenBinding">
                @L["Audiences.BindAudience"]
            </SUIButton>
        </AuthorizeView>
    </Actions>
</SUIPageHeader>

<div class="contract-strip contract-strip--info">
    <SUIIcon Name="scope" Size="20" />
    <div>
        <strong>@L["Audiences.InfoTitle"]</strong>
        <span>@L["Audiences.InfoDescription"]</span>
    </div>
</div>

@if (notice is not null)
{
    <div class="inline-notice inline-notice--success" role="status"><SUIIcon Name="check" Size="19" /><span>@notice</span></div>
}
@if (submission?.IsSuccess is false)
{
    <div class="inline-notice inline-notice--danger" role="alert">
        <SUIIcon Name="alert" Size="19" />
        <div><strong>@L["Audiences.BindingNotAlteredTitle"]</strong><span>@submission.ErrorMessage</span></div>
        @if (submission.Outcome is ManagementDataOutcome.Conflict)
        {
            <SUIButton ColorValue="SUIColor.Secondary" Disabled="@(loading || busy)" OnClick="ReloadForReviewAsync">@L["Audiences.ReloadToReview"]</SUIButton>
        }
    </div>
}

@if (showBinding)
{
    <AuthorizeView Policy="@ManagementUiPolicies.UpdateAudienceBindings">
        <div class="form-section" aria-labelledby="audience-binding-heading" aria-busy="@busy">
            <div class="form-section__heading">
                <h2 id="audience-binding-heading" tabindex="-1" @ref="actionHeading">@L["Audiences.BindAudience"]</h2>
                <p>@L["Audiences.BindingHelp"]</p>
            </div>
            @if (EditableScopes.Count is 0)
            {
                <p>@L["Audiences.NoScopesAvailable"] <a href="scopes/new">@L["Audiences.CreateScopeLink"]</a> @L["Audiences.NoScopesAvailableSuffix"]</p>
            }
            else
            {
                <SUIFormGrid Columns="2" Spacing="4" LabelLines="2">
                    <IdentityTextField T="string" Id="audience-name" Label="@L["Audiences.FieldIdentifier"].Value" HelperText="@L["Audiences.FieldIdentifierHelp"].Value" MaxLength="512" Disabled="@(busy || loading)" @bind-Value="audienceName" />
                    <IdentitySelect T="string" Id="audience-scope" Label="@L["Audiences.FieldScope"].Value" Disabled="@(busy || loading)" @bind-Value="selectedScopeId">
                        <SUISelectItem Value="@(string.Empty)">@L["Audiences.SelectScope"]</SUISelectItem>
                        @foreach (var scope in EditableScopes)
                        {
                            <SUISelectItem Value="@scope.Id">@scope.Name</SUISelectItem>
                        }
                    </IdentitySelect>
                </SUIFormGrid>
                <p class="audience-binding-impact">@L["Audiences.BindingImpact"]</p>
            }
            <SUIStack Row Wrap AlignItems="Center" Justify="End" Spacing="2" Class="form-actions">
                <SUILoadingButton ColorValue="SUIColor.Primary" IsLoading="@busy" Disabled="@(!CanSubmit)" OnClick="AddBindingAsync">@(busy ? L["Audiences.Saving"].Value : L["Audiences.SaveBinding"].Value)</SUILoadingButton>
                <SUIButton ColorValue="SUIColor.Secondary" Disabled="@busy" OnClick="CloseBinding">@L["Audiences.Cancel"]</SUIButton>
            </SUIStack>
        </div>
    </AuthorizeView>
}

@if (removal is not null)
{
    <div class="form-section" role="region" aria-labelledby="audience-remove-heading">
        <h2 id="audience-remove-heading" tabindex="-1" @ref="actionHeading">@L["Audiences.RemoveHeading"]</h2>
        <p>@L["Audiences.RemoveImpactPrefix"] <code>@removal.Scope.Name</code> @L["Audiences.RemoveImpactMiddle"] <code>@removal.Audience</code> @L["Audiences.RemoveImpactSuffix"]</p>
        <p>@L["Audiences.LastBindingNotice"]</p>
        <SUIStack Row Wrap AlignItems="Center" Justify="End" Spacing="2" Class="form-actions">
            <SUILoadingButton ColorValue="SUIColor.Error" IsLoading="@busy" Disabled="@(busy || loading)" OnClick="RemoveBindingAsync">@(busy ? L["Audiences.Removing"].Value : L["Audiences.ConfirmRemoval"].Value)</SUILoadingButton>
            <SUIButton ColorValue="SUIColor.Secondary" Disabled="@busy" OnClick="CancelRemoval">@L["Audiences.Cancel"]</SUIButton>
        </SUIStack>
    </div>
}

<div class="table-panel audience-panel" aria-labelledby="audiences-list-heading" aria-busy="@loading">
    <div class="data-toolbar">
        <div><h2 id="audiences-list-heading" tabindex="-1" @ref="inventoryHeading">@L["Audiences.ListHeading"]</h2><p>@L["Audiences.ListDescription"]</p></div>
        <IdentityTextField T="string"
                           Id="audience-search"
                           InputType="search"
                           AdornmentIcon="search"
                           Immediate="true"
                           Placeholder="@L["Audiences.SearchPlaceholder"].Value"
                           aria-label="@L["Audiences.SearchLabel"].Value"
                           autocomplete="off"
                           @bind-Value="search" />
    </div>
    <ManagementDataView Result="result"
                        Loading="loading"
                        OnRetry="LoadAsync"
                        LoadingLabel="@L["Audiences.LoadingAriaLabel"].Value"
                        SkeletonRows="3"
                        UnavailableTitle="@L["Audiences.LoadErrorTitle"].Value">
    <Success Context="inventory">
    @if (FilteredAudiences.Count is 0)
    {
        <SUIEmptyState Icon="server" Title="@(AllAudiences.Count is 0 ? L["Audiences.EmptyTitleNone"].Value : L["Audiences.EmptyTitleSearch"].Value)" Description="@(AllAudiences.Count is 0 ? L["Audiences.EmptyDescriptionNone"].Value : L["Audiences.EmptyDescriptionSearch"].Value)">
            <Actions>@if (search.Length > 0) { <SUIButton ColorValue="SUIColor.Secondary" OnClick="ClearSearch">@L["Audiences.ClearSearch"]</SUIButton> }</Actions>
        </SUIEmptyState>
    }
    else
    {
        <SUITable TItem="ManagementAudienceSummary"
                  Items="FilteredAudiences"
                  RowKey="audience => audience.Name"
                  StackOnMobile="true">
            <HeaderContent>
                <SUITh>@L["Audiences.ColumnAudience"]</SUITh>
                <SUITh>@L["Audiences.ColumnScopes"]</SUITh>
                <SUITh>@L["Audiences.ColumnClients"]</SUITh>
            </HeaderContent>
            <RowTemplate Context="audience">
                <SUITd DataLabel="@L["Audiences.ColumnAudience"].Value"><code>@audience.Name</code></SUITd>
                <SUITd DataLabel="@L["Audiences.ColumnScopes"].Value">
                    <ul class="audience-bindings">
                        @foreach (var scope in audience.Scopes)
                        {
                            <li>
                                <a href="@($"scopes/{Uri.EscapeDataString(scope.Id)}")">@scope.Name</a>
                                @if (scope.IsManifestManaged)
                                {
                                    <SUIStatusBadge ToneValue="SUITone.Info">@L["Audiences.ManifestBadge"]</SUIStatusBadge>
                                }
                                else
                                {
                                    <AuthorizeView Policy="@ManagementUiPolicies.UpdateAudienceBindings">
                                        <SUIButton VariantValue="SUIVariant.Text"
                                                   ColorValue="SUIColor.Primary"
                                                   SizeValue="SUISize.Small"
                                                   Disabled="@(!interactive || busy)"
                                                   aria-label="@L["Audiences.RemoveBindingAriaLabel", audience.Name, scope.Name].Value"
                                                   OnClick="() => ConfirmRemoval(audience.Name, scope)">
                                            @L["Audiences.RemoveBindingButton"]
                                        </SUIButton>
                                    </AuthorizeView>
                                }
                            </li>
                        }
                    </ul>
                </SUITd>
                <SUITd DataLabel="@L["Audiences.ColumnClients"].Value">
                    @if (audience.ClientIds.Count is 0) { <span>@L["Audiences.NoClients"]</span> }
                    else
                    {
                        @* Native disclosure: the client list stays in the document while
                           collapsed (find-in-page, prerender); SUIExpansionPanel drops it. *@
                        <details><summary>@L["Audiences.ClientCountSummary", audience.ClientIds.Count]</summary><ul class="audience-clients">@foreach (var clientId in audience.ClientIds) { <li><code>@clientId</code></li> }</ul></details>
                    }
                </SUITd>
            </RowTemplate>
        </SUITable>
    }
    </Success>
    </ManagementDataView>
    <footer class="table-footer"><span role="status">@(loading ? L["Audiences.LoadingFooter"].Value : result?.IsSuccess is true ? L["Audiences.FooterCountFormat", FilteredAudiences.Count, AllAudiences.Count].Value : L["Audiences.NoResultsLoaded"].Value)</span><a href="scopes">@L["Audiences.ManageScopesLink"]</a></footer>
</div>

@code {
    private ManagementDataResult<ManagementAudienceInventory>? result;
    private ManagementDataResult<ManagementScopeDetail>? submission;
    private string search = string.Empty, audienceName = string.Empty, selectedScopeId = string.Empty;
    private string? notice;
    private bool loading = true, busy, showBinding;
    private ElementReference actionHeading;
    private ElementReference inventoryHeading;
    private bool focusAction;
    private bool focusInventory;
    private bool interactive;
    private Removal? removal;
    private sealed record Removal(string Audience, ManagementScopeDetail Scope);
    private IReadOnlyList<ManagementAudienceSummary> AllAudiences => result?.Value?.Audiences ?? [];
    private IReadOnlyList<ManagementScopeDetail> EditableScopes => result?.Value?.Scopes.Where(s =>
        !s.IsManifestManaged && s.Name is not ("openid" or "offline_access" or "profile" or "email" or "phone" or "address" or "roles" or "entitlements" or "directives" or "identity.management" or "scim")).ToArray() ?? [];
    private IReadOnlyList<ManagementAudienceSummary> FilteredAudiences => AllAudiences.Where(a =>
        a.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || a.Scopes.Any(s => s.Name.Contains(search, StringComparison.OrdinalIgnoreCase)) || a.ClientIds.Any(c => c.Contains(search, StringComparison.OrdinalIgnoreCase))).ToArray();
    private bool CanSubmit => !busy && !loading && result?.IsSuccess is true && !string.IsNullOrWhiteSpace(audienceName) && EditableScopes.Any(s => s.Id == selectedScopeId);
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() { loading = true; result = await ScopeData.ListAudiencesAsync(); loading = false; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { interactive = true; StateHasChanged(); }
        if (focusAction) { focusAction = false; await actionHeading.FocusAsync(); }
        if (focusInventory) { focusInventory = false; await inventoryHeading.FocusAsync(); }
    }
    private void OpenBinding() { showBinding = true; removal = null; submission = null; notice = null; focusAction = true; }
    private void CloseBinding() { showBinding = false; submission = null; focusInventory = true; }
    private void ClearSearch() => search = string.Empty;
    private void ConfirmRemoval(string audience, ManagementScopeDetail scope) { removal = new(audience, scope); showBinding = false; submission = null; notice = null; focusAction = true; }
    private void CancelRemoval() { removal = null; submission = null; focusInventory = true; }
    private async Task ReloadForReviewAsync()
    {
        removal = null; submission = null;
        await LoadAsync();
        if (showBinding) focusAction = true;
        else focusInventory = true;
    }
    private async Task AddBindingAsync()
    {
        if (!CanSubmit) return;
        var scope = EditableScopes.Single(s => s.Id == selectedScopeId);
        await SaveAsync(scope, audienceName.Trim(), true);
    }
    private async Task RemoveBindingAsync()
    {
        if (busy || loading || removal is null) return;
        await SaveAsync(removal.Scope, removal.Audience, false);
    }
    private async Task SaveAsync(ManagementScopeDetail scope, string audience, bool assigned)
    {
        busy = true;
        try
        {
            submission = await ScopeData.UpdateAudienceBindingAsync(scope.Id, new(audience, assigned, scope.Resources));
            if (submission.IsSuccess)
            {
                notice = assigned ? L["Audiences.NoticeBound"].Value : L["Audiences.NoticeRemoved"].Value;
                showBinding = false; removal = null;
                audienceName = string.Empty; selectedScopeId = string.Empty;
                await LoadAsync();
                focusInventory = true;
            }
        }
        finally { busy = false; }
    }
}
