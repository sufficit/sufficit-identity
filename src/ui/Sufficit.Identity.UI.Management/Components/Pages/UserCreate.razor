@page "/users/new"
@attribute [Authorize(Policy = ManagementUiPolicies.Access)]
@attribute [StreamRendering]
@inject ManagementUserDataSource UserData
@inject NavigationManager Navigation

<PageTitle>Novo usuário | Sufficit Identity</PageTitle>

<SUIPageHeader Title="Novo usuário"
            Description="Crie uma conta no provedor sem atribuir autoridades próprias de aplicações.">
    <Actions>
        <a class="button button--secondary" href="users">
            <SUIIcon Name="arrow-left" Size="17" />
            Voltar para usuários
        </a>
    </Actions>
</SUIPageHeader>

<div class="contract-strip contract-strip--success">
    <SUIIcon Name="shield" Size="20" />
    <div>
        <strong>Conta de autenticação, não perfil empresarial</strong>
        <span>Esta operação cria identificação e credencial. Grupos, cargos e permissões são definidos pelos sistemas que os utilizam.</span>
    </div>
    <SUIStatusBadge Tone="success">Auditável</SUIStatusBadge>
</div>

@if (loading)
{
    <div class="form-section" aria-busy="true">
        <div class="table-skeleton" aria-label="Carregando autorização">
            @for (var index = 0; index < 4; index++)
            {
                <span></span>
            }
        </div>
    </div>
}
else if (accessResult?.IsSuccess is false)
{
    <div class="panel">
        <SUIEmptyState Icon="shield"
                    Title="@AccessErrorTitle"
                    Description="@accessResult.ErrorMessage">
            <Actions>
                <button class="button button--secondary"
                        type="button"
                        @onclick="LoadAsync">
                    Tentar novamente
                </button>
            </Actions>
        </SUIEmptyState>
    </div>
}
else if (!Access.CanCreate)
{
    <div class="panel">
        <SUIEmptyState Icon="users"
                    Title="Criação de usuários não autorizada"
                    Description="Sua sessão pode consultar o diretório, mas não possui a capability necessária para criar contas.">
            <Actions>
                <a class="button button--secondary" href="users">Voltar para usuários</a>
            </Actions>
        </SUIEmptyState>
    </div>
}
else
{
    @if (submission?.IsSuccess is false)
    {
        <div class="inline-notice inline-notice--danger" role="alert">
            <SUIIcon Name="alert" Size="19" />
            <div>
                <strong>@SubmissionTitle</strong>
                <span>@submission.ErrorMessage</span>
            </div>
        </div>
    }

    <div>
    <EditForm Model="model"
              OnValidSubmit="CreateAsync"
              FormName="create-management-user"
              class="management-form">
        <DataAnnotationsValidator />

        <div class="form-section" aria-labelledby="user-identity-heading">
            <div class="form-section__heading">
                <h2 id="user-identity-heading">Identificação</h2>
                <p>Use dados reconhecíveis pelo usuário. O e-mail começa pendente de confirmação.</p>
            </div>

            <div class="form-grid form-grid--two">
                <div class="field-group">
                    <label for="user-name">Nome de usuário</label>
                    <InputText id="user-name"
                               class="form-control"
                               autocomplete="username"
                               maxlength="256"
                               @bind-Value="model.UserName" />
                    <ValidationMessage For="() => model.UserName" />
                    @if (submission?.ErrorField is "userName")
                    {
                        <p class="validation-message">@submission.ErrorMessage</p>
                    }
                </div>

                <div class="field-group">
                    <label for="user-email">E-mail</label>
                    <InputText id="user-email"
                               class="form-control"
                               type="email"
                               autocomplete="email"
                               maxlength="256"
                               @bind-Value="model.Email" />
                    <ValidationMessage For="() => model.Email" />
                    @if (submission?.ErrorField is "email")
                    {
                        <p class="validation-message">@submission.ErrorMessage</p>
                    }
                </div>
            </div>
        </div>

        <div class="form-section" aria-labelledby="user-password-heading">
            <div class="form-section__heading">
                <h2 id="user-password-heading">Senha inicial</h2>
                <p>A política real é validada pelo Identity no servidor. A senha nunca entra na auditoria ou na resposta.</p>
            </div>

            <div class="form-grid form-grid--two">
                <div class="field-group">
                    <label for="initial-password">Senha</label>
                    <InputText id="initial-password"
                               class="form-control"
                               type="password"
                               autocomplete="new-password"
                               @bind-Value="model.InitialPassword" />
                    <ValidationMessage For="() => model.InitialPassword" />
                    @if (submission?.ErrorField is "initialPassword")
                    {
                        <p class="validation-message">@submission.ErrorMessage</p>
                    }
                </div>

                <div class="field-group">
                    <label for="confirm-password">Confirmar senha</label>
                    <InputText id="confirm-password"
                               class="form-control"
                               type="password"
                               autocomplete="new-password"
                               @bind-Value="model.ConfirmPassword" />
                    <ValidationMessage For="() => model.ConfirmPassword" />
                </div>
            </div>
            <span class="field-hint">Compartilhe a senha por um canal seguro e oriente a troca após o primeiro acesso.</span>
        </div>

        <footer class="form-actions">
            <a class="button button--secondary" href="users">Cancelar</a>
            <button class="button button--primary"
                    type="submit"
                    disabled="@submitting">
                @if (submitting)
                {
                    <span class="button-spinner" aria-hidden="true"></span>
                    <span>Criando usuário…</span>
                }
                else
                {
                    <SUIIcon Name="plus" Size="17" />
                    <span>Criar usuário</span>
                }
            </button>
        </footer>
    </EditForm>
    </div>
}

@code {
    private readonly UserCreateModel model = new();
    private ManagementDataResult<ManagementUserAccess>? accessResult;
    private ManagementDataResult<ManagementUserDetail>? submission;
    private bool loading = true;
    private bool submitting;

    private ManagementUserAccess Access =>
        accessResult?.Value ?? new(false, false);

    private string AccessErrorTitle =>
        accessResult?.Outcome is ManagementDataOutcome.StepUpRequired
            ? "Autenticação adicional necessária"
            : "Não foi possível carregar sua autoridade";

    private string SubmissionTitle =>
        submission?.Outcome is ManagementDataOutcome.StepUpRequired
            ? "MFA exigido para criar usuários"
            : submission?.Outcome is ManagementDataOutcome.Conflict
                ? "Já existe uma identidade com esses dados"
                : "Não foi possível criar o usuário";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        accessResult = await UserData.GetAccessAsync();
        loading = false;

    }

    private async Task CreateAsync()
    {
        if (submitting)
        {
            return;
        }

        submitting = true;
        submission = await UserData.CreateAsync(
            new CreateManagementUserCommand(
                model.UserName,
                model.Email,
                model.InitialPassword));
        submitting = false;

        if (submission.IsSuccess && submission.Value is not null)
        {
            Navigation.NavigateTo(
                $"users/{Uri.EscapeDataString(submission.Value.Id)}?created=1");
        }
    }

    private sealed class UserCreateModel
    {
        [Required(ErrorMessage = "Informe o nome de usuário.")]
        [StringLength(256, ErrorMessage = "Use no máximo 256 caracteres.")]
        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe o e-mail.")]
        [EmailAddress(ErrorMessage = "Informe um e-mail válido.")]
        [StringLength(256, ErrorMessage = "Use no máximo 256 caracteres.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe a senha inicial.")]
        public string InitialPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirme a senha inicial.")]
        [Compare(
            nameof(InitialPassword),
            ErrorMessage = "As senhas não coincidem.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
