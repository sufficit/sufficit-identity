@page "/users/new"
@attribute [Authorize(Policy = ManagementUiPolicies.Access)]
@attribute [StreamRendering]
@inject ManagementUserDataSource UserData
@inject NavigationManager Navigation

<PageTitle>@L["Users.Create.PageTitle"]</PageTitle>

<SUIPageHeader Title="@L["Users.Create.HeaderTitle"].Value"
            Description="@L["Users.Create.HeaderDescription"].Value">
    <Actions>
        <a class="button button--secondary" href="users">
            <SUIIcon Name="arrow-left" Size="17" />
            @L["Users.Create.BackToUsers"]
        </a>
    </Actions>
</SUIPageHeader>

<div class="contract-strip contract-strip--success">
    <SUIIcon Name="shield" Size="20" />
    <div>
        <strong>@L["Users.Create.ContractStrip.Title"]</strong>
        <span>@L["Users.Create.ContractStrip.Description"]</span>
    </div>
    <SUIStatusBadge ToneValue="SUITone.Success">@L["Users.Create.ContractStrip.Badge"]</SUIStatusBadge>
</div>

@if (loading)
{
    <div class="form-section" aria-busy="true">
        <div class="table-skeleton" aria-label="@L["Users.Create.LoadingAriaLabel"].Value">
            @for (var index = 0; index < 4; index++)
            {
                <span></span>
            }
        </div>
    </div>
}
else if (accessResult?.IsSuccess is false)
{
    <div class="panel">
        <SUIEmptyState Icon="shield"
                    Title="@AccessErrorTitle"
                    Description="@accessResult.ErrorMessage">
            <Actions>
                <button class="button button--secondary"
                        type="button"
                        @onclick="LoadAsync">
                    @L["Users.Create.Retry"]
                </button>
            </Actions>
        </SUIEmptyState>
    </div>
}
else if (!Access.CanCreate)
{
    <div class="panel">
        <SUIEmptyState Icon="users"
                    Title="@L["Users.Create.Forbidden.Title"].Value"
                    Description="@L["Users.Create.Forbidden.Description"].Value">
            <Actions>
                <a class="button button--secondary" href="users">@L["Users.Create.BackToUsers"]</a>
            </Actions>
        </SUIEmptyState>
    </div>
}
else
{
    @if (submission?.IsSuccess is false)
    {
        <div class="inline-notice inline-notice--danger" role="alert">
            <SUIIcon Name="alert" Size="19" />
            <div>
                <strong>@SubmissionTitle</strong>
                <span>@submission.ErrorMessage</span>
            </div>
        </div>
    }

    <div>
    <EditForm Model="model"
              OnValidSubmit="CreateAsync"
              FormName="create-management-user"
              class="management-form">
        <DataAnnotationsValidator />

        <div class="form-section" aria-labelledby="user-identity-heading">
            <div class="form-section__heading">
                <h2 id="user-identity-heading">@L["Users.Create.Identity.Heading"]</h2>
                <p>@L["Users.Create.Identity.Description"]</p>
            </div>

            <div class="form-grid form-grid--two">
                <div class="field-group">
                    <label for="user-name">@L["Users.Create.Field.UserName"]</label>
                    <InputText id="user-name"
                               class="form-control"
                               autocomplete="username"
                               maxlength="256"
                               @bind-Value="model.UserName" />
                    <ValidationMessage For="() => model.UserName" />
                    @if (submission?.ErrorField is "userName")
                    {
                        <p class="validation-message">@submission.ErrorMessage</p>
                    }
                </div>

                <div class="field-group">
                    <label for="user-email">@L["Users.Create.Field.Email"]</label>
                    <InputText id="user-email"
                               class="form-control"
                               type="email"
                               autocomplete="email"
                               maxlength="256"
                               @bind-Value="model.Email" />
                    <ValidationMessage For="() => model.Email" />
                    @if (submission?.ErrorField is "email")
                    {
                        <p class="validation-message">@submission.ErrorMessage</p>
                    }
                </div>
            </div>
        </div>

        <div class="form-section" aria-labelledby="user-password-heading">
            <div class="form-section__heading">
                <h2 id="user-password-heading">@L["Users.Create.Password.Heading"]</h2>
                <p>@L["Users.Create.Password.Description"]</p>
            </div>

            <div class="form-grid form-grid--two">
                <div class="field-group">
                    <label for="initial-password">@L["Users.Create.Field.Password"]</label>
                    <InputText id="initial-password"
                               class="form-control"
                               type="password"
                               autocomplete="new-password"
                               @bind-Value="model.InitialPassword" />
                    <ValidationMessage For="() => model.InitialPassword" />
                    @if (submission?.ErrorField is "initialPassword")
                    {
                        <p class="validation-message">@submission.ErrorMessage</p>
                    }
                </div>

                <div class="field-group">
                    <label for="confirm-password">@L["Users.Create.Field.ConfirmPassword"]</label>
                    <InputText id="confirm-password"
                               class="form-control"
                               type="password"
                               autocomplete="new-password"
                               @bind-Value="model.ConfirmPassword" />
                    <ValidationMessage For="() => model.ConfirmPassword" />
                </div>
            </div>
            <span class="field-hint">@L["Users.Create.Password.Hint"]</span>
        </div>

        <footer class="form-actions">
            <a class="button button--secondary" href="users">@L["Users.Create.Cancel"]</a>
            <button class="button button--primary"
                    type="submit"
                    disabled="@submitting">
                @if (submitting)
                {
                    <span class="button-spinner" aria-hidden="true"></span>
                    <span>@L["Users.Create.Submitting"]</span>
                }
                else
                {
                    <SUIIcon Name="plus" Size="17" />
                    <span>@L["Users.Create.Submit"]</span>
                }
            </button>
        </footer>
    </EditForm>
    </div>
}

@code {
    private readonly UserCreateModel model = new();
    private ManagementDataResult<ManagementUserAccess>? accessResult;
    private ManagementDataResult<ManagementUserDetail>? submission;
    private bool loading = true;
    private bool submitting;

    private ManagementUserAccess Access =>
        accessResult?.Value ?? new(false, false);

    private string AccessErrorTitle =>
        accessResult?.Outcome is ManagementDataOutcome.StepUpRequired
            ? L["Users.Create.AccessError.StepUpTitle"].Value
            : L["Users.Create.AccessError.GenericTitle"].Value;

    private string SubmissionTitle =>
        submission?.Outcome is ManagementDataOutcome.StepUpRequired
            ? L["Users.Create.SubmitError.StepUpTitle"].Value
            : submission?.Outcome is ManagementDataOutcome.Conflict
                ? L["Users.Create.SubmitError.ConflictTitle"].Value
                : L["Users.Create.SubmitError.GenericTitle"].Value;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        accessResult = await UserData.GetAccessAsync();
        loading = false;

    }

    private async Task CreateAsync()
    {
        if (submitting)
        {
            return;
        }

        submitting = true;
        submission = await UserData.CreateAsync(
            new CreateManagementUserCommand(
                model.UserName,
                model.Email,
                model.InitialPassword));
        submitting = false;

        if (submission.IsSuccess && submission.Value is not null)
        {
            Navigation.NavigateTo(
                $"users/{Uri.EscapeDataString(submission.Value.Id)}?created=1");
        }
    }

    protected override void OnInitialized()
    {
        model.Localizer = L;
        base.OnInitialized();
    }

    private sealed class UserCreateModel : IValidatableObject
    {
        public IStringLocalizer<Sufficit.Identity.UI.Management.Resources.ManagementResource>? Localizer { get; set; }

        public string UserName { get; set; } = string.Empty;

        public string Email { get; set; } = string.Empty;

        public string InitialPassword { get; set; } = string.Empty;

        public string ConfirmPassword { get; set; } = string.Empty;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            var l = Localizer ?? throw new InvalidOperationException(
                "The form model localizer must be set before validation.");

            if (string.IsNullOrWhiteSpace(UserName))
            {
                yield return new ValidationResult(l["Users.Create.Validation.UserNameRequired"].Value, [nameof(UserName)]);
            }
            if (UserName?.Length > 256)
            {
                yield return new ValidationResult(l["Common.Validation.MaxLength", 256].Value, [nameof(UserName)]);
            }
            if (string.IsNullOrWhiteSpace(Email))
            {
                yield return new ValidationResult(l["Users.Create.Validation.EmailRequired"].Value, [nameof(Email)]);
            }
            if (!string.IsNullOrWhiteSpace(Email) && !new EmailAddressAttribute().IsValid(Email))
            {
                yield return new ValidationResult(l["Users.Create.Validation.EmailInvalid"].Value, [nameof(Email)]);
            }
            if (Email?.Length > 256)
            {
                yield return new ValidationResult(l["Common.Validation.MaxLength", 256].Value, [nameof(Email)]);
            }
            if (string.IsNullOrWhiteSpace(InitialPassword))
            {
                yield return new ValidationResult(l["Users.Create.Validation.PasswordRequired"].Value, [nameof(InitialPassword)]);
            }
            if (string.IsNullOrWhiteSpace(ConfirmPassword))
            {
                yield return new ValidationResult(l["Users.Create.Validation.ConfirmPasswordRequired"].Value, [nameof(ConfirmPassword)]);
            }
            if (!string.Equals(InitialPassword, ConfirmPassword, StringComparison.Ordinal))
            {
                yield return new ValidationResult(l["Users.Create.Validation.PasswordsDoNotMatch"].Value, [nameof(ConfirmPassword)]);
            }
        }
    }
}
