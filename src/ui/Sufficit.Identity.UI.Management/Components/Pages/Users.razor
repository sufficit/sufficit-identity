@page "/users"
@attribute [Authorize(Policy = ManagementUiPolicies.Access)]
@attribute [StreamRendering]
@using System.Globalization
@inject ManagementUserDataSource UserData
@inject NavigationManager Navigation

<PageTitle>@L["Users.PageTitle"]</PageTitle>

<SUIPageHeader Title="@L["Users.Header.Title"]"
            Description="@L["Users.Header.Description"]">
    <Actions>
        @if (accessResult?.IsSuccess is true && Access.CanCreate)
        {
            <SUIButton Href="users/new" StartIcon="plus">
                @L["Users.Actions.New"]
            </SUIButton>
        }
        <SUIStatusBadge ToneValue="SUITone.Info" Icon="shield">@L["Users.Badge.GlobalDirectory"]</SUIStatusBadge>
    </Actions>
</SUIPageHeader>

@if (Deleted)
{
    <div class="inline-notice inline-notice--success" role="status">
        <SUIIcon Name="check" Size="19" />
        <div><strong>@L["Users.Deleted.Title"]</strong><span>@L["Users.Deleted.Description"]</span></div>
    </div>
}

<ManagementDataView Result="accessResult"
                    Loading="accessLoading"
                    OnRetry="LoadAccessAsync"
                    FailureClass="panel"
                    StepUpTitle="@L["Users.Error.StepUpTitle"]"
                    ForbiddenTitle="@L["Users.Error.AccessDeniedTitle"]">
    <LoadingContent>
        <div class="users-dashboard users-dashboard--loading">
            <div class="table-skeleton" aria-label="@L["Users.Loading.Dashboard"]"><span></span><span></span><span></span><span></span></div>
        </div>
    </LoadingContent>
    <Success Context="access">
    <main class="users-dashboard" aria-busy="@usersLoading">
        <div class="users-overview" aria-labelledby="registration-overview-heading">
            <div class="users-overview__heading">
                <div>
                    <h2 id="registration-overview-heading">@L["Users.Overview.Heading"]</h2>
                    <p>@AnalyticsRangeLabel</p>
                </div>
                @if (SelectedDay is not null)
                {
                    <SUIChip ColorValue="SUIColor.Primary"
                             RemoveLabel="@L["Users.Overview.ClearDay"].Value"
                             OnRemove="ClearSelectedDay">
                        @BrowserTime.FormatDay(SelectedDay.Value)
                    </SUIChip>
                }
            </div>

            <dl class="users-insight-strip">
                <div><dt>@L["Users.Insight.Directory"]</dt><dd>@Analytics.DirectoryTotal.ToString("N0", PtBr)</dd></div>
                <div><dt>@L["Users.Insight.Today"]</dt><dd>@Analytics.RegisteredToday.ToString("N0", PtBr)</dd></div>
                <div><dt>@L["Users.Insight.Typical"]</dt><dd>@Analytics.TypicalRegistrationsPerDay.ToString("0.#", PtBr)</dd></div>
                <div class="@(AnomalyCount > 0 ? "users-insight--alert" : null)">
                    <dt>@L["Users.Insight.OutOfPattern"]</dt><dd>@AnomalyCount</dd>
                </div>
            </dl>

            @if (usersLoading && usersResult is null)
            {
                <div class="registration-chart registration-chart--loading" aria-label="@L["Users.Loading.History"]"></div>
            }
            else if (Analytics.Days.Count is 0)
            {
                <div class="registration-chart__empty">@L["Users.Overview.EmptyHistory"]</div>
            }
            else
            {
                <div class="registration-chart" role="group" aria-label="@L["Users.Chart.AriaLabel"]">
                    <div class="registration-chart__scale" aria-hidden="true">
                        <span>@ChartMax</span><span>@Math.Ceiling(ChartMax / 2d)</span><span>0</span>
                    </div>
                    <div class="registration-chart__viewport" tabindex="0">
                        <div class="registration-chart__plot">
                            @foreach (var day in Analytics.Days)
                            {
                                <button type="button"
                                        class="registration-bar @(day.IsAnomaly ? "registration-bar--anomaly" : null) @(SelectedDay == day.Date ? "registration-bar--selected" : null)"
                                        title="@DayAriaLabel(day)"
                                        aria-label="@DayAriaLabel(day)"
                                        aria-pressed="@(SelectedDay == day.Date)"
                                        @onclick="() => SelectDay(day.Date)">
                                    <span class="registration-bar__value">@(day.Count > 0 ? day.Count : null)</span>
                                    <span class="registration-bar__column pct-@BarHeight(day.Count)"></span>
                                    <span class="registration-bar__date">@BrowserTime.FormatDay(day.Date, TimeStyle.DayMonth)</span>
                                </button>
                            }
                        </div>
                    </div>
                </div>
                <div class="chart-legend" aria-label="@L["Users.Chart.LegendAriaLabel"]">
                    <span><i class="chart-legend__mark"></i>@L["Users.Chart.LegendRegistrations"]</span>
                    <span><i class="chart-legend__mark chart-legend__mark--alert"></i>@L["Users.Chart.LegendAnomaly", Analytics.AnomalyThreshold]</span>
                    <span class="chart-legend__hint">@L["Users.Chart.LegendHint"]</span>
                </div>
            }
        </div>

        <div class="users-investigation @(IsStaleUnverifiedReview ? "users-investigation--active" : null)"
                 aria-labelledby="stale-unverified-heading">
            <div class="users-investigation__summary">
                <span class="users-investigation__icon" aria-hidden="true"><SUIIcon Name="alert" Size="20" /></span>
                <div>
                    <h2 id="stale-unverified-heading">@L["Users.Investigation.Heading"]</h2>
                    <p>@L["Users.Investigation.Description"]</p>
                </div>
            </div>
            <div class="users-investigation__count" aria-label="@StaleUnverifiedCountLabel">
                <strong>@Analytics.StaleUnverifiedWithoutExternalTotal.ToString("N0", PtBr)</strong>
                <span>@Pluralize(Analytics.StaleUnverifiedWithoutExternalTotal, L["Users.Count.AccountSingular"], L["Users.Count.AccountPlural"])</span>
            </div>
            @if (IsStaleUnverifiedReview)
            {
                <SUIButton Href="@BaseUri" VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" aria-current="page" StartIcon="x">
                    @L["Users.Investigation.End"]
                </SUIButton>
            }
            else
            {
                <SUIButton Href="@RiskReviewUrl" VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" EndIcon="arrow-right">
                    @L["Users.Investigation.Review"]
                </SUIButton>
            }
        </div>

        <SUIExpansionPanel Class="users-filter-panel"
                           Title="@L["Users.Filters.Heading"].Value"
                           StartIcon="search"
                           Expanded="true"
                           KeepContentMounted="true">
            <HeaderContent><span class="users-filter-count">@ActiveFilterLabel</span></HeaderContent>
            <ChildContent>
            <form class="users-filter-form" data-sui-align-row @onsubmit="ApplyFilters" @onsubmit:preventDefault>
                <IdentityTextField T="string" Class="users-field users-field--search"
                              Id="users-search" name="search" autocomplete="off"
                              Label="@L["Users.Filters.NameOrEmail"]" InputType="search" Placeholder="@L["Users.Filters.SearchPlaceholder"]"
                              Value="@search" ValueChanged="SearchSelected" Immediate />
                <IdentitySelect T="ManagementUserReviewFilter" Class="users-field users-field--review"
                           Label="@L["Users.Filters.Investigation"]" id="users-review-filter" name="review"
                           Value="@review" ValueChanged="ReviewSelected">
                    <SUISelectItem Value="@ManagementUserReviewFilter.All">@L["Users.Filters.Review.All"]</SUISelectItem>
                    <SUISelectItem Value="@ManagementUserReviewFilter.StaleUnverifiedWithoutExternal">@L["Users.Filters.Review.Stale"]</SUISelectItem>
                </IdentitySelect>
                <IdentitySelect T="ManagementUserStateFilter" Class="users-field"
                           Label="@L["Users.Filters.State"]" id="users-state-filter" name="state"
                           Value="@state" ValueChanged="StateSelected">
                    <SUISelectItem Value="@ManagementUserStateFilter.All">@L["Users.Filters.All"]</SUISelectItem>
                    <SUISelectItem Value="@ManagementUserStateFilter.Active">@L["Users.Filters.State.Active"]</SUISelectItem>
                    <SUISelectItem Value="@ManagementUserStateFilter.Locked">@L["Users.Filters.State.Locked"]</SUISelectItem>
                </IdentitySelect>
                <IdentitySelect T="ManagementUserBooleanFilter" Class="users-field"
                           Label="@L["Users.Common.Email"]" id="users-email-filter" name="email"
                           Value="@emailConfirmed" ValueChanged="EmailSelected">
                    <SUISelectItem Value="@ManagementUserBooleanFilter.All">@L["Users.Filters.All"]</SUISelectItem>
                    <SUISelectItem Value="@ManagementUserBooleanFilter.Enabled">@L["Users.Filters.Email.Confirmed"]</SUISelectItem>
                    <SUISelectItem Value="@ManagementUserBooleanFilter.Disabled">@L["Users.Filters.Email.NotConfirmed"]</SUISelectItem>
                </IdentitySelect>
                <IdentitySelect T="ManagementUserBooleanFilter" Class="users-field"
                           Label="@L["Users.Filters.Mfa"]" id="users-mfa-filter" name="mfa"
                           Value="@mfa" ValueChanged="MfaSelected">
                    <SUISelectItem Value="@ManagementUserBooleanFilter.All">@L["Users.Filters.All"]</SUISelectItem>
                    <SUISelectItem Value="@ManagementUserBooleanFilter.Enabled">@L["Users.Filters.Active"]</SUISelectItem>
                    <SUISelectItem Value="@ManagementUserBooleanFilter.Disabled">@L["Users.Filters.Inactive"]</SUISelectItem>
                </IdentitySelect>
                <SUIDateField Class="users-field"
                              Id="users-registered-from" Name="registeredFrom"
                              Label="@L["Users.Filters.RegisteredFrom"]" Culture="@PtBr"
                              Value="@registeredFrom" ValueChanged="RegisteredFromSelected" />
                <SUIDateField Class="users-field"
                              Id="users-registered-to" Name="registeredTo"
                              Label="@L["Users.Filters.RegisteredTo"]" Culture="@PtBr"
                              Value="@registeredTo" ValueChanged="RegisteredToSelected" />
                <IdentitySelect T="ManagementUserSort" Class="users-field"
                           Label="@L["Users.Filters.SortBy"]" id="users-sort-filter" name="sort"
                           Value="@sort" ValueChanged="SortSelected">
                    <SUISelectItem Value="@ManagementUserSort.CreatedNewest">@L["Users.Sort.CreatedNewest"]</SUISelectItem>
                    <SUISelectItem Value="@ManagementUserSort.CreatedOldest">@L["Users.Sort.CreatedOldest"]</SUISelectItem>
                    <SUISelectItem Value="@ManagementUserSort.NameAscending">@L["Users.Sort.NameAsc"]</SUISelectItem>
                    <SUISelectItem Value="@ManagementUserSort.NameDescending">@L["Users.Sort.NameDesc"]</SUISelectItem>
                    <SUISelectItem Value="@ManagementUserSort.EmailAscending">@L["Users.Sort.EmailAsc"]</SUISelectItem>
                    <SUISelectItem Value="@ManagementUserSort.EmailDescending">@L["Users.Sort.EmailDesc"]</SUISelectItem>
                </IdentitySelect>
                <IdentitySelect T="int" Class="users-field"
                           Label="@L["Users.Filters.ChartHistory"]" id="users-analytics-filter" name="range"
                           Value="@analyticsDays" ValueChanged="AnalyticsDaysSelected">
                    <SUISelectItem Value="@(14)">@L["Users.Range.Days", 14]</SUISelectItem>
                    <SUISelectItem Value="@(30)">@L["Users.Range.Days", 30]</SUISelectItem>
                    <SUISelectItem Value="@(60)">@L["Users.Range.Days", 60]</SUISelectItem>
                    <SUISelectItem Value="@(90)">@L["Users.Range.Days", 90]</SUISelectItem>
                </IdentitySelect>
                <SUIStack Row="true" AlignItems="end" Spacing="2" Wrap="true" Class="users-filter-actions">
                    <SUIButton ColorValue="SUIColor.Primary" ButtonTypeValue="SUIButtonType.Submit" Disabled="@usersLoading">@(usersLoading ? L["Users.Filters.Applying"] : L["Users.Filters.Apply"])</SUIButton>
                    <SUIButton ColorValue="SUIColor.Default" VariantValue="SUIVariant.Outlined" Disabled="@usersLoading" OnClick="ClearFilters">@L["Users.Filters.Clear"]</SUIButton>
                </SUIStack>
            </form>
            </ChildContent>
        </SUIExpansionPanel>

        <div class="table-panel users-results" aria-labelledby="users-list-heading">
            <div class="data-toolbar users-results__header">
                <div><h2 id="users-list-heading">@L["Users.Results.Heading"]</h2><p>@ResultContextLabel</p></div>
                <span class="users-result-total" aria-live="polite">@ResultCountLabel</span>
            </div>
            <ManagementDataView Result="usersResult"
                                Loading="usersLoading"
                                OnRetry="LoadUsersAsync"
                                Class="client-results"
                                LoadingLabel="@L["Users.Loading.Users"]"
                                SkeletonRows="5"
                                StepUpTitle="@L["Users.Error.MfaRequiredTitle"]"
                                ForbiddenTitle="@L["Users.Error.DirectoryDeniedTitle"]"
                                UnavailableTitle="@L["Users.Error.QueryFailedTitle"]">
                <Success Context="loadedUsers">
                @if (Page.Items.Count is 0)
                {
                    <SUIEmptyState Icon="users" Title="@EmptyStateTitle" Description="@EmptyStateDescription"><Actions><SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" OnClick="ClearFilters">@L["Users.Empty.BackToDirectory"]</SUIButton></Actions></SUIEmptyState>
                }
                else
                {
                    <SUITable TItem="ManagementUserSummary"
                              Items="Page.Items"
                              RowKey="user => user.Id"
                              Class="users-table"
                              StackOnMobile="true">
                        <HeaderContent>
                            <SUITh>
                                <SUITableSortLabel TItem="ManagementUserSummary"
                                                   aria-label="@L["Users.Table.SortByName"].Value"
                                                   AllowUnsorted="false"
                                                   SortDirection="@SortDirectionFor(ManagementUserSort.NameAscending, ManagementUserSort.NameDescending)"
                                                   SortDirectionChanged="_ => SortBy(ToggleNameSort)"
                                                   AscendingLabel="@L["Users.Table.SortedAscending"].Value"
                                                   DescendingLabel="@L["Users.Table.SortedDescending"].Value"
                                                   UnsortedLabel="@L["Users.Table.NotSorted"].Value">@L["Users.Table.User"]</SUITableSortLabel>
                            </SUITh>
                            <SUITh>@L["Users.Common.Email"]</SUITh>
                            <SUITh>
                                <SUITableSortLabel TItem="ManagementUserSummary"
                                                   aria-label="@L["Users.Table.SortByCreated"].Value"
                                                   AllowUnsorted="false"
                                                   SortDirection="@SortDirectionFor(ManagementUserSort.CreatedOldest, ManagementUserSort.CreatedNewest)"
                                                   SortDirectionChanged="_ => SortBy(ToggleCreatedSort)"
                                                   AscendingLabel="@L["Users.Table.SortedAscending"].Value"
                                                   DescendingLabel="@L["Users.Table.SortedDescending"].Value"
                                                   UnsortedLabel="@L["Users.Table.NotSorted"].Value">@L["Users.Table.Registered"]</SUITableSortLabel>
                            </SUITh>
                            <SUITh>@L["Users.Table.ExternalAccess"]</SUITh>
                            <SUITh>@L["Users.Filters.Mfa"]</SUITh>
                            <SUITh>@L["Users.Filters.State"]</SUITh>
                            <SUITh><span class="visually-hidden">@L["Users.Table.Actions"]</span></SUITh>
                        </HeaderContent>
                        <RowTemplate Context="user">
                            <SUITd DataLabel="@L["Users.Table.User"]">
                                <span class="user-identity">
                                    @*
                                        referrerpolicy: the avatar host must not learn which
                                        console page an operator is looking at.
                                    *@
                                    @if (user.PictureUrl is not null)
                                    {
                                        <img class="user-avatar" src="@user.PictureUrl" alt=""
                                             referrerpolicy="no-referrer" loading="lazy"
                                             width="28" height="28" />
                                    }
                                    else
                                    {
                                        <span class="user-avatar user-avatar--initials" aria-hidden="true">@InitialsFor(user)</span>
                                    }
                                    <a class="client-name client-link" href="@UserHref(user.Id)">@DisplayUserName(user)</a>
                                </span>
                            </SUITd>
                            <SUITd DataLabel="@L["Users.Common.Email"]">
                                <span class="user-email">
                                    <span>@DisplayEmail(user)</span>
                                    @if (user.EmailConfirmed)
                                    {
                                        <span class="verified-mark" title="@L["Users.Table.EmailConfirmed"]" aria-label="@L["Users.Table.EmailConfirmed"]">
                                            <SUIIcon Name="check" Size="13" />
                                        </span>
                                    }
                                </span>
                            </SUITd>
                            <SUITd DataLabel="@L["Users.Table.Registered"]"><time datetime="@user.CreatedAtUtc.ToString("O")"><strong>@Time.Format(user.CreatedAtUtc, TimeStyle.Date)</strong><span>@Time.Format(user.CreatedAtUtc, TimeStyle.Time)</span></time></SUITd>
                            <SUITd DataLabel="@L["Users.Table.ExternalAccess"]"><SUIStatusBadge ToneValue="@(user.HasExternalLogin ? SUITone.Info : SUITone.Warning)">@(user.HasExternalLogin ? L["Users.Table.Linked"] : L["Users.Table.Missing"])</SUIStatusBadge></SUITd>
                            <SUITd DataLabel="@L["Users.Filters.Mfa"]"><SUIStatusBadge ToneValue="@(user.TwoFactorEnabled ? SUITone.Success : SUITone.Neutral)">@(user.TwoFactorEnabled ? L["Users.Filters.Active"] : L["Users.Filters.Inactive"])</SUIStatusBadge></SUITd>
                            <SUITd DataLabel="@L["Users.Filters.State"]"><span class="registration-state"><span class="status-dot @(user.IsLockedOut ? "status-dot--danger" : "status-dot--success")" aria-hidden="true"></span>@(user.IsLockedOut ? L["Users.Table.Locked"] : L["Users.Filters.Active"])</span></SUITd>
                            <SUITd DataLabel="@L["Users.Table.Actions"]">
                                <SUIButton Href="@UserHref(user.Id)" VariantValue="SUIVariant.Text" SizeValue="SUISize.Small"
                                           aria-label="@L["Users.Table.OpenDetails", DisplayUserName(user)].Value" EndIcon="arrow-right">
                                    @L["Users.Table.Details"]
                                </SUIButton>
                            </SUITd>
                        </RowTemplate>
                    </SUITable>
                }
                </Success>
            </ManagementDataView>
            <SUIPagination Class="table-footer table-footer--paginated"
                           TotalItems="@Page.TotalCount"
                           PageSize="@Page.PageSize"
                           PageIndex="@(Page.Page - 1)"
                           PageHref="@(index => UrlFor(page: index + 1))"
                           AriaLabel="@L["Users.Pagination.AriaLabel"].Value"
                           PreviousLabel="@L["Users.Pagination.Previous"].Value"
                           NextLabel="@L["Users.Pagination.Next"].Value"
                           PageLabel="@((page, total) => L["Users.Pagination.PageOf", page, total].Value)"
                           RangeFormatter="@((first, last, total) => L["Users.Pagination.Showing", first.ToString("N0"), last.ToString("N0"), total.ToString("N0")].Value)"
                           EmptyText="@L["Users.Pagination.NoResults"].Value" />
        </div>
    </main>
    </Success>
</ManagementDataView>

@code {
    // The reader's zone once the browser answers (BrowserTimeProvider in the layout).
    [CascadingParameter]
    private BrowserTime Time { get; set; } = BrowserTime.Server;

    private static readonly CultureInfo PtBr = CultureInfo.GetCultureInfo("pt-BR");
    [SupplyParameterFromQuery(Name = "deleted")] public int DeletedFlag { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? QuerySearch { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int QueryPage { get; set; } = 1;
    [SupplyParameterFromQuery(Name = "from")] public DateOnly? QueryFrom { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public DateOnly? QueryTo { get; set; }
    [SupplyParameterFromQuery(Name = "day")] public DateOnly? QueryDay { get; set; }
    [SupplyParameterFromQuery(Name = "state")] public string? QueryStateValue { get; set; }
    [SupplyParameterFromQuery(Name = "email")] public string? QueryEmailValue { get; set; }
    [SupplyParameterFromQuery(Name = "mfa")] public string? QueryMfaValue { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? QuerySortValue { get; set; }
    [SupplyParameterFromQuery(Name = "review")] public string? QueryReviewValue { get; set; }
    [SupplyParameterFromQuery(Name = "range")] public int QueryAnalyticsDays { get; set; } = 30;

    private ManagementDataResult<ManagementUserAccess>? accessResult;
    private ManagementDataResult<ManagementUserPage>? usersResult;
    private bool accessLoading = true;
    private bool usersLoading;
    private string search = string.Empty;
    private DateOnly? registeredFrom;
    private DateOnly? registeredTo;
    private ManagementUserStateFilter state;
    private ManagementUserBooleanFilter emailConfirmed;
    private ManagementUserBooleanFilter mfa;
    private ManagementUserSort sort = ManagementUserSort.CreatedNewest;
    private ManagementUserReviewFilter review;
    private int analyticsDays = 30;
    private string? loadedFingerprint;
    private const int PageSize = 25;

    private bool Deleted => DeletedFlag is 1;
    private DateOnly? SelectedDay => QueryDay;
    private ManagementUserAccess Access => accessResult?.Value ?? new(false, false);
    private ManagementUserPage Page => usersResult?.Value ?? new([], 1, PageSize, 0);
    private ManagementUserAnalytics Analytics => Page.Analytics ?? new(0, 0, 0, 0, 3, []);
    private ManagementUserStateFilter QueryState => ParseEnum(QueryStateValue, ManagementUserStateFilter.All);
    private ManagementUserBooleanFilter QueryEmail => ParseEnum(QueryEmailValue, ManagementUserBooleanFilter.All);
    private ManagementUserBooleanFilter QueryMfa => ParseEnum(QueryMfaValue, ManagementUserBooleanFilter.All);
    private ManagementUserSort QuerySort => ParseEnum(QuerySortValue, ManagementUserSort.CreatedNewest);
    private ManagementUserReviewFilter QueryReview => ParseEnum(QueryReviewValue, ManagementUserReviewFilter.All);
    private bool IsStaleUnverifiedReview => QueryReview is ManagementUserReviewFilter.StaleUnverifiedWithoutExternal;
    private int AnomalyCount => Analytics.Days.Count(day => day.IsAnomaly);
    private int ChartMax => Math.Max(1, Analytics.Days.Count > 0 ? Analytics.Days.Max(day => day.Count) : 1);
    private ManagementUserSort ToggleCreatedSort => QuerySort == ManagementUserSort.CreatedNewest ? ManagementUserSort.CreatedOldest : ManagementUserSort.CreatedNewest;
    private ManagementUserSort ToggleNameSort => QuerySort == ManagementUserSort.NameAscending ? ManagementUserSort.NameDescending : ManagementUserSort.NameAscending;
    private string AnalyticsRangeLabel => L["Users.Overview.RangeLabel", analyticsDays];
    private string ResultContextLabel => IsStaleUnverifiedReview ? L["Users.Results.StaleContext"] : SelectedDay is { } day ? L["Users.Results.DayContext", BrowserTime.FormatDay(day)] : L["Users.Results.DefaultContext"];
    private string ResultCountLabel => usersLoading ? L["Users.Results.Updating"] : $"{Page.TotalCount:N0} {Pluralize(Page.TotalCount, L["Users.Count.AccountSingular"], L["Users.Count.AccountPlural"])}";
    private string ActiveFilterLabel { get { var count = 0; if (!string.IsNullOrWhiteSpace(QuerySearch)) count++; if (QueryFrom is not null || QueryTo is not null) count++; if (QueryDay is not null) count++; if (QueryState != ManagementUserStateFilter.All) count++; if (QueryEmail != ManagementUserBooleanFilter.All) count++; if (QueryMfa != ManagementUserBooleanFilter.All) count++; if (QueryReview != ManagementUserReviewFilter.All) count++; return count == 0 ? L["Users.Filters.None"] : $"{count} {Pluralize(count, L["Users.Filters.ActiveSingular"], L["Users.Filters.ActivePlural"])}"; } }
    private string StaleUnverifiedCountLabel => $"{Analytics.StaleUnverifiedWithoutExternalTotal:N0} {Pluralize(Analytics.StaleUnverifiedWithoutExternalTotal, L["Users.Count.PendingAccountSingular"], L["Users.Count.PendingAccountPlural"])}";
    private string EmptyStateTitle => IsStaleUnverifiedReview ? L["Users.Empty.PendingTitle"] : L["Users.Empty.DefaultTitle"];
    private string EmptyStateDescription => IsStaleUnverifiedReview ? L["Users.Empty.PendingDescription"] : L["Users.Empty.DefaultDescription"];

    protected override async Task OnParametersSetAsync()
    {
        var fingerprint = $"{QuerySearch}|{QueryPage}|{QueryFrom}|{QueryTo}|{QueryDay}|{QueryState}|{QueryEmail}|{QueryMfa}|{QuerySort}|{QueryAnalyticsDays}|{QueryReview}";
        if (fingerprint == loadedFingerprint) return;
        loadedFingerprint = fingerprint;
        SyncDraftsFromQuery();
        if (accessResult is null) await LoadAccessAsync(); else if (accessResult.IsSuccess) await LoadUsersAsync();
    }

    private async Task LoadAccessAsync()
    {
        accessLoading = true;
        accessResult = await UserData.GetAccessAsync();
        accessLoading = false;
        if (accessResult.IsSuccess) await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        usersLoading = true;
        usersResult = await UserData.SearchAsync(new ManagementUserSearch(QuerySearch, Math.Max(1, QueryPage), PageSize, QueryFrom, QueryTo, QueryDay, QueryState, QueryEmail, QueryMfa, QuerySort, NormalizeRange(QueryAnalyticsDays), QueryReview));
        usersLoading = false;
    }

    private void SyncDraftsFromQuery() { search = QuerySearch ?? string.Empty; registeredFrom = QueryFrom; registeredTo = QueryTo; state = QueryState; emailConfirmed = QueryEmail; mfa = QueryMfa; sort = QuerySort; analyticsDays = NormalizeRange(QueryAnalyticsDays); review = QueryReview; }
    private void SearchSelected(string? value) => search = value ?? string.Empty;
    private void RegisteredFromSelected(DateOnly? value) => registeredFrom = value;
    private void RegisteredToSelected(DateOnly? value) => registeredTo = value;
    private void ReviewSelected(ManagementUserReviewFilter value) => review = value;
    private void StateSelected(ManagementUserStateFilter value) => state = value;
    private void EmailSelected(ManagementUserBooleanFilter value) => emailConfirmed = value;
    private void MfaSelected(ManagementUserBooleanFilter value) => mfa = value;
    private void SortSelected(ManagementUserSort value) => sort = value;
    private void AnalyticsDaysSelected(int value) => analyticsDays = NormalizeRange(value);
    private void ApplyFilters() => Navigation.NavigateTo(UrlFor(page: 1, useDrafts: true, day: null, clearDay: true));
    private void ClearFilters() => Navigation.NavigateTo(BaseUri);
    private void SelectDay(DateOnly day) => Navigation.NavigateTo(UrlFor(day: SelectedDay == day ? null : day, clearDay: SelectedDay == day, page: 1));

    private string UrlFor(int? page = null, DateOnly? day = null, bool clearDay = false, ManagementUserSort? sort = null, bool useDrafts = false)
    {
        var selectedSort = sort ?? (useDrafts ? this.sort : QuerySort);
        var values = new Dictionary<string, object?>
        {
            ["q"] = NullIfEmpty(useDrafts ? search : QuerySearch), ["page"] = (page ?? Math.Max(1, QueryPage)) > 1 ? page ?? QueryPage : null,
            ["from"] = useDrafts ? registeredFrom : QueryFrom, ["to"] = useDrafts ? registeredTo : QueryTo,
            ["day"] = clearDay ? null : day ?? QueryDay,
            ["state"] = EnumOrNull(useDrafts ? state : QueryState), ["email"] = EnumOrNull(useDrafts ? emailConfirmed : QueryEmail), ["mfa"] = EnumOrNull(useDrafts ? mfa : QueryMfa),
            ["sort"] = selectedSort is ManagementUserSort.CreatedNewest ? null : selectedSort.ToString(),
            ["review"] = EnumOrNull(useDrafts ? review : QueryReview),
            ["range"] = NormalizeRange(useDrafts ? analyticsDays : QueryAnalyticsDays) == 30 ? null : NormalizeRange(useDrafts ? analyticsDays : QueryAnalyticsDays),
        };
        return Navigation.GetUriWithQueryParameters(BaseUri, values);
    }

    private string BaseUri => Navigation.Uri.Split('?', '#')[0];
    private string RiskReviewUrl => Navigation.GetUriWithQueryParameters(BaseUri, new Dictionary<string, object?> { ["review"] = ManagementUserReviewFilter.StaleUnverifiedWithoutExternal.ToString(), ["sort"] = ManagementUserSort.CreatedOldest.ToString() });
    private static object? EnumOrNull<T>(T value) where T : struct, Enum => Convert.ToInt32(value) == 0 ? null : value.ToString();
    private static T ParseEnum<T>(string? value, T fallback) where T : struct, Enum => Enum.TryParse<T>(value, true, out var parsed) && Enum.IsDefined(parsed) ? parsed : fallback;
    private static string? NullIfEmpty(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static int NormalizeRange(int value) => value is 14 or 30 or 60 or 90 ? value : 30;
    // A whole percent: the height travels as one of the pct-N utility classes
    // (app.css), never as an inline style the CSP would have to allow.
    private int BarHeight(int count) => (int)Math.Round(
        Math.Max(count > 0 ? 8m : 2m, count * 100m / ChartMax),
        MidpointRounding.AwayFromZero);
    private static string UserHref(string id) => $"users/{Uri.EscapeDataString(id)}";
    private static string DisplayUserName(ManagementUserSummary user) => string.IsNullOrWhiteSpace(user.UserName) ? user.Email ?? user.Id : user.UserName;
    private string DisplayEmail(ManagementUserSummary user) => string.IsNullOrWhiteSpace(user.Email) ? L["Users.Table.EmailUnset"] : user.Email;
    /// <summary>
    /// Fallback avatar for the accounts that carry no usable picture — which is
    /// nearly all of them. Takes the first letter of the display name; a name
    /// that starts with punctuation or a digit yields "?" rather than a
    /// confusing glyph.
    /// </summary>
    private static string InitialsFor(ManagementUserSummary user)
    {
        var source = DisplayUserName(user);
        var first = source.FirstOrDefault(char.IsLetter);
        return first == default ? "?" : char.ToUpperInvariant(first).ToString();
    }
    private static string Pluralize(int count, string singular, string plural) => count is 1 ? singular : plural;
    private SUISortDirection SortDirectionFor(ManagementUserSort ascending, ManagementUserSort descending) => QuerySort == ascending ? SUISortDirection.Ascending : QuerySort == descending ? SUISortDirection.Descending : SUISortDirection.None;
    // The header keeps its localized aria-label (which already names the action),
    // so the library's built-in English state suffix is suppressed.
    private void SortBy(ManagementUserSort value) => Navigation.NavigateTo(UrlFor(sort: value, page: 1));
    private void ClearSelectedDay() => Navigation.NavigateTo(UrlFor(day: null, clearDay: true, page: 1));
    private string DayAriaLabel(ManagementUserRegistrationDay day) => L["Users.Chart.DayAriaLabel", day.Date.ToString("dd 'de' MMMM", PtBr), day.Count, Pluralize(day.Count, L["Users.Count.RegistrationSingular"], L["Users.Count.RegistrationPlural"]), day.IsAnomaly ? L["Users.Chart.DayAnomalySuffix"] : string.Empty];
}
