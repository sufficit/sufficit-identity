@page "/users"
@attribute [Authorize(Policy = ManagementUiPolicies.Access)]
@attribute [StreamRendering]
@using System.Globalization
@inject ManagementUserDataSource UserData
@inject NavigationManager Navigation

<PageTitle>Usuários | Sufficit Identity</PageTitle>

<SUIPageHeader Title="Usuários"
            Description="Investigue cadastros, encontre picos fora do padrão e navegue pelo diretório com filtros compartilháveis.">
    <Actions>
        @if (accessResult?.IsSuccess is true && Access.CanCreate)
        {
            <a class="button button--primary" href="users/new">
                <SUIIcon Name="plus" Size="17" />
                Novo usuário
            </a>
        }
        <SUIStatusBadge ToneValue="SUITone.Info" Icon="shield">Diretório global</SUIStatusBadge>
    </Actions>
</SUIPageHeader>

@if (Deleted)
{
    <div class="inline-notice inline-notice--success" role="status">
        <SUIIcon Name="check" Size="19" />
        <div><strong>Conta excluída</strong><span>Credenciais, sessões, tokens e autorizações anteriores foram revogados.</span></div>
    </div>
}

@if (accessLoading)
{
    <div class="users-dashboard users-dashboard--loading" aria-busy="true">
        <div class="table-skeleton" aria-label="Carregando dashboard"><span></span><span></span><span></span><span></span></div>
    </div>
}
else if (accessResult?.IsSuccess is false)
{
    <div class="panel">
        <SUIEmptyState Icon="shield" Title="@AccessErrorTitle" Description="@accessResult.ErrorMessage">
            <Actions><button class="button button--secondary" type="button" @onclick="LoadAccessAsync">Tentar novamente</button></Actions>
        </SUIEmptyState>
    </div>
}
else
{
    <main class="users-dashboard" aria-busy="@usersLoading">
        <div class="users-overview" aria-labelledby="registration-overview-heading">
            <div class="users-overview__heading">
                <div>
                    <h2 id="registration-overview-heading">Cadastros por dia</h2>
                    <p>@AnalyticsRangeLabel · datas em UTC</p>
                </div>
                @if (SelectedDay is not null)
                {
                    <a class="filter-chip" href="@UrlFor(day: null, clearDay: true, page: 1)">
                        @SelectedDay.Value.ToString("dd/MM/yyyy", PtBr)
                        <SUIIcon Name="x" Size="14" />
                    </a>
                }
            </div>

            <dl class="users-insight-strip">
                <div><dt>Diretório</dt><dd>@Analytics.DirectoryTotal.ToString("N0", PtBr)</dd></div>
                <div><dt>Hoje</dt><dd>@Analytics.RegisteredToday.ToString("N0", PtBr)</dd></div>
                <div><dt>Dia típico</dt><dd>@Analytics.TypicalRegistrationsPerDay.ToString("0.#", PtBr)</dd></div>
                <div class="@(AnomalyCount > 0 ? "users-insight--alert" : null)">
                    <dt>Fora do padrão</dt><dd>@AnomalyCount</dd>
                </div>
            </dl>

            @if (usersLoading && usersResult is null)
            {
                <div class="registration-chart registration-chart--loading" aria-label="Carregando histórico"></div>
            }
            else if (Analytics.Days.Count is 0)
            {
                <div class="registration-chart__empty">Ainda não há histórico suficiente para o período.</div>
            }
            else
            {
                <div class="registration-chart" role="group" aria-label="Gráfico de cadastros diários. Selecione um dia para filtrar a lista.">
                    <div class="registration-chart__scale" aria-hidden="true">
                        <span>@ChartMax</span><span>@Math.Ceiling(ChartMax / 2d)</span><span>0</span>
                    </div>
                    <div class="registration-chart__viewport" tabindex="0">
                        <div class="registration-chart__plot">
                            @foreach (var day in Analytics.Days)
                            {
                                <button type="button"
                                        class="registration-bar @(day.IsAnomaly ? "registration-bar--anomaly" : null) @(SelectedDay == day.Date ? "registration-bar--selected" : null)"
                                        title="@DayAriaLabel(day)"
                                        aria-label="@DayAriaLabel(day)"
                                        aria-pressed="@(SelectedDay == day.Date)"
                                        @onclick="() => SelectDay(day.Date)">
                                    <span class="registration-bar__value">@(day.Count > 0 ? day.Count : null)</span>
                                    <span class="registration-bar__column" style="--registration-height: @BarHeight(day.Count)%"></span>
                                    <span class="registration-bar__date">@day.Date.ToString("dd/MM", PtBr)</span>
                                </button>
                            }
                        </div>
                    </div>
                </div>
                <div class="chart-legend" aria-label="Legenda do gráfico">
                    <span><i class="chart-legend__mark"></i>Cadastros</span>
                    <span><i class="chart-legend__mark chart-legend__mark--alert"></i>Acima de @Analytics.AnomalyThreshold no dia</span>
                    <span class="chart-legend__hint">Toque em uma coluna para abrir aquele dia</span>
                </div>
            }
        </div>

        <div class="users-investigation @(IsStaleUnverifiedReview ? "users-investigation--active" : null)"
                 aria-labelledby="stale-unverified-heading">
            <div class="users-investigation__summary">
                <span class="users-investigation__icon" aria-hidden="true"><SUIIcon Name="alert" Size="20" /></span>
                <div>
                    <h2 id="stale-unverified-heading">Cadastros pendentes há mais de 15 dias</h2>
                    <p>E-mail não confirmado e nenhum login externo vinculado, como Google ou Facebook.</p>
                </div>
            </div>
            <div class="users-investigation__count" aria-label="@StaleUnverifiedCountLabel">
                <strong>@Analytics.StaleUnverifiedWithoutExternalTotal.ToString("N0", PtBr)</strong>
                <span>@Pluralize(Analytics.StaleUnverifiedWithoutExternalTotal, "conta", "contas")</span>
            </div>
            @if (IsStaleUnverifiedReview)
            {
                <a class="button button--secondary" href="@BaseUri" aria-current="page">
                    <SUIIcon Name="x" Size="15" /> Encerrar investigação
                </a>
            }
            else
            {
                <a class="button button--secondary" href="@RiskReviewUrl">
                    Revisar contas <SUIIcon Name="arrow-right" Size="15" />
                </a>
            }
        </div>

        <details class="users-filter-panel" open>
            <summary>
                <span><SUIIcon Name="search" Size="18" /> Filtros e ordenação</span>
                <span class="users-filter-count">@ActiveFilterLabel</span>
            </summary>
            <form class="users-filter-form" @onsubmit="ApplyFilters" @onsubmit:preventDefault>
                <label class="users-field users-field--search">
                    <span>Nome ou e-mail</span>
                    <div class="search-field"><SUIIcon Name="search" Size="18" /><input type="search" autocomplete="off" placeholder="Buscar no diretório" @bind="search" @bind:event="oninput" /></div>
                </label>
                <div class="users-field users-field--review">
                    <span>Investigação</span>
                    <SUISelect T="ManagementUserReviewFilter" id="users-review-filter" name="review" aria-label="Investigação" Value="@review" ValueChanged="ReviewSelected">
                        <SUISelectItem Value="@ManagementUserReviewFilter.All">Diretório completo</SUISelectItem>
                        <SUISelectItem Value="@ManagementUserReviewFilter.StaleUnverifiedWithoutExternal">Pendentes há mais de 15 dias</SUISelectItem>
                    </SUISelect>
                </div>
                <div class="users-field">
                    <span>Estado</span>
                    <SUISelect T="ManagementUserStateFilter" id="users-state-filter" name="state" aria-label="Estado" Value="@state" ValueChanged="StateSelected">
                        <SUISelectItem Value="@ManagementUserStateFilter.All">Todos</SUISelectItem>
                        <SUISelectItem Value="@ManagementUserStateFilter.Active">Ativos</SUISelectItem>
                        <SUISelectItem Value="@ManagementUserStateFilter.Locked">Bloqueados</SUISelectItem>
                    </SUISelect>
                </div>
                <div class="users-field">
                    <span>E-mail</span>
                    <SUISelect T="ManagementUserBooleanFilter" id="users-email-filter" name="email" aria-label="E-mail" Value="@emailConfirmed" ValueChanged="EmailSelected">
                        <SUISelectItem Value="@ManagementUserBooleanFilter.All">Todos</SUISelectItem>
                        <SUISelectItem Value="@ManagementUserBooleanFilter.Enabled">Confirmado</SUISelectItem>
                        <SUISelectItem Value="@ManagementUserBooleanFilter.Disabled">Não confirmado</SUISelectItem>
                    </SUISelect>
                </div>
                <div class="users-field">
                    <span>MFA</span>
                    <SUISelect T="ManagementUserBooleanFilter" id="users-mfa-filter" name="mfa" aria-label="MFA" Value="@mfa" ValueChanged="MfaSelected">
                        <SUISelectItem Value="@ManagementUserBooleanFilter.All">Todos</SUISelectItem>
                        <SUISelectItem Value="@ManagementUserBooleanFilter.Enabled">Ativo</SUISelectItem>
                        <SUISelectItem Value="@ManagementUserBooleanFilter.Disabled">Inativo</SUISelectItem>
                    </SUISelect>
                </div>
                <label class="users-field"><span>Cadastro inicial</span><input type="date" @bind="registeredFrom" /></label>
                <label class="users-field"><span>Cadastro final</span><input type="date" @bind="registeredTo" /></label>
                <div class="users-field">
                    <span>Ordenar por</span>
                    <SUISelect T="ManagementUserSort" id="users-sort-filter" name="sort" aria-label="Ordenar por" Value="@sort" ValueChanged="SortSelected">
                        <SUISelectItem Value="@ManagementUserSort.CreatedNewest">Cadastro mais recente</SUISelectItem>
                        <SUISelectItem Value="@ManagementUserSort.CreatedOldest">Cadastro mais antigo</SUISelectItem>
                        <SUISelectItem Value="@ManagementUserSort.NameAscending">Nome A–Z</SUISelectItem>
                        <SUISelectItem Value="@ManagementUserSort.NameDescending">Nome Z–A</SUISelectItem>
                        <SUISelectItem Value="@ManagementUserSort.EmailAscending">E-mail A–Z</SUISelectItem>
                        <SUISelectItem Value="@ManagementUserSort.EmailDescending">E-mail Z–A</SUISelectItem>
                    </SUISelect>
                </div>
                <div class="users-field">
                    <span>Histórico do gráfico</span>
                    <SUISelect T="int" id="users-analytics-filter" name="range" aria-label="Histórico do gráfico" Value="@analyticsDays" ValueChanged="AnalyticsDaysSelected">
                        <SUISelectItem Value="@(14)">14 dias</SUISelectItem>
                        <SUISelectItem Value="@(30)">30 dias</SUISelectItem>
                        <SUISelectItem Value="@(60)">60 dias</SUISelectItem>
                        <SUISelectItem Value="@(90)">90 dias</SUISelectItem>
                    </SUISelect>
                </div>
                <div class="users-filter-actions">
                    <button class="button button--primary" type="submit" disabled="@usersLoading">@(usersLoading ? "Aplicando…" : "Aplicar filtros")</button>
                    <button class="button button--secondary" type="button" @onclick="ClearFilters" disabled="@usersLoading">Limpar</button>
                </div>
            </form>
        </details>

        <div class="table-panel users-results" aria-labelledby="users-list-heading">
            <div class="data-toolbar users-results__header">
                <div><h2 id="users-list-heading">Contas encontradas</h2><p>@ResultContextLabel</p></div>
                <span class="users-result-total" aria-live="polite">@ResultCountLabel</span>
            </div>
            <div class="client-results" aria-live="polite">
                @if (usersLoading)
                {
                    <div class="table-skeleton" aria-label="Carregando usuários"><span></span><span></span><span></span><span></span><span></span></div>
                }
                else if (usersResult?.IsSuccess is false)
                {
                    <SUIEmptyState Icon="alert" Title="@UsersErrorTitle" Description="@usersResult.ErrorMessage"><Actions><button class="button button--secondary" type="button" @onclick="LoadUsersAsync">Tentar novamente</button></Actions></SUIEmptyState>
                }
                else if (Page.Items.Count is 0)
                {
                    <SUIEmptyState Icon="users" Title="@EmptyStateTitle" Description="@EmptyStateDescription"><Actions><button class="button button--secondary" type="button" @onclick="ClearFilters">Voltar ao diretório</button></Actions></SUIEmptyState>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="data-table data-table--users users-table">
                            <thead><tr>
                                <th scope="col"><a href="@UrlFor(sort: ToggleNameSort, page: 1)" aria-label="Ordenar por nome">Usuário @SortMark(ManagementUserSort.NameAscending, ManagementUserSort.NameDescending)</a></th>
                                <th scope="col">E-mail</th>
                                <th scope="col"><a href="@UrlFor(sort: ToggleCreatedSort, page: 1)" aria-label="Ordenar por data de cadastro">Cadastro @SortMark(ManagementUserSort.CreatedNewest, ManagementUserSort.CreatedOldest)</a></th>
                                <th scope="col">Acesso externo</th><th scope="col">MFA</th><th scope="col">Estado</th><th scope="col"><span class="visually-hidden">Ações</span></th>
                            </tr></thead>
                            <tbody>
                            @foreach (var user in Page.Items)
                            {
                                <tr>
                                    <td data-label="Usuário"><a class="client-name client-link" href="@UserHref(user.Id)">@DisplayUserName(user)</a></td>
                                    <td data-label="E-mail">
                                        <span class="user-email">
                                            <span>@DisplayEmail(user)</span>
                                            @if (user.EmailConfirmed)
                                            {
                                                <span class="verified-mark" title="E-mail confirmado" aria-label="E-mail confirmado">
                                                    <SUIIcon Name="check" Size="13" />
                                                </span>
                                            }
                                        </span>
                                    </td>
                                    <td data-label="Cadastro"><time datetime="@user.CreatedAtUtc.ToString("O")"><strong>@user.CreatedAtUtc.ToString("dd/MM/yyyy", PtBr)</strong><span>@user.CreatedAtUtc.ToString("HH:mm", PtBr) UTC</span></time></td>
                                    <td data-label="Acesso externo"><SUIStatusBadge ToneValue="@(user.HasExternalLogin ? SUITone.Info : SUITone.Warning)">@(user.HasExternalLogin ? "Vinculado" : "Ausente")</SUIStatusBadge></td>
                                    <td data-label="MFA"><SUIStatusBadge ToneValue="@(user.TwoFactorEnabled ? SUITone.Success : SUITone.Neutral)">@(user.TwoFactorEnabled ? "Ativo" : "Inativo")</SUIStatusBadge></td>
                                    <td data-label="Estado"><span class="registration-state"><span class="status-dot @(user.IsLockedOut ? "status-dot--danger" : "status-dot--success")" aria-hidden="true"></span>@(user.IsLockedOut ? "Bloqueado" : "Ativo")</span></td>
                                    <td data-label="Ações"><a class="row-action" href="@UserHref(user.Id)" aria-label="@($"Abrir detalhes de {DisplayUserName(user)}")">Detalhes<SUIIcon Name="arrow-right" Size="15" /></a></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <footer class="table-footer table-footer--paginated">
                <span>@PaginationLabel</span>
                @if (TotalPages > 1)
                {
                    <nav class="pagination" aria-label="Paginação de usuários">
                        <a class="button button--secondary button--compact" aria-disabled="@(Page.Page <= 1)" href="@(Page.Page > 1 ? UrlFor(page: Page.Page - 1) : null)">Anterior</a>
                        <span>Página @Page.Page de @TotalPages</span>
                        <a class="button button--secondary button--compact" aria-disabled="@(Page.Page >= TotalPages)" href="@(Page.Page < TotalPages ? UrlFor(page: Page.Page + 1) : null)">Próxima</a>
                    </nav>
                }
            </footer>
        </div>
    </main>
}

@code {
    private static readonly CultureInfo PtBr = CultureInfo.GetCultureInfo("pt-BR");
    [SupplyParameterFromQuery(Name = "deleted")] public int DeletedFlag { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? QuerySearch { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int QueryPage { get; set; } = 1;
    [SupplyParameterFromQuery(Name = "from")] public DateOnly? QueryFrom { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public DateOnly? QueryTo { get; set; }
    [SupplyParameterFromQuery(Name = "day")] public DateOnly? QueryDay { get; set; }
    [SupplyParameterFromQuery(Name = "state")] public string? QueryStateValue { get; set; }
    [SupplyParameterFromQuery(Name = "email")] public string? QueryEmailValue { get; set; }
    [SupplyParameterFromQuery(Name = "mfa")] public string? QueryMfaValue { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? QuerySortValue { get; set; }
    [SupplyParameterFromQuery(Name = "review")] public string? QueryReviewValue { get; set; }
    [SupplyParameterFromQuery(Name = "range")] public int QueryAnalyticsDays { get; set; } = 30;

    private ManagementDataResult<ManagementUserAccess>? accessResult;
    private ManagementDataResult<ManagementUserPage>? usersResult;
    private bool accessLoading = true;
    private bool usersLoading;
    private string search = string.Empty;
    private DateOnly? registeredFrom;
    private DateOnly? registeredTo;
    private ManagementUserStateFilter state;
    private ManagementUserBooleanFilter emailConfirmed;
    private ManagementUserBooleanFilter mfa;
    private ManagementUserSort sort = ManagementUserSort.CreatedNewest;
    private ManagementUserReviewFilter review;
    private int analyticsDays = 30;
    private string? loadedFingerprint;
    private const int PageSize = 25;

    private bool Deleted => DeletedFlag is 1;
    private DateOnly? SelectedDay => QueryDay;
    private ManagementUserAccess Access => accessResult?.Value ?? new(false, false);
    private ManagementUserPage Page => usersResult?.Value ?? new([], 1, PageSize, 0);
    private ManagementUserAnalytics Analytics => Page.Analytics ?? new(0, 0, 0, 0, 3, []);
    private ManagementUserStateFilter QueryState => ParseEnum(QueryStateValue, ManagementUserStateFilter.All);
    private ManagementUserBooleanFilter QueryEmail => ParseEnum(QueryEmailValue, ManagementUserBooleanFilter.All);
    private ManagementUserBooleanFilter QueryMfa => ParseEnum(QueryMfaValue, ManagementUserBooleanFilter.All);
    private ManagementUserSort QuerySort => ParseEnum(QuerySortValue, ManagementUserSort.CreatedNewest);
    private ManagementUserReviewFilter QueryReview => ParseEnum(QueryReviewValue, ManagementUserReviewFilter.All);
    private bool IsStaleUnverifiedReview => QueryReview is ManagementUserReviewFilter.StaleUnverifiedWithoutExternal;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(Page.TotalCount / (double)Page.PageSize));
    private int AnomalyCount => Analytics.Days.Count(day => day.IsAnomaly);
    private int ChartMax => Math.Max(1, Analytics.Days.Count > 0 ? Analytics.Days.Max(day => day.Count) : 1);
    private ManagementUserSort ToggleCreatedSort => QuerySort == ManagementUserSort.CreatedNewest ? ManagementUserSort.CreatedOldest : ManagementUserSort.CreatedNewest;
    private ManagementUserSort ToggleNameSort => QuerySort == ManagementUserSort.NameAscending ? ManagementUserSort.NameDescending : ManagementUserSort.NameAscending;
    private string AccessErrorTitle => accessResult?.Outcome is ManagementDataOutcome.StepUpRequired ? "Autenticação adicional necessária" : "Acesso ao diretório não autorizado";
    private string UsersErrorTitle => usersResult?.Outcome is ManagementDataOutcome.StepUpRequired ? "MFA exigido para esta operação" : usersResult?.Outcome is ManagementDataOutcome.Forbidden ? "Acesso ao diretório negado" : "Não foi possível consultar os usuários";
    private string AnalyticsRangeLabel => $"Últimos {analyticsDays} dias";
    private string ResultContextLabel => IsStaleUnverifiedReview ? "Mais de 15 dias, sem confirmação de e-mail e sem login externo vinculado." : SelectedDay is { } day ? $"Cadastros de {day:dd/MM/yyyy}" : "Use filtros combinados para reduzir o conjunto investigado.";
    private string ResultCountLabel => usersLoading ? "Atualizando…" : $"{Page.TotalCount:N0} {Pluralize(Page.TotalCount, "conta", "contas")}";
    private string PaginationLabel => Page.TotalCount == 0 ? "Nenhum resultado" : $"Exibindo {(Page.Page - 1) * Page.PageSize + 1:N0}–{Math.Min(Page.Page * Page.PageSize, Page.TotalCount):N0} de {Page.TotalCount:N0}";
    private string ActiveFilterLabel { get { var count = 0; if (!string.IsNullOrWhiteSpace(QuerySearch)) count++; if (QueryFrom is not null || QueryTo is not null) count++; if (QueryDay is not null) count++; if (QueryState != ManagementUserStateFilter.All) count++; if (QueryEmail != ManagementUserBooleanFilter.All) count++; if (QueryMfa != ManagementUserBooleanFilter.All) count++; if (QueryReview != ManagementUserReviewFilter.All) count++; return count == 0 ? "Sem filtros" : $"{count} {Pluralize(count, "filtro ativo", "filtros ativos")}"; } }
    private string StaleUnverifiedCountLabel => $"{Analytics.StaleUnverifiedWithoutExternalTotal:N0} {Pluralize(Analytics.StaleUnverifiedWithoutExternalTotal, "conta pendente", "contas pendentes")}";
    private string EmptyStateTitle => IsStaleUnverifiedReview ? "Nenhuma conta pendente neste critério" : "Nenhum usuário neste recorte";
    private string EmptyStateDescription => IsStaleUnverifiedReview ? "Não há cadastros com mais de 15 dias, e-mail não confirmado e sem login externo vinculado." : "Altere os filtros ou limpe o dia selecionado para ampliar a busca.";

    protected override async Task OnParametersSetAsync()
    {
        var fingerprint = $"{QuerySearch}|{QueryPage}|{QueryFrom}|{QueryTo}|{QueryDay}|{QueryState}|{QueryEmail}|{QueryMfa}|{QuerySort}|{QueryAnalyticsDays}|{QueryReview}";
        if (fingerprint == loadedFingerprint) return;
        loadedFingerprint = fingerprint;
        SyncDraftsFromQuery();
        if (accessResult is null) await LoadAccessAsync(); else if (accessResult.IsSuccess) await LoadUsersAsync();
    }

    private async Task LoadAccessAsync()
    {
        accessLoading = true;
        accessResult = await UserData.GetAccessAsync();
        accessLoading = false;
        if (accessResult.IsSuccess) await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        usersLoading = true;
        usersResult = await UserData.SearchAsync(new ManagementUserSearch(QuerySearch, Math.Max(1, QueryPage), PageSize, QueryFrom, QueryTo, QueryDay, QueryState, QueryEmail, QueryMfa, QuerySort, NormalizeRange(QueryAnalyticsDays), QueryReview));
        usersLoading = false;
    }

    private void SyncDraftsFromQuery() { search = QuerySearch ?? string.Empty; registeredFrom = QueryFrom; registeredTo = QueryTo; state = QueryState; emailConfirmed = QueryEmail; mfa = QueryMfa; sort = QuerySort; analyticsDays = NormalizeRange(QueryAnalyticsDays); review = QueryReview; }
    private void ReviewSelected(ManagementUserReviewFilter value) => review = value;
    private void StateSelected(ManagementUserStateFilter value) => state = value;
    private void EmailSelected(ManagementUserBooleanFilter value) => emailConfirmed = value;
    private void MfaSelected(ManagementUserBooleanFilter value) => mfa = value;
    private void SortSelected(ManagementUserSort value) => sort = value;
    private void AnalyticsDaysSelected(int value) => analyticsDays = NormalizeRange(value);
    private void ApplyFilters() => Navigation.NavigateTo(UrlFor(page: 1, useDrafts: true, day: null, clearDay: true));
    private void ClearFilters() => Navigation.NavigateTo(BaseUri);
    private void SelectDay(DateOnly day) => Navigation.NavigateTo(UrlFor(day: SelectedDay == day ? null : day, clearDay: SelectedDay == day, page: 1));

    private string UrlFor(int? page = null, DateOnly? day = null, bool clearDay = false, ManagementUserSort? sort = null, bool useDrafts = false)
    {
        var selectedSort = sort ?? (useDrafts ? this.sort : QuerySort);
        var values = new Dictionary<string, object?>
        {
            ["q"] = NullIfEmpty(useDrafts ? search : QuerySearch), ["page"] = (page ?? Math.Max(1, QueryPage)) > 1 ? page ?? QueryPage : null,
            ["from"] = useDrafts ? registeredFrom : QueryFrom, ["to"] = useDrafts ? registeredTo : QueryTo,
            ["day"] = clearDay ? null : day ?? QueryDay,
            ["state"] = EnumOrNull(useDrafts ? state : QueryState), ["email"] = EnumOrNull(useDrafts ? emailConfirmed : QueryEmail), ["mfa"] = EnumOrNull(useDrafts ? mfa : QueryMfa),
            ["sort"] = selectedSort is ManagementUserSort.CreatedNewest ? null : selectedSort.ToString(),
            ["review"] = EnumOrNull(useDrafts ? review : QueryReview),
            ["range"] = NormalizeRange(useDrafts ? analyticsDays : QueryAnalyticsDays) == 30 ? null : NormalizeRange(useDrafts ? analyticsDays : QueryAnalyticsDays),
        };
        return Navigation.GetUriWithQueryParameters(BaseUri, values);
    }

    private string BaseUri => Navigation.Uri.Split('?', '#')[0];
    private string RiskReviewUrl => Navigation.GetUriWithQueryParameters(BaseUri, new Dictionary<string, object?> { ["review"] = ManagementUserReviewFilter.StaleUnverifiedWithoutExternal.ToString(), ["sort"] = ManagementUserSort.CreatedOldest.ToString() });
    private static object? EnumOrNull<T>(T value) where T : struct, Enum => Convert.ToInt32(value) == 0 ? null : value.ToString();
    private static T ParseEnum<T>(string? value, T fallback) where T : struct, Enum => Enum.TryParse<T>(value, true, out var parsed) && Enum.IsDefined(parsed) ? parsed : fallback;
    private static string? NullIfEmpty(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static int NormalizeRange(int value) => value is 14 or 30 or 60 or 90 ? value : 30;
    private string BarHeight(int count) => Math
        .Max(count > 0 ? 8m : 2m, count * 100m / ChartMax)
        .ToString("0.###", CultureInfo.InvariantCulture);
    private static string UserHref(string id) => $"users/{Uri.EscapeDataString(id)}";
    private static string DisplayUserName(ManagementUserSummary user) => string.IsNullOrWhiteSpace(user.UserName) ? user.Email ?? user.Id : user.UserName;
    private static string DisplayEmail(ManagementUserSummary user) => string.IsNullOrWhiteSpace(user.Email) ? "Não informado" : user.Email;
    private static string Pluralize(int count, string singular, string plural) => count is 1 ? singular : plural;
    private string SortMark(ManagementUserSort ascending, ManagementUserSort descending) => QuerySort == ascending ? "↑" : QuerySort == descending ? "↓" : "↕";
    private string DayAriaLabel(ManagementUserRegistrationDay day) => $"{day.Date.ToString("dd 'de' MMMM", PtBr)}: {day.Count} {Pluralize(day.Count, "cadastro", "cadastros")}{(day.IsAnomaly ? ", acima do padrão" : string.Empty)}";
}
