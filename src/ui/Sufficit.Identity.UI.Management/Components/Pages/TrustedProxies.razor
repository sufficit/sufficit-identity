@page "/settings/trusted-proxies"
@attribute [Authorize(Policy = ManagementUiPolicies.ReadTrustedProxies)]
@using Sufficit.Identity.Management.Networking
@using Sufficit.Identity.UI.Management.Networking
@inject ManagementTrustedProxiesDataSource ProxyData

<PageTitle>@L["TrustedProxies.PageTitle"]</PageTitle>
<SUIPageHeader Title="@L["TrustedProxies.HeaderTitle"].Value"
               Description="@L["TrustedProxies.HeaderDescription"].Value" />

@if (loading)
{
    <div class="detail-shell" aria-busy="true" aria-label="@L["TrustedProxies.Loading.Aria"].Value">
        <div class="detail-skeleton"></div>
    </div>
}
else if (configuration is null)
{
    <SUIEmptyState Icon="alert" Title="@L["TrustedProxies.LoadError.Title"].Value" Description="@message">
        <Actions><SUIButton OnClick="LoadAsync">@L["TrustedProxies.Retry"]</SUIButton></Actions>
    </SUIEmptyState>
}
else
{
    <div class="proxy-workspace">
        <section class="settings-panel" aria-labelledby="proxy-effective-heading">
            <div class="panel-header">
                <div><h2 id="proxy-effective-heading">@L["TrustedProxies.Effective.Heading"]</h2>
                    <p>@L["TrustedProxies.Effective.Description"]</p></div>
                <SUIStatusBadge ToneValue="SUITone.Info">@L["TrustedProxies.ForwardLimitBadge", configuration.ForwardLimit]</SUIStatusBadge>
            </div>
            <div class="proxy-panel-body">
            @if (configuration.EffectiveNetworks.Count == 0)
            {
                <p>@L["TrustedProxies.NoProxies"]</p>
            }
            else
            {
                <ul class="proxy-networks" aria-label="@L["TrustedProxies.EffectiveNetworks.Aria"].Value">
                    @foreach (var network in configuration.EffectiveNetworks)
                    {
                        <li><code>@network</code><span>@Source(network)</span></li>
                    }
                </ul>
            }
            <p class="proxy-note">@L["TrustedProxies.AppSettingsNote"]</p>
            <dl class="config-list">
                <div><dt>@L["TrustedProxies.FileHopsLabel"]</dt><dd>@configuration.FileForwardLimit</dd></div>
                <div><dt>@L["TrustedProxies.LastDbChangeLabel"]</dt><dd>@UpdatedLabel</dd></div>
            </dl>
            <a href="audit">@L["TrustedProxies.ViewAuditLink"]</a>
            </div>
        </section>

        <section class="settings-panel" aria-labelledby="proxy-edit-heading">
            <div class="panel-header"><div><h2 id="proxy-edit-heading">@L["TrustedProxies.DbConfig.Heading"]</h2>
                <p>@L["TrustedProxies.DbConfig.Description"]</p></div></div>
            <div class="proxy-panel-body">
            <AuthorizeView Policy="@ManagementUiPolicies.WriteTrustedProxies">
                <Authorized Context="operatorState">
                    <EditForm Model="model" OnValidSubmit="SaveAsync" FormName="trusted-proxies">
                        <DataAnnotationsValidator />
                        <fieldset disabled="@saving" class="proxy-fields">
                            <SUITextField T="string" id="trusted-proxy-networks" name="networks"
                                          Label="@L["TrustedProxies.Field.Networks.Label"].Value" Multiline="true" Rows="6"
                                          HelperText="@L["TrustedProxies.Field.Networks.Helper"].Value"
                                          Placeholder="172.16.2.0/32" MaxLength="@(8448)"
                                          @bind-Value="model.Networks" />
                            <SUISwitch id="proxy-inherit-limit" @bind-Value="model.InheritLimit"
                                       Label="@L["TrustedProxies.Field.InheritLimit.Label"].Value" />
                            @if (!model.InheritLimit)
                            {
                                <SUINumericField T="int" id="proxy-forward-limit" name="forwardLimit"
                                                 Label="@L["TrustedProxies.Field.ForwardLimit.Label"].Value" Min="@(1)" Max="@(10)"
                                                 @bind-Value="model.ForwardLimit" />
                                <ValidationMessage For="@(() => model.ForwardLimit)" />
                            }
                            <p class="proxy-note">@L["TrustedProxies.HopExplanation"]</p>
                            <div class="form-actions">
                                <SUIButton ButtonTypeValue="SUIButtonType.Submit" ColorValue="SUIColor.Primary" Disabled="@saving">
                                    @(saving ? L["TrustedProxies.Saving"] : L["TrustedProxies.SaveConfig"])
                                </SUIButton>
                                <SUIButton OnClick="LoadAsync" ColorValue="SUIColor.Default" VariantValue="SUIVariant.Outlined" Disabled="@saving">@L["TrustedProxies.Reload"]</SUIButton>
                            </div>
                        </fieldset>
                    </EditForm>
                </Authorized>
                <NotAuthorized><p>@L["TrustedProxies.NotAuthorized"]</p></NotAuthorized>
            </AuthorizeView>
            @if (configuration.NotificationPending)
            {
                <p role="status" class="proxy-note">@L["TrustedProxies.NotificationPending"]</p>
            }
            @if (configuration.NotificationsEnabled)
            {
                <p class="proxy-note">@(configuration.NotificationsConnected ? L["TrustedProxies.Notifications.Connected"] : L["TrustedProxies.Notifications.Waiting"])</p>
            }
            <p class="proxy-note">@L["TrustedProxies.AuditNote", configuration.RefreshSeconds]</p>
            </div>
        </section>
    </div>
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div role="status" aria-live="polite">
            <SUIAlert ToneValue="@(error ? SUITone.Danger : SUITone.Success)">@message</SUIAlert>
        </div>
    }
}

@code {
    private ManagementTrustedProxies? configuration;
    private ProxyForm model = new();
    private bool loading = true, saving, error;
    private string? message;
    private string UpdatedLabel => configuration?.UpdatedAtUtc is { } time && time > DateTime.UnixEpoch
        ? time.ToString("dd/MM/yyyy HH:mm:ss") : L["TrustedProxies.NoChanges"].Value;

    protected override Task OnInitializedAsync()
    {
        model.Localizer = L;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (saving) return;
        loading = true;
        message = null;
        var result = await ProxyData.GetAsync();
        configuration = result.Value;
        if (result.IsSuccess && configuration is not null) Apply(configuration);
        else { error = true; message = result.ErrorMessage; }
        loading = false;
    }

    private async Task SaveAsync()
    {
        if (saving || configuration is null) return;
        saving = true;
        message = null;
        try
        {
            var result = await ProxyData.SaveAsync(new(
                model.Networks.Split(['\r', '\n'], StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries),
                model.InheritLimit ? null : model.ForwardLimit, configuration.Revision));
            error = !result.IsSuccess;
            if (result.IsSuccess && result.Value is not null)
            {
                Apply(result.Value);
                message = L["TrustedProxies.ConfigSaved"].Value;
            }
            else message = result.ErrorMessage;
        }
        finally { saving = false; }
    }

    private void Apply(ManagementTrustedProxies value)
    {
        configuration = value;
        model = new()
        {
            Localizer = L,
            Networks = string.Join('\n', value.DatabaseNetworks),
            InheritLimit = value.DatabaseForwardLimit is null,
            ForwardLimit = value.ForwardLimit
        };
    }

    private string Source(string network) => configuration!.FileNetworks.Contains(network)
        ? configuration.DatabaseNetworks.Contains(network) ? L["TrustedProxies.Source.FileAndDb"].Value : L["TrustedProxies.Source.File"].Value
        : L["TrustedProxies.Source.Database"].Value;

    private sealed class ProxyForm : IValidatableObject
    {
        public IStringLocalizer<Sufficit.Identity.UI.Management.Resources.ManagementResource>? Localizer { get; set; }

        public string Networks { get; set; } = string.Empty;
        public bool InheritLimit { get; set; } = true;
        public int ForwardLimit { get; set; } = 2;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            var l = Localizer;
            if (l is null)
            {
                yield break;
            }

            if (ForwardLimit is < 1 or > 10)
            {
                yield return new ValidationResult(
                    l["TrustedProxies.Validation.ForwardLimitRange"].Value,
                    [nameof(ForwardLimit)]);
            }
        }
    }
}
