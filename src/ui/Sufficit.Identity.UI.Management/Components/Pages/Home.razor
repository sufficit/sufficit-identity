@page "/"
@attribute [Authorize(Policy = ManagementUiPolicies.Access)]
@inject ManagementOverviewDataSource OverviewData

@{ var overview = result?.Value!; }

<PageTitle>@L["Home.PageTitle"]</PageTitle>

<SUIPageHeader Title="@L["Home.HeaderTitle"].Value"
            Description="@L["Home.HeaderDescription"].Value">
    <Actions>
        <SUIButton Href="settings"
                   VariantValue="SUIVariant.Outlined"
                   ColorValue="SUIColor.Default">
            <SUIIcon Name="settings" Size="17" />
            @L["Home.ViewConfiguration"]
        </SUIButton>
    </Actions>
</SUIPageHeader>

@if (loading)
{
    <div class="detail-shell"
             aria-busy="true"
             aria-label="@L["Home.LoadingAriaLabel"].Value">
        <div class="detail-skeleton"></div>
        <div class="detail-skeleton detail-skeleton--short"></div>
    </div>
}
else if (result?.IsSuccess is not true || result.Value is null)
{
    <div>
        <SUIEmptyState Icon="alert"
                    Title="@L["Home.RuntimeError.Title"].Value"
                    Description="@(result?.ErrorMessage ?? L["Home.RuntimeError.Description"].Value)">
            <Actions>
                <SUIButton ColorValue="SUIColor.Primary"
                           OnClick="RefreshAsync">
                    @L["Home.Retry"]
                </SUIButton>
            </Actions>
        </SUIEmptyState>
    </div>
}
else
{
    <div class="contract-strip contract-strip--success">
        <SUIIcon Name="shield" Size="20" />
        <div>
            <strong>@L["Home.RuntimeState.Title"]</strong>
            <span>@L["Home.RuntimeState.Summary", overview.EnvironmentName, overview.Operator.Capabilities.Count]</span>
        </div>
        <SUIStatusBadge ToneValue="SUITone.Success">@L["Home.Current"]</SUIStatusBadge>
    </div>

    <div class="dashboard-grid">
        <div class="panel" aria-labelledby="available-modules-heading">
            <div class="panel-header">
                <div>
                    <h2 id="available-modules-heading">@L["Home.AvailableAreas.Title"]</h2>
                </div>
                <span class="section-meta">@L["Home.AvailableAreas.AuthorizedCount", AccessibleModuleCount]</span>
            </div>

            @if (AccessibleModules.Count is 0)
            {
                <SUIEmptyState Icon="lock"
                            Title="@NoAccessTitle"
                            Description="@NoAccessDescription">
                    <Actions>
                        @if (MfaIsPending)
                        {
                            <form method="post"
                                  action="/connect/endsession"
                                  data-enhance="false">
                                <AntiforgeryToken />
                                <input type="hidden" name="force_mfa" value="true" />
                                <SUIButton ButtonTypeValue="SUIButtonType.Submit"
                                           ColorValue="SUIColor.Error">
                                    @L["Home.EndSessionMfa"]
                                </SUIButton>
                            </form>
                            <SUIButton Href="/management/"
                                       VariantValue="SUIVariant.Outlined"
                                       ColorValue="SUIColor.Default"
                                       data-enhance-nav="false">
                                @L["Home.ReloadSession"]
                            </SUIButton>
                            <SUIButton Href="/manage/twofactor"
                                       VariantValue="SUIVariant.Outlined"
                                       ColorValue="SUIColor.Default"
                                       data-enhance-nav="false">
                                @L["Home.ViewMfaConfig"]
                            </SUIButton>
                        }
                    </Actions>
                </SUIEmptyState>
            }
            else
            {
                <div class="capability-list">
                    @foreach (var module in AccessibleModules)
                    {
                        <a class="capability-row" href="@module.Presentation.Href">
                            <span class="capability-row__icon">
                                <SUIIcon Name="@module.Presentation.Icon" />
                            </span>
                            <span class="capability-row__copy">
                                <strong>@module.Presentation.Title</strong>
                                <span>@module.Presentation.Description</span>
                            </span>
                            <SUIStatusBadge ToneValue="SUITone.Success">@L["Home.Allowed"]</SUIStatusBadge>
                            <SUIIcon Name="arrow-right"
                                     Size="17"
                                     CssClass="capability-row__arrow" />
                        </a>
                    }
                </div>
            }
        </div>

        <div class="settings-panel" aria-labelledby="effective-policy-heading">
            <div class="panel-header">
                <div>
                    <h2 id="effective-policy-heading">@L["Home.EffectivePolicy.Title"]</h2>
                </div>
            </div>
            <dl class="config-list">
                <div>
                    <dt>
                        <span>@L["Home.Field.Environment"]</span>
                        <code>Environment</code>
                    </dt>
                    <dd>
                        <span class="config-value">@overview.EnvironmentName</span>
                        <SUIStatusBadge ToneValue="SUITone.Neutral">Runtime</SUIStatusBadge>
                    </dd>
                </div>
                <div>
                    <dt>
                        <span>@L["Home.Field.Mfa"]</span>
                        <code>RequireMfa</code>
                    </dt>
                    <dd>
                        <span class="config-value">@MfaPolicyLabel</span>
                        <SUIStatusBadge ToneValue="@IdentitySuiTone.From(MfaTone)">@MfaSessionLabel</SUIStatusBadge>
                    </dd>
                </div>
                <div>
                    <dt>
                        <span>@L["Home.Field.HttpScope"]</span>
                        <code>RequiredScope</code>
                    </dt>
                    <dd>
                        <span class="config-value">
                            <code>@overview.Api.RequiredScope</code>
                        </span>
                        <SUIStatusBadge ToneValue="SUITone.Info">OAuth</SUIStatusBadge>
                    </dd>
                </div>
            </dl>
        </div>
    </div>

    <div class="security-note" aria-labelledby="runtime-source-title">
        <SUIIcon Name="check" Size="21" />
        <div>
            <h2 id="runtime-source-title">@L["Home.SecurityNote.Title"]</h2>
            <p>
                @L["Home.SecurityNote.Description"]
            </p>
        </div>
        <a href="settings">
            @L["Home.ViewDetails"]
            <SUIIcon Name="arrow-right" Size="15" />
        </a>
    </div>
}

@code {
    [CascadingParameter(Name = "ManagementOverview")]
    public ManagementDataResult<ManagementOverview>? CascadedOverview
    {
        get;
        set;
    }

    private ManagementDataResult<ManagementOverview>? result;
    private bool loading = true;
    private bool initialized;

    private ManagementOverview Overview =>
        result?.Value
        ?? throw new InvalidOperationException(
            "Overview is only available after a successful load.");

    private IReadOnlyList<ModuleView> AccessibleModules =>
        Overview.Modules
            .Where(module => module.CanAccess)
            .Select(CreateModuleView)
            .OfType<ModuleView>()
            .OrderBy(item => item.Presentation.SectionOrder)
            .ThenBy(item => item.Presentation.Order)
            .ToArray();

    private int AccessibleModuleCount => AccessibleModules.Count;

    private string MfaPolicyLabel =>
        Overview.Operator.RequiresMfa
            ? L["Home.Mfa.Required"].Value
            : L["Home.Mfa.Optional"].Value;

    private string MfaSessionLabel =>
        !Overview.Operator.RequiresMfa
            ? L["Home.Mfa.NotRequired"].Value
            : Overview.Operator.MeetsMfaRequirement
                ? L["Home.Mfa.Met"].Value
                : L["Home.Mfa.Pending"].Value;

    private string MfaTone =>
        Overview.Operator is
            { RequiresMfa: true, MeetsMfaRequirement: false }
            ? "warning"
            : "success";

    private string NoAccessTitle =>
        Overview.Operator is
            { RequiresMfa: true, MeetsMfaRequirement: false }
            ? L["Home.NoAccess.MfaRequired"].Value
            : L["Home.NoAccess.NoAreas"].Value;

    private string NoAccessDescription =>
        MfaIsPending
            ? L["Home.NoAccess.MfaPendingDescription", L["Home.ReloadSession"].Value].Value
            : L["Home.NoAccess.NoModulesGranted"].Value;

    private bool MfaIsPending =>
        Overview.Operator is
            { RequiresMfa: true, MeetsMfaRequirement: false };

    protected override async Task OnParametersSetAsync()
    {
        if (initialized)
        {
            return;
        }

        initialized = true;
        if (CascadedOverview is not null)
        {
            result = CascadedOverview;
            loading = false;
            return;
        }

        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        loading = true;
        result = await OverviewData.GetAsync();
        loading = false;
    }

    private ModuleView? CreateModuleView(
        ManagementModuleDescriptor module)
    {
        var presentation = ManagementModulePresentations.Find(module.Key, L);
        return presentation is null
            ? null
            : new ModuleView(module, presentation);
    }

    private sealed record ModuleView(
        ManagementModuleDescriptor Module,
        ManagementModulePresentation Presentation);
}
