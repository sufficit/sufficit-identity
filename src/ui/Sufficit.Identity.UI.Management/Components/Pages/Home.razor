@page "/"
@inject ManagementOverviewDataSource OverviewData

@{ var overview = result?.Value!; }

<PageTitle>Visão geral | Sufficit Identity</PageTitle>

<SUIPageHeader Title="Visão geral"
            Description="Consulte as áreas liberadas para sua sessão e a política efetiva do serviço de identidade.">
    <Actions>
        <a class="button button--secondary" href="settings">
            <SUIIcon Name="settings" Size="17" />
            Ver configuração
        </a>
    </Actions>
</SUIPageHeader>

@if (loading)
{
    <div class="detail-shell"
             aria-busy="true"
             aria-label="Carregando estado administrativo">
        <div class="detail-skeleton"></div>
        <div class="detail-skeleton detail-skeleton--short"></div>
    </div>
}
else if (result?.IsSuccess is not true || result.Value is null)
{
    <div>
        <SUIEmptyState Icon="alert"
                    Title="Não foi possível consultar o runtime"
                    Description="@(result?.ErrorMessage ?? "O serviço de identidade não informou seu estado administrativo.")">
            <Actions>
                <button class="button button--primary"
                        type="button"
                        @onclick="RefreshAsync">
                    Tentar novamente
                </button>
            </Actions>
        </SUIEmptyState>
    </div>
}
else
{
    <div class="contract-strip contract-strip--success">
        <SUIIcon Name="shield" Size="20" />
        <div>
            <strong>Estado fornecido pelo runtime</strong>
            <span>Ambiente @overview.EnvironmentName · @overview.Operator.Capabilities.Count capabilities efetivas</span>
        </div>
        <SUIStatusBadge Tone="success">Atual</SUIStatusBadge>
    </div>

    <div class="dashboard-grid">
        <div class="panel" aria-labelledby="available-modules-heading">
            <div class="panel-header">
                <div>
                    <h2 id="available-modules-heading">Áreas disponíveis</h2>
                </div>
                <span class="section-meta">@AccessibleModuleCount autorizadas</span>
            </div>

            @if (AccessibleModules.Count is 0)
            {
                <SUIEmptyState Icon="lock"
                            Title="@NoAccessTitle"
                            Description="@NoAccessDescription" />
            }
            else
            {
                <div class="capability-list">
                    @foreach (var module in AccessibleModules)
                    {
                        <a class="capability-row" href="@module.Presentation.Href">
                            <span class="capability-row__icon">
                                <SUIIcon Name="@module.Presentation.Icon" />
                            </span>
                            <span class="capability-row__copy">
                                <strong>@module.Presentation.Title</strong>
                                <span>@module.Presentation.Description</span>
                            </span>
                            <SUIStatusBadge Tone="success">Permitido</SUIStatusBadge>
                            <SUIIcon Name="arrow-right"
                                     Size="17"
                                     CssClass="capability-row__arrow" />
                        </a>
                    }
                </div>
            }
        </div>

        <div class="settings-panel" aria-labelledby="effective-policy-heading">
            <div class="panel-header">
                <div>
                    <h2 id="effective-policy-heading">Política efetiva</h2>
                </div>
            </div>
            <dl class="config-list">
                <div>
                    <dt>
                        <span>Ambiente</span>
                        <code>Environment</code>
                    </dt>
                    <dd>
                        <span class="config-value">@overview.EnvironmentName</span>
                        <SUIStatusBadge Tone="neutral">Runtime</SUIStatusBadge>
                    </dd>
                </div>
                <div>
                    <dt>
                        <span>Autenticação multifator</span>
                        <code>RequireMfa</code>
                    </dt>
                    <dd>
                        <span class="config-value">@MfaPolicyLabel</span>
                        <SUIStatusBadge Tone="@MfaTone">@MfaSessionLabel</SUIStatusBadge>
                    </dd>
                </div>
                <div>
                    <dt>
                        <span>Escopo do transporte HTTP</span>
                        <code>RequiredScope</code>
                    </dt>
                    <dd>
                        <span class="config-value">
                            <code>@overview.Api.RequiredScope</code>
                        </span>
                        <SUIStatusBadge Tone="info">OAuth</SUIStatusBadge>
                    </dd>
                </div>
            </dl>
        </div>
    </div>

    <div class="security-note" aria-labelledby="runtime-source-title">
        <SUIIcon Name="check" Size="21" />
        <div>
            <h2 id="runtime-source-title">Uma consulta, a mesma decisão</h2>
            <p>
                A interface e o adaptador HTTP projetam o mesmo catálogo de módulos,
                capabilities e políticas calculado pelo serviço de aplicação.
            </p>
        </div>
        <a href="settings">
            Ver detalhes
            <SUIIcon Name="arrow-right" Size="15" />
        </a>
    </div>
}

@code {
    [CascadingParameter(Name = "ManagementOverview")]
    public ManagementDataResult<ManagementOverview>? CascadedOverview
    {
        get;
        set;
    }

    private ManagementDataResult<ManagementOverview>? result;
    private bool loading = true;
    private bool initialized;

    private ManagementOverview Overview =>
        result?.Value
        ?? throw new InvalidOperationException(
            "Overview is only available after a successful load.");

    private IReadOnlyList<ModuleView> AccessibleModules =>
        Overview.Modules
            .Where(module => module.CanAccess)
            .Select(CreateModuleView)
            .OfType<ModuleView>()
            .OrderBy(item => item.Presentation.SectionOrder)
            .ThenBy(item => item.Presentation.Order)
            .ToArray();

    private int AccessibleModuleCount => AccessibleModules.Count;

    private string MfaPolicyLabel =>
        Overview.Operator.RequiresMfa ? "Obrigatória" : "Opcional";

    private string MfaSessionLabel =>
        !Overview.Operator.RequiresMfa
            ? "Não exigida"
            : Overview.Operator.MeetsMfaRequirement
                ? "Atendida"
                : "Pendente";

    private string MfaTone =>
        Overview.Operator is
            { RequiresMfa: true, MeetsMfaRequirement: false }
            ? "warning"
            : "success";

    private string NoAccessTitle =>
        Overview.Operator is
            { RequiresMfa: true, MeetsMfaRequirement: false }
            ? "Autenticação multifator necessária"
            : "Nenhuma área liberada";

    private string NoAccessDescription =>
        Overview.Operator is
            { RequiresMfa: true, MeetsMfaRequirement: false }
            ? "Conclua o MFA da sua sessão para acessar os módulos administrativos."
            : "O runtime não concedeu acesso a nenhum módulo para esta sessão.";

    protected override async Task OnParametersSetAsync()
    {
        if (initialized)
        {
            return;
        }

        initialized = true;
        if (CascadedOverview is not null)
        {
            result = CascadedOverview;
            loading = false;
            return;
        }

        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        loading = true;
        result = await OverviewData.GetAsync();
        loading = false;
    }

    private static ModuleView? CreateModuleView(
        ManagementModuleDescriptor module)
    {
        var presentation = ManagementModulePresentations.Find(module.Key);
        return presentation is null
            ? null
            : new ModuleView(module, presentation);
    }

    private sealed record ModuleView(
        ManagementModuleDescriptor Module,
        ManagementModulePresentation Presentation);
}
