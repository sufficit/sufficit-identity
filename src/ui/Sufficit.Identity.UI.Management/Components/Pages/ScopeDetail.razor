@page "/scopes/{Id}"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageScopes)]
@inject ManagementScopeDataSource ScopeData
@inject NavigationManager Navigation

@{ var scope = result?.Value!; }

<PageTitle>@PageTitleText</PageTitle>

<SUIPageHeader Title="@HeaderTitle"
            Description="@L["Scopes.Detail.HeaderDescription"].Value">
    <Actions>
        <a class="button button--secondary" href="scopes">
            <SUIIcon Name="arrow-left" Size="17" />
            @L["Scopes.BackToScopes"]
        </a>
    </Actions>
</SUIPageHeader>

@if (Created is 1)
{
    <div class="inline-notice inline-notice--success" role="status">
        <SUIIcon Name="check" Size="19" />
        <div>
            <strong>@L["Scopes.Created.Title"]</strong>
            <span>@L["Scopes.Created.Description"]</span>
        </div>
    </div>
}

@if (Updated is 1)
{
    <div class="inline-notice inline-notice--success" role="status">
        <SUIIcon Name="check" Size="19" />
        <div>
            <strong>@L["Scopes.Updated.Title"]</strong>
            <span>@L["Scopes.Updated.Description"]</span>
        </div>
    </div>
}

@if (loading)
{
    <div class="detail-shell" aria-busy="true" aria-label="@L["Scopes.Loading.Aria"].Value">
        <div class="detail-skeleton"></div>
    </div>
}
else if (result?.IsSuccess is true && result.Value is not null)
{
    @if (scope.IsManifestManaged)
    {
        <div class="contract-strip contract-strip--info">
            <SUIIcon Name="workflow" Size="20" />
            <div>
                <strong>@L["Scopes.ManifestManaged.Title"]</strong>
                <span>@L["Scopes.ManifestManaged.Description"]</span>
            </div>
            <SUIStatusBadge ToneValue="SUITone.Info">@L["Scopes.ReadOnly"]</SUIStatusBadge>
        </div>
    }

    @if (submission?.IsSuccess is false || deletion?.IsSuccess is false)
    {
        <div class="inline-notice inline-notice--danger" role="alert">
            <SUIIcon Name="alert" Size="19" />
            <div>
                <strong>@L["Scopes.OperationError.Title"]</strong>
                <span>@(submission?.ErrorMessage ?? deletion?.ErrorMessage)</span>
            </div>
        </div>
    }

    <div>
    <EditForm Model="model"
              OnValidSubmit="UpdateAsync"
              FormName="update-oauth-scope"
              class="management-form"
              Context="definition">
        <DataAnnotationsValidator />
        <div class="form-section" aria-labelledby="scope-detail-heading">
            <div class="form-section__heading">
                <h2 id="scope-detail-heading">@L["Scopes.Detail.Title"]</h2>
                <p>@L["Scopes.Detail.Description"]</p>
            </div>
            <SUIFormGrid Columns="2" Spacing="4" LabelLines="2">
                <SUITextField T="string"
                              id="scope-name"
                              Label="@L["Scopes.Field.Name.Label"].Value"
                              HelperText="@L["Scopes.Field.Name.ImmutableHelper"].Value"
                              Value="@scope.Name"
                              readonly />
                <SUITextField T="string"
                              id="scope-display-name"
                              Label="@L["Scopes.Field.DisplayName.Label"].Value"
                              HelperText="@L["Scopes.Field.DisplayName.Helper"].Value"
                              MaxLength="200"
                              Disabled="@scope.IsManifestManaged"
                              ErrorText="@ErrorFor(definition, nameof(model.DisplayName))"
                              @bind-Value="model.DisplayName" />
            </SUIFormGrid>
            <SUIFormGrid Columns="1" Spacing="4">
                <SUITextField T="string"
                              id="scope-description"
                              Label="@L["Scopes.Field.Description.Label"].Value"
                              HelperText="@L["Scopes.Field.Description.Helper"].Value"
                              Multiline
                              MaxLength="1000"
                              Disabled="@scope.IsManifestManaged"
                              ErrorText="@ErrorFor(definition, nameof(model.Description))"
                              @bind-Value="model.Description" />
                <SUITextField T="string"
                              id="scope-resources"
                              Label="@L["Scopes.Field.Resources.DetailLabel"].Value"
                              HelperText="@L["Scopes.Field.Resources.DetailHelper"].Value"
                              Multiline
                              Disabled="@scope.IsManifestManaged"
                              @bind-Value="model.Resources" />
            </SUIFormGrid>
        </div>

        <div class="form-section" aria-labelledby="scope-usage-heading">
            <div class="form-section__heading">
                <h2 id="scope-usage-heading">@L["Scopes.Usage.Title"]</h2>
                <p>@L["Scopes.Usage.Description"]</p>
            </div>
            @if (scope.ClientIds.Count is 0)
            {
                <p class="detail-empty">@L["Scopes.Usage.None"]</p>
            }
            else
            {
                <ul class="technical-list technical-list--tokens">
                    @foreach (var clientId in scope.ClientIds)
                    {
                        <li><code>@clientId</code></li>
                    }
                </ul>
            }
        </div>

        @if (!scope.IsManifestManaged)
        {
            <footer class="form-actions">
                <a class="button button--secondary" href="scopes">Cancelar</a>
                <button class="button button--primary" type="submit" disabled="@submitting">
                    @if (submitting)
                    {
                        <span class="button-spinner" aria-hidden="true"></span>
                        <span>@L["Scopes.Save.Saving"]</span>
                    }
                    else
                    {
                        <SUIIcon Name="check" Size="17" />
                        <span>@L["Scopes.Save.Submit"]</span>
                    }
                </button>
            </footer>
        }
    </EditForm>
    </div>

    @if (!scope.IsManifestManaged)
    {
        <div class="delete-zone" aria-labelledby="delete-scope-heading">
            <div>
                <h2 id="delete-scope-heading">@L["Scopes.Delete.Title"]</h2>
                <p>
                    @(scope.ClientIds.Count is 0
                        ? L["Scopes.Delete.NoClients"]
                        : L["Scopes.Delete.HasClients"])
                </p>
            </div>
            <label class="delete-confirmation">
                <input type="checkbox"
                       disabled="@(scope.ClientIds.Count > 0)"
                       @bind="deleteConfirmed" />
                <span>@L["Scopes.Delete.ConfirmLabel"]</span>
            </label>
            <button class="button button--danger"
                    type="button"
                    disabled="@(!deleteConfirmed || deleting || scope.ClientIds.Count > 0)"
                    @onclick="DeleteAsync">
                <SUIIcon Name="trash" Size="17" />
                @(deleting ? L["Scopes.Delete.Deleting"] : L["Scopes.Delete.Title"])
            </button>
        </div>
    }
}
else
{
    <div>
        <SUIEmptyState Icon="alert"
                    Title="@ErrorTitle"
                    Description="@(result?.ErrorMessage ?? L["Scopes.Error.DetailFallback"].Value)">
            <Actions>
                <a class="button button--secondary" href="scopes">@L["Scopes.BackToScopes"]</a>
            </Actions>
        </SUIEmptyState>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "created")]
    public int Created { get; set; }

    [SupplyParameterFromQuery(Name = "updated")]
    public int Updated { get; set; }

    private readonly ScopeEditModel model = new();
    private ManagementDataResult<ManagementScopeDetail>? result;
    private ManagementDataResult<ManagementScopeDetail>? submission;
    private ManagementDataResult<bool>? deletion;
    private bool loading = true;
    private bool submitting;
    private bool deleting;
    private bool deleteConfirmed;

    private string HeaderTitle =>
        result?.Value?.DisplayName
        ?? result?.Value?.Name
        ?? L["Scopes.Detail.DefaultTitle"].Value;

    private string PageTitleText => $"{HeaderTitle} | Sufficit Identity";

    private string ErrorTitle =>
        result?.Outcome is ManagementDataOutcome.NotFound
            ? L["Scopes.ErrorTitle.NotFound"].Value
            : result?.Outcome is ManagementDataOutcome.StepUpRequired
                ? L["Scopes.ErrorTitle.DetailStepUp"].Value
                : L["Scopes.ErrorTitle.DetailGeneric"].Value;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        model.Localizer = L;
        result = await ScopeData.GetAsync(Id);
        if (result.IsSuccess && result.Value is not null)
        {
            model.DisplayName = result.Value.DisplayName;
            model.Description = result.Value.Description;
            model.Resources = string.Join(Environment.NewLine, result.Value.Resources);
        }
        loading = false;
    }

    private async Task UpdateAsync()
    {
        if (submitting || result?.Value?.IsManifestManaged is true)
        {
            return;
        }

        submitting = true;
        submission = await ScopeData.UpdateAsync(
            Id,
            new UpdateManagementScopeCommand(
                model.DisplayName,
                model.Description,
                SplitLines(model.Resources)));
        submitting = false;

        if (submission.IsSuccess)
        {
            Navigation.NavigateTo(
                $"scopes/{Uri.EscapeDataString(Id)}?updated=1",
                forceLoad: true);
        }
    }

    private async Task DeleteAsync()
    {
        if (!deleteConfirmed || deleting)
        {
            return;
        }

        deleting = true;
        deletion = await ScopeData.DeleteAsync(Id);
        deleting = false;
        if (deletion.IsSuccess)
        {
            Navigation.NavigateTo("scopes?deleted=1");
        }
    }

    private static IReadOnlyList<string> SplitLines(string? value) =>
        (value ?? string.Empty).Split(
            ['\r', '\n'],
            StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    /// <summary>
    /// Delivers the field validation message to the component itself, instead
    /// of hanging a &lt;ValidationMessage&gt; next to it: inside a two-column
    /// grid, the sibling element becomes a cell and shifts the following
    /// column.
    /// </summary>
    private string? ErrorFor(EditContext context, string field) =>
        context.GetValidationMessages(new FieldIdentifier(model, field))
            .FirstOrDefault();

    private sealed class ScopeEditModel : IValidatableObject
    {
        public IStringLocalizer<Sufficit.Identity.UI.Management.Resources.ManagementResource>? Localizer { get; set; }

        public string? DisplayName { get; set; }

        public string? Description { get; set; }

        public string? Resources { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            var l = Localizer;
            if (l is null)
            {
                yield break;
            }

            if (DisplayName?.Length > 200)
            {
                yield return new ValidationResult(
                    l["Scopes.Validation.MaxLength200"].Value,
                    [nameof(DisplayName)]);
            }

            if (Description?.Length > 1000)
            {
                yield return new ValidationResult(
                    l["Scopes.Validation.MaxLength1000"].Value,
                    [nameof(Description)]);
            }
        }
    }
}
