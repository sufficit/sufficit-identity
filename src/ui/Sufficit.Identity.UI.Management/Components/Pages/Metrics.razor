@page "/metrics"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageMetrics)]
@attribute [StreamRendering]
@inject ManagementMetricsDataSource MetricsData
@inject NavigationManager Navigation

@{ var overview = overviewResult?.Value!; }

<PageTitle>@L["Metrics.PageTitle"]</PageTitle>

<SUIPageHeader Title="@L["Metrics.HeaderTitle"].Value"
            Description="@L["Metrics.HeaderDescription"].Value" />

<div class="contract-strip contract-strip--success">
    <SUIIcon Name="chart" Size="20" />
    <div>
        <strong>@L["Metrics.OffCriticalPath.Title"]</strong>
        <span>@L["Metrics.OffCriticalPath.Description"]</span>
    </div>
    <SUIStatusBadge ToneValue="SUITone.Success">@L["Metrics.NonBlocking"]</SUIStatusBadge>
</div>

<div class="metrics-filter" aria-labelledby="metrics-filter-heading">
    <div>
        <h2 id="metrics-filter-heading">@L["Metrics.Filter.Heading"]</h2>
        <p>@L["Metrics.Filter.Description"]</p>
    </div>
    <div class="metrics-filter__controls" data-sui-align-row>
        <SUISelect T="int"
                   id="metrics-days"
                   name="days"
                   aria-label="@L["Metrics.Filter.PeriodAria"].Value"
                   Label="@L["Metrics.Filter.PeriodAria"].Value"
                   Value="@selectedDays"
                   ValueChanged="SelectedDaysChanged">
            <SUISelectItem Value="@(7)">@L["Metrics.Filter.Last7Days"]</SUISelectItem>
            <SUISelectItem Value="@(30)">@L["Metrics.Filter.Last30Days"]</SUISelectItem>
            <SUISelectItem Value="@(90)">@L["Metrics.Filter.Last90Days"]</SUISelectItem>
            <SUISelectItem Value="@(365)">@L["Metrics.Filter.Last12Months"]</SUISelectItem>
        </SUISelect>
        <SUITextField T="string"
                      id="metrics-client"
                      name="client"
                      aria-label="@L["Metrics.Filter.ClientIdAria"].Value"
                      Label="@L["Metrics.Filter.ClientIdLabel"].Value"
                      InputType="search"
                      Placeholder="@L["Metrics.Filter.AllApplications"].Value"
                      Value="@selectedClient"
                      ValueChanged="SelectedClientChanged"
                      autocomplete="off" />
        <SUIButton ColorValue="SUIColor.Primary"
                   Class="metrics-filter__apply"
                   OnClick="ApplyFilters">
            @L["Metrics.Filter.Apply"]
        </SUIButton>
    </div>
</div>

@if (loading)
{
    <div class="detail-shell" aria-busy="true" aria-label="@L["Metrics.Loading.Aria"].Value">
        <div class="detail-skeleton"></div>
        <div class="detail-skeleton detail-skeleton--short"></div>
    </div>
}
else if (overviewResult?.IsSuccess is not true || overviewResult.Value is null)
{
    <div>
        <SUIEmptyState Icon="alert" Title="@L["Metrics.LoadError.Title"].Value"
                    Description="@(overviewResult?.ErrorMessage ?? L["Metrics.LoadError.Fallback"].Value)">
            <Actions>
                <SUIButton ColorValue="SUIColor.Primary" OnClick="LoadAsync">@L["Metrics.Retry"]</SUIButton>
            </Actions>
        </SUIEmptyState>
    </div>
}
else
{
    <div class="metrics-summary" aria-label="@L["Metrics.Summary.Aria"].Value">
        <div><span>@L["Metrics.Summary.EventsInPeriod"]</span><strong>@FormatNumber(overview.TotalEvents)</strong></div>
        <div><span>@L["Metrics.Summary.ActiveApplications"]</span><strong>@FormatNumber(overview.ActiveApplications)</strong></div>
        <div><span>@L["Metrics.Summary.Success"]</span><strong>@SuccessRate(overview)</strong></div>
        <div><span>@L["Metrics.Summary.DroppedInQueue"]</span><strong>@FormatNumber(overview.Collector.Dropped)</strong></div>
    </div>

    <div class="metrics-workspace">
        <div class="panel metrics-chart-panel" aria-labelledby="usage-chart-heading">
            <div class="panel-header">
                <div><h2 id="usage-chart-heading">@L["Metrics.Chart.Heading"]</h2><p>@L["Metrics.Chart.Description"]</p></div>
                <span class="section-meta">UTC</span>
            </div>
            @if (overview.Daily.Count is 0)
            {
                <div class="metrics-empty">@L["Metrics.Chart.NoUsage"]</div>
            }
            else
            {
                <div class="usage-chart" role="img" aria-label="@L["Metrics.Chart.Aria"].Value">
                    @foreach (var point in overview.Daily)
                    {
                        <div class="usage-chart__column" title="@point.DateUtc.ToString("dd/MM/yyyy"): @point.Count">
                            <span class="usage-chart__value">@FormatCompact(point.Count)</span>
                            <span class="usage-chart__bar" style="height: @BarHeight(point.Count, overview.Daily)%"></span>
                            <span class="usage-chart__date">@point.DateUtc.ToString("dd/MM")</span>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="panel" aria-labelledby="collector-heading">
            <div class="panel-header"><div><h2 id="collector-heading">@L["Metrics.Collector.Heading"]</h2><p>@L["Metrics.Collector.Description"]</p></div></div>
            <dl class="metrics-health">
                <div><dt>@L["Metrics.Collector.Queued"]</dt><dd>@FormatNumber(overview.Collector.QueueDepth)</dd></div>
                <div><dt>@L["Metrics.Collector.Persisted"]</dt><dd>@FormatNumber(overview.Collector.Persisted)</dd></div>
                <div><dt>@L["Metrics.Collector.Exported"]</dt><dd>@FormatNumber(overview.Collector.Exported)</dd></div>
                <div><dt>@L["Metrics.Collector.IsolatedFailures"]</dt><dd>@FormatNumber(overview.Collector.Failures)</dd></div>
            </dl>
        </div>
    </div>

    <div class="table-panel" aria-labelledby="top-applications-heading">
        <div class="data-toolbar">
            <div><h2 id="top-applications-heading">@L["Metrics.TopApplications.Heading"]</h2><p>@L["Metrics.TopApplications.Description"]</p></div>
        </div>
        @if (overview.Applications.Count is 0)
        {
            <div class="metrics-empty">@L["Metrics.TopApplications.NoMatch"]</div>
        }
        else
        {
            <div class="metrics-application-list">
                @foreach (var application in overview.Applications)
                {
                    <div class="metrics-application-row">
                        <div><strong>@application.DisplayName</strong><code>@application.ClientId</code></div>
                        <div><strong>@FormatNumber(application.Count)</strong><span>@L["Metrics.TopApplications.LastUsed", application.LastUsedAtUtc.ToString("dd/MM HH:mm")]</span></div>
                    </div>
                }
            </div>
        }
    </div>
}

<div class="form-section metrics-settings" aria-labelledby="metrics-settings-heading">
    <div class="form-section__heading">
        <h2 id="metrics-settings-heading">@L["Metrics.Settings.Heading"]</h2>
        <p>@L["Metrics.Settings.Description"]</p>
    </div>
    @if (configurationLoading)
    {
        <div class="detail-skeleton detail-skeleton--short"></div>
    }
    else if (configuration is not null)
    {
        <EditForm Model="configuration" OnValidSubmit="SaveConfigurationAsync" FormName="metrics-configuration">
            <DataAnnotationsValidator />
            <div class="metrics-toggle-row">
                <div class="metrics-toggle-card">
                    <SUISwitch @bind-Value="configuration.Enabled" Label="@L["Metrics.Settings.LocalCollection.Label"].Value" />
                    <p>@L["Metrics.Settings.LocalCollection.Description"]</p>
                </div>
                <div class="metrics-toggle-card">
                    <SUISwitch @bind-Value="configuration.ExportEnabled" Label="@L["Metrics.Settings.ExternalExport.Label"].Value" />
                    <p>@L["Metrics.Settings.ExternalExport.Description"]</p>
                </div>
            </div>
            <div class="form-grid form-grid--two metrics-settings__fields" data-sui-align-row>
                <SUISelect T="string"
                           id="metrics-provider"
                           aria-label="@L["Metrics.Field.Provider.Label"].Value"
                           Label="@L["Metrics.Field.Provider.Label"].Value"
                           @bind-Value="configuration.Provider">
                    <SUISelectItem Value="@("internal")">@L["Metrics.Provider.InternalOnly"]</SUISelectItem>
                    <SUISelectItem Value="@("victoria_metrics")">VictoriaMetrics</SUISelectItem>
                </SUISelect>
                <SUINumericField T="int"
                                 id="metrics-retention"
                                 aria-label="@L["Metrics.Field.RetentionDays.Label"].Value"
                                 Label="@L["Metrics.Field.RetentionDays.Label"].Value"
                                 Min="@(1)"
                                 Max="@(3650)"
                                 @bind-Value="configuration.RetentionDays" />
                <SUITextField T="string"
                              id="metrics-endpoint"
                              aria-label="@L["Metrics.Field.Endpoint.Label"].Value"
                              Label="@L["Metrics.Field.Endpoint.Label"].Value"
                              InputType="url"
                              Placeholder="https://metrics.example.com"
                              @bind-Value="configuration.Endpoint" />
                <SUITextField T="string"
                              id="metrics-database"
                              aria-label="@L["Metrics.Field.Database.Label"].Value"
                              Label="@L["Metrics.Field.Database.Label"].Value"
                              Placeholder="identity"
                              @bind-Value="configuration.Database" />
                <SUISelect T="string"
                           id="metrics-auth"
                           aria-label="@L["Metrics.Field.AuthScheme.Label"].Value"
                           Label="@L["Metrics.Field.AuthScheme.Label"].Value"
                           Value="@AuthorizationSchemeValue"
                           ValueChanged="AuthorizationSchemeChanged">
                    <SUISelectItem Value="@string.Empty">@L["Metrics.AuthScheme.None"]</SUISelectItem>
                    <SUISelectItem Value="@("Bearer")">Bearer</SUISelectItem>
                    <SUISelectItem Value="@("Basic")">Basic</SUISelectItem>
                </SUISelect>
                <SUITextField T="string"
                              id="metrics-username"
                              aria-label="@L["Metrics.Field.Username.Aria"].Value"
                              Label="@L["Metrics.Field.Username.Label"].Value"
                              @bind-Value="configuration.Username"
                              autocomplete="username" />
                <SUITextField T="string"
                              id="metrics-secret"
                              aria-label="@L["Metrics.Field.Secret.Aria"].Value"
                              Label="@L["Metrics.Field.Secret.Label"].Value"
                              InputType="password"
                              HelperText="@SecretHelperText"
                              @bind-Value="configuration.Secret"
                              autocomplete="new-password" />
                <SUINumericField T="int"
                                 id="metrics-batch"
                                 aria-label="@L["Metrics.Field.BatchSize.Label"].Value"
                                 Label="@L["Metrics.Field.BatchSize.Label"].Value"
                                 Min="@(1)"
                                 Max="@(2000)"
                                 @bind-Value="configuration.BatchSize" />
                <SUINumericField T="int"
                                 id="metrics-timeout"
                                 aria-label="@L["Metrics.Field.Timeout.Label"].Value"
                                 Label="@L["Metrics.Field.Timeout.Label"].Value"
                                 Min="@(1)"
                                 Max="@(120)"
                                 @bind-Value="configuration.TimeoutSeconds" />
            </div>
            @if (configuration.HasSecret)
            {
                <div class="metrics-clear-secret">
                    <SUISwitch @bind-Value="configuration.ClearSecret"
                               Label="@L["Metrics.ClearSecret.Label"].Value" />
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(configurationMessage))
            {
                <SUIAlert ToneValue="@(configurationMessageIsError ? SUITone.Danger : SUITone.Success)"
                          Icon="@(configurationMessageIsError ? "alert" : "check")"
                          Class="metrics-configuration-feedback">
                    @configurationMessage
                </SUIAlert>
            }
            <div class="form-actions">
                <SUIButton ButtonTypeValue="SUIButtonType.Submit"
                           ColorValue="SUIColor.Primary"
                           Disabled="@savingConfiguration">
                    @(savingConfiguration ? L["Metrics.Save.Saving"] : L["Metrics.Save.Submit"])
                </SUIButton>
            </div>
        </EditForm>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "days")] public int? Days { get; set; }
    [SupplyParameterFromQuery(Name = "client")] public string? ClientId { get; set; }
    private int selectedDays = 30;
    private string? selectedClient;
    private bool loading = true, configurationLoading = true, savingConfiguration;
    private ManagementDataResult<ManagementMetricsOverview>? overviewResult;
    private MetricsConfigurationModel? configuration;
    private string? configurationMessage;
    private bool configurationMessageIsError;

    private string AuthorizationSchemeValue => configuration?.AuthorizationScheme ?? string.Empty;
    private string SecretHelperText => configuration?.HasSecret is true
        ? L["Metrics.Secret.Existing"].Value
        : L["Metrics.Secret.None"].Value;

    protected override async Task OnParametersSetAsync()
    {
        selectedDays = Days is 7 or 30 or 90 or 365 ? Days.Value : 30;
        selectedClient = ClientId;
        await LoadAsync();
        if (configuration is null) await LoadConfigurationAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        var to = DateTime.UtcNow;
        overviewResult = await MetricsData.GetOverviewAsync(to.AddDays(-selectedDays), to, selectedClient);
        loading = false;
    }

    private async Task LoadConfigurationAsync()
    {
        configurationLoading = true;
        var result = await MetricsData.GetConfigurationAsync();
        if (result.IsSuccess && result.Value is not null) configuration = MetricsConfigurationModel.From(result.Value);
        else
        {
            configurationMessage = result.ErrorMessage;
            configurationMessageIsError = true;
        }
        configurationLoading = false;
    }

    private Task SelectedDaysChanged(int value)
    {
        selectedDays = value;
        return Task.CompletedTask;
    }

    private Task SelectedClientChanged(string? value)
    {
        selectedClient = value;
        return Task.CompletedTask;
    }

    private Task AuthorizationSchemeChanged(string? value)
    {
        if (configuration is not null)
            configuration.AuthorizationScheme = string.IsNullOrWhiteSpace(value) ? null : value;
        return Task.CompletedTask;
    }

    private void ApplyFilters()
    {
        var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["days"] = selectedDays,
            ["client"] = string.IsNullOrWhiteSpace(selectedClient) ? null : selectedClient.Trim()
        });
        Navigation.NavigateTo(uri);
    }

    private async Task SaveConfigurationAsync()
    {
        if (configuration is null) return;
        savingConfiguration = true; configurationMessage = null;
        var result = await MetricsData.UpdateConfigurationAsync(configuration.ToCommand());
        configurationMessage = result.IsSuccess ? L["Metrics.Save.Success"].Value : result.ErrorMessage;
        configurationMessageIsError = !result.IsSuccess;
        if (result.IsSuccess && result.Value is not null) configuration = MetricsConfigurationModel.From(result.Value);
        savingConfiguration = false;
    }

    private static string FormatNumber(long value) => value.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));
    private string FormatCompact(long value) => value >= 1_000_000
        ? $"{value / 1_000_000d:0.#} {L["Metrics.Compact.Million"].Value}"
        : value >= 1_000
            ? $"{value / 1_000d:0.#} {L["Metrics.Compact.Thousand"].Value}"
            : value.ToString();
    private static string SuccessRate(ManagementMetricsOverview value) => value.TotalEvents == 0 ? "—" : $"{value.SuccessfulEvents * 100d / value.TotalEvents:0.#}%";
    private static int BarHeight(long count, IReadOnlyList<ManagementMetricsDailyPoint> points) => Math.Max(4, (int)Math.Round(count * 100d / Math.Max(1, points.Max(item => item.Count))));

    private sealed class MetricsConfigurationModel
    {
        public bool Enabled { get; set; }
        public bool ExportEnabled { get; set; }
        [Range(1, 3650)] public int RetentionDays { get; set; }
        public string Provider { get; set; } = "internal";
        public string? Endpoint { get; set; }
        public string? Database { get; set; }
        public string? AuthorizationScheme { get; set; }
        public string? Username { get; set; }
        public string? Secret { get; set; }
        public bool HasSecret { get; set; }
        public bool ClearSecret { get; set; }
        [Range(1, 120)] public int TimeoutSeconds { get; set; } = 10;
        [Range(1, 2000)] public int BatchSize { get; set; } = 250;
        public SaveManagementMetricsConfiguration ToCommand() => new(Enabled, RetentionDays, ExportEnabled, Provider, Endpoint, Database, AuthorizationScheme, Username, Secret, ClearSecret, TimeoutSeconds, BatchSize);
        public static MetricsConfigurationModel From(ManagementMetricsConfiguration value) => new() { Enabled = value.Enabled, RetentionDays = value.RetentionDays, ExportEnabled = value.ExportEnabled, Provider = value.Provider, Endpoint = value.Endpoint, Database = value.Database, AuthorizationScheme = value.AuthorizationScheme, Username = value.Username, HasSecret = value.HasSecret, TimeoutSeconds = value.TimeoutSeconds, BatchSize = value.BatchSize };
    }
}
