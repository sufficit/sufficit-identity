@page "/metrics"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageMetrics)]
@attribute [StreamRendering]
@inject ManagementMetricsDataSource MetricsData
@inject NavigationManager Navigation

@{ var overview = overviewResult?.Value!; }

<PageTitle>Métricas | Sufficit Identity</PageTitle>

<PageHeader Title="Uso das aplicações"
            Description="Acompanhe autenticações por cliente e configure a coleta sem acoplar a disponibilidade do Identity ao destino externo." />

<div class="contract-strip contract-strip--success">
    <AppIcon Name="chart" Size="20" />
    <div>
        <strong>Coleta fora do caminho crítico</strong>
        <span>Autenticação nunca aguarda banco ou exportador; pressão excessiva é descartada e fica visível.</span>
    </div>
    <StatusBadge Tone="success">Não bloqueante</StatusBadge>
</div>

<div class="metrics-filter" aria-labelledby="metrics-filter-heading">
    <div>
        <h2 id="metrics-filter-heading">Período analisado</h2>
        <p>Os filtros ficam na URL para preservar e compartilhar a investigação.</p>
    </div>
    <div class="metrics-filter__controls">
        <div class="field-group">
            <label for="metrics-days">Período</label>
            <select id="metrics-days" class="form-control" @bind="selectedDays">
                <option value="7">Últimos 7 dias</option>
                <option value="30">Últimos 30 dias</option>
                <option value="90">Últimos 90 dias</option>
                <option value="365">Últimos 12 meses</option>
            </select>
        </div>
        <div class="field-group metrics-filter__client">
            <label for="metrics-client">Client ID <span class="label-optional">opcional</span></label>
            <input id="metrics-client" name="client" class="form-control" type="search"
                   autocomplete="off" placeholder="Todas as aplicações" @bind="selectedClient" />
        </div>
        <button class="button button--primary" type="button" @onclick="ApplyFilters">Aplicar filtros</button>
    </div>
</div>

@if (loading)
{
    <div class="detail-shell" aria-busy="true" aria-label="Carregando métricas">
        <div class="detail-skeleton"></div>
        <div class="detail-skeleton detail-skeleton--short"></div>
    </div>
}
else if (overviewResult?.IsSuccess is not true || overviewResult.Value is null)
{
    <div>
        <EmptyState Icon="alert" Title="Não foi possível consultar as métricas"
                    Description="@(overviewResult?.ErrorMessage ?? "O coletor não informou seu estado.")">
            <Actions><button class="button button--primary" type="button" @onclick="LoadAsync">Tentar novamente</button></Actions>
        </EmptyState>
    </div>
}
else
{
    <div class="metrics-summary" aria-label="Resumo de uso">
        <div><span>Eventos no período</span><strong>@FormatNumber(overview.TotalEvents)</strong></div>
        <div><span>Aplicações ativas</span><strong>@FormatNumber(overview.ActiveApplications)</strong></div>
        <div><span>Sucesso</span><strong>@SuccessRate(overview)</strong></div>
        <div><span>Descartados na fila</span><strong>@FormatNumber(overview.Collector.Dropped)</strong></div>
    </div>

    <div class="metrics-workspace">
        <div class="panel metrics-chart-panel" aria-labelledby="usage-chart-heading">
            <div class="panel-header">
                <div><h2 id="usage-chart-heading">Cadência diária</h2><p>Emissões OAuth/OIDC concluídas por dia.</p></div>
                <span class="section-meta">UTC</span>
            </div>
            @if (overview.Daily.Count is 0)
            {
                <div class="metrics-empty">Nenhum uso registrado neste período.</div>
            }
            else
            {
                <div class="usage-chart" role="img" aria-label="Gráfico de uso diário">
                    @foreach (var point in overview.Daily)
                    {
                        <div class="usage-chart__column" title="@point.DateUtc.ToString("dd/MM/yyyy"): @point.Count">
                            <span class="usage-chart__value">@FormatCompact(point.Count)</span>
                            <span class="usage-chart__bar" style="height: @BarHeight(point.Count, overview.Daily)%"></span>
                            <span class="usage-chart__date">@point.DateUtc.ToString("dd/MM")</span>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="panel" aria-labelledby="collector-heading">
            <div class="panel-header"><div><h2 id="collector-heading">Saúde da coleta</h2><p>Pressão e entregas desde o início do processo.</p></div></div>
            <dl class="metrics-health">
                <div><dt>Na fila</dt><dd>@FormatNumber(overview.Collector.QueueDepth)</dd></div>
                <div><dt>Persistidos</dt><dd>@FormatNumber(overview.Collector.Persisted)</dd></div>
                <div><dt>Exportados</dt><dd>@FormatNumber(overview.Collector.Exported)</dd></div>
                <div><dt>Falhas isoladas</dt><dd>@FormatNumber(overview.Collector.Failures)</dd></div>
            </dl>
        </div>
    </div>

    <div class="table-panel" aria-labelledby="top-applications-heading">
        <div class="data-toolbar">
            <div><h2 id="top-applications-heading">Aplicações mais utilizadas</h2><p>Ordenadas pelo volume no período selecionado.</p></div>
        </div>
        @if (overview.Applications.Count is 0)
        {
            <div class="metrics-empty">Nenhuma aplicação corresponde aos filtros.</div>
        }
        else
        {
            <div class="metrics-application-list">
                @foreach (var application in overview.Applications)
                {
                    <div class="metrics-application-row">
                        <div><strong>@application.DisplayName</strong><code>@application.ClientId</code></div>
                        <div><strong>@FormatNumber(application.Count)</strong><span>último uso @application.LastUsedAtUtc.ToString("dd/MM HH:mm") UTC</span></div>
                    </div>
                }
            </div>
        }
    </div>
}

<div class="form-section metrics-settings" aria-labelledby="metrics-settings-heading">
    <div class="form-section__heading">
        <h2 id="metrics-settings-heading">Coleta e exportação</h2>
        <p>A configuração é persistida no banco e reaplicada em execução. O vault interno deve estar habilitado para armazenar credenciais.</p>
    </div>
    @if (configurationLoading)
    {
        <div class="detail-skeleton detail-skeleton--short"></div>
    }
    else if (configuration is not null)
    {
        <EditForm Model="configuration" OnValidSubmit="SaveConfigurationAsync" FormName="metrics-configuration">
            <DataAnnotationsValidator />
            <div class="metrics-toggle-row">
                <label class="switch-control" for="metrics-enabled"><InputCheckbox id="metrics-enabled" @bind-Value="configuration.Enabled" /><span><strong>Coleta local</strong><small>Registra uso por aplicação no banco.</small></span></label>
                <label class="switch-control" for="metrics-export"><InputCheckbox id="metrics-export" @bind-Value="configuration.ExportEnabled" /><span><strong>Exportação externa</strong><small>Envia lotes sem afetar autenticações.</small></span></label>
            </div>
            <div class="form-grid form-grid--two">
                <div class="field-group"><label for="metrics-provider">Provedor</label><InputSelect id="metrics-provider" class="form-control" @bind-Value="configuration.Provider"><option value="internal">Somente banco local</option><option value="victoria_metrics">VictoriaMetrics</option></InputSelect></div>
                <div class="field-group"><label for="metrics-retention">Retenção em dias</label><InputNumber id="metrics-retention" class="form-control" @bind-Value="configuration.RetentionDays" /></div>
                <div class="field-group"><label for="metrics-endpoint">Endpoint</label><InputText id="metrics-endpoint" class="form-control" @bind-Value="configuration.Endpoint" placeholder="https://metrics.example.com" /></div>
                <div class="field-group"><label for="metrics-database">Banco lógico</label><InputText id="metrics-database" class="form-control" @bind-Value="configuration.Database" placeholder="identity" /></div>
                <div class="field-group"><label for="metrics-auth">Esquema de autorização</label><InputSelect id="metrics-auth" class="form-control" @bind-Value="configuration.AuthorizationScheme"><option value="">Sem autenticação</option><option value="Bearer">Bearer</option><option value="Basic">Basic</option></InputSelect></div>
                <div class="field-group"><label for="metrics-username">Usuário <span class="label-optional">Basic</span></label><InputText id="metrics-username" class="form-control" @bind-Value="configuration.Username" autocomplete="username" /></div>
                <div class="field-group"><label for="metrics-secret">Novo segredo <span class="label-optional">opcional</span></label><InputText id="metrics-secret" class="form-control" type="password" @bind-Value="configuration.Secret" autocomplete="new-password" /><span class="field-hint">@(configuration.HasSecret ? "Já existe um segredo protegido; deixe vazio para mantê-lo." : "Nenhum segredo armazenado.")</span></div>
                <div class="field-group"><label for="metrics-batch">Eventos por lote</label><InputNumber id="metrics-batch" class="form-control" @bind-Value="configuration.BatchSize" /></div>
                <div class="field-group"><label for="metrics-timeout">Timeout do exportador em segundos</label><InputNumber id="metrics-timeout" class="form-control" @bind-Value="configuration.TimeoutSeconds" /></div>
            </div>
            @if (configuration.HasSecret)
            {
                <label class="switch-control metrics-clear-secret" for="metrics-clear-secret"><InputCheckbox id="metrics-clear-secret" @bind-Value="configuration.ClearSecret" /><span>Remover a credencial protegida ao salvar</span></label>
            }
            @if (!string.IsNullOrWhiteSpace(configurationMessage))
            {
                <p class="form-feedback" role="status">@configurationMessage</p>
            }
            <div class="form-actions"><button class="button button--primary" type="submit" disabled="@savingConfiguration">@(savingConfiguration ? "Salvando…" : "Salvar configuração")</button></div>
        </EditForm>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "days")] public int? Days { get; set; }
    [SupplyParameterFromQuery(Name = "client")] public string? ClientId { get; set; }
    private int selectedDays = 30;
    private string? selectedClient;
    private bool loading = true, configurationLoading = true, savingConfiguration;
    private ManagementDataResult<ManagementMetricsOverview>? overviewResult;
    private MetricsConfigurationModel? configuration;
    private string? configurationMessage;

    protected override async Task OnParametersSetAsync()
    {
        selectedDays = Days is 7 or 30 or 90 or 365 ? Days.Value : 30;
        selectedClient = ClientId;
        await LoadAsync();
        if (configuration is null) await LoadConfigurationAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        var to = DateTime.UtcNow;
        overviewResult = await MetricsData.GetOverviewAsync(to.AddDays(-selectedDays), to, selectedClient);
        loading = false;
    }

    private async Task LoadConfigurationAsync()
    {
        configurationLoading = true;
        var result = await MetricsData.GetConfigurationAsync();
        if (result.IsSuccess && result.Value is not null) configuration = MetricsConfigurationModel.From(result.Value);
        else configurationMessage = result.ErrorMessage;
        configurationLoading = false;
    }

    private void ApplyFilters()
    {
        var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["days"] = selectedDays,
            ["client"] = string.IsNullOrWhiteSpace(selectedClient) ? null : selectedClient.Trim()
        });
        Navigation.NavigateTo(uri);
    }

    private async Task SaveConfigurationAsync()
    {
        if (configuration is null) return;
        savingConfiguration = true; configurationMessage = null;
        var result = await MetricsData.UpdateConfigurationAsync(configuration.ToCommand());
        configurationMessage = result.IsSuccess ? "Configuração salva e disponível para o coletor." : result.ErrorMessage;
        if (result.IsSuccess && result.Value is not null) configuration = MetricsConfigurationModel.From(result.Value);
        savingConfiguration = false;
    }

    private static string FormatNumber(long value) => value.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));
    private static string FormatCompact(long value) => value >= 1_000_000 ? $"{value / 1_000_000d:0.#} mi" : value >= 1_000 ? $"{value / 1_000d:0.#} mil" : value.ToString();
    private static string SuccessRate(ManagementMetricsOverview value) => value.TotalEvents == 0 ? "—" : $"{value.SuccessfulEvents * 100d / value.TotalEvents:0.#}%";
    private static int BarHeight(long count, IReadOnlyList<ManagementMetricsDailyPoint> points) => Math.Max(4, (int)Math.Round(count * 100d / Math.Max(1, points.Max(item => item.Count))));

    private sealed class MetricsConfigurationModel
    {
        public bool Enabled { get; set; }
        public bool ExportEnabled { get; set; }
        [Range(1, 3650)] public int RetentionDays { get; set; }
        public string Provider { get; set; } = "internal";
        public string? Endpoint { get; set; }
        public string? Database { get; set; }
        public string? AuthorizationScheme { get; set; }
        public string? Username { get; set; }
        public string? Secret { get; set; }
        public bool HasSecret { get; set; }
        public bool ClearSecret { get; set; }
        [Range(1, 120)] public int TimeoutSeconds { get; set; } = 10;
        [Range(1, 2000)] public int BatchSize { get; set; } = 250;
        public SaveManagementMetricsConfiguration ToCommand() => new(Enabled, RetentionDays, ExportEnabled, Provider, Endpoint, Database, AuthorizationScheme, Username, Secret, ClearSecret, TimeoutSeconds, BatchSize);
        public static MetricsConfigurationModel From(ManagementMetricsConfiguration value) => new() { Enabled = value.Enabled, RetentionDays = value.RetentionDays, ExportEnabled = value.ExportEnabled, Provider = value.Provider, Endpoint = value.Endpoint, Database = value.Database, AuthorizationScheme = value.AuthorizationScheme, Username = value.Username, HasSecret = value.HasSecret, TimeoutSeconds = value.TimeoutSeconds, BatchSize = value.BatchSize };
    }
}
