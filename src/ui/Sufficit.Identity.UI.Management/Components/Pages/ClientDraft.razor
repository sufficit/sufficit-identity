@page "/clients/drafts/{Id:guid}/{Step}"
@using Sufficit.Identity.Application.Security
@attribute [Authorize(Policy = ManagementUiPolicies.ManageClients)]
@implements IAsyncDisposable
@inject ManagementClientDataSource ClientData
@inject NavigationManager Navigation

<PageTitle>@L["Clients.Draft.PageTitle"] | Sufficit Identity</PageTitle>

@if (loading)
{
    <div class="wizard-loading" aria-busy="true" aria-label="@L["Clients.Draft.LoadingAriaLabel"].Value">
        <span class="button-spinner" aria-hidden="true"></span>
        <p>@L["Clients.Draft.RecoveringDraft"]</p>
    </div>
}
else if (draft is null)
{
    <div>
        <SUIPageHeader Title="@L["Clients.Draft.UnavailableTitle"].Value"
                    Description="@L["Clients.Draft.UnavailableDescription"].Value" />
    </div>
    <div>
        <SUIEmptyState Icon="alert" Title="@L["Clients.Draft.OpenErrorTitle"].Value" Description="@errorMessage">
            <Actions>
                <a class="button button--primary" href="clients/new">@L["Clients.Draft.StartNewApplication"]</a>
                <a class="button button--secondary" href="clients">@L["Clients.Create.Back"]</a>
            </Actions>
        </SUIEmptyState>
    </div>
}
else if (completion is not null)
{
    <div>
        <SUIPageHeader Title="@L["Clients.Draft.CreatedTitle"].Value"
                    Description="@L["Clients.Draft.CreatedDescription"].Value" />
    </div>
    <div class="completion-panel" aria-labelledby="completion-heading">
        <span class="completion-panel__icon"><SUIIcon Name="check" Size="26" /></span>
        <div>
            <h2 id="completion-heading">@completion.Client.DisplayName</h2>
            <p>Client ID: <code>@completion.Client.ClientId</code></p>
        </div>
        @if (!string.IsNullOrWhiteSpace(completion.OneTimeSecret))
        {
            <div class="one-time-secret" role="alert">
                <div>
                    <strong>@L["Clients.Draft.CopyCredentialTitle"]</strong>
                    <span>@L["Clients.Draft.CopyCredentialMessage"]</span>
                </div>
                <input id="generated-client-secret"
                       name="generated-client-secret"
                       class="form-control technical-value"
                       value="@completion.OneTimeSecret"
                       readonly
                       aria-label="@L["Clients.Draft.GeneratedCredentialAriaLabel"].Value" />
            </div>
        }
        <div class="wizard-actions wizard-actions--complete">
            <a class="button button--primary" href="@ClientHref(completion.Client.Id)">@L["Clients.Draft.OpenApplication"]</a>
            <a class="button button--secondary" href="clients">@L["Clients.Create.Back"]</a>
        </div>
    </div>
}
else
{
    <div>
    <SUIPageHeader Title="@L["Clients.Draft.PageTitle"].Value"
                Description="@L["Clients.Draft.WizardDescription"].Value">
        <Actions>
            <a class="button button--secondary" href="clients">@L["Clients.Draft.SaveAndExit"]</a>
        </Actions>
    </SUIPageHeader>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="inline-notice inline-notice--danger" role="alert">
            <SUIIcon Name="alert" Size="19" />
            <div><strong>@L["Clients.Draft.OperationErrorTitle"]</strong><span>@errorMessage</span></div>
        </div>
    }

    <div class="wizard-shell">
        <nav class="wizard-progress" aria-label="@L["Clients.Draft.StepsAriaLabel"].Value">
            <div class="wizard-progress__summary">
                <span>@L["Clients.Draft.StepProgress", CurrentStepIndex + 1, Steps.Length]</span>
                <strong>@CurrentStep.Label</strong>
            </div>
            <ol>
                @foreach (var step in Steps.Select((item, index) => (item, index)))
                {
                    <li class="@(step.index == CurrentStepIndex ? "is-current" : step.index < CurrentStepIndex ? "is-complete" : null)">
                        <button type="button"
                                aria-current="@(step.index == CurrentStepIndex ? "step" : null)"
                                @onclick="() => GoToStepAsync(step.item.Id)">
                            <span>@(step.index + 1)</span>
                            <strong>@step.item.ShortLabel</strong>
                        </button>
                    </li>
                }
            </ol>
            <div class="wizard-save-state" aria-live="polite">
                @if (saving)
                {
                    <span class="button-spinner" aria-hidden="true"></span>
                    <span>@L["Clients.Draft.Saving"]</span>
                }
                else if (savedAt is not null)
                {
                    <span class="wizard-save-state__icon"><SUIIcon Name="check" Size="15" /></span>
                    <span>@L["Clients.Draft.SavedAt", savedAt.Value.ToLocalTime().ToString("HH:mm")]</span>
                }
                else
                {
                    <span class="wizard-save-state__icon"><SUIIcon Name="lock" Size="15" /></span>
                    <span>@L["Clients.Draft.ProtectedDraft"]</span>
                }
            </div>
        </nav>

        <main class="wizard-stage" aria-labelledby="wizard-stage-heading">
            <header class="wizard-stage__heading">
                <span class="wizard-stage__eyebrow">@CurrentStep.Eyebrow</span>
                <h2 id="wizard-stage-heading">@CurrentStep.Label</h2>
                <p>@CurrentStep.Description</p>
            </header>

            @if (CurrentStep.Id == ManagementClientDraftSteps.Identity)
            {
                <div class="form-grid form-grid--two">
                    <div class="field-group">
                        <label for="client-display-name">@L["Clients.Draft.AppNameLabel"]</label>
                        <input id="client-display-name" name="displayName" class="form-control"
                               autocomplete="organization" value="@draft.Values.DisplayName"
                               @oninput="DisplayNameChangedAsync" />
                        <span class="field-hint">@L["Clients.Draft.AppNameHint"]</span>
                        @foreach (var issue in IssuesFor("displayName"))
                        {
                            <span class="field-feedback field-feedback--@IssueTone(issue)">@issue.Message</span>
                        }
                    </div>
                    <div class="field-group">
                        <label for="client-id">Client ID</label>
                        <input id="client-id" name="clientId" class="form-control technical-value"
                               autocomplete="off" spellcheck="false" value="@draft.Values.ClientId"
                               @oninput="ClientIdChangedAsync" />
                        <span class="field-hint">@L["Clients.Draft.ClientIdHintPrefix"] <code>portal_web</code>.</span>
                        @foreach (var issue in IssuesFor("clientId"))
                        {
                            <span class="field-feedback field-feedback--@IssueTone(issue)">@issue.Message</span>
                        }
                    </div>
                </div>
                <div class="profile-context">
                    <SUIIcon Name="shield" Size="21" />
                    <div><strong>@ProfileName</strong><span>@ProfileOutcome</span></div>
                </div>
            }
            else if (CurrentStep.Id == ManagementClientDraftSteps.Protocol)
            {
                <fieldset class="choice-fieldset">
                    <legend>@L["Clients.Draft.ClientTypeLegend"]</legend>
                    <div class="choice-grid choice-grid--two">
                        <label class="choice-control">
                            <input name="client-type" type="radio" value="public"
                                   checked="@(draft.Values.ClientType == "public")"
                                   @onchange='() => SetClientTypeAsync("public")' />
                            <span><strong>@L["Clients.Detail.TypePublic"]</strong><small>@L["Clients.Draft.PublicClientHint"]</small></span>
                        </label>
                        <label class="choice-control">
                            <input name="client-type" type="radio" value="confidential"
                                   checked="@(draft.Values.ClientType == "confidential")"
                                   @onchange='() => SetClientTypeAsync("confidential")' />
                            <span><strong>@L["Clients.Detail.TypeConfidential"]</strong><small>@L["Clients.Draft.ConfidentialClientHint"]</small></span>
                        </label>
                    </div>
                </fieldset>
                <fieldset class="choice-fieldset">
                    <legend>@L["Clients.Draft.GrantTypesLegend"]</legend>
                    <div class="choice-grid">
                        <label class="choice-control">
                            <input id="grant-authorization-code" name="grantTypes" type="checkbox" checked="@draft.Values.AuthorizationCode" @onchange="AuthorizationCodeChangedAsync" />
                            <span><strong>Authorization Code + PKCE</strong><small>@L["Clients.Draft.AuthCodeHint"]</small></span>
                        </label>
                        <label class="choice-control">
                            <input id="grant-refresh-token" name="grantTypes" type="checkbox" checked="@draft.Values.RefreshToken" @onchange="RefreshTokenChangedAsync" />
                            <span><strong>Refresh Token</strong><small>@L["Clients.Draft.RefreshTokenHint"]</small></span>
                        </label>
                        <label class="choice-control">
                            <input id="grant-client-credentials" name="grantTypes" type="checkbox" checked="@draft.Values.ClientCredentials" @onchange="ClientCredentialsChangedAsync" />
                            <span><strong>Client Credentials</strong><small>@L["Clients.Draft.ClientCredentialsHint"]</small></span>
                        </label>
                        <label class="choice-control">
                            <input id="grant-device-code" name="grantTypes" type="checkbox" checked="@draft.Values.DeviceCode" @onchange="DeviceCodeChangedAsync" />
                            <span><strong>Device Code</strong><small>@L["Clients.Draft.DeviceCodeHint"]</small></span>
                        </label>
                    </div>
                    @foreach (var issue in IssuesFor("grantTypes"))
                    {
                        <span class="field-feedback field-feedback--@IssueTone(issue)">@issue.Message</span>
                    }
                </fieldset>
                <div class="form-grid form-grid--two">
                    <div class="field-group">
                        <label for="consent-type">@L["Clients.Detail.ConsentLabel"]</label>
                        <select id="consent-type" name="consentType" class="form-control"
                                value="@draft.Values.ConsentType" @onchange="ConsentChangedAsync">
                            <option value="explicit">@L["Clients.Draft.ConsentExplicitOption"]</option>
                            <option value="implicit">@L["Clients.Draft.ConsentImplicitOption"]</option>
                            <option value="external">@L["Clients.Draft.ConsentExternalOption"]</option>
                            <option value="systematic">@L["Clients.Draft.ConsentSystematicOption"]</option>
                        </select>
                    </div>
                    <label class="choice-control choice-control--single">
                        <input id="require-par" name="requirePar" type="checkbox"
                               checked="@draft.Values.RequirePar" @onchange="RequireParChangedAsync" />
                        <span><strong>@L["Clients.Draft.RequireParLabel"]</strong><small>@L["Clients.Draft.RequireParHint"]</small></span>
                    </label>
                </div>
                <div class="field-group token-lifetime-editor">
                    <div class="field-group__heading">
                        <label>@L["Clients.Detail.TokenValidityHeading"]</label>
                        <span class="field-hint">@L["Clients.Draft.TokenLifetimeHint"]</span>
                    </div>
                    <div class="form-grid form-grid--three">
                        <div class="field-group">
                            <label for="draft-access-token-lifetime">@L["Clients.Draft.AccessTokenLifetimeLabel"]</label>
                            <input id="draft-access-token-lifetime" name="accessTokenLifetimeMinutes" type="number" min="1" max="@TokenLifetimeLimits.MaximumAccessTokenLifetimeMinutes" class="form-control" value="@draft.Values.AccessTokenLifetimeMinutes" @oninput="AccessTokenLifetimeChangedAsync" />
                        </div>
                        <div class="field-group">
                            <label for="draft-identity-token-lifetime">@L["Clients.Draft.IdTokenLifetimeLabel"]</label>
                            <input id="draft-identity-token-lifetime" name="identityTokenLifetimeMinutes" type="number" min="1" max="120" class="form-control" value="@draft.Values.IdentityTokenLifetimeMinutes" @oninput="IdentityTokenLifetimeChangedAsync" />
                        </div>
                        <div class="field-group">
                            <label for="draft-refresh-token-lifetime">@L["Clients.Draft.RefreshTokenLifetimeLabel"]</label>
                            <input id="draft-refresh-token-lifetime" name="refreshTokenLifetimeDays" type="number" min="1" max="365" class="form-control" value="@draft.Values.RefreshTokenLifetimeDays" @oninput="RefreshTokenLifetimeChangedAsync" />
                        </div>
                    </div>
                </div>
            }
            else if (CurrentStep.Id == ManagementClientDraftSteps.Permissions)
            {
                <label class="search-field scope-search">
                    <span class="visually-hidden">@L["Clients.Draft.SearchPermissionsLabel"]</span>
                    <SUIIcon Name="search" Size="18" />
                    <input id="scope-search" name="scopeSearch" type="search" placeholder="@L["Clients.Draft.SearchScopesPlaceholder"].Value"
                           autocomplete="off" @bind="scopeSearch" @bind:event="oninput" />
                </label>
                <div class="scope-picker">
                    @foreach (var scope in FilteredScopes)
                    {
                        <label class="scope-option">
                            <input name="selectedScopes" type="checkbox" value="@scope.Name"
                                   checked="@draft.Values.Scopes.Contains(scope.Name, StringComparer.Ordinal)"
                                   @onchange="args => ScopeChangedAsync(scope.Name, args)" />
                            <span><strong>@scope.DisplayName</strong><code>@scope.Name</code><small>@scope.Description</small></span>
                            @if (scope.IsProtocolScope)
                            {
                                <SUIStatusBadge ToneValue="SUITone.Neutral">@L["Clients.Draft.DefaultScopeBadge"]</SUIStatusBadge>
                            }
                        </label>
                    }
                </div>
                @foreach (var issue in IssuesFor("scopes"))
                {
                    <span class="field-feedback field-feedback--@IssueTone(issue)">@issue.Message</span>
                }
            }
            else if (CurrentStep.Id == ManagementClientDraftSteps.Uris)
            {
                <div class="uri-editor">
                    <div class="uri-editor__heading"><div><h3>Redirect URIs</h3><p>@L["Clients.Draft.RedirectUrisHint"]</p></div><button class="button button--secondary button--compact" type="button" @onclick="AddRedirectAsync"><SUIIcon Name="plus" Size="16" />@L["Clients.Draft.AddAction"]</button></div>
                    @if (draft.Values.RedirectUris.Count == 0)
                    {
                        <p class="uri-editor__empty">@L["Clients.Draft.NoUriAdded"]</p>
                    }
                    @foreach (var uri in draft.Values.RedirectUris.Select((value, index) => (value, index)))
                    {
                        <div class="uri-row">
                            <input id="redirect-uri-@uri.index" name="redirectUris" class="form-control technical-value"
                                   aria-label="Redirect URI @(uri.index + 1)" value="@uri.value"
                                   @oninput="args => RedirectChangedAsync(uri.index, args)" />
                            <button type="button" class="icon-button" aria-label="@L["Clients.Draft.RemoveRedirectUriAriaLabel", uri.index + 1].Value" @onclick="() => RemoveRedirectAsync(uri.index)"><SUIIcon Name="trash" Size="17" /></button>
                        </div>
                    }
                    @foreach (var issue in IssuesFor("redirectUris"))
                    {
                        <span class="field-feedback field-feedback--@IssueTone(issue)">@issue.Message</span>
                    }
                </div>
                <div class="uri-editor">
                    <div class="uri-editor__heading"><div><h3>Post logout redirect URIs</h3><p>@L["Clients.Draft.PostLogoutUrisHint"]</p></div><button class="button button--secondary button--compact" type="button" @onclick="AddLogoutRedirectAsync"><SUIIcon Name="plus" Size="16" />@L["Clients.Draft.AddAction"]</button></div>
                    @foreach (var uri in draft.Values.PostLogoutRedirectUris.Select((value, index) => (value, index)))
                    {
                        <div class="uri-row">
                            <input id="logout-redirect-uri-@uri.index" name="postLogoutRedirectUris" class="form-control technical-value"
                                   aria-label="Post logout redirect URI @(uri.index + 1)" value="@uri.value"
                                   @oninput="args => LogoutRedirectChangedAsync(uri.index, args)" />
                            <button type="button" class="icon-button" aria-label="@L["Clients.Draft.RemovePostLogoutUriAriaLabel", uri.index + 1].Value" @onclick="() => RemoveLogoutRedirectAsync(uri.index)"><SUIIcon Name="trash" Size="17" /></button>
                        </div>
                    }
                </div>
                <details class="advanced-disclosure">
                    <summary>@L["Clients.Draft.AdvancedLogoutSummary"]</summary>
                    <div class="form-grid form-grid--two">
                        <div class="field-group"><label for="frontchannel-uri">Front-channel logout URI</label><input id="frontchannel-uri" name="frontchannelLogoutUri" class="form-control technical-value" value="@draft.Values.FrontchannelLogoutUri" @oninput="FrontchannelChangedAsync" /></div>
                        <div class="field-group"><label for="backchannel-uri">Back-channel logout URI</label><input id="backchannel-uri" name="backchannelLogoutUri" class="form-control technical-value" value="@draft.Values.BackchannelLogoutUri" @oninput="BackchannelChangedAsync" /></div>
                    </div>
                    <div class="choice-grid choice-grid--two">
                        <label class="choice-control"><input name="frontchannelSessionRequired" type="checkbox" checked="@draft.Values.FrontchannelLogoutSessionRequired" @onchange="FrontchannelSessionChangedAsync" /><span><strong>@L["Clients.Draft.FrontchannelSessionLabel"]</strong><small>@L["Clients.Draft.SessionRequiredHint"]</small></span></label>
                        <label class="choice-control"><input name="backchannelSessionRequired" type="checkbox" checked="@draft.Values.BackchannelLogoutSessionRequired" @onchange="BackchannelSessionChangedAsync" /><span><strong>@L["Clients.Draft.BackchannelSessionLabel"]</strong><small>@L["Clients.Draft.SessionRequiredHint"]</small></span></label>
                    </div>
                </details>
            }
            else if (CurrentStep.Id == ManagementClientDraftSteps.Credentials)
            {
                <div class="credential-decision">
                    <span><SUIIcon Name="@(CreatesCredential ? "key" : "shield")" Size="26" /></span>
                    <div>
                        <h3>@(CreatesCredential ? L["Clients.Draft.CredentialWillBeGenerated"] : L["Clients.Draft.NoSecretNeeded"])</h3>
                        <p>@(CreatesCredential ? L["Clients.Draft.CredentialOneTimeHint"] : L["Clients.Draft.PublicClientNoSecretHint"])</p>
                    </div>
                </div>
                <ul class="security-checklist">
                    <li><SUIIcon Name="check" Size="17" /> @L["Clients.Draft.ChecklistProtectedConfig"]</li>
                    <li><SUIIcon Name="check" Size="17" /> @L["Clients.Draft.ChecklistRandomCredential"]</li>
                    <li><SUIIcon Name="check" Size="17" /> @L["Clients.Draft.ChecklistAuditNoSecret"]</li>
                </ul>
            }
            else
            {
                <div class="review-status review-status--@(draft.Validation.IsReady ? "ready" : "blocked")">
                    <SUIIcon Name="@(draft.Validation.IsReady ? "check" : "alert")" Size="22" />
                    <div><strong>@(draft.Validation.IsReady ? L["Clients.Draft.ReadyTitle"] : L["Clients.Draft.NotReadyTitle"])</strong><span>@(draft.Validation.IsReady ? L["Clients.Draft.ReadyMessage"] : L["Clients.Draft.NotReadyMessage"])</span></div>
                </div>
                @if (draft.Validation.Issues.Count > 0)
                {
                    <div class="review-issues">
                        @foreach (var issue in draft.Validation.Issues)
                        {
                            <button type="button" class="review-issue review-issue--@IssueTone(issue)" @onclick="() => GoToStepAsync(issue.Step)">
                                <SUIIcon Name="@(issue.Severity == ClientValidationSeverity.Error ? "alert" : "info")" Size="18" />
                                <span>
                                    <strong>@issue.Message</strong>
                                    @if (!string.IsNullOrWhiteSpace(issue.Remediation))
                                    {
                                        <small>@issue.Remediation</small>
                                    }
                                </span>
                                <SUIIcon Name="arrow-right" Size="16" />
                            </button>
                        }
                    </div>
                }
                <div class="review-grid">
                    <div><h3>@L["Clients.Draft.Step.Identity"]</h3><dl><div><dt>@L["Clients.Draft.NameLabel"]</dt><dd>@ValueOrDash(draft.Values.DisplayName)</dd></div><div><dt>Client ID</dt><dd><code>@ValueOrDash(draft.Values.ClientId)</code></dd></div><div><dt>@L["Clients.Detail.TypeLabel"]</dt><dd>@draft.Values.ClientType</dd></div></dl></div>
                    <div><h3>@L["Clients.Draft.Step.Protocol"]</h3><dl><div><dt>@L["Clients.Draft.FlowsLabel"]</dt><dd>@GrantSummary</dd></div><div><dt>@L["Clients.Detail.ConsentLabel"]</dt><dd>@draft.Values.ConsentType</dd></div><div><dt>PAR</dt><dd>@(draft.Values.RequirePar ? L["Clients.Draft.RequiredLabel"] : L["Clients.Draft.OptionalLabel"])</dd></div><div><dt>@L["Clients.Draft.TokensLabel"]</dt><dd>@TokenLifetimeSummary</dd></div></dl></div>
                    <div><h3>@L["Clients.Draft.Step.Permissions"]</h3><p>@(draft.Values.Scopes.Count == 0 ? L["Clients.Draft.NoScopeSelected"].Value : string.Join(", ", draft.Values.Scopes))</p></div>
                    <div><h3>@L["Clients.Draft.ReturnsHeading"]</h3><p>@L["Clients.Draft.ReturnsSummary", draft.Values.RedirectUris.Count, draft.Values.PostLogoutRedirectUris.Count]</p></div>
                </div>
            }

            <footer class="wizard-actions">
                <div>
                    @if (CurrentStepIndex > 0)
                    {
                        <button class="button button--secondary" type="button" disabled="@busy" @onclick="PreviousAsync"><SUIIcon Name="arrow-left" Size="17" />@L["Clients.Registrations.Previous"]</button>
                    }
                    else
                    {
                        <a class="button button--secondary" href="clients/new">@L["Clients.Draft.SwitchProfile"]</a>
                    }
                </div>
                <div>
                    @if (CurrentStepIndex < Steps.Length - 1)
                    {
                        <button class="button button--primary" type="button" disabled="@busy" @onclick="NextAsync">@L["Clients.Draft.Continue"]<SUIIcon Name="arrow-right" Size="17" /></button>
                    }
                    else
                    {
                        <button class="button button--primary" type="button" disabled="@(busy || !draft.Validation.IsReady)" @onclick="CompleteAsync">
                            @if (busy)
                            {
                                <span class="button-spinner" aria-hidden="true"></span>
                            }
                            <span>@L["Clients.Draft.CreateApplication"]</span>
                        </button>
                    }
                </div>
            </footer>

            <div class="abandon-zone">
                @if (confirmAbandon)
                {
                    <span>@L["Clients.Draft.ConfirmAbandonMessage"]</span>
                    <button class="button button--danger button--compact" type="button" disabled="@busy" @onclick="AbandonAsync">@L["Clients.Draft.ConfirmAbandonYes"]</button>
                    <button class="button button--secondary button--compact" type="button" @onclick="() => confirmAbandon = false">@L["Clients.Detail.Cancel"]</button>
                }
                else
                {
                    <button class="text-action text-action--danger" type="button" @onclick="() => confirmAbandon = true">@L["Clients.Draft.AbandonDraft"]</button>
                }
            </div>
        </main>
    </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public string Step { get; set; } = ManagementClientDraftSteps.Identity;

    private WizardStep[] Steps =>
    [
        new(ManagementClientDraftSteps.Identity, L["Clients.Draft.Step.Identity"].Value, L["Clients.Draft.Step.Identity"].Value, L["Clients.Draft.Eyebrow.Identity"].Value, L["Clients.Draft.StepDescription.Identity"].Value),
        new(ManagementClientDraftSteps.Protocol, L["Clients.Draft.Step.Protocol"].Value, L["Clients.Draft.Step.Protocol"].Value, L["Clients.Draft.Eyebrow.Protocol"].Value, L["Clients.Draft.StepDescription.Protocol"].Value),
        new(ManagementClientDraftSteps.Permissions, L["Clients.Draft.Step.Permissions"].Value, L["Clients.Draft.StepShort.Permissions"].Value, L["Clients.Draft.Eyebrow.Permissions"].Value, L["Clients.Draft.StepDescription.Permissions"].Value),
        new(ManagementClientDraftSteps.Uris, L["Clients.Draft.Step.UrisLogout"].Value, L["Clients.Draft.StepShort.Uris"].Value, L["Clients.Draft.Eyebrow.Uris"].Value, L["Clients.Draft.StepDescription.Uris"].Value),
        new(ManagementClientDraftSteps.Credentials, L["Clients.Draft.Step.Credentials"].Value, L["Clients.Draft.StepShort.Credentials"].Value, L["Clients.Draft.Eyebrow.Credentials"].Value, L["Clients.Draft.StepDescription.Credentials"].Value),
        new(ManagementClientDraftSteps.Review, L["Clients.Draft.Step.Review"].Value, L["Clients.Draft.Step.Review"].Value, L["Clients.Draft.Eyebrow.Review"].Value, L["Clients.Draft.StepDescription.Review"].Value),
    ];

    private ManagementClientDraftDetail? draft;
    private IReadOnlyList<ManagementClientProfile> profiles = [];
    private IReadOnlyList<ManagementClientAvailableScope> scopes = [];
    private CompleteManagementClientDraftResult? completion;
    private readonly SemaphoreSlim saveLock = new(1, 1);
    private CancellationTokenSource? saveDebounce;
    private bool loading = true;
    private bool saving;
    private bool busy;
    private bool confirmAbandon;
    private DateTimeOffset? savedAt;
    private string? errorMessage;
    private string scopeSearch = string.Empty;
    private Guid loadedId;

    private int CurrentStepIndex => Math.Max(0, Array.FindIndex(Steps, item => item.Id == NormalizeStep(Step)));
    private WizardStep CurrentStep => Steps[CurrentStepIndex];
    private ManagementClientProfile? Profile => profiles.FirstOrDefault(item => item.Id == draft?.Profile);
    private string ProfileName => Profile?.DisplayName ?? draft?.Profile ?? L["Clients.Draft.CustomConfigLabel"].Value;
    private string ProfileOutcome => Profile?.Outcome ?? L["Clients.Draft.ValidationPendingMessage"].Value;
    private bool CreatesCredential => draft?.Values.ClientType == "confidential";
    private IEnumerable<ManagementClientAvailableScope> FilteredScopes => string.IsNullOrWhiteSpace(scopeSearch)
        ? scopes
        : scopes.Where(item => item.Name.Contains(scopeSearch, StringComparison.OrdinalIgnoreCase)
            || item.DisplayName.Contains(scopeSearch, StringComparison.OrdinalIgnoreCase)
            || (item.Description?.Contains(scopeSearch, StringComparison.OrdinalIgnoreCase) ?? false));
    private string GrantSummary => draft is null ? "—" : string.Join(", ", new[]
    {
        draft.Values.AuthorizationCode ? "Authorization Code" : null,
        draft.Values.RefreshToken ? "Refresh Token" : null,
        draft.Values.ClientCredentials ? "Client Credentials" : null,
        draft.Values.DeviceCode ? "Device Code" : null,
    }.Where(value => value is not null));
    private string TokenLifetimeSummary => draft is null
        ? "—"
        : L["Clients.Draft.TokenSummaryFormat",
            draft.Values.AccessTokenLifetimeMinutes?.ToString() ?? L["Clients.Draft.GlobalDefaultShort"].Value,
            draft.Values.IdentityTokenLifetimeMinutes?.ToString() ?? L["Clients.Draft.GlobalDefaultShort"].Value,
            draft.Values.RefreshTokenLifetimeDays?.ToString() ?? L["Clients.Draft.GlobalDefaultShort"].Value].Value;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedId != Id || draft is null)
        {
            await LoadAsync();
            return;
        }
        var normalized = NormalizeStep(Step);
        if (!string.Equals(Step, normalized, StringComparison.Ordinal))
        {
            Navigation.NavigateTo(DraftHref(normalized), replace: true);
        }
    }

    private async Task LoadAsync()
    {
        loading = true;
        errorMessage = null;
        var draftTask = ClientData.GetClientDraftAsync(Id);
        var profilesTask = ClientData.GetClientProfilesAsync();
        var scopesTask = ClientData.GetAvailableClientScopesAsync();
        await Task.WhenAll(draftTask, profilesTask, scopesTask);
        var draftResult = await draftTask;
        draft = draftResult.Value;
        profiles = (await profilesTask).Value ?? [];
        scopes = (await scopesTask).Value ?? [];
        errorMessage = draftResult.IsSuccess ? null : draftResult.ErrorMessage ?? L["Clients.Draft.DraftNotFoundError"].Value;
        loadedId = Id;
        loading = false;
        if (draft is not null && !ManagementClientDraftSteps.All.Contains(Step, StringComparer.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(DraftHref(draft.CurrentStep), replace: true);
        }
    }

    private async Task DisplayNameChangedAsync(ChangeEventArgs args)
    {
        if (draft is null) return;
        var oldSlug = Slugify(draft.Values.DisplayName);
        draft.Values.DisplayName = args.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(draft.Values.ClientId) || draft.Values.ClientId == oldSlug)
        {
            draft.Values.ClientId = Slugify(draft.Values.DisplayName);
        }
        await QueueSaveAsync();
    }

    private async Task ClientIdChangedAsync(ChangeEventArgs args) { if (draft is null) return; draft.Values.ClientId = args.Value?.ToString() ?? string.Empty; await QueueSaveAsync(); }
    private async Task SetClientTypeAsync(string value) { if (draft is null) return; draft.Values.ClientType = value; await QueueSaveAsync(); }
    private async Task ConsentChangedAsync(ChangeEventArgs args) { if (draft is null) return; draft.Values.ConsentType = args.Value?.ToString() ?? "explicit"; await QueueSaveAsync(); }
    private async Task RequireParChangedAsync(ChangeEventArgs args) { if (draft is null) return; draft.Values.RequirePar = IsChecked(args); await QueueSaveAsync(); }
    private async Task AuthorizationCodeChangedAsync(ChangeEventArgs args) { if (draft is null) return; draft.Values.AuthorizationCode = IsChecked(args); await QueueSaveAsync(); }
    private async Task RefreshTokenChangedAsync(ChangeEventArgs args) { if (draft is null) return; draft.Values.RefreshToken = IsChecked(args); await QueueSaveAsync(); }
    private async Task ClientCredentialsChangedAsync(ChangeEventArgs args) { if (draft is null) return; draft.Values.ClientCredentials = IsChecked(args); await QueueSaveAsync(); }
    private async Task DeviceCodeChangedAsync(ChangeEventArgs args) { if (draft is null) return; draft.Values.DeviceCode = IsChecked(args); await QueueSaveAsync(); }
    private async Task AccessTokenLifetimeChangedAsync(ChangeEventArgs args) { if (draft is null) return; draft.Values.AccessTokenLifetimeMinutes = ParseOptionalInt(args); await QueueSaveAsync(); }
    private async Task IdentityTokenLifetimeChangedAsync(ChangeEventArgs args) { if (draft is null) return; draft.Values.IdentityTokenLifetimeMinutes = ParseOptionalInt(args); await QueueSaveAsync(); }
    private async Task RefreshTokenLifetimeChangedAsync(ChangeEventArgs args) { if (draft is null) return; draft.Values.RefreshTokenLifetimeDays = ParseOptionalInt(args); await QueueSaveAsync(); }
    private async Task ScopeChangedAsync(string scope, ChangeEventArgs args) { if (draft is null) return; if (IsChecked(args)) { if (!draft.Values.Scopes.Contains(scope, StringComparer.Ordinal)) draft.Values.Scopes.Add(scope); } else draft.Values.Scopes.Remove(scope); await QueueSaveAsync(); }
    private async Task AddRedirectAsync() { if (draft is null) return; draft.Values.RedirectUris.Add(string.Empty); await QueueSaveAsync(); }
    private async Task RemoveRedirectAsync(int index) { if (draft is null || index >= draft.Values.RedirectUris.Count) return; draft.Values.RedirectUris.RemoveAt(index); await QueueSaveAsync(); }
    private async Task RedirectChangedAsync(int index, ChangeEventArgs args) { if (draft is null || index >= draft.Values.RedirectUris.Count) return; draft.Values.RedirectUris[index] = args.Value?.ToString() ?? string.Empty; await QueueSaveAsync(); }
    private async Task AddLogoutRedirectAsync() { if (draft is null) return; draft.Values.PostLogoutRedirectUris.Add(string.Empty); await QueueSaveAsync(); }
    private async Task RemoveLogoutRedirectAsync(int index) { if (draft is null || index >= draft.Values.PostLogoutRedirectUris.Count) return; draft.Values.PostLogoutRedirectUris.RemoveAt(index); await QueueSaveAsync(); }
    private async Task LogoutRedirectChangedAsync(int index, ChangeEventArgs args) { if (draft is null || index >= draft.Values.PostLogoutRedirectUris.Count) return; draft.Values.PostLogoutRedirectUris[index] = args.Value?.ToString() ?? string.Empty; await QueueSaveAsync(); }
    private async Task FrontchannelChangedAsync(ChangeEventArgs args) { if (draft is null) return; draft.Values.FrontchannelLogoutUri = args.Value?.ToString(); await QueueSaveAsync(); }
    private async Task BackchannelChangedAsync(ChangeEventArgs args) { if (draft is null) return; draft.Values.BackchannelLogoutUri = args.Value?.ToString(); await QueueSaveAsync(); }
    private async Task FrontchannelSessionChangedAsync(ChangeEventArgs args) { if (draft is null) return; draft.Values.FrontchannelLogoutSessionRequired = IsChecked(args); await QueueSaveAsync(); }
    private async Task BackchannelSessionChangedAsync(ChangeEventArgs args) { if (draft is null) return; draft.Values.BackchannelLogoutSessionRequired = IsChecked(args); await QueueSaveAsync(); }

    private async Task QueueSaveAsync()
    {
        saveDebounce?.Cancel();
        saveDebounce?.Dispose();
        saveDebounce = new CancellationTokenSource();
        var token = saveDebounce.Token;
        try
        {
            await Task.Delay(650, token);
            await SaveAsync(CurrentStep.Id, token);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }

    private async Task<bool> SaveAsync(string step, CancellationToken cancellationToken = default)
    {
        if (draft is null) return false;
        await saveLock.WaitAsync(cancellationToken);
        try
        {
            saving = true;
            errorMessage = null;
            await InvokeAsync(StateHasChanged);
            var result = await ClientData.SaveClientDraftAsync(new(Id, draft.Version, step, draft.Values), cancellationToken);
            if (result.IsSuccess && result.Value is not null)
            {
                draft = result.Value;
                savedAt = result.Value.UpdatedAt;
                return true;
            }
            errorMessage = result.ErrorMessage ?? L["Clients.Draft.SaveFailedError"].Value;
            return false;
        }
        finally
        {
            saving = false;
            saveLock.Release();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task GoToStepAsync(string step)
    {
        saveDebounce?.Cancel();
        if (await SaveAsync(step)) Navigation.NavigateTo(DraftHref(step));
    }
    private Task PreviousAsync() => GoToStepAsync(Steps[Math.Max(0, CurrentStepIndex - 1)].Id);
    private Task NextAsync() => GoToStepAsync(Steps[Math.Min(Steps.Length - 1, CurrentStepIndex + 1)].Id);

    private async Task CompleteAsync()
    {
        if (draft is null || busy) return;
        busy = true;
        saveDebounce?.Cancel();
        if (await SaveAsync(ManagementClientDraftSteps.Review))
        {
            var result = await ClientData.CompleteClientDraftAsync(Id, draft.Version);
            if (result.IsSuccess) completion = result.Value;
            else errorMessage = result.ErrorMessage ?? L["Clients.Draft.CreateFailedError"].Value;
        }
        busy = false;
    }

    private async Task AbandonAsync()
    {
        if (busy) return;
        busy = true;
        var result = await ClientData.AbandonClientDraftAsync(Id);
        if (result.IsSuccess) Navigation.NavigateTo("clients?draftDeleted=1");
        else errorMessage = result.ErrorMessage ?? L["Clients.Draft.AbandonFailedError"].Value;
        busy = false;
    }

    private IEnumerable<ClientValidationIssue> IssuesFor(string field) => draft?.Validation.Issues.Where(issue => issue.Field == field) ?? [];
    private string DraftHref(string step) => $"clients/drafts/{Id:D}/{step}";
    private static string ClientHref(string id) => $"clients/{Uri.EscapeDataString(id)}?created=1";
    private static string NormalizeStep(string? step) => ManagementClientDraftSteps.All.FirstOrDefault(item => string.Equals(item, step, StringComparison.OrdinalIgnoreCase)) ?? ManagementClientDraftSteps.Identity;
    private static string IssueTone(ClientValidationIssue issue) => issue.Severity == ClientValidationSeverity.Error ? "danger" : "warning";
    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static bool IsChecked(ChangeEventArgs args) => args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
    private static int? ParseOptionalInt(ChangeEventArgs args) => int.TryParse(args.Value?.ToString(), out var value) ? value : null;
    private static string Slugify(string? value) => string.Join("-", (value ?? string.Empty).Trim().ToLowerInvariant().Split(' ', StringSplitOptions.RemoveEmptyEntries)).Where(character => char.IsLetterOrDigit(character) || character is '-' or '_' or '.').Aggregate(string.Empty, (current, character) => current + character).Trim('-');

    public async ValueTask DisposeAsync()
    {
        saveDebounce?.Cancel();
        saveDebounce?.Dispose();
        saveLock.Dispose();
        await Task.CompletedTask;
    }

    private sealed record WizardStep(string Id, string Label, string ShortLabel, string Eyebrow, string Description);
}
