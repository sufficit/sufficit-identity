@page "/clients/drafts/{Id:guid}/{Step}"
@using Sufficit.Identity.Application.Security
@attribute [Authorize(Policy = ManagementUiPolicies.ManageClients)]
@implements IAsyncDisposable
@inject ManagementClientDataSource ClientData
@inject NavigationManager Navigation
@inject ISUIDialogService Dialogs

<PageTitle>@L["Clients.Draft.PageTitle"] | Sufficit Identity</PageTitle>

@if (!loading && draftResult?.IsSuccess is false)
{
    <div>
        <SUIPageHeader Title="@L["Clients.Draft.UnavailableTitle"].Value"
                    Description="@L["Clients.Draft.UnavailableDescription"].Value" />
    </div>
}

<ManagementDataView Result="draftResult"
                    Loading="loading"
                    OnRetry="LoadAsync"
                    NotFoundTitle="@L["Clients.Draft.OpenErrorTitle"].Value"
                    UnavailableTitle="@L["Clients.Draft.OpenErrorTitle"].Value">
    <LoadingContent>
        <div class="wizard-loading" aria-label="@L["Clients.Draft.LoadingAriaLabel"].Value">
            <SUIProgressCircular Indeterminate="true" AriaLabel="@L["Clients.Draft.LoadingAriaLabel"].Value" />
            <p>@L["Clients.Draft.RecoveringDraft"]</p>
        </div>
    </LoadingContent>
    <FailureActions>
        <SUIButton Href="clients/new" ColorValue="SUIColor.Primary">@L["Clients.Draft.StartNewApplication"]</SUIButton>
        <SUIButton Href="clients" VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default">@L["Clients.Create.Back"]</SUIButton>
    </FailureActions>
    <Success Context="_">
@if (completion is not null)
{
    <div>
        <SUIPageHeader Title="@L["Clients.Draft.CreatedTitle"].Value"
                    Description="@L["Clients.Draft.CreatedDescription"].Value" />
    </div>
    <div class="completion-panel" aria-labelledby="completion-heading">
        <span class="completion-panel__icon"><SUIIcon Name="check" Size="26" /></span>
        <div>
            <h2 id="completion-heading">@completion.Client.DisplayName</h2>
            <p>Client ID: <code>@completion.Client.ClientId</code></p>
        </div>
        <SUIStack Row="true" Wrap="true" Spacing="2">
            <SUIButton Href="@ClientHref(completion.Client.Id)" ColorValue="SUIColor.Primary">@L["Clients.Draft.OpenApplication"]</SUIButton>
            <SUIButton Href="clients" VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default">@L["Clients.Create.Back"]</SUIButton>
        </SUIStack>
    </div>
}
else
{
    <div>
    <SUIPageHeader Title="@L["Clients.Draft.PageTitle"].Value"
                Description="@L["Clients.Draft.WizardDescription"].Value">
        <Actions>
            <SUIButton Href="clients" VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default">@L["Clients.Draft.SaveAndExit"]</SUIButton>
        </Actions>
    </SUIPageHeader>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <SUIAlert ToneValue="SUITone.Danger" Icon="alert">
            <div><strong>@L["Clients.Draft.OperationErrorTitle"]</strong> <span>@errorMessage</span></div>
        </SUIAlert>
    }

    <div class="wizard-shell">
        <div class="draft-progress">
            <div class="wizard-progress__summary">
                <span>@L["Clients.Draft.StepProgress", CurrentStepIndex + 1, Steps.Length]</span>
                <strong>@CurrentStep.Label</strong>
            </div>
            <SUIProgressSteps Steps="StepLabels"
                              ActiveIndex="CurrentStepIndex"
                              MaxReachableIndex="@(Steps.Length - 1)"
                              ActiveIndexChanged="StepSelectedAsync"
                              AriaLabel="@L["Clients.Draft.StepsAriaLabel"].Value"
                              CompletedStatusLabel="@L["Clients.Draft.StepStatus.Completed"].Value"
                              CurrentStatusLabel="@L["Clients.Draft.StepStatus.Current"].Value"
                              PendingStatusLabel="@L["Clients.Draft.StepStatus.Pending"].Value"
                              StepPositionLabel="@((position, total) => L["Clients.Draft.StepProgress", position, total].Value)" />
            <div class="wizard-save-state" aria-live="polite">
                @if (saving)
                {
                    <SUIProgressCircular Indeterminate="true" SizeValue="SUISize.Small" />
                    <span>@L["Clients.Draft.Saving"]</span>
                }
                else if (savedAt is not null)
                {
                    <span class="wizard-save-state__icon"><SUIIcon Name="check" Size="15" /></span>
                    <span>@L["Clients.Draft.SavedAt", Time.Format(savedAt.Value, TimeStyle.Time)]</span>
                }
                else
                {
                    <span class="wizard-save-state__icon"><SUIIcon Name="lock" Size="15" /></span>
                    <span>@L["Clients.Draft.ProtectedDraft"]</span>
                }
            </div>
        </div>

        <main class="wizard-stage" aria-labelledby="wizard-stage-heading">
            <header class="wizard-stage__heading">
                <span class="wizard-stage__eyebrow">@CurrentStep.Eyebrow</span>
                <h2 id="wizard-stage-heading">@CurrentStep.Label</h2>
                <p>@CurrentStep.Description</p>
            </header>

            @if (CurrentStep.Id == ManagementClientDraftSteps.Identity)
            {
                <SUIFormGrid Columns="2">
                    <IdentityTextField T="string"
                                       Id="client-display-name"
                                       Name="displayName"
                                       Label="@L["Clients.Draft.AppNameLabel"].Value"
                                       HelperText="@L["Clients.Draft.AppNameHint"].Value"
                                       WarningText="@FieldWarnings("displayName")"
                                       ErrorText="@FieldErrors("displayName")"
                                       Immediate="true"
                                       Value="@draft!.Values.DisplayName"
                                       ValueChanged="DisplayNameChangedAsync"
                                       autocomplete="organization" />
                    <IdentityTextField T="string"
                                       Id="client-id"
                                       Name="clientId"
                                       Label="Client ID"
                                       WarningText="@FieldWarnings("clientId")"
                                       ErrorText="@FieldErrors("clientId")"
                                       Monospace="true"
                                       Immediate="true"
                                       Value="@draft.Values.ClientId"
                                       ValueChanged="ClientIdChangedAsync"
                                       autocomplete="off">
                        <HelperContent>@L["Clients.Draft.ClientIdHintPrefix"] <code>portal_web</code></HelperContent>
                    </IdentityTextField>
                </SUIFormGrid>
                <div class="profile-context">
                    <SUIIcon Name="shield" Size="21" />
                    <div><strong>@ProfileName</strong><span>@ProfileOutcome</span></div>
                </div>
            }
            else if (CurrentStep.Id == ManagementClientDraftSteps.Protocol)
            {
                @* Fieldsets and grids carry no outer margin: the stack spaces the groups. *@
                <SUIStack Spacing="5">
                    <fieldset class="choice-fieldset">
                        <legend>@L["Clients.Draft.ClientTypeLegend"]</legend>
                        <SUIFormGrid Columns="2">
                            <SUIChoiceCard TValue="string"
                                           Name="client-type"
                                           Value="@("public")"
                                           SelectedValue="@draft!.Values.ClientType"
                                           SelectedValueChanged="SetClientTypeAsync"
                                           Title="@L["Clients.Detail.TypePublic"].Value"
                                           Description="@L["Clients.Draft.PublicClientHint"].Value" />
                            <SUIChoiceCard TValue="string"
                                           Name="client-type"
                                           Value="@("confidential")"
                                           SelectedValue="@draft.Values.ClientType"
                                           SelectedValueChanged="SetClientTypeAsync"
                                           Title="@L["Clients.Detail.TypeConfidential"].Value"
                                           Description="@L["Clients.Draft.ConfidentialClientHint"].Value" />
                        </SUIFormGrid>
                    </fieldset>
                    <fieldset class="choice-fieldset">
                        <legend>@L["Clients.Draft.GrantTypesLegend"]</legend>
                        <SUIFormGrid Columns="2">
                            <SUICheckbox Id="grant-authorization-code" Name="grantTypes" FormValue="authorization_code"
                                         Label="Authorization Code + PKCE" HelperText="@L["Clients.Draft.AuthCodeHint"].Value"
                                         Value="@draft!.Values.AuthorizationCode" ValueChanged="AuthorizationCodeChangedAsync" />
                            <SUICheckbox Id="grant-refresh-token" Name="grantTypes" FormValue="refresh_token"
                                         Label="Refresh Token" HelperText="@L["Clients.Draft.RefreshTokenHint"].Value"
                                         Value="@draft.Values.RefreshToken" ValueChanged="RefreshTokenChangedAsync" />
                            <SUICheckbox Id="grant-client-credentials" Name="grantTypes" FormValue="client_credentials"
                                         Label="Client Credentials" HelperText="@L["Clients.Draft.ClientCredentialsHint"].Value"
                                         Value="@draft.Values.ClientCredentials" ValueChanged="ClientCredentialsChangedAsync" />
                            <SUICheckbox Id="grant-device-code" Name="grantTypes" FormValue="device_code"
                                         Label="Device Code" HelperText="@L["Clients.Draft.DeviceCodeHint"].Value"
                                         Value="@draft.Values.DeviceCode" ValueChanged="DeviceCodeChangedAsync" />
                        </SUIFormGrid>
                        @foreach (var issue in IssuesFor("grantTypes"))
                        {
                            <SUIAlert ToneValue="@IssueTone(issue)">@issue.Message</SUIAlert>
                        }
                    </fieldset>
                    <SUIFormGrid Columns="2">
                        <IdentitySelect T="string"
                                        Id="consent-type"
                                        Name="consentType"
                                        Label="@L["Clients.Detail.ConsentLabel"].Value"
                                        Value="@draft!.Values.ConsentType"
                                        ValueChanged="ConsentChangedAsync">
                            <SUISelectItem Value="@("explicit")">@L["Clients.Draft.ConsentExplicitOption"]</SUISelectItem>
                            <SUISelectItem Value="@("implicit")">@L["Clients.Draft.ConsentImplicitOption"]</SUISelectItem>
                            <SUISelectItem Value="@("external")">@L["Clients.Draft.ConsentExternalOption"]</SUISelectItem>
                            <SUISelectItem Value="@("systematic")">@L["Clients.Draft.ConsentSystematicOption"]</SUISelectItem>
                        </IdentitySelect>
                        <SUISwitch Id="require-par" Name="requirePar"
                                   Label="@L["Clients.Draft.RequireParLabel"].Value" HelperText="@L["Clients.Draft.RequireParHint"].Value"
                                   Value="@draft.Values.RequirePar" ValueChanged="RequireParChangedAsync" />
                    </SUIFormGrid>
                    <fieldset class="choice-fieldset">
                        <legend>@L["Clients.Detail.TokenValidityHeading"]</legend>
                        <span class="field-hint">@L["Clients.Draft.TokenLifetimeHint"]</span>
                        <SUIFormGrid Columns="3">
                            <IdentityNumericField T="int?"
                                                  Id="draft-access-token-lifetime"
                                                  Name="accessTokenLifetimeMinutes"
                                                  Label="@L["Clients.Draft.AccessTokenLifetimeLabel"].Value"
                                                  Suffix="@L["Clients.Draft.UnitMinutes"].Value"
                                                  Optional="true"
                                                  OptionalText="@L["Clients.Draft.OptionalMarker"].Value"
                                                  Min="1"
                                                  Max="@TokenLifetimeLimits.MaximumAccessTokenLifetimeMinutes"
                                                  Immediate="true"
                                                  Value="@draft!.Values.AccessTokenLifetimeMinutes"
                                                  ValueChanged="AccessTokenLifetimeChangedAsync" />
                            <IdentityNumericField T="int?"
                                                  Id="draft-identity-token-lifetime"
                                                  Name="identityTokenLifetimeMinutes"
                                                  Label="@L["Clients.Draft.IdTokenLifetimeLabel"].Value"
                                                  Suffix="@L["Clients.Draft.UnitMinutes"].Value"
                                                  Optional="true"
                                                  OptionalText="@L["Clients.Draft.OptionalMarker"].Value"
                                                  Min="1"
                                                  Max="120"
                                                  Immediate="true"
                                                  Value="@draft.Values.IdentityTokenLifetimeMinutes"
                                                  ValueChanged="IdentityTokenLifetimeChangedAsync" />
                            <IdentityNumericField T="int?"
                                                  Id="draft-refresh-token-lifetime"
                                                  Name="refreshTokenLifetimeDays"
                                                  Label="@L["Clients.Draft.RefreshTokenLifetimeLabel"].Value"
                                                  Suffix="@L["Clients.Draft.UnitDays"].Value"
                                                  Optional="true"
                                                  OptionalText="@L["Clients.Draft.OptionalMarker"].Value"
                                                  Min="1"
                                                  Max="365"
                                                  Immediate="true"
                                                  Value="@draft.Values.RefreshTokenLifetimeDays"
                                                  ValueChanged="RefreshTokenLifetimeChangedAsync" />
                        </SUIFormGrid>
                    </fieldset>
                </SUIStack>
            }
            else if (CurrentStep.Id == ManagementClientDraftSteps.Permissions)
            {
                <SUIStack Spacing="2">
                    <IdentityTextField T="string"
                                       Id="scope-search"
                                       Name="scopeSearch"
                                       InputType="search"
                                       AdornmentIcon="search"
                                       Placeholder="@L["Clients.Draft.SearchScopesPlaceholder"].Value"
                                       Immediate="true"
                                       Value="@scopeSearch"
                                       ValueChanged="@((string? value) => scopeSearch = value ?? string.Empty)"
                                       aria-label="@L["Clients.Draft.SearchPermissionsLabel"].Value"
                                       autocomplete="off" />
                    @foreach (var scope in FilteredScopes)
                    {
                        <SUIStack Row="true" AlignItems="Center" Justify="Between" Spacing="3" @key="scope.Name">
                            <SUICheckbox Name="selectedScopes"
                                         FormValue="@scope.Name"
                                         Label="@scope.DisplayName"
                                         Value="@draft!.Values.Scopes.Contains(scope.Name, StringComparer.Ordinal)"
                                         ValueChanged="value => ScopeChangedAsync(scope.Name, value)">
                                <HelperContent><code>@scope.Name</code>@(string.IsNullOrWhiteSpace(scope.Description) ? null : $" — {scope.Description}")</HelperContent>
                            </SUICheckbox>
                            @if (scope.IsProtocolScope)
                            {
                                <SUIStatusBadge ToneValue="SUITone.Neutral">@L["Clients.Draft.DefaultScopeBadge"]</SUIStatusBadge>
                            }
                        </SUIStack>
                    }
                    @foreach (var issue in IssuesFor("scopes"))
                    {
                        <SUIAlert ToneValue="@IssueTone(issue)">@issue.Message</SUIAlert>
                    }
                </SUIStack>
            }
            else if (CurrentStep.Id == ManagementClientDraftSteps.Uris)
            {
                <div class="uri-editor">
                    <SUIStack Spacing="2">
                        <SUIStack Row="true" AlignItems="Start" Justify="Between" Spacing="3">
                            <div><h3>Redirect URIs</h3><p>@L["Clients.Draft.RedirectUrisHint"]</p></div>
                            <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" SizeValue="SUISize.Small" StartIcon="plus" OnClick="AddRedirectAsync">@L["Clients.Draft.AddAction"]</SUIButton>
                        </SUIStack>
                        @if (draft!.Values.RedirectUris.Count == 0)
                        {
                            <p>@L["Clients.Draft.NoUriAdded"]</p>
                        }
                        @foreach (var uri in draft.Values.RedirectUris.Select((value, index) => (value, index)))
                        {
                            <SUIStack Row="true" AlignItems="Center" Spacing="2">
                                <IdentityTextField T="string"
                                                   Id="@($"redirect-uri-{uri.index}")"
                                                   Name="redirectUris"
                                                   Class="uri-editor__field"
                                                   Monospace="true"
                                                   Immediate="true"
                                                   Value="@uri.value"
                                                   ValueChanged="value => RedirectChangedAsync(uri.index, value)"
                                                   aria-label="@($"Redirect URI {uri.index + 1}")" />
                                <SUIIconButton Icon="trash"
                                               Title="@L["Clients.Draft.RemoveRedirectUriAriaLabel", uri.index + 1].Value"
                                               VariantValue="SUIVariant.Outlined"
                                               ColorValue="SUIColor.Error"
                                               OnClick="() => RemoveRedirectAsync(uri.index)" />
                            </SUIStack>
                        }
                        @foreach (var issue in IssuesFor("redirectUris"))
                        {
                            <SUIAlert ToneValue="@IssueTone(issue)">@issue.Message</SUIAlert>
                        }
                    </SUIStack>
                </div>
                <div class="uri-editor">
                    <SUIStack Spacing="2">
                        <SUIStack Row="true" AlignItems="Start" Justify="Between" Spacing="3">
                            <div><h3>Post logout redirect URIs</h3><p>@L["Clients.Draft.PostLogoutUrisHint"]</p></div>
                            <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" SizeValue="SUISize.Small" StartIcon="plus" OnClick="AddLogoutRedirectAsync">@L["Clients.Draft.AddAction"]</SUIButton>
                        </SUIStack>
                        @foreach (var uri in draft!.Values.PostLogoutRedirectUris.Select((value, index) => (value, index)))
                        {
                            <SUIStack Row="true" AlignItems="Center" Spacing="2">
                                <IdentityTextField T="string"
                                                   Id="@($"logout-redirect-uri-{uri.index}")"
                                                   Name="postLogoutRedirectUris"
                                                   Class="uri-editor__field"
                                                   Monospace="true"
                                                   Immediate="true"
                                                   Value="@uri.value"
                                                   ValueChanged="value => LogoutRedirectChangedAsync(uri.index, value)"
                                                   aria-label="@($"Post logout redirect URI {uri.index + 1}")" />
                                <SUIIconButton Icon="trash"
                                               Title="@L["Clients.Draft.RemovePostLogoutUriAriaLabel", uri.index + 1].Value"
                                               VariantValue="SUIVariant.Outlined"
                                               ColorValue="SUIColor.Error"
                                               OnClick="() => RemoveLogoutRedirectAsync(uri.index)" />
                            </SUIStack>
                        }
                    </SUIStack>
                </div>
                <SUIExpansionPanel Title="@L["Clients.Draft.AdvancedLogoutSummary"].Value" Class="advanced-disclosure">
                    <SUIStack Spacing="4">
                        <SUIFormGrid Columns="2">
                            <IdentityTextField T="string" Id="frontchannel-uri" Name="frontchannelLogoutUri"
                                               Label="Front-channel logout URI" Monospace="true" Immediate="true"
                                               Value="@draft!.Values.FrontchannelLogoutUri" ValueChanged="FrontchannelChangedAsync" />
                            <IdentityTextField T="string" Id="backchannel-uri" Name="backchannelLogoutUri"
                                               Label="Back-channel logout URI" Monospace="true" Immediate="true"
                                               Value="@draft.Values.BackchannelLogoutUri" ValueChanged="BackchannelChangedAsync" />
                        </SUIFormGrid>
                        <SUIFormGrid Columns="2">
                            <SUISwitch Name="frontchannelSessionRequired"
                                       Label="@L["Clients.Draft.FrontchannelSessionLabel"].Value" HelperText="@L["Clients.Draft.SessionRequiredHint"].Value"
                                       Value="@draft!.Values.FrontchannelLogoutSessionRequired" ValueChanged="FrontchannelSessionChangedAsync" />
                            <SUISwitch Name="backchannelSessionRequired"
                                       Label="@L["Clients.Draft.BackchannelSessionLabel"].Value" HelperText="@L["Clients.Draft.SessionRequiredHint"].Value"
                                       Value="@draft.Values.BackchannelLogoutSessionRequired" ValueChanged="BackchannelSessionChangedAsync" />
                        </SUIFormGrid>
                    </SUIStack>
                </SUIExpansionPanel>
            }
            else if (CurrentStep.Id == ManagementClientDraftSteps.Credentials)
            {
                <div class="credential-decision">
                    <span><SUIIcon Name="@(CreatesCredential ? "key" : "shield")" Size="26" /></span>
                    <div>
                        <h3>@(CreatesCredential ? L["Clients.Draft.CredentialWillBeGenerated"] : L["Clients.Draft.NoSecretNeeded"])</h3>
                        <p>@(CreatesCredential ? L["Clients.Draft.CredentialOneTimeHint"] : L["Clients.Draft.PublicClientNoSecretHint"])</p>
                    </div>
                </div>
                <ul class="security-checklist">
                    <li><SUIIcon Name="check" Size="17" /> @L["Clients.Draft.ChecklistProtectedConfig"]</li>
                    <li><SUIIcon Name="check" Size="17" /> @L["Clients.Draft.ChecklistRandomCredential"]</li>
                    <li><SUIIcon Name="check" Size="17" /> @L["Clients.Draft.ChecklistAuditNoSecret"]</li>
                </ul>
            }
            else
            {
                <SUIStack Spacing="2">
                    <SUIAlert ToneValue="@(draft!.Validation.IsReady ? SUITone.Success : SUITone.Warning)"
                              Icon="@(draft.Validation.IsReady ? "check" : "alert")">
                        <div><strong>@(draft.Validation.IsReady ? L["Clients.Draft.ReadyTitle"] : L["Clients.Draft.NotReadyTitle"])</strong> <span>@(draft.Validation.IsReady ? L["Clients.Draft.ReadyMessage"] : L["Clients.Draft.NotReadyMessage"])</span></div>
                    </SUIAlert>
                    @foreach (var issue in draft.Validation.Issues)
                    {
                        <SUIButton VariantValue="SUIVariant.Outlined"
                                   ColorValue="SUIColor.Default"
                                   IconColorValue="@(issue.Severity == ClientValidationSeverity.Error ? SUIColor.Error : SUIColor.Warning)"
                                   StartIcon="@(issue.Severity == ClientValidationSeverity.Error ? "alert" : "info")"
                                   EndIcon="arrow-right"
                                   FullWidth="true"
                                   Style="justify-content:space-between;text-align:start"
                                   OnClick="() => GoToStepAsync(issue.Step)">
                            <strong>@issue.Message</strong>
                            @if (!string.IsNullOrWhiteSpace(issue.Remediation))
                            {
                                <small>@issue.Remediation</small>
                            }
                        </SUIButton>
                    }
                </SUIStack>
                <div class="review-grid">
                    <div><h3>@L["Clients.Draft.Step.Identity"]</h3><dl><div><dt>@L["Clients.Draft.NameLabel"]</dt><dd>@ValueOrDash(draft!.Values.DisplayName)</dd></div><div><dt>Client ID</dt><dd><code>@ValueOrDash(draft.Values.ClientId)</code></dd></div><div><dt>@L["Clients.Detail.TypeLabel"]</dt><dd>@draft.Values.ClientType</dd></div></dl></div>
                    <div><h3>@L["Clients.Draft.Step.Protocol"]</h3><dl><div><dt>@L["Clients.Draft.FlowsLabel"]</dt><dd>@GrantSummary</dd></div><div><dt>@L["Clients.Detail.ConsentLabel"]</dt><dd>@draft.Values.ConsentType</dd></div><div><dt>PAR</dt><dd>@(draft.Values.RequirePar ? L["Clients.Draft.RequiredLabel"] : L["Clients.Draft.OptionalLabel"])</dd></div><div><dt>@L["Clients.Draft.TokensLabel"]</dt><dd>@TokenLifetimeSummary</dd></div></dl></div>
                    <div><h3>@L["Clients.Draft.Step.Permissions"]</h3><p>@(draft.Values.Scopes.Count == 0 ? L["Clients.Draft.NoScopeSelected"].Value : string.Join(", ", draft.Values.Scopes))</p></div>
                    <div><h3>@L["Clients.Draft.ReturnsHeading"]</h3><p>@L["Clients.Draft.ReturnsSummary", draft.Values.RedirectUris.Count, draft.Values.PostLogoutRedirectUris.Count]</p></div>
                </div>
            }

            <footer class="wizard-actions">
                @if (CurrentStepIndex > 0)
                {
                    <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" StartIcon="arrow-left" Disabled="@busy" OnClick="PreviousAsync">@L["Clients.Registrations.Previous"]</SUIButton>
                }
                else
                {
                    <SUIButton Href="clients/new" VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default">@L["Clients.Draft.SwitchProfile"]</SUIButton>
                }
                @if (CurrentStepIndex < Steps.Length - 1)
                {
                    <SUIButton ColorValue="SUIColor.Primary" EndIcon="arrow-right" Disabled="@busy" OnClick="NextAsync">@L["Clients.Draft.Continue"]</SUIButton>
                }
                else
                {
                    <SUILoadingButton ColorValue="SUIColor.Primary"
                                      IsLoading="@busy"
                                      Disabled="@(busy || !draft!.Validation.IsReady)"
                                      OnClick="CompleteAsync"
                                      aria-busy="@busy">
                        @L["Clients.Draft.CreateApplication"]
                    </SUILoadingButton>
                }
            </footer>

            <SUIStack Row="true" Wrap="true" AlignItems="Center" Justify="Center" Spacing="2" Class="abandon-zone">
                @if (confirmAbandon)
                {
                    <span>@L["Clients.Draft.ConfirmAbandonMessage"]</span>
                    <SUIButton ColorValue="SUIColor.Error" SizeValue="SUISize.Small" Disabled="@busy" OnClick="AbandonAsync">@L["Clients.Draft.ConfirmAbandonYes"]</SUIButton>
                    <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default" SizeValue="SUISize.Small" OnClick="() => confirmAbandon = false">@L["Clients.Detail.Cancel"]</SUIButton>
                }
                else
                {
                    <SUIButton VariantValue="SUIVariant.Text" ColorValue="SUIColor.Error" SizeValue="SUISize.Small" OnClick="() => confirmAbandon = true">@L["Clients.Draft.AbandonDraft"]</SUIButton>
                }
            </SUIStack>
        </main>
    </div>
    </div>
}
    </Success>
</ManagementDataView>

@code {
    // The reader's zone once the browser answers (BrowserTimeProvider in the layout).
    [CascadingParameter]
    private BrowserTime Time { get; set; } = BrowserTime.Server;

    [Parameter] public Guid Id { get; set; }
    [Parameter] public string Step { get; set; } = ManagementClientDraftSteps.Identity;

    private WizardStep[] Steps =>
    [
        new(ManagementClientDraftSteps.Identity, L["Clients.Draft.Step.Identity"].Value, L["Clients.Draft.Step.Identity"].Value, L["Clients.Draft.Eyebrow.Identity"].Value, L["Clients.Draft.StepDescription.Identity"].Value),
        new(ManagementClientDraftSteps.Protocol, L["Clients.Draft.Step.Protocol"].Value, L["Clients.Draft.Step.Protocol"].Value, L["Clients.Draft.Eyebrow.Protocol"].Value, L["Clients.Draft.StepDescription.Protocol"].Value),
        new(ManagementClientDraftSteps.Permissions, L["Clients.Draft.Step.Permissions"].Value, L["Clients.Draft.StepShort.Permissions"].Value, L["Clients.Draft.Eyebrow.Permissions"].Value, L["Clients.Draft.StepDescription.Permissions"].Value),
        new(ManagementClientDraftSteps.Uris, L["Clients.Draft.Step.UrisLogout"].Value, L["Clients.Draft.StepShort.Uris"].Value, L["Clients.Draft.Eyebrow.Uris"].Value, L["Clients.Draft.StepDescription.Uris"].Value),
        new(ManagementClientDraftSteps.Credentials, L["Clients.Draft.Step.Credentials"].Value, L["Clients.Draft.StepShort.Credentials"].Value, L["Clients.Draft.Eyebrow.Credentials"].Value, L["Clients.Draft.StepDescription.Credentials"].Value),
        new(ManagementClientDraftSteps.Review, L["Clients.Draft.Step.Review"].Value, L["Clients.Draft.Step.Review"].Value, L["Clients.Draft.Eyebrow.Review"].Value, L["Clients.Draft.StepDescription.Review"].Value),
    ];

    private ManagementDataResult<ManagementClientDraftDetail>? draftResult;
    private ManagementClientDraftDetail? draft;
    private IReadOnlyList<ManagementClientProfile> profiles = [];
    private IReadOnlyList<ManagementClientAvailableScope> scopes = [];
    private CompleteManagementClientDraftResult? completion;
    private readonly SemaphoreSlim saveLock = new(1, 1);
    private CancellationTokenSource? saveDebounce;
    private bool loading = true;
    private bool saving;
    private bool busy;
    private bool confirmAbandon;
    private DateTimeOffset? savedAt;
    private string? errorMessage;
    private string scopeSearch = string.Empty;
    private Guid loadedId;

    private int CurrentStepIndex => Math.Max(0, Array.FindIndex(Steps, item => item.Id == NormalizeStep(Step)));
    private WizardStep CurrentStep => Steps[CurrentStepIndex];
    private IReadOnlyList<string> StepLabels => Steps.Select(item => item.ShortLabel).ToArray();
    private ManagementClientProfile? Profile => profiles.FirstOrDefault(item => item.Id == draft?.Profile);
    private string ProfileName => Profile?.DisplayName ?? draft?.Profile ?? L["Clients.Draft.CustomConfigLabel"].Value;
    private string ProfileOutcome => Profile?.Outcome ?? L["Clients.Draft.ValidationPendingMessage"].Value;
    private bool CreatesCredential => draft?.Values.ClientType == "confidential";
    private IEnumerable<ManagementClientAvailableScope> FilteredScopes => string.IsNullOrWhiteSpace(scopeSearch)
        ? scopes
        : scopes.Where(item => item.Name.Contains(scopeSearch, StringComparison.OrdinalIgnoreCase)
            || item.DisplayName.Contains(scopeSearch, StringComparison.OrdinalIgnoreCase)
            || (item.Description?.Contains(scopeSearch, StringComparison.OrdinalIgnoreCase) ?? false));
    private string GrantSummary => draft is null ? "—" : string.Join(", ", new[]
    {
        draft.Values.AuthorizationCode ? "Authorization Code" : null,
        draft.Values.RefreshToken ? "Refresh Token" : null,
        draft.Values.ClientCredentials ? "Client Credentials" : null,
        draft.Values.DeviceCode ? "Device Code" : null,
    }.Where(value => value is not null));
    private string TokenLifetimeSummary => draft is null
        ? "—"
        : L["Clients.Draft.TokenSummaryFormat",
            draft.Values.AccessTokenLifetimeMinutes?.ToString() ?? L["Clients.Draft.GlobalDefaultShort"].Value,
            draft.Values.IdentityTokenLifetimeMinutes?.ToString() ?? L["Clients.Draft.GlobalDefaultShort"].Value,
            draft.Values.RefreshTokenLifetimeDays?.ToString() ?? L["Clients.Draft.GlobalDefaultShort"].Value].Value;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedId != Id || draft is null)
        {
            await LoadAsync();
            return;
        }
        var normalized = NormalizeStep(Step);
        if (!string.Equals(Step, normalized, StringComparison.Ordinal))
        {
            Navigation.NavigateTo(DraftHref(normalized), replace: true);
        }
    }

    private async Task LoadAsync()
    {
        loading = true;
        errorMessage = null;
        var draftTask = ClientData.GetClientDraftAsync(Id);
        var profilesTask = ClientData.GetClientProfilesAsync();
        var scopesTask = ClientData.GetAvailableClientScopesAsync();
        await Task.WhenAll(draftTask, profilesTask, scopesTask);
        draftResult = await draftTask;
        draft = draftResult.Value;
        profiles = (await profilesTask).Value ?? [];
        scopes = (await scopesTask).Value ?? [];
        loadedId = Id;
        loading = false;
        if (draft is not null && !ManagementClientDraftSteps.All.Contains(Step, StringComparer.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(DraftHref(draft.CurrentStep), replace: true);
        }
    }

    private async Task DisplayNameChangedAsync(string? value)
    {
        if (draft is null) return;
        var oldSlug = Slugify(draft.Values.DisplayName);
        draft.Values.DisplayName = value ?? string.Empty;
        if (string.IsNullOrWhiteSpace(draft.Values.ClientId) || draft.Values.ClientId == oldSlug)
        {
            draft.Values.ClientId = Slugify(draft.Values.DisplayName);
        }
        await QueueSaveAsync();
    }

    private async Task ClientIdChangedAsync(string? value) { if (draft is null) return; draft.Values.ClientId = value ?? string.Empty; await QueueSaveAsync(); }
    private async Task SetClientTypeAsync(string value) { if (draft is null) return; draft.Values.ClientType = value; await QueueSaveAsync(); }
    private async Task ConsentChangedAsync(string? value) { if (draft is null) return; draft.Values.ConsentType = value ?? "explicit"; await QueueSaveAsync(); }
    private async Task RequireParChangedAsync(bool value) { if (draft is null) return; draft.Values.RequirePar = value; await QueueSaveAsync(); }
    private async Task AuthorizationCodeChangedAsync(bool value) { if (draft is null) return; draft.Values.AuthorizationCode = value; await QueueSaveAsync(); }
    private async Task RefreshTokenChangedAsync(bool value) { if (draft is null) return; draft.Values.RefreshToken = value; await QueueSaveAsync(); }
    private async Task ClientCredentialsChangedAsync(bool value) { if (draft is null) return; draft.Values.ClientCredentials = value; await QueueSaveAsync(); }
    private async Task DeviceCodeChangedAsync(bool value) { if (draft is null) return; draft.Values.DeviceCode = value; await QueueSaveAsync(); }
    private async Task AccessTokenLifetimeChangedAsync(int? value) { if (draft is null) return; draft.Values.AccessTokenLifetimeMinutes = value; await QueueSaveAsync(); }
    private async Task IdentityTokenLifetimeChangedAsync(int? value) { if (draft is null) return; draft.Values.IdentityTokenLifetimeMinutes = value; await QueueSaveAsync(); }
    private async Task RefreshTokenLifetimeChangedAsync(int? value) { if (draft is null) return; draft.Values.RefreshTokenLifetimeDays = value; await QueueSaveAsync(); }
    private async Task ScopeChangedAsync(string scope, bool selected) { if (draft is null) return; if (selected) { if (!draft.Values.Scopes.Contains(scope, StringComparer.Ordinal)) draft.Values.Scopes.Add(scope); } else draft.Values.Scopes.Remove(scope); await QueueSaveAsync(); }
    private async Task AddRedirectAsync() { if (draft is null) return; draft.Values.RedirectUris.Add(string.Empty); await QueueSaveAsync(); }
    private async Task RemoveRedirectAsync(int index) { if (draft is null || index >= draft.Values.RedirectUris.Count) return; draft.Values.RedirectUris.RemoveAt(index); await QueueSaveAsync(); }
    private async Task RedirectChangedAsync(int index, string? value) { if (draft is null || index >= draft.Values.RedirectUris.Count) return; draft.Values.RedirectUris[index] = value ?? string.Empty; await QueueSaveAsync(); }
    private async Task AddLogoutRedirectAsync() { if (draft is null) return; draft.Values.PostLogoutRedirectUris.Add(string.Empty); await QueueSaveAsync(); }
    private async Task RemoveLogoutRedirectAsync(int index) { if (draft is null || index >= draft.Values.PostLogoutRedirectUris.Count) return; draft.Values.PostLogoutRedirectUris.RemoveAt(index); await QueueSaveAsync(); }
    private async Task LogoutRedirectChangedAsync(int index, string? value) { if (draft is null || index >= draft.Values.PostLogoutRedirectUris.Count) return; draft.Values.PostLogoutRedirectUris[index] = value ?? string.Empty; await QueueSaveAsync(); }
    private async Task FrontchannelChangedAsync(string? value) { if (draft is null) return; draft.Values.FrontchannelLogoutUri = value; await QueueSaveAsync(); }
    private async Task BackchannelChangedAsync(string? value) { if (draft is null) return; draft.Values.BackchannelLogoutUri = value; await QueueSaveAsync(); }
    private async Task FrontchannelSessionChangedAsync(bool value) { if (draft is null) return; draft.Values.FrontchannelLogoutSessionRequired = value; await QueueSaveAsync(); }
    private async Task BackchannelSessionChangedAsync(bool value) { if (draft is null) return; draft.Values.BackchannelLogoutSessionRequired = value; await QueueSaveAsync(); }

    private async Task QueueSaveAsync()
    {
        saveDebounce?.Cancel();
        saveDebounce?.Dispose();
        saveDebounce = new CancellationTokenSource();
        var token = saveDebounce.Token;
        try
        {
            await Task.Delay(650, token);
            await SaveAsync(CurrentStep.Id, token);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }

    private async Task<bool> SaveAsync(string step, CancellationToken cancellationToken = default)
    {
        if (draft is null) return false;
        await saveLock.WaitAsync(cancellationToken);
        try
        {
            saving = true;
            errorMessage = null;
            await InvokeAsync(StateHasChanged);
            var result = await ClientData.SaveClientDraftAsync(new(Id, draft.Version, step, draft.Values), cancellationToken);
            if (result.IsSuccess && result.Value is not null)
            {
                draft = result.Value;
                savedAt = result.Value.UpdatedAt;
                return true;
            }
            errorMessage = result.ErrorMessage ?? L["Clients.Draft.SaveFailedError"].Value;
            return false;
        }
        finally
        {
            saving = false;
            saveLock.Release();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task GoToStepAsync(string step)
    {
        saveDebounce?.Cancel();
        if (await SaveAsync(step)) Navigation.NavigateTo(DraftHref(step));
    }
    private Task StepSelectedAsync(int index) => GoToStepAsync(Steps[Math.Clamp(index, 0, Steps.Length - 1)].Id);
    private Task PreviousAsync() => GoToStepAsync(Steps[Math.Max(0, CurrentStepIndex - 1)].Id);
    private Task NextAsync() => GoToStepAsync(Steps[Math.Min(Steps.Length - 1, CurrentStepIndex + 1)].Id);

    private async Task CompleteAsync()
    {
        if (draft is null || busy) return;
        busy = true;
        saveDebounce?.Cancel();
        if (await SaveAsync(ManagementClientDraftSteps.Review))
        {
            var result = await ClientData.CompleteClientDraftAsync(Id, draft.Version);
            if (result.IsSuccess)
        {
            completion = result.Value;
            if (!string.IsNullOrWhiteSpace(completion?.OneTimeSecret))
            {
                StateHasChanged();
                await OneTimeTokenDialog.ShowAsync(
                    Dialogs,
                    L["Clients.Draft.CopyCredentialTitle"].Value,
                    new OneTimeTokenRequest(
                        completion.OneTimeSecret,
                        L["Clients.Draft.CopyCredentialMessage"].Value,
                        L["Clients.Draft.GeneratedCredentialAriaLabel"].Value,
                        CopyLabel: L["Clients.Edit.CopyCredentialAction"].Value));
            }
        }
            else errorMessage = result.ErrorMessage ?? L["Clients.Draft.CreateFailedError"].Value;
        }
        busy = false;
    }

    private async Task AbandonAsync()
    {
        if (busy) return;
        busy = true;
        var result = await ClientData.AbandonClientDraftAsync(Id);
        if (result.IsSuccess) Navigation.NavigateTo("clients?draftDeleted=1");
        else errorMessage = result.ErrorMessage ?? L["Clients.Draft.AbandonFailedError"].Value;
        busy = false;
    }

    private IEnumerable<ClientValidationIssue> IssuesFor(string field) => draft?.Validation.Issues.Where(issue => issue.Field == field) ?? [];
    private string DraftHref(string step) => $"clients/drafts/{Id:D}/{step}";
    private static string ClientHref(string id) => $"clients/{Uri.EscapeDataString(id)}?created=1";
    private static string NormalizeStep(string? step) => ManagementClientDraftSteps.All.FirstOrDefault(item => string.Equals(item, step, StringComparison.OrdinalIgnoreCase)) ?? ManagementClientDraftSteps.Identity;
    private static SUITone IssueTone(ClientValidationIssue issue) => issue.Severity == ClientValidationSeverity.Error ? SUITone.Danger : SUITone.Warning;

    // Errors block (ErrorText, aria-invalid); warnings only advise (WarningText).
    private string? FieldErrors(string field) => JoinMessages(IssuesFor(field).Where(issue => issue.Severity == ClientValidationSeverity.Error));
    private string? FieldWarnings(string field) => JoinMessages(IssuesFor(field).Where(issue => issue.Severity != ClientValidationSeverity.Error));
    private static string? JoinMessages(IEnumerable<ClientValidationIssue> issues) => string.Join(" ", issues.Select(issue => issue.Message)) is { Length: > 0 } text ? text : null;
    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string Slugify(string? value) => string.Join("-", (value ?? string.Empty).Trim().ToLowerInvariant().Split(' ', StringSplitOptions.RemoveEmptyEntries)).Where(character => char.IsLetterOrDigit(character) || character is '-' or '_' or '.').Aggregate(string.Empty, (current, character) => current + character).Trim('-');

    public async ValueTask DisposeAsync()
    {
        saveDebounce?.Cancel();
        saveDebounce?.Dispose();
        saveLock.Dispose();
        await Task.CompletedTask;
    }

    private sealed record WizardStep(string Id, string Label, string ShortLabel, string Eyebrow, string Description);
}
