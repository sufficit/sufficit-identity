@page "/database"
@attribute [Authorize(Policy = ManagementUiPolicies.ReadDatabase)]
@attribute [StreamRendering]
@implements IAsyncDisposable
@inject ManagementDatabaseDataSource DatabaseData
@inject ILogger<Database> Logger

<PageTitle>@L["Database.PageTitle"]</PageTitle>

<SUIPageHeader Title="@L["Database.HeaderTitle"].Value"
            Description="@L["Database.HeaderDescription"].Value">
    <Actions>
        <div class="database-page-actions">
            <button class="button button--secondary database-live-control"
                    type="button"
                    aria-pressed="@liveUpdatesEnabled"
                    @onclick="ToggleLiveUpdatesAsync">
                <span class="status-dot @LiveStatusDotClass"
                      aria-hidden="true"></span>
                @LiveControlLabel
            </button>
            <button class="button button--secondary"
                    type="button"
                    disabled="@refreshing"
                    @onclick="RefreshAsync">
                <SUIIcon Name="refresh"
                         Size="17"
                         CssClass="@(refreshing ? "database-refresh-icon database-refresh-icon--active" : "database-refresh-icon")" />
                @(refreshing ? L["Database.Refreshing"] : L["Database.RefreshNow"])
            </button>
        </div>
    </Actions>
</SUIPageHeader>

@if (loading)
{
    <div class="detail-shell"
             aria-busy="true"
             aria-label="@L["Database.Loading.Aria"].Value">
        <div class="detail-skeleton"></div>
        <div class="detail-skeleton detail-skeleton--short"></div>
    </div>
}
else if (snapshot is null)
{
    <div>
        <SUIEmptyState Icon="database"
                    Title="@L["Database.LoadError.Title"].Value"
                    Description="@(refreshError ?? L["Database.LoadError.Fallback"].Value)">
            <Actions>
                <button class="button button--primary"
                        type="button"
                        @onclick="RefreshAsync">
                    @L["Database.Retry"]
                </button>
            </Actions>
        </SUIEmptyState>
    </div>
}
else
{
    <div class="contract-strip @WatchdogStripClass"
             aria-live="polite">
        <SUIIcon Name="database" Size="20" />
        <div>
            <strong>@WatchdogTitle</strong>
            <span>@WatchdogDescription</span>
        </div>
        <SUIStatusBadge ToneValue="@IdentitySuiTone.From(WatchdogTone)">@WatchdogBadge</SUIStatusBadge>
    </div>

    @if (!string.IsNullOrWhiteSpace(refreshError))
    {
        <div class="inline-notice inline-notice--danger" role="status">
            <SUIIcon Name="alert" Size="19" />
            <div>
                <strong>@L["Database.StaleData.Title"]</strong>
                <span>@refreshError @L["Database.StaleData.Suffix"]</span>
            </div>
        </div>
    }

    <div class="database-capacity-stack" aria-label="@L["Database.Capacity.Aria"].Value">
        @foreach (var pool in EffectivePools)
        {
            <div class="database-capacity" aria-labelledby="@PoolHeadingId(pool)">
                <div class="database-capacity__header">
                    <div>
                        <h2 id="@PoolHeadingId(pool)">@pool.Provider</h2>
                        <p>@L["Database.Pool.Prefix"] <code>@pool.Name</code></p>
                    </div>
                    <SUIStatusBadge ToneValue="@IdentitySuiTone.From(PoolTone(pool))">@PoolStatus(pool)</SUIStatusBadge>
                </div>

                <div class="database-capacity__pressure">
                    <div class="database-capacity__pressure-copy">
                        <span>@L["Database.Column.OccupancyObserved"]</span>
                        <strong>@PressureDescription(pool)</strong>
                    </div>
                    <div class="database-capacity__track"
                         role="progressbar"
                         aria-label="@L["Database.Occupancy.Aria", pool.Name].Value"
                         aria-valuemin="0"
                         aria-valuenow="@PoolPressure(pool)"
                         aria-valuemax="100">
                        <span class="database-capacity__fill database-capacity__fill--@PoolTone(pool)"
                              style="transform: scaleX(@PressureScale(PoolPressure(pool)))"></span>
                    </div>
                </div>

                <dl class="database-capacity__facts">
                    <div>
                        <dt>@L["Database.Facts.InUse"]</dt>
                        <dd>@FormatMetric(PoolUsed(pool))</dd>
                    </div>
                    <div>
                        <dt>@L["Database.Facts.Idle"]</dt>
                        <dd>@FormatMetric(pool.IdleConnections)</dd>
                    </div>
                    <div>
                        <dt>@L["Database.Facts.Limit"]</dt>
                        <dd>@FormatMetric(pool.MaximumConnections)</dd>
                    </div>
                    <div>
                        <dt>@L["Database.Facts.Queued"]</dt>
                        <dd>@FormatMetric(pool.PendingRequests)</dd>
                    </div>
                    <div>
                        <dt>@L["Database.Facts.PoolTimeouts"]</dt>
                        <dd>@FormatNumber(pool.ConnectionTimeouts)</dd>
                    </div>
                </dl>

                @if (!pool.MetricsAvailable)
                {
                    <p class="database-capacity__note">
                        @L["Database.NoPoolMetrics"]
                    </p>
                }
            </div>
        }
    </div>

    <div class="table-panel" aria-labelledby="database-connections-heading">
        <div class="data-toolbar">
            <div>
                <h2 id="database-connections-heading">@L["Database.Connections.Heading"]</h2>
                <p>
                    @FormatNumber(snapshot.ActiveConnections.Count) @L["Database.Connections.CountSuffix"]
                    <time datetime="@snapshot.CapturedAtUtc.ToUniversalTime().ToString("O", System.Globalization.CultureInfo.InvariantCulture)">
                        @FormatTimestamp(snapshot.CapturedAtUtc)
                    </time>
                </p>
            </div>
            <div class="database-live-status" aria-live="polite">
                <span class="status-dot @LiveStatusDotClass"
                      aria-hidden="true"></span>
                <span>@LiveStatusLabel</span>
            </div>
        </div>

        @if (snapshot.ActiveConnections.Count is 0)
        {
            <SUIEmptyState Icon="database"
                        Title="@L["Database.Empty.NoConnections.Title"].Value"
                        Description="@L["Database.Empty.NoConnections.Description"].Value" />
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table data-table--database">
                    <thead>
                        <tr>
                            <th scope="col">@L["Database.Table.Connection"]</th>
                            <th scope="col">@L["Database.Table.Origin"]</th>
                            <th scope="col">@L["Database.Table.OpenedAt"]</th>
                            <th scope="col">@L["Database.Table.Requests"]</th>
                            <th scope="col">@L["Database.Table.LastExecution"]</th>
                            <th scope="col">@L["Database.Table.State"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var connection in snapshot.ActiveConnections)
                        {
                            <tr>
                                <td data-label="@L["Database.Table.Connection"].Value">
                                    <span class="database-connection-id">
                                        <strong>@PhysicalConnectionLabel(connection)</strong>
                                        <code>@connection.Id</code>
                                    </span>
                                </td>
                                <td data-label="@L["Database.Table.Origin"].Value">
                                    <span class="database-origin">
                                        <strong>@connection.DataSource</strong>
                                        <span>@connection.Provider · @connection.Database</span>
                                    </span>
                                </td>
                                <td data-label="@L["Database.Table.OpenedAt"].Value">
                                    <span class="database-timing">
                                        <strong>@FormatTimestamp(connection.OpenedAtUtc)</strong>
                                        <span>@L["Database.Timing.AgoFormat", FormatElapsed(connection.OpenedAtUtc)]</span>
                                    </span>
                                </td>
                                <td data-label="@L["Database.Table.Requests"].Value">
                                    <span class="database-request-count">
                                        <strong>@FormatNumber(connection.CommandCount)</strong>
                                        <span>@L["Database.Requests.InLease", FormatNumber(connection.LeaseCommandCount)]</span>
                                    </span>
                                </td>
                                <td data-label="@L["Database.Table.LastExecution"].Value">
                                    <span class="database-timing">
                                        <strong>@FormatLastCommand(connection)</strong>
                                        <span>@FormatDuration(connection.LastDurationMilliseconds)</span>
                                    </span>
                                </td>
                                <td data-label="@L["Database.Table.State"].Value">
                                    <SUIStatusBadge ToneValue="@(connection.ActiveCommands > 0 ? SUITone.Info : SUITone.Neutral)">
                                        @(connection.ActiveCommands > 0
                                            ? L["Database.State.Running", connection.ActiveCommands]
                                            : L["Database.State.Leased"])
                                    </SUIStatusBadge>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <footer class="table-footer database-telemetry-footer">
            <span>@L["Database.Footer.TotalCommands", FormatNumber(snapshot.TotalCommands)]</span>
            <span>@L["Database.Footer.FailedCommands", FormatNumber(snapshot.FailedCommands)]</span>
        </footer>
    </div>
}

@code {
    private readonly CancellationTokenSource disposal = new();
    private readonly TaskCompletionSource<bool> initialSnapshot =
        new(TaskCreationOptions.RunContinuationsAsynchronously);
    private DatabaseRuntimeSnapshot? snapshot;
    private Task? liveUpdateLoop;
    private string? refreshError;
    private bool loading = true;
    private bool refreshing;
    private bool liveUpdatesEnabled = true;
    private bool liveConnected;

    private string? LiveStatusDotClass => !liveUpdatesEnabled
        ? null
        : liveConnected
            ? "status-dot--success"
            : "status-dot--warning";

    private string LiveControlLabel => !liveUpdatesEnabled
        ? L["Database.LiveControl.Paused"].Value
        : liveConnected
            ? L["Database.LiveControl.Active"].Value
            : L["Database.LiveControl.Reconnecting"].Value;

    private string LiveStatusLabel => !liveUpdatesEnabled
        ? L["Database.LiveStatus.Paused"].Value
        : liveConnected
            ? L["Database.LiveStatus.Active"].Value
            : L["Database.LiveStatus.Reconnecting"].Value;

    private IReadOnlyList<DatabasePoolSnapshot> EffectivePools =>
        snapshot?.Pools.Count > 0
            ? snapshot.Pools
            :
            [
                new DatabasePoolSnapshot(
                    "runtime",
                    snapshot?.ActiveConnections.FirstOrDefault()?.Provider
                        ?? L["Database.Watchdog.ProviderUnidentified"].Value,
                    snapshot?.ActiveConnections.Count ?? 0,
                    null,
                    null,
                    null,
                    null,
                    0,
                    MetricsAvailable: false)
            ];

    private DatabaseWatchdogSnapshot Watchdog =>
        snapshot?.Watchdog
        ?? new DatabaseWatchdogSnapshot(false, "disabled", 0, null, null, null);

    private string WatchdogTone => Watchdog.Status switch
    {
        "healthy" => "success",
        "degraded" or "restarting" => "warning",
        _ => "info"
    };

    private string WatchdogStripClass => $"contract-strip--{WatchdogTone}";

    private string WatchdogTitle => Watchdog.Status switch
    {
        "healthy" => L["Database.Watchdog.Title.Healthy"].Value,
        "degraded" => L["Database.Watchdog.Title.Degraded"].Value,
        "restarting" => L["Database.Watchdog.Title.Restarting"].Value,
        "starting" => L["Database.Watchdog.Title.Starting"].Value,
        _ => L["Database.Watchdog.Title.Disabled"].Value
    };

    private string WatchdogBadge => Watchdog.Status switch
    {
        "healthy" => L["Database.Watchdog.Badge.Healthy"].Value,
        "degraded" => L["Database.Watchdog.Badge.Degraded"].Value,
        "restarting" => L["Database.Watchdog.Badge.Restarting"].Value,
        "starting" => L["Database.Watchdog.Badge.Starting"].Value,
        _ => L["Database.Watchdog.Badge.Disabled"].Value
    };

    private string WatchdogDescription
    {
        get
        {
            if (!Watchdog.Enabled)
            {
                return L["Database.Watchdog.Description.Disabled"].Value;
            }
            if (Watchdog.LastProbeAtUtc is null)
            {
                return L["Database.Watchdog.Description.WaitingFirstCheck"].Value;
            }

            var latency = Watchdog.LastLatencyMilliseconds is null
                ? L["Database.Watchdog.LatencyUnavailable"].Value
                : $"{Watchdog.LastLatencyMilliseconds:0} ms";
            return Watchdog.ConsecutiveFailures is 0
                ? L["Database.Watchdog.Description.LastCheckOk", FormatTimestamp(Watchdog.LastProbeAtUtc.Value), latency].Value
                : L["Database.Watchdog.Description.LastCheckFailures", Watchdog.ConsecutiveFailures, FormatTimestamp(Watchdog.LastProbeAtUtc.Value)].Value;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        liveUpdateLoop = RunLiveUpdatesAsync(disposal.Token);
        await initialSnapshot.Task;
    }

    private async Task RefreshAsync()
    {
        if (refreshing)
        {
            return;
        }

        refreshing = true;
        try
        {
            var result = await DatabaseData.GetAsync(disposal.Token);
            if (result.IsSuccess && result.Value is not null)
            {
                ApplySnapshot(result.Value);
            }
            else
            {
                refreshError = result.ErrorMessage
                    ?? L["Database.RefreshError.NotAvailable"].Value;
            }
        }
        finally
        {
            refreshing = false;
            loading = false;
        }
    }

    private async Task RunLiveUpdatesAsync(CancellationToken cancellationToken)
    {
        var reconnectDelay = TimeSpan.FromSeconds(1);
        while (!cancellationToken.IsCancellationRequested)
        {
            try
            {
                await foreach (var updatedSnapshot in DatabaseData
                    .WatchAsync(cancellationToken)
                    .WithCancellation(cancellationToken))
                {
                    reconnectDelay = TimeSpan.FromSeconds(1);
                    await InvokeAsync(() =>
                    {
                        liveConnected = true;
                        if (liveUpdatesEnabled || snapshot is null)
                        {
                            ApplySnapshot(updatedSnapshot);
                        }
                        initialSnapshot.TrySetResult(true);
                        StateHasChanged();
                    });
                }

                if (!cancellationToken.IsCancellationRequested)
                {
                    throw new InvalidOperationException(
                        "The database telemetry event stream ended unexpectedly.");
                }
            }
            catch (OperationCanceledException)
                when (cancellationToken.IsCancellationRequested)
            {
                break;
            }
            catch (ManagementAccessException exception)
            {
                await InvokeAsync(() =>
                {
                    liveConnected = false;
                    loading = false;
                    refreshError = exception.Decision.Outcome is
                        ManagementAuthorizationOutcome.StepUpRequired
                            ? L["Common.Access.StepUpRequired"].Value
                            : L["Common.Access.Forbidden"].Value;
                    initialSnapshot.TrySetResult(false);
                    StateHasChanged();
                });
                break;
            }
            catch (Exception exception)
            {
                Logger.LogWarning(
                    exception,
                    "Database telemetry live stream was interrupted.");
                await InvokeAsync(() =>
                {
                    liveConnected = false;
                    loading = false;
                    refreshError = L["Database.LiveStream.Interrupted"].Value;
                    initialSnapshot.TrySetResult(false);
                    StateHasChanged();
                });

                try
                {
                    await Task.Delay(reconnectDelay, cancellationToken);
                }
                catch (OperationCanceledException)
                    when (cancellationToken.IsCancellationRequested)
                {
                    break;
                }

                reconnectDelay = TimeSpan.FromSeconds(
                    Math.Min(reconnectDelay.TotalSeconds * 2, 15));
            }
        }

        initialSnapshot.TrySetResult(false);
    }

    private async Task ToggleLiveUpdatesAsync()
    {
        liveUpdatesEnabled = !liveUpdatesEnabled;
        if (liveUpdatesEnabled)
        {
            await RefreshAsync();
        }
    }

    private void ApplySnapshot(DatabaseRuntimeSnapshot value)
    {
        snapshot = value;
        refreshError = null;
        loading = false;
    }

    private long? PoolUsed(DatabasePoolSnapshot pool) =>
        pool.UsedConnections
        ?? (snapshot is null ? null : snapshot.ActiveConnections.Count);

    private int PoolPressure(DatabasePoolSnapshot pool)
    {
        var used = PoolUsed(pool);
        if (used is null || pool.MaximumConnections is null
            || pool.MaximumConnections <= 0)
        {
            return 0;
        }

        return Math.Clamp(
            (int)Math.Round(used.Value * 100d / pool.MaximumConnections.Value),
            0,
            100);
    }

    private static string PressureScale(int pressure) =>
        (pressure / 100d).ToString(
            "0.##",
            System.Globalization.CultureInfo.InvariantCulture);

    private string PoolTone(DatabasePoolSnapshot pool)
    {
        if ((pool.PendingRequests ?? 0) > 0 || PoolPressure(pool) >= 90)
        {
            return "danger";
        }
        if (pool.ConnectionTimeouts > 0 || PoolPressure(pool) >= 75)
        {
            return "warning";
        }
        return pool.MetricsAvailable ? "success" : "info";
    }

    private string PoolStatus(DatabasePoolSnapshot pool) => PoolTone(pool) switch
    {
        "danger" => L["Database.Pool.Status.Critical"].Value,
        "warning" => L["Database.Pool.Status.Attention"].Value,
        "success" => L["Database.Pool.Status.WithinLimit"].Value,
        _ => L["Database.Pool.Status.PartialTelemetry"].Value
    };

    private string PressureDescription(DatabasePoolSnapshot pool)
    {
        var used = PoolUsed(pool);
        return used is not null && pool.MaximumConnections is not null
            ? L["Database.Pressure.WithLimit", used, pool.MaximumConnections, PoolPressure(pool)].Value
            : used is not null
                ? L["Database.Pressure.NoLimit", used].Value
                : L["Database.Pressure.NotPublished"].Value;
    }

    private static string PoolHeadingId(DatabasePoolSnapshot pool)
    {
        var safe = new string(pool.Name
            .Where(character => char.IsLetterOrDigit(character))
            .Take(32)
            .ToArray());
        return $"database-pool-{(string.IsNullOrEmpty(safe) ? "default" : safe)}";
    }

    private string PhysicalConnectionLabel(
        DatabaseConnectionSnapshot connection) =>
        string.IsNullOrWhiteSpace(connection.PhysicalId)
            ? L["Database.PhysicalConnection.Logical"].Value
            : L["Database.PhysicalConnection.Session", connection.PhysicalId].Value;

    private static string FormatMetric(long? value) =>
        value is null ? "—" : FormatNumber(value.Value);

    private static string FormatNumber(long value) =>
        value.ToString(
            "N0",
            System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));

    private static string FormatTimestamp(DateTimeOffset value) =>
        value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss");

    private string FormatElapsed(DateTimeOffset value)
    {
        var elapsed = DateTimeOffset.UtcNow - value.ToUniversalTime();
        if (elapsed.TotalSeconds < 1)
        {
            return L["Database.Elapsed.LessThanSecond"].Value;
        }
        if (elapsed.TotalMinutes < 1)
        {
            return $"{Math.Floor(elapsed.TotalSeconds):0} s";
        }
        if (elapsed.TotalHours < 1)
        {
            return $"{Math.Floor(elapsed.TotalMinutes):0} min";
        }
        return $"{elapsed.TotalHours:0.#} h";
    }

    private string FormatLastCommand(DatabaseConnectionSnapshot connection) =>
        connection.LastCommandAtUtc is null
            ? L["Database.LastCommand.None"].Value
            : FormatTimestamp(connection.LastCommandAtUtc.Value);

    private string FormatDuration(double? milliseconds)
    {
        if (milliseconds is null)
        {
            return L["Database.Duration.Unavailable"].Value;
        }
        return milliseconds < 1
            ? L["Database.Duration.LessThanMs"].Value
            : $"{milliseconds:0.#} ms";
    }

    public async ValueTask DisposeAsync()
    {
        await disposal.CancelAsync();
        if (liveUpdateLoop is not null)
        {
            await liveUpdateLoop;
        }
        disposal.Dispose();
    }
}
