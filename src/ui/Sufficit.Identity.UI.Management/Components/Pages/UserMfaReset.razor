@page "/users/{Id}/actions/mfa"
@attribute [Authorize(Policy = ManagementUiPolicies.Access)]
@attribute [StreamRendering]
@inject ManagementUserDataSource UserData

<PageTitle>@L["Users.MfaReset.PageTitle"]</PageTitle>

<SUIPageHeader Title="@HeaderTitle" Description="@L["Users.MfaReset.Description"].Value">
    <Actions>
        <SUIButton ColorValue="SUIColor.Secondary" StartIcon="arrow-left" Href="@DetailHref">@L["Users.Actions.BackToUser"]</SUIButton>
    </Actions>
</SUIPageHeader>

<ManagementDataView Result="result"
                    Loading="loading"
                    OnRetry="LoadAsync"
                    FailureClass="panel"
                    NotFoundTitle="@L["Users.Detail.Error.NotFound"].Value"
                    StepUpTitle="@L["Users.Detail.Error.StepUp"].Value"
                    ForbiddenTitle="@L["Users.Detail.Error.Forbidden"].Value"
                    UnavailableTitle="@L["Users.Detail.Error.Generic"].Value">
    <LoadingContent>
    <div class="credential-panel" aria-label="@L["Users.Actions.Loading"].Value">
        <div class="detail-skeleton"></div>
        <div class="detail-skeleton detail-skeleton--short"></div>
    </div>
    </LoadingContent>
    <FailureActions>
        <SUIButton ColorValue="SUIColor.Secondary" Href="@DetailHref">@L["Users.Actions.BackToUser"]</SUIButton>
    </FailureActions>
    <Success Context="user">
        <UserMfaResetPanel User="user" UserChanged="OnUserChanged" />
    </Success>
</ManagementDataView>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private ManagementDataResult<ManagementUserDetail>? result;
    private bool loading = true;
    private string DetailHref => $"users/{Uri.EscapeDataString(Id)}";
    private string HeaderTitle => result?.Value?.UserName ?? result?.Value?.Email ?? L["Users.MfaReset.Title"].Value;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        result = await UserData.GetAsync(Id);
        loading = false;
    }

    private void OnUserChanged(ManagementUserDetail user) =>
        result = ManagementDataResult<ManagementUserDetail>.Success(user);
}
