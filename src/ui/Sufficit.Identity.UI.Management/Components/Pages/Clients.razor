@page "/clients"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageClients)]
@attribute [StreamRendering]
@inject ManagementClientDataSource ClientData
@inject NavigationManager Navigation

<PageTitle>Aplicações | Sufficit Identity</PageTitle>

<PageHeader Title="Aplicações"
            Description="Crie, retome e gerencie integrações OAuth e OpenID Connect.">
    <Actions>
        <a class="button button--primary" href="clients/new">
            <AppIcon Name="plus" Size="17" />
            Nova aplicação
        </a>
    </Actions>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(DeletedClientId))
{
    <div class="inline-notice inline-notice--success" role="status">
        <AppIcon Name="check" Size="19" />
        <div>
            <strong>Cliente excluído</strong>
            <span>O registro <code>@DeletedClientId</code> foi removido e a operação foi auditada.</span>
        </div>
    </div>
}

@if (DraftDeletedFlag is 1)
{
    <div class="inline-notice inline-notice--success" role="status">
        <AppIcon Name="check" Size="19" />
        <div><strong>Rascunho descartado</strong><span>A configuração incompleta foi removida com segurança.</span></div>
    </div>
}

<div class="contract-strip contract-strip--info" id="clients-integration-note">
    <AppIcon Name="code" Size="20" />
    <div>
        <strong>Uma única fonte de verdade</strong>
        <span>A interface e a API usam as mesmas validações, permissões e trilha de auditoria.</span>
    </div>
    <StatusBadge Tone="info">Capability</StatusBadge>
</div>

@if (!loading && Drafts.Count > 0)
{
    <div class="draft-panel" aria-labelledby="drafts-heading">
        <div class="data-toolbar">
            <div><h2 id="drafts-heading">Continuar configuração</h2><p>Rascunhos protegidos e disponíveis somente para sua conta administrativa.</p></div>
            <StatusBadge Tone="info">@Drafts.Count @(Drafts.Count == 1 ? "rascunho" : "rascunhos")</StatusBadge>
        </div>
        <div class="draft-list">
            @foreach (var item in Drafts)
            {
                <a class="draft-item" href="@DraftHref(item)">
                    <span class="draft-item__icon"><AppIcon Name="edit" Size="19" /></span>
                    <span class="draft-item__body">
                        <strong>@DraftName(item)</strong>
                        <span>@item.ProfileDisplayName · Etapa @DraftStepLabel(item.CurrentStep)</span>
                        <small>Atualizado @FormatRelative(item.UpdatedAt) · expira em @item.ExpiresAt.ToLocalTime().ToString("dd/MM/yyyy")</small>
                    </span>
                    <StatusBadge Tone="@(item.IsReady ? "success" : "neutral")">@(item.IsReady ? "Pronto" : "Em andamento")</StatusBadge>
                    <AppIcon Name="arrow-right" Size="17" />
                </a>
            }
        </div>
    </div>
}

<div class="table-panel" aria-labelledby="clients-list-heading" aria-busy="@loading">
    <div class="data-toolbar">
        <div>
            <h2 id="clients-list-heading">Aplicações registradas</h2>
            <p>@ToolbarDescription</p>
        </div>
        <div class="data-toolbar__actions">
            @if (CanFilter)
            {
                <label class="search-field">
                    <span class="visually-hidden">Pesquisar aplicações</span>
                    <AppIcon Name="search" Size="18" />
                    <input type="search"
                           placeholder="Pesquisar por client_id ou nome"
                           autocomplete="off"
                           name="q"
                           value="@search"
                           @onchange="SearchChanged" />
                </label>
                <label class="compact-filter">
                    <span>Tipo</span>
                    <select id="client-type-filter" name="type" class="form-control" value="@typeFilter" @onchange="TypeChanged">
                        <option value="all">Todos</option>
                        <option value="public">Públicos</option>
                        <option value="confidential">Confidenciais</option>
                    </select>
                </label>
                <label class="compact-filter">
                    <span>Fluxo</span>
                    <select id="client-grant-filter" name="grant" class="form-control" value="@grantFilter" @onchange="GrantChanged">
                        <option value="all">Todos os fluxos</option>
                        <option value="authorization_code">Authorization Code</option>
                        <option value="client_credentials">Client Credentials</option>
                        <option value="device_code">Device Code</option>
                        <option value="refresh_token">Refresh Token</option>
                    </select>
                </label>
                <label class="compact-filter">
                    <span>Origem</span>
                    <select id="client-origin-filter" name="origin" class="form-control" value="@originFilter" @onchange="OriginChanged">
                        <option value="all">Todas</option>
                        <option value="manual">Manual</option>
                        <option value="manifest">Manifesto</option>
                    </select>
                </label>
                <label class="compact-filter">
                    <span>Estado</span>
                    <select id="client-status-filter" name="status" class="form-control" value="@statusFilter" @onchange="StatusChanged">
                        <option value="all">Todos</option>
                        <option value="active">Ativos</option>
                    </select>
                </label>
                <label class="compact-filter compact-filter--text">
                    <span>Scope</span>
                    <input id="client-scope-filter" name="scope" class="form-control" value="@scopeFilter" placeholder="ex.: openid" @onchange="ScopeChanged" />
                </label>
            }
        </div>
    </div>

    <div class="client-results" aria-live="polite">
        @if (loading)
        {
            <div class="table-skeleton" aria-label="Carregando clientes">
                @for (var index = 0; index < 4; index++)
                {
                    <span></span>
                }
            </div>
        }
        else if (result?.IsSuccess is true)
        {
            @if (FilteredClients.Count is 0)
            {
                @if (!HasActiveClientFilters)
                {
                    <EmptyState Icon="database"
                                Title="@EmptyTitle"
                                Description="@EmptyDescription" />
                }
                else
                {
                    <EmptyState Icon="search"
                                Title="@EmptyTitle"
                                Description="@EmptyDescription">
                        <Actions>
                            <button class="button button--secondary"
                                    type="button"
                                    @onclick="ClearSearch">
                                    Limpar filtros
                            </button>
                        </Actions>
                    </EmptyState>
                }
            }
            else
            {
                <div class="table-scroll">
                    <table class="data-table data-table--clients">
                        <thead>
                            <tr>
                                <th scope="col">Aplicação</th>
                                <th scope="col">Client ID</th>
                                <th scope="col">Tipo</th>
                                <th scope="col">Estado</th>
                                <th scope="col">Origem</th>
                                <th scope="col"><span class="visually-hidden">Ações</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var client in FilteredClients)
                            {
                                <tr>
                                    <td data-label="Aplicação">
                                        <a class="client-name client-link"
                                           href="@ClientHref(client.Id)">
                                            @DisplayName(client)
                                        </a>
                                    </td>
                                    <td data-label="Client ID">
                                        <code class="client-id">@client.ClientId</code>
                                    </td>
                                    <td data-label="Tipo">
                                        <StatusBadge Tone="@ClientTypeTone(client.Type)">
                                            @ClientTypeLabel(client.Type)
                                        </StatusBadge>
                                    </td>
                                    <td data-label="Estado">
                                        <span class="registration-state">
                                            <span class="status-dot @(ClientStatusTone(client.Status))" aria-hidden="true"></span>
                                            @ClientStatusLabel(client.Status)
                                        </span>
                                    </td>
                                    <td data-label="Origem">
                                        <span class="registration-state">@ClientOriginLabel(client.Origin)</span>
                                    </td>
                                    <td data-label="Ações">
                                        <a class="row-action"
                                           href="@ClientHref(client.Id)"
                                           aria-label="@($"Abrir detalhes de {client.ClientId}")">
                                            Detalhes
                                            <AppIcon Name="arrow-right" Size="15" />
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else
        {
            <EmptyState Icon="database"
                        Title="Não foi possível consultar os clientes"
                        Description="O serviço de identidade não conseguiu ler os registros agora. Verifique o banco e tente novamente.">
                <Actions>
                    <button class="button button--secondary"
                            type="button"
                            @onclick="LoadClientsAsync">
                        Tentar novamente
                    </button>
                </Actions>
            </EmptyState>
        }
    </div>

    <footer class="table-footer table-footer--paginated">
        <span aria-live="polite" aria-atomic="true">@ResultCountLabel</span>
        @if (HasPages)
        {
            <nav class="pagination" aria-label="Paginação de aplicações">
                <button class="button button--secondary button--small"
                        type="button"
                        disabled="@(CurrentPage <= 1 || loading)"
                        @onclick="() => GoToPage(CurrentPage - 1)">
                    <AppIcon Name="arrow-left" Size="15" />
                    Anterior
                </button>
                <span class="pagination__status">Página @CurrentPage de @PageCount</span>
                <button class="button button--secondary button--small"
                        type="button"
                        disabled="@(CurrentPage >= PageCount || loading)"
                        @onclick="() => GoToPage(CurrentPage + 1)">
                    Próxima
                    <AppIcon Name="arrow-right" Size="15" />
                </button>
            </nav>
        }
        else
        {
            <span class="pagination__status">Página única</span>
        }
    </footer>
</div>

<div class="client-guardrails" aria-labelledby="client-safety-heading">
    <div>
        <h2 id="client-safety-heading">Proteções aplicadas</h2>
        <p>Cada alteração é validada, autorizada e auditada antes de chegar ao registro OAuth.</p>
    </div>
    <ul>
        <li><AppIcon Name="shield" Size="18" /> Operações exigem capabilities específicas do provedor</li>
        <li><AppIcon Name="lock" Size="18" /> Segredos nunca aparecem na listagem</li>
        <li><AppIcon Name="audit" Size="18" /> Criação e exclusão geram eventos persistentes</li>
    </ul>
</div>

@code {
    private ManagementDataResult<ManagementClientPage>? result;
    private ManagementDataResult<IReadOnlyList<ManagementClientDraftSummary>>? draftsResult;
    private bool loading = true;
    private string search = string.Empty;
    private string typeFilter = "all";
    private string grantFilter = "all";
    private string scopeFilter = string.Empty;
    private string originFilter = "all";
    private string statusFilter = "all";
    private int page = 1;
    private int pageSize = 25;
    private string? loadedFingerprint;

    [SupplyParameterFromQuery(Name = "deleted")]
    public string? DeletedClientId { get; set; }

    [SupplyParameterFromQuery(Name = "draftDeleted")]
    public int DraftDeletedFlag { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? QuerySearch { get; set; }

    [SupplyParameterFromQuery(Name = "type")]
    public string? QueryType { get; set; }

    [SupplyParameterFromQuery(Name = "grant")]
    public string? QueryGrant { get; set; }

    [SupplyParameterFromQuery(Name = "scope")]
    public string? QueryScope { get; set; }

    [SupplyParameterFromQuery(Name = "origin")]
    public string? QueryOrigin { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? QueryStatus { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int QueryPage { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "pageSize")]
    public int QueryPageSize { get; set; } = 25;

    private IReadOnlyList<ManagementClientSummary> AllClients =>
        result?.Value?.Items ?? [];

    private IReadOnlyList<ManagementClientDraftSummary> Drafts =>
        draftsResult?.Value ?? [];

    private IReadOnlyList<ManagementClientSummary> FilteredClients => AllClients;

    private bool CanFilter => result?.IsSuccess is true;

    private string ToolbarDescription =>
        loading
            ? "Consultando o registro de aplicações…"
            : result?.IsSuccess is true
                ? "Filtros e paginação são processados pelo serviço de aplicação."
                : "A consulta falhou antes de retornar registros.";

    private string ResultCountLabel =>
        loading
            ? "Carregando registros"
            : result?.IsSuccess is true
                ? ResultRangeLabel
                : "Nenhum registro carregado";

    private string EmptyTitle =>
        HasActiveClientFilters
            ? "Nenhum cliente corresponde aos filtros"
            : "Nenhum cliente registrado";

    private string EmptyDescription =>
        HasActiveClientFilters
            ? "Revise os filtros de busca, tipo, fluxo, origem, estado ou scope e tente novamente."
            : "O serviço respondeu com uma coleção vazia. Crie a primeira aplicação para começar.";

    private bool HasActiveClientFilters =>
        !string.IsNullOrWhiteSpace(search)
        || typeFilter != "all"
        || grantFilter != "all"
        || !string.IsNullOrWhiteSpace(scopeFilter)
        || originFilter != "all"
        || statusFilter != "all";

    private int TotalCount => result?.Value?.TotalCount ?? 0;
    private int CurrentPage => result?.Value?.Page ?? page;
    private int PageSize => result?.Value?.PageSize ?? pageSize;
    private int PageCount => result?.Value?.PageCount ?? 0;
    private bool HasPages => PageCount > 1;
    private string ResultRangeLabel
    {
        get
        {
            if (TotalCount is 0)
            {
                return "0 registros";
            }

            var first = ((CurrentPage - 1) * PageSize) + 1;
            var last = Math.Min(CurrentPage * PageSize, TotalCount);
            return $"{first}–{last} de {TotalCount} {Pluralize(TotalCount, "registro", "registros")}";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var normalizedType = NormalizeType(QueryType);
        var normalizedGrant = NormalizeGrant(QueryGrant);
        var normalizedOrigin = NormalizeOrigin(QueryOrigin);
        var normalizedStatus = NormalizeStatus(QueryStatus);
        var normalizedPage = NormalizePage(QueryPage);
        var normalizedPageSize = NormalizePageSize(QueryPageSize);
        var fingerprint = $"{QuerySearch}|{normalizedType}|{normalizedGrant}|{QueryScope}|{normalizedOrigin}|{normalizedStatus}|{normalizedPage}|{normalizedPageSize}";
        if (fingerprint == loadedFingerprint)
        {
            return;
        }
        loadedFingerprint = fingerprint;
        search = QuerySearch ?? string.Empty;
        typeFilter = normalizedType;
        grantFilter = normalizedGrant;
        scopeFilter = QueryScope?.Trim() ?? string.Empty;
        originFilter = normalizedOrigin;
        statusFilter = normalizedStatus;
        page = normalizedPage;
        pageSize = normalizedPageSize;
        await LoadClientsAsync();
    }

    private async Task LoadClientsAsync()
    {
        loading = true;
        var query = new ManagementClientQuery(
            search,
            typeFilter,
            grantFilter,
            string.IsNullOrWhiteSpace(scopeFilter) ? null : scopeFilter,
            originFilter,
            statusFilter,
            page,
            pageSize);
        var clientsTask = ClientData.SearchClientsAsync(query);
        var draftsTask = draftsResult is null
            ? ClientData.GetClientDraftsAsync()
            : Task.FromResult(draftsResult);
        await Task.WhenAll(clientsTask, draftsTask);
        result = await clientsTask;
        draftsResult = await draftsTask;
        loading = false;
    }

    private void SearchChanged(ChangeEventArgs args)
    {
        search = args.Value?.ToString() ?? string.Empty;
        SyncUrl(resetPage: true);
    }

    private void TypeChanged(ChangeEventArgs args)
    {
        typeFilter = NormalizeType(args.Value?.ToString());
        SyncUrl(resetPage: true);
    }

    private void GrantChanged(ChangeEventArgs args)
    {
        grantFilter = NormalizeGrant(args.Value?.ToString());
        SyncUrl(resetPage: true);
    }

    private void ScopeChanged(ChangeEventArgs args)
    {
        scopeFilter = args.Value?.ToString()?.Trim() ?? string.Empty;
        SyncUrl(resetPage: true);
    }

    private void OriginChanged(ChangeEventArgs args)
    {
        originFilter = NormalizeOrigin(args.Value?.ToString());
        SyncUrl(resetPage: true);
    }

    private void StatusChanged(ChangeEventArgs args)
    {
        statusFilter = NormalizeStatus(args.Value?.ToString());
        SyncUrl(resetPage: true);
    }

    private void ClearSearch()
    {
        search = string.Empty;
        typeFilter = "all";
        grantFilter = "all";
        scopeFilter = string.Empty;
        originFilter = "all";
        statusFilter = "all";
        SyncUrl(resetPage: true);
    }

    private void GoToPage(int targetPage)
    {
        if (targetPage < 1 || targetPage > PageCount)
        {
            return;
        }

        page = targetPage;
        SyncUrl(resetPage: false);
    }

    private void SyncUrl(bool resetPage)
    {
        if (resetPage)
        {
            page = 1;
        }

        var uri = Navigation.GetUriWithQueryParameters(BaseUri, new Dictionary<string, object?>
        {
            ["q"] = string.IsNullOrWhiteSpace(search) ? null : search.Trim(),
            ["type"] = typeFilter == "all" ? null : typeFilter,
            ["grant"] = grantFilter == "all" ? null : grantFilter,
            ["scope"] = string.IsNullOrWhiteSpace(scopeFilter) ? null : scopeFilter.Trim(),
            ["origin"] = originFilter == "all" ? null : originFilter,
            ["status"] = statusFilter == "all" ? null : statusFilter,
            ["page"] = resetPage || page <= 1 ? null : page,
            ["pageSize"] = pageSize == 25 ? null : pageSize,
        });
        Navigation.NavigateTo(uri, replace: true);
    }

    private static string ClientHref(string id) =>
        $"clients/{Uri.EscapeDataString(id)}";

    private static string DraftHref(ManagementClientDraftSummary item) =>
        $"clients/drafts/{item.Id:D}/{item.CurrentStep}";

    private static string DraftName(ManagementClientDraftSummary item) =>
        !string.IsNullOrWhiteSpace(item.DisplayName)
            ? item.DisplayName
            : !string.IsNullOrWhiteSpace(item.ClientId)
                ? item.ClientId
                : "Aplicação sem nome";

    private static string DraftStepLabel(string step) => step switch
    {
        ManagementClientDraftSteps.Identity => "Identidade",
        ManagementClientDraftSteps.Protocol => "Protocolo",
        ManagementClientDraftSteps.Permissions => "Permissões",
        ManagementClientDraftSteps.Uris => "URIs e logout",
        ManagementClientDraftSteps.Credentials => "Credenciais",
        ManagementClientDraftSteps.Review => "Revisão",
        _ => "Configuração"
    };

    private static string FormatRelative(DateTimeOffset value)
    {
        var elapsed = DateTimeOffset.UtcNow - value.ToUniversalTime();
        if (elapsed < TimeSpan.FromMinutes(1)) return "agora";
        if (elapsed < TimeSpan.FromHours(1)) return $"há {(int)elapsed.TotalMinutes} min";
        if (elapsed < TimeSpan.FromDays(1)) return $"há {(int)elapsed.TotalHours} h";
        return $"em {value.ToLocalTime():dd/MM/yyyy}";
    }

    private static string NormalizeType(string? value) => value?.ToLowerInvariant() switch
    {
        "public" => "public",
        "confidential" => "confidential",
        _ => "all"
    };

    private static string NormalizeGrant(string? value) => value?.ToLowerInvariant() switch
    {
        "authorization_code" => "authorization_code",
        "client_credentials" => "client_credentials",
        "device_code" => "device_code",
        "refresh_token" => "refresh_token",
        _ => "all"
    };

    private static string NormalizeOrigin(string? value) => value?.ToLowerInvariant() switch
    {
        "manual" => "manual",
        "manifest" => "manifest",
        _ => "all"
    };

    private static string NormalizeStatus(string? value) => value?.ToLowerInvariant() switch
    {
        "active" => "active",
        _ => "all"
    };

    private static int NormalizePage(int value) => value < 1 ? 1 : value;

    private static int NormalizePageSize(int value) => value switch
    {
        < 1 => 25,
        > 100 => 100,
        _ => value
    };

    private string BaseUri => Navigation.Uri.Split('?', '#')[0];

    private static string DisplayName(ManagementClientSummary client) =>
        string.IsNullOrWhiteSpace(client.DisplayName)
            ? "Sem nome de exibição"
            : client.DisplayName;

    private static string ClientTypeLabel(string? type) =>
        type?.ToLowerInvariant() switch
        {
            "public" => "Público",
            "confidential" => "Confidencial",
            null or "" => "Não informado",
            _ => type
        };

    private static string ClientTypeTone(string? type) =>
        string.Equals(type, "confidential", StringComparison.OrdinalIgnoreCase)
            ? "info"
            : "neutral";

    private static string ClientStatusLabel(string? status) => "Ativo";

    private static string ClientStatusTone(string? status) => "status-dot--success";

    private static string ClientOriginLabel(string? origin) =>
        string.Equals(origin, "manifest", StringComparison.OrdinalIgnoreCase)
            ? "Manifesto"
            : "Manual";

    private static string Pluralize(int count, string singular, string plural) =>
        count is 1 ? singular : plural;
}
