@page "/clients"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageClients)]
@attribute [StreamRendering]
@inject ManagementClientDataSource ClientData
@inject NavigationManager Navigation

<PageTitle>@L["Clients.List.PageTitle"] | Sufficit Identity</PageTitle>

<SUIPageHeader Title="@L["Clients.List.PageTitle"].Value"
            Description="@L["Clients.List.Description"].Value">
    <Actions>
        <SUIButton Href="clients/registrations" ColorValue="SUIColor.Secondary" StartIcon="shield">
            @L["Clients.Registrations.Title"]
        </SUIButton>
        <SUIButton Href="clients/new" ColorValue="SUIColor.Primary" StartIcon="plus">
            @L["Clients.Create.Title"]
        </SUIButton>
    </Actions>
</SUIPageHeader>

@if (!string.IsNullOrWhiteSpace(DeletedClientId))
{
    <SUIAlert ToneValue="SUITone.Success" Icon="check" role="status">
        <strong>@L["Clients.List.DeletedTitle"]</strong>
        <span>@L["Clients.List.DeletedMessagePrefix"] <code>@DeletedClientId</code> @L["Clients.List.DeletedMessageSuffix"]</span>
    </SUIAlert>
}

@if (DraftDeletedFlag is 1)
{
    <SUIAlert ToneValue="SUITone.Success" Icon="check" role="status">
        <strong>@L["Clients.List.DraftDeletedTitle"]</strong>
        <span>@L["Clients.List.DraftDeletedMessage"]</span>
    </SUIAlert>
}

<div class="contract-strip contract-strip--info" id="clients-integration-note">
    <SUIIcon Name="code" Size="20" />
    <div>
        <strong>@L["Clients.List.SingleSourceTitle"]</strong>
        <span>@L["Clients.List.SingleSourceMessage"]</span>
    </div>
    <SUIStatusBadge ToneValue="SUITone.Info">Capability</SUIStatusBadge>
</div>

@if (!loading && Drafts.Count > 0)
{
    <div class="draft-panel" aria-labelledby="drafts-heading">
        <div class="data-toolbar">
            <div><h2 id="drafts-heading">@L["Clients.List.ContinueConfigHeading"]</h2><p>@L["Clients.List.DraftsProtectedDescription"]</p></div>
            <SUIStatusBadge ToneValue="SUITone.Info">@Drafts.Count @(Drafts.Count == 1 ? L["Clients.List.DraftSingular"] : L["Clients.List.DraftPlural"])</SUIStatusBadge>
        </div>
        <SUIStack Spacing="2" Class="draft-list">
            @foreach (var item in Drafts)
            {
                <SUIChoiceCard TValue="Guid"
                               Value="@item.Id"
                               Href="@DraftHref(item)"
                               Title="@DraftName(item)"
                               Description="@($"{item.ProfileDisplayName} · {L["Clients.List.StepLabel"].Value} {DraftStepLabel(item.CurrentStep)}")"
                               LeadingTone="SUITone.Info">
                    <IconContent><SUIIcon Name="edit" Size="19" /></IconContent>
                    <TrailingContent>
                        <span class="draft-item__status">
                            <SUIStatusBadge ToneValue="@(item.IsReady ? SUITone.Success : SUITone.Neutral)">@(item.IsReady ? L["Clients.List.ReadyStatus"] : L["Clients.List.InProgressStatus"])</SUIStatusBadge>
                        </span>
                        <SUIIcon Name="chevron-right" Size="17" />
                    </TrailingContent>
                    <ChildContent>
                        <small class="draft-item__meta">@L["Clients.List.UpdatedLabel"] @FormatRelative(item.UpdatedAt) · @L["Clients.List.ExpiresInLabel"] @Time.Format(item.ExpiresAt, TimeStyle.Date)</small>
                    </ChildContent>
                </SUIChoiceCard>
            }
        </SUIStack>
    </div>
}

<div class="table-panel" aria-labelledby="clients-list-heading" aria-busy="@loading">
    <div class="data-toolbar data-toolbar--clients">
        <div>
            <h2 id="clients-list-heading">@L["Clients.List.RegisteredHeading"]</h2>
            <p>@ToolbarDescription</p>
        </div>
        <div class="clients-filters">
            @if (CanFilter)
            {
                <IdentityTextField T="string" Class="clients-filter clients-filter--search"
                          Id="client-search" name="q" InputType="search" aria-label="@L["Clients.List.SearchAriaLabel"].Value"
                          AdornmentIcon="search"
                          Placeholder="@L["Clients.List.SearchPlaceholder"].Value" autocomplete="off"
                          Value="@search" ValueChanged="SearchChanged" />
                <IdentitySelect T="string" id="client-type-filter" name="type" Label="@L["Clients.Detail.TypeLabel"].Value" Class="clients-filter" Value="@typeFilter" ValueChanged="TypeSelected">
                    <SUISelectItem Value="@("all")">@L["Clients.List.All"]</SUISelectItem>
                    <SUISelectItem Value="@("public")">@L["Clients.List.FilterPublic"]</SUISelectItem>
                    <SUISelectItem Value="@("confidential")">@L["Clients.List.FilterConfidential"]</SUISelectItem>
                </IdentitySelect>
                <IdentitySelect T="string" id="client-grant-filter" name="grant" Label="@L["Clients.List.FlowLabel"].Value" Class="clients-filter" Value="@grantFilter" ValueChanged="GrantSelected">
                    <SUISelectItem Value="@("all")">@L["Clients.List.AllFlows"]</SUISelectItem>
                    <SUISelectItem Value="@("authorization_code")">Authorization Code</SUISelectItem>
                    <SUISelectItem Value="@("client_credentials")">Client Credentials</SUISelectItem>
                    <SUISelectItem Value="@("device_code")">Device Code</SUISelectItem>
                    <SUISelectItem Value="@("refresh_token")">Refresh Token</SUISelectItem>
                </IdentitySelect>
                <IdentitySelect T="string" id="client-origin-filter" name="origin" Label="@L["Clients.List.OriginLabel"].Value" Class="clients-filter" Value="@originFilter" ValueChanged="OriginSelected">
                    <SUISelectItem Value="@("all")">@L["Clients.List.AllFeminine"]</SUISelectItem>
                    <SUISelectItem Value="@("manual")">@L["Clients.List.OriginManual"]</SUISelectItem>
                    <SUISelectItem Value="@("manifest")">@L["Clients.List.OriginManifest"]</SUISelectItem>
                </IdentitySelect>
                <IdentitySelect T="string" id="client-status-filter" name="status" Label="@L["Clients.List.StatusLabel"].Value" Class="clients-filter" Value="@statusFilter" ValueChanged="StatusSelected">
                    <SUISelectItem Value="@("all")">@L["Clients.List.All"]</SUISelectItem>
                    <SUISelectItem Value="@("active")">@L["Clients.List.StatusActive"]</SUISelectItem>
                    <SUISelectItem Value="@("disabled")">@L["Clients.State.Disabled"]</SUISelectItem>
                </IdentitySelect>
                <IdentityTextField T="string" Class="clients-filter" Label="Scope" Monospace="true"
                              Id="client-scope-filter" name="scope" Value="@scopeFilter"
                              Placeholder="@L["Clients.List.ScopePlaceholder"].Value" ValueChanged="ScopeChanged" />
            }
        </div>
    </div>

    <ManagementDataView Result="result"
                        Loading="loading"
                        OnRetry="LoadClientsAsync"
                        Class="client-results"
                        LoadingLabel="@L["Clients.List.LoadingClientsAriaLabel"].Value"
                        UnavailableTitle="@L["Clients.List.QueryErrorTitle"].Value"
                        UnavailableDescription="@L["Clients.List.QueryErrorDescription"].Value">
        <Success Context="_">
            @if (FilteredClients.Count is 0)
            {
                @if (!HasActiveClientFilters)
                {
                    <SUIEmptyState Icon="database"
                                Title="@EmptyTitle"
                                Description="@EmptyDescription" />
                }
                else
                {
                    <SUIEmptyState Icon="search"
                                Title="@EmptyTitle"
                                Description="@EmptyDescription">
                        <Actions>
                            <SUIButton VariantValue="SUIVariant.Outlined" ColorValue="SUIColor.Default"
                                    OnClick="ClearSearch">
                                    @L["Clients.List.ClearFilters"]
                            </SUIButton>
                        </Actions>
                    </SUIEmptyState>
                }
            }
            else
            {
                <SUITable TItem="ManagementClientSummary"
                          Items="FilteredClients"
                          RowKey="@(client => client.Id)"
                          StackOnMobile="true"
                          Hover="true"
                          ColumnCount="6"
                          Class="client-results-table">
                    <HeaderContent>
                        <SUITh>@L["Clients.Registrations.ColumnApplication"]</SUITh>
                        <SUITh>Client ID</SUITh>
                        <SUITh>@L["Clients.Detail.TypeLabel"]</SUITh>
                        <SUITh>@L["Clients.List.StatusLabel"]</SUITh>
                        <SUITh>@L["Clients.List.OriginLabel"]</SUITh>
                        <SUITh><span class="visually-hidden">@L["Clients.Registrations.ColumnActions"]</span></SUITh>
                    </HeaderContent>
                    <RowTemplate Context="client">
                        <SUITd DataLabel="@L["Clients.Registrations.ColumnApplication"].Value">
                            <SUILink Class="client-name client-link" Href="@ClientHref(client.Id)">
                                @DisplayName(client)
                            </SUILink>
                        </SUITd>
                        <SUITd DataLabel="Client ID">
                            <code class="client-id">@client.ClientId</code>
                        </SUITd>
                        <SUITd DataLabel="@L["Clients.Detail.TypeLabel"].Value">
                            <SUIStatusBadge ToneValue="@IdentitySuiTone.From(ClientTypeTone(client.Type))">
                                @ClientTypeLabel(client.Type)
                            </SUIStatusBadge>
                        </SUITd>
                        <SUITd DataLabel="@L["Clients.List.StatusLabel"].Value">
                            <span class="registration-state">
                                <span class="status-dot @(ClientStatusTone(client.Status))" aria-hidden="true"></span>
                                @ClientStatusLabel(client.Status)
                            </span>
                        </SUITd>
                        <SUITd DataLabel="@L["Clients.List.OriginLabel"].Value">
                            <span class="registration-state">@ClientOriginLabel(client.Origin)</span>
                        </SUITd>
                        <SUITd DataLabel="@L["Clients.Registrations.ColumnActions"].Value">
                            <SUIButton Href="@ClientHref(client.Id)"
                                       VariantValue="SUIVariant.Text"
                                       SizeValue="SUISize.Small"
                                       EndIcon="arrow-right"
                                       aria-label="@L["Clients.List.OpenDetailsAriaLabel", client.ClientId].Value">
                                @L["Clients.Registrations.Details"]
                            </SUIButton>
                        </SUITd>
                    </RowTemplate>
                </SUITable>
            }
        </Success>
    </ManagementDataView>

    <footer class="table-footer table-footer--paginated clients-footer">
        @if (result?.IsSuccess is true)
        {
            <SUIPagination Class="clients-pagination"
                           TotalItems="TotalCount"
                           PageSize="PageSize"
                           PageIndex="@(CurrentPage - 1)"
                           PageIndexChanged="@((int index) => GoToPage(index + 1))"
                           Disabled="loading"
                           AriaLabel="@L["Clients.List.PaginationAriaLabel"].Value"
                           PreviousLabel="@L["Clients.Registrations.Previous"].Value"
                           NextLabel="@L["Clients.Registrations.Next"].Value"
                           PageLabel="@((current, count) => L["Clients.Registrations.PageOf", current, count].Value)"
                           RangeFormatter="FormatRange"
                           EmptyText="@L["Clients.List.ZeroRecords"].Value" />
        }
        else
        {
            <span aria-live="polite" aria-atomic="true">@ResultCountLabel</span>
        }
    </footer>
</div>

<div class="client-guardrails" aria-labelledby="client-safety-heading">
    <div>
        <h2 id="client-safety-heading">@L["Clients.List.GuardrailsHeading"]</h2>
        <p>@L["Clients.List.GuardrailsDescription"]</p>
    </div>
    <ul>
        <li><SUIIcon Name="shield" Size="18" /> @L["Clients.List.GuardrailCapabilities"]</li>
        <li><SUIIcon Name="lock" Size="18" /> @L["Clients.List.GuardrailSecrets"]</li>
        <li><SUIIcon Name="audit" Size="18" /> @L["Clients.List.GuardrailAudit"]</li>
    </ul>
</div>

@code {
    // The reader's zone once the browser answers (BrowserTimeProvider in the layout).
    [CascadingParameter]
    private BrowserTime Time { get; set; } = BrowserTime.Server;

    private ManagementDataResult<ManagementClientPage>? result;
    private ManagementDataResult<IReadOnlyList<ManagementClientDraftSummary>>? draftsResult;
    private bool loading = true;
    private string search = string.Empty;
    private string typeFilter = "all";
    private string grantFilter = "all";
    private string scopeFilter = string.Empty;
    private string originFilter = "all";
    private string statusFilter = "all";
    private int page = 1;
    private int pageSize = 25;
    private string? loadedFingerprint;

    [SupplyParameterFromQuery(Name = "deleted")]
    public string? DeletedClientId { get; set; }

    [SupplyParameterFromQuery(Name = "draftDeleted")]
    public int DraftDeletedFlag { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? QuerySearch { get; set; }

    [SupplyParameterFromQuery(Name = "type")]
    public string? QueryType { get; set; }

    [SupplyParameterFromQuery(Name = "grant")]
    public string? QueryGrant { get; set; }

    [SupplyParameterFromQuery(Name = "scope")]
    public string? QueryScope { get; set; }

    [SupplyParameterFromQuery(Name = "origin")]
    public string? QueryOrigin { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? QueryStatus { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int QueryPage { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "pageSize")]
    public int QueryPageSize { get; set; } = 25;

    private IReadOnlyList<ManagementClientSummary> AllClients =>
        result?.Value?.Items ?? [];

    private IReadOnlyList<ManagementClientDraftSummary> Drafts =>
        draftsResult?.Value ?? [];

    private IReadOnlyList<ManagementClientSummary> FilteredClients => AllClients;

    private bool CanFilter => result?.IsSuccess is true;

    private string ToolbarDescription =>
        loading
            ? L["Clients.List.ToolbarLoading"].Value
            : result?.IsSuccess is true
                ? L["Clients.List.ToolbarSuccess"].Value
                : L["Clients.List.ToolbarFailure"].Value;

    private string ResultCountLabel =>
        loading
            ? L["Clients.Registrations.LoadingRegistrations"].Value
            : L["Clients.List.NoRecordsLoaded"].Value;

    private string EmptyTitle =>
        HasActiveClientFilters
            ? L["Clients.List.NoMatchTitle"].Value
            : L["Clients.List.NoClientsTitle"].Value;

    private string EmptyDescription =>
        HasActiveClientFilters
            ? L["Clients.List.NoMatchDescription"].Value
            : L["Clients.List.NoClientsDescription"].Value;

    private bool HasActiveClientFilters =>
        !string.IsNullOrWhiteSpace(search)
        || typeFilter != "all"
        || grantFilter != "all"
        || !string.IsNullOrWhiteSpace(scopeFilter)
        || originFilter != "all"
        || statusFilter != "all";

    private int TotalCount => result?.Value?.TotalCount ?? 0;
    private int CurrentPage => result?.Value?.Page ?? page;
    private int PageSize => result?.Value?.PageSize ?? pageSize;
    private int PageCount => result?.Value?.PageCount ?? 0;
    private string FormatRange(int first, int last, int total)
    {
        var unit = Pluralize(total, L["Clients.List.RecordSingular"].Value, L["Clients.List.RecordPlural"].Value);
        return L["Clients.List.RangeFormat", first, last, total, unit].Value;
    }

    protected override async Task OnParametersSetAsync()
    {
        var normalizedType = NormalizeType(QueryType);
        var normalizedGrant = NormalizeGrant(QueryGrant);
        var normalizedOrigin = NormalizeOrigin(QueryOrigin);
        var normalizedStatus = NormalizeStatus(QueryStatus);
        var normalizedPage = NormalizePage(QueryPage);
        var normalizedPageSize = NormalizePageSize(QueryPageSize);
        var fingerprint = $"{QuerySearch}|{normalizedType}|{normalizedGrant}|{QueryScope}|{normalizedOrigin}|{normalizedStatus}|{normalizedPage}|{normalizedPageSize}";
        if (fingerprint == loadedFingerprint)
        {
            return;
        }
        loadedFingerprint = fingerprint;
        search = QuerySearch ?? string.Empty;
        typeFilter = normalizedType;
        grantFilter = normalizedGrant;
        scopeFilter = QueryScope?.Trim() ?? string.Empty;
        originFilter = normalizedOrigin;
        statusFilter = normalizedStatus;
        page = normalizedPage;
        pageSize = normalizedPageSize;
        await LoadClientsAsync();
    }

    private async Task LoadClientsAsync()
    {
        loading = true;
        var query = new ManagementClientQuery(
            search,
            typeFilter,
            grantFilter,
            string.IsNullOrWhiteSpace(scopeFilter) ? null : scopeFilter,
            originFilter,
            statusFilter,
            page,
            pageSize);
        var clientsTask = ClientData.SearchClientsAsync(query);
        var draftsTask = draftsResult is null
            ? ClientData.GetClientDraftsAsync()
            : Task.FromResult(draftsResult);
        await Task.WhenAll(clientsTask, draftsTask);
        result = await clientsTask;
        draftsResult = await draftsTask;
        loading = false;
    }

    private void SearchChanged(string? value)
    {
        search = value ?? string.Empty;
        SyncUrl(resetPage: true);
    }

    private void TypeSelected(string? value)
    {
        typeFilter = NormalizeType(value);
        SyncUrl(resetPage: true);
    }

    private void GrantSelected(string? value)
    {
        grantFilter = NormalizeGrant(value);
        SyncUrl(resetPage: true);
    }

    private void ScopeChanged(string? value)
    {
        scopeFilter = value?.Trim() ?? string.Empty;
        SyncUrl(resetPage: true);
    }

    private void OriginSelected(string? value)
    {
        originFilter = NormalizeOrigin(value);
        SyncUrl(resetPage: true);
    }

    private void StatusSelected(string? value)
    {
        statusFilter = NormalizeStatus(value);
        SyncUrl(resetPage: true);
    }

    private void ClearSearch()
    {
        search = string.Empty;
        typeFilter = "all";
        grantFilter = "all";
        scopeFilter = string.Empty;
        originFilter = "all";
        statusFilter = "all";
        SyncUrl(resetPage: true);
    }

    private void GoToPage(int targetPage)
    {
        if (targetPage < 1 || targetPage > PageCount)
        {
            return;
        }

        page = targetPage;
        SyncUrl(resetPage: false);
    }

    private void SyncUrl(bool resetPage)
    {
        if (resetPage)
        {
            page = 1;
        }

        var uri = Navigation.GetUriWithQueryParameters(BaseUri, new Dictionary<string, object?>
        {
            ["q"] = string.IsNullOrWhiteSpace(search) ? null : search.Trim(),
            ["type"] = typeFilter == "all" ? null : typeFilter,
            ["grant"] = grantFilter == "all" ? null : grantFilter,
            ["scope"] = string.IsNullOrWhiteSpace(scopeFilter) ? null : scopeFilter.Trim(),
            ["origin"] = originFilter == "all" ? null : originFilter,
            ["status"] = statusFilter == "all" ? null : statusFilter,
            ["page"] = resetPage || page <= 1 ? null : page,
            ["pageSize"] = pageSize == 25 ? null : pageSize,
        });
        Navigation.NavigateTo(uri, replace: true);
    }

    private static string ClientHref(string id) =>
        $"clients/{Uri.EscapeDataString(id)}";

    private static string DraftHref(ManagementClientDraftSummary item) =>
        $"clients/drafts/{item.Id:D}/{item.CurrentStep}";

    private string DraftName(ManagementClientDraftSummary item) =>
        !string.IsNullOrWhiteSpace(item.DisplayName)
            ? item.DisplayName
            : !string.IsNullOrWhiteSpace(item.ClientId)
                ? item.ClientId
                : L["Clients.List.UnnamedApplication"].Value;

    private string DraftStepLabel(string step) => step switch
    {
        ManagementClientDraftSteps.Identity => L["Clients.Draft.Step.Identity"].Value,
        ManagementClientDraftSteps.Protocol => L["Clients.Draft.Step.Protocol"].Value,
        ManagementClientDraftSteps.Permissions => L["Clients.Draft.Step.Permissions"].Value,
        ManagementClientDraftSteps.Uris => L["Clients.Draft.Step.UrisLogout"].Value,
        ManagementClientDraftSteps.Credentials => L["Clients.Draft.Step.Credentials"].Value,
        ManagementClientDraftSteps.Review => L["Clients.Draft.Step.Review"].Value,
        _ => L["Clients.Draft.Step.Default"].Value
    };

    private string FormatRelative(DateTimeOffset value)
    {
        var elapsed = DateTimeOffset.UtcNow - value.ToUniversalTime();
        if (elapsed < TimeSpan.FromMinutes(1)) return L["Clients.List.JustNow"].Value;
        if (elapsed < TimeSpan.FromHours(1)) return L["Clients.List.MinutesAgo", (int)elapsed.TotalMinutes].Value;
        if (elapsed < TimeSpan.FromDays(1)) return L["Clients.List.HoursAgo", (int)elapsed.TotalHours].Value;
        return $"{L["Clients.List.OnDatePrefix"].Value} {Time.Format(value, TimeStyle.Date)}";
    }

    private static string NormalizeType(string? value) => value?.ToLowerInvariant() switch
    {
        "public" => "public",
        "confidential" => "confidential",
        _ => "all"
    };

    private static string NormalizeGrant(string? value) => value?.ToLowerInvariant() switch
    {
        "authorization_code" => "authorization_code",
        "client_credentials" => "client_credentials",
        "device_code" => "device_code",
        "refresh_token" => "refresh_token",
        _ => "all"
    };

    private static string NormalizeOrigin(string? value) => value?.ToLowerInvariant() switch
    {
        "manual" => "manual",
        "manifest" => "manifest",
        _ => "all"
    };

    private static string NormalizeStatus(string? value) => value?.ToLowerInvariant() switch
    {
        "active" => "active",
        "disabled" => "disabled",
        _ => "all"
    };

    private static int NormalizePage(int value) => value < 1 ? 1 : value;

    private static int NormalizePageSize(int value) => value switch
    {
        < 1 => 25,
        > 100 => 100,
        _ => value
    };

    private string BaseUri => Navigation.Uri.Split('?', '#')[0];

    private string DisplayName(ManagementClientSummary client) =>
        string.IsNullOrWhiteSpace(client.DisplayName)
            ? L["Clients.List.NoDisplayName"].Value
            : client.DisplayName;

    private string ClientTypeLabel(string? type) =>
        type?.ToLowerInvariant() switch
        {
            "public" => L["Clients.Detail.TypePublic"].Value,
            "confidential" => L["Clients.Detail.TypeConfidential"].Value,
            null or "" => L["Clients.Detail.NotInformed"].Value,
            _ => type
        };

    private static string ClientTypeTone(string? type) =>
        string.Equals(type, "confidential", StringComparison.OrdinalIgnoreCase)
            ? "info"
            : "neutral";

    private string ClientStatusLabel(string? status) => status == "disabled"
        ? L["Clients.State.Disabled"].Value
        : L["Clients.List.ClientStatusActive"].Value;

    private static string ClientStatusTone(string? status) =>
        status == "disabled" ? "status-dot--danger" : "status-dot--success";

    private string ClientOriginLabel(string? origin) =>
        string.Equals(origin, "manifest", StringComparison.OrdinalIgnoreCase)
            ? L["Clients.List.OriginManifest"].Value
            : L["Clients.List.OriginManual"].Value;

    private static string Pluralize(int count, string singular, string plural) =>
        count is 1 ? singular : plural;
}
