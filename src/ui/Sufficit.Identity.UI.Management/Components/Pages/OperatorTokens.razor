@page "/tokens"
@using Microsoft.JSInterop
@using Sufficit.Identity.Management.Authorization
@using Sufficit.Identity.Management.OperatorTokens
@using Sufficit.Identity.UI.Management.Clients
@using Sufficit.Identity.UI.Management.OperatorTokens
@attribute [Authorize(Policy = ManagementUiPolicies.ManageOperatorTokens)]
@inject ManagementOperatorTokenDataSource TokenData
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>@L["OperatorTokens.PageTitle"]</PageTitle>

<SUIPageHeader Title="@L["OperatorTokens.Header.Title"].Value"
               Description="@L["OperatorTokens.Header.Description"].Value" />

<div class="contract-strip @(ShowMfaWarning ? "contract-strip--warning" : "contract-strip--info")">
    <SUIIcon Name="shield" Size="20" />
    <div>
        <strong>@L["OperatorTokens.LinkPrepares.Title"]</strong>
        <span>@L["OperatorTokens.LinkPrepares.Description"]</span>
    </div>
    @if (ShowMfaWarning)
    {
        <SUIStatusBadge ToneValue="SUITone.Warning">@L["OperatorTokens.MfaRequiredBadge"]</SUIStatusBadge>
    }
</div>

@if (workspaceResult is null)
{
    <div class="operator-token-loading" aria-live="polite">
        <span class="button-spinner" aria-hidden="true"></span>
        <span>@L["OperatorTokens.Loading"]</span>
    </div>
}
else if (workspaceResult.IsSuccess is false || workspace is null)
{
    <SUIAlert ToneValue="SUITone.Danger" Icon="alert" Class="operator-token-alert">
        <div class="operator-token-alert__copy">
            <strong>@ErrorTitle(workspaceResult)</strong>
            <span>@workspaceResult.ErrorMessage</span>
        </div>
    </SUIAlert>
}
else
{
    @if (queryPrepared)
    {
        <section class="operator-token-request" aria-labelledby="prepared-request-heading">
            <span class="operator-token-request__icon"><SUIIcon Name="external" Size="20" /></span>
            <div>
                <h2 id="prepared-request-heading">@L["OperatorTokens.PreparedRequest.Title"]</h2>
                <p>@L["OperatorTokens.PreparedRequest.Description"]</p>
                <dl>
                    <div><dt>@L["OperatorTokens.Field.PurposeLabel"]</dt><dd>@purpose</dd></div>
                    <div><dt>@L["OperatorTokens.Field.LifetimeLabel"]</dt><dd>@FormatDuration(tokenLifetimeSeconds)</dd></div>
                    <div><dt>@L["OperatorTokens.Field.CapabilitiesLabel"]</dt><dd>@L["OperatorTokens.Field.CapabilitiesSelectedCount", selectedCapabilities.Count]</dd></div>
                </dl>
            </div>
            <SUIStatusBadge ToneValue="SUITone.Neutral">@L["OperatorTokens.AwaitingConfirmation"]</SUIStatusBadge>
        </section>
    }

    @if (queryUnavailableCapabilities.Count > 0)
    {
        <SUIAlert ToneValue="SUITone.Danger" Icon="alert" Class="operator-token-alert">
            <div class="operator-token-alert__copy">
                <strong>@L["OperatorTokens.UnavailableAccess.Title"]</strong>
                <span>@L["OperatorTokens.UnavailableAccess.Description", string.Join(", ", queryUnavailableCapabilities)]</span>
            </div>
        </SUIAlert>
    }

    @if (queryValidationErrors.Count > 0)
    {
        <SUIAlert ToneValue="SUITone.Danger" Icon="alert" Class="operator-token-alert">
            <div class="operator-token-alert__copy">
                <strong>@L["OperatorTokens.InvalidLinkParameters.Title"]</strong>
                <ul>
                    @foreach (var error in queryValidationErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        </SUIAlert>
    }

    @if (operationResult?.IsSuccess is false)
    {
        <SUIAlert ToneValue="SUITone.Danger" Icon="alert" Class="operator-token-alert">
            <div class="operator-token-alert__copy">
                <strong>@ErrorTitle(operationResult)</strong>
                <span>@operationResult.ErrorMessage</span>
                @if (operationResult.ErrorDetails?.Count > 0)
                {
                    <ul>
                        @foreach (var detail in operationResult.ErrorDetails)
                        {
                            <li>@detail</li>
                        }
                    </ul>
                }
            </div>
        </SUIAlert>
    }
    else if (revokedPurpose is not null)
    {
        <div class="inline-notice inline-notice--success" role="status">
            <SUIIcon Name="check" Size="19" />
            <div>
                <strong>@L["OperatorTokens.Revoked.Title"]</strong>
                <span>@L["OperatorTokens.Revoked.Description", revokedPurpose]</span>
            </div>
        </div>
    }

    <div class="operator-token-layout">
        <section class="operator-token-issuer" aria-labelledby="operator-token-issuer-heading">
            <header>
                <div>
                    <h2 id="operator-token-issuer-heading">@L["OperatorTokens.Issuer.Title"]</h2>
                    <p>@L["OperatorTokens.Issuer.Description"]</p>
                </div>
                <SUIStatusBadge ToneValue="@(workspace.IssuanceEnabled ? SUITone.Success : SUITone.Danger)">
                    @(workspace.IssuanceEnabled ? L["OperatorTokens.Issuer.EnabledBadge"] : L["OperatorTokens.Issuer.DisabledBadge"])
                </SUIStatusBadge>
            </header>

            <div class="operator-token-fields" data-sui-align-row>
                <SUITextField T="string"
                              id="operator-token-purpose"
                              aria-label="@L["OperatorTokens.Field.PurposeLabel"].Value"
                              Label="@L["OperatorTokens.Field.PurposeLabel"].Value"
                              HelperText="@L["OperatorTokens.Field.Purpose.Helper"].Value"
                              Placeholder="@L["OperatorTokens.Field.Purpose.Placeholder"].Value"
                              MaxLength="120"
                              Disabled="@issuing"
                              Value="@purpose"
                              ValueChanged="PurposeChanged"
                              autocomplete="off" />

                <SUISelect T="int"
                           id="operator-token-lifetime"
                           aria-label="@L["OperatorTokens.Field.LifetimeLabel"].Value"
                           Label="@L["OperatorTokens.Field.LifetimeLabel"].Value"
                           HelperText="@LifetimeHelperText"
                           Disabled="@issuing"
                           Value="@tokenLifetimeSeconds"
                           ValueChanged="LifetimeChanged">
                        @foreach (var lifetime in LifetimeOptions)
                        {
                            <SUISelectItem Value="@lifetime">@FormatDuration(lifetime)</SUISelectItem>
                        }
                </SUISelect>
            </div>

            <details class="operator-token-capability-picker" open="@capabilityPickerOpen">
                <summary>@L["OperatorTokens.CapabilityPicker.Summary"]</summary>
                <div class="operator-token-capability-picker__body">
                    <SUITextField T="string"
                                  id="capability-filter"
                                  aria-label="@L["OperatorTokens.CapabilityFilter.Label"].Value"
                                  Label="@L["OperatorTokens.CapabilityFilter.Label"].Value"
                                  Placeholder="@L["OperatorTokens.CapabilityFilter.Placeholder"].Value"
                                  Immediate
                                  Disabled="@issuing"
                                  Value="@capabilityFilter"
                                  ValueChanged="CapabilityFilterChanged"
                                  autocomplete="off" />

                    @foreach (var group in CapabilityGroups)
                    {
                        <fieldset>
                            <legend>@group.Name</legend>
                            <div class="operator-token-capability-grid">
                                @foreach (var capability in group.Capabilities)
                                {
                                    <div class="operator-token-capability">
                                        <label class="operator-token-capability__selection">
                                            <input type="checkbox"
                                                   checked="@selectedCapabilities.Contains(capability)"
                                                   disabled="@issuing"
                                                   @onchange="eventArgs => ToggleCapability(capability, eventArgs)" />
                                            <span>
                                                <strong>@CapabilityLabel(capability)</strong>
                                                <code>@capability</code>
                                            </span>
                                        </label>
                                        <ManagementCapabilityHelp Capability="@capability" />
                                    </div>
                                }
                            </div>
                        </fieldset>
                    }

                    @if (CapabilityGroups.Count is 0)
                    {
                        <p class="operator-token-capability-picker__empty">@L["OperatorTokens.CapabilityPicker.Empty"]</p>
                    }
                </div>
            </details>

            <footer class="operator-token-issue-actions">
                <div class="operator-token-issue-summary">
                    <strong>@FormatDuration(tokenLifetimeSeconds)</strong>
                    <span>· @L["OperatorTokens.Issuer.SelectedSummary", selectedCapabilities.Count, workspace.MaximumCapabilities]</span>
                </div>
                <AuthorizeView Policy="@ManagementUiPolicies.IssueOperatorTokens">
                    <Authorized>
                        <SUILoadingButton IsLoading="@issuing"
                                          Disabled="@(!CanIssue)"
                                          ColorValue="SUIColor.Primary"
                                          OnClick="IssueAsync"
                                          aria-busy="@issuing">
                            <SUIIcon Name="key" Size="17" />
                            <span>@(queryPrepared ? L["OperatorTokens.Issue.ConfirmButton"] : L["OperatorTokens.Issue.GenerateButton"])</span>
                        </SUILoadingButton>
                    </Authorized>
                    <NotAuthorized>
                        <span class="operator-token-unauthorized">@L["OperatorTokens.Issue.MissingCapability"].Value <code>identity.management.tokens.issue</code>.</span>
                    </NotAuthorized>
                </AuthorizeView>
            </footer>
        </section>

        <aside class="operator-token-safety" aria-labelledby="operator-token-safety-heading">
            <span class="operator-token-safety__icon"><SUIIcon Name="shield" Size="24" /></span>
            <h2 id="operator-token-safety-heading">@L["OperatorTokens.Safety.Title"]</h2>
            <ul class="plain-check-list">
                <li><SUIIcon Name="check" Size="16" /> @L["OperatorTokens.Safety.FixedScope"].Value <code>identity.management</code></li>
                <li><SUIIcon Name="check" Size="16" /> @L["OperatorTokens.Safety.NoAdminRole"]</li>
                <li><SUIIcon Name="check" Size="16" /> @L["OperatorTokens.Safety.MfaPreserved"]</li>
                <li><SUIIcon Name="check" Size="16" /> @L["OperatorTokens.Safety.AuditedIssuance"]</li>
                <li><SUIIcon Name="check" Size="16" /> @L["OperatorTokens.Safety.NoChaining"]</li>
            </ul>
            <p>@L["OperatorTokens.Safety.UrlNote"]</p>
        </aside>
    </div>

    @if (issuedToken is not null)
    {
        <section class="operator-token-reveal" aria-labelledby="operator-token-reveal-heading" role="status">
            <header>
                <div>
                    <h2 id="operator-token-reveal-heading">@L["OperatorTokens.Reveal.Title"]</h2>
                    <p>@L["OperatorTokens.Reveal.Description"]</p>
                </div>
                <SUIStatusBadge ToneValue="SUITone.Warning">@L["OperatorTokens.Reveal.ExpiresBadge", issuedExpiresAt.ToLocalTime().ToString("dd/MM HH:mm:ss")]</SUIStatusBadge>
            </header>
            <textarea class="operator-token-value"
                      aria-label="@L["OperatorTokens.Reveal.TokenAriaLabel"].Value"
                      readonly
                      spellcheck="false"
                      autocomplete="off">@issuedToken</textarea>
            <footer>
                <span>@L["OperatorTokens.Reveal.CapabilitiesCount", issuedCapabilities.Count]</span>
                <div>
                    <SUIButton VariantValue="SUIVariant.Outlined"
                               ColorValue="SUIColor.Primary"
                               OnClick="CopyIssuedTokenAsync">
                        <SUIIcon Name="code" Size="17" />
                        @(tokenCopied ? L["OperatorTokens.Reveal.Copied"] : L["OperatorTokens.Reveal.CopyButton"])
                    </SUIButton>
                    <SUIButton VariantValue="SUIVariant.Text"
                               ColorValue="SUIColor.Default"
                               OnClick="HideIssuedToken">
                        @L["OperatorTokens.Reveal.Hide"]
                    </SUIButton>
                </div>
            </footer>
            @if (clipboardUnavailable)
            {
                <span class="operator-token-clipboard-note">@L["OperatorTokens.Reveal.ClipboardBlocked"]</span>
            }
        </section>
    }

    <section class="operator-token-active" aria-labelledby="operator-token-active-heading">
        <header>
            <div>
                <h2 id="operator-token-active-heading">@L["OperatorTokens.Active.Title"]</h2>
                <p>@L["OperatorTokens.Active.Description"]</p>
            </div>
            <SUIStatusBadge ToneValue="SUITone.Neutral">@L["OperatorTokens.Active.CountBadge", workspace.ActiveTokens.Count]</SUIStatusBadge>
        </header>

        @if (workspace.ActiveTokens.Count is 0)
        {
            <SUIEmptyState Icon="key"
                           Title="@L["OperatorTokens.Active.EmptyTitle"].Value"
                           Description="@L["OperatorTokens.Active.EmptyDescription"].Value" />
        }
        else
        {
            <div class="operator-token-list">
                @foreach (var token in workspace.ActiveTokens)
                {
                    <article>
                        <div class="operator-token-list__main">
                            <div>
                                <strong>@token.Purpose</strong>
                                <span>@L["OperatorTokens.Active.IssuedExpires", token.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm"), token.ExpiresAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")]</span>
                            </div>
                            <SUIStatusBadge ToneValue="SUITone.Success">@L["OperatorTokens.Active.StatusBadge"]</SUIStatusBadge>
                        </div>
                        <div class="operator-token-list__capabilities">
                            @foreach (var capability in token.Capabilities)
                            {
                                <code>@capability</code>
                            }
                        </div>
                        <footer>
                            <code title="@L["OperatorTokens.Active.AuditableId"].Value">@ShortId(token.Id)</code>
                            <AuthorizeView Policy="@ManagementUiPolicies.RevokeOperatorTokens">
                                <Authorized>
                                    @if (pendingRevokeId == token.Id)
                                    {
                                        <div class="operator-token-revoke-confirmation">
                                            <span>@L["OperatorTokens.Revoke.ConfirmPrompt"]</span>
                                            <SUILoadingButton IsLoading="@revoking"
                                                              Disabled="@revoking"
                                                              SizeValue="SUISize.Small"
                                                              ColorValue="SUIColor.Error"
                                                              OnClick="async _ => await RevokeAsync(token)">
                                                @L["OperatorTokens.Revoke.Confirm"]
                                            </SUILoadingButton>
                                            <SUIButton VariantValue="SUIVariant.Text"
                                                       ColorValue="SUIColor.Default"
                                                       SizeValue="SUISize.Small"
                                                       Disabled="@revoking"
                                                       OnClick="CancelRevoke">
                                                @L["OperatorTokens.Revoke.Cancel"]
                                            </SUIButton>
                                        </div>
                                    }
                                    else
                                    {
                                        <SUIButton VariantValue="SUIVariant.Text"
                                                   ColorValue="SUIColor.Error"
                                                   SizeValue="SUISize.Small"
                                                   OnClick="_ => PrepareRevoke(token.Id)">
                                            @L["Capability.Label.Revoke"]
                                        </SUIButton>
                                    }
                                </Authorized>
                            </AuthorizeView>
                        </footer>
                    </article>
                }
            </div>
        }
    </section>
}

@code {
    [Parameter, SupplyParameterFromQuery(Name = "action")]
    public string? RequestedAction { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "purpose")]
    public string? RequestedPurpose { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "lifetimeSeconds")]
    public int? RequestedLifetimeSeconds { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "capability")]
    public string[]? RequestedCapabilities { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "capabilities")]
    public string? RequestedCapabilitiesCsv { get; set; }

    private ManagementDataResult<OperatorTokenWorkspace>? workspaceResult;
    private ManagementDataResult<object>? operationResult;
    private OperatorTokenWorkspace? workspace;
    private string purpose = "";
    private int tokenLifetimeSeconds = 900;
    private readonly HashSet<string> selectedCapabilities = new(StringComparer.Ordinal);
    private readonly List<string> queryUnavailableCapabilities = [];
    private readonly List<string> queryValidationErrors = [];
    private bool queryPrepared;
    private bool capabilityPickerOpen;
    private string capabilityFilter = "";
    private bool issuing;
    private bool revoking;
    private string? pendingRevokeId;
    private string? revokedPurpose;
    private string? issuedToken;
    private DateTimeOffset issuedExpiresAt;
    private IReadOnlyList<string> issuedCapabilities = [];
    private bool tokenCopied;
    private bool clipboardUnavailable;

    protected override async Task OnInitializedAsync()
    {
        workspaceResult = await TokenData.GetAsync();
        workspace = workspaceResult.Value;
        if (workspace is null)
        {
            return;
        }

        tokenLifetimeSeconds = workspace.DefaultLifetimeSeconds;
        ApplyQueryRequest();
    }

    private IReadOnlyList<int> LifetimeOptions
    {
        get
        {
            var values = new[] { 300, 600, 900, 1800, 3600 }
                .Where(value => value <= workspace!.MaximumLifetimeSeconds)
                .Append(tokenLifetimeSeconds)
                .Where(value => value >= 60)
                .Distinct()
                .Order()
                .ToArray();
            return values;
        }
    }

    private IReadOnlyList<CapabilityGroup> CapabilityGroups => workspace is null
        ? []
        : workspace.AvailableCapabilities
            .Where(MatchesCapabilityFilter)
            .GroupBy(CapabilityGroupKey)
            .OrderBy(group => CapabilityGroupOrder(group.Key))
            .Select(group => new CapabilityGroup(
                L[$"Capability.Group.{group.Key}"],
                group.Order(StringComparer.Ordinal).ToArray()))
            .ToArray();

    private bool CanIssue =>
        workspace?.IssuanceEnabled is true
        && !issuing
        && !string.IsNullOrWhiteSpace(purpose)
        && purpose.Trim().Length <= 120
        && selectedCapabilities.Count is > 0
        && selectedCapabilities.Count <= workspace.MaximumCapabilities
        && queryUnavailableCapabilities.Count is 0
        && queryValidationErrors.Count is 0;

    private bool ShowMfaWarning => workspace is
    {
        MfaRequired: true,
        MfaSatisfied: false
    };

    private void ApplyQueryRequest()
    {
        queryPrepared = string.Equals(
                RequestedAction,
                "issue",
                StringComparison.OrdinalIgnoreCase)
            || !string.IsNullOrWhiteSpace(RequestedPurpose)
            || RequestedLifetimeSeconds is not null
            || RequestedCapabilities?.Length > 0
            || !string.IsNullOrWhiteSpace(RequestedCapabilitiesCsv);

        var requestedPurpose = RequestedPurpose?.Trim();
        purpose = string.IsNullOrWhiteSpace(requestedPurpose)
            ? L["OperatorTokens.DefaultPurpose"].Value
            : requestedPurpose[..Math.Min(requestedPurpose.Length, 120)];
        if (requestedPurpose?.Length > 120)
        {
            queryValidationErrors.Add(
                L["OperatorTokens.Validation.PurposeLength", 120]);
        }

        if (RequestedLifetimeSeconds is { } requestedLifetime)
        {
            if (requestedLifetime >= 60
                && requestedLifetime <= workspace!.MaximumLifetimeSeconds)
            {
                tokenLifetimeSeconds = requestedLifetime;
            }
            else
            {
                queryValidationErrors.Add(
                    L[
                        "OperatorTokens.Validation.LifetimeRange",
                        60,
                        workspace!.MaximumLifetimeSeconds]);
            }
        }

        var requestedCapabilities = (RequestedCapabilities ?? [])
            .Concat((RequestedCapabilitiesCsv ?? "")
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.Ordinal)
            .ToArray();
        foreach (var capability in requestedCapabilities)
        {
            if (workspace!.AvailableCapabilities.Contains(
                capability,
                StringComparer.Ordinal))
            {
                selectedCapabilities.Add(capability);
            }
            else
            {
                queryUnavailableCapabilities.Add(capability);
            }
        }
        if (requestedCapabilities.Length > workspace!.MaximumCapabilities)
        {
            queryValidationErrors.Add(
                L[
                    "OperatorTokens.Validation.CapabilityLimit",
                    requestedCapabilities.Length,
                    workspace.MaximumCapabilities]);
        }
        capabilityPickerOpen = !queryPrepared || selectedCapabilities.Count is 0;
    }

    private async Task IssueAsync()
    {
        if (!CanIssue || workspace is null)
        {
            return;
        }

        issuing = true;
        revokedPurpose = null;
        issuedToken = null;
        tokenCopied = false;
        clipboardUnavailable = false;
        var result = await TokenData.IssueAsync(
            new IssueOperatorTokenCommand(
                purpose,
                tokenLifetimeSeconds,
                selectedCapabilities.Order(StringComparer.Ordinal).ToArray()));
        operationResult = ToObjectResult(result);
        if (result.IsSuccess && result.Value is { } issued)
        {
            issuedToken = issued.AccessToken;
            issuedExpiresAt = issued.ExpiresAtUtc;
            issuedCapabilities = issued.Capabilities;
            workspace = workspace with
            {
                ActiveTokens = [
                    issued.Token,
                    .. workspace.ActiveTokens.Where(token => token.Id != issued.Token.Id)
                ]
            };
        }
        issuing = false;
    }

    private async Task RevokeAsync(OperatorTokenSummary token)
    {
        if (revoking || workspace is null)
        {
            return;
        }

        revoking = true;
        var result = await TokenData.RevokeAsync(token.Id);
        operationResult = ToObjectResult(result);
        if (result.IsSuccess)
        {
            revokedPurpose = token.Purpose;
            workspace = workspace with
            {
                ActiveTokens = workspace.ActiveTokens
                    .Where(item => item.Id != token.Id)
                    .ToArray()
            };
            pendingRevokeId = null;
        }
        revoking = false;
    }

    private async Task CopyIssuedTokenAsync()
    {
        if (string.IsNullOrWhiteSpace(issuedToken))
        {
            return;
        }
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", issuedToken);
            tokenCopied = true;
            clipboardUnavailable = false;
        }
        catch (JSException)
        {
            clipboardUnavailable = true;
        }
    }

    private void HideIssuedToken()
    {
        issuedToken = null;
        tokenCopied = false;
        clipboardUnavailable = false;
    }

    private Task PurposeChanged(string? value)
    {
        purpose = value ?? string.Empty;
        SynchronizeRequestUrl();
        return Task.CompletedTask;
    }

    private string LifetimeHelperText => workspace is null
        ? string.Empty
        : L["OperatorTokens.Field.Lifetime.Helper", FormatDuration(workspace.MaximumLifetimeSeconds)].Value;

    private Task LifetimeChanged(int value)
    {
        tokenLifetimeSeconds = value;
        SynchronizeRequestUrl();
        return Task.CompletedTask;
    }

    private Task CapabilityFilterChanged(string? value)
    {
        capabilityFilter = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private void ToggleCapability(string capability, ChangeEventArgs eventArgs)
    {
        if (eventArgs.Value is true)
        {
            selectedCapabilities.Add(capability);
        }
        else
        {
            selectedCapabilities.Remove(capability);
        }

        SynchronizeRequestUrl();
    }

    private void SynchronizeRequestUrl()
    {
        if (workspace is null)
        {
            return;
        }

        // The query string is the shareable draft of this request. Replace the
        // current history entry so checking several capabilities does not make
        // the browser Back button walk through every intermediate checkbox
        // state. Keep all mutation paths above synchronized: removing one of
        // them would make a copied URL silently restore stale permissions.
        var uri = OperatorTokenRequestUrl.Build(
            Navigation,
            purpose,
            tokenLifetimeSeconds,
            selectedCapabilities);
        queryPrepared = true;
        queryUnavailableCapabilities.Clear();
        RevalidateCurrentRequest();
        Navigation.NavigateTo(uri, replace: true);
    }

    private void RevalidateCurrentRequest()
    {
        if (workspace is not { } currentWorkspace)
        {
            return;
        }

        queryValidationErrors.Clear();
        if (purpose.Trim().Length > 120)
        {
            queryValidationErrors.Add(
                L["OperatorTokens.Validation.PurposeLength", 120]);
        }
        if (tokenLifetimeSeconds < 60
            || tokenLifetimeSeconds > currentWorkspace.MaximumLifetimeSeconds)
        {
            queryValidationErrors.Add(
                L[
                    "OperatorTokens.Validation.LifetimeRange",
                    60,
                    currentWorkspace.MaximumLifetimeSeconds]);
        }
        if (selectedCapabilities.Count > currentWorkspace.MaximumCapabilities)
        {
            queryValidationErrors.Add(
                L[
                    "OperatorTokens.Validation.CapabilityLimit",
                    selectedCapabilities.Count,
                    currentWorkspace.MaximumCapabilities]);
        }
    }

    private void PrepareRevoke(string id)
    {
        pendingRevokeId = id;
        revokedPurpose = null;
        operationResult = null;
    }

    private void CancelRevoke() => pendingRevokeId = null;

    private bool MatchesCapabilityFilter(string capability) =>
        string.IsNullOrWhiteSpace(capabilityFilter)
        || capability.Contains(capabilityFilter.Trim(), StringComparison.OrdinalIgnoreCase)
        || L[$"Capability.Group.{CapabilityGroupKey(capability)}"].Value.Contains(
            capabilityFilter.Trim(),
            StringComparison.OrdinalIgnoreCase)
        || CapabilityLabel(capability).Contains(
            capabilityFilter.Trim(),
            StringComparison.OrdinalIgnoreCase);

    private static string CapabilityGroupKey(string capability) => capability switch
    {
        _ when capability.Contains(".users.", StringComparison.Ordinal)
            || capability.Contains(".claims.", StringComparison.Ordinal) => "Identity",
        _ when capability.Contains(".clients.", StringComparison.Ordinal)
            || capability.Contains(".scopes.", StringComparison.Ordinal)
            || capability.Contains(".authorizations.", StringComparison.Ordinal) => "OAuthOidc",
        _ when capability.Contains(".branding.", StringComparison.Ordinal) => "Experience",
        _ when capability.Contains(".vault.", StringComparison.Ordinal) => "Secrets",
        _ => "Operations",
    };

    private static int CapabilityGroupOrder(string group) => group switch
    {
        "Identity" => 10,
        "OAuthOidc" => 20,
        "Operations" => 30,
        "Experience" => 40,
        "Secrets" => 50,
        _ => 100,
    };

    private string CapabilityLabel(string capability) =>
        ManagementCapabilityPresentation.Get(capability, L).Label;

    private string FormatDuration(int seconds) => seconds switch
    {
        3600 => L["OperatorTokens.Duration.OneHour"].Value,
        _ when seconds % 60 is 0 => L["OperatorTokens.Duration.Minutes", seconds / 60].Value,
        _ => L["OperatorTokens.Duration.Seconds", seconds].Value,
    };

    private static string ShortId(string id) => id.Length <= 12
        ? id
        : $"{id[..8]}…{id[^4..]}";

    private string ErrorTitle<T>(ManagementDataResult<T> result) =>
        result.Outcome switch
        {
            ManagementDataOutcome.Invalid => L["OperatorTokens.Error.InvalidTitle"].Value,
            ManagementDataOutcome.Conflict => L["OperatorTokens.Error.ConflictTitle"].Value,
            ManagementDataOutcome.NotFound => L["OperatorTokens.Error.NotFoundTitle"].Value,
            ManagementDataOutcome.Forbidden => L["OperatorTokens.Error.ForbiddenTitle"].Value,
            ManagementDataOutcome.StepUpRequired => L["OperatorTokens.Error.StepUpTitle"].Value,
            ManagementDataOutcome.Unavailable => L["OperatorTokens.Error.UnavailableTitle"].Value,
            _ => L["OperatorTokens.Error.GenericTitle"].Value,
        };

    private static ManagementDataResult<object> ToObjectResult<T>(
        ManagementDataResult<T> result) => result.IsSuccess
            ? ManagementDataResult<object>.Success(new object())
            : ManagementDataResult<object>.Failure(
                result.Outcome,
                result.ErrorMessage,
                result.ErrorField,
                result.ErrorDetails);

    private sealed record CapabilityGroup(
        string Name,
        IReadOnlyList<string> Capabilities);
}
