@page "/provisioning"
@using Microsoft.JSInterop
@attribute [Authorize(Policy = ManagementUiPolicies.ManageProvisioning)]
@inject ManagementProvisioningDataSource ProvisioningData
@inject ManagementProvisioningTokenDataSource TokenData
@inject IJSRuntime JS

<PageTitle>@L["Provisioning.PageTitle"]</PageTitle>

<SUIPageHeader Title="@L["Provisioning.Header.Title"].Value"
            Description="@L["Provisioning.Header.Description"].Value" />

<div class="contract-strip contract-strip--success">
    <SUIIcon Name="shield" Size="20" />
    <div>
        <strong>@L["Provisioning.Contract.Title"]</strong>
        <span>@L["Provisioning.Contract.Description"]</span>
    </div>
    <SUIStatusBadge ToneValue="SUITone.Success">@L["Provisioning.Contract.ActiveBadge"]</SUIStatusBadge>
</div>

<AuthorizeView Policy="@ManagementUiPolicies.ManageProvisioningToken">
    <Authorized>
        <section class="temporary-token-panel" aria-labelledby="temporary-token-heading">
            <div class="temporary-token-panel__copy">
                <div class="temporary-token-panel__heading">
                    <span class="temporary-token-panel__icon">
                        <SUIIcon Name="key" Size="20" />
                    </span>
                    <div>
                        <h2 id="temporary-token-heading">@L["Provisioning.TemporaryToken.Title"]</h2>
                        <p>@L["Provisioning.TemporaryToken.Description"]</p>
                    </div>
                </div>
                <div class="temporary-token-panel__controls" data-sui-align-row>
                    <SUISelect T="int"
                               id="provisioning-token-lifetime"
                               aria-label="@L["Provisioning.TemporaryToken.LifetimeLabel"].Value"
                               Label="@L["Provisioning.TemporaryToken.LifetimeLabel"].Value"
                               Class="temporary-token-field"
                               Disabled="@tokenIssuing"
                               Value="@tokenLifetimeSeconds"
                               ValueChanged="TokenLifetimeChanged">
                        <SUISelectItem Value="@(600)">@L["Provisioning.TemporaryToken.Lifetime10Min"]</SUISelectItem>
                        <SUISelectItem Value="@(900)">@L["Provisioning.TemporaryToken.Lifetime15Min"]</SUISelectItem>
                        <SUISelectItem Value="@(1800)">@L["Provisioning.TemporaryToken.Lifetime30Min"]</SUISelectItem>
                        <SUISelectItem Value="@(3600)">@L["Provisioning.TemporaryToken.Lifetime60Min"]</SUISelectItem>
                    </SUISelect>
                    <SUILoadingButton IsLoading="@tokenIssuing"
                                      Disabled="@tokenIssuing"
                                      VariantValue="SUIVariant.Outlined"
                                      ColorValue="SUIColor.Primary"
                                      OnClick="IssueTemporaryTokenAsync"
                                      aria-busy="@tokenIssuing">
                        <SUIIcon Name="key" Size="17" />
                        <span>@L["Provisioning.TemporaryToken.GenerateButton"]</span>
                    </SUILoadingButton>
                </div>
            </div>

            @if (tokenResult?.IsSuccess is true && temporaryToken is not null)
            {
                <div class="temporary-token-panel__reveal" role="status">
                    <div class="temporary-token-panel__reveal-heading">
                        <div>
                            <strong>@L["Provisioning.TemporaryToken.IssuedTitle"]</strong>
                            <span>@L["Provisioning.TemporaryToken.IssuedDescription"]</span>
                        </div>
                        <SUIStatusBadge ToneValue="SUITone.Warning">@L["Provisioning.TemporaryToken.ExpiresBadge", TokenExpirationLabel]</SUIStatusBadge>
                    </div>
                    <textarea class="temporary-token-value"
                              aria-label="@L["Provisioning.TemporaryToken.ValueAriaLabel"].Value"
                              readonly
                              spellcheck="false"
                              autocomplete="off">@temporaryToken</textarea>
                    <div class="temporary-token-panel__actions">
                        <span class="temporary-token-panel__hint">@L["Provisioning.TemporaryToken.CapabilitiesLabel"].Value <code>identity.provisioning.preview</code> @L["Provisioning.Common.And"].Value <code>identity.provisioning.apply</code></span>
                        <div>
                            <SUIButton VariantValue="SUIVariant.Outlined"
                                       ColorValue="SUIColor.Primary"
                                       OnClick="CopyTemporaryTokenAsync">
                                <SUIIcon Name="copy" Size="17" />
                                @(tokenCopied ? L["Provisioning.TemporaryToken.Copied"] : L["Provisioning.TemporaryToken.CopyButton"])
                            </SUIButton>
                            <SUIButton VariantValue="SUIVariant.Text"
                                       ColorValue="SUIColor.Default"
                                       OnClick="HideTemporaryToken">
                                @L["Provisioning.TemporaryToken.HideButton"]
                            </SUIButton>
                        </div>
                    </div>
                    @if (clipboardUnavailable)
                    {
                        <span class="temporary-token-panel__clipboard-note">@L["Provisioning.TemporaryToken.ClipboardUnavailable"]</span>
                    }
                </div>
            }
            else if (tokenResult?.IsSuccess is true)
            {
                <div class="inline-notice inline-notice--success" role="status">
                    <SUIIcon Name="check" Size="19" />
                    <div>
                        <strong>@L["Provisioning.TemporaryToken.HiddenTitle"]</strong>
                        <span>@L["Provisioning.TemporaryToken.HiddenDescription"]</span>
                    </div>
                </div>
            }
            else if (tokenResult?.IsSuccess is false)
            {
                <div class="inline-notice inline-notice--danger" role="alert">
                    <SUIIcon Name="alert" Size="19" />
                    <div>
                        <strong>@TokenErrorTitle</strong>
                        <span>@tokenResult.ErrorMessage</span>
                    </div>
                </div>
            }
        </section>
    </Authorized>
</AuthorizeView>

<ol class="workflow-steps" aria-label="@L["Provisioning.Workflow.Aria"].Value">
    <li class="@StepClass(1)">
        <span>1</span>
        <div><strong>@L["Provisioning.Workflow.Step1.Title"]</strong><small>@L["Provisioning.Workflow.Step1.Subtitle"]</small></div>
    </li>
    <li class="workflow-connector" aria-hidden="true"></li>
    <li class="@StepClass(2)">
        <span>2</span>
        <div><strong>@L["Provisioning.Workflow.Step2.Title"]</strong><small>@L["Provisioning.Workflow.Step2.Subtitle"]</small></div>
    </li>
    <li class="workflow-connector" aria-hidden="true"></li>
    <li class="@StepClass(3)">
        <span>3</span>
        <div><strong>@L["Capability.Label.Apply"]</strong><small>@L["Provisioning.Workflow.Step3.Subtitle"]</small></div>
    </li>
</ol>

@if (OperationResult?.IsSuccess is false)
{
    <div class="inline-notice inline-notice--danger" role="alert">
        <SUIIcon Name="alert" Size="19" />
        <div>
            <strong>@ErrorTitle</strong>
            <span>@OperationResult.ErrorMessage</span>
            @if (ErrorDetails.Count > 0)
            {
                <ul class="provisioning-errors">
                    @foreach (var error in ErrorDetails)
                    {
                        <li>@error</li>
                    }
                </ul>
            }
        </div>
    </div>
}
else if (applyResult?.IsSuccess is true)
{
    <div class="inline-notice inline-notice--success" role="status">
        <SUIIcon Name="check" Size="19" />
        <div>
            <strong>@L["Provisioning.Applied.Title"]</strong>
            <span>@L["Provisioning.Applied.Description"]</span>
        </div>
    </div>
}

<div class="provisioning-grid">
    <div class="manifest-panel" aria-labelledby="manifest-heading">
        <div class="panel-header">
            <div>
                <h2 id="manifest-heading">@L["Provisioning.Manifest.Heading"]</h2>
                <p>@L["Provisioning.Manifest.Description"]</p>
            </div>
            <SUIStatusBadge ToneValue="SUITone.Neutral">@L["Provisioning.Manifest.SchemaBadge"]</SUIStatusBadge>
        </div>
        <label class="manifest-editor">
            <span class="visually-hidden">@L["Provisioning.Manifest.VisuallyHidden"]</span>
            <textarea spellcheck="false"
                      autocomplete="off"
                      maxlength="@ManagementProvisioningDataSource.MaxManifestLength"
                      aria-describedby="manifest-guidance manifest-count"
                      @bind="ManifestJson"
                      @bind:event="oninput"></textarea>
        </label>
        <footer class="manifest-actions">
            <div>
                <span id="manifest-guidance">@L["Provisioning.Manifest.Guidance"]</span>
                <span id="manifest-count">@L["Provisioning.Manifest.CountFormat", ManifestJson.Length.ToString("N0"), ManagementProvisioningDataSource.MaxManifestLength.ToString("N0")]</span>
            </div>
            <SUILoadingButton IsLoading="@previewing"
                              Disabled="@IsBusy"
                              ColorValue="SUIColor.Primary"
                              OnClick="PreviewAsync"
                              aria-busy="@previewing">
                <SUIIcon Name="search" Size="17" />
                <span>@L["Capability.Label.Preview"]</span>
            </SUILoadingButton>
        </footer>
    </div>

    <aside class="safety-panel" aria-labelledby="safety-heading">
        <span class="safety-panel__icon"><SUIIcon Name="shield" Size="24" /></span>
        <h2 id="safety-heading">@L["Provisioning.Safety.Heading"]</h2>
        <ul class="plain-check-list">
            <li><SUIIcon Name="check" Size="16" /> @L["Provisioning.Safety.Item1"]</li>
            <li><SUIIcon Name="check" Size="16" /> @L["Provisioning.Safety.Item2"]</li>
            <li><SUIIcon Name="check" Size="16" /> @L["Provisioning.Safety.Item3"]</li>
            <li><SUIIcon Name="check" Size="16" /> @L["Provisioning.Safety.Item4"]</li>
        </ul>
        <a href="audit">@L["Provisioning.Safety.AuditLink"] <SUIIcon Name="arrow-right" Size="15" /></a>
    </aside>
</div>

@if (Plan is not null)
{
    <div class="provisioning-plan" aria-labelledby="plan-heading">
        <div class="data-toolbar">
            <div>
                <h2 id="plan-heading">@(applyResult?.IsSuccess is true ? L["Provisioning.Plan.AppliedHeading"] : L["Provisioning.Plan.PreviewHeading"])</h2>
                <p>@PlanSummary</p>
            </div>
            <div class="provisioning-plan__counts" aria-label="@L["Provisioning.Plan.CountsAria"].Value">
                <span><strong>@ChangeCount(IdentityManifestChangeKind.Create)</strong> @L["Provisioning.Plan.CreateLabel"]</span>
                <span><strong>@ChangeCount(IdentityManifestChangeKind.Update)</strong> @L["Provisioning.Plan.UpdateLabel"]</span>
                <span><strong>@ChangeCount(IdentityManifestChangeKind.Unchanged)</strong> @L["Provisioning.Plan.UnchangedLabel"]</span>
            </div>
        </div>

        @if (Plan.Changes.Count is 0)
        {
            <SUIEmptyState Icon="workflow"
                        Title="@L["Provisioning.Plan.EmptyTitle"].Value"
                        Description="@L["Provisioning.Plan.EmptyDescription"].Value" />
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table data-table--provisioning">
                    <thead>
                        <tr>
                            <th scope="col">@L["Provisioning.Plan.Table.Resource"]</th>
                            <th scope="col">@L["Provisioning.Plan.Table.Identifier"]</th>
                            <th scope="col">@L["Provisioning.Plan.Table.Result"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var change in Plan.Changes)
                        {
                            <tr>
                                <td data-label="@L["Provisioning.Plan.Table.Resource"].Value">@ResourceLabel(change.ResourceType)</td>
                                <td data-label="@L["Provisioning.Plan.Table.Identifier"].Value"><code>@change.Identifier</code></td>
                                <td data-label="@L["Provisioning.Plan.Table.Result"].Value">
                                    <SUIStatusBadge ToneValue="@IdentitySuiTone.From(ChangeTone(change.Kind))">
                                        @ChangeLabel(change.Kind)
                                    </SUIStatusBadge>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (applyResult?.IsSuccess is not true)
        {
            <footer class="provisioning-apply">
                @if (Plan.HasChanges)
                {
                    <label class="provisioning-confirmation">
                        <input type="checkbox"
                               disabled="@IsBusy"
                               @bind="confirmed" />
                        <span>
                            <strong>@L["Provisioning.Plan.ConfirmLabel"]</strong>
                            <small>@L["Provisioning.Plan.ConfirmHint"]</small>
                        </span>
                    </label>
                    <SUILoadingButton IsLoading="@applying"
                                      Disabled="@(!CanApply)"
                                      ColorValue="SUIColor.Error"
                                      OnClick="ApplyAsync"
                                      aria-busy="@applying">
                        <SUIIcon Name="workflow" Size="17" />
                        <span>@L["Provisioning.Plan.ApplyButton"]</span>
                    </SUILoadingButton>
                }
                else
                {
                    <span class="provisioning-current">
                        <SUIIcon Name="check" Size="18" />
                        @L["Provisioning.Plan.AlreadyCurrent"]
                    </span>
                }
            </footer>
        }
    </div>
}

@code {
    private const string InitialManifest =
        """
        {
          "schemaVersion": 1,
          "scopes": [],
          "clients": []
        }
        """;

    private string manifestJson = InitialManifest;
    private string? previewedManifest;
    private ManagementDataResult<IdentityProvisioningPlan>? previewResult;
    private ManagementDataResult<IdentityProvisioningPlan>? applyResult;
    private bool previewing;
    private bool applying;
    private bool confirmed;
    private int tokenLifetimeSeconds = 900;
    private bool tokenIssuing;
    private string? temporaryToken;
    private DateTimeOffset? temporaryTokenExpiresAt;
    private bool tokenCopied;
    private bool clipboardUnavailable;
    private ManagementDataResult<ProvisioningTokenIssueResult>? tokenResult;

    private string ManifestJson
    {
        get => manifestJson;
        set
        {
            if (string.Equals(manifestJson, value, StringComparison.Ordinal))
            {
                return;
            }

            manifestJson = value;
            previewedManifest = null;
            previewResult = null;
            applyResult = null;
            confirmed = false;
        }
    }

    private bool IsBusy => previewing || applying || tokenIssuing;

    private string TokenExpirationLabel =>
        temporaryTokenExpiresAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
        ?? L["Provisioning.TemporaryToken.ExpiresSoon"].Value;

    private bool HasFreshPreview =>
        previewResult?.IsSuccess is true
        && string.Equals(
            previewedManifest,
            manifestJson,
            StringComparison.Ordinal);

    private bool CanApply =>
        !IsBusy
        && confirmed
        && HasFreshPreview
        && previewResult?.Value?.HasChanges is true;

    private int CurrentStep =>
        applyResult?.IsSuccess is true
            ? 3
            : HasFreshPreview
                ? 2
                : 1;

    private ManagementDataResult<IdentityProvisioningPlan>? OperationResult =>
        applyResult?.IsSuccess is false
            ? applyResult
            : previewResult?.IsSuccess is false
                ? previewResult
                : null;

    private IdentityProvisioningPlan? Plan =>
        applyResult?.IsSuccess is true
            ? applyResult.Value
            : HasFreshPreview
                ? previewResult?.Value
                : null;

    private IReadOnlyList<string> ErrorDetails =>
        OperationResult?.ErrorDetails ?? [];

    private string ErrorTitle =>
        OperationResult?.Outcome switch
        {
            ManagementDataOutcome.Invalid => L["Provisioning.Error.InvalidTitle"].Value,
            ManagementDataOutcome.Forbidden => L["Provisioning.Error.ForbiddenTitle"].Value,
            ManagementDataOutcome.StepUpRequired => L["Provisioning.Error.StepUpTitle"].Value,
            ManagementDataOutcome.Conflict => L["Provisioning.Error.ConflictTitle"].Value,
            ManagementDataOutcome.Unavailable => L["Provisioning.Error.UnavailableTitle"].Value,
            _ => L["Provisioning.Error.GenericTitle"].Value
        };

    private string TokenErrorTitle =>
        tokenResult?.Outcome switch
        {
            ManagementDataOutcome.Forbidden => L["Provisioning.TokenError.ForbiddenTitle"].Value,
            ManagementDataOutcome.StepUpRequired => L["Provisioning.TokenError.StepUpTitle"].Value,
            ManagementDataOutcome.Conflict => L["Provisioning.TokenError.ConflictTitle"].Value,
            ManagementDataOutcome.Invalid => L["Provisioning.TokenError.InvalidTitle"].Value,
            ManagementDataOutcome.Unavailable => L["Provisioning.TokenError.UnavailableTitle"].Value,
            _ => L["Provisioning.TokenError.GenericTitle"].Value
        };

    private string PlanSummary =>
        Plan?.HasChanges is true
            ? L[
                "Provisioning.Plan.SummaryFormat",
                Plan.Changes.Count(change => change.Kind is not IdentityManifestChangeKind.Unchanged)].Value
            : L["Provisioning.Plan.SummaryEmpty"].Value;

    private async Task PreviewAsync()
    {
        previewing = true;
        confirmed = false;
        applyResult = null;
        previewResult = await ProvisioningData.PreviewAsync(manifestJson);
        previewedManifest = previewResult.IsSuccess
            ? manifestJson
            : null;
        previewing = false;
    }

    private async Task ApplyAsync()
    {
        if (!CanApply)
        {
            return;
        }

        applying = true;
        applyResult = await ProvisioningData.ApplyAsync(manifestJson);
        confirmed = false;
        applying = false;
    }

    private async Task IssueTemporaryTokenAsync()
    {
        if (tokenIssuing)
        {
            return;
        }

        tokenIssuing = true;
        temporaryToken = null;
        temporaryTokenExpiresAt = null;
        tokenCopied = false;
        clipboardUnavailable = false;
        tokenResult = await TokenData.IssueAsync(tokenLifetimeSeconds);
        if (tokenResult.IsSuccess && tokenResult.Value is { } issued)
        {
            temporaryToken = issued.AccessToken;
            temporaryTokenExpiresAt = issued.ExpiresAtUtc;
        }

        tokenIssuing = false;
    }

    private Task TokenLifetimeChanged(int value)
    {
        tokenLifetimeSeconds = value;
        return Task.CompletedTask;
    }

    private async Task CopyTemporaryTokenAsync()
    {
        if (string.IsNullOrWhiteSpace(temporaryToken))
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync(
                "navigator.clipboard.writeText",
                temporaryToken);
            tokenCopied = true;
            clipboardUnavailable = false;
        }
        catch (JSException)
        {
            tokenCopied = false;
            clipboardUnavailable = true;
        }
    }

    private void HideTemporaryToken()
    {
        temporaryToken = null;
        temporaryTokenExpiresAt = null;
        tokenCopied = false;
        clipboardUnavailable = false;
    }

    private string StepClass(int step)
    {
        var classes = "workflow-step";
        if (step == CurrentStep)
        {
            classes += " workflow-step--current";
        }
        else if (step < CurrentStep)
        {
            classes += " workflow-step--complete";
        }

        return classes;
    }

    private int ChangeCount(IdentityManifestChangeKind kind) =>
        Plan?.Changes.Count(change => change.Kind == kind) ?? 0;

    private string ResourceLabel(string resourceType) =>
        resourceType switch
        {
            "client" => L["Provisioning.Resource.Client"].Value,
            "scope" => L["Provisioning.Resource.Scope"].Value,
            _ => resourceType
        };

    private string ChangeLabel(IdentityManifestChangeKind kind) =>
        kind switch
        {
            IdentityManifestChangeKind.Create => L["Capability.Label.Create"].Value,
            IdentityManifestChangeKind.Update => L["Capability.Label.Update"].Value,
            IdentityManifestChangeKind.Unchanged => L["Provisioning.Change.Unchanged"].Value,
            _ => kind.ToString()
        };

    private static string ChangeTone(IdentityManifestChangeKind kind) =>
        kind switch
        {
            IdentityManifestChangeKind.Create => "success",
            IdentityManifestChangeKind.Update => "warning",
            _ => "neutral"
        };
}
