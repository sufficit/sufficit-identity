@page "/provisioning"
@using Microsoft.JSInterop
@attribute [Authorize(Policy = ManagementUiPolicies.ManageProvisioning)]
@inject ManagementProvisioningDataSource ProvisioningData
@inject ManagementProvisioningTokenDataSource TokenData
@inject IJSRuntime JS

<PageTitle>Provisionamento | Sufficit Identity</PageTitle>

<SUIPageHeader Title="Provisionamento"
            Description="Revise e aplique manifestos aditivos de clientes e scopes usando o mesmo caso de uso da API." />

<div class="contract-strip contract-strip--success">
    <SUIIcon Name="shield" Size="20" />
    <div>
        <strong>Operação centralizada e auditável</strong>
        <span>Preview e aplicação passam pela autorização do Management; nenhum segredo é recebido em texto puro.</span>
    </div>
    <SUIStatusBadge ToneValue="SUITone.Success">Ativo</SUIStatusBadge>
</div>

<AuthorizeView Policy="@ManagementUiPolicies.ManageProvisioningToken">
    <Authorized>
        <section class="temporary-token-panel" aria-labelledby="temporary-token-heading">
            <div class="temporary-token-panel__copy">
                <div class="temporary-token-panel__heading">
                    <span class="temporary-token-panel__icon">
                        <SUIIcon Name="key" Size="20" />
                    </span>
                    <div>
                        <h2 id="temporary-token-heading">Token temporário para provisioning</h2>
                        <p>Gere uma credencial curta para usar no terminal ou em uma aplicação. Ela recebe somente preview e apply, exige MFA e nunca é registrada na auditoria.</p>
                    </div>
                </div>
                <div class="temporary-token-panel__controls" data-sui-align-row>
                    <SUISelect T="int"
                               id="provisioning-token-lifetime"
                               aria-label="Validade"
                               Label="Validade"
                               Class="temporary-token-field"
                               Disabled="@tokenIssuing"
                               Value="@tokenLifetimeSeconds"
                               ValueChanged="TokenLifetimeChanged">
                        <SUISelectItem Value="@(600)">10 minutos</SUISelectItem>
                        <SUISelectItem Value="@(900)">15 minutos</SUISelectItem>
                        <SUISelectItem Value="@(1800)">30 minutos</SUISelectItem>
                        <SUISelectItem Value="@(3600)">60 minutos</SUISelectItem>
                    </SUISelect>
                    <SUILoadingButton IsLoading="@tokenIssuing"
                                      Disabled="@tokenIssuing"
                                      VariantValue="SUIVariant.Outlined"
                                      ColorValue="SUIColor.Primary"
                                      OnClick="IssueTemporaryTokenAsync"
                                      aria-busy="@tokenIssuing">
                        <SUIIcon Name="key" Size="17" />
                        <span>Gerar token temporário</span>
                    </SUILoadingButton>
                </div>
            </div>

            @if (tokenResult?.IsSuccess is true && temporaryToken is not null)
            {
                <div class="temporary-token-panel__reveal" role="status">
                    <div class="temporary-token-panel__reveal-heading">
                        <div>
                            <strong>Token emitido uma única vez</strong>
                            <span>Copie agora. Depois de ocultar este valor, ele não poderá ser recuperado pela interface.</span>
                        </div>
                        <SUIStatusBadge ToneValue="SUITone.Warning">Expira @TokenExpirationLabel</SUIStatusBadge>
                    </div>
                    <textarea class="temporary-token-value"
                              aria-label="Token temporário de provisioning"
                              readonly
                              spellcheck="false"
                              autocomplete="off">@temporaryToken</textarea>
                    <div class="temporary-token-panel__actions">
                        <span class="temporary-token-panel__hint">Capacidades: <code>identity.provisioning.preview</code> e <code>identity.provisioning.apply</code></span>
                        <div>
                            <SUIButton VariantValue="SUIVariant.Outlined"
                                       ColorValue="SUIColor.Primary"
                                       OnClick="CopyTemporaryTokenAsync">
                                <SUIIcon Name="copy" Size="17" />
                                @(tokenCopied ? "Copiado" : "Copiar token")
                            </SUIButton>
                            <SUIButton VariantValue="SUIVariant.Text"
                                       ColorValue="SUIColor.Default"
                                       OnClick="HideTemporaryToken">
                                Ocultar token
                            </SUIButton>
                        </div>
                    </div>
                    @if (clipboardUnavailable)
                    {
                        <span class="temporary-token-panel__clipboard-note">A cópia automática não está disponível neste navegador; selecione o valor acima e use Ctrl+C.</span>
                    }
                </div>
            }
            else if (tokenResult?.IsSuccess is true)
            {
                <div class="inline-notice inline-notice--success" role="status">
                    <SUIIcon Name="check" Size="19" />
                    <div>
                        <strong>Token ocultado</strong>
                        <span>O valor não pode ser recuperado pela interface. Emita outro somente se necessário.</span>
                    </div>
                </div>
            }
            else if (tokenResult?.IsSuccess is false)
            {
                <div class="inline-notice inline-notice--danger" role="alert">
                    <SUIIcon Name="alert" Size="19" />
                    <div>
                        <strong>@TokenErrorTitle</strong>
                        <span>@tokenResult.ErrorMessage</span>
                    </div>
                </div>
            }
        </section>
    </Authorized>
</AuthorizeView>

<ol class="workflow-steps" aria-label="Etapas do provisionamento">
    <li class="@StepClass(1)">
        <span>1</span>
        <div><strong>Manifesto</strong><small>Definir intenção</small></div>
    </li>
    <li class="workflow-connector" aria-hidden="true"></li>
    <li class="@StepClass(2)">
        <span>2</span>
        <div><strong>Preview</strong><small>Revisar mudanças</small></div>
    </li>
    <li class="workflow-connector" aria-hidden="true"></li>
    <li class="@StepClass(3)">
        <span>3</span>
        <div><strong>Aplicar</strong><small>Confirmar operação</small></div>
    </li>
</ol>

@if (OperationResult?.IsSuccess is false)
{
    <div class="inline-notice inline-notice--danger" role="alert">
        <SUIIcon Name="alert" Size="19" />
        <div>
            <strong>@ErrorTitle</strong>
            <span>@OperationResult.ErrorMessage</span>
            @if (ErrorDetails.Count > 0)
            {
                <ul class="provisioning-errors">
                    @foreach (var error in ErrorDetails)
                    {
                        <li>@error</li>
                    }
                </ul>
            }
        </div>
    </div>
}
else if (applyResult?.IsSuccess is true)
{
    <div class="inline-notice inline-notice--success" role="status">
        <SUIIcon Name="check" Size="19" />
        <div>
            <strong>Manifesto aplicado</strong>
            <span>A operação foi concluída de forma transacional e registrada na auditoria.</span>
        </div>
    </div>
}

<div class="provisioning-grid">
    <div class="manifest-panel" aria-labelledby="manifest-heading">
        <div class="panel-header">
            <div>
                <h2 id="manifest-heading">Manifesto JSON</h2>
                <p>Edite ou cole o contrato declarativo completo antes de gerar o preview.</p>
            </div>
            <SUIStatusBadge ToneValue="SUITone.Neutral">Schema v1</SUIStatusBadge>
        </div>
        <label class="manifest-editor">
            <span class="visually-hidden">Conteúdo do manifesto JSON</span>
            <textarea spellcheck="false"
                      autocomplete="off"
                      maxlength="@ManagementProvisioningDataSource.MaxManifestLength"
                      aria-describedby="manifest-guidance manifest-count"
                      @bind="ManifestJson"
                      @bind:event="oninput"></textarea>
        </label>
        <footer class="manifest-actions">
            <div>
                <span id="manifest-guidance">Use somente referências externas para segredos.</span>
                <span id="manifest-count">@ManifestJson.Length.ToString("N0") de @ManagementProvisioningDataSource.MaxManifestLength.ToString("N0") caracteres</span>
            </div>
            <SUILoadingButton IsLoading="@previewing"
                              Disabled="@IsBusy"
                              ColorValue="SUIColor.Primary"
                              OnClick="PreviewAsync"
                              aria-busy="@previewing">
                <SUIIcon Name="search" Size="17" />
                <span>Gerar preview</span>
            </SUILoadingButton>
        </footer>
    </div>

    <aside class="safety-panel" aria-labelledby="safety-heading">
        <span class="safety-panel__icon"><SUIIcon Name="shield" Size="24" /></span>
        <h2 id="safety-heading">Garantias do fluxo</h2>
        <ul class="plain-check-list">
            <li><SUIIcon Name="check" Size="16" /> Preview não altera o banco</li>
            <li><SUIIcon Name="check" Size="16" /> Objetos omitidos não são excluídos</li>
            <li><SUIIcon Name="check" Size="16" /> Segredos usam referência externa</li>
            <li><SUIIcon Name="check" Size="16" /> Apply e auditoria usam a mesma transação</li>
        </ul>
        <a href="audit">Consultar trilha de auditoria <SUIIcon Name="arrow-right" Size="15" /></a>
    </aside>
</div>

@if (Plan is not null)
{
    <div class="provisioning-plan" aria-labelledby="plan-heading">
        <div class="data-toolbar">
            <div>
                <h2 id="plan-heading">@(applyResult?.IsSuccess is true ? "Mudanças aplicadas" : "Preview do manifesto")</h2>
                <p>@PlanSummary</p>
            </div>
            <div class="provisioning-plan__counts" aria-label="Resumo das mudanças">
                <span><strong>@ChangeCount(IdentityManifestChangeKind.Create)</strong> criar</span>
                <span><strong>@ChangeCount(IdentityManifestChangeKind.Update)</strong> atualizar</span>
                <span><strong>@ChangeCount(IdentityManifestChangeKind.Unchanged)</strong> sem mudança</span>
            </div>
        </div>

        @if (Plan.Changes.Count is 0)
        {
            <SUIEmptyState Icon="workflow"
                        Title="Manifesto vazio"
                        Description="Nenhum cliente ou scope foi declarado. Nada será alterado." />
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table data-table--provisioning">
                    <thead>
                        <tr>
                            <th scope="col">Recurso</th>
                            <th scope="col">Identificador</th>
                            <th scope="col">Resultado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var change in Plan.Changes)
                        {
                            <tr>
                                <td data-label="Recurso">@ResourceLabel(change.ResourceType)</td>
                                <td data-label="Identificador"><code>@change.Identifier</code></td>
                                <td data-label="Resultado">
                                    <SUIStatusBadge ToneValue="@IdentitySuiTone.From(ChangeTone(change.Kind))">
                                        @ChangeLabel(change.Kind)
                                    </SUIStatusBadge>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (applyResult?.IsSuccess is not true)
        {
            <footer class="provisioning-apply">
                @if (Plan.HasChanges)
                {
                    <label class="provisioning-confirmation">
                        <input type="checkbox"
                               disabled="@IsBusy"
                               @bind="confirmed" />
                        <span>
                            <strong>Confirmo a aplicação deste preview</strong>
                            <small>Somente os itens marcados como criar ou atualizar serão modificados.</small>
                        </span>
                    </label>
                    <SUILoadingButton IsLoading="@applying"
                                      Disabled="@(!CanApply)"
                                      ColorValue="SUIColor.Error"
                                      OnClick="ApplyAsync"
                                      aria-busy="@applying">
                        <SUIIcon Name="workflow" Size="17" />
                        <span>Aplicar manifesto</span>
                    </SUILoadingButton>
                }
                else
                {
                    <span class="provisioning-current">
                        <SUIIcon Name="check" Size="18" />
                        O ambiente já corresponde ao manifesto.
                    </span>
                }
            </footer>
        }
    </div>
}

@code {
    private const string InitialManifest =
        """
        {
          "schemaVersion": 1,
          "scopes": [],
          "clients": []
        }
        """;

    private string manifestJson = InitialManifest;
    private string? previewedManifest;
    private ManagementDataResult<IdentityProvisioningPlan>? previewResult;
    private ManagementDataResult<IdentityProvisioningPlan>? applyResult;
    private bool previewing;
    private bool applying;
    private bool confirmed;
    private int tokenLifetimeSeconds = 900;
    private bool tokenIssuing;
    private string? temporaryToken;
    private DateTimeOffset? temporaryTokenExpiresAt;
    private bool tokenCopied;
    private bool clipboardUnavailable;
    private ManagementDataResult<ProvisioningTokenIssueResult>? tokenResult;

    private string ManifestJson
    {
        get => manifestJson;
        set
        {
            if (string.Equals(manifestJson, value, StringComparison.Ordinal))
            {
                return;
            }

            manifestJson = value;
            previewedManifest = null;
            previewResult = null;
            applyResult = null;
            confirmed = false;
        }
    }

    private bool IsBusy => previewing || applying || tokenIssuing;

    private string TokenExpirationLabel =>
        temporaryTokenExpiresAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
        ?? "em breve";

    private bool HasFreshPreview =>
        previewResult?.IsSuccess is true
        && string.Equals(
            previewedManifest,
            manifestJson,
            StringComparison.Ordinal);

    private bool CanApply =>
        !IsBusy
        && confirmed
        && HasFreshPreview
        && previewResult?.Value?.HasChanges is true;

    private int CurrentStep =>
        applyResult?.IsSuccess is true
            ? 3
            : HasFreshPreview
                ? 2
                : 1;

    private ManagementDataResult<IdentityProvisioningPlan>? OperationResult =>
        applyResult?.IsSuccess is false
            ? applyResult
            : previewResult?.IsSuccess is false
                ? previewResult
                : null;

    private IdentityProvisioningPlan? Plan =>
        applyResult?.IsSuccess is true
            ? applyResult.Value
            : HasFreshPreview
                ? previewResult?.Value
                : null;

    private IReadOnlyList<string> ErrorDetails =>
        OperationResult?.ErrorDetails ?? [];

    private string ErrorTitle =>
        OperationResult?.Outcome switch
        {
            ManagementDataOutcome.Invalid => "Manifesto inválido — corrija os itens abaixo",
            ManagementDataOutcome.Forbidden => "Capability de provisioning ausente",
            ManagementDataOutcome.StepUpRequired => "MFA necessário para continuar",
            ManagementDataOutcome.Conflict => "Configuração do Identity impede a operação",
            ManagementDataOutcome.Unavailable => "Identity não respondeu à operação",
            _ => "A operação não foi concluída"
        };

    private string TokenErrorTitle =>
        tokenResult?.Outcome switch
        {
            ManagementDataOutcome.Forbidden => "Capability de emissão ausente",
            ManagementDataOutcome.StepUpRequired => "MFA necessário para emitir o token",
            ManagementDataOutcome.Conflict => "Emissão temporária desabilitada ou incompleta",
            ManagementDataOutcome.Invalid => "Validade do token inválida",
            ManagementDataOutcome.Unavailable => "Identity não respondeu à emissão",
            _ => "O token não foi emitido"
        };

    private string PlanSummary =>
        Plan?.HasChanges is true
            ? $"{Plan.Changes.Count(change => change.Kind is not IdentityManifestChangeKind.Unchanged)} mudança(s) efetiva(s) encontrada(s)."
            : "Nenhuma mudança efetiva foi encontrada.";

    private async Task PreviewAsync()
    {
        previewing = true;
        confirmed = false;
        applyResult = null;
        previewResult = await ProvisioningData.PreviewAsync(manifestJson);
        previewedManifest = previewResult.IsSuccess
            ? manifestJson
            : null;
        previewing = false;
    }

    private async Task ApplyAsync()
    {
        if (!CanApply)
        {
            return;
        }

        applying = true;
        applyResult = await ProvisioningData.ApplyAsync(manifestJson);
        confirmed = false;
        applying = false;
    }

    private async Task IssueTemporaryTokenAsync()
    {
        if (tokenIssuing)
        {
            return;
        }

        tokenIssuing = true;
        temporaryToken = null;
        temporaryTokenExpiresAt = null;
        tokenCopied = false;
        clipboardUnavailable = false;
        tokenResult = await TokenData.IssueAsync(tokenLifetimeSeconds);
        if (tokenResult.IsSuccess && tokenResult.Value is { } issued)
        {
            temporaryToken = issued.AccessToken;
            temporaryTokenExpiresAt = issued.ExpiresAtUtc;
        }

        tokenIssuing = false;
    }

    private Task TokenLifetimeChanged(int value)
    {
        tokenLifetimeSeconds = value;
        return Task.CompletedTask;
    }

    private async Task CopyTemporaryTokenAsync()
    {
        if (string.IsNullOrWhiteSpace(temporaryToken))
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync(
                "navigator.clipboard.writeText",
                temporaryToken);
            tokenCopied = true;
            clipboardUnavailable = false;
        }
        catch (JSException)
        {
            tokenCopied = false;
            clipboardUnavailable = true;
        }
    }

    private void HideTemporaryToken()
    {
        temporaryToken = null;
        temporaryTokenExpiresAt = null;
        tokenCopied = false;
        clipboardUnavailable = false;
    }

    private string StepClass(int step)
    {
        var classes = "workflow-step";
        if (step == CurrentStep)
        {
            classes += " workflow-step--current";
        }
        else if (step < CurrentStep)
        {
            classes += " workflow-step--complete";
        }

        return classes;
    }

    private int ChangeCount(IdentityManifestChangeKind kind) =>
        Plan?.Changes.Count(change => change.Kind == kind) ?? 0;

    private static string ResourceLabel(string resourceType) =>
        resourceType switch
        {
            "client" => "Cliente",
            "scope" => "Scope",
            _ => resourceType
        };

    private static string ChangeLabel(IdentityManifestChangeKind kind) =>
        kind switch
        {
            IdentityManifestChangeKind.Create => "Criar",
            IdentityManifestChangeKind.Update => "Atualizar",
            IdentityManifestChangeKind.Unchanged => "Sem mudança",
            _ => kind.ToString()
        };

    private static string ChangeTone(IdentityManifestChangeKind kind) =>
        kind switch
        {
            IdentityManifestChangeKind.Create => "success",
            IdentityManifestChangeKind.Update => "warning",
            _ => "neutral"
        };
}
