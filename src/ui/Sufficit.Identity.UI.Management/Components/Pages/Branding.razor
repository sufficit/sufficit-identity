@page "/branding"
@using System.Text.RegularExpressions
@using Microsoft.JSInterop
@attribute [Authorize(Policy = ManagementUiPolicies.ManageBranding)]
@inject ManagementBrandingDataSource BrandingData
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Branding | Sufficit Identity</PageTitle>

<SUIPageHeader Title="Branding"
            Description="@L["Branding.HeaderDescription"].Value">
    <Actions>
        <SUIButton ColorValue="SUIColor.Secondary"
                   StartIcon="refresh"
                   Disabled="@busy"
                   OnClick="RefreshAsync">
            @L["Branding.Refresh"]
        </SUIButton>
        <SUIButton ColorValue="SUIColor.Primary"
                   StartIcon="plus"
                   Disabled="@busy"
                   OnClick="BeginCreate">
            @L["Branding.NewTheme"]
        </SUIButton>
    </Actions>
</SUIPageHeader>

<div class="contract-strip contract-strip--success">
    <SUIIcon Name="shield" Size="20" />
    <div>
        <strong>@L["Branding.SingleSourceOfTruth.Title"]</strong>
        <span>@L["Branding.SingleSourceOfTruth.Description"]</span>
    </div>
    <SUIStatusBadge ToneValue="SUITone.Success">@L["Branding.Integrated"]</SUIStatusBadge>
</div>

@if (ActiveThemeCount > 1)
{
    <div class="inline-notice inline-notice--danger" role="alert">
        <SUIIcon Name="alert" Size="19" />
        <div>
            <strong>@L["Branding.MultipleActiveThemes.Title"]</strong>
            <span>@L["Branding.MultipleActiveThemes.Description"]</span>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="inline-notice inline-notice--success" role="status">
        <SUIIcon Name="check" Size="19" />
        <div>
            <strong>@L["Branding.Updated"]</strong>
            <span>@successMessage</span>
        </div>
    </div>
}

@if (operation?.IsSuccess is false)
{
    <div class="inline-notice inline-notice--danger" role="alert">
        <SUIIcon Name="alert" Size="19" />
        <div>
            <strong>@L["Branding.OperationError.Title"]</strong>
            <span>@operation.ErrorMessage</span>
        </div>
    </div>
}

<div class="branding-workspace">
    <div class="panel branding-themes" aria-labelledby="themes-heading">
        <div class="panel-header">
            <div>
                <h2 id="themes-heading">@L["Branding.SavedConfigurations"]</h2>
            </div>
            @if (!loading && themes.Count > 0)
            {
                <SUIStatusBadge ToneValue="SUITone.Neutral">@themes.Count</SUIStatusBadge>
            }
        </div>

        <ManagementDataView Result="loadResult"
                            Loading="loading"
                            OnRetry="RefreshAsync"
                            UnavailableTitle="@L["Branding.LoadError.Title"].Value">
            <LoadingContent>
                <div class="theme-list theme-list--loading"
                     aria-label="@L["Branding.LoadingThemes"].Value">
                    <div class="theme-row-skeleton"></div>
                    <div class="theme-row-skeleton"></div>
                </div>
            </LoadingContent>
            <Success Context="_">
        @if (themes.Count is 0)
        {
            <SUIEmptyState Icon="palette"
                        Title="@L["Branding.NoThemes.Title"].Value"
                        Description="@L["Branding.NoThemes.Description"].Value">
                <Actions>
                    <SUIButton ColorValue="SUIColor.Primary"
                               OnClick="BeginCreate">
                        @L["Branding.CreateTheme"]
                    </SUIButton>
                </Actions>
            </SUIEmptyState>
        }
        else
        {
            <div class="theme-list" role="radiogroup" aria-labelledby="themes-heading">
                <SUIStack Spacing="2">
                    @foreach (var theme in themes)
                    {
                        <SUIChoiceCard TValue="int"
                                       @key="theme.Id"
                                       Name="branding-theme"
                                       Value="@theme.Id"
                                       SelectedValue="@(Selected?.Id ?? 0)"
                                       SelectedValueChanged="SelectById"
                                       Title="@theme.Name"
                                       Description="@ThemeIdentity(theme)">
                            <IconContent>
                                <span class="theme-row__mark" aria-hidden="true">@ColorFill(theme.BrandColor)</span>
                            </IconContent>
                            <TrailingContent>
                                @if (theme.IsActive)
                                {
                                    <SUIStatusBadge ToneValue="SUITone.Success">@L["Branding.Active"]</SUIStatusBadge>
                                }
                            </TrailingContent>
                        </SUIChoiceCard>
                    }
                </SUIStack>
            </div>
        }
            </Success>
        </ManagementDataView>
    </div>

    <div class="brand-preview-panel" aria-labelledby="brand-preview-heading">
        @if (Selected is null)
        {
            <SUIEmptyState Icon="palette"
                        Title="@L["Branding.SelectTheme"].Value"
                        Description="@L["Branding.PreviewUsesPersistedValues"].Value" />
        }
        else if (Selected is { } theme)
        {
            <div class="brand-preview-panel__header">
                <div>
                    <h2 id="brand-preview-heading">@theme.Name</h2>
                </div>
                <SUIStatusBadge ToneValue="@(theme.IsActive ? SUITone.Success : SUITone.Neutral)">
                    @(theme.IsActive ? L["Branding.Published"] : L["Branding.Draft"])
                </SUIStatusBadge>
            </div>

            @* Sample of the public sign-in page, not controls of this page: the
               blocks imitate the login card and stay plain markup. *@
            <div class="identity-preview" @ref="previewElement">
                <div class="identity-preview__top">
                    <img @key="PreviewHeaderIcon"
                         src="@PreviewHeaderIcon"
                         width="32"
                         height="32"
                         alt=""
                         @onerror="UseHeaderFallback" />
                    <span>@ThemeIdentity(theme)</span>
                    @if (PreviewBackgroundUrl is not null)
                    {
                        <span class="identity-preview__asset-badge">@L["Branding.CustomBackground"]</span>
                    }
                </div>
                <div class="identity-preview__body">
                    <div class="identity-preview__card">
                        <img @key="PreviewLogo"
                             class="identity-preview__logo"
                             src="@PreviewLogo"
                             alt="@ThemeIdentity(theme)"
                             @onerror="UseLogoFallback" />
                        <div class="preview-line"></div>
                        <div class="preview-field"></div>
                        <div class="preview-line preview-line--short"></div>
                        <div class="preview-field"></div>
                        <div class="preview-button"></div>
                    </div>
                </div>
            </div>

            <dl class="token-list">
                <div>
                    <dt>@L["Branding.Field.Brand"]</dt>
                    <dd>
                        <span class="color-swatch" aria-hidden="true">@ColorFill(theme.BrandColor)</span>
                        <code>@DisplayColor(theme.BrandColor)</code>
                    </dd>
                </div>
                <div>
                    <dt>@L["Branding.Field.SoftHighlight"]</dt>
                    <dd>
                        <span class="color-swatch" aria-hidden="true">@ColorFill(theme.BrandSoftColor)</span>
                        <code>@DisplayColor(theme.BrandSoftColor)</code>
                    </dd>
                </div>
                <div>
                    <dt>@L["Branding.Field.UpdatedAt"]</dt>
                    <dd><time datetime="@theme.UpdatedAt.ToString("O")">@FormatDate(theme.UpdatedAt)</time></dd>
                </div>
            </dl>

            <SUIStack Row Wrap AlignItems="Center" Justify="End" Spacing="2" Class="brand-preview-actions">
                <SUIButton ColorValue="SUIColor.Secondary"
                           StartIcon="edit"
                           Disabled="@busy"
                           OnClick="BeginEdit">
                    @L["Branding.EditTheme"]
                </SUIButton>
                @if (!theme.IsActive)
                {
                    <SUILoadingButton ColorValue="SUIColor.Primary"
                                      StartIcon="check"
                                      IsLoading="@activating"
                                      Disabled="@busy"
                                      OnClick="ActivateAsync">
                        @(activating ? L["Branding.Publishing"] : L["Branding.PublishTheme"])
                    </SUILoadingButton>
                }
            </SUIStack>
        }
    </div>
</div>

@if (editing)
{
    <div>
    <EditForm Model="model"
              OnValidSubmit="SaveAsync"
              FormName="branding-theme"
              class="management-form branding-form">
        <DataAnnotationsValidator />

        <div class="form-section" aria-labelledby="branding-identity-heading">
            <div class="form-section__heading">
                <h2 id="branding-identity-heading">@(creating ? L["Branding.NewTheme"] : L["Branding.EditTheme"])</h2>
                <p>@L["Branding.Form.IdentityHelp"]</p>
            </div>

            <SUIFormGrid Columns="2">
                <IdentityTextField T="string"
                                   Id="theme-name"
                                   Label="@L["Branding.Field.ThemeName"].Value"
                                   @bind-Value="model.Name"
                                   autocomplete="off" />
                <IdentityTextField T="string"
                                   Id="theme-title"
                                   Label="@L["Branding.Field.BrowserTitle"].Value"
                                   @bind-Value="model.Title"
                                   autocomplete="off" />
                <IdentityTextField T="string"
                                   Id="brand-name"
                                   Label="@L["Branding.Field.BrandName"].Value"
                                   @bind-Value="model.BrandName"
                                   autocomplete="off" />
                <IdentityTextField T="string"
                                   Id="brand-subtitle"
                                   Label="@L["Branding.Field.BrandSubtitle"].Value"
                                   @bind-Value="model.BrandSubtitle"
                                   autocomplete="off" />
            </SUIFormGrid>
        </div>

        <div class="form-section" aria-labelledby="branding-assets-heading">
            <div class="form-section__heading">
                <h2 id="branding-assets-heading">@L["Branding.Form.AssetsTitle"]</h2>
                <p>@L["Branding.Form.AssetsHelp"]</p>
            </div>

            <SUIFormGrid Columns="2">
                <IdentityTextField T="string"
                                   Id="logo-url"
                                   Label="@L["Branding.Field.MainLogo"].Value"
                                   @bind-Value="model.LogoUrl"
                                   autocomplete="url" />
                <IdentityTextField T="string"
                                   Id="header-icon-url"
                                   Label="@L["Branding.Field.HeaderIcon"].Value"
                                   @bind-Value="model.HeaderIconUrl"
                                   autocomplete="url" />
                <IdentityTextField T="string"
                                   Id="favicon-url"
                                   Label="Favicon"
                                   @bind-Value="model.FaviconUrl"
                                   autocomplete="url" />
                @* Immediate: the preview background follows every keystroke. *@
                <IdentityTextField T="string"
                                   Id="background-url"
                                   Label="@L["Branding.Field.BackgroundImage"].Value"
                                   HelperText="@L["Branding.Form.BackgroundHint"].Value"
                                   Immediate="true"
                                   @bind-Value="model.BackgroundImageUrl"
                                   autocomplete="url" />
            </SUIFormGrid>
        </div>

        <div class="form-section" aria-labelledby="branding-colors-heading">
            <div class="form-section__heading">
                <h2 id="branding-colors-heading">@L["Branding.Form.ColorsTitle"]</h2>
                <p>@L["Branding.Form.ColorsHelp"]</p>
            </div>

            <SUIFormGrid Columns="4" MinColumnWidth="10rem">
                <IdentityTextField T="string"
                                   Id="brand-color"
                                   Label="@L["Branding.Field.Brand"].Value"
                                   Placeholder="#cc0000"
                                   @bind-Value="model.BrandColor"
                                   autocomplete="off" />
                <IdentityTextField T="string"
                                   Id="brand-hover-color"
                                   Label="@L["Branding.Field.Interaction"].Value"
                                   Placeholder="#a30000"
                                   @bind-Value="model.BrandHoverColor"
                                   autocomplete="off" />
                <IdentityTextField T="string"
                                   Id="brand-soft-color"
                                   Label="@L["Branding.Field.SoftBackground"].Value"
                                   Placeholder="#fbe9e9"
                                   @bind-Value="model.BrandSoftColor"
                                   autocomplete="off" />
                <IdentityTextField T="string"
                                   Id="theme-color"
                                   Label="@L["Branding.Field.Browser"].Value"
                                   Placeholder="#cc0000"
                                   @bind-Value="model.ThemeColor"
                                   autocomplete="off" />
            </SUIFormGrid>
        </div>

        <div class="form-section" aria-labelledby="branding-avatar-heading">
            <div class="form-section__heading">
                <h2 id="branding-avatar-heading">@L["Branding.Form.AvatarsTitle"]</h2>
                <p>@L["Branding.Form.AvatarsHelp"]</p>
            </div>
            <IdentityTextField T="string"
                               Id="avatar-url-template"
                               Label="@L["Branding.Field.AvatarUrlTemplate"].Value"
                               @bind-Value="model.AvatarUrlTemplate"
                               autocomplete="off" />
        </div>

        <SUIStack Row Wrap AlignItems="Center" Justify="End" Spacing="2" Class="form-actions">
            <SUIButton ColorValue="SUIColor.Secondary"
                       Disabled="@saving"
                       OnClick="CancelEdit">
                @L["Branding.Cancel"]
            </SUIButton>
            <SUILoadingButton ButtonTypeValue="SUIButtonType.Submit"
                              ColorValue="SUIColor.Primary"
                              StartIcon="check"
                              IsLoading="@saving"
                              Disabled="@saving">
                @(saving ? L["Branding.Saving"] : creating ? L["Branding.CreateTheme"] : L["Branding.SaveChanges"])
            </SUILoadingButton>
        </SUIStack>
    </EditForm>
    </div>
}

@if (Selected is { IsActive: false } selectedTheme && !editing)
{
    <div class="danger-zone" aria-labelledby="delete-theme-heading">
        <div>
            <h2 id="delete-theme-heading">@L["Branding.DeleteTheme"]</h2>
            <p>@L["Branding.DeleteTheme.Description"]</p>
        </div>

        @if (!confirmingDelete)
        {
            <SUIButton ColorValue="SUIColor.Error"
                       StartIcon="trash"
                       Disabled="@busy"
                       OnClick="BeginDelete">
                @L["Branding.DeleteTheme"]
            </SUIButton>
        }
        else
        {
            <SUIStack Spacing="2">
                <IdentityTextField T="string"
                                   Id="delete-theme-confirmation"
                                   Label="@($"{L["Branding.DeleteConfirmPrefix"].Value} {selectedTheme.Name} {L["Branding.DeleteConfirmSuffix"].Value}")"
                                   Immediate="true"
                                   @bind-Value="deleteConfirmation"
                                   autocomplete="off" />
                <SUIStack Row Wrap AlignItems="Center" Justify="End" Spacing="2">
                    <SUIButton ColorValue="SUIColor.Secondary"
                               Disabled="@deleting"
                               OnClick="CancelDelete">
                        @L["Branding.Cancel"]
                    </SUIButton>
                    <SUILoadingButton ColorValue="SUIColor.Error"
                                      StartIcon="trash"
                                      IsLoading="@deleting"
                                      Disabled="@(!CanDelete)"
                                      OnClick="DeleteAsync">
                        @(deleting ? L["Branding.Deleting"] : L["Branding.ConfirmDeletion"])
                    </SUILoadingButton>
                </SUIStack>
            </SUIStack>
        }
    </div>
}

@code {
    // The reader's zone once the browser answers (BrowserTimeProvider in the layout).
    [CascadingParameter]
    private BrowserTime Time { get; set; } = BrowserTime.Server;

    private const string FallbackIcon =
        "/_content/Sufficit.Identity.UI.Management/img/logo-mark.png";

    private IReadOnlyList<ManagementBrandingTheme> themes = [];
    private ManagementDataResult<IReadOnlyList<ManagementBrandingTheme>>?
        loadResult;
    private ManagementDataResult<object>? operation;
    private ManagementBrandingTheme? Selected { get; set; }
    private BrandingEditModel model = new();
    private bool loading = true;
    private bool editing;
    private bool creating;
    private bool saving;
    private bool activating;
    private bool deleting;
    private bool confirmingDelete;
    private bool headerFallback;
    private bool logoFallback;
    private string deleteConfirmation = string.Empty;
    private string? successMessage;

    private bool busy => loading || saving || activating || deleting;
    private int ActiveThemeCount => themes.Count(theme => theme.IsActive);
    private bool CanDelete =>
        !deleting
        && Selected is { IsActive: false }
        && string.Equals(
            deleteConfirmation,
            Selected.Name,
            StringComparison.Ordinal);
    private string PreviewHeaderIcon =>
        headerFallback
            ? FallbackIcon
            : (editing ? model.HeaderIconUrl : Selected?.HeaderIconUrl) ?? FallbackIcon;
    private string PreviewLogo =>
        logoFallback
            ? FallbackIcon
            : (editing ? model.LogoUrl : Selected?.LogoUrl) ?? FallbackIcon;
    private string? PreviewBackgroundUrl =>
        SafePreviewImageUrl(editing ? model.BackgroundImageUrl : Selected?.BackgroundImageUrl);
    private ElementReference previewElement;
    private IJSObjectReference? previewModule;
    private (string? Element, string Variables)? appliedPreview;

    // The preview's colors and background change as the operator types, and
    // the CSP allows no inline style attribute. They are set through CSSOM
    // (element.style.setProperty), which the policy does not govern.
    private Dictionary<string, string> PreviewVariables =>
        BuildPreviewVariables(
            editing ? model.BrandColor : Selected?.BrandColor,
            editing ? model.BrandSoftColor : Selected?.BrandSoftColor,
            PreviewBackgroundUrl);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Selected is null || previewElement.Id is null)
        {
            return;
        }

        var variables = PreviewVariables;
        var applied = (previewElement.Id, string.Join(';', variables.Select(pair => $"{pair.Key}:{pair.Value}")));
        if (appliedPreview == applied)
        {
            return;
        }

        try
        {
            previewModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Sufficit.Identity.UI.Management/Components/Pages/Branding.razor.js");
            await previewModule.InvokeVoidAsync("setVariables", previewElement, variables);
            appliedPreview = applied;
        }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        if (previewModule is not null)
        {
            try
            {
                await previewModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        model.Localizer = L;
        await LoadAsync();
    }

    private async Task RefreshAsync() =>
        await LoadAsync(Selected?.Id);

    private async Task LoadAsync(int? preferredId = null)
    {
        loading = true;
        loadResult = await BrandingData.GetThemesAsync();
        themes = loadResult.Value ?? [];
        Selected = preferredId is null
            ? themes.FirstOrDefault(theme => theme.IsActive)
                ?? themes.FirstOrDefault()
            : themes.FirstOrDefault(theme => theme.Id == preferredId)
                ?? themes.FirstOrDefault(theme => theme.IsActive)
                ?? themes.FirstOrDefault();
        ResetPreviewFallbacks();
        loading = false;
    }

    private void SelectById(int id)
    {
        if (themes.FirstOrDefault(theme => theme.Id == id) is { } theme)
        {
            Select(theme);
        }
    }

    private void Select(ManagementBrandingTheme theme)
    {
        Selected = theme;
        operation = null;
        successMessage = null;
        confirmingDelete = false;
        ResetPreviewFallbacks();
    }

    private void BeginCreate()
    {
        model = BrandingEditModel.CreateDefault();
        model.Localizer = L;
        creating = true;
        editing = true;
        operation = null;
        successMessage = null;
    }

    private void BeginEdit()
    {
        if (Selected is null)
        {
            return;
        }

        model = BrandingEditModel.From(Selected);
        model.Localizer = L;
        creating = false;
        editing = true;
        operation = null;
        successMessage = null;
    }

    private void CancelEdit()
    {
        editing = false;
        creating = false;
        operation = null;
    }

    private async Task SaveAsync()
    {
        if (saving)
        {
            return;
        }

        saving = true;
        var command = model.ToCommand();
        if (creating)
        {
            var created = await BrandingData.CreateThemeAsync(command);
            operation = Box(created);
            if (created.IsSuccess && created.Value is not null)
            {
                successMessage = L["Branding.Success.Created", created.Value.Name].Value;
                editing = false;
                creating = false;
                await LoadAsync(created.Value.Id);
            }
        }
        else if (Selected is not null)
        {
            var updated = await BrandingData.UpdateThemeAsync(
                Selected.Id,
                command);
            operation = Box(updated);
            if (updated.IsSuccess && updated.Value is not null)
            {
                successMessage = L["Branding.Success.Updated", updated.Value.Name].Value;
                editing = false;
                await LoadAsync(updated.Value.Id);
            }
        }
        saving = false;
    }

    private async Task ActivateAsync()
    {
        if (Selected is null || activating)
        {
            return;
        }

        activating = true;
        var activated = await BrandingData.ActivateThemeAsync(Selected.Id);
        operation = Box(activated);
        if (activated.IsSuccess && activated.Value is not null)
        {
            successMessage = L["Branding.Success.Activated", activated.Value.Name].Value;
            await LoadAsync(activated.Value.Id);
        }
        activating = false;
    }

    private void BeginDelete()
    {
        confirmingDelete = true;
        deleteConfirmation = string.Empty;
        operation = null;
    }

    private void CancelDelete()
    {
        confirmingDelete = false;
        deleteConfirmation = string.Empty;
    }

    private async Task DeleteAsync()
    {
        if (!CanDelete || Selected is null)
        {
            return;
        }

        deleting = true;
        var deletedName = Selected.Name;
        var deleted = await BrandingData.DeleteThemeAsync(Selected.Id);
        operation = Box(deleted);
        if (deleted.IsSuccess)
        {
            successMessage = L["Branding.Success.Deleted", deletedName].Value;
            confirmingDelete = false;
            await LoadAsync();
        }
        deleting = false;
    }

    private void ResetPreviewFallbacks()
    {
        headerFallback = false;
        logoFallback = false;
    }

    private void UseHeaderFallback() => headerFallback = true;

    private void UseLogoFallback() => logoFallback = true;

    private static string ThemeIdentity(ManagementBrandingTheme theme)
    {
        var parts = new[] { theme.BrandName, theme.BrandSubtitle }
            .Where(value => !string.IsNullOrWhiteSpace(value));
        var value = string.Join(' ', parts);
        return string.IsNullOrWhiteSpace(value)
            ? theme.Title ?? theme.Name
            : value;
    }

    private static Dictionary<string, string> BuildPreviewVariables(
        string? brandColor,
        string? brandSoftColor,
        string? backgroundImageUrl) =>
        new()
        {
            ["--preview-brand"] = brandColor ?? "#cc0000",
            ["--preview-brand-soft"] = brandSoftColor ?? "#fbe9e9",
            ["--preview-background-image"] = backgroundImageUrl is null ? "none" : $"url(\"{backgroundImageUrl}\")",
        };

    private static string? SafePreviewImageUrl(string? value)
    {
        var normalized = value?.Trim();
        if (string.IsNullOrWhiteSpace(normalized)
            || normalized.StartsWith("//", StringComparison.Ordinal)
            || normalized.Any(char.IsControl)
            || normalized.IndexOfAny(['"', '\'', '\\', '(', ')']) >= 0)
        {
            return null;
        }

        if (normalized.StartsWith("/", StringComparison.Ordinal))
        {
            return normalized;
        }

        return Uri.TryCreate(normalized, UriKind.Absolute, out var uri)
            && string.Equals(uri.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase)
            ? uri.AbsoluteUri
            : null;
    }

    // A color sample as an SVG fill: a presentation attribute, which the CSP
    // does not govern, where an inline background would need style-src-attr.
    private static RenderFragment ColorFill(string? color) => builder =>
    {
        builder.OpenElement(0, "svg");
        builder.AddAttribute(1, "viewBox", "0 0 1 1");
        builder.AddAttribute(2, "preserveAspectRatio", "none");
        builder.AddAttribute(3, "focusable", "false");
        builder.OpenElement(4, "rect");
        builder.AddAttribute(5, "width", "1");
        builder.AddAttribute(6, "height", "1");
        builder.AddAttribute(7, "fill", color ?? "#cc0000");
        builder.CloseElement();
        builder.CloseElement();
    };

    private string DisplayColor(string? color) =>
        color ?? L["Branding.HostDefault"].Value;

    private string FormatDate(DateTime value) =>
        Time.Format(value);

    private static ManagementDataResult<object> Box<T>(
        ManagementDataResult<T> result) =>
        result.IsSuccess
            ? ManagementDataResult<object>.Success(result.Value!)
            : ManagementDataResult<object>.Failure(
                result.Outcome,
                result.ErrorMessage,
                result.ErrorField);

    private sealed class BrandingEditModel : IValidatableObject
    {
        private static readonly Regex HexColorPattern = new(
            "^#[0-9A-Fa-f]{6}$",
            RegexOptions.Compiled);

        public IStringLocalizer<Sufficit.Identity.UI.Management.Resources.ManagementResource>? Localizer { get; set; }

        public string Name { get; set; } = string.Empty;

        [StringLength(512)]
        public string? LogoUrl { get; set; }

        [StringLength(512)]
        public string? FaviconUrl { get; set; }

        [StringLength(512)]
        public string? HeaderIconUrl { get; set; }

        [StringLength(512)]
        public string? BackgroundImageUrl { get; set; }

        [StringLength(7)]
        public string? BrandColor { get; set; }

        [StringLength(7)]
        public string? BrandHoverColor { get; set; }

        [StringLength(7)]
        public string? BrandSoftColor { get; set; }

        [StringLength(7)]
        public string? ThemeColor { get; set; }

        [StringLength(200)]
        public string? Title { get; set; }

        [StringLength(100)]
        public string? BrandName { get; set; }

        [StringLength(100)]
        public string? BrandSubtitle { get; set; }

        [StringLength(512)]
        public string? AvatarUrlTemplate { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            var l = Localizer;
            if (l is null)
            {
                throw new InvalidOperationException(
                    "Localizer must be set before validating BrandingEditModel.");
            }

            if (string.IsNullOrWhiteSpace(Name))
            {
                yield return new ValidationResult(
                    l["Branding.Validation.NameRequired"].Value,
                    [nameof(Name)]);
            }
            else if (Name.Length > 100)
            {
                yield return new ValidationResult(
                    l["Common.Validation.MaxLength", 100].Value,
                    [nameof(Name)]);
            }

            foreach (var (value, fieldName) in new (string? Value, string FieldName)[]
            {
                (BrandColor, nameof(BrandColor)),
                (BrandHoverColor, nameof(BrandHoverColor)),
                (BrandSoftColor, nameof(BrandSoftColor)),
                (ThemeColor, nameof(ThemeColor)),
            })
            {
                if (!string.IsNullOrWhiteSpace(value)
                    && !HexColorPattern.IsMatch(value))
                {
                    yield return new ValidationResult(
                        l["Branding.Validation.HexColorFormat"].Value,
                        [fieldName]);
                }
            }
        }

        public SaveManagementBrandingThemeCommand ToCommand() =>
            new(
                Name,
                LogoUrl,
                FaviconUrl,
                HeaderIconUrl,
                BackgroundImageUrl,
                BrandColor,
                BrandHoverColor,
                BrandSoftColor,
                ThemeColor,
                Title,
                BrandName,
                BrandSubtitle,
                AvatarUrlTemplate);

        public static BrandingEditModel CreateDefault() =>
            new()
            {
                BrandColor = "#cc0000",
                BrandHoverColor = "#a30000",
                BrandSoftColor = "#fbe9e9",
                ThemeColor = "#cc0000"
            };

        public static BrandingEditModel From(ManagementBrandingTheme theme) =>
            new()
            {
                Name = theme.Name,
                LogoUrl = theme.LogoUrl,
                FaviconUrl = theme.FaviconUrl,
                HeaderIconUrl = theme.HeaderIconUrl,
                BackgroundImageUrl = theme.BackgroundImageUrl,
                BrandColor = theme.BrandColor,
                BrandHoverColor = theme.BrandHoverColor,
                BrandSoftColor = theme.BrandSoftColor,
                ThemeColor = theme.ThemeColor,
                Title = theme.Title,
                BrandName = theme.BrandName,
                BrandSubtitle = theme.BrandSubtitle,
                AvatarUrlTemplate = theme.AvatarUrlTemplate
            };
    }
}
