@page "/users/{Id}/actions/password"
@attribute [Authorize(Policy = ManagementUiPolicies.Access)]
@attribute [StreamRendering]
@inject ManagementUserDataSource UserData

<PageTitle>@L["Users.PasswordReset.PageTitle"]</PageTitle>

<SUIPageHeader Title="@HeaderTitle" Description="@L["Users.Detail.Reset.Description"].Value">
    <Actions>
        <a class="button button--secondary" href="@DetailHref"><SUIIcon Name="arrow-left" Size="17" />@L["Users.Actions.BackToUser"]</a>
    </Actions>
</SUIPageHeader>

@if (loading)
{
    <div class="credential-panel" aria-busy="true" aria-label="@L["Users.Actions.Loading"].Value"><div class="detail-skeleton"></div><div class="detail-skeleton detail-skeleton--short"></div></div>
}
else if (result?.IsSuccess is false || result?.Value is null)
{
    <div class="panel"><SUIEmptyState Icon="alert" Title="@LoadErrorTitle" Description="@result?.ErrorMessage"><Actions><a class="button button--secondary" href="@DetailHref">@L["Users.Actions.BackToUser"]</a></Actions></SUIEmptyState></div>
}
else if (result.Value.Actions.CanResetPassword)
{
    <EditForm Model="model" OnValidSubmit="ResetPasswordAsync" FormName="reset-management-user-password" class="credential-panel">
        <DataAnnotationsValidator />
        <div class="credential-panel__heading">
            <div class="credential-panel__icon"><SUIIcon Name="key" Size="20" /></div>
            <div><h2>@L["Users.Detail.Reset.Title"]</h2><p>@L["Users.Detail.Reset.Description"]</p></div>
            <SUIStatusBadge ToneValue="SUITone.Info">@L["Users.Detail.Reset.Badge"]</SUIStatusBadge>
        </div>

        @if (operation?.IsSuccess is true)
        {
            <div class="inline-notice inline-notice--success" role="status"><SUIIcon Name="check" Size="19" /><div><strong>@L["Users.Detail.PasswordReset.Title"]</strong><span>@L["Users.Detail.PasswordReset.Description"]</span></div></div>
        }
        else if (operation?.IsSuccess is false)
        {
            <div class="inline-notice inline-notice--danger" role="alert"><SUIIcon Name="alert" Size="19" /><div><strong>@OperationErrorTitle</strong><span>@operation.ErrorMessage</span></div></div>
        }

        <div class="form-grid form-grid--two credential-panel__fields">
            <div class="field-group">
                <label for="new-password">@L["Users.Detail.Reset.Field.NewPassword"]</label>
                <InputText id="new-password" class="form-control" type="password" autocomplete="new-password" @bind-Value="model.NewPassword" />
                <ValidationMessage For="() => model.NewPassword" />
                @if (operation?.ErrorField is "newPassword") { <p class="validation-message">@operation.ErrorMessage</p> }
            </div>
            <div class="field-group">
                <label for="confirm-new-password">@L["Users.Detail.Reset.Field.ConfirmPassword"]</label>
                <InputText id="confirm-new-password" class="form-control" type="password" autocomplete="new-password" @bind-Value="model.ConfirmPassword" />
                <ValidationMessage For="() => model.ConfirmPassword" />
            </div>
        </div>
        <div class="credential-panel__actions">
            <span>@L["Users.Detail.Reset.PolicyNote"]</span>
            <button class="button button--primary" type="submit" disabled="@busy">
                @if (busy) { <span class="button-spinner" aria-hidden="true"></span><span>@L["Users.Detail.Reset.Submitting"]</span> }
                else { <SUIIcon Name="key" Size="17" /><span>@L["Users.Detail.Reset.Title"]</span> }
            </button>
        </div>
    </EditForm>
}
else if (result.Value.Actions.ResetPasswordRequiresMfa)
{
    <div class="decision-note decision-note--neutral"><SUIIcon Name="shield" Size="21" /><div><h2>@L["Users.Detail.Reset.MfaRequiredTitle"]</h2><p>@L["Users.Detail.MfaRequiredDescription"]</p></div></div>
}
else
{
    <div class="decision-note decision-note--neutral"><SUIIcon Name="lock" Size="21" /><div><h2>@L["Users.Detail.Reset.ForbiddenTitle"]</h2><p>@L["Users.Detail.Reset.ForbiddenDescription"]</p></div></div>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private readonly PasswordResetModel model = new();
    private ManagementDataResult<ManagementUserDetail>? result;
    private ManagementDataResult<ManagementUserDetail>? operation;
    private bool loading = true;
    private bool busy;
    private string DetailHref => $"users/{Uri.EscapeDataString(Id)}";
    private string HeaderTitle => result?.Value?.UserName ?? result?.Value?.Email ?? L["Users.Detail.Reset.Title"].Value;
    private string LoadErrorTitle => result?.Outcome is ManagementDataOutcome.NotFound
        ? L["Users.Detail.Error.NotFound"].Value
        : result?.Outcome is ManagementDataOutcome.StepUpRequired
            ? L["Users.Detail.Error.StepUp"].Value
            : result?.Outcome is ManagementDataOutcome.Forbidden
                ? L["Users.Detail.Error.Forbidden"].Value
                : L["Users.Detail.Error.Generic"].Value;
    private string OperationErrorTitle => operation?.Outcome is ManagementDataOutcome.StepUpRequired
        ? L["Users.Detail.Reset.Error.StepUp"].Value
        : operation?.Outcome is ManagementDataOutcome.Forbidden
            ? L["Users.Detail.Error.InsufficientAuthority"].Value
            : L["Users.Detail.Reset.Error.Generic"].Value;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        result = await UserData.GetAsync(Id);
        loading = false;
    }

    protected override void OnInitialized()
    {
        model.Localizer = L;
        base.OnInitialized();
    }

    private async Task ResetPasswordAsync()
    {
        if (busy) return;
        busy = true;
        operation = await UserData.ResetPasswordAsync(Id, new ResetManagementUserPasswordCommand(model.NewPassword));
        busy = false;
        if (operation.IsSuccess && operation.Value is not null)
        {
            result = operation;
            model.NewPassword = model.ConfirmPassword = string.Empty;
        }
    }

    private sealed class PasswordResetModel : IValidatableObject
    {
        public IStringLocalizer<Sufficit.Identity.UI.Management.Resources.ManagementResource>? Localizer { get; set; }
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            var l = Localizer ?? throw new InvalidOperationException("The form model localizer must be set before validation.");
            if (string.IsNullOrWhiteSpace(NewPassword)) yield return new ValidationResult(l["Users.Detail.Validation.NewPasswordRequired"].Value, [nameof(NewPassword)]);
            if (string.IsNullOrWhiteSpace(ConfirmPassword)) yield return new ValidationResult(l["Users.Detail.Validation.ConfirmNewPasswordRequired"].Value, [nameof(ConfirmPassword)]);
            if (!string.Equals(NewPassword, ConfirmPassword, StringComparison.Ordinal)) yield return new ValidationResult(l["Users.Create.Validation.PasswordsDoNotMatch"].Value, [nameof(ConfirmPassword)]);
        }
    }
}
