@page "/claims/edit"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageClaims)]
@inject ManagementClaimDataSource ClaimData
@inject NavigationManager Navigation

@{ var claim = result?.Value!; }

<PageTitle>@L["ClaimDetail.PageTitle"]</PageTitle>

<SUIPageHeader Title="@L["ClaimDetail.HeaderTitle"].Value"
            Description="@L["ClaimDetail.HeaderDescription"].Value">
    <Actions>
        <a class="button button--secondary" href="@BackHref">
            <SUIIcon Name="arrow-left" Size="17" />
            @L["ClaimDetail.BackToClaims"]
        </a>
    </Actions>
</SUIPageHeader>

@if (updated)
{
    <div class="inline-notice inline-notice--success" role="status">
        <SUIIcon Name="check" Size="19" />
        <div>
            <strong>@L["ClaimDetail.Updated.Title"]</strong>
            <span>@L["ClaimDetail.Updated.Description"]</span>
        </div>
    </div>
}

@if (!HasClaimContext)
{
    <div>
        <SUIEmptyState Icon="users"
                    Title="@L["ClaimDetail.SelectClaim.Title"].Value"
                    Description="@L["ClaimDetail.SelectClaim.Description"].Value">
            <Actions>
                <a class="button button--primary" href="users">@L["ClaimDetail.OpenUserDirectory"]</a>
            </Actions>
        </SUIEmptyState>
    </div>
}
else if (loading)
{
    <div class="detail-shell" aria-busy="true" aria-label="@L["ClaimDetail.LoadingAriaLabel"].Value">
        <div class="detail-skeleton"></div>
        <div class="detail-skeleton detail-skeleton--short"></div>
    </div>
}
else if (result?.IsSuccess is true && result.Value is not null
         && string.Equals(result.Value.UserId, UserId, StringComparison.Ordinal))
{
    <div class="contract-strip contract-strip--warning">
        <SUIIcon Name="refresh" Size="20" />
        <div>
            <strong>@L["ClaimDetail.ContractStrip.Title"]</strong>
            <span>@string.Format(L["ClaimDetail.ContractStrip.DescriptionFormat"].Value, AccountLabel(claim))</span>
        </div>
        <SUIStatusBadge ToneValue="SUITone.Warning">@L["ClaimDetail.ContractStrip.Badge"]</SUIStatusBadge>
    </div>

    @if (submission?.IsSuccess is false)
    {
        <div class="inline-notice inline-notice--danger" role="alert">
            <SUIIcon Name="alert" Size="19" />
            <div>
                <strong>@L["ClaimDetail.SubmitError.Title"]</strong>
                <span>@submission.ErrorMessage</span>
            </div>
        </div>
    }

    <div>
    <EditForm Model="model"
              OnValidSubmit="UpdateAsync"
              FormName="update-user-claim"
              class="management-form">
        <DataAnnotationsValidator />

        <div class="form-section" aria-labelledby="claim-identity-heading">
            <div class="form-section__heading">
                <h2 id="claim-identity-heading">@L["ClaimDetail.Assignment.Heading"]</h2>
                <p>@L["ClaimDetail.Assignment.Description"]</p>
            </div>
            <dl class="property-list">
                <div>
                    <dt>@L["ClaimDetail.Field.Account"]</dt>
                    <dd><a class="client-name" href="@UserHref">@AccountLabel(claim)</a></dd>
                </div>
                <div>
                    <dt>@L["ClaimDetail.Field.Identifier"]</dt>
                    <dd><code class="client-id">@claim.Id</code></dd>
                </div>
            </dl>
        </div>

        <div class="form-section" aria-labelledby="claim-edit-heading">
            <div class="form-section__heading">
                <h2 id="claim-edit-heading">@L["ClaimDetail.TypeValue.Heading"]</h2>
                <p>@L["ClaimDetail.TypeValue.Description"]</p>
            </div>

            <div class="field-group">
                <label for="claim-type">@L["ClaimDetail.Field.Type"]</label>
                <InputText id="claim-type"
                           class="form-control"
                           autocomplete="off"
                           @bind-Value="model.Type" />
                <ValidationMessage For="() => model.Type" />
            </div>

            <div class="field-group">
                <label for="claim-value">@L["ClaimDetail.Field.Value"]</label>
                <InputTextArea id="claim-value"
                               class="form-control form-control--textarea"
                               @bind-Value="model.Value" />
                <ValidationMessage For="() => model.Value" />
                <span class="field-hint">@L["ClaimDetail.Field.ValueHint"]</span>
            </div>
        </div>

        <footer class="form-actions">
            <a class="button button--secondary" href="@BackHref">@L["ClaimDetail.Cancel"]</a>
            <button class="button button--primary" type="submit" disabled="@saving">
                @if (saving)
                {
                    <span class="button-spinner" aria-hidden="true"></span>
                    <span>@L["ClaimDetail.Saving"]</span>
                }
                else
                {
                    <SUIIcon Name="edit" Size="17" />
                    <span>@L["ClaimDetail.SaveClaim"]</span>
                }
            </button>
        </footer>
    </EditForm>
    </div>

    <div class="delete-zone" aria-labelledby="delete-claim-heading">
        <div>
            <h2 id="delete-claim-heading">@L["ClaimDetail.Delete.Heading"]</h2>
            <p>@L["ClaimDetail.Delete.Description"]</p>
        </div>
        @if (deletion?.IsSuccess is false)
        {
            <div class="inline-notice inline-notice--danger" role="alert">
                <SUIIcon Name="alert" Size="19" />
                <div>
                    <strong>@L["ClaimDetail.Delete.ErrorTitle"]</strong>
                    <span>@deletion.ErrorMessage</span>
                </div>
            </div>
        }
        <label class="delete-confirmation">
            <input type="checkbox" @bind="confirmed" />
            <span>@L["ClaimDetail.Delete.ConfirmLabel"]</span>
        </label>
        <button class="button button--danger"
                type="button"
                disabled="@(!confirmed || deleting)"
                @onclick="DeleteAsync">
            <SUIIcon Name="trash" Size="17" />
            @(deleting ? L["ClaimDetail.Delete.Removing"] : L["ClaimDetail.Delete.Submit"])
        </button>
    </div>
}
else
{
    <div>
        <SUIEmptyState Icon="alert"
                    Title="@ErrorTitle"
                    Description="@(result?.ErrorMessage ?? L["ClaimDetail.Error.GenericDescription"].Value)">
            <Actions>
                <a class="button button--secondary" href="@BackHref">@L["ClaimDetail.BackToClaims"]</a>
            </Actions>
        </SUIEmptyState>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "user")]
    public string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "claim")]
    public int? ClaimId { get; set; }

    private readonly ClaimEditModel model = new();
    private ManagementDataResult<ManagementClaimAssignment>? result;
    private ManagementDataResult<ManagementClaimAssignment>? submission;
    private ManagementDataResult<bool>? deletion;
    private bool loading = true;
    private bool saving;
    private bool deleting;
    private bool confirmed;
    private bool updated;

    private bool HasClaimContext =>
        !string.IsNullOrWhiteSpace(UserId) && ClaimId is > 0;

    private string BackHref =>
        !string.IsNullOrWhiteSpace(UserId)
            ? $"claims?user={Uri.EscapeDataString(UserId)}"
            : "users";

    private string UserHref =>
        !string.IsNullOrWhiteSpace(UserId)
            ? $"users/{Uri.EscapeDataString(UserId)}"
            : "users";

    private string ErrorTitle =>
        result?.Outcome is ManagementDataOutcome.NotFound
            ? L["ClaimDetail.Error.NotFound"].Value
            : result?.Outcome is ManagementDataOutcome.StepUpRequired
                ? L["ClaimDetail.Error.StepUp"].Value
                : L["ClaimDetail.Error.Generic"].Value;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        result = null;
        submission = null;
        deletion = null;
        updated = false;
        confirmed = false;

        if (!HasClaimContext)
        {
            loading = false;
            return;
        }

        result = await ClaimData.GetAsync(ClaimId!.Value);
        if (result.Value is { } claim)
        {
            model.Type = claim.Type;
            model.Value = claim.Value;
        }
        loading = false;
    }

    private async Task UpdateAsync()
    {
        if (!HasClaimContext || saving)
        {
            return;
        }

        saving = true;
        updated = false;
        submission = await ClaimData.UpdateAsync(
            ClaimId!.Value,
            new UpdateManagementClaimCommand(model.Type, model.Value));
        saving = false;
        if (submission.IsSuccess && submission.Value is not null)
        {
            result = submission;
            updated = true;
        }
    }

    private async Task DeleteAsync()
    {
        if (!HasClaimContext || !confirmed || deleting)
        {
            return;
        }

        deleting = true;
        deletion = await ClaimData.DeleteAsync(ClaimId!.Value);
        deleting = false;
        if (deletion.IsSuccess)
        {
            Navigation.NavigateTo($"{BackHref}&deleted=1");
        }
    }

    private static string AccountLabel(ManagementClaimAssignment claim) =>
        claim.UserName ?? claim.Email ?? claim.UserId;

    protected override void OnInitialized()
    {
        model.Localizer = L;
        base.OnInitialized();
    }

    private sealed class ClaimEditModel : IValidatableObject
    {
        public IStringLocalizer<Sufficit.Identity.UI.Management.Resources.ManagementResource>? Localizer { get; set; }

        public string Type { get; set; } = string.Empty;

        public string Value { get; set; } = string.Empty;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            var l = Localizer ?? throw new InvalidOperationException(
                "The form model localizer must be set before validation.");

            if (string.IsNullOrWhiteSpace(Type))
            {
                yield return new ValidationResult(l["Claims.Validation.TypeRequired"].Value, [nameof(Type)]);
            }
            if (Type?.Length > 256)
            {
                yield return new ValidationResult(l["Common.Validation.MaxLength", 256].Value, [nameof(Type)]);
            }
            if (string.IsNullOrWhiteSpace(Value))
            {
                yield return new ValidationResult(l["Claims.Validation.ValueRequired"].Value, [nameof(Value)]);
            }
            if (Value?.Length > 4096)
            {
                yield return new ValidationResult(l["Common.Validation.MaxLength", 4096].Value, [nameof(Value)]);
            }
        }
    }
}
