@page "/clients/new"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageClients)]
@inject ManagementClientDataSource ClientData
@inject NavigationManager Navigation

<PageTitle>Nova aplicação | Sufficit Identity</PageTitle>

<PageHeader Title="Nova aplicação"
            Description="Escolha o cenário de uso. O Identity prepara uma configuração segura e explica cada decisão.">
    <Actions>
        <a class="button button--secondary" href="clients">
            <AppIcon Name="arrow-left" Size="17" />
            Voltar para aplicações
        </a>
    </Actions>
</PageHeader>

<div class="setup-intro" aria-labelledby="profile-heading">
    <div>
        <h2 id="profile-heading">Como esta aplicação será usada?</h2>
        <p>Você poderá revisar e ajustar tudo antes de criar. Nenhuma aplicação incompleta será registrada.</p>
    </div>
    <div class="setup-intro__assurance">
        <AppIcon Name="shield" Size="20" />
        <span>Defaults seguros, validação progressiva e rascunho retomável</span>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="inline-notice inline-notice--danger" role="alert">
        <AppIcon Name="alert" Size="19" />
        <div>
            <strong>Não foi possível iniciar a configuração</strong>
            <span>@errorMessage</span>
        </div>
    </div>
}

@if (loading)
{
    <div class="profile-grid" aria-label="Carregando perfis de aplicação" aria-busy="true">
        @for (var index = 0; index < 4; index++)
        {
            <div class="profile-card profile-card--loading"></div>
        }
    </div>
}
else if (profiles.Count is 0)
{
    <div>
        <EmptyState Icon="alert"
                    Title="Nenhum perfil disponível"
                    Description="O runtime não informou uma configuração de aplicação disponível.">
            <Actions>
                <button class="button button--secondary" type="button" @onclick="LoadAsync">Tentar novamente</button>
            </Actions>
        </EmptyState>
    </div>
}
else
{
    <div class="profile-grid" aria-label="Perfis de aplicação">
        @foreach (var profile in profiles)
        {
            <button class="profile-card"
                    type="button"
                    disabled="@(creatingProfile is not null)"
                    aria-busy="@(creatingProfile == profile.Id)"
                    @onclick="() => CreateDraftAsync(profile.Id)">
                <span class="profile-card__icon"><AppIcon Name="@profile.Icon" Size="23" /></span>
                <span class="profile-card__body">
                    <strong>@profile.DisplayName</strong>
                    <span>@profile.Description</span>
                    <small>@profile.Outcome</small>
                </span>
                <span class="profile-card__action">
                    @if (creatingProfile == profile.Id)
                    {
                        <span class="button-spinner" aria-hidden="true"></span>
                        <span class="visually-hidden">Criando rascunho</span>
                    }
                    else
                    {
                        <AppIcon Name="arrow-right" Size="18" />
                    }
                </span>
            </button>
        }
    </div>
}

<div class="setup-footnote">
    <AppIcon Name="lock" Size="18" />
    <p>Credenciais nunca entram na URL ou no rascunho. Quando necessárias, são geradas somente na conclusão e exibidas uma única vez.</p>
</div>

@code {
    private IReadOnlyList<ManagementClientProfile> profiles = [];
    private bool loading = true;
    private string? creatingProfile;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        errorMessage = null;
        var result = await ClientData.GetClientProfilesAsync();
        profiles = result.Value ?? [];
        errorMessage = result.IsSuccess ? null : result.ErrorMessage;
        loading = false;
    }

    private async Task CreateDraftAsync(string profile)
    {
        if (creatingProfile is not null)
        {
            return;
        }

        creatingProfile = profile;
        errorMessage = null;
        var result = await ClientData.CreateClientDraftAsync(profile);
        creatingProfile = null;
        if (result.IsSuccess && result.Value is not null)
        {
            Navigation.NavigateTo(
                $"clients/drafts/{result.Value.Id:D}/{ManagementClientDraftSteps.Identity}");
            return;
        }

        errorMessage = result.ErrorMessage ?? "O serviço não conseguiu criar o rascunho.";
    }
}
