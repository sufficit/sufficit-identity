@page "/clients/new"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageClients)]
@inject ManagementClientDataSource ClientData
@inject NavigationManager Navigation

<PageTitle>@L["Clients.Create.Title"] | Sufficit Identity</PageTitle>

<SUIPageHeader Title="@L["Clients.Create.Title"].Value"
            Description="@L["Clients.Create.Description"].Value">
    <Actions>
        <a class="button button--secondary" href="clients">
            <SUIIcon Name="arrow-left" Size="17" />
            @L["Clients.Create.Back"]
        </a>
    </Actions>
</SUIPageHeader>

<div class="setup-intro" aria-labelledby="profile-heading">
    <div>
        <h2 id="profile-heading">@L["Clients.Create.ProfileHeading"]</h2>
        <p>@L["Clients.Create.ProfileIntro"]</p>
    </div>
    <div class="setup-intro__assurance">
        <SUIIcon Name="shield" Size="20" />
        <span>@L["Clients.Create.Assurance"]</span>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="inline-notice inline-notice--danger" role="alert">
        <SUIIcon Name="alert" Size="19" />
        <div>
            <strong>@L["Clients.Create.ErrorTitle"]</strong>
            <span>@errorMessage</span>
        </div>
    </div>
}

@if (loading)
{
    <div class="profile-grid" aria-label="@L["Clients.Create.LoadingAriaLabel"].Value" aria-busy="true">
        @for (var index = 0; index < 4; index++)
        {
            <div class="profile-card profile-card--loading"></div>
        }
    </div>
}
else if (profiles.Count is 0)
{
    <div>
        <SUIEmptyState Icon="alert"
                    Title="@L["Clients.Create.EmptyTitle"].Value"
                    Description="@L["Clients.Create.EmptyDescription"].Value">
            <Actions>
                <button class="button button--secondary" type="button" @onclick="LoadAsync">@L["Clients.Create.Retry"]</button>
            </Actions>
        </SUIEmptyState>
    </div>
}
else
{
    <div class="profile-grid" aria-label="@L["Clients.Create.ProfilesAriaLabel"].Value">
        @foreach (var profile in profiles)
        {
            <button class="profile-card @(profile.IsAvailable ? string.Empty : "profile-card--unavailable")"
                    type="button"
                    disabled="@(creatingProfile is not null || !profile.IsAvailable)"
                    aria-busy="@(creatingProfile == profile.Id)"
                    @onclick="() => CreateDraftAsync(profile.Id)">
                <span class="profile-card__icon"><SUIIcon Name="@profile.Icon" Size="23" /></span>
                <span class="profile-card__body">
                    <strong>@profile.DisplayName</strong>
                    <span>@profile.Description</span>
                    <small>@(profile.IsAvailable ? profile.Outcome : profile.UnavailableReason)</small>
                </span>
                <span class="profile-card__action">
                    @if (!profile.IsAvailable)
                    {
                        <SUIIcon Name="lock" Size="17" />
                    }
                    else if (creatingProfile == profile.Id)
                    {
                        <span class="button-spinner" aria-hidden="true"></span>
                        <span class="visually-hidden">@L["Clients.Create.CreatingDraft"]</span>
                    }
                    else
                    {
                        <SUIIcon Name="arrow-right" Size="18" />
                    }
                </span>
            </button>
        }
    </div>
}

<div class="setup-footnote">
    <SUIIcon Name="lock" Size="18" />
    <p>@L["Clients.Create.Footnote"]</p>
</div>

@code {
    private IReadOnlyList<ManagementClientProfile> profiles = [];
    private bool loading = true;
    private string? creatingProfile;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        errorMessage = null;
        var result = await ClientData.GetClientProfilesAsync();
        profiles = result.Value ?? [];
        errorMessage = result.IsSuccess ? null : result.ErrorMessage;
        loading = false;
    }

    private async Task CreateDraftAsync(string profile)
    {
        if (creatingProfile is not null)
        {
            return;
        }

        creatingProfile = profile;
        errorMessage = null;
        var result = await ClientData.CreateClientDraftAsync(profile);
        creatingProfile = null;
        if (result.IsSuccess && result.Value is not null)
        {
            Navigation.NavigateTo(
                $"clients/drafts/{result.Value.Id:D}/{ManagementClientDraftSteps.Identity}");
            return;
        }

        errorMessage = result.ErrorMessage ?? L["Clients.Create.DraftCreationFailed"].Value;
    }
}
