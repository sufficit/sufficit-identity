@namespace Sufficit.Identity.UI.Management.Components

@{
    var copy = ManagementCapabilityPresentation.Get(Capability, L);
}

<span class="management-capability-help"
      lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
    <SUIIconButton ColorValue="SUIColor.Info"
                   SizeValue="SUISize.Small"
                   Title="@L["Capability.Help.AriaLabel", copy.HelpTitle].Value"
                   aria-describedby="@TooltipId">
        <SUIIcon Name="info" Size="17" />
    </SUIIconButton>
    <span id="@TooltipId"
          class="management-capability-help__tooltip"
          role="tooltip">
        <strong>@copy.HelpTitle</strong>
        <span>@copy.HelpText</span>
    </span>
</span>

@code {
    [Parameter, EditorRequired]
    public string Capability { get; set; } = string.Empty;

    private string TooltipId =>
        $"capability-help-{Capability.Replace('.', '-')}";
}
