@inject Microsoft.Extensions.Options.IOptions<ManagementUiOptions> ManagementOptions
@using System.Globalization
@using Sufficit.Identity.UI.Management.Configuration
@using Microsoft.AspNetCore.Http
@using Sufficit.Identity.Application.Security
@using Sufficit.Identity.UI.Components

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="@ManagementOptions.Value.GetBaseHref()" />
    <link rel="icon" href="/_content/Sufficit.Identity.UI.Management/img/logo-mark.png" type="image/png" />
    <meta name="theme-color" content="#242223" />
    <link rel="stylesheet" href="/_content/Sufficit.Blazor.UI/sufficit-ui.css?v=@AssetVersion" />
    <link rel="stylesheet" href="/Sufficit.Identity.Server.styles.css?v=@AssetVersion" />
    <link rel="stylesheet" href="/_content/Sufficit.Identity.UI.Management/app.css?v=@AssetVersion" />
    <link rel="stylesheet" href="/_content/Sufficit.Identity.UI.Management/users.css?v=@AssetVersion" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <SUIThemeProvider Theme="@ManagementTheme" Nonce="@CspNonce.From(HttpContext?.Items)">
        <Routes @rendermode="InteractiveServer" />
        <ReconnectModal Reconnecting="@L["Layout.Reconnecting"].Value"
                        Failed="@L["Layout.ConnectionLost"].Value"
                        Reload="@L["Layout.Reload"].Value" />
        <div id="blazor-error-ui" role="alert">
            <span>@L["Layout.ConnectionLost"]</span>
            <a href="" class="reload">@L["Layout.Reload"]</a>
            <button type="button" class="dismiss" aria-label="@L["Layout.DismissNotice"].Value">×</button>
        </div>
    </SUIThemeProvider>
    <script src="/_content/Sufficit.Identity.UI.Management/_framework/blazor.web.js"></script>
    <script type="module" src="/_content/Sufficit.Identity.UI.Management/sui-init.js?v=@AssetVersion"></script>
</body>

</html>

@code {
    // These stylesheets are served under fixed names without Cache-Control,
    // so a browser could keep last release's layout for hours. The release
    // id in the query string makes every deploy fetch them again.
    private static readonly string AssetVersion = Uri.EscapeDataString(
        (System.Reflection.CustomAttributeExtensions
            .GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>(typeof(App).Assembly)
            ?.InformationalVersion ?? "0").Split('+') is { Length: > 1 } parts ? parts[1] : "0");

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // Management and Vault can share one host process and register different
    // SUI themes. Keep this surface explicit so registration order cannot make
    // operational controls inherit the Vault library-default blue palette.
    private static readonly IdentitySUITheme ManagementTheme = new();
}
