<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                <LayoutView Layout="typeof(MainLayout)">
                    <section class="panel" aria-labelledby="management-access-denied">
                        <h1 id="management-access-denied">@L["Routes.AccessDenied.Title"]</h1>
                        <p>
                            @L["Routes.AccessDenied.Description"]
                        </p>
                        <a class="button button--secondary" href="/account/manage">
                            @L["Routes.AccessDenied.OpenAccount"]
                        </a>
                    </section>
                </LayoutView>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <NotFoundPage />
        </LayoutView>
    </NotFound>
</Router>
