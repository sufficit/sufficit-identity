<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sufficit.Identity.Server</RootNamespace>
    <AssemblyName>Sufficit.Identity.Server</AssemblyName>
    <!-- Kept for compatibility with existing local User Secrets. -->
    <UserSecretsId>sufficit-identity-sts</UserSecretsId>
    <Description>Sufficit Identity — composition host for STS, management and UI modules.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\Sufficit.Identity.Core.csproj" />
    <ProjectReference Include="..\sts\Sufficit.Identity.STS.csproj" />
    <ProjectReference Include="..\management\Sufficit.Identity.Management.csproj" />
  </ItemGroup>

  <!--
    Sufficit Identity UI (Blazor Server login/consent/logout/manage) lives in
    the SIBLING repo sufficit-identity-ui. There is no published
    `Sufficit.Identity.UI` NuGet package yet, so the reference is resolved one
    of two ways, picked automatically by MSBuild from the filesystem:

      * When the sibling repo is checked out at the expected relative path
        (dev machines, and CI which checks out both repos as siblings — see
        .github/workflows/ci.yml), the FIRST ItemGroup below resolves it as a
        ProjectReference: source-built, exact same code the developer has.

      * When the sibling repo is ABSENT (e.g. a consumer trying to build ONLY
        this repo without the UI), the <Error> target below fires at build time
        with a CLEAR, actionable message explaining what to do — instead of the
        opaque "ProjectReference could not be resolved" the UNCONDITIONAL
        reference produced before. (A PackageReference on a placeholder NuGet
        package was considered but rejected: this repo uses Central Package
        Management, so the version would have to live in
        Directory.Packages.props as a permanent entry for a package that does
        not exist — polluting the CPM manifest.)

    When a real Sufficit.Identity.UI NuGet package is eventually published,
    replace the <Error> target with a version-less <PackageReference> (CPM
    controls the version) gated on the same !Exists condition, and add the
    corresponding <PackageVersion> to Directory.Packages.props.

    See docs/eval/PLAN-2026-07-25-claude-fable-5.md item 1.2 [L2].
  -->
  <ItemGroup Condition="Exists('..\..\..\sufficit-identity-ui\src\Sufficit.Identity.UI\Sufficit.Identity.UI.csproj')">
    <ProjectReference Include="..\..\..\sufficit-identity-ui\src\Sufficit.Identity.UI\Sufficit.Identity.UI.csproj" />
  </ItemGroup>
  <Target Name="RequireSiblingUiRepo"
          Condition="!Exists('..\..\..\sufficit-identity-ui\src\Sufficit.Identity.UI\Sufficit.Identity.UI.csproj')"
          BeforeTargets="Build;Restore">
    <Error Text="Sufficit.Identity.UI (Blazor Server login/consent/logout UI) is required but was not found at '..\..\..\sufficit-identity-ui\src\Sufficit.Identity.UI\Sufficit.Identity.UI.csproj'. This repo references the sibling repo sufficit-identity-ui as a ProjectReference when present (dev machines, CI). Either: (1) check out sufficit-identity-ui as a sibling directory of this repo, or (2) once a Sufficit.Identity.UI NuGet package is published, replace this error with a PackageReference (see the comment above). Until then this repo cannot build in isolation." />
  </Target>

  <ItemGroup>
    <!-- Real appsettings files are developer-local/ignored and may contain
         credentials. Runtime configuration must come from User Secrets,
         environment variables, or mounted configuration — never from a
         build/publish artifact. -->
    <Content Update="appsettings.json;appsettings.*.json"
             CopyToOutputDirectory="Never"
             CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
