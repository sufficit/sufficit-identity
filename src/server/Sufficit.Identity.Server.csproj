<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sufficit.Identity.Server</RootNamespace>
    <AssemblyName>Sufficit.Identity.Server</AssemblyName>
    <!-- Retained for tooling only; runtime startup secrets come from vault-secrets.env. -->
    <UserSecretsId>sufficit-identity-sts</UserSecretsId>
    <Description>Sufficit Identity — composition host for STS, management and UI modules.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\application\Sufficit.Identity.Application.Abstractions\Sufficit.Identity.Application.Abstractions.csproj" />
    <ProjectReference Include="..\core\Sufficit.Identity.Core.csproj" />
    <ProjectReference Include="..\sts\Sufficit.Identity.STS.csproj" />
    <ProjectReference Include="..\management\Sufficit.Identity.Management.csproj" />
    <ProjectReference Include="..\scim\Sufficit.Identity.Scim.csproj" />
    <ProjectReference Include="..\ui\Sufficit.Identity.UI.Abstractions\Sufficit.Identity.UI.Abstractions.csproj" />
    <ProjectReference Include="..\ui\Sufficit.Identity.UI\Sufficit.Identity.UI.csproj" />
    <ProjectReference Include="..\ui\Sufficit.Identity.UI.Management\Sufficit.Identity.UI.Management.csproj" />
    <ProjectReference Include="..\ui\Sufficit.Identity.UI.Vault\Sufficit.Identity.UI.Vault.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real appsettings files are developer-local/ignored. Runtime startup
         secrets must come from vault-secrets.env — never from a build or
         publish artifact. -->
    <Content Update="appsettings.json;appsettings.*.json"
             CopyToOutputDirectory="Never"
             CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
