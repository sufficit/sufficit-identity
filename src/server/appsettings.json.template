      "_LegacyGrants": "Feature flags for OAuth 2.0 grant types removed by OAuth 2.1 (Resource Owner Password Credentials and the 'none' grant). Both default to FALSE (secure-by-default since EVALUATION-2026-07-21 §5 P0 #8). Opt-in per environment ONLY if a legacy client still requires these — and pair with telemetry + a removal date (Onda E).",
      "LegacyGrants": {
        "_Password": "Enables grant_type=password. Removed by OAuth 2.1. Default false — flip to true ONLY in environments where a legacy client still needs it (e.g. during migration).",
        "Password": false,
        "_None": "Enables the 'none' grant/response type (implicit access_token without PKCE). Removed by OAuth 2.1. Default false — flip to true ONLY for legacy WebForms / old-SwaggerUI clients during migration.",
        "None": false
      },
      "_Pkce": "OAuth 2.1 PKCE policy. The secure defaults require PKCE for every authorization-code client and accept only S256. Use the opt-outs only during a controlled legacy-client migration.",
      "Pkce": {
        "RequireForAllClients": true,
        "AllowPlainCodeChallengeMethod": false
      },
      "_Par": "Pushed Authorization Request (PAR, RFC 9126) policy. The PAR endpoint (connect/par) is always registered; these options control whether PAR is *required* of all clients (defense in depth) and the request_uri lifetime for non-FAPI clients. Per-client PAR requirement is also available via OpenIddict's Requirements.Features.PushedAuthorizationRequests flag on the application.",
      "Par": {
        "_RequireForAllClients": "true requires every authorization request to use a pushed request_uri (no direct /connect/authorize with query params). Default false to preserve backward compatibility; flip to true once every client has been migrated to push its authorization request.",
        "RequireForAllClients": false,
        "_RequestUriLifetimeSeconds": "Lifetime of a pushed request_uri for non-FAPI clients, in seconds. Null (default) = OpenIddict built-in default (60s). Values must be 1..599. FAPI 2.0 clients are governed separately by Fapi2.PushedAuthorizationRequestLifetimeSeconds.",
        "RequestUriLifetimeSeconds": null
      },
      "_Jar": "JWT-Secured Authorization Requests (JAR, RFC 9101). When enabled, the STS accepts signed request parameters at the authorization and PAR endpoints, validates the signature against the client's registered JWKS, and merges the signed claims. Independent of FAPI 2.0 but required for the FAPI 2.0 profile. Clients must register jwks or jwks_uri for request-object signing.",
      "Jar": {
        "_Enabled": "true accepts signed request objects at /connect/authorize and /connect/par. Default false.",
        "Enabled": false,
        "_AllowedSigningAlgorithms": "Accepted request-object signing algorithms. Defaults to the FAPI 2.0 baseline.",
        "AllowedSigningAlgorithms": ["PS256", "ES256"],
        "_MaxLifetimeSeconds": "Maximum request-object lifetime in seconds. Default 120 (2 minutes).",
        "MaxLifetimeSeconds": 120
      },
      "_TokenExchange": "RFC 8693 token exchange remains enabled for compatibility and still requires the per-client OpenIddict grant permission. AllowedClientIds adds a second closed allowlist without removing the grant globally; exchanged scopes and resources are always attenuated against the subject token.",
      "TokenExchange": {
        "Enabled": true,
        "AllowedClientIds": []
      },
      "_RateLimit": "Fixed-window rate limit applied to POST /connect/token, per client IP, no queueing. Complements (never replaces) account lockout. Disable only if an upstream gateway already throttles the token endpoint.",
      "RateLimit": {
        "Enabled": true,
        "_PermitLimit": "Requests allowed per window, per client IP.",
        "PermitLimit": 30,
        "_WindowSeconds": "Window length in seconds; also sent as Retry-After on 429.",
        "WindowSeconds": 60,
        "DeviceInformationPermitLimit": 12,
        "DeviceInformationWindowSeconds": 60,
        "_FailOnUntrustedProxy": "true (item 5.1 [L4]) makes startup FAIL when TrustedProxies is empty outside Development, instead of only logging a warning. Without trusted proxies, the rate limiter shares ONE bucket for all traffic (the proxy's IP) → self-inflicted 429s. Default false (warning); flip to true in production so a missing TrustedProxies cannot silently turn the rate limiter into a self-DoS.",
        "FailOnUntrustedProxy": false
      },
      "UserSessions": {
        "CacheLifetimeSeconds": 60,
        "ActivityUpdateIntervalSeconds": 300
      },
      "_DeploymentTopology": "Explicit hosting contract: SingleReplica, Clustered, BehindTrustedProxy or ClusteredBehindTrustedProxy. Clustered modes require a shared distributed cache and an explicit issuer; proxy modes require TrustedProxies, HTTPS issuer and RateLimit:FailOnUntrustedProxy=true.",
      "DeploymentTopology": "SingleReplica",
      "_DistributedCache": "Multi-replica distributed-cache guard. Several security-critical stores (DPoP replay/nonce, CIBA pending requests, front-channel logout, passkey tickets) depend on IDistributedCache. The default AddDistributedMemoryCache is single-node — correct for one replica, but with >1 replica each replica has its own isolated cache and DPoP replay protection / CIBA cross-replica / nonce challenges silently break. Set RequireShared=true before scaling out so the STS fails fast if the cache is the in-memory fallback (i.e. a shared cache like Redis is missing).",
      "DistributedCache": {
        "_RequireShared": "true makes startup FAIL outside Development if the registered IDistributedCache is the in-memory fallback (MemoryDistributedCache), because that backend is not shared across replicas. Default false (no check) — flip to true before deploying more than one replica.",
        "RequireShared": false
      },
      "_Tokens": "Token lifetimes. Null access/identity values use the OpenIddict defaults (60 and 20 minutes). Refresh token rotation is always on; only lifetimes are configurable.",
      "Tokens": {
        "AccessTokenLifetimeMinutes": null,
        "IdentityTokenLifetimeMinutes": null,
        "RefreshTokenLifetimeDays": 14,
        "_UseReferenceAccessTokens": "P0 #5 / eval #B2 — MIGRATION-CONTRACT DECISION, not a mechanical toggle. true (default, current/legacy behavior) = opaque reference access tokens validated only via /connect/introspect. false = self-contained JWT access tokens validated locally by any resource server holding the signing public key. This applies to ALL clients at once (OpenIddict has no per-client token-format switch) — but the legacy inventory (docs/migration/PLAN.md) shows only ONE of the 26 legacy clients (sufficit-endpoints) actually used reference tokens; the rest expect a JWT they validate locally. Do NOT flip to false without first confirming every resource server can handle the new format (JWT: faster, no introspection dependency, but un-revocable before expiry; reference: instantly revocable, opaque, but every validation is a network round-trip here).",
        "UseReferenceAccessTokens": true
      },
      "_Lockout": "Account lockout enforced on password verification (interactive login and grant_type=password).",
      "Lockout": {
        "_MaxFailedAttempts": "Consecutive failures before the account locks.",
        "MaxFailedAttempts": 5,
        "_DurationMinutes": "How long the account stays locked.",
        "DurationMinutes": 5
      },
      "_Password": "Password complexity policy applied on user creation and password change/reset (eval M2). Defaults raise the bar above ASP.NET Core defaults (RequiredLength=6) toward the 2026 baseline (NIST 800-63B favors length; minimum 8, default here is 12). Existing users are NOT forced to change their password on login — Identity applies these rules only at creation/change time.",
      "Password": {
        "_RequiredLength": "Minimum password length. Default 12 (NIST 800-63B floor is 8).",
        "RequiredLength": 12,
        "_RequireDigit": "Require at least one digit. Default true.",
        "RequireDigit": true,
        "_RequireLowercase": "Require at least one lowercase letter. Default true.",
        "RequireLowercase": true,
        "_RequireUppercase": "Require at least one uppercase letter. Default true.",
        "RequireUppercase": true,
        "_RequireNonAlphanumeric": "Require at least one non-alphanumeric character. Default true.",
        "RequireNonAlphanumeric": true,
        "_RequiredUniqueChars": "Minimum number of distinct characters. Default 4.",
        "RequiredUniqueChars": 4,
        "_RejectBreached": "OPT-IN hook for a breached-password validator (HIBP range API or local list). Default false — the flag surfaces the decision but NO validator is wired up by default. Flip to true only after implementing and validating the validator's latency/availability for this environment.",
        "RejectBreached": false
      },
      "_SignIn": "Sign-in policy applied by SignInManager.CanSignInAsync, consulted by every grant in AuthorizationController (eval M3). RequireConfirmedEmail=true (default) blocks sign-in until the user proves email ownership, closing the 'register with someone else's email' hole. WARNING: external-login users (Google/GitHub/Facebook) are only EmailConfirmed when the provider asserts email_verified — see docs/runbooks/RUNBOOK-CONFIRMED-EMAIL.md BEFORE flipping this in production.",
      "SignIn": {
        "_RequireConfirmedEmail": "true (default, secure-by-default) requires a confirmed email to sign in. Every grant collapses the unconfirmed case into the same generic invalid_grant as a wrong password (no user enumeration).",
        "RequireConfirmedEmail": true
      },
      "_ServerSideSessions": "The ASP.NET Core Identity application cookie is SERVER-SIDE: the browser holds only the opaque OIDC `sid` as its cookie value, while the full AuthenticationTicket lives in the `oidcusersessions` table (DataProtection-protected). This enables per-device session enumeration (ISessionManagement.ListBySubjectAsync) and per-session revocation (ISessionManagement.RevokeAsync by sid), closing the protocol gap vs. Keycloak/Duende/Zitadel. The session store is DB-backed and therefore shared across replicas out of the box — no extra Redis dependency (unlike the DPoP/CIBA/nonce stores). Global revocation (RevokeAllSessionsAsync / management revoke-all / user disable/delete) bumps the security stamp AND drops every session row, so both the cookies and the session table reflect reality. Production schema must add the `oidcusersessions` table before deploying — see docs/migration/sql/080-add-oidc-user-sessions.sql (existing databases) or 001-create-empty-database.sql (fresh).",
      "_CredentialMutations": "Central security boundary for password, MFA, passkey and federated-login mutations. Audit preserves existing sessions during rollout while recording where recent authentication is missing; switch StepUpMode to Enforce after observing production telemetry. Successful mutations revoke OAuth credentials and other browser sessions while preserving and refreshing the initiating browser session.",
      "CredentialMutations": {
        "StepUpMode": "Audit",
        "MaximumAuthenticationAgeMinutes": 15
      },
      "_ClaimScopeMap": "Central claim-emission policy. Mapped claims require their scope. Unmapped claims retain legacy access-token behavior while IncludeUnmappedClaimsInAccessTokens is true; inventory and map consumers before changing it to false for strict allowlisting.",
      "ClaimScopeMap": {
        "ClaimToScope": {
          "directive": "directives"
        },
        "IncludeUnmappedClaimsInAccessTokens": true,
        "DeniedUnmappedClaimTypes": [
          "security_stamp",
          "concurrency_stamp",
          "password_hash",
          "authenticator_key",
          "recovery_codes"
        ]
      },
      "_PersonalTokens": "Observe computes strict least-privilege PAT decisions without breaking existing callers. After inventorying callers and issuing personal_tokens.manage, switch Mode to Enforce.",
      "PersonalTokens": {
        "Mode": "Observe",
        "RequiredScope": "personal_tokens.manage",
        "RequireRecentAuthentication": true,
        "MaximumAuthenticationAgeMinutes": 15,
        "MaximumLifetimeDays": 90,
        "RequireSenderConstraint": false,
        "EligibleClientIds": []
      },
      "_Mtls": "Mutual TLS (mTLS) client authentication and sender-constrained access tokens (RFC 8705, item 3.4). Opt-in (default false): enabling registers the MTLS-aliased endpoint paths (e.g. /connect/token/mtls) and advertises tls_client_certificate_bound_access_tokens=true in discovery. mTLS requires the HOST (Kestrel/nginx) to request and validate client certificates at the TLS handshake — that is DEPLOYMENT configuration (see Program.cs comments), not something this flag alone does. private_key_jwt (RFC 7523) is enabled by OpenIddict unconditionally and is the OTHER strong client-auth method (not gated here). Together with PAR (item 3.3) and DPoP (item 3.1), these are the FAPI 2.0 prerequisites.",
      "Mtls": {
        "_Enabled": "true registers MTLS endpoint aliases and advertises mTLS support in discovery. Default false — enable only after the host is configured for client certificates.",
        "Enabled": false,
        "_DeploymentMode": "Must be DirectTls or TrustedProxy before Enabled=true; Unattested fails startup.",
        "DeploymentMode": "Unattested",
        "RequireValidCertificateChain": true,
        "ClientCertificateThumbprints": {}
      },
      "_BackchannelLogout": "OIDC Back-Channel Logout 1.0. The STS signs and POSTs a short-lived logout_token to every RP that registered a backchannel_logout_uri. Enabled by default; clients without metadata are skipped. The OP session sid is included when the RP requires session-specific logout.",
      "BackchannelLogout": {
        "_Enabled": "true distributes a signed logout_token to RPs on sign-out and advertises the capability in discovery. Default true.",
        "Enabled": true
      },
      "_FrontchannelLogout": "OIDC Front-Channel Logout 1.0. After local sign-out, the OP renders each registered frontchannel_logout_uri in a one-time iframe page. Enabled by default; iss and the OP session sid are included for session correlation.",
      "FrontchannelLogout": {
        "_Enabled": "true renders registered RP logout URIs and advertises front-channel support. Default true.",
        "Enabled": true
      },
      "_Dpop": "DPoP (RFC 9449, item 3.1) — sender-constrains access tokens to a client-provided key, neutralizing token theft/replay without mTLS. OpenIddict 7.6 has NO DPoP support; the STS implements proof validation from scratch (DpopProofValidator, EC P-256/RSA, htm/htu binding, jti replay cache, optional nonce) and attaches cnf.jkt to tokens whose requests carried a valid proof. When Enabled but RequireForAllClients=false (default), DPoP is accepted-but-not-required (legacy bearer clients keep working). Flip RequireForAllClients only after every client sends DPoP proofs.",
      "Dpop": {
        "_Enabled": "true validates the DPoP header on token requests and sender-constrains tokens whose requests carried a valid proof. Default false.",
        "Enabled": false,
        "_RequireForAllClients": "true REJECTS token requests without a valid DPoP proof (bearer tokens no longer issued). Default false (accept-but-don't-require) for gradual rollout.",
        "RequireForAllClients": false,
        "_RequireNonce": "true enforces the DPoP nonce dance (RFC 9449 §8): a proof without a valid nonce claim is rejected with HTTP 400 use_dpop_nonce + a DPoP-Nonce response header; the client retries carrying that nonce. RECOMMENDED by the RFC; default false (flip once clients implement the retry). Ignored when Enabled is false.",
        "RequireNonce": false
      },
      "_Fapi2": "Opt-in enforcement boundary for the final FAPI 2.0 Security Profile. This does NOT assert certification. Only listed confidential clients are affected. DPoP mode requires Dpop.Enabled=true; mTLS mode requires Mtls.Enabled=true plus certificate validation at the TLS terminator. Profiled authorization flows require authenticated PAR, response_type=code, PKCE S256, redirect_uri, iss, short-lived codes/request_uri and sender-constrained tokens.",
      "Fapi2": {
        "Enabled": false,
        "ClientIds": [],
        "_SenderConstraint": "DPoP or Mtls. DPoP additionally binds dpop_jkt from PAR to the authorization code and token-endpoint proof.",
        "SenderConstraint": "Dpop",
        "AuthorizationCodeLifetimeSeconds": 60,
        "PushedAuthorizationRequestLifetimeSeconds": 300
      },
      "_Jarm": "JWT Secured Authorization Response Mode. Independent of FAPI 2.0 and disabled by default. Encryption resolves an eligible RSA public key from each recipient client's registered JWKS; no server-global recipient private key is used.",
      "Jarm": {
        "Enabled": false,
        "LifetimeSeconds": 120,
        "Encryption": {
          "_Enabled": "true requires an RSA public encryption key (use=enc or encrypt/wrapKey key_ops) in each client's registered JWKS.",
          "Enabled": false,
          "_KeyManagementAlgorithm": "JWE alg (key management). Default RSA-OAEP.",
          "KeyManagementAlgorithm": "RSA-OAEP",
          "_ContentEncryptionAlgorithm": "JWE enc (content encryption). Default A256CBC-HS512 (compatible with RSA key transport in Microsoft IdentityModel).",
          "ContentEncryptionAlgorithm": "A256CBC-HS512"
        }
      },
      "_SharedSignals": "OpenID Shared Signals Framework 1.0 / CAEP transmitter. Disabled by default. When enabled, exposes /.well-known/ssf-configuration, emits CAEP events (session-revoked, credential-change, device-change, assurance-level-change) on credential/session changes, and pushes signed SETs to receivers. Statically provisioned receivers get push delivery (RFC 8935); when StreamManagementEnabled is true, the dynamic stream API (RFC 8933) and poll delivery (RFC 8934) are also exposed. Put Authorization values in environment variables/secrets.",
      "SharedSignals": {
        "Enabled": false,
        "Receivers": [],
        "_StreamManagementEnabled": "true exposes the RFC 8933 stream-management REST API (/ssf/streams CRUD + verify) and the RFC 8934 poll endpoint (/ssf/events). Both require the ssf_transmitter scope. Default false — the REST surface is administrative and should be enabled deliberately.",
        "StreamManagementEnabled": false,
        "_RequiredScope": "OAuth scope required to call the stream-management and poll endpoints. Default ssf_transmitter. The scope must exist as an OpenIddict scope (create it via the management API or provisioning manifest).",
        "RequiredScope": "ssf_transmitter",
        "_RequireExplicitSubject": "When true, stream creation must include subject explicitly; use ALL only as a deliberate subscription to every subject. Default false for compatibility. Omitted subjects still default to ALL and emit a warning.",
        "RequireExplicitSubject": false
      },
      "_Ciba": "OpenID Connect CIBA Core 1.0 decoupled authentication. Pending state is database-authoritative and atomically consumed; generated access tokens are tracked by OpenIddict for introspection/revocation. Initiation and polling share one explicit client/grant policy, and the approval page displays the binding message.",
      "Ciba": {
        "_Enabled": "true registers the CIBA endpoints (initiation, completion, poll) and the pending-request store. Default false.",
        "Enabled": false,
        "_ExpiresInSeconds": "How long an unapproved auth_req_id stays valid (CIBA Core expires_in). Default 600 (10 min).",
        "ExpiresInSeconds": 600,
        "_PollIntervalSeconds": "Minimum seconds the client MUST wait between polls (CIBA Core interval). Faster polls get slow_down. Default 5.",
        "PollIntervalSeconds": 5,
        "_ClientPolicyMode": "Observe reports public/unentitled CIBA callers while retaining compatibility. Provision gt:urn:openid:params:grant-type:ciba and switch to Enforce per cohort.",
        "ClientPolicyMode": "Observe",
        "RequireConfidentialClient": true,
        "RequiredGrantPermission": "gt:urn:openid:params:grant-type:ciba",
        "AllowedClientIds": []
      },
      "_Mcp": "MCP (Model Context Protocol) / agent-AI resource-server configuration (Onda 4). Configures the STS to serve as the authorization server for MCP servers and other agent resource servers. Static resource validation remains active when only RFC 9728 metadata is enabled; it is disabled only when Mcp.Resources explicitly lists dynamic resource URIs, and those URIs still require per-client oi_rprm permissions.",
      "Mcp": {
        "_Resources": "Array of resource/audience URIs the STS recognizes as valid `resource` indicator targets (RFC 8707, item 4.2). Each typically points to an MCP server (e.g. https://mcp.example.com). A client must ALSO be granted the matching oi_rprm permission (Permissions.Prefixes.Resource + uri) to request one. The STS disables OpenIddict's static resource validation (trusting per-client oi_rprm) so dynamic MCP resources work without listing them all up front.",
        "Resources": [],
        "_ProtectedResourceMetadataEnabled": "true (default) exposes /.well-known/oauth-protected-resource (RFC 9728) pointing resource servers (MCP) to this STS as their authorization server. Disable only if the STS is never an MCP/agent AS.",
        "ProtectedResourceMetadataEnabled": true,
