  "_AllowedHosts": "Kestrel's Host-header allowlist, semicolon-separated (e.g. \"your-identity-host;www.your-identity-host\"). '*' accepts ANY Host header — combined with a reverse proxy that forwards the client's original Host unchecked, this enables host-header poisoning (spoofed password-reset links, cache-poisoning). Set this to the real production host(s); it does not need to match Issuer's scheme, only its host.",
  "AllowedHosts": "your-identity-host",
  "Sufficit": {
    "Identity": {
      "Issuer": "https://your-identity-host/",
      "ConnectionStringName": "DefaultConnection",
      "_TrustedProxies": "Array of CIDR strings for reverse-proxy networks allowed to set X-Forwarded-* headers. Leaving this UNSET (not listed) trusts only loopback (ASP.NET Core default). The example values below reflect the Sufficit production topology (verified 2026-07-21 from nginx access logs on eveo-apps/apoint-apps/castrum-apps): 177.104.185.114 (eveo-cloud Proxmox gateway), 177.104.185.117 (apoint-cloud gateway), plus the internal sufflocal/healthcheck networks 172.16.0.0/16 and the AWS Route53 health-checker range 15.177.0.0/16. If TrustedProxies is empty in production, the rate limiter partitions by the proxy's IP (one shared bucket for the whole deployment — self-inflicted 429s) and X-Forwarded-Proto is dropped (Request.Scheme stays http, defeating the cookie Secure policy). Adjust per environment in appsettings.<env>.json.",
      "TrustedProxies": [
        "177.104.185.114/32",
        "177.104.185.117/32",
        "172.16.0.0/16",
        "15.177.0.0/16"
      ],
      "Management": {
        "Enabled": false,
        "RoutePrefix": "api",
        "RequireAuthorization": true,
        "RequiredScope": "skoruba_identity_admin_api",
        "_RequireMfa": "true requires the access token to carry an amr claim proving multi-factor auth (item 5.2 [L3]) for the management endpoints. Default false — flip only after the login UI emits amr for MFA sessions, otherwise every admin token is rejected.",
        "RequireMfa": false
      },
      "_Scim": "Optional SCIM 2.0 provisioning endpoint at /scim/v2. Groups are opaque provisioning groups and are never interpreted as ASP.NET Identity roles or Sufficit business authorities.",
      "Scim": {
        "Enabled": false,
        "RequireAuthorization": true,
        "RequiredScope": "scim",
        "MaxResults": 100
      },
      "_Certificates": "Required in production. PFX files (X509Certificate2) used to sign and encrypt tokens. Leave empty only in Development, where ephemeral dev certificates are used automatically; any other environment fails to start without these.",
      "Certificates": {
        "_SigningPath": "Path to the PFX file used to sign tokens.",
        "SigningPath": "",
        "_SigningPassword": "Password protecting the signing PFX file.",
        "SigningPassword": "",
        "_EncryptionPath": "Path to the PFX file used to encrypt tokens.",
        "EncryptionPath": "",
        "_EncryptionPassword": "Password protecting the encryption PFX file.",
        "EncryptionPassword": ""
      },
      "_LegacyGrants": "Feature flags for OAuth 2.0 grant types removed by OAuth 2.1 (Resource Owner Password Credentials and the 'none' grant). Both default to FALSE (secure-by-default since EVALUATION-2026-07-21 §5 P0 #8). Opt-in per environment ONLY if a legacy client still requires these — and pair with telemetry + a removal date (Onda E).",
      "LegacyGrants": {
        "_Password": "Enables grant_type=password. Removed by OAuth 2.1. Default false — flip to true ONLY in environments where a legacy client still needs it (e.g. during migration).",
        "Password": false,
        "_None": "Enables the 'none' grant/response type (implicit access_token without PKCE). Removed by OAuth 2.1. Default false — flip to true ONLY for legacy WebForms / old-SwaggerUI clients during migration.",
        "None": false
      },
      "_TokenExchange": "Master switch for RFC 8693 token exchange. Default FALSE (secure-by-default). Production environments that have signed off a delegation policy must opt-in via Enabled=true AND configure a closed AllowedClientIds allowlist.",
      "TokenExchange": {
        "Enabled": false,
        "AllowedClientIds": []
      },
      "_RateLimit": "Fixed-window rate limit applied to POST /connect/token, per client IP, no queueing. Complements (never replaces) account lockout. Disable only if an upstream gateway already throttles the token endpoint.",
      "RateLimit": {
        "Enabled": true,
        "_PermitLimit": "Requests allowed per window, per client IP.",
        "PermitLimit": 30,
        "_WindowSeconds": "Window length in seconds; also sent as Retry-After on 429.",
        "WindowSeconds": 60,
        "_FailOnUntrustedProxy": "true (item 5.1 [L4]) makes startup FAIL when TrustedProxies is empty outside Development, instead of only logging a warning. Without trusted proxies, the rate limiter shares ONE bucket for all traffic (the proxy's IP) → self-inflicted 429s. Default false (warning); flip to true in production so a missing TrustedProxies cannot silently turn the rate limiter into a self-DoS.",
        "FailOnUntrustedProxy": false
      },
      "_Tokens": "Token lifetimes. Null access/identity values use the OpenIddict defaults (60 and 20 minutes). Refresh token rotation is always on; only lifetimes are configurable.",
      "Tokens": {
        "AccessTokenLifetimeMinutes": null,
        "IdentityTokenLifetimeMinutes": null,
        "RefreshTokenLifetimeDays": 14,
        "_UseReferenceAccessTokens": "P0 #5 / eval #B2 — MIGRATION-CONTRACT DECISION, not a mechanical toggle. true (default, current/legacy behavior) = opaque reference access tokens validated only via /connect/introspect. false = self-contained JWT access tokens validated locally by any resource server holding the signing public key. This applies to ALL clients at once (OpenIddict has no per-client token-format switch) — but the legacy inventory (docs/migration/PLAN.md) shows only ONE of the 26 legacy clients (sufficit-endpoints) actually used reference tokens; the rest expect a JWT they validate locally. Do NOT flip to false without first confirming every resource server can handle the new format (JWT: faster, no introspection dependency, but un-revocable before expiry; reference: instantly revocable, opaque, but every validation is a network round-trip here).",
        "UseReferenceAccessTokens": true
      },
      "_Lockout": "Account lockout enforced on password verification (interactive login and grant_type=password).",
      "Lockout": {
        "_MaxFailedAttempts": "Consecutive failures before the account locks.",
        "MaxFailedAttempts": 5,
        "_DurationMinutes": "How long the account stays locked.",
        "DurationMinutes": 5
      },
      "_Password": "Password complexity policy applied on user creation and password change/reset (eval M2). Defaults raise the bar above ASP.NET Core defaults (RequiredLength=6) toward the 2026 baseline (NIST 800-63B favors length; minimum 8, default here is 12). Existing users are NOT forced to change their password on login — Identity applies these rules only at creation/change time.",
      "Password": {
        "_RequiredLength": "Minimum password length. Default 12 (NIST 800-63B floor is 8).",
        "RequiredLength": 12,
        "_RequireDigit": "Require at least one digit. Default true.",
        "RequireDigit": true,
        "_RequireLowercase": "Require at least one lowercase letter. Default true.",
        "RequireLowercase": true,
        "_RequireUppercase": "Require at least one uppercase letter. Default true.",
        "RequireUppercase": true,
        "_RequireNonAlphanumeric": "Require at least one non-alphanumeric character. Default true.",
        "RequireNonAlphanumeric": true,
        "_RequiredUniqueChars": "Minimum number of distinct characters. Default 4.",
        "RequiredUniqueChars": 4,
        "_RejectBreached": "OPT-IN hook for a breached-password validator (HIBP range API or local list). Default false — the flag surfaces the decision but NO validator is wired up by default. Flip to true only after implementing and validating the validator's latency/availability for this environment.",
        "RejectBreached": false
      },
      "_SignIn": "Sign-in policy applied by SignInManager.CanSignInAsync, consulted by every grant in AuthorizationController (eval M3). RequireConfirmedEmail=true (default) blocks sign-in until the user proves email ownership, closing the 'register with someone else's email' hole. WARNING: external-login users (Google/GitHub/Facebook) are only EmailConfirmed when the provider asserts email_verified — see docs/runbooks/RUNBOOK-CONFIRMED-EMAIL.md BEFORE flipping this in production.",
      "SignIn": {
        "_RequireConfirmedEmail": "true (default, secure-by-default) requires a confirmed email to sign in. Every grant collapses the unconfirmed case into the same generic invalid_grant as a wrong password (no user enumeration).",
        "RequireConfirmedEmail": true
      },
      "_ClaimScopeMap": "Config-driven claim-type → required-scope allowlist that gates which custom persisted claims (e.g. 'directive') reach the access token (eval #10 / item 2.5 [M5]). A claim type present in ClaimToScope reaches the access token ONLY if the subject was granted the mapped scope; a claim type NOT in the map keeps the pre-existing behavior (access token). The map ships EMPTY by default — behavior is byte-identical to before until an operator deliberately adds an entry. Rollout one RS at a time: first confirm the RS requests the mapped scope, THEN add the entry (adding before that silently strips the claim from that RS's tokens). The relevant scopes ('directives', 'policies') are already registered.",
      "ClaimScopeMap": {
        "_ClaimToScope": "Object mapping claim type → scope name. Example: { \"directive\": \"directives\", \"policies\": \"policies\" }. Empty object = no gating (retrocompatible).",
        "ClaimToScope": {}
      },
      "_Mtls": "Mutual TLS (mTLS) client authentication and sender-constrained access tokens (RFC 8705, item 3.4). Opt-in (default false): enabling registers the MTLS-aliased endpoint paths (e.g. /connect/token/mtls) and advertises tls_client_certificate_bound_access_tokens=true in discovery. mTLS requires the HOST (Kestrel/nginx) to request and validate client certificates at the TLS handshake — that is DEPLOYMENT configuration (see Program.cs comments), not something this flag alone does. private_key_jwt (RFC 7523) is enabled by OpenIddict unconditionally and is the OTHER strong client-auth method (not gated here). Together with PAR (item 3.3) and DPoP (item 3.1), these are the FAPI 2.0 prerequisites.",
      "Mtls": {
        "_Enabled": "true registers MTLS endpoint aliases and advertises mTLS support in discovery. Default false — enable only after the host is configured for client certificates.",
        "Enabled": false
      },
      "_BackchannelLogout": "OIDC Back-Channel Logout 1.0 (item 3.2 [L1]). When enabled, the STS signs and POSTs a logout_token to every RP that registered a backchannel_logout_uri when the user signs out, terminating the RP's local session too. OpenIddict 7.6 only consumes logout_tokens — the STS hand-builds the JWT (LogoutTokenGenerator) and fans it out (BackchannelLogoutDistributor, direct HTTP with bounded retry; a queue-backed implementation can drop in later). Discovery advertises backchannel_logout_supported=true only when enabled. Opt-in (default false): only useful once RPs register a backchannel_logout_uri.",
      "BackchannelLogout": {
        "_Enabled": "true distributes a signed logout_token to RPs on sign-out and advertises the capability in discovery. Default false.",
        "Enabled": false
      },
      "_Dpop": "DPoP (RFC 9449, item 3.1) — sender-constrains access tokens to a client-provided key, neutralizing token theft/replay without mTLS. OpenIddict 7.6 has NO DPoP support; the STS implements proof validation from scratch (DpopProofValidator, EC P-256/RSA, htm/htu binding, jti replay cache, optional nonce) and attaches cnf.jkt to tokens whose requests carried a valid proof. When Enabled but RequireForAllClients=false (default), DPoP is accepted-but-not-required (legacy bearer clients keep working). Flip RequireForAllClients only after every client sends DPoP proofs.",
      "Dpop": {
        "_Enabled": "true validates the DPoP header on token requests and sender-constrains tokens whose requests carried a valid proof. Default false.",
        "Enabled": false,
        "_RequireForAllClients": "true REJECTS token requests without a valid DPoP proof (bearer tokens no longer issued). Default false (accept-but-don't-require) for gradual rollout.",
        "RequireForAllClients": false,
        "_RequireNonce": "true enforces the DPoP nonce dance (RFC 9449 §8): a proof without a valid nonce claim is rejected with HTTP 400 use_dpop_nonce + a DPoP-Nonce response header; the client retries carrying that nonce. RECOMMENDED by the RFC; default false (flip once clients implement the retry). Ignored when Enabled is false.",
        "RequireNonce": false
      },
      "_Ciba": "CIBA (Client-Initiated Backchannel Authentication, RFC 9126, item 3.5) — decoupled auth where the consumption device (kiosk/call-center/AI agent) is NOT the authentication device. OpenIddict 7.6 has NO CIBA support; the STS implements it from scratch: /bc-authorize initiation, an in-memory ICibaPendingRequestStore, /connect/ciba/complete (out-of-band approval), and /connect/ciba/token (poll). The access token is emitted by CibaAccessTokenGenerator (a hand-built JWT signed with the STS key, validatable against the STS JWKS) because OpenIddict forbids SignIn from the unregistered endpoint. LIMITATION: the CIBA JWT is NOT an OpenIddict reference token (no /connect/introspect or /connect/revocation); insert into IOpenIddictTokenManager when a client needs those.",
      "Ciba": {
        "_Enabled": "true registers the CIBA endpoints (initiation, completion, poll) and the pending-request store. Default false.",
        "Enabled": false,
        "_ExpiresInSeconds": "How long an unapproved auth_req_id stays valid (RFC 9126 §2.2 expires_in). Default 600 (10 min).",
        "ExpiresInSeconds": 600,
        "_PollIntervalSeconds": "Minimum seconds the client MUST wait between polls (RFC 9126 §2.2 interval). Faster polls get slow_down. Default 5.",
        "PollIntervalSeconds": 5
      },
      "_Mcp": "MCP (Model Context Protocol) / agent-AI resource-server configuration (Onda 4). Configures the STS to serve as the authorization server for MCP servers and other agent resource servers. NOTE: when ProtectedResourceMetadataEnabled=true (default) OR Mcp.Resources is non-empty, the STS disables OpenIddict's STATIC resource validation (DisableResourceValidation) and trusts per-client oi_rprm permissions instead — this affects ALL token grants (resource indicators are accepted dynamically), not just MCP clients. If you need strict static-audience validation, set ProtectedResourceMetadataEnabled=false and leave Resources empty.",
      "Mcp": {
        "_Resources": "Array of resource/audience URIs the STS recognizes as valid `resource` indicator targets (RFC 8707, item 4.2). Each typically points to an MCP server (e.g. https://mcp.sufficit.com.br). A client must ALSO be granted the matching oi_rprm permission (Permissions.Prefixes.Resource + uri) to request one. The STS disables OpenIddict's static resource validation (trusting per-client oi_rprm) so dynamic MCP resources work without listing them all up front.",
        "Resources": [],
        "_ProtectedResourceMetadataEnabled": "true (default) exposes /.well-known/oauth-protected-resource (RFC 9728) pointing resource servers (MCP) to this STS as their authorization server. Disable only if the STS is never an MCP/agent AS.",
        "ProtectedResourceMetadataEnabled": true,
        "_Dcr": "Dynamic Client Registration (RFC 7591, item 4.3) — opt-in. When enabled, exposes /connect/register for clients (incl. MCP clients) to self-register. Gated: requires an initial access token by default. HIGH-RISK open-registration surface — enable deliberately.",
        "Dcr": {
          "_Enabled": "true exposes /connect/register. Default false (secure-by-default).",
          "Enabled": false,
          "_RequireInitialAccessToken": "true (default) requires a valid bearer initial access token in the Authorization header for /connect/register. Without it, anyone can register a client.",
          "RequireInitialAccessToken": true,
          "_InitialAccessToken": "The static initial access token accepted by /connect/register. Configure via User Secrets / env var — NEVER commit a real value. Empty = endpoint rejects all requests (even when Enabled).",
          "InitialAccessToken": ""
        }
