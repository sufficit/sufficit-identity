<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sufficit.Identity.Application</RootNamespace>
    <AssemblyName>Sufficit.Identity.Application.Abstractions</AssemblyName>
    <Description>Sufficit Identity — implementation-neutral application contracts.</Description>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <DefineConstants>$(DefineConstants);APPLICATION_CONTRACTS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
