             Link="Management\Authorization\ManagementAuthorizationContracts.cs" />
    <Compile Include="..\..\management\Authorizations\AuthorizationManagementService.cs"
             Link="Management\Authorizations\AuthorizationManagementContracts.cs" />
    <Compile Include="..\..\management\Branding\BrandingManagementService.cs"
             Link="Management\Branding\BrandingManagementContracts.cs" />
    <Compile Include="..\..\management\Claims\ClaimManagementService.cs"
             Link="Management\Claims\ClaimManagementContracts.cs" />
    <Compile Include="..\..\management\Clients\ClientManagementService.cs"
             Link="Management\Clients\ClientManagementContracts.cs" />
    <Compile Include="..\..\management\Clients\ClientConfigurationDraftService.cs"
             Link="Management\Clients\ClientConfigurationDraftContracts.cs" />
    <Compile Include="..\..\management\Database\DatabaseMonitoringService.cs"
             Link="Management\Database\DatabaseMonitoringContracts.cs" />
    <Compile Include="..\..\management\Overview\ManagementOverviewService.cs"
             Link="Management\Overview\ManagementOverviewContracts.cs" />
    <Compile Include="..\..\management\Metrics\MetricsManagementService.cs"
             Link="Management\Metrics\MetricsManagementContracts.cs" />
    <Compile Include="..\..\management\Provisioning\ProvisioningManagementService.cs"
             Link="Management\Provisioning\ProvisioningManagementContracts.cs" />
    <Compile Include="..\..\management\Scopes\ScopeManagementService.cs"
