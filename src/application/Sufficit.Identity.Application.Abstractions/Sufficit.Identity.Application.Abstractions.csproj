    <Compile Include="..\..\management\Sessions\SessionManagementService.cs"
             Link="Management\Sessions\SessionManagementContracts.cs" />
    <Compile Include="..\..\management\Users\UserManagementService.cs"
             Link="Management\Users\UserManagementContracts.cs" />
