@page "/claims/new"
@attribute [Authorize(Policy = ManagementUiPolicies.ManageClaims)]
@inject ManagementClaimDataSource ClaimData
@inject ManagementUserDataSource UserData
@inject NavigationManager Navigation

<PageTitle>Atribuir claim | Sufficit Identity</PageTitle>

<PageHeader Title="Atribuir claim"
            Description="Associe um atributo adicional a uma conta sem incorporar regras de negócio da aplicação.">
    <Actions>
        <a class="button button--secondary" href="@BackHref">
            <AppIcon Name="arrow-left" Size="17" />
            Voltar para claims
        </a>
    </Actions>
</PageHeader>

<section class="contract-strip contract-strip--warning">
    <AppIcon Name="refresh" Size="20" />
    <div>
        <strong>Alteração efetiva na próxima emissão</strong>
        <span>A atribuição atualiza o selo de segurança e revoga tokens ativos da conta.</span>
    </div>
    <StatusBadge Tone="warning">Impacta sessões</StatusBadge>
</section>

@if (submission?.IsSuccess is false)
{
    <section class="inline-notice inline-notice--danger" role="alert">
        <AppIcon Name="alert" Size="19" />
        <div>
            <strong>Não foi possível atribuir a claim</strong>
            <span>@submission.ErrorMessage</span>
        </div>
    </section>
}

<EditForm Model="model"
          OnValidSubmit="CreateAsync"
          FormName="create-user-claim"
          class="management-form">
    <DataAnnotationsValidator />

    <section class="form-section" aria-labelledby="claim-account-heading">
        <div class="form-section__heading">
            <h2 id="claim-account-heading">Conta</h2>
            <p>Pesquise no diretório do provedor. A lista também usa o serviço canônico de usuários.</p>
        </div>

        <div class="user-picker">
            <div class="field-group">
                <label for="user-search">Pesquisar conta</label>
                <div class="user-search">
                    <input id="user-search"
                           class="form-control"
                           type="search"
                           placeholder="Nome de usuário ou e-mail"
                           autocomplete="off"
                           @bind="userSearch" />
                    <button class="button button--secondary"
                            type="button"
                            disabled="@loadingUsers"
                            @onclick="SearchUsersAsync">
                        Pesquisar
                    </button>
                </div>
            </div>

            <div class="field-group">
                <label for="claim-user">Conta selecionada</label>
                <InputSelect id="claim-user"
                             class="form-control"
                             @bind-Value="model.UserId">
                    <option value="">Selecione uma conta</option>
                    @foreach (var user in Users)
                    {
                        <option value="@user.Id">@UserLabel(user)</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => model.UserId" />
                <span class="field-hint">@UserPickerHint</span>
            </div>
        </div>
    </section>

    <section class="form-section" aria-labelledby="claim-value-heading">
        <div class="form-section__heading">
            <h2 id="claim-value-heading">Atributo</h2>
            <p>Use nomes interoperáveis quando existirem. Claims de protocolo e perfil básico são protegidas.</p>
        </div>

        <div class="field-group">
            <label for="claim-type">Tipo da claim</label>
            <InputText id="claim-type"
                       class="form-control"
                       list="claim-type-suggestions"
                       autocomplete="off"
                       @bind-Value="model.Type" />
            <datalist id="claim-type-suggestions">
                @foreach (var type in SuggestedTypes)
                {
                    <option value="@type"></option>
                }
            </datalist>
            <ValidationMessage For="() => model.Type" />
            <span class="field-hint">Exemplo: <code>locale</code>, <code>zoneinfo</code> ou um nome com namespace próprio.</span>
        </div>

        <div class="field-group">
            <label for="claim-value">Valor</label>
            <InputTextArea id="claim-value"
                           class="form-control form-control--textarea"
                           @bind-Value="model.Value" />
            <ValidationMessage For="() => model.Value" />
            <span class="field-hint">O valor não será copiado para o evento de auditoria.</span>
        </div>
    </section>

    <footer class="form-actions">
        <a class="button button--secondary" href="@BackHref">Cancelar</a>
        <button class="button button--primary" type="submit" disabled="@submitting">
            @if (submitting)
            {
                <span class="button-spinner" aria-hidden="true"></span>
                <span>Atribuindo…</span>
            }
            else
            {
                <AppIcon Name="plus" Size="17" />
                <span>Atribuir claim</span>
            }
        </button>
    </footer>
</EditForm>

@code {
    [SupplyParameterFromQuery(Name = "user")]
    public string? User { get; set; }

    private readonly ClaimCreateModel model = new();
    private ManagementDataResult<ManagementClaimMetadata>? metadataResult;
    private ManagementDataResult<ManagementUserPage>? usersResult;
    private ManagementDataResult<ManagementClaimAssignment>? submission;
    private string userSearch = string.Empty;
    private bool loadingUsers;
    private bool submitting;

    private IReadOnlyList<ManagementUserSummary> Users =>
        usersResult?.Value?.Items ?? [];

    private IReadOnlyList<string> SuggestedTypes =>
        metadataResult?.Value?.SuggestedTypes ?? [];

    private string BackHref =>
        string.IsNullOrWhiteSpace(User)
            ? "claims"
            : $"claims?user={Uri.EscapeDataString(User)}";

    private string UserPickerHint =>
        loadingUsers
            ? "Consultando o diretório…"
            : usersResult?.IsSuccess is false
                ? usersResult.ErrorMessage ?? "Não foi possível consultar as contas."
                : Users.Count is 0
                    ? "Nenhuma conta encontrada."
                    : $"{Users.Count} conta(s) disponível(is) nesta pesquisa.";

    protected override async Task OnInitializedAsync()
    {
        model.UserId = User ?? string.Empty;
        await Task.WhenAll(
            SearchUsersAsync(),
            LoadMetadataAsync());
    }

    private async Task LoadMetadataAsync() =>
        metadataResult = await ClaimData.GetMetadataAsync();

    private async Task SearchUsersAsync()
    {
        loadingUsers = true;
        usersResult = await UserData.SearchAsync(
            new ManagementUserSearch(userSearch, 1, 100));
        loadingUsers = false;
    }

    private async Task CreateAsync()
    {
        if (submitting)
        {
            return;
        }

        submitting = true;
        submission = await ClaimData.CreateAsync(
            new CreateManagementClaimCommand(
                model.UserId,
                model.Type,
                model.Value));
        submitting = false;

        if (submission.IsSuccess && submission.Value is not null)
        {
            Navigation.NavigateTo($"claims/{submission.Value.Id}?created=1");
        }
    }

    private static string UserLabel(ManagementUserSummary user)
    {
        var primary = user.UserName ?? user.Email ?? user.Id;
        return user.Email is not null
            && !string.Equals(primary, user.Email, StringComparison.OrdinalIgnoreCase)
                ? $"{primary} — {user.Email}"
                : primary;
    }

    private sealed class ClaimCreateModel
    {
        [Required(ErrorMessage = "Selecione uma conta.")]
        public string UserId { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe o tipo da claim.")]
        [StringLength(256, ErrorMessage = "Use no máximo 256 caracteres.")]
        public string Type { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe o valor da claim.")]
        [StringLength(4096, ErrorMessage = "Use no máximo 4096 caracteres.")]
        public string Value { get; set; } = string.Empty;
    }
}
