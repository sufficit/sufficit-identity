@page "/users/new"
@attribute [StreamRendering]
@inject ManagementUserDataSource UserData
@inject NavigationManager Navigation

<PageTitle>Novo usuário | Sufficit Identity</PageTitle>

<PageHeader Title="Novo usuário"
            Description="Crie uma identidade no contexto autorizado sem conceder papéis ou diretivas implicitamente.">
    <Actions>
        <a class="button button--secondary" href="users">
            <AppIcon Name="arrow-left" Size="17" />
            Voltar para usuários
        </a>
    </Actions>
</PageHeader>

<section class="contract-strip contract-strip--success">
    <AppIcon Name="shield" Size="20" />
    <div>
        <strong>Privilégio mínimo desde a criação</strong>
        <span>A associação ao contexto é persistida separadamente; autoridade só nasce de regras explícitas.</span>
    </div>
    <StatusBadge Tone="success">Auditável</StatusBadge>
</section>

@if (loading)
{
    <section class="form-section" aria-busy="true">
        <div class="table-skeleton" aria-label="Carregando contextos autorizados">
            @for (var index = 0; index < 4; index++)
            {
                <span></span>
            }
        </div>
    </section>
}
else if (accessResult?.IsSuccess is false)
{
    <section class="panel">
        <EmptyState Icon="shield"
                    Title="@AccessErrorTitle"
                    Description="@accessResult.ErrorMessage">
            <Actions>
                <button class="button button--secondary"
                        type="button"
                        @onclick="LoadAsync">
                    Tentar novamente
                </button>
            </Actions>
        </EmptyState>
    </section>
}
else if (!Access.CanCreate || Access.ContextIds.Count is 0)
{
    <section class="panel">
        <EmptyState Icon="users"
                    Title="Nenhum contexto disponível para criação"
                    Description="A conta possui acesso ao módulo, mas não recebeu um contexto válido para criar usuários.">
            <Actions>
                <a class="button button--secondary" href="users">Voltar para usuários</a>
            </Actions>
        </EmptyState>
    </section>
}
else
{
    @if (submission?.IsSuccess is false)
    {
        <section class="inline-notice inline-notice--danger" role="alert">
            <AppIcon Name="alert" Size="19" />
            <div>
                <strong>@SubmissionTitle</strong>
                <span>@submission.ErrorMessage</span>
            </div>
        </section>
    }

    <EditForm Model="model"
              OnValidSubmit="CreateAsync"
              FormName="create-management-user"
              class="management-form">
        <DataAnnotationsValidator />

        <section class="form-section" aria-labelledby="user-context-heading">
            <div class="form-section__heading">
                <h2 id="user-context-heading">Contexto de origem</h2>
                <p>O contexto limita esta criação e passa a compor a associação persistida da conta.</p>
            </div>

            <div class="field-group">
                <label for="user-context">Contexto</label>
                <InputSelect id="user-context"
                             class="form-control"
                             @bind-Value="model.ContextId">
                    @foreach (var contextId in Access.ContextIds)
                    {
                        <option value="@contextId">@ContextLabel(contextId)</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => model.ContextId" />
                @if (submission?.ErrorField is "contextId")
                {
                    <p class="validation-message">@submission.ErrorMessage</p>
                }
                <span class="field-hint">A senha e a identidade continuam únicas, mesmo se a conta ganhar outros contextos depois.</span>
            </div>
        </section>

        <section class="form-section" aria-labelledby="user-identity-heading">
            <div class="form-section__heading">
                <h2 id="user-identity-heading">Identificação</h2>
                <p>Use dados reconhecíveis pelo usuário. O e-mail começa pendente de confirmação.</p>
            </div>

            <div class="form-grid form-grid--two">
                <div class="field-group">
                    <label for="user-name">Nome de usuário</label>
                    <InputText id="user-name"
                               class="form-control"
                               autocomplete="username"
                               maxlength="256"
                               @bind-Value="model.UserName" />
                    <ValidationMessage For="() => model.UserName" />
                    @if (submission?.ErrorField is "userName")
                    {
                        <p class="validation-message">@submission.ErrorMessage</p>
                    }
                </div>

                <div class="field-group">
                    <label for="user-email">E-mail</label>
                    <InputText id="user-email"
                               class="form-control"
                               type="email"
                               autocomplete="email"
                               maxlength="256"
                               @bind-Value="model.Email" />
                    <ValidationMessage For="() => model.Email" />
                    @if (submission?.ErrorField is "email")
                    {
                        <p class="validation-message">@submission.ErrorMessage</p>
                    }
                </div>
            </div>
        </section>

        <section class="form-section" aria-labelledby="user-password-heading">
            <div class="form-section__heading">
                <h2 id="user-password-heading">Senha inicial</h2>
                <p>A política real é validada pelo Identity no servidor. A senha nunca entra na auditoria ou na resposta.</p>
            </div>

            <div class="form-grid form-grid--two">
                <div class="field-group">
                    <label for="initial-password">Senha</label>
                    <InputText id="initial-password"
                               class="form-control"
                               type="password"
                               autocomplete="new-password"
                               @bind-Value="model.InitialPassword" />
                    <ValidationMessage For="() => model.InitialPassword" />
                    @if (submission?.ErrorField is "initialPassword")
                    {
                        <p class="validation-message">@submission.ErrorMessage</p>
                    }
                </div>

                <div class="field-group">
                    <label for="confirm-password">Confirmar senha</label>
                    <InputText id="confirm-password"
                               class="form-control"
                               type="password"
                               autocomplete="new-password"
                               @bind-Value="model.ConfirmPassword" />
                    <ValidationMessage For="() => model.ConfirmPassword" />
                </div>
            </div>
            <span class="field-hint">Compartilhe a senha por um canal seguro e oriente a troca após o primeiro acesso.</span>
        </section>

        <footer class="form-actions">
            <a class="button button--secondary" href="users">Cancelar</a>
            <button class="button button--primary"
                    type="submit"
                    disabled="@submitting">
                @if (submitting)
                {
                    <span class="button-spinner" aria-hidden="true"></span>
                    <span>Criando usuário…</span>
                }
                else
                {
                    <AppIcon Name="plus" Size="17" />
                    <span>Criar usuário</span>
                }
            </button>
        </footer>
    </EditForm>
}

@code {
    [SupplyParameterFromQuery(Name = "context")]
    public string? RequestedContextId { get; set; }

    private readonly UserCreateModel model = new();
    private ManagementDataResult<ManagementUserAccess>? accessResult;
    private ManagementDataResult<ManagementUserDetail>? submission;
    private bool loading = true;
    private bool submitting;

    private ManagementUserAccess Access =>
        accessResult?.Value ?? new(false, [], false);

    private string AccessErrorTitle =>
        accessResult?.Outcome is ManagementDataOutcome.StepUpRequired
            ? "Autenticação adicional necessária"
            : "Não foi possível carregar sua autoridade";

    private string SubmissionTitle =>
        submission?.Outcome is ManagementDataOutcome.StepUpRequired
            ? "MFA exigido para criar neste contexto"
            : submission?.Outcome is ManagementDataOutcome.Conflict
                ? "Já existe uma identidade com esses dados"
                : "Não foi possível criar o usuário";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        accessResult = await UserData.GetAccessAsync();
        loading = false;

        if (accessResult.IsSuccess)
        {
            model.ContextId =
                !string.IsNullOrWhiteSpace(RequestedContextId)
                && Access.ContextIds.Contains(
                    RequestedContextId,
                    StringComparer.OrdinalIgnoreCase)
                    ? RequestedContextId
                    : Access.ContextIds.FirstOrDefault() ?? string.Empty;
        }
    }

    private async Task CreateAsync()
    {
        if (submitting)
        {
            return;
        }

        submitting = true;
        submission = await UserData.CreateAsync(
            new CreateManagementUserCommand(
                model.UserName,
                model.Email,
                model.InitialPassword,
                model.ContextId));
        submitting = false;

        if (submission.IsSuccess && submission.Value is not null)
        {
            Navigation.NavigateTo(
                $"users/{Uri.EscapeDataString(submission.Value.Id)}" +
                $"?created=1&context={Uri.EscapeDataString(model.ContextId)}");
        }
    }

    private static string ContextLabel(string contextId) =>
        contextId.Length > 12
            ? $"{contextId[..8]}…{contextId[^4..]}"
            : contextId;

    private sealed class UserCreateModel
    {
        [Required(ErrorMessage = "Selecione o contexto.")]
        public string ContextId { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe o nome de usuário.")]
        [StringLength(256, ErrorMessage = "Use no máximo 256 caracteres.")]
        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe o e-mail.")]
        [EmailAddress(ErrorMessage = "Informe um e-mail válido.")]
        [StringLength(256, ErrorMessage = "Use no máximo 256 caracteres.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe a senha inicial.")]
        public string InitialPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirme a senha inicial.")]
        [Compare(
            nameof(InitialPassword),
            ErrorMessage = "As senhas não coincidem.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
