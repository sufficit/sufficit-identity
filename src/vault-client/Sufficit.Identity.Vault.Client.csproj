<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sufficit.Identity.Vault.Client</RootNamespace>
    <AssemblyName>Sufficit.Identity.Vault.Client</AssemblyName>
    <Description>Sufficit Identity — thin REST client for the central vault (named secrets). No key material ever reaches this package; it only talks to the management API.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\application\Sufficit.Identity.Application.Abstractions\Sufficit.Identity.Application.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sufficit.Identity.Tests" />
  </ItemGroup>

</Project>
