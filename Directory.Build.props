<Project>

  <PropertyGroup>
    <Product>Sufficit Identity</Product>
    <Company>Sufficit</Company>
    <Authors>Sufficit</Authors>
    <Copyright>Copyright (c) 2026 Sufficit</Copyright>
    <Version>0.4.0-alpha</Version>
    <NeutralLanguage>en-US</NeutralLanguage>

    <!-- Strongly encourage modern C# -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Central package management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Shared SUI components: local sibling checkout OR published package.
         When the sufficit-blazor-ui repository is checked out BESIDE this
         repository, projects reference it directly for a fast inner loop
         against unreleased component changes; otherwise (CI, Docker, fresh
         clones) they consume the published Sufficit.Blazor.UI NuGet package.
         IMPORTANT: the committed packages.lock.json must stay in PACKAGE
         mode (CI restores in locked mode and has no sibling). After local
         work with the sibling, regenerate the locks for commit by forcing
         package mode (restore with force-evaluate and the property
         SufficitUseLocalSui=false: dotnet restore with
         "-p:SufficitUseLocalSui=false"). -->
      <!-- (Note: XML comments cannot contain double hyphens, so the exact
           CLI flags are spelled out in words here.) -->
    <SufficitUseLocalSui Condition="'$(SufficitUseLocalSui)' == '' and Exists('$(MSBuildThisFileDirectory)../sufficit-blazor-ui/src/Sufficit.Blazor.UI.csproj')">true</SufficitUseLocalSui>
  </PropertyGroup>

</Project>
