# Sufficit Identity operational hardening
#
# Installed as /etc/sufficit/identity/hardening.env by helpers/install.sh.
# The installer never overwrites an existing value. On upgrades it appends
# newly introduced keys with these secure defaults. Values use ASP.NET Core's
# double-underscore environment-variable mapping for ':' configuration keys.
# Keep secrets and connection strings out of this file.

# The application limiter protects POST /connect/token. Nginx adds edge limits
# for interactive authentication, registration, CIBA, management and SCIM.
Sufficit__Identity__RateLimit__Enabled=true
Sufficit__Identity__RateLimit__PermitLimit=30
Sufficit__Identity__RateLimit__WindowSeconds=60
Sufficit__Identity__RateLimit__FailOnUntrustedProxy=true

# Initial CSP calibration stage. The same-origin collector is implemented by
# the STS and logs a sanitized report projection to the Identity journal.
Sufficit__Identity__Csp__Enabled=true
Sufficit__Identity__Csp__ReportOnly=true
Sufficit__Identity__Csp__ReportUri=/security/csp-report

# Sensitive scopes require MFA evidence by default. A client_credentials
# integration cannot satisfy MFA; keep those callers on a separately reviewed
# exception path rather than weakening the default for human operators.
Sufficit__Identity__Management__RequireMfa=true
Sufficit__Identity__Scim__RequireMfa=true
Sufficit__Identity__PersonalTokens__RequireMfa=true
Sufficit__Identity__SharedSignals__RequireMfa=true

# GitHub stays unavailable unless both this non-secret rollout gate and the
# central OAuth credentials in vault-secrets.env are present. Keep the gate in
# the persistent overlay so every replica advertises the same provider state.
Sufficit__Identity__ExternalProviders__GitHub__Enabled=true

# Temporary bearer issuance is an explicit deployment opt-in. Both flows are
# short-lived, reference-token based and remain subject to Management MFA and
# capability checks. Enable only the flow exposed by the deployed UI.
Sufficit__Identity__Management__TemporaryProvisioningToken__Enabled=false
Sufficit__Identity__Management__TemporaryOperatorToken__Enabled=false

# The internal multi-tenant system was removed (2026-08): isolation is per
# deployment, externally. Object-level authorization covers protected
# principals only; no tenant configuration is required or accepted.

# Bound every process to a finite MySQL/MariaDB pool and recover when the
# process remains alive but the pool can no longer obtain a usable connection.
# MaximumSize is PER replica; keep the sum below the database connection budget.
Sufficit__Identity__Database__ConnectionPool__MaximumSize=50
Sufficit__Identity__Database__ConnectionPool__MinimumSize=0
Sufficit__Identity__Database__ConnectionPool__ConnectionTimeoutSeconds=15
Sufficit__Identity__Database__ConnectionPool__CommandTimeoutSeconds=30
Sufficit__Identity__Database__ConnectionPool__ConnectionLifetimeSeconds=180
Sufficit__Identity__Database__ConnectionPool__ConnectionIdleTimeoutSeconds=180
Sufficit__Identity__Database__ConnectionPool__ResetOnCheckout=true
Sufficit__Identity__Database__ConnectionPool__ApplicationName=Sufficit.Identity
Sufficit__Identity__Database__Watchdog__Enabled=true
Sufficit__Identity__Database__Watchdog__StartupDelaySeconds=60
Sufficit__Identity__Database__Watchdog__ProbeIntervalSeconds=30
Sufficit__Identity__Database__Watchdog__ProbeTimeoutSeconds=10
Sufficit__Identity__Database__Watchdog__ConsecutiveFailuresBeforeRestart=3

# The current stores are process-local. These features intentionally remain
# disabled until a capable client exists and, before HA/CIBA, shared stores are
# implemented for DPoP nonce/replay state and CIBA pending requests.
Sufficit__Identity__Dpop__Enabled=false
Sufficit__Identity__Dpop__RequireForAllClients=false
Sufficit__Identity__Dpop__RequireNonce=false
Sufficit__Identity__Ciba__Enabled=false

# Advanced interoperability profiles remain explicit opt-ins. FAPI also needs
# a client allowlist and DPoP/mTLS prerequisites; SSF needs configured HTTPS
# receivers and should gain a durable outbox before delivery is contractual.
Sufficit__Identity__Fapi2__Enabled=false
Sufficit__Identity__Jarm__Enabled=false
Sufficit__Identity__SharedSignals__Enabled=false
