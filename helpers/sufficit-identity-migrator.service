[Unit]
Description=Sufficit Identity database migrator
After=network-online.target
Requires=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/sufficit-identity/migrate-database.sh
WorkingDirectory=/opt/sufficit-identity/
User=dotnetuser
Group=www-data
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=DOTNET_ROOT=/opt/dotnet-10
EnvironmentFile=-/etc/sufficit/identity/hardening.env

[Install]
WantedBy=multi-user.target
