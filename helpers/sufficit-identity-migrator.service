# =============================================================================
# Sufficit Identity database migrator — MANUAL, ONE SERVER ONLY.
#
# The identity database is MULTIMASTER-REPLICATED across eveo-apps,
# apoint-apps and castrum-apps: applying a migration on any ONE node
# replicates it to the others. The migrator must therefore be started BY
# HAND, once, on a single node — never enabled (no [Install] section:
# "static" unit, cannot be auto-started at boot).
#
#   systemctl start sufficit-identity-migrator
#   journalctl -u sufficit-identity-migrator -n 20
#
# The EF migrator itself takes a MariaDB GET_LOCK advisory lock, so a second
# node starting concurrently blocks until the first finishes — but do not
# rely on that: replication makes the second run redundant.
# =============================================================================
[Unit]
Description=Sufficit Identity database migrator (manual, one node only - multimaster)
After=network-online.target
Requires=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/sufficit-identity/migrate-database.sh
WorkingDirectory=/opt/sufficit-identity/
User=dotnetuser
Group=www-data
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=DOTNET_ROOT=/opt/dotnet-10
EnvironmentFile=-/etc/sufficit/identity/hardening.env
EnvironmentFile=-/etc/sufficit/identity/vault-secrets.env

# NO [Install] section on purpose: the unit is STATIC (cannot be enabled,
# never starts at boot) — database migrations run manually, on one node of
# the multimaster replication group only.
