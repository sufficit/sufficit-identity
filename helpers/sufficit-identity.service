[Unit]
Description=.NET Sufficit Identity Service (OpenIddict)
After=network-online.target
Requires=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
ExecStartPre=/usr/libexec/sufficit-identity/prestart.sh
ExecStart=/opt/dotnet-10/dotnet Sufficit.Identity.Server.dll
WorkingDirectory=/opt/sufficit-identity/
User=dotnetuser
Group=www-data
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
# The Unix socket is shared with nginx through the www-data group. Keep
# group-write permission while leaving all other permissions masked.
UMask=0007

SyslogIdentifier=[sufficit][identity]
StandardOutput=journal
StandardError=journal

Restart=on-failure
TimeoutStartSec=120
TimeoutStopSec=15
RestartSec=10
KillMode=mixed

KillSignal=SIGINT
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=DOTNET_ROOT=/opt/dotnet-10
EnvironmentFile=-/etc/sufficit/identity/hardening.env
EnvironmentFile=-/etc/sufficit/identity/vault-secrets.env

RuntimeDirectory=sufficit-identity
RuntimeDirectoryMode=0775
ReadWritePaths=/run/sufficit-identity

[Install]
WantedBy=multi-user.target
