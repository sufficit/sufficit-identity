                  "password",
                  "{USER_PASSWORD}"
                ],
                [
                  "wait",
                  "css",
                  "button[type=submit]",
                  10,
                  ".*",
                  "update-image-placeholder-optional"
                ],
                [
                  "click",
                  "css",
                  "button[type=submit]"
                ]
              ]
            },
            {
              "task": "Authorization error page",
              "optional": true,
              "match": "https://identity-op.test/connect/authorize*",
              "commands": [
                [
                  "wait",
                  "css",
                  "body",
                  10,
                  ".*",
                  "update-image-placeholder-optional"
                ]
              ]
            }
          ]
        }
      ]
    },
