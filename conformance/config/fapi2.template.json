{
  "alias": "{ALIAS}",
  "description": "Sufficit Identity - FAPI 2.0 Security Profile (final)",
  "server": {
    "discoveryUrl": "https://identity-op.test/.well-known/openid-configuration",
    "allow_unexpected_metadata_fields": [
      "device_authorization_endpoint_auth_methods_supported",
      "pushed_authorization_request_endpoint_auth_methods_supported"
    ]
  },
  "client": {
    "client_id": "{CLIENT1_ID}",
    "jwks": {
      "keys": [
        "{CLIENT1_JWK}"
      ]
    },
    "scope": "openid profile"
  },
  "client2": {
    "client_id": "{CLIENT2_ID}",
    "jwks": {
      "keys": [
        "{CLIENT2_JWK}"
      ]
    },
    "scope": "openid profile"
  },
  "resource": {
    "resourceUrl": "https://identity-op.test/connect/userinfo",
    "resourceMethod": "GET"
  },
  "browser": [
    {
      "match": "https://identity-op.test/connect/authorize*",
      "tasks": [
        {
          "task": "Login",
          "optional": true,
          "match": "https://identity-op.test/account/login*",
          "commands": [
            [
              "text",
              "id",
              "username",
              "{USER_NAME}"
            ],
            [
              "text",
              "id",
              "password",
              "{USER_PASSWORD}"
            ],
            [
              "wait",
              "css",
              "button[type=submit]",
              10,
              ".*",
              "update-image-placeholder-optional"
            ],
            [
              "click",
              "css",
              "button[type=submit]"
            ]
          ]
        },
        {
          "task": "Consent (allow)",
          "optional": true,
          "match": "https://identity-op.test/consent*",
          "commands": [
            [
              "click",
              "css",
              "button[name=consent_decision][value=allow]"
            ]
          ]
        },
        {
          "task": "Verify Complete",
          "match": "{SUITE_BASE_URL}/test/*/callback*",
          "commands": [
            [
              "wait",
              "id",
              "submission_complete",
              10
            ]
          ]
        }
      ]
    }
  ],
